ion_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n  # Combine all action types for iteration. This is a stylistic improvement over v1,\n  # as the visited set correctly handles redundancy for USE actions that don't change state.\n  all_possible_actions = move_actions + [USE_ACT] \n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states to prevent excessive computation in very large or complex scenarios.\n  # The factor of 10 accounts for the additional state dimensions (direction, inventory).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for CraftState.step here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore all possible actions (movements and USE from current position):\n    for action in all_possible_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state hasn't been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:03:24.114798", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid state at the start of collection\n  initial_pos = current_state.pos # Agent's starting (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moves in positive column (c+1)\n      1: (-1, 0),  # Facing UP (1), moves in negative row (r-1)\n      2: (0, -1),  # Facing LEFT (2), moves in negative column (c-1)\n      3: (1, 0)    # Facing DOWN (3), moves in positive row (r+1)\n  }\n\n  # Define how agent's direction changes for left/right turns\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are entities that the agent cannot walk over.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  # It's crucial to store direction because reaching the same position with a different\n  # facing direction can lead to different subsequent paths and interaction possibilities.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a target state is found\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the agent is in a state where the primitive can be collected.\n      # For the 'USE' action in CraftWorld, this typically means the primitive is in the cell\n      # directly in front of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the \"front\" cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the primitive exists in that front cell, we've reached a collectable state.\n          # This assumes 'USE' acts on the cell the agent is facing.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # The actions to get to this (pos, dir) state\n              break # Shortest path found, terminate BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward:\n      # Calculate the next position if the agent moves forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within grid bounds and this specific (position, direction)\n      # state has not been visited to avoid redundant exploration and infinite loops.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable.\n          # A cell is not walkable if it contains any non-grabbable/blocking entity.\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Additionally, the agent generally cannot walk *onto* the primitive itself to collect it.\n          # Collection implies interacting with an adjacent cell.\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left:\n      # Calculate the next direction if the agent turns left. Position remains the same.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right:\n      # Calculate the next direction if the agent turns right. Position remains the same.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:03:25.302013", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid state at the start of collection\n  initial_pos = current_state.pos # Agent's starting (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  # This mapping is crucial for calculating the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moves in positive column (c+1)\n      1: (-1, 0),  # Facing UP (1), moves in negative row (r-1)\n      2: (0, -1),  # Facing LEFT (2), moves in negative column (c-1)\n      3: (1, 0)    # Facing DOWN (3), moves in positive row (r+1)\n  }\n\n  # Define how agent's direction changes for left/right turns\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent cycles and redundant exploration.\n  # A state is defined by both position and facing direction because actions depend on direction.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a target state is found\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent based on current_dir.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the \"front\" cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If the primitive exists in that front cell, we've reached a collectable state.\n          # The agent is now positioned and oriented correctly to 'USE' the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # The actions to get to this (pos, dir) state\n              break # Shortest path found, terminate BFS\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving in current direction\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the potential next position is within grid bounds AND\n      # if this new (position, direction) state has not been visited before.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable.\n          is_walkable = True\n          # A cell is not walkable if it contains any non-grabbable/blocking entity.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, typically, the agent cannot walk *onto* the primitive itself to collect it;\n          # it must be adjacent and 'USE' it. So, block walking onto the primitive.\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark as visited\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to a state where the primitive is in front,\n  # append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:04:41.504698", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its integer ID using the world's cookbook index.\n  # This ensures we are working with the canonical ID used internally by the simulation.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found, it's an invalid target for collection.\n    return []\n\n  # 2. Early exit condition: If the agent already possesses the target primitive in its inventory,\n  # no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is inherently collectible via the 'USE' action in the game.\n  # This includes items that can be picked up (`grabbable_indices`) and specific\n  # environmental resources like water or stone. Items like workshops or boundaries\n  # are typically static environment features and are not meant to be collected into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item cannot be collected using the 'USE' action, we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define constant integer IDs for actions and spatial relationships.\n  # These IDs are obtained from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of basic movement actions for iteration during BFS.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to change from its `current_dir` to a `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference that correctly\n      # represents the shortest turn (e.g., from 3 to 0 is 1 step clockwise).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue to store tuples of (CraftState, list_of_actions_to_reach_this_state)\n  \n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory (a numpy.ndarray) is converted to an immutable tuple for hashability.\n  # Including inventory is critical because acquiring tools or other items can change\n  # the agent's capabilities and thus, what future actions are possible (e.g., collecting wood requires an axe).\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions from the current state for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for BFS exploration. These values are tuned to prevent the search from running\n  # indefinitely in very complex or large state spaces, ensuring a practical search time.\n  # MAX_EXPLORED_STATES limits the number of unique (pos, dir, inventory) states considered.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 12 # Multiplier adjusted for v2 to be slightly more generous.\n  explored_states_count = 0\n\n  # MAX_PATH_LENGTH limits the maximum number of actions in a valid path.\n  # If the shortest path found exceeds this, it is considered too inefficient for practical plans.\n  MAX_PATH_LENGTH = 250 # Increased for v2 to allow for slightly longer, but still manageable, plans.\n\n  # 6. BFS Loop: Continues as long as there are states to explore in the queue.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path leading to it\n    explored_states_count += 1\n\n    # Pruning: If the number of distinct states processed exceeds the heuristic limit,\n    # it implies that a reasonably short path might not exist, or the search is too extensive.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations\n        # (UP, RIGHT, DOWN, LEFT) to determine if facing one of them would put the\n        # primitive directly in front of the agent.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions to get the agent into the correct orientation.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # The reward for turning is typically 0.0, so it's ignored here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                # This is crucial for verifying if 'USE' successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Check if the count of the target primitive in\n                # the inventory *increased* after the 'USE' action. This confirms\n                # successful collection, accounting for any game rules (e.g., needing\n                # a specific tool) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found. Return the full sequence\n                    # of actions: path to reach the location, turns to face, and the final USE.\n                    final_path = path + turns_to_face + [USE_ACT]\n                    \n                    # Apply path length constraint: If the shortest path found is too long,\n                    # consider it unachievable for practical purposes.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # Path found, but it exceeds the acceptable length limit.\n                        # This branch of the BFS will not yield a usable solution.\n                        return [] # Returning empty implies no viable path found within constraints.\n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Convert the inventory of the new state to a tuple for hashability in the `visited` set.\n      next_inventory_tuple = tuple(next_state.inventory) \n      # Create a unique key for the visited set.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited before, add it to the queue and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This is distinct from the 'USE' in the goal check. This general 'USE' handles scenarios\n    # where using an item at the current location might change the inventory\n    # (e.g., picking up a tool like an axe or shears), enabling future collection of other primitives,\n    # even if it doesn't directly collect the *target* primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change (inventory, position, or direction). This prevents adding\n    # redundant states to the queue if 'USE' had no effect (e.g., using nothing or\n    # using an item that doesn't change the state).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is unreachable from the\n  # initial state under the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:04:43.012620", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its integer ID.\n  # This ID is essential for interacting with the simulation's internal state (grid, inventory).\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not valid or recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early exit condition: If the agent already possesses the target primitive in its inventory,\n  # no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is inherently collectible via the 'USE' action in the game.\n  # Collectible items include 'grabbable' items (e.g., wood, iron), and specific environmental\n  # resources like 'water' or 'stone' that can be directly gathered.\n  # Non-collectible items (e.g., workshops, boundaries, crafted items not meant for inventory pickup)\n  # should not trigger a collection attempt.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected by using it, then this function cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define constant integer IDs for actions and spatial relationships.\n  # These are obtained from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of basic movement actions for convenient iteration.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to change from its `current_dir` to a `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the target direction.\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference that correctly\n      # represents the shortest turn (e.g., from 3 to 0 is 1 step clockwise).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implying a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  # `q` is the queue to store (CraftState, list_of_actions_to_reach_this_state).\n  q = collections.deque()\n  \n  # `visited` set tracks visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory (a numpy.ndarray) is converted to an immutable tuple for hashability.\n  # Including inventory is critical because acquiring tools or other items can change\n  # the agent's capabilities and thus, what future actions are possible.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions from the current state for boundary checks and to set\n  # a heuristic limit on the number of states to explore.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for BFS exploration. These prevent the search from running\n  # indefinitely in very complex or large state spaces, ensuring timely completion.\n  # MAX_EXPLORED_STATES: Limits the total number of unique (pos, dir, inventory) states visited.\n  # The multiplier (e.g., 10) accounts for variations in inventory at the same location.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # MAX_PATH_LENGTH: Limits the length of the action sequence. If the shortest path\n  # found (due to BFS) exceeds this, it is considered too long to be practical.\n  MAX_PATH_LENGTH = 200 # This value can be tuned based on scenario complexity.\n\n  # 6. BFS Loop: Continues as long as there are states to explore in the queue.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path leading to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the heuristic limit,\n    # we stop further exploration to manage computational resources. This implies\n    # either no path exists or any existing path is too complex to find within limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations\n        # (UP, RIGHT, DOWN, LEFT) to determine if facing one of them would put the\n        # primitive directly in front of the agent.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions to get the agent into the correct orientation.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # The reward for turning is typically 0.0, so it's ignored here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                # This is crucial for verifying if 'USE' successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Check if the count of the target primitive in\n                # the inventory *increased* after the 'USE' action. This confirms\n                # successful collection, accounting for any game rules (e.g., needing\n                # a specific tool) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found. Return the full sequence\n                    # of actions: path to reach the location, turns to face, and the final USE.\n                    final_path = path + turns_to_face + [USE_ACT]\n                    \n                    # Apply MAX_PATH_LENGTH constraint: if the shortest path found is too long,\n                    # consider it unachievable for practical purposes.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found is over the limit, so no valid path exists within the constraint.\n                        return []\n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Convert the inventory of the new state to a tuple for hashability in the `visited` set.\n      next_inventory_tuple = tuple(next_state.inventory) \n      # Create a unique key for the visited set, incorporating position, direction, and inventory.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited before, add it to the queue and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This is distinct from the 'USE' in the goal check above. This general 'USE' handles\n    # scenarios where using an item at the current location might change the inventory\n    # (e.g., picking up a tool like an axe or shears), enabling future collection of other\n    # primitives, even if it doesn't directly collect the *target* primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change (inventory, position, or direction). This prevents adding\n    # redundant states to the queue if 'USE' had no effect (e.g., using nothing or\n    # using an item that doesn't change the state).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is unreachable from the\n  # initial state under the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:06:15.615279", "function_name": "collect", "function_body": "  \"\"\"Further refined version of `collect_v1`, offering robust and optimal pathfinding.\n  This function leverages Breadth-First Search (BFS) to efficiently determine the\n  shortest sequence of actions required to navigate the agent to a position where\n  the specified primitive item can be collected using the 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to be collected.\n\n    Returns:\n        List[int]: An ordered list of integer action IDs. This sequence, when\n                   executed by the agent, will lead it to collect the target primitive.\n                   Returns an empty list if the primitive is not recognized,\n                   is not grabbable, or is unreachable within the current grid.\n  \"\"\"\n  actions_list = [] # Stores the final sequence of actions to be returned.\n  \n  # Capture the immutable state of the environment for pathfinding.\n  current_state = env._current_state \n  initial_grid = current_state.grid       # Static grid layout for BFS traversal.\n  initial_pos = current_state.pos         # Agent's starting (row, col) coordinates.\n  initial_dir = current_state.dir         # Agent's initial facing direction.\n\n  # Retrieve grid dimensions to ensure all movements and checks are within bounds.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # 1. Validate and Identify Primitive:\n  # Translate the primitive name (string) into its unique integer ID.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Critically, check if the primitive is actually an item that can be picked up.\n  # `grabbable_indices` ensures it's not a static environment feature (like water)\n  # or an unknown/unrecognized item (where `primitive_id` might be None).\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] # Cannot collect this item, return empty path.\n\n  # 2. Map Action Names to Integer IDs:\n  # Obtain the canonical integer IDs for movement and interaction actions.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumes 'UP' means moving forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to pick up item in front.\n\n  # 3. Define Directional Transitions:\n  # `DIR_TO_DRDC`: Maps agent's direction to corresponding (delta_row, delta_col) for forward movement.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing Right: column increases.\n      1: (-1, 0),  # Facing Up: row decreases.\n      2: (0, -1),  # Facing Left: column decreases.\n      3: (1, 0)    # Facing Down: row increases.\n  }\n  # `TURN_LEFT_MAP`: Defines the next direction after a counter-clockwise turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # `TURN_RIGHT_MAP`: Defines the next direction after a clockwise turn.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Cache non-walkable entity indices for efficient checks during pathfinding.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for BFS Logic:\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if (row, col) coordinates are within the grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if a given cell `pos` is traversable by the agent.\n      A cell is walkable if it's within bounds and does not contain:\n      - Any blocking entities (like water, workshops, or grid boundaries).\n      - The target `primitive_id` itself, as the agent must be adjacent to pick it up, not on it.\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False # Out of bounds.\n      \n      # Check if the cell contains any known non-walkable obstacles.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # Contains a blocking obstacle.\n      \n      # The agent cannot move onto the item it intends to collect.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # Contains the target primitive itself.\n          \n      return True # Cell is clear for movement.\n\n  def _is_target_facing_state(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Verifies if the agent, at `pos` and `current_dir`, is positioned such that\n      the `primitive_id` is in the cell directly in front, allowing for a 'USE' action.\n      \"\"\"\n      r, c = pos\n      # Calculate the coordinates of the cell in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # The cell in front is out of bounds.\n      \n      # Check if the target primitive is present (quantity > 0) in the front cell.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) for Shortest Path:\n  # BFS guarantees finding the shortest path in terms of number of actions,\n  # as each movement/turn action is treated with a unit cost.\n\n  # `queue`: Stores tuples `(agent_state, path_so_far)`.\n  #   `agent_state`: `((row, col), direction)` representing the agent's current configuration.\n  #   `path_so_far`: List of action IDs that led to `agent_state`.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # `visited`: Set to keep track of explored agent states `((row, col), direction)`\n  # to prevent redundant processing and infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  # `path_to_collection_spot`: Stores the optimal action sequence (excluding the final 'USE').\n  path_to_collection_spot = None \n\n  # Optimization: Check if the agent is already in the desired state at the very beginning.\n  if _is_target_facing_state(initial_pos, initial_dir):\n      path_to_collection_spot = [] # No prior movement actions needed.\n\n  # Commence BFS if the target state is not immediately reachable.\n  if path_to_collection_spot is None:\n      while queue:\n          (current_pos, current_dir), current_path = queue.popleft()\n          \n          # Explore potential next states by applying each possible action:\n\n          # --- 5a. Try Moving Forward ---\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction remains constant after moving forward.\n\n          # Check if the new position is walkable and the state hasn't been visited.\n          if _is_walkable_cell(next_pos_fwd):\n              next_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if next_state_fwd not in visited:\n                  visited.add(next_state_fwd)\n                  new_path_fwd = current_path + [MOVE_FORWARD_ACTION]\n                  \n                  # If this new state allows immediate collection, we found the shortest path.\n                  if _is_target_facing_state(next_pos_fwd, next_dir_fwd):\n                      path_to_collection_spot = new_path_fwd\n                      break # Exit BFS, path found.\n                  \n                  queue.append((next_state_fwd, new_path_fwd))\n\n          # --- 5b. Try Turning Left ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Position remains unchanged when turning.\n          new_state_left = (current_pos, next_dir_left) \n          \n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = current_path + [TURN_LEFT_ACTION]\n              \n              # If turning left leads to a collection-ready state.\n              if _is_target_facing_state(current_pos, next_dir_left):\n                  path_to_collection_spot = new_path_left\n                  break # Exit BFS, path found.\n              \n              queue.append((new_state_left, new_path_left))\n\n          # --- 5c. Try Turning Right ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains unchanged when turning.\n          new_state_right = (current_pos, next_dir_right)\n          \n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = current_path + [TURN_RIGHT_ACTION]\n              \n              # If turning right leads to a collection-ready state.\n              if _is_target_facing_state(current_pos, next_dir_right):\n                  path_to_collection_spot = new_path_right\n                  break # Exit BFS, path found.\n              \n              queue.append((new_state_right, new_path_right))\n      \n  # 6. Final Action List Construction:\n  # If a path was successfully found by the BFS (or if agent started in target state),\n  # append the final 'USE' action to complete the collection.\n  if path_to_collection_spot is not None:\n      actions_list.extend(path_to_collection_spot)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:06:16.822083", "function_name": "collect", "function_body": "  actions_list = [] # This will store the final sequence of actions to be returned.\n  \n  # Retrieve the current state of the environment.\n  current_state = env._current_state \n  initial_grid = current_state.grid       # The 3D NumPy array representing the world grid at search start.\n  initial_pos = current_state.pos         # Agent's initial (row, col) coordinates.\n  initial_dir = current_state.dir         # Agent's initial facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Determine grid dimensions for boundary checks and traversal logic.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # 1. Validate Primitive: Ensure the primitive exists and is grabbable.\n  # The cookbook's index maps string names to integer IDs.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # A primitive can only be collected if its ID is explicitly listed in the\n  # world's `grabbable_indices`. Also, `Index.__getitem__` can return None\n  # if the item name is not found in the index.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices:\n      return [] # Uncollectible primitive, return an empty action list.\n\n  # 2. Map Action Names to Integer IDs: Standard actions in CraftLab.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' translates to moving one step forward relative to agent's direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to pick up or interact with the item in front.\n\n  # 3. Define Directional Transformations: How agent's position and direction change.\n  # `DIR_TO_DRDC`: Maps agent's direction (0-3) to a change in (row, column) for a forward move.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: +col\n      1: (-1, 0),  # Up: -row\n      2: (0, -1),  # Left: -col\n      3: (1, 0)    # Down: +row\n  }\n  # `TURN_LEFT_MAP`: Defines the new direction after a counter-clockwise turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # `TURN_RIGHT_MAP`: Defines the new direction after a clockwise turn.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Cache non-walkable entity indices. These are entities the agent cannot traverse through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Define Helper Functions for BFS Pathfinding.\n\n  def _is_coord_in_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if the given (row, col) coordinates are within the grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_cell_walkable(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can move into a specific cell (`pos`).\n      A cell is considered walkable if it's within bounds and does not contain:\n      - Any non-grabbable (blocking) entity like water, workshops, or boundaries.\n      - The `primitive_id` itself, as the agent needs to be *adjacent* to collect,\n        not on top of, the item.\n      \"\"\"\n      r, c = pos\n      if not _is_coord_in_bounds(r, c):\n          return False\n      \n      # Check if the cell contains any known blocking obstacles.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # Obstacle found, cell is not walkable.\n      \n      # The agent cannot walk *onto* the primitive it wants to collect.\n      # The 'USE' action operates on the cell *in front* of the agent.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # Target primitive is here, agent cannot occupy this spot.\n          \n      return True # Cell is clear for movement.\n\n  def _is_target_facing_state(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the current agent `pos` and `current_dir`, the target\n      `primitive_id` is located in the cell directly in front, meaning a 'USE'\n      action would successfully collect it.\n      \"\"\"\n      r, c = pos\n      # Calculate coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_coord_in_bounds(front_r, front_c):\n          return False # Cell in front is out of bounds.\n      \n      # Check if the primitive exists (quantity > 0) in that front cell.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) Implementation for Shortest Path.\n  # BFS guarantees finding the shortest path in terms of number of actions,\n  # as all actions (move, turn) have an implied cost of 1.\n\n  # `queue`: Stores tuples of `(agent_state, path_to_state)`.\n  #   `agent_state` is `((row, col), direction)`.\n  #   `path_to_state` is a list of integer action IDs leading to this state.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # `visited`: Stores `agent_state` tuples (position, direction) to prevent\n  # redundant computations and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the action sequence (excluding the final 'USE' action)\n  # that leads the agent to a position where it can collect the primitive.\n  path_to_collection_spot = None \n\n  # Optimization: Check if the agent is already in the 'ready-to-use' state.\n  if _is_target_facing_state(initial_pos, initial_dir):\n      path_to_collection_spot = [] # No movement actions needed, directly ready for 'USE'.\n\n  # If not already at the collection spot, start the BFS.\n  if path_to_collection_spot is None:\n      while queue:\n          current_agent_pos, current_agent_dir = queue.popleft()\n          current_path = current_agent_dir # `current_agent_dir` is actually the path, name is misleading in v0/v1\n          # Correcting variable unpack from previous versions:\n          # `queue.popleft()` returns `((pos, dir), path_actions)`\n          # So, `current_agent_state` is `(pos, dir)` and `current_path_actions` is the list.\n          current_state_tuple, current_path_actions = current_agent_pos, current_agent_dir # Rename for clarity\n          \n          current_pos, current_dir = current_state_tuple # Unpack position and direction\n          \n          # Explore all valid next actions: Move Forward, Turn Left, Turn Right.\n\n          # --- 5a. Explore Move Forward ---\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction doesn't change when moving.\n          next_state_fwd = (next_pos_fwd, next_dir_fwd)\n\n          if _is_cell_walkable(next_pos_fwd) and next_state_fwd not in visited:\n              visited.add(next_state_fwd)\n              new_path_fwd = current_path_actions + [MOVE_FORWARD_ACTION]\n              \n              # Check if moving forward leads to the target-facing state.\n              if _is_target_facing_state(next_pos_fwd, next_dir_fwd):\n                  path_to_collection_spot = new_path_fwd\n                  break # Shortest path found, terminate BFS.\n              \n              queue.append((next_state_fwd, new_path_fwd))\n\n          # --- 5b. Explore Turn Left ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          next_state_left = (current_pos, next_dir_left) # Position remains the same when turning.\n          \n          if next_state_left not in visited:\n              visited.add(next_state_left)\n              new_path_left = current_path_actions + [TURN_LEFT_ACTION]\n              \n              # Check if turning left leads to the target-facing state.\n              if _is_target_facing_state(current_pos, next_dir_left):\n                  path_to_collection_spot = new_path_left\n                  break # Shortest path found, terminate BFS.\n              \n              queue.append((next_state_left, new_path_left))\n\n          # --- 5c. Explore Turn Right ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          next_state_right = (current_pos, next_dir_right) # Position remains the same when turning.\n          \n          if next_state_right not in visited:\n              visited.add(next_state_right)\n              new_path_right = current_path_actions + [TURN_RIGHT_ACTION]\n              \n              # Check if turning right leads to the target-facing state.\n              if _is_target_facing_state(current_pos, next_dir_right):\n                  path_to_collection_spot = new_path_right\n                  break # Shortest path found, terminate BFS.\n              \n              queue.append((next_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List.\n  # If BFS successfully found a path to a collection-ready state, append the 'USE' action.\n  if path_to_collection_spot is not None:\n      actions_list.extend(path_to_collection_spot)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:08:14.480327", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID for the target item (what we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected via this function.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' kind on the grid that needs to be interacted with\n  # to yield the target primitive. This distinction is crucial for primitives\n  # like \"wood\" (target) which often comes from \"tree\" (source).\n  # `i_kind_source` will be the integer ID of the entity on the grid that we need to\n  # interact with using the 'USE' action to obtain `i_kind_target`.\n  i_kind_source = -1 \n\n  # Case A: The primitive itself is directly grabbable (can be picked up directly from the grid)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # This mapping is based on common CraftWorld environment interactions.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\", \n          \"rock\": \"rock_block\", \n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Extend this dictionary for any other derived primitives collectible from specific grid entities.\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n      \n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The mapped source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This suggests an issue with the environment configuration or the mapping.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid in this context.\n          # It might be an item that needs to be crafted, or a non-interactive entity.\n          return []\n\n  # If `i_kind_source` remains invalid after all checks, it means the primitive cannot be collected\n  # via interaction with a grid entity using the 'USE' action.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice for 180 degrees\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set must include the agent's position, direction, and inventory.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having acquired a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Set a robust upper bound for explored states to prevent excessively long searches.\n  # This heuristic considers grid size, number of directions, and a factor for relevant\n  # inventory permutations (e.g., acquiring a necessary tool).\n  # The multiplier `(1 + len(world.cookbook.kinds)) * 5` from v1 is a high bound,\n  # potentially for more complex inventory interactions, ensuring completeness for simpler tasks.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) * 5 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, continue to next queued item\n    # or terminate if queue becomes empty. This prevents excessively long searches.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Can we collect the target primitive by 'USE'ing at the agent's current position?\n    # This applies if the `i_kind_source` is directly under the agent (e.g., a grabbable item).\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Check if the count of the *target primitive* (i_kind_target) increased in inventory.\n        # This is the definitive check for successful collection, implicitly accounting for any\n        # tools or conditions required by `CraftState.step`.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Primitive collected by using at current position\n\n    # Goal Check 2: Can we collect the target primitive from an adjacent cell?\n    # Iterate through all four cardinal directions to check for the `i_kind_source` entity.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure the cell we are checking is within grid bounds and contains the `i_kind_source`.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Simulate the turning actions required to face the `i_kind_source` entity.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting 'USE' to verify actual collection.\n            inventory_before_use_adjacent = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use_adjacent = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the *target primitive* (i_kind_target) in inventory actually increase?\n            # This accounts for game mechanics like requiring a tool (e.g., axe for wood),\n            # or consuming the source (e.g., tree disappearing after collecting wood).\n            if state_after_use_adjacent.inventory[i_kind_target] > inventory_before_use_adjacent[i_kind_target]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    # Attempt to move in all four cardinal directions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert array to tuple for hashing\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position.\n    # This is important for actions that don't directly target a primitive but change state\n    # in a beneficial way (e.g., picking up a grabbable tool from the ground, or interacting\n    # with a workshop to obtain a tool that is then used for collection).\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Only add this new state to the queue if the 'USE' action actually resulted in a change\n    # to the inventory, position, or direction. This prunes redundant states where 'USE' does nothing.\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and the capabilities of the 'collect' action.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:08:23.588145", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID for the target item (what we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected by this function.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' kind on the grid that needs to be interacted with\n  # to yield the target primitive. This distinction is crucial for primitives\n  # like \"wood\" (target) which comes from \"tree\" (source).\n  # `i_kind_source` will be the integer ID of the entity on the grid that we need to\n  # interact with using the 'USE' action to obtain `i_kind_target`.\n  # Initialize with a sentinel value.\n  i_kind_source = -1 \n\n  # Case A: The primitive itself is directly grabbable (can be picked up directly from the grid)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  # In these cases, the source entity on the grid is the primitive itself.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # This mapping is based on common CraftWorld environment behaviors.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\", \n          \"rock\": \"rock_block\", \n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n      \n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The mapped source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid.\n          # For `primitive` types like BOUNDARY or WORKSHOPs, which are static environment features,\n          # they correctly fall into this category and cannot be \"collected\".\n          return []\n\n  # If `i_kind_source` is still invalid (-1 after all checks), it means the primitive cannot be collected\n  # via interaction with a grid entity using the 'USE' action.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice for 180 degrees\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set must include the agent's position, direction, and a tuple\n  # representation of the inventory. This is critical for distinguishing states\n  # where inventory changes (e.g., picking up a tool) from states where only\n  # position/direction change, allowing the BFS to explore paths involving tool acquisition.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Set a robust upper bound for explored states to prevent excessively long searches.\n  # This heuristic considers grid size, number of directions, and a factor for\n  # possible relevant inventory permutations. It's a safeguard against state space explosion.\n  # The multiplier is increased to allow for potentially deeper searches where\n  # intermediate tool acquisition might require more steps/states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent Time Limit Exceeded.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      # If the limit is hit, it implies a path might not exist within reasonable search bounds\n      # or the problem instance is too complex for this BFS. Continue to the next queued item.\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Can we collect the target primitive from the agent's current position?\n    # This covers scenarios where the agent needs to use an item at their current spot\n    # (e.g., picking up a loose grabbable item they are standing on).\n    # We check if the `i_kind_source` entity is at the agent's current grid cell.\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Critical check: Did the count of the *target primitive* increase in inventory?\n        # This is the definitive verification for successful collection, implicitly\n        # accounting for any tool requirements or other game rules handled by CraftState.step.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Primitive successfully collected by using at current position\n\n    # Goal Check 2: Can we collect the target primitive from an adjacent cell?\n    # Iterate through all four cardinal directions to check for the `i_kind_source` entity.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure the cell we are checking is within grid bounds and contains the `i_kind_source`.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Simulate the turning actions required to face the `i_kind_source` entity.\n            # This is done on a temporary state to avoid modifying the current BFS state directly.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting 'USE' to verify actual collection.\n            inventory_before_use_adjacent = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use_adjacent = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the *target primitive* in inventory actually increase?\n            # This accounts for game mechanics like requiring a tool (e.g., axe for wood),\n            # consuming the source (e.g., tree disappearing after collecting wood),\n            # and confirms the 'USE' action was successful for the target.\n            if state_after_use_adjacent.inventory[i_kind_target] > inventory_before_use_adjacent[i_kind_target]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    # Attempt to move in all four cardinal directions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert array to tuple for hashing\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Add the new state to the queue only if it hasn't been visited before.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the general 'USE' action from the current position.\n    # This is crucial for actions that don't directly target a primitive but change state\n    # in a beneficial way (e.g., picking up a tool that is lying on the ground, or\n    # interacting with a workshop that might provide a temporary buff or item).\n    # This step is vital for implicitly finding paths that involve tool acquisition.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Only add this new state to the queue if the 'USE' action actually resulted in a change\n    # to the inventory, position, or direction. This prunes redundant states where 'USE' does nothing.\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        # Add the state resulting from the general USE action if it's new.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # (e.g., no required tools available, source entity not on map, or blocked path).\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:09:24.275356", "function_name": "collect", "function_body": "  # Retrieve the current state of the environment\n  current_craft_state = env._current_state\n  \n  # Extract initial grid layout, agent's starting position, and facing direction\n  initial_grid = current_craft_state.grid\n  agent_start_pos_rc = current_craft_state.pos # (row, col) tuple\n  agent_start_dir_int = current_craft_state.dir # Integer: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n\n  # Get the unique integer ID for the target primitive from the game's cookbook index.\n  # This ID is used to locate the primitive within the grid's feature layers.\n  try:\n      target_primitive_id = current_craft_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name does not exist in the cookbook, it cannot be collected.\n      # This indicates an invalid primitive name or a misconfiguration.\n      return [] # Return empty list, as the primitive is unknown or uncollectable.\n\n  # Determine the dimensions of the game grid.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map action names (from DSL/game config) to their corresponding integer IDs.\n  # These IDs are used by the environment's step function.\n  env_action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = env_action_map['UP']    # Corresponds to moving one step in current facing direction\n  ACTION_TURN_LEFT = env_action_map['LEFT']     # Corresponds to rotating 90 degrees left\n  ACTION_TURN_RIGHT = env_action_map['RIGHT']   # Corresponds to rotating 90 degrees right\n  ACTION_USE = env_action_map['USE']            # Corresponds to interacting with the cell in front\n\n  # Define how agent's (row, column) position changes for each of its 4 cardinal directions.\n  # Direction 0: Right (positive column change)\n  # Direction 1: Up (negative row change)\n  # Direction 2: Left (negative column change)\n  # Direction 3: Down (positive row change)\n  DIRECTION_DELTAS_RC = {\n      0: (0, 1),   # Right: (dr=0, dc=+1)\n      1: (-1, 0),  # Up:    (dr=-1, dc=0)\n      2: (0, -1),  # Left:  (dr=0, dc=-1)\n      3: (1, 0)    # Down:  (dr=+1, dc=0)\n  }\n\n  # Define how agent's direction integer changes when turning left or right.\n  # This creates a cyclic mapping (e.g., Right -> Up -> Left -> Down -> Right).\n  TURN_LEFT_DIR_CYCLE = {0: 1, 1: 2, 2: 3, 3: 0}   # R->U->L->D->R\n  TURN_RIGHT_DIR_CYCLE = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # These are typically boundaries, water, or specific workshop structures.\n  non_walkable_entity_ids = current_craft_state.world.non_grabbable_indices\n\n  # --- Breadth-First Search (BFS) Implementation ---\n  # The BFS explores possible agent states (position, direction) to find the shortest\n  # path to a state where the agent is adjacent to and facing the target primitive.\n\n  # The queue for BFS stores tuples:\n  # ((current_row, current_col), current_direction_int), list_of_actions_to_reach_this_state\n  bfs_queue = collections.deque([((agent_start_pos_rc, agent_start_dir_int), [])])\n  \n  # The set of visited states prevents redundant explorations and infinite loops.\n  # A state is defined by (position_tuple, direction_int).\n  visited_states_set = {(agent_start_pos_rc, agent_start_dir_int)}\n\n  # This variable will store the action sequence if a path to the target is found.\n  shortest_path_to_primitive_adj = None \n\n  while bfs_queue:\n      (current_pos_rc, current_dir), actions_taken_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos_rc\n\n      # 1. Check if the current agent state satisfies the goal condition:\n      #    Is the agent currently positioned such that the target primitive is\n      #    directly in the cell it's facing?\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      delta_r_front, delta_c_front = DIRECTION_DELTAS_RC[current_dir]\n      cell_in_front_r, cell_in_front_c = current_r + delta_r_front, current_c + delta_c_front\n\n      # Validate if the cell in front is within the grid boundaries.\n      if (0 <= cell_in_front_r < GRID_ROWS and 0 <= cell_in_front_c < GRID_COLS):\n          # Check if the target primitive exists in this specific cell.\n          if initial_grid[cell_in_front_r, cell_in_front_c, target_primitive_id] > 0:\n              # Goal state reached: agent is adjacent to and facing the primitive.\n              shortest_path_to_primitive_adj = actions_taken_so_far\n              break # Exit BFS; we found the shortest path.\n\n      # 2. Explore all possible next actions from the current state (Move Forward, Turn Left, Turn Right).\n      \n      # --- Try Moving Forward ---\n      next_r_move, next_c_move = current_r + DIRECTION_DELTAS_RC[current_dir][0], \\\n                                 current_c + DIRECTION_DELTAS_RC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Check if the potential next position is within grid boundaries.\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS):\n          # Check if this (position, direction) state has not been visited yet.\n          if ((next_pos_move, next_dir_move) not in visited_states_set):\n              # Determine if the 'next_pos_move' cell is a walkable location for the agent.\n              is_walkable_cell = True\n              \n              # An agent cannot walk onto cells containing non-walkable entities (e.g., walls, water).\n              for kind_idx in non_walkable_entity_ids:\n                  if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_walkable_cell = False\n                      break # Not walkable, no need to check further kinds.\n              \n              # An agent also cannot walk *onto* the primitive it intends to collect;\n              # it must remain adjacent to it to 'USE' it.\n              if is_walkable_cell and initial_grid[next_r_move, next_c_move, target_primitive_id] > 0:\n                  is_walkable_cell = False\n\n              if is_walkable_cell:\n                  # If valid and walkable, add this new state to the queue and mark as visited.\n                  visited_states_set.add((next_pos_move, next_dir_move))\n                  bfs_queue.append(((next_pos_move, next_dir_move), actions_taken_so_far + [ACTION_MOVE_FORWARD]))\n\n      # --- Try Turning Left ---\n      next_dir_turn_left = TURN_LEFT_DIR_CYCLE[current_dir]\n      # Turning actions do not change the agent's position.\n      if ((current_pos_rc, next_dir_turn_left) not in visited_states_set):\n          # If valid and not visited, add this new state to the queue and mark as visited.\n          visited_states_set.add((current_pos_rc, next_dir_turn_left))\n          bfs_queue.append(((current_pos_rc, next_dir_turn_left), actions_taken_so_far + [ACTION_TURN_LEFT]))\n\n      # --- Try Turning Right ---\n      next_dir_turn_right = TURN_RIGHT_DIR_CYCLE[current_dir]\n      # Turning actions do not change the agent's position.\n      if ((current_pos_rc, next_dir_turn_right) not in visited_states_set):\n          # If valid and not visited, add this new state to the queue and mark as visited.\n          visited_states_set.add((current_pos_rc, next_dir_turn_right))\n          bfs_queue.append(((current_pos_rc, next_dir_turn_right), actions_taken_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  final_action_sequence = []\n  if shortest_path_to_primitive_adj is not None:\n      # If a path was found to an adjacent and facing position, append the 'USE' action.\n      # The 'USE' action collects the primitive.\n      final_action_sequence.extend(shortest_path_to_primitive_adj)\n      final_action_sequence.append(ACTION_USE)\n\n  return final_action_sequence", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:09:25.465129", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Returns a list of actions to find and collect the specified primitive in the passed environment.\n\n  This function uses a Breadth-First Search (BFS) algorithm to find the shortest\n  sequence of actions (moves and turns) that brings the agent to a position\n  adjacent to the target primitive, facing it. Once such a state is reached,\n  a 'USE' action is appended to the sequence to simulate collection.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object representing the current game state.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action IDs that, when executed, should\n                 lead to the collection of the primitive. Returns an empty list\n                 if the primitive cannot be found or is unreachable.\n  \"\"\"\n  actions_to_collect = []\n  current_state = env._current_state # Get the current state of the environment\n\n  # Extract initial agent properties and grid information\n  initial_grid = current_state.grid # The 3D numpy array representing the world grid\n  initial_agent_pos = current_state.pos # (row, col) tuple of agent's starting position\n  initial_agent_dir = current_state.dir # Integer (0-3) representing agent's starting direction\n\n  # Get the integer ID for the target primitive from the game's cookbook index\n  try:\n      target_primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not valid or not found in the game's registry,\n      # it's impossible to collect, so return an empty action list.\n      return []\n\n  # Get grid dimensions (rows, columns) for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map symbolic action names to their corresponding integer IDs using the environment's spec\n  action_ids = env.action_specs()\n  MOVE_FORWARD_ACTION = action_ids['UP']    # Corresponds to moving one cell forward\n  TURN_LEFT_ACTION = action_ids['LEFT']     # Corresponds to turning 90 degrees counter-clockwise\n  TURN_RIGHT_ACTION = action_ids['RIGHT']   # Corresponds to turning 90 degrees clockwise\n  USE_ACTION = action_ids['USE']            # Corresponds to interacting with the cell in front\n\n  # Define how agent's position changes based on its current direction\n  # Directions: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  # Maps (direction_id) -> (delta_row, delta_col)\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Right: (row_unchanged, col_increases)\n      1: (-1, 0),  # Up:    (row_decreases, col_unchanged)\n      2: (0, -1),  # Left:  (row_unchanged, col_decreases)\n      3: (1, 0)    # Down:  (row_increases, col_unchanged)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Identify entity kinds that the agent cannot walk onto (e.g., boundaries, water, workshops)\n  # These are global non-grabbable indices.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # --- BFS Setup for Pathfinding ---\n  # The BFS queue stores tuples:\n  # ( (current_row, current_col), current_direction_id ), list_of_actions_taken_to_reach_this_state\n  search_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n\n  # The visited set stores (position_tuple, direction_id) tuples to prevent\n  # infinite loops and redundant path exploration.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the action sequence once the target condition is met.\n  path_to_adjacent_primitive = None\n\n  # Start the BFS traversal\n  while search_queue:\n      # Dequeue the current state and its path\n      (current_pos_rc, current_dir), path_actions = search_queue.popleft()\n      r, c = current_pos_rc # Unpack current row and column\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      dr_front, dc_front = DIRECTION_TO_DELTA_RC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front # Coordinates of the cell directly in front\n\n      # Check if the 'front' cell is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the target primitive is present in this 'front' cell\n          if initial_grid[front_r, front_c, target_primitive_id] > 0:\n              path_to_adjacent_primitive = path_actions # We found the sequence of actions!\n              break # Exit the BFS loop, as a shortest path is found\n\n      # --- Explore Possible Next Actions (Move, Turn Left, Turn Right) ---\n\n      # 1. Try to Move Forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_RC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains unchanged after moving forward\n\n      # Check if the potential new position is within bounds and the state (pos, dir) is unvisited\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          # Determine if the 'next_pos_move' cell is walkable for the agent\n          is_walkable = True\n          # Agent cannot walk onto specified non-grabbable (e.g., BOUNDARY, WATER, WORKSHOP) entities\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk *onto* the specific target primitive itself; it must remain adjacent to USE it.\n          if is_walkable and initial_grid[next_r_move, next_c_move, target_primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              # Add the new state to visited and enqueue it\n              visited_states.add((next_pos_move, next_dir_move))\n              search_queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try to Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos_rc, next_dir_left) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_left))\n          search_queue.append(((current_pos_rc, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try to Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos_rc, next_dir_right) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_right))\n          search_queue.append(((current_pos_rc, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # --- Finalize Actions ---\n  # If a path to being adjacent to and facing the primitive was found:\n  if path_to_adjacent_primitive is not None:\n      actions_to_collect.extend(path_to_adjacent_primitive)\n      actions_to_collect.append(USE_ACTION) # Append the USE action to collect the primitive\n      \n  return actions_to_collect", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:10:51.955027", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using explicit path reconstruction to optimize memory.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # Helper to create a hashable state key (row, col, direction, inventory_tuple)\n  def _get_state_key(state: craft.CraftState):\n      return (state.pos[0], state.pos[1], state.dir, tuple(state.inventory))\n\n  # 1. Get the primitive's integer ID (this is the *target* item we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory at the very beginning.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' entity kind on the grid that needs to be interacted with\n  # to yield the target primitive.\n  i_kind_source = -1\n\n  # Case A: The primitive itself is directly grabbable (can be picked up directly from the grid)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This mapping is specific to how CraftWorld generates resources.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\",\n          \"rock\": \"rock_block\",\n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n\n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on a grid object.\n          return []\n\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # 5. Initialize Breadth-First Search (BFS) for path reconstruction.\n  q = collections.deque()\n  # parent_map stores {state_key: (previous_state_key, action_taken_to_reach_this_state)}\n  parent_map = {}\n\n  # Start BFS from the current environment state.\n  initial_state_key = _get_state_key(current_state)\n  q.append(current_state)\n  parent_map[initial_state_key] = (None, None) # No parent for the starting state\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent excessively long searches.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # Variable to store the goal state when found\n  found_goal_state = None\n\n  # 6. BFS Loop.\n  while q:\n    state = q.popleft()\n    current_state_key = _get_state_key(state)\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Continue processing states already in queue, but don't add more if limit reached.\n\n    # --- GOAL CHECK ---\n    # If the target primitive is now in the agent's inventory, we have found a path.\n    if state.inventory[i_kind_target] > 0:\n        found_goal_state = state\n        break # Goal achieved! Exit the BFS loop.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- EXPLORE ACTIONS ---\n    possible_actions_from_this_state = list(move_actions)\n\n    # Decide whether to explore the USE action from the current state.\n    # This is important for harvesting, crafting, or picking up tools.\n    do_general_use_exploration = False\n\n    # Check if agent is currently on a grabbable item (it could be the target or a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0:\n        item_at_pos_idx = item_at_pos_idx_flat[0]\n        if item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n\n    # Check if agent is facing a workshop, a grabbable item, or another primitive resource.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n\n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx in world.workshop_indices or\n                item_in_front_idx in world.grabbable_indices or\n                item_in_front_idx in world.cookbook.primitives): # 'primitives' here includes sources like 'tree', 'iron_ore'\n                do_general_use_exploration = True\n\n    if do_general_use_exploration:\n        possible_actions_from_this_state.append(USE_ACT)\n\n    # Simulate each possible action and add resulting states to the queue if unvisited.\n    for action in possible_actions_from_this_state:\n      # Simulate the action. `state.step` returns (reward, new_state).\n      # Reward is not used for pathfinding here.\n      _, next_state = state.step(action)\n      next_state_key = _get_state_key(next_state)\n\n      # If this next state has not been visited before (or a shorter path to it has not been found)\n      if next_state_key not in parent_map:\n        parent_map[next_state_key] = (current_state_key, action)\n        q.append(next_state)\n\n  # 7. Path Reconstruction.\n  # If found_goal_state is None, it means the BFS exhausted all reachable states without finding the primitive.\n  if found_goal_state is None:\n      return []\n\n  path = []\n  current_key = _get_state_key(found_goal_state)\n  # Backtrack from the goal state using the parent_map until the initial state (parent is None).\n  while parent_map[current_key][0] is not None:\n      prev_key, action = parent_map[current_key]\n      path.append(action)\n      current_key = prev_key\n  path.reverse() # The path was built in reverse order, so reverse it to get the correct sequence.\n  return path", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:10:53.637540", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID (this is the *target* item we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' entity kind on the grid that needs to be interacted with\n  # to yield the target primitive. This distinction is crucial for primitives\n  # like \"wood\" (target) which comes from \"tree\" (source).\n  i_kind_source = -1 # Default to an invalid value\n\n  # Case A: The primitive itself is directly grabbable (can be picked up directly from the grid)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  # These are entities that can be interacted with directly to get the target primitive.\n  if i_kind_target in world.grabbable_indices:\n      # If the target primitive is something that can be picked up directly from the grid (e.g., 'stick'),\n      # then the source entity to interact with is the primitive itself on the grid.\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # This mapping captures common resource-harvesting mechanics in CraftWorld.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\",\n          \"rock\": \"rock_block\",\n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Add other explicit mappings if there are more complex dependencies.\n          # Note: If a primitive (like PLANK) can only be crafted, it won't be in this map,\n          # nor will it be directly grabbable or a special resource. In such cases,\n          # i_kind_source will remain -1, and the function will correctly return [].\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n\n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on a grid object.\n          # (e.g., it might be a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid after all checks, it means the primitive cannot be collected\n  # via interacting with an environmental object, so return an empty path.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference for rotation.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice for simplicity\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing the agent's full state (row, col, direction, inventory_tuple)\n  # to avoid cycles and redundant exploration. Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state: list of action integers)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # A robust upper bound for explored states to prevent excessively long searches.\n  # This factor considers grid size, 4 possible directions, and a heuristic\n  # for the number of distinct inventory states that might be encountered during exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # We continue the loop rather than breaking, allowing other shorter branches to potentially\n    # complete if the goal is still reachable through them, but prioritizing breadth-first search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check 1: Is the *target primitive* already in the current state's inventory?\n    # This covers the scenario where a previous action in `path` led to collection.\n    if state.inventory[i_kind_target] > 0:\n        return path # Goal achieved! Return the sequence of actions that led to this state.\n\n    # Goal Check 2: Can the 'source' entity (i_kind_source) be collected by `USE`ing at the agent's current position?\n    # This covers cases like picking up a loose item that is directly the source (e.g., a \"stick\")\n    # if the agent is standing on it.\n    if (state.grid[current_r, current_c, i_kind_source] == 1):\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n\n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        # This is crucial because using on a source might produce the target, or something else.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 3: Can the 'source' entity (i_kind_source) be collected by `USE`ing an adjacent cell?\n    # Iterate through cardinal directions to find the specific cell containing the source entity.\n    # Optimization: Use `state.next_to()` to quickly check if the source is nearby before iterating directions.\n    if state.next_to(i_kind_source):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target source entity\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind_source] == 1):\n\n                # Simulate the turning actions required to face the source entity.\n                temp_state_after_turns = state\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the *target primitive* in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., requiring tools, or multiple uses) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive (e.g., crafting a required tool).\n    # This block applies a heuristic to only explore USE when an \"interesting\" object\n    # is at the agent's current position or in front of the agent.\n    do_general_use_exploration = False\n\n    # Check if agent is currently on a grabbable item (it could be the target or a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0:\n        item_at_pos_idx = item_at_pos_idx_flat[0]\n        if item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n\n    # Check if agent is facing a workshop, a grabbable item, or another primitive resource source.\n    # Interacting with workshops, picking up tools, or harvesting resources (like trees for wood)\n    # are key scenarios covered here.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n\n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx in world.workshop_indices or\n                item_in_front_idx in world.grabbable_indices or\n                item_in_front_idx in world.cookbook.primitives): # 'primitives' here includes sources like 'tree', 'iron_ore'\n                do_general_use_exploration = True\n\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n\n        # Only add to queue if the USE action resulted in a meaningful state change.\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T10:11:55.310876", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n    This version refines the walkability check by directly leveraging NumPy's\n    `np.any` for efficiency and conciseness when determining if a cell contains\n    blocking entities. It removes the separate `_is_cell_walkable` helper function\n    from `collect_v1`, integrating its logic directly into the BFS exploration loop.\n    \n    Like previous versions, it ensures the agent finds the shortest path to a cell\n    adjacent to the target primitive and then uses the 'USE' action to collect it.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] \n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n  \n  # Define all kinds that block movement into a cell.\n  # This includes inherently non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself (agent must stand adjacent to collectible resources).\n  non_grabbable_kinds_set = current_state.world.non_grabbable_indices\n  blocking_kinds_for_movement = set(non_grabbable_kinds_set)\n  blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing in the walkability check.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front_cell is within grid bounds.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive).\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if next_pos is within bounds.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos contains any blocking kind using NumPy's any function.\n              # This check is more direct and efficient than the helper function used in v1.\n              if not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:11:56.551648", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions (height, width, kinds)\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices.\n  MOVE_FORWARD_ACTION = action_map['UP'] \n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" relative to agent's orientation.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row=0, delta_col=1)\n      1: (-1, 0),  # Facing UP: (delta_row=-1, delta_col=0)\n      2: (0, -1),  # Facing LEFT: (delta_row=0, delta_col=-1)\n      3: (1, 0)    # Facing DOWN: (delta_row=1, delta_col=0)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Prepare the set of kinds that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are \"non-grabbable\" items according to CraftWorld's definition and cannot be walked through.\n  non_grabbable_kinds_set = current_state.world.non_grabbable_indices\n\n  # Define all blocking kinds for movement into a cell.\n  # This includes inherently non-grabbable items AND the primitive itself (agent cannot walk ONTO the primitive\n  # if it's a collectible resource like WOOD or STONE; it must stand adjacent to it).\n  blocking_kinds_for_movement = set(non_grabbable_kinds_set)\n  # If the target primitive is a grabbable resource (e.g., WOOD, STONE), it should also block movement onto its cell.\n  # If it's already non-grabbable (e.g., WORKSHOP0), adding it again has no effect.\n  blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing during the `np.any` check.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action list to reach the desired state (adjacent and facing primitive)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front_cell is within grid bounds.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the front_cell contains the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive).\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if next_pos is within bounds.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          # Check if this (position, direction) state hasn't been visited to avoid redundant paths.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos contains any blocking kind using NumPy's any function.\n              # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n              if not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T10:13:18.509620", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n  # Combine all action types for iteration. The visited set correctly handles redundancy.\n  all_possible_actions = move_actions + [USE_ACT] \n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states to prevent excessive computation in very large or complex scenarios.\n  # The factor of 10 accounts for the additional state dimensions (direction, inventory).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for CraftState.step here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore all possible actions (movements and USE from current position):\n    for action in all_possible_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state hasn't been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
