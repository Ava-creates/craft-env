{"timestamp": "2025-08-01T12:28:08.782138", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by encapsulating helper functions within its scope.\"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  # This function is moved inside collect_v2 for better encapsulation.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # Helper to reconstruct path from the parent map\n  # This function is moved inside collect_v2 for better encapsulation.\n  def _reconstruct_path(end_state_key, initial_key, parent_map):\n      path = []\n      current_key = end_state_key\n      while current_key != initial_key:\n          if current_key not in parent_map:\n              # Should not happen if a path was truly found.\n              return [] \n          prev_state_key, action = parent_map[current_key]\n          path.append(action)\n          current_key = prev_state_key\n      return path[::-1] # Reverse the path to get actions from start to end\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # `visited` set stores state keys: (pos_r, pos_c, dir, inventory_tuple)\n  visited = set()\n  # `parent` dictionary maps `current_state_key` -> `(previous_state_key, action_taken_to_reach_current)`\n  parent = {} \n  # `state_object_map` maps `state_key` -> `CraftState` object. Necessary to retrieve the actual state object\n  # when expanding from a key, as `CraftState` is not directly hashable and we need to call its methods.\n  state_object_map = {}\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n\n  q.append(initial_state_key)\n  visited.add(initial_state_key)\n  state_object_map[initial_state_key] = current_state # Store the initial state object\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state_key = q.popleft() # Dequeue the state key\n    state = state_object_map[state_key] # Retrieve the actual CraftState object\n    \n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate turning actions and update parent/state maps for intermediate steps\n                temp_state_after_turns = state\n                temp_state_key_after_turns = state_key \n\n                for turn_action in turns_to_face:\n                    _, next_sim_state = temp_state_after_turns.step(turn_action)\n                    next_sim_state_key = (next_sim_state.pos[0], next_sim_state.pos[1], next_sim_state.dir, tuple(next_sim_state.inventory))\n                    \n                    # Only add to parent/state_object_map if it's a new state or found a shorter path to it (BFS guarantees shortest path if first visited)\n                    if next_sim_state_key not in visited:\n                        visited.add(next_sim_state_key) # Mark as visited to prevent cycles\n                        parent[next_sim_state_key] = (temp_state_key_after_turns, turn_action)\n                        state_object_map[next_sim_state_key] = next_sim_state \n\n                    temp_state_after_turns = next_sim_state\n                    temp_state_key_after_turns = next_sim_state_key\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Primitive successfully collected. Reconstruct full path.\n                    final_state_key_after_use = (state_after_use.pos[0], state_after_use.pos[1], state_after_use.dir, tuple(state_after_use.inventory))\n                    \n                    # Store the parent and state object for the final collection step.\n                    # This ensures the path reconstruction is accurate for the goal-achieving state,\n                    # as it explicitly records the collection action, even if the exact state key\n                    # (pos, dir, inventory) might have been encountered by a non-collecting path earlier.\n                    parent[final_state_key_after_use] = (temp_state_key_after_turns, USE_ACT)\n                    state_object_map[final_state_key_after_use] = state_after_use\n                    visited.add(final_state_key_after_use) # Mark as visited to be consistent, though we are exiting immediately.\n                    \n                    return _reconstruct_path(final_state_key_after_use, initial_state_key, parent)\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append(next_state_key)\n        parent[next_state_key] = (state_key, action) # Record parent and action\n        state_object_map[next_state_key] = next_state # Store the actual state object\n    \n    # Explore the USE action from the current position, even if not directly on the target primitive.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append(next_state_key)\n            parent[next_state_key] = (state_key, USE_ACT) # Record parent and action\n            state_object_map[next_state_key] = state_after_current_use # Store the actual state object\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T12:29:21.889640", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  This function finds the shortest sequence of actions for the agent to move\n  to a position adjacent to the specified primitive and then 'use' it.\n  It uses a Breadth-First Search (BFS) to explore possible agent states\n  (position, direction) on the grid, ensuring the generated path is optimal\n  for the given grid and movement rules.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation environment.\n      primitive (str): The name of the primitive item or location to collect/interact with\n                       (e.g., \"WOOD\", \"WORKSHOP0\", \"WATER\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., UP, LEFT, USE) to execute.\n                 Returns an empty list if the primitive is already in inventory (for collectible items)\n                 or if no path can be found to the primitive.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Get the current state of the environment.\n  \n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Early exit: If the primitive is a collectible resource and already in inventory,\n  # no actions are needed. Workshops/locations are not held in inventory, so this check\n  # correctly only applies to items like WOOD, STONE, etc.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Extract essential state information for pathfinding.\n  grid_occupancy = current_state.grid # The static grid layout for the search.\n  agent_initial_pos = current_state.pos # Agent's starting (row, column) tuple.\n  agent_initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Get grid dimensions.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_occupancy.shape\n\n  # Map symbolic actions from the environment's action specifications to their integer indices.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']   # Typically 'UP' in DMLab represents moving forward.\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define changes in (row, column) for each agent facing direction.\n  # This helps calculate the cell directly in front of the agent or the next position after moving.\n  DIRECTION_TO_DRDC = {\n      0: (0, 1),   # RIGHT: Change in column (+1)\n      1: (-1, 0),  # UP: Change in row (-1)\n      2: (0, -1),  # LEFT: Change in column (-1)\n      3: (1, 0)    # DOWN: Change in row (+1)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Determine all entity kinds that inherently block agent movement.\n  # This includes `non_grabbable_indices` from `CraftWorld` (e.g., BOUNDARY, other agents, fixed workshops).\n  # Additionally, if the target `primitive_id` itself is a collectible resource (e.g., WOOD, STONE),\n  # the agent cannot walk *onto* it but must stand *adjacent* to it. Hence, the primitive_id is also\n  # considered a blocking kind for movement into that specific cell.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  if primitive_id not in unwalkable_kind_ids: # Avoid adding if it's already a non-grabbable (like a workshop)\n      unwalkable_kind_ids.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing during grid cell checks.\n  unwalkable_kind_ids_list = list(unwalkable_kind_ids)\n\n  # BFS initialization:\n  # queue: Stores tuples of ( (agent_pos_tuple, agent_dir_int), list_of_actions_taken_to_reach_this_state )\n  queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  # visited: Stores (agent_pos_tuple, agent_dir_int) to prevent redundant exploration and cycles.\n  visited_states = {(agent_initial_pos, agent_initial_dir)}\n\n  target_reached_path = None # This will store the action sequence if a path to the primitive is found.\n\n  # === BFS Loop ===\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Goal Check: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries AND contains the target primitive.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT and\n          grid_occupancy[front_r, front_c, primitive_id] > 0):\n          \n          target_reached_path = path_so_far # Path found leading to a state adjacent and facing the primitive.\n          break # Exit BFS, as the shortest path has been found.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n      \n      # Try Move Forward action:\n      # Calculate the next position if the agent moves forward (position changes, direction remains).\n      move_dr, move_dc = DIRECTION_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT):\n          # Form the potential next state (position, direction).\n          potential_next_state = (next_pos, next_dir)\n          # Check if this state has not been visited yet.\n          if potential_next_state not in visited_states:\n              # Check if the next position is walkable. A cell is unwalkable if it contains\n              # any of the specified unwalkable_kind_ids.\n              # np.any efficiently checks if any of the specified kind indices have a count > 0 at that cell.\n              is_next_cell_walkable = not np.any(grid_occupancy[next_r, next_c, unwalkable_kind_ids_list] > 0)\n              \n              if is_next_cell_walkable:\n                  visited_states.add(potential_next_state) # Mark this state as visited.\n                  # Add the new state to the queue with the updated path of actions.\n                  queue.append((potential_next_state, path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # Try Turn Left action:\n      # Calculate the new direction after turning left (position remains unchanged).\n      next_dir_left = TURN_LEFT_DIRECTION_MAP[current_dir]\n      potential_next_state_left = (current_pos, next_dir_left)\n      # Check if this turning state has not been visited.\n      if potential_next_state_left not in visited_states:\n          visited_states.add(potential_next_state_left)\n          queue.append((potential_next_state_left, path_so_far + [ACTION_TURN_LEFT]))\n\n      # Try Turn Right action:\n      # Calculate the new direction after turning right (position remains unchanged).\n      next_dir_right = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      potential_next_state_right = (current_pos, next_dir_right)\n      # Check if this turning state has not been visited.\n      if potential_next_state_right not in visited_states:\n          visited_states.add(potential_next_state_right)\n          queue.append((potential_next_state_right, path_so_far + [ACTION_TURN_RIGHT]))\n\n  # === Post-BFS Processing ===\n  # If a path was found to reach a state adjacent and facing the primitive,\n  # append the final 'USE' action to the path.\n  if target_reached_path is not None:\n      actions_list.extend(target_reached_path)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:29:23.096719", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines pathfinding and collection logic for primitive resources or\n    interactions (e.g., crafting stations). It uses a Breadth-First Search (BFS)\n    to find the shortest sequence of movements and turns to position the agent\n    adjacent to the target primitive and facing it, followed by a 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item or location to collect/interact with\n                         (e.g., \"WOOD\", \"WATER\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute (e.g., [UP, LEFT, USE]).\n                   Returns an empty list if:\n                   - The primitive is already present in the agent's inventory.\n                   - No path to the primitive is found in the current grid configuration.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Retrieve the integer ID for the target primitive using the world's index.\n  # This ID is crucial for identifying the primitive in the grid and inventory.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Early exit optimization: If the agent already possesses the primitive in its inventory,\n  # no actions are needed to collect it. Return an empty list immediately.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Extract necessary state information for the pathfinding algorithm.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position as (row, column) tuple (y, x)\n  initial_dir = current_state.dir # Agent's starting facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get grid dimensions for boundary checks during movement.\n  WIDTH, HEIGHT, _ = initial_grid.shape # WIDTH corresponds to rows, HEIGHT to columns\n\n  # Map symbolic action names (e.g., 'UP', 'LEFT') to their corresponding integer indices\n  # as defined by the CraftLab environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # 'UP' typically means moving forward relative to agent's facing.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']           # Action to interact with/collect the primitive.\n\n  # Define changes in (row, column) for each of the four cardinal directions.\n  # This mapping is used to calculate the cell directly in front of the agent,\n  # or the new position after a 'Move Forward' action.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: No change in row, +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row, no change in column.\n      2: (0, -1),  # Facing LEFT: No change in row, -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row, no change in column.\n  }\n\n  # Define how the agent's facing direction changes when executing 'Turn Left' or 'Turn Right'.\n  # Directions wrap around (e.g., turning left from UP (1) results in LEFT (2), turning right from RIGHT (0) results in DOWN (3)).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Right -> Down -> Left -> Up -> Right\n\n  # Identify all entity kinds that inherently block agent movement into a cell.\n  # This set includes `non_grabbable_indices` (e.g., BOUNDARY, WATER, workshop types like WORKSHOP0)\n  # and the `primitive_id` itself if it's a collectible resource (e.g., WOOD, STONE).\n  # The agent should stand *adjacent* to these items to interact/collect, not *on* them.\n  blocking_kinds_for_movement = set(current_state.world.non_grabbable_indices)\n  if primitive_id not in blocking_kinds_for_movement:\n      blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set of blocking kinds into a NumPy array. This allows for\n  # efficient vectorized checks on the `initial_grid` using NumPy's advanced indexing.\n  blocking_kinds_for_movement_array = np.array(list(blocking_kinds_for_movement), dtype=int)\n\n  # Initialize Breadth-First Search (BFS) data structures:\n  # The `queue` stores `((current_position, current_direction), list_of_actions_to_reach_this_state)`.\n  # BFS guarantees finding the shortest path in terms of the number of actions.\n  # The `visited` set stores `(position_tuple, direction_int)` pairs to prevent\n  # redundant exploration of states and to avoid infinite loops in cyclic paths.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the final sequence of actions if a path to the primitive is found.\n\n  # BFS main loop: Continues as long as there are states to explore in the queue.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Extract current row and column of the agent.\n\n      # --- 1. Goal Check: Determine if the target primitive is directly in front of the agent ---\n      # Calculate the coordinates of the cell one step forward from the agent's current position and direction.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # First, check if the calculated front cell is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # If within bounds, check if this cell contains the primitive we are looking for.\n          # `initial_grid[front_r, front_c, primitive_id] > 0` verifies that at least one unit\n          # of the target primitive exists at this location.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # A path to be adjacent and facing the primitive is found.\n              break # Exit the BFS loop, as we have found the shortest path.\n\n      # --- 2. Explore Possible Next Actions: Move Forward, Turn Left, Turn Right ---\n      \n      # Try 'Move Forward' action:\n      # Calculate the agent's next potential position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential `next_pos` is within the grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this specific `(position, direction)` state has not been visited before.\n          if (next_pos, next_dir) not in visited:\n              # Determine if the `next_pos` cell is walkable. A cell is considered non-walkable\n              # if it contains any item listed in `blocking_kinds_for_movement_array`.\n              # `np.any(array > 0)` efficiently checks if any of the specified kind counts are positive.\n              is_walkable = not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_array] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir)) # Mark this new state as visited.\n                  # Add the new state to the queue along with the path of actions taken to reach it.\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try 'Turn Left' action:\n      # Calculate the agent's new direction after turning left. The agent's position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this `(current_position, new_direction)` state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try 'Turn Right' action:\n      # Calculate the agent's new direction after turning right. The agent's position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this `(current_position, new_direction)` state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS search completes:\n  # If `target_path_actions` is not None, it means a valid path was found to reach a position\n  # adjacent to and facing the primitive. The final step is to append the `USE_ACTION`.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:30:14.873068", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # Defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it).\n  all_unwalkable_ids = set(current_state.world.non_grabbable_indices)\n  all_unwalkable_ids.add(primitive_id) \n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # This is the goal condition: being adjacent to the primitive and facing it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found!\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable\n          is_walkable = True\n          # A cell is walkable if it does not contain any of the unwalkable kinds.\n          for kind_idx in all_unwalkable_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to the sequence.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:30:16.100118", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function implements a Breadth-First Search (BFS) to find the shortest\n    sequence of actions (movements and turns) that leads the agent to a state\n    where it is adjacent to and facing the target primitive. Once such a state\n    is reached, a 'USE' action is appended to the path.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is not found or reachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial (row, col) position\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:R, 1:U, 2:L, 3:D)\n\n  # Retrieve the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions (Numpy array shape is (rows, cols, depth))\n  GRID_HEIGHT, GRID_WIDTH, _ = initial_grid.shape\n\n  # Map DSL action names to their corresponding integer indices from the environment's action specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In DMLab-like environments, 'UP' often means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for agent movement (row_change, col_change)\n  # when moving forward in each facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (move right)\n      1: (-1, 0),  # Facing UP: -1 to row (move up)\n      2: (0, -1),  # Facing LEFT: -1 to column (move left)\n      3: (1, 0)    # Facing DOWN: +1 to row (move down)\n  }\n\n  # Define how agent's direction changes when turning (new_direction)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that are impassable (e.g., boundaries, water, workshops).\n  # The agent cannot move onto cells containing these kinds.\n  non_walkable_kind_ids = set(current_state.world.non_grabbable_indices)\n\n  # BFS setup:\n  # queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # visited set stores (position_tuple, direction_int) to avoid revisiting states and infinite loops\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # To store the action sequence once the target is found\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check for goal condition: Is the primitive directly in front of the agent?\n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < GRID_HEIGHT and 0 <= front_c < GRID_WIDTH):\n          # Check if this cell contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Found a path to be adjacent to and facing the primitive! Exit BFS.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within grid boundaries\n      if (0 <= next_r < GRID_HEIGHT and 0 <= next_c < GRID_WIDTH):\n          # Check if this (position, direction) state has been visited to prevent cycles\n          if (next_pos, next_dir_after_move) not in visited:\n              \n              # Determine if the next position is walkable\n              is_walkable = True\n              # Check against all known non-walkable entity types\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # The agent also cannot walk *onto* the primitive itself; it must stop adjacent to it.\n              if initial_grid[next_r, next_c, primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir_after_move))\n                  queue.append(((next_pos, next_dir_after_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to an adjacent and facing state, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T12:31:12.357778", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information from the current CraftState for pathfinding\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This ID is used to identify the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # --- Improvement for v2: Early exit if the primitive is not present on the grid ---\n  # If the target primitive doesn't exist anywhere on the map, there's no path to find.\n  # This avoids unnecessary BFS computation.\n  if not np.any(initial_grid[:, :, primitive_id] > 0):\n      return [] # Primitive does not exist on the map, return empty action list.\n\n  # Retrieve action mapping from the environment (these are constant action IDs)\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Interact with the cell in front\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics)\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector\n  # which indicates the cell directly in front of the agent for movement/interaction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell (r, c) is valid and walkable for the agent.\n  def is_cell_walkable(r, c):\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent.\n      A cell is considered walkable if:\n      1. It falls within the grid boundaries.\n      2. It does not contain the target primitive itself (agent interacts from an adjacent cell).\n      3. It does not contain any non-grabbable entities (impassable terrain like water, boundaries, etc.).\n      \"\"\"\n      # 1. Check if the position is within grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Check if the cell contains the target primitive.\n      # The agent interacts with primitives from an adjacent square, not by stepping onto them.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      # Iterate through the indices of known non-walkable kinds. If any are present, the cell is not walkable.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # This represents a unique state (agent's position and orientation) and the path to achieve it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path to the goal is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Goal Check: Is the primitive directly in front of the agent from the current state?\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # Action 1: Try Move Forward\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r_fwd, next_c_fwd = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is valid and walkable, and this new (position, direction) state\n      # has not been visited yet.\n      if is_cell_walkable(next_r_fwd, next_c_fwd) and (next_pos_fwd, next_dir_fwd) not in visited:\n          # If walkable and unvisited, add the new state to the queue and mark it as visited.\n          visited.add((next_pos_fwd, next_dir_fwd))\n          queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action 2: Try Turn Left\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_pos_left = current_pos # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if (next_pos_left, next_dir_left) not in visited:\n          # Add the new state to the queue and mark as visited.\n          visited.add((next_pos_left, next_dir_left))\n          queue.append(((next_pos_left, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action 3: Try Turn Right\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_pos_right = current_pos # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if (next_pos_right, next_dir_right) not in visited:\n          # Add the new state to the queue and mark as visited.\n          visited.add((next_pos_right, next_dir_right))\n          queue.append(((next_pos_right, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
