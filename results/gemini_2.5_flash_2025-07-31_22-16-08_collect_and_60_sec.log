l_dir)}\n\n  target_path_actions = None # Stores the shortest sequence of actions to reach the \"ready to use\" state.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent in the current state.\n      # This is the \"goal\" condition for the BFS (agent is adjacent and facing the primitive).\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the shortest path\n          # to a state where the agent can 'USE' the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to the target interaction state found, terminate BFS.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid bounds and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' cell is walkable.\n          # A cell is not walkable if it contains any 'blocking_kind' (like boundaries, water).\n          # Also, the agent cannot walk *onto* the primitive itself; it must stand *adjacent* to it.\n          is_walkable = True\n          for kind_idx in blocking_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Prevent walking onto the primitive itself. This applies to grabbable items (like WOOD)\n          # and also provides a redundant check for non-grabbable items if they are the primitive.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to the \"ready to use\" state, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:53:41.647631", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid\n  start_pos = current_state.pos # tuple (r, c)\n  start_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  target_primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = grid_snapshot.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP'] # Agent moves forward in its current direction\n  TURN_LEFT = action_map['LEFT']   # Agent turns left in place\n  TURN_RIGHT = action_map['RIGHT'] # Agent turns right in place\n  USE_ACTION = action_map['USE']   # Agent uses the item in front of it\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given cell (r, c) is walkable for the agent.\n  # A cell is not walkable if it's out of bounds, contains a non-grabbable entity,\n  # or is the target primitive itself (as the agent needs to be adjacent to use it).\n  def is_walkable_cell(r_coord, c_coord, primitive_id_to_collect):\n    # Check grid boundaries\n    if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n      return False\n    \n    # Check if cell contains any entity that blocks movement\n    for kind_idx in non_walkable_kind_ids:\n      if grid_snapshot[r_coord, c_coord, kind_idx] > 0:\n        return False\n    \n    # Agent cannot walk onto the primitive it wants to collect; it must be adjacent to use it.\n    if grid_snapshot[r_coord, c_coord, primitive_id_to_collect] > 0:\n        return False\n\n    return True\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(start_pos, start_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at the current state.\n      # If so, this is a valid state to perform the USE action to collect it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if grid_snapshot[front_r, front_c, target_primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found! (agent is adjacent to and facing the primitive)\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next_pos is walkable and this state hasn't been visited\n      if is_walkable_cell(next_r, next_c, target_primitive_id):\n          if (next_pos, next_dir_after_move) not in visited:\n              visited.add((next_pos, next_dir_after_move))\n              queue.append(((next_pos, next_dir_after_move), path_actions + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT]))\n\n  # If a path was found, append the USE action to the sequence of actions.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:53:42.954358", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid\n  start_pos = current_state.pos  # (row, col)\n  start_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  target_primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = grid_snapshot.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # Used to calculate the cell in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: row stays same, col increases\n      1: (-1, 0),  # Facing UP: row decreases, col stays same\n      2: (0, -1),  # Facing LEFT: row stays same, col decreases\n      3: (1, 0)    # Facing DOWN: row increases, col stays same\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R(0)->U(1)->L(2)->D(3)->R(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R(0)->D(3)->L(2)->U(1)->R(0)\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS queue: stores ((current_r, current_c), current_dir), list_of_actions_to_reach_here\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Visited set: stores (current_pos_tuple, current_dir_int) to prevent redundant exploration\n  visited = {(start_pos, start_dir)}\n\n  target_path_actions = None # To store the path of actions once the target is found\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is directly in front of the agent at the current state.\n      # If so, this is a valid state from which to perform the USE action.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if grid_snapshot[front_r, front_c, target_primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Option 1: Try Moving Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within grid boundaries\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state has not been visited yet\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              \n              # Determine if the target cell (next_r, next_c) is walkable.\n              # It must not contain any non-grabbable entities or the primitive itself (agent cannot walk onto primitive).\n              is_walkable = True\n              for kind_idx in non_walkable_kind_ids:\n                  if grid_snapshot[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              \n              # Agent cannot walk directly onto the primitive it wants to collect;\n              # it must remain adjacent to \"use\" it.\n              if is_walkable and grid_snapshot[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos_after_move, next_dir_after_move))\n                  queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD]))\n\n      # --- Option 2: Try Turning Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT]))\n\n      # --- Option 3: Try Turning Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT]))\n\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:54:32.444322", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial (row, column) position\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the primitive we want to collect\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve mapping of action names to their integer indices from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' typically means moving forward relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) corresponding to agent's facing direction\n  # Used to calculate the cell in front of the agent for movement\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: +1 to column\n      1: (-1, 0),  # UP: -1 to row\n      2: (0, -1),  # LEFT: -1 to column\n      3: (1, 0)    # DOWN: +1 to row\n  }\n\n  # Maps for updating the agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Define what constitutes an obstacle for agent movement.\n  # These are entities the agent cannot walk onto.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # If the target primitive itself is a grabbable item (e.g., WOOD, STONE),\n  # the agent should stand *adjacent* to it to collect, not on the same tile.\n  # Therefore, the primitive's own ID is also considered an obstacle for movement.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # --- Initial Check: Is the primitive already collectible from the current position? ---\n  # The `CraftState.next_to` method checks if the primitive is in the 3x3 neighborhood.\n  if current_state.next_to(primitive_id):\n      # If so, we just need to use the item. No pathfinding required.\n      return [USE_ACTION]\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # BFS state: ((row, col), direction), list_of_actions_taken\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), path_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (agent_position_tuple, agent_direction_int) to prevent cycles\n  # and re-exploring states already visited via a shorter or equal path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions to reach a collectable state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # --- Check if the current BFS state is a \"goal\" state for collection ---\n      # A goal state means the primitive is in the 3x3 neighborhood of the agent's current position (r, c).\n      # This manually replicates the logic of `CraftState.next_to` but for an arbitrary (r,c) in BFS.\n      is_collectable_from_current_pos = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectable_from_current_pos = True\n                  break # Found the primitive in the neighborhood\n          if is_collectable_from_current_pos:\n              break\n\n      if is_collectable_from_current_pos:\n          # A position from which the primitive can be collected has been found.\n          target_path_actions = path_actions\n          break # Shortest path found, terminate BFS\n\n      # --- Explore possible next actions from the current state ---\n\n      # 1. Try moving forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check bounds and if the next cell is walkable and this state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next cell contains any obstacle\n          is_walkable = True\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # --- After BFS: Construct the final action list ---\n  if target_path_actions is not None:\n      # If a path to a collectable position was found, extend the actions list with it\n      actions_list.extend(target_path_actions)\n      # Finally, append the USE action to collect the primitive\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:54:33.582846", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward or checking the cell in front\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Determine obstacles for agent movement\n  # This includes non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # and the primitive itself if it's a grabbable item (as agent interacts from adjacent cell)\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n\n  # --- Nested Helper Functions for Readability ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is walkable for the agent.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any obstacle\n      for kind_idx in obstacles_to_movement_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains an obstacle\n\n      return True\n\n  def _is_primitive_in_front_of_agent(agent_r, agent_c, agent_dir):\n      \"\"\"Checks if the target primitive is in the cell directly in front of the agent given its position and direction.\"\"\"\n      dr, dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = agent_r + dr, agent_c + dc\n      \n      # Check if the cell in front is within bounds and contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          return True\n      return False\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already in front of the agent's initial position and direction,\n  # no pathfinding is needed; just use the item.\n  if _is_primitive_in_front_of_agent(initial_pos[0], initial_pos[1], initial_dir):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable state\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (position and direction) is a \"goal\" state for collection.\n      # A goal state means the primitive is directly in front of the agent's current (r, c) and direction.\n      if _is_primitive_in_front_of_agent(r, c, current_dir):\n          target_path = path_actions # Path to reach this collectable state\n          break # Shortest path found, terminate BFS\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Only add to queue if the next cell is walkable and this state hasn't been visited\n      if _is_cell_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position and orientation was found, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:55:47.331436", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE' (e.g., workshops, boundaries),\n  # we return an empty list as it implies it's not meant to be picked up into inventory.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory\n  # and considering intermediate 'USE' actions. This is a heuristic and may need tuning.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check:\n    # 6a. Check if the grabbable primitive can be collected from the agent's current cell.\n    # This covers cases where the agent is standing directly on a grabbable item and can pick it up.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify if the USE action successfully collected the item from the current spot.\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Item collected from current position.\n    \n    # 6b. Check if the primitive can be collected from an adjacent cell (cardinal directions).\n    # `state.next_to(i_kind)` checks the 3x3 neighborhood. We then iterate through cardinal directions\n    # to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing coordinates are within grid bounds and contain the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible next states:\n    # 6c. Explore movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 6d. Explore the general 'USE' action from the current position.\n    # This is crucial for acquiring tools or interacting with environmental elements\n    # that are not the target primitive but are necessary for subsequent collection steps.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or within the `MAX_EXPLORED_STATES` limit.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:55:48.744497", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:56:52.592264", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  \n  # Defensive checks:\n  # 1. If primitive name is not found in the index.\n  # 2. If the primitive is not a grabbable item (e.g., it's a workshop, boundary, or recipe output).\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0), moves +1 in column\n      1: (-1, 0),  # Facing UP (1), moves -1 in row\n      2: (0, -1),  # Facing LEFT (2), moves -1 in column\n      3: (1, 0)    # Facing DOWN (3), moves +1 in row\n  }\n\n  # Maps for turning left/right, updating the agent's direction (0-3).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Indices of entities that act as obstacles and cannot be walked through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n  \n  def is_cell_in_bounds(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  def is_cell_walkable(r, c):\n      \"\"\"Checks if the given grid cell (r, c) is a valid location for the agent to move into.\"\"\"\n      if not is_cell_in_bounds(r, c):\n          return False\n      \n      # Agent cannot walk onto non-grabbable items that act as obstacles.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk onto the target primitive itself; it must stop adjacent to it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  def is_goal_achieved(agent_pos, agent_dir):\n      \"\"\"Checks if the primitive is directly in front of the agent at agent_pos, facing agent_dir.\"\"\"\n      r, c = agent_pos\n      front_dr, front_dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not is_cell_in_bounds(front_r, front_c):\n          return False # Cell in front is out of bounds\n      \n      # Check if the primitive is present in the cell directly in front.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # BFS setup:\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a path is found.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the goal condition.\n      # This check needs to be done *before* exploring next steps,\n      # as the current (pos, dir) might already be the goal state.\n      if is_goal_achieved(current_pos, current_dir):\n          target_path = path_actions\n          break # Path to target found! Exit BFS.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right).\n      \n      # --- Explore Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      if is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Explore Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Explore Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found, append the USE action to complete the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T06:56:53.913149", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid # Use a clearer name for the static grid state\n  initial_pos = current_state.pos    # Agent's starting position (row, col)\n  initial_dir = current_state.dir    # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Early exit: If the primitive name is not valid (not in the index)\n  # or if it's not a grabbable item (e.g., a workshop or boundary),\n  # we cannot 'collect' it using the USE action in this context.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  # Extract grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_snapshot.shape\n\n  # Map DSL action names to their integer IDs provided by the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' typically means move forward in current dir.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors (delta_row, delta_col) for agent movement.\n  # The agent's direction (dir) is usually an integer: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT: moving forward increases column index by 1.\n      1: (-1, 0),  # Facing UP: moving forward decreases row index by 1.\n      2: (0, -1),  # Facing LEFT: moving forward decreases column index by 1.\n      3: (1, 0)    # Facing DOWN: moving forward increases row index by 1.\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT (Counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT (Clockwise)\n\n  # Retrieve indices of entities that act as obstacles in the environment.\n  # These are typically non-grabbable items like boundaries, water, or workshop locations.\n  non_walkable_entities = current_state.world.non_grabbable_indices\n\n  # BFS state representation: ((row, col), direction).\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and ensure that the shortest path (in terms of action count) is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions leading to the collection point.\n\n  # Perform Breadth-First Search to find the shortest path to the primitive.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Goal Check: Determine if the agent is currently in a \"goal state\"\n      # where the primitive can be collected. A goal state means the primitive\n      # is directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc # Coordinates of the cell directly in front.\n      \n      # Check if the cell in front is within the grid boundaries.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the cell directly in front contains the target primitive.\n          if grid_snapshot[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # A path to the collection point has been found!\n              break # Exit BFS as the shortest path is guaranteed by BFS.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n      \n      # --- Explore Move Forward action ---\n      # Calculate the next position if the agent moves forward. The direction remains unchanged.\n      move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n      next_r_fwd, next_c_fwd = r + move_dr, c + move_dc\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir\n\n      # Check if the potential next state (position, direction) is valid and hasn't been visited.\n      if (0 <= next_r_fwd < GRID_WIDTH and 0 <= next_c_fwd < GRID_HEIGHT and\n          (next_pos_fwd, next_dir_fwd) not in visited):\n          \n          is_walkable = True\n          # A cell is considered non-walkable if it contains any obstacle entity.\n          for kind_idx in non_walkable_entities:\n              if grid_snapshot[next_r_fwd, next_c_fwd, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Crucially, the agent should not walk *onto* the primitive itself,\n          # as the 'USE' action operates on the cell *in front* of the agent.\n          if grid_snapshot[next_r_fwd, next_c_fwd, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos_fwd, next_dir_fwd))\n              queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Explore Turn Left action ---\n      # Turning only changes the agent's direction, not its position.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Explore Turn Right action ---\n      # Turning only changes the agent's direction, not its position.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a valid path to the primitive was found (or if the agent started in a collectible state),\n  # extend the `actions_list` with the path and then append the `USE_ACTION`.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:57:39.682847", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction for pathfinding.\n  # The grid is considered static during pathfinding; only agent's (pos, dir) changes.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting row, column tuple (r, c)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions to check boundaries during pathfinding.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # --- Early Exit: If the primitive is not grabbable, collecting it is not possible. ---\n  # This includes things like BOUNDARY, WATER, WORKSHOP_X as defined in the DSL as primitives,\n  # which are part of `non_grabbable_indices`.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving forward based on current orientation.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 column\n      1: (-1, 0),  # Facing UP (1): move -1 row\n      2: (0, -1),  # Facing LEFT (2): move -1 column\n      3: (1, 0)    # Facing DOWN (3): move +1 row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define entities that block agent movement.\n  # These are typically non-grabbable structures like boundaries, water, workshops.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # A grabbable primitive itself also acts as an obstacle to movement;\n  # the agent should not move *onto* the primitive's square to collect it.\n  # Instead, it should position itself adjacent and use 'USE'.\n  # This is only added if it's grabbable, which is ensured by the early exit above.\n  obstacles_to_movement_indices.add(primitive_id)\n\n  # --- Nested Helper Functions ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is within bounds and does not contain any obstacle.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any defined obstacle kind.\n      # The `initial_grid` represents the fixed map layout.\n      for kind_idx in obstacles_to_movement_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains a non-walkable item/obstacle\n\n      return True\n\n  def _is_primitive_in_front_of_agent(agent_r, agent_c, agent_dir):\n      \"\"\"Checks if the target primitive is in the cell directly in front of the agent.\"\"\"\n      dr, dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = agent_r + dr, agent_c + dc\n      \n      # Check bounds for the cell in front\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False\n      \n      # Check if the primitive is in that front cell.\n      # `initial_grid` is used because the map contents don't change during pathfinding.\n      if initial_grid[front_r, front_c, primitive_id] > 0:\n          return True\n      return False\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already directly in front of the agent's initial position\n  # and orientation, we can just perform the USE action without pathfinding.\n  if _is_primitive_in_front_of_agent(initial_pos[0], initial_pos[1], initial_dir):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to a collectable state.\n\n  # Main BFS loop: continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent state (position and direction) is a goal state,\n      # meaning the primitive is directly in front and ready for collection.\n      if _is_primitive_in_front_of_agent(r, c, current_dir):\n          target_path_actions = path_actions # A shortest path to this collectible state is found.\n          break # Terminate BFS; no need to explore further as BFS finds the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # If the next cell is walkable and this (position, direction) state has not been visited:\n      if _is_cell_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir)) # Mark the new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position and orientation was found,\n  # append the final 'USE' action to perform the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:57:40.995714", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Store initial grid, position, and direction.\n  # The grid is considered static for pathfinding.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting row, column tuple (r, c)\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving forward based on current orientation.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 column (East)\n      1: (-1, 0),  # Facing UP (1): move -1 row (North)\n      2: (0, -1),  # Facing LEFT (2): move -1 column (West)\n      3: (1, 0)    # Facing DOWN (3): move +1 row (South)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # --- Obstacle Definition for Movement ---\n  # These are entities that the agent cannot walk *onto*.\n  # Includes fixed environment elements like boundaries, water, workshops.\n  unwalkable_entities_indices = set(current_state.world.non_grabbable_indices)\n  \n  # A grabbable primitive itself also acts as an obstacle to movement;\n  # the agent should not move *onto* the primitive's square to collect it.\n  # Instead, it should position itself adjacent and use 'USE'.\n  # Only add it to unwalkable if it's actually something that can be picked up.\n  if primitive_id in current_state.world.grabbable_indices:\n      unwalkable_entities_indices.add(primitive_id)\n  else:\n      # If the primitive is not grabbable (e.g., BOUNDARY, WATER, WORKSHOP_X),\n      # there's no way to \"collect\" it. Return empty action list.\n      return []\n\n  # --- Helper Functions ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is within bounds and does not contain any obstacle.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any defined unwalkable kind.\n      # The `initial_grid` represents the fixed map layout.\n      for kind_idx in unwalkable_entities_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains a non-walkable item/obstacle\n\n      return True\n\n  def _is_primitive_in_front_of_agent(agent_r, agent_c, agent_dir):\n      \"\"\"Checks if the target primitive is in the cell directly in front of the agent.\"\"\"\n      dr, dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = agent_r + dr, agent_c + dc\n      \n      # Check bounds for the cell in front\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False\n      \n      # Check if the primitive is in that front cell.\n      if initial_grid[front_r, front_c, primitive_id] > 0:\n          return True\n      return False\n  # --- End of Helper Functions ---\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples:\n  #   ((current_position_tuple (r, c), current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and redundant computations, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to a collectable state.\n\n  # Main BFS loop: continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent state (position and direction) is a goal state,\n      # meaning the primitive is directly in front and ready for collection.\n      if _is_primitive_in_front_of_agent(r, c, current_dir):\n          target_path_actions = path_actions # A shortest path to this collectible state is found.\n          break # Terminate BFS; no need to explore further as BFS finds the shortest path.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # If the next cell is walkable and this (position, direction) state has not been visited:\n      if _is_cell_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir)) # Mark the new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position and orientation was found,\n  # append the final 'USE' action to perform the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:58:47.283418", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get essential environment details from the current state\n  grid = current_state.grid\n  agent_start_pos = current_state.pos  # Agent's initial position (row, col)\n  agent_start_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the primitive name (e.g., \"WOOD\") to its numerical ID (integer index)\n  # This ID is used to check for the primitive's presence on the grid.\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions for boundary checks during movement\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  # These are the integers that `env.step()` expects.\n  action_codes = env.action_specs()\n  ACTION_FORWARD = action_codes['UP']      # Moves agent forward in its current direction\n  ACTION_TURN_LEFT = action_codes['LEFT']   # Turns agent 90 degrees left\n  ACTION_TURN_RIGHT = action_codes['RIGHT'] # Turns agent 90 degrees right\n  ACTION_USE = action_codes['USE']         # Interacts with the entity directly in front of the agent\n\n  # Mapping agent's direction (0-3) to a (delta_row, delta_column) vector.\n  # This vector indicates the change in coordinates for the cell directly in front of the agent.\n  DIRECTION_TO_FRONT_CELL_DELTAS = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col+1)\n      1: (-1, 0),  # Facing UP (North): (row-1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col-1)\n      3: (1, 0)    # Facing DOWN (South): (row+1, col)\n  }\n\n  # Mappings for the new direction after performing a turn.\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT(0) -> UP(1)\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT(0) -> DOWN(3)\n\n  # Get the set of integer IDs for entities that are considered non-walkable terrain.\n  # These are obstacles the agent cannot move onto (e.g., boundaries, water, workshop locations).\n  impassable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([((agent_start_pos, agent_start_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(agent_start_pos, agent_start_dir)}\n\n  # This variable will store the action sequence if a path is found,\n  # leading the agent to be adjacent to and facing the primitive (before the 'USE' action).\n  path_to_target_adjacency = None \n\n  # BFS Traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check for Goal State: Is the target primitive directly in front of the agent?\n      # This is the \"adjacency\" state we're searching for before performing the 'USE' action.\n      dr_front, dc_front = DIRECTION_TO_FRONT_CELL_DELTAS[current_dir]\n      front_cell_r, front_cell_c = current_row + dr_front, current_col + dc_front\n      \n      # Ensure the cell directly in front is within grid boundaries.\n      if (0 <= front_cell_r < num_rows and 0 <= front_cell_c < num_cols):\n          # If the primitive is present in this 'front' cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if grid[front_cell_r, front_cell_c, primitive_kind_id] > 0:\n              path_to_target_adjacency = path_so_far # Store the sequence of actions that led to this state.\n              break # Path found! Terminate BFS as we found the shortest path to the interaction point.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # A) Try ACTION_FORWARD\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_pos_fwd = (front_cell_r, front_cell_c) # Agent moves into the cell that was previously \"front\".\n      next_dir_fwd = current_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_pos_fwd[0] < num_rows and 0 <= next_pos_fwd[1] < num_cols and\n          (next_pos_fwd, next_dir_fwd) not in visited):\n          \n          # Determine if the next cell is walkable.\n          is_walkable = True\n          \n          # The agent cannot walk onto the primitive itself, as interaction is from an adjacent square.\n          if grid[next_pos_fwd[0], next_pos_fwd[1], primitive_kind_id] > 0:\n              is_walkable = False\n          \n          # The agent also cannot walk onto any entities marked as generally impassable.\n          # This includes boundaries, water, workshops, etc.\n          # We use `any()` with a generator expression for efficiency to check if any impassable kind is present.\n          if is_walkable and any(grid[next_pos_fwd[0], next_pos_fwd[1], kind_idx] > 0 for kind_idx in impassable_kind_ids):\n              is_walkable = False\n\n          if is_walkable:\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos_fwd, next_dir_fwd))\n              queue.append(((next_pos_fwd, next_dir_fwd), path_so_far + [ACTION_FORWARD]))\n\n      # B) Try ACTION_TURN_LEFT\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_DIRECTION_MAP[current_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # C) Try ACTION_TURN_RIGHT\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      # Check if this new state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # 3. Finalize Actions:\n  # After BFS completes:\n  # If a path to the target state (agent adjacent and facing the primitive) was found,\n  # append the final 'USE' action to the discovered path. This completes the collection sequence.\n  # If no path was found (path_to_target_adjacency remains None), an empty list is returned.\n  final_action_sequence = []\n  if path_to_target_adjacency is not None:\n      final_action_sequence.extend(path_to_target_adjacency)\n      final_action_sequence.append(ACTION_USE)\n\n  return final_action_sequence", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:58:48.388686", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # --- IMPROVEMENT FOR COLLECT_V2 ---\n  # If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n  # ----------------------------------\n\n  # 1. Extract Current State Information for Pathfinding\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's initial position (row, col)\n  start_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get grid dimensions for boundary checks during movement.\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  ACT_FORWARD = action_map['UP']      # Moves agent forward in its current direction\n  ACT_LEFT = action_map['LEFT']       # Turns agent 90 degrees left\n  ACT_RIGHT = action_map['RIGHT']     # Turns agent 90 degrees right\n  ACT_USE = action_map['USE']         # Interacts with the entity directly in front\n\n  # 2. Define Agent Movement and Direction Mechanics\n  # DRDC: Maps agent's direction (0-3) to a (delta_row, delta_column) vector.\n  # This vector indicates the change in coordinates for the cell directly in front of the agent.\n  DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col+1)\n      1: (-1, 0),  # Facing UP (North): (row-1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col-1)\n      3: (1, 0)    # Facing DOWN (South): (row+1, col)\n  }\n\n  # TURN_L_MAP / TURN_R_MAP: Map current direction to the new direction after a turn.\n  TURN_L_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT(0) -> UP(1)\n  TURN_R_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT(0) -> DOWN(3)\n\n  # Get indices of entities that are considered non-walkable terrain (e.g., boundaries, water, certain workshops).\n  impassable_ids = current_state.world.non_grabbable_indices\n\n  # 3. BFS Initialization\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(start_pos, start_dir)}\n\n  # This variable will store the action sequence if a path is found,\n  # leading the agent to be adjacent to and facing the primitive (before the 'USE' action).\n  found_path = None \n\n  # 4. BFS Traversal\n  while queue:\n      (curr_pos, curr_dir), path_actions = queue.popleft()\n      r, c = curr_pos # Unpack current row and column.\n\n      # Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      dr, dc = DRDC[curr_dir]\n      front_r, front_c = r + dr, c + dc\n      \n      # Ensure the cell directly in front is within grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this 'front' cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if grid[front_r, front_c, primitive_id] > 0:\n              found_path = path_actions # Store the sequence of actions that led to this state.\n              break # Path found! Terminate BFS as we found the shortest path.\n\n      # 5. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # A) Try Move Forward Action\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_pos_fwd = (front_r, front_c) # Agent moves into the cell that was previously \"front\".\n      next_dir_fwd = curr_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_pos_fwd[0] < num_rows and 0 <= next_pos_fwd[1] < num_cols and\n          (next_pos_fwd, next_dir_fwd) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          #   a) The primitive itself (interaction is from an adjacent square, not by stepping on it).\n          #   b) Any non-grabbable/impassable entities (like boundaries, water, or specific workshops).\n          is_walkable = True\n          # First, check if the cell contains the primitive we are looking for.\n          if grid[next_pos_fwd[0], next_pos_fwd[1], primitive_id] > 0:\n              is_walkable = False\n          else: # If not the primitive, check other impassable kinds.\n              for kind_idx in impassable_ids:\n                  if grid[next_pos_fwd[0], next_pos_fwd[1], kind_idx] > 0:\n                      is_walkable = False\n                      break\n\n          if is_walkable:\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos_fwd, next_dir_fwd))\n              queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [ACT_FORWARD]))\n\n      # B) Try Turn Left Action\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_L_MAP[curr_dir]\n      # Check if this new state (same position, new direction) has not been visited.\n      if ((curr_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((curr_pos, next_dir_left))\n          queue.append(((curr_pos, next_dir_left), path_actions + [ACT_LEFT]))\n\n      # C) Try Turn Right Action\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_R_MAP[curr_dir]\n      # Check if this new state has not been visited.\n      if ((curr_pos, next_dir_right) not in visited):\n          visited.add((curr_pos, next_dir_right))\n          queue.append(((curr_pos, next_dir_right), path_actions + [ACT_RIGHT]))\n\n  # 6. Finalize Actions\n  # After BFS completes:\n  # If a path to the target state (agent adjacent and facing the primitive) was found,\n  # append the final 'USE' action to the discovered path. This completes the collection sequence.\n  # If no path was found (found_path remains None), an empty list is returned.\n  final_actions = []\n  if found_path is not None:\n      final_actions = found_path + [ACT_USE]\n\n  return final_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:00:35.370088", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # IMPROVEMENT for collect_v2: Dynamically scale MAX_EXPLORED_STATES based on n_kinds.\n  # The factor '10' from collect_v1 is replaced by 'len(world.cookbook.kinds)' to better account\n  # for the potential complexity of inventory states, as more distinct items in the world\n  # mean more possible inventory combinations that might need to be explored.\n  # Adding 1 to ensure the multiplier is at least 1.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Check for primitive directly under the agent's feet.\n    if state.grid[current_r, current_c, i_kind] == 1: # The item is present at agent's current position\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count increased after USE action\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:00:37.124005", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook (this is the desired item for inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' kind on the grid that needs to be interacted with\n  # (e.g., 'tree' to get 'wood', or 'water' to get 'water').\n  i_kind_source = -1 # Default to an invalid value\n\n  # Case A: Primitive is directly grabbable (appears on grid and can be picked up)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: Primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # These mappings are derived from the environment's crafting and gathering logic.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\", \n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Add other mappings if the environment contains more implicit resource sources.\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n      \n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource and no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid \n          # (e.g., it's a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid, it means the primitive cannot be collected by this function's logic.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # as inventory changes can open up new possibilities (e.g., gaining a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Max explored states is a heuristic to prevent excessively long searches,\n  # especially with complex inventory dynamics. Increased from v1.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Is the 'source' entity (e.g., 'tree') at the agent's current position?\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Is the 'source' entity (e.g., 'tree') in an adjacent cell?\n    # Iterate through cardinal directions to find the specific cell containing the source entity.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds and contains the target source entity\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Simulate the turning actions required to face the source entity.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the *target primitive* in inventory actually increase?\n            # This verifies successful collection, accounting for any internal game rules\n            # (e.g., requiring tools) implemented in `CraftState.step`.\n            if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
