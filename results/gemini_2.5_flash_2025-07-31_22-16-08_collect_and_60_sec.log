: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get the set of integer indices for entities that the agent cannot walk onto.\n  # This typically includes boundaries, water, and specific workshop types.\n  impassable_entity_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given cell (r, c) is a valid and walkable location for the agent.\n  # A cell is walkable if it's within bounds, doesn't contain impassable entities, and isn't the primitive itself.\n  def is_walkable_destination(r: int, c: int) -> bool:\n      # First, check if the cell is within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Second, check if the cell contains any impassable entities.\n      # The agent cannot move into cells occupied by these types of objects.\n      for entity_id in impassable_entity_ids:\n          if initial_grid[r, c, entity_id] > 0:\n              return False\n      \n      # Third, the agent cannot walk onto the primitive it intends to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      # If all checks pass, the cell is safe and walkable.\n      return True\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores ( (agent_position, agent_direction), list_of_actions_taken_to_reach_this_state ).\n  # Each element defines a unique state of the agent (where it is and where it's facing) and the path to get there.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states already explored.\n  # This prevents redundant computations and infinite loops in cyclic paths, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the sequence of actions that leads the agent to be adjacent to and facing the primitive.\n  path_to_primitive_front = None \n\n  # Start the BFS traversal\n  while queue:\n      (current_pos, current_dir), actions_so_far = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the goal condition for our pathfinding: being in a position to 'USE' the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell immediately in front, we've found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_front = actions_so_far\n              break # Shortest path found; exit BFS.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the agent's new position if it moves one step forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the calculated next position is walkable using the helper function\n      # and if this new (position, direction) state has not been visited yet.\n      if is_walkable_destination(next_r, next_c) and (next_pos, next_dir) not in visited:\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), actions_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the agent's new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new (position, direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), actions_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the agent's new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new (position, direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), actions_so_far + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path to the target state (adjacent and facing the primitive) was found,\n  # append the final 'USE' action to that path to simulate collecting the primitive.\n  # If no path was found (path_to_primitive_front remains None), an empty list is returned,\n  # indicating the primitive is currently unreachable from the agent's initial state.\n  if path_to_primitive_front is not None:\n      actions_list.extend(path_to_primitive_front)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:37:31.998730", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment and define constants for readability\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define all kinds that block agent movement into a cell.\n  # This includes non-grabbable entities (like walls, water, workshops)\n  # AND the primitive itself, as the agent needs to be *adjacent* to it to 'USE' it, not occupy its cell.\n  blocked_for_movement_kinds = current_state.world.non_grabbable_indices.copy()\n  blocked_for_movement_kinds.add(primitive_id)\n  \n  # Convert to numpy array for efficient checking using np.any\n  blocked_for_movement_kinds_np = np.array(list(blocked_for_movement_kinds))\n  # Flag to avoid calling np.any on an empty array if there are no blocking kinds\n  has_blocking_kinds = len(blocked_for_movement_kinds_np) > 0\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the potential next cell contains any blocking kind using NumPy's any\n          if has_blocking_kinds and np.any(initial_grid[next_r, next_c, blocked_for_movement_kinds_np] > 0):\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:37:33.158796", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest path to an adjacent cell of the primitive and collects it using BFS.\n  \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute, or an empty list if not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction\n  # (0:R, 1:U, 2:L, 3:D) -> (row_change, col_change)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (1, 0)    # DOWN\n  }\n\n  # Mapping for updating agent's direction when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define all kinds that block agent movement onto a cell.\n  # This includes non-grabbable entities (like walls, water, workshops)\n  # AND the primitive itself, as the agent needs to be *adjacent* to it to 'USE' it.\n  # Convert to a numpy array for efficient indexing in the `np.any` check.\n  blocked_for_movement_kinds_set = current_state.world.non_grabbable_indices.copy()\n  blocked_for_movement_kinds_set.add(primitive_id)\n  blocked_for_movement_kinds_np = np.array(list(blocked_for_movement_kinds_set), dtype=int)\n\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the path to the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent (goal check)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, path found.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Attempt to Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change\n\n      # Check bounds and if this state (pos, dir) has been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the potential next cell contains any blocking kind.\n          # Only perform this check if there are blocking kinds to look for.\n          if blocked_for_movement_kinds_np.size > 0:\n              # Check if any of the blocking kinds are present in the target cell\n              # by checking the specific indices in the grid slice.\n              if np.any(initial_grid[next_r, next_c, blocked_for_movement_kinds_np] > 0):\n                  is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Attempt to Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Attempt to Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:39:38.713113", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    This version refines the heuristic search limits to be more adaptive to the full state space\n    and clarifies the state representation in the BFS. It also slightly increases the maximum\n    path length and explored states to provide greater robustness for larger or more complex\n    environments where longer action sequences or a wider range of states might be necessary.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  # This step translates the human-readable primitive name into its internal integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the world's index, it's an invalid target.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This function specifically targets items that can be \"collected\" into the agent's inventory.\n  # This includes fundamental resources, special environmental items, and any other grabbable items.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # If the item is not designed to be collected (e.g., a workshop, a boundary),\n      # then this function cannot find a path to collect it.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  # If the goal is already met, no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to (row_delta, col_delta) for the cell in front.\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decrement row\n      1: (0, 1),  # RIGHT: Increment column\n      2: (1, 0),  # DOWN: Increment row\n      3: (0, -1)  # LEFT: Decrement column\n  }\n\n  # Helper function to compute the minimum turning actions to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction\n      # Calculate the shortest angular difference (modulo 4 for 4 directions).\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (equivalent to two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  q = collections.deque()\n  # The `visited` set is crucial for preventing redundant exploration and infinite loops (cycles).\n  # Each state is uniquely identified by:\n  # (hash of grid bytes, agent_row, agent_col, agent_direction, tuple of inventory counts).\n  # Hashing the grid is essential because `USE_ACT` can modify the environment (e.g., chop a tree).\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  # Start BFS from the current state, with an empty path.\n  q.append((current_state, [])) # Queue stores (CraftState object, path_of_actions_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, num_kinds = current_state.grid.shape # Get grid dimensions and total number of item kinds.\n\n  # Heuristic search limits to manage computational complexity and prevent excessive runtime.\n  # These are adapted to the size of the state space, considering grid dimensions, directions, and potential inventory variations.\n  \n  # MAX_EXPLORED_STATES: Upper bound on the number of unique (grid, pos, dir, inventory) states to explore.\n  # Multiplied by `num_kinds` to account for more complex inventory states with many different items.\n  # The `200` is a heuristic constant for a reasonable balance.\n  MAX_EXPLORED_STATES = grid_rows * grid_cols * 4 * num_kinds * 200 # Pos * Dir * Inventory Kinds * Factor\n\n  # MAX_PATH_LENGTH: Upper bound on the length of any action sequence.\n  # Prevents search from exploring overly long, likely suboptimal, paths.\n  # `(grid_rows + grid_cols)` roughly represents the maximum Manhattan distance.\n  # Multiplied by 7 to allow for significant detours, turning actions, and multiple interactions.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 7 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty (no more states to explore)\n  # or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the next state and its path.\n    explored_states_count += 1\n\n    # Pruning check: If limits are reached, stop exploring this path branch.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue # Skip further processing for this path if it's too long or too many states explored overall.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # This list will store tuples for each possible next state:\n    # (next_state_object, full_path_to_next_state, inventory_BEFORE_the_last_action_applied).\n    # The 'inventory_BEFORE' is critical to accurately detect if the *target primitive* was acquired\n    # specifically by the last action in the path.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state by applying actions ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n        inventory_before_action = np.copy(state.inventory) # Inventory before movement (no change expected).\n        _, next_state = state.step(action) # Simulate the action. Reward is always 0.0 in this environment.\n        potential_next_transitions.append((next_state, path + [action], inventory_before_action))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This handles interactions with grabbable items or resources located directly under the agent.\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE (as USE can modify it).\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if the USE_ACT resulted in any meaningful change (inventory, grid, etc.).\n    # If no change, it means the action had no effect or was invalid in that context.\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and \n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interactions with nearby environmental features (e.g., trees, rocks, workshops).\n    for target_dir_idx in range(4): # Iterate through all four cardinal directions.\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Before simulating, ensure the target cell is within bounds and contains *some* entity.\n        # This prevents trying to USE empty or out-of-bounds cells.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Simulate the sequence of turning actions to orient the agent.\n            # A temporary state is used to apply turns without affecting the original `state` from the queue.\n            temp_state_before_use = state \n            for turn_action in turns_to_face:\n                _, temp_state_before_use = temp_state_before_use.step(turn_action)\n            \n            # Capture state immediately before the final USE_ACT for comparison.\n            inventory_before_adj_use = np.copy(temp_state_before_use.inventory)\n            grid_before_adj_use = np.copy(temp_state_before_use.grid)\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use.step(USE_ACT)\n            \n            # Check if this USE_ACT also resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use.pos and\n                state_after_adj_use.dir == temp_state_before_use.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        # This is the primary goal condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            # Goal achieved! Since it's BFS, this path is guaranteed to be the shortest.\n            return next_p \n\n        # If the goal is not yet achieved, add the new state to the queue if it hasn't been visited.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Re-hash grid as it might have changed.\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found\n  # within the given search limits, it means the primitive is currently unreachable.\n  return []", "island_id": 6, "scores": {"3": 2.5}}
