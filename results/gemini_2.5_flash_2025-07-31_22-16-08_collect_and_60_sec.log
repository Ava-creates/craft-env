{"timestamp": "2025-08-01T04:18:40.612185", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Helper to map (dx, dy) from agent_pos to target_pos to the required agent direction.\n  # CraftState dir: 0=N, 1=E, 2=S, 3=W (North, East, South, West)\n  DXDY_TO_DIR_INDEX = {\n      (0, -1): 0, # North (Up on grid)\n      (1, 0): 1,  # East (Right on grid)\n      (0, 1): 2,  # South (Down on grid)\n      (-1, 0): 3, # West (Left on grid)\n  }\n\n  # Helper to map an action to the resulting agent direction index.\n  ACTION_TO_RESULTING_DIR_INDEX = {\n      UP: 0,    # Moving Up (action 1) results in facing North (dir 0)\n      RIGHT: 1, # Moving Right (action 3) results in facing East (dir 1)\n      DOWN: 2,  # Moving Down (action 0) results in facing South (dir 2)\n      LEFT: 3,  # Moving Left (action 2) results in facing West (dir 3)\n  }\n\n  # Direction vectors corresponding to agent's dir (0:N, 1:E, 2:S, 3:W)\n  DIR_INDEX_TO_DXDY = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0), # West\n  }\n\n  # Get grid dimensions\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Initial check: If agent is already at a position where it can USE the primitive\n  # (i.e., primitive is directly in front of the agent), return [USE].\n  cx, cy = current_state.pos\n  current_dir_idx = current_state.dir\n  \n  # Calculate cell directly in front of the agent\n  fx, fy = cx, cy\n  if current_dir_idx == 0: # North\n      fy -= 1\n  elif current_dir_idx == 1: # East\n      fx += 1\n  elif current_dir_idx == 2: # South\n      fy += 1\n  elif current_dir_idx == 3: # West\n      fx -= 1\n\n  if (0 <= fx < grid_width and 0 <= fy < grid_height and \n      grid[fx, fy, primitive_idx] > 0):\n      return [USE]\n\n  # 2. Find all primitive locations on the grid.\n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # 3. Define goal states for BFS: (agent_x, agent_y, required_agent_dir).\n  # A goal state is an (agent_position, agent_direction) pair from which the USE action will hit the primitive.\n  goal_states = set()\n  for px, py in primitive_grid_locations:\n    # Iterate through cardinal neighbors of the primitive (where agent could stand)\n    # The (dx_rel, dy_rel) here is the vector FROM the agent's potential position TO the primitive.\n    \n    # Agent at (px, py-1) needs to face South (0,1) towards primitive\n    if 0 <= py - 1 < grid_height:\n        agent_pos = (px, py - 1)\n        required_dx, required_dy = px - agent_pos[0], py - agent_pos[1] # Vector from agent to primitive\n        required_agent_dir = DXDY_TO_DIR_INDEX[(required_dx, required_dy)]\n        goal_states.add((agent_pos[0], agent_pos[1], required_agent_dir))\n\n    # Agent at (px, py+1) needs to face North (0,-1) towards primitive\n    if 0 <= py + 1 < grid_height:\n        agent_pos = (px, py + 1)\n        required_dx, required_dy = px - agent_pos[0], py - agent_pos[1]\n        required_agent_dir = DXDY_TO_DIR_INDEX[(required_dx, required_dy)]\n        goal_states.add((agent_pos[0], agent_pos[1], required_agent_dir))\n\n    # Agent at (px-1, py) needs to face East (1,0) towards primitive\n    if 0 <= px - 1 < grid_width:\n        agent_pos = (px - 1, py)\n        required_dx, required_dy = px - agent_pos[0], py - agent_pos[1]\n        required_agent_dir = DXDY_TO_DIR_INDEX[(required_dx, required_dy)]\n        goal_states.add((agent_pos[0], agent_pos[1], required_agent_dir))\n\n    # Agent at (px+1, py) needs to face West (-1,0) towards primitive\n    if 0 <= px + 1 < grid_width:\n        agent_pos = (px + 1, py)\n        required_dx, required_dy = px - agent_pos[0], py - agent_pos[1]\n        required_agent_dir = DXDY_TO_DIR_INDEX[(required_dx, required_dy)]\n        goal_states.add((agent_pos[0], agent_pos[1], required_agent_dir))\n\n  if not goal_states: # If no primitive or no valid adjacent positions, cannot collect.\n      return []\n\n  # 4. Perform BFS on (x, y, dir) states to find the shortest path to any goal state.\n  start_bfs_state = (current_state.pos[0], current_state.pos[1], current_state.dir)\n  \n  # Queue stores (x, y, dir_agent_is_facing_at_this_pos)\n  q = collections.deque([start_bfs_state])\n  # visited stores {(x, y, dir): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  visited = {start_bfs_state: (None, None, None, None)}\n\n  # Define possible moves (dx, dy), corresponding action, and the resulting agent direction\n  # after that action (0:N, 1:E, 2:S, 3:W).\n  MOVE_ACTIONS_AND_NEW_DIRS = [\n      ((0, -1), UP, ACTION_TO_RESULTING_DIR_INDEX[UP]),    # Move Y- (Up)\n      ((0, 1), DOWN, ACTION_TO_RESULTING_DIR_INDEX[DOWN]), # Move Y+ (Down)\n      ((-1, 0), LEFT, ACTION_TO_RESULTING_DIR_INDEX[LEFT]),# Move X- (Left)\n      ((1, 0), RIGHT, ACTION_TO_RESULTING_DIR_INDEX[RIGHT]),# Move X+ (Right)\n  ]\n\n  # Identify impassable kinds (non-grabbable and not workshops)\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  found_goal_state = None\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # Check if the current state is one of our target goal states\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break # Found the shortest path to a valid collection state\n\n    # Explore valid neighboring states (position, direction)\n    for (dx, dy), action, n_dir in MOVE_ACTIONS_AND_NEW_DIRS:\n      nx, ny = cx + dx, cy + dy\n      new_bfs_state = (nx, ny, n_dir)\n\n      # Check grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability at the new position\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If the target cell contains an impassable object\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue\n\n      # If the new state (position, direction) has not been visited, add it to the queue\n      if new_bfs_state not in visited:\n        visited[new_bfs_state] = (cx, cy, c_dir, action) # Store parent state and action to reach here\n        q.append(new_bfs_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any goal state (primitive is unreachable)\n\n  # 5. Reconstruct the path of actions from the start state to the found goal state.\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state until the initial state is reached\n  while current_path_state != start_bfs_state:\n    # visited[current_path_state] gives (parent_x, parent_y, parent_dir, action_to_reach_current_state)\n    px, py, p_dir, action_taken = visited[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (px, py, p_dir)\n  \n  path_actions.reverse() # Path was built in reverse order, so reverse to get correct sequence\n\n  # Append the USE action at the end to collect the primitive\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:18:41.881774", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get primitive index. Using .get() for robustness, though .index() would also work\n  # if primitive is guaranteed to be in the index.\n  primitive_idx = env.world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n      # This primitive name is not known to the cookbook.\n      return []\n\n  # 1. Initial check: If the primitive is already in the agent's inventory, it's collected.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Constants mapping actions to (delta_x, delta_y) and the resulting agent direction.\n  # Agent directions: 0=North, 1=East, 2=South, 3=West (clockwise from North).\n  ACTION_TO_MOVE_AND_NEW_DIR = {\n      UP:    ((0, -1), 0), # Move North (Y-1), face North (dir 0)\n      RIGHT: ((1, 0),  1), # Move East (X+1), face East (dir 1)\n      DOWN:  ((0, 1),  2), # Move South (Y+1), face South (dir 2)\n      LEFT:  ((-1, 0), 3), # Move West (X-1), face West (dir 3)\n  }\n\n  # Constants mapping agent direction to the (delta_x, delta_y) of the cell in front.\n  DIR_TO_FRONT_CELL_DELTA = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0), # West\n  }\n  \n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir\n\n  # 2. Immediate USE action check: Is the primitive directly in front of the agent?\n  front_dx, front_dy = DIR_TO_FRONT_CELL_DELTA[start_dir]\n  target_x_immediate, target_y_immediate = start_x + front_dx, start_y + front_dy\n  \n  if (0 <= target_x_immediate < grid_width and 0 <= target_y_immediate < grid_height and \n      grid[target_x_immediate, target_y_immediate, primitive_idx] > 0):\n      return [USE] # Primitive is directly collectable.\n\n  # 3. Identify impassable terrain.\n  # These are `non_grabbable_indices` that are NOT `workshop_indices` (as workshops are walkable).\n  impassable_indices = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices:\n          impassable_indices.add(idx)\n\n  # 4. Perform BFS to find the shortest path to a state from which the primitive can be collected.\n  # BFS state: (current_x, current_y, current_direction)\n  q = collections.deque([(start_x, start_y, start_dir)])\n  # visited: {(x, y, dir): (parent_x, parent_y, parent_dir, action_taken_to_reach_here)}\n  visited = {(start_x, start_y, start_dir): (None, None, None, None)}\n  \n  final_collection_state = None # To store the (x, y, dir) state from which USE is performed.\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # Check if the current state allows for collecting the primitive with a 'USE' action.\n    # Calculate the cell in front of the agent at current (cx, cy, c_dir).\n    collect_dx, collect_dy = DIR_TO_FRONT_CELL_DELTA[c_dir]\n    collect_target_x, collect_target_y = cx + collect_dx, cy + collect_dy\n\n    if (0 <= collect_target_x < grid_width and 0 <= collect_target_y < grid_height and \n        grid[collect_target_x, collect_target_y, primitive_idx] > 0):\n        final_collection_state = current_bfs_state\n        break # Found the shortest path to a state where collection is possible.\n\n    # Explore valid neighboring states by applying movement actions.\n    for action, ((move_dx, move_dy), next_dir) in ACTION_TO_MOVE_AND_NEW_DIR.items():\n      nx, ny = cx + move_dx, cy + move_dy\n      next_bfs_state = (nx, ny, next_dir)\n\n      # Check grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new cell (nx, ny) is passable.\n      is_impassable_cell = False\n      for k_idx in impassable_indices:\n          if grid[nx, ny, k_idx] > 0:\n              is_impassable_cell = True\n              break\n      \n      if is_impassable_cell:\n          continue\n\n      # If the next state (position and direction) has not been visited, add it to the queue.\n      if next_bfs_state not in visited:\n        visited[next_bfs_state] = (cx, cy, c_dir, action) # Record parent and action.\n        q.append(next_bfs_state)\n\n  if final_collection_state is None:\n    return [] # No path found to any collectable primitive location.\n\n  # 5. Reconstruct the path of actions.\n  path_actions = []\n  current_path_state = final_collection_state\n  \n  # Backtrack from the found collection-ready state to the initial state.\n  while current_path_state != (start_x, start_y, start_dir):\n    px, py, p_dir, action_to_reach_here = visited[current_path_state]\n    path_actions.append(action_to_reach_here)\n    current_path_state = (px, py, p_dir)\n  \n  path_actions.reverse() # Reverse the list to get actions in chronological order.\n\n  # Append the USE action at the end to actually collect the primitive.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:19:22.455250", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Uses BFS to find the shortest path to a primitive\n  and adds a 'USE' action if the primitive is grabbable, a harvestable resource, or a workshop.\n  \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n  \n  # 1. Get the integer index for the primitive string\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it's an invalid primitive.\n    return []\n  \n  # 2. Define action mappings\n  ACTIONS = env.action_specs()\n  MOVE_ACTIONS = [ACTIONS['DOWN'], ACTIONS['UP'], ACTIONS['LEFT'], ACTIONS['RIGHT']]\n  USE_ACTION = ACTIONS['USE']\n  \n  # 3. Determine if the primitive requires a 'USE' action\n  # A 'USE' action is needed if the primitive is:\n  #   a. A grabbable item (e.g., plank, stick, rope)\n  #   b. A primitive resource that needs to be harvested (e.g., wood, stone, iron, grass, gold, gem, water)\n  #   c. A workshop (e.g., workshop0, workshop1, workshop2)\n  #   The `CraftState.step(USE_ACTION)` method handles the logic for these interactions.\n  requires_use = (\n      primitive_idx in world.grabbable_indices or\n      primitive_idx in world.cookbook.primitives or\n      primitive_idx in world.workshop_indices\n  )\n  \n  # 4. BFS setup\n  # Queue stores (CraftState object, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(current_state, [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant exploration.\n  # This correctly accounts for agent orientation in addition to position, as changing direction\n  # can sometimes be necessary (e.g., to face a certain way to \"use\" an object).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n  \n  # 5. Perform BFS\n  while queue:\n    state, path = queue.popleft()\n    \n    # Check if the goal condition is met: current state is next to the primitive.\n    # `state.next_to(primitive_idx)` checks if any cell in the 3x3 neighborhood\n    # around the agent's current position contains the primitive.\n    if state.next_to(primitive_idx):\n      final_path = list(path) # Create a copy to avoid modifying the path in the queue\n      if requires_use:\n        final_path.append(USE_ACTION)\n      return final_path\n            \n    # Explore neighbors by trying all move actions\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the next state without modifying the environment's actual state.\n      # `state.step()` returns (reward, new_state). We only need `new_state`.\n      _, new_state = state.step(action) \n      \n      # Check if the new state (position and direction) has been visited to prevent loops\n      # and re-exploring redundant paths.\n      new_pos_dir = (new_state.pos, new_state.dir)\n      \n      if new_pos_dir not in visited:\n        visited.add(new_pos_dir)\n        queue.append((new_state, path + [action]))\n        \n  # 6. If the queue becomes empty and no path to the primitive was found,\n  # it implies the primitive is unreachable or does not exist in the current grid.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:19:23.699788", "function_name": "collect", "function_body": "  initial_state = env._current_state\n  world = env.world\n  \n  # Get the integer index for the primitive\n  i_primitive = world.cookbook.index[primitive]\n\n  # Actions from craft module (assuming these are defined as integers)\n  # e.g., craft.UP, craft.DOWN, etc.\n  MOVE_ACTIONS = [craft.DOWN, craft.UP, craft.LEFT, craft.RIGHT]\n  USE_ACTION = craft.USE\n\n  # Determine if the primitive typically requires a USE action for collection or interaction.\n  # This includes primitive resources (like WOOD, STONE) and interactive locations (like WORKSHOPs).\n  requires_use = (i_primitive in world.cookbook.primitives or \n                  i_primitive in world.workshop_indices)      \n\n  # BFS setup\n  # Queue stores (current_CraftState_instance, path_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_state, [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant exploration.\n  # This is crucial because an agent can be at the same position but facing a different direction,\n  # leading to different interaction possibilities or paths.\n  visited = set()\n  visited.add((initial_state.pos, initial_state.dir))\n  \n  # Mapping from agent's direction integer to (dr, dc) delta for the cell in front.\n  # CraftWorld directions: 0:EAST, 1:SOUTH, 2:WEST, 3:NORTH\n  DIR_TO_DELTA = {0: (0, 1), 1: (1, 0), 2: (0, -1), 3: (-1, 0)}\n\n  # Get grid dimensions for boundary checks (though state.step often handles this implicitly)\n  grid_width, grid_height, _ = initial_state.grid.shape \n\n  while queue:\n    current_state, path = queue.popleft()\n    \n    # Calculate the coordinates of the cell directly in front of the agent.\n    dr, dc = DIR_TO_DELTA[current_state.dir]\n    front_row, front_col = current_state.pos[0] + dr, current_state.pos[1] + dc\n\n    # Check if the calculated front cell is within grid boundaries.\n    if (0 <= front_row < grid_width and 0 <= front_col < grid_height):\n      # Check if the primitive is located in the cell directly in front of the agent.\n      if current_state.grid[front_row, front_col, i_primitive] == 1.0:\n        # Goal reached: agent is positioned and oriented to interact with the primitive.\n        if requires_use:\n          # If the primitive needs a 'USE' action (e.g., harvesting, crafting at workshop),\n          # append the USE action to the path.\n          return path + [USE_ACTION]\n        else:\n          # If no 'USE' action is required (e.g., just being adjacent to water or a boundary),\n          # the current path is sufficient to \"collect\" (i.e., reach) it.\n          return path\n            \n    # Explore neighbors by trying all possible movement actions.\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the next state.\n      # `current_state.step(action)` returns a tuple (reward, new_state).\n      # The reward is always 0.0 for basic movement in this CraftState implementation.\n      # The new_state represents the state *after* the action (including pos and dir updates).\n      _, new_state = current_state.step(action) \n      \n      # The (position, direction) tuple uniquely identifies a state in our BFS search.\n      new_pos_dir = (new_state.pos, new_state.dir)\n      \n      # Add the new state to the queue if it hasn't been visited before.\n      # This check also implicitly handles cases where the agent tries to move into an impassable block\n      # (as `step` won't change `pos` or `dir`, resulting in `new_pos_dir` being the same as `current_pos_dir`,\n      # which would already be in `visited`).\n      if new_pos_dir not in visited:\n        visited.add(new_pos_dir)\n        queue.append((new_state, path + [action]))\n        \n  # If the queue becomes empty and no path to the primitive was found that satisfies\n  # the adjacency and facing conditions, it means the primitive is unreachable\n  # or does not exist in the current grid configuration.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:20:31.305916", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Validate primitive and get its index\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos  # (row, col) tuple\n  start_dir = current_state.dir  # 0:South, 1:North, 2:West, 3:East\n  global_grid = current_state.grid\n  grid_rows, grid_cols, _ = global_grid.shape # Grid dimensions (Height, Width)\n  inventory = current_state.inventory # Agent's current inventory\n\n  # Optimization: If the primitive is already in the inventory, no actions are needed.\n  if inventory[primitive_idx] > 0:\n      return []\n\n  # 4. Determine primitive type for collection logic\n  # These categorizations define how the agent interacts with the primitive to \"collect\" it.\n  primitive_is_workshop = primitive_idx in env.world.workshop_indices\n  primitive_is_grabbable_resource = primitive_idx in env.world.grabbable_indices and not primitive_is_workshop\n  primitive_is_non_grabbable_resource = (\n      primitive_idx in env.world.non_grabbable_indices and\n      not primitive_is_workshop and\n      primitive_idx in env.world.cookbook.primitives # Ensure it's a collectible resource like STONE/WATER\n  )\n\n  # 5. Define movement deltas and corresponding new agent directions\n  # Maps DMLab action values to ((delta_row, delta_col), new_direction_value)\n  movement_actions = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP, new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN, new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT, new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT, new direction is East (3)\n  }\n\n  # 6. Define deltas for the cell \"in front\" of the agent based on its current direction.\n  # This is crucial for determining where the 'USE' action will apply for adjacent items.\n  # Maps CraftState.dir values to (delta_row, delta_col)\n  direction_to_forward_delta = {\n      0: (1, 0),  # Facing South: cell is (row+1, col)\n      1: (-1, 0), # Facing North: cell is (row-1, col)\n      2: (0, -1), # Facing West: cell is (row, col-1)\n      3: (0, 1)   # Facing East: cell is (row, col+1)\n  }\n\n  # 7. Identify indices of items that generally block agent movement.\n  # This includes things like BOUNDARY, WATER, STONE, and other workshops (if not the target).\n  blocking_obstacles_indices = env.world.non_grabbable_indices\n\n  def is_traversable(r, c):\n      \"\"\"\n      Checks if (r, c) is within grid bounds and is a cell the agent can move onto.\n      A cell is traversable if it's within bounds and does not contain a blocking obstacle.\n      Special rule: The agent *can* move onto a workshop if that workshop is the specific primitive\n      being collected (as workshops are destinations, not just obstacles).\n      \"\"\"\n      # Check bounds first\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # Check if the cell contains any item that acts as a blocking obstacle.\n      cell_contents = global_grid[r, c, :]\n      for kind_idx in blocking_obstacles_indices:\n          if cell_contents[kind_idx] > 0: # If this kind of blocking item is present at (r,c)\n              # If the blocking item is the *target workshop* we are looking for, it's traversable.\n              if kind_idx == primitive_idx and primitive_is_workshop:\n                  continue # It's the target workshop, so it's not an obstacle for pathfinding\n              else:\n                  # Otherwise, it's a general blocking obstacle (e.g., WATER, STONE, BOUNDARY, or other workshops)\n                  return False \n      return True\n  \n  # 8. BFS Initialization\n  # The queue stores tuples: ((current_position (r,c), current_direction (int)), path_so_far (list of actions))\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # The visited set stores ((r,c), dir) tuples to avoid redundant exploration and cycles in the path.\n  visited = {(start_pos, start_dir)}\n\n  path_to_collection_spot = None # This will store the sequence of actions to reach the target state.\n  needs_use_action = False      # Flag indicating if a 'USE' action is required at the end.\n  \n  # 9. BFS Loop\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (position and direction) is a valid spot to collect the primitive.\n      collection_achievable_from_current_state = False\n\n      if primitive_is_workshop:\n          # For workshops, the agent needs to be ON the workshop's cell.\n          # No 'USE' action is typically needed to \"collect\" a workshop itself.\n          if global_grid[r, c, primitive_idx] > 0:\n              collection_achievable_from_current_state = True\n              needs_use_action = False\n      elif primitive_is_grabbable_resource: # Primitives like WOOD, IRON, GRASS, ROCK, GOLD, GEM\n          # For grabbable resources, the agent must be ON the cell.\n          # A 'USE' action is generally required to pick them up in this environment.\n          if global_grid[r, c, primitive_idx] > 0:\n              collection_achievable_from_current_state = True\n              needs_use_action = True\n      elif primitive_is_non_grabbable_resource: # Primitives like WATER, STONE\n          # For non-grabbable resources, the agent must be ADJACENT and FACING the primitive,\n          # then perform a 'USE' action.\n          fwd_dr, fwd_dc = direction_to_forward_delta[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front is within bounds and contains the primitive.\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              collection_achievable_from_current_state = True\n              needs_use_action = True\n      \n      # If the current state allows for collection, we found the shortest path.\n      if collection_achievable_from_current_state:\n          path_to_collection_spot = path_so_far\n          break \n\n      # Explore valid neighbors by trying all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, ((dr, dc), new_dir_val) in movement_actions.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_key = (next_pos, new_dir_val) # A state is defined by position and direction\n\n          # Only proceed if the next position is traversable and this (position, direction) state\n          # has not been visited before.\n          if (is_traversable(next_r, next_c) and\n              next_state_key not in visited):\n              \n              visited.add(next_state_key)\n              queue.append((next_state_key, path_so_far + [action_val]))\n  \n  # 10. Construct the final sequence of actions\n  if path_to_collection_spot is not None:\n      # If a path to the collection spot was found, append the 'USE' action if required.\n      if needs_use_action:\n          actions = path_to_collection_spot + [ACTION_USE]\n      else:\n          actions = path_to_collection_spot\n  \n  # If path_to_collection_spot remains None, 'actions' stays an empty list,\n  # indicating the primitive is unreachable or not found.\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:20:32.592514", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Validate primitive and get its index\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos  # (row, col) tuple\n  start_dir = current_state.dir  # 0:South, 1:North, 2:West, 3:East\n  global_grid = current_state.grid\n  grid_rows, grid_cols, _ = global_grid.shape # Grid dimensions (Height, Width)\n\n  # 4. Determine primitive type for collection logic\n  # Workshops are locations to be reached.\n  # Grabbables are items collected by moving onto their cell.\n  # Other non-grabbables (e.g., STONE, WATER) require being adjacent and using 'USE'.\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  primitive_is_workshop = primitive_idx in env.world.workshop_indices\n  primitive_is_non_grabbable_and_not_workshop = (\n      primitive_idx in env.world.non_grabbable_indices and\n      not primitive_is_workshop\n  )\n\n  # 5. Define movement deltas and corresponding new agent directions\n  # (delta_row, delta_col), new_direction_value\n  movement_actions = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # 6. Define deltas for the cell \"in front\" of the agent based on its direction\n  # This is used to check where the 'USE' action applies for non-grabbable items.\n  # (delta_row, delta_col)\n  direction_to_forward_delta = {\n      0: (1, 0),  # Facing South: cell (row+1, col)\n      1: (-1, 0), # Facing North: cell (row-1, col)\n      2: (0, -1), # Facing West: cell (row, col-1)\n      3: (0, 1)   # Facing East: cell (row, col+1)\n  }\n\n  # 7. Identify general obstacle indices (non-grabbable items that block movement)\n  # This includes things like WATER, STONE, BOUNDARY.\n  blocking_obstacles_indices = env.world.non_grabbable_indices\n\n  def is_valid_movement_target(r, c):\n      \"\"\"\n      Checks if (r, c) is within grid bounds and can be moved onto by the agent.\n      A cell is traversable if it's in bounds and does not contain any blocking obstacle.\n      Blocking obstacles are non-grabbable items, *unless* the non-grabbable item\n      is the target primitive and it's a workshop (workshops are locations you can move onto).\n      \"\"\"\n      # Check bounds\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # Check if the cell contains any *blocking* item.\n      # Iterate through all known kinds that might be present at (r,c)\n      for kind_id in env.world.cookbook.kinds: \n          if global_grid[r, c, kind_id] > 0: # If this kind_id is present at (r,c)\n              if kind_id in blocking_obstacles_indices: # If this kind is generally non-grabbable\n                  # If the target primitive is a workshop, and the current 'kind_id' *is* that workshop,\n                  # then it's not considered an obstacle for movement *to* that workshop.\n                  if primitive_is_workshop and kind_id == primitive_idx:\n                      continue # This specific non-grabbable (the target workshop) is NOT an obstacle for movement\n                  else:\n                      return False # It's a blocking obstacle (e.g., WATER, STONE, or another workshop)\n      return True\n  \n  # 8. BFS Initialization\n  # Queue stores tuples: ((current_position (r,c), current_direction (int)), path_so_far (list of actions))\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set stores ((r,c), dir) tuples to avoid redundant computations and cycles.\n  visited = {(start_pos, start_dir)}\n\n  path_to_collection_spot = None # Stores the actions to reach the state where collection can occur.\n  # This flag indicates if a 'USE' action is required *after* reaching the path_to_collection_spot.\n  requires_final_use_action = False      \n  \n  # 9. BFS Loop\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (position and direction) allows for collection.\n      \n      # Condition 1: Primitive is a Workshop (target is a location to be on)\n      if primitive_is_workshop:\n          # If agent is on the target workshop cell\n          if global_grid[r, c, primitive_idx] > 0:\n              path_to_collection_spot = path_so_far\n              requires_final_use_action = False # No 'USE' action needed to collect a workshop itself\n              break \n\n      # Condition 2: Primitive is Grabbable (target is an item to walk over and collect)\n      elif primitive_is_grabbable:\n          # If agent is on the target grabbable item's cell.\n          # CraftWorld collects grabbables automatically upon moving onto their tile.\n          if global_grid[r, c, primitive_idx] > 0:\n              path_to_collection_spot = path_so_far\n              requires_final_use_action = False # Collection happens implicitly by moving onto the cell\n              break\n      \n      # Condition 3: Primitive is Non-Grabbable, Non-Workshop (target requires adjacent USE)\n      elif primitive_is_non_grabbable_and_not_workshop:\n          fwd_dr, fwd_dc = direction_to_forward_delta[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front is within bounds and contains the primitive.\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              path_to_collection_spot = path_so_far\n              requires_final_use_action = True # 'USE' action is needed here\n              break\n\n      # Explore valid neighbors by trying all possible movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, ((dr, dc), new_dir_val) in movement_actions.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_key = (next_pos, new_dir_val) # State includes position and direction\n\n          # Only proceed if the next position is valid to move onto and this state hasn't been visited.\n          if (is_valid_movement_target(next_r, next_c) and\n              next_state_key not in visited):\n              \n              visited.add(next_state_key)\n              queue.append((next_state_key, path_so_far + [action_val]))\n  \n  # 10. Construct final action sequence\n  if path_to_collection_spot is not None:\n      if requires_final_use_action:\n          actions = path_to_collection_spot + [ACTION_USE]\n      else:\n          actions = path_to_collection_spot\n  # If path_to_collection_spot is None, 'actions' remains an empty list, indicating unreachability.\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:22:09.399012", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  DOWN_ACTION = action_map[\"DOWN\"]\n  UP_ACTION = action_map[\"UP\"]\n  LEFT_ACTION = action_map[\"LEFT\"]\n  RIGHT_ACTION = action_map[\"RIGHT\"]\n  USE_ACTION = action_map[\"USE\"]\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get current state details\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Determine if the target primitive is grabbable (i.e., can be picked up and added to inventory).\n  # Items like WOOD, IRON, GRASS are grabbable.\n  # Items like WATER, STONE, WORKSHOPS are typically non-grabbable environmental features.\n  grabbable_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_primitive = (primitive_id in grabbable_ids_set)\n\n  # Identify obstacle kinds. These are non-grabbable items that the agent cannot move through.\n  # The `non_grabbable_indices` attribute already provides a set of such IDs.\n  # The pathfinding logic must ensure the agent doesn't try to move onto these,\n  # unless the obstacle is the target primitive itself (e.g., moving onto a workshop).\n  obstacle_kinds_ids = env.world.non_grabbable_indices\n\n  # Define possible moves and their corresponding actions (dx, dy)\n  move_actions = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_position, path_taken_so_far_as_action_list)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop to find the shortest path to the primitive\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is reachable for collection from the current position.\n    # This is the \"improvement\" over collect_v0:\n    # For grabbable items, \"collection\" can happen if the item is in the 3x3 neighborhood (implies USE_ACTION).\n    # For non-grabbable items, \"collection\" means simply reaching the item's location.\n    target_found_for_collection = False\n    if is_grabbable_primitive:\n        # Check 3x3 neighborhood for the primitive\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n                # Ensure adjusted coordinates are within grid bounds\n                if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n                    if grid[nx_adj, ny_adj, primitive_id] > 0:\n                        target_found_for_collection = True\n                        break\n            if target_found_for_collection:\n                break\n        \n        if target_found_for_collection:\n            # If the primitive is grabbable and in reach, append a USE_ACTION.\n            return path_so_far + [USE_ACTION]\n    else: # Non-grabbable primitive (e.g., workshop, water)\n        # If the agent is on the tile of the non-grabbable primitive, it's \"collected\".\n        if grid[cx, cy, primitive_id] > 0:\n            return path_so_far # Just return the path to the location\n\n    # Explore neighbors (possible next moves)\n    for action, (dx, dy) in move_actions.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Check for obstacles at the next position.\n      # A cell is considered an obstacle if it contains any non-grabbable item\n      # that is NOT the primitive we are trying to collect. This allows moving\n      # onto the target primitive's tile even if it's generally non-grabbable\n      # (e.g., a workshop).\n      is_obstacle_cell = False\n      for kind_id in obstacle_kinds_ids:\n        if kind_id != primitive_id and grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break\n      \n      if is_obstacle_cell:\n        continue # Skip this move if it leads to an obstacle\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:22:10.541345", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  DOWN_ACTION = action_map[\"DOWN\"]\n  UP_ACTION = action_map[\"UP\"]\n  LEFT_ACTION = action_map[\"LEFT\"]\n  RIGHT_ACTION = action_map[\"RIGHT\"]\n  USE_ACTION = action_map[\"USE\"]\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  \n  # Check if primitive is already in inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already collected, no actions needed.\n\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  grabbable_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_primitive = (primitive_id in grabbable_ids_set)\n\n  # Get the set of all non-grabbable indices.\n  # This set will be used to determine if a cell is an obstacle.\n  all_non_grabbable_ids = env.world.non_grabbable_indices\n  \n  # Identify specific impassable obstacles (like boundaries), which we can never move onto.\n  # \"BOUNDARY\" is assumed to be always impassable.\n  boundary_id = env.world.cookbook.index.get(\"BOUNDARY\")\n\n  # Define moves: (action, dx, dy, resulting_dir)\n  # Assuming movement actions directly set the agent's direction upon completion.\n  # Directions: 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT (common DMLab convention)\n  move_actions_info = {\n      UP_ACTION: (0, -1, 0),    # (dx, dy, new_dir) for UP\n      RIGHT_ACTION: (1, 0, 1),  # (dx, dy, new_dir) for RIGHT\n      DOWN_ACTION: (0, 1, 2),   # (dx, dy, new_dir) for DOWN\n      LEFT_ACTION: (-1, 0, 3),  # (dx, dy, new_dir) for LEFT\n  }\n\n  # Mapping from direction integer to (dx, dy) vector representing the cell \"in front\" of the agent.\n  dir_to_vec = {\n      0: (0, -1), # UP\n      1: (1, 0),  # RIGHT\n      2: (0, 1),  # DOWN\n      3: (-1, 0)  # LEFT\n  }\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_x, current_y, current_direction, path_taken_so_far_as_action_list)\n  queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  # Visited set stores (x, y, dir) tuples to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while queue:\n    cx, cy, cdir, path_so_far = queue.popleft()\n\n    # --- GOAL CHECK ---\n    # The collection method depends on whether the primitive is grabbable or not.\n    # For grabbable primitives (e.g., WOOD, IRON), we assume 'USE' acts on the tile directly in front.\n    # For non-grabbable primitives (e.g., WORKSHOP, WATER), we assume 'collection' means stepping onto the tile.\n    \n    if is_grabbable_primitive: # Items like WOOD, IRON, GRASS, ROCK, GOLD, GEM (often 'mined' or 'chopped' when adjacent)\n        # Calculate the coordinates of the cell directly in front of the agent\n        fx, fy = cx + dir_to_vec[cdir][0], cy + dir_to_vec[cdir][1]\n\n        # Check if the front cell is within grid boundaries\n        if 0 <= fx < grid_width and 0 <= fy < grid_height:\n            # If the primitive is found in the cell in front, we can USE it.\n            if grid[fx, fy, primitive_id] > 0:\n                return path_so_far + [USE_ACTION]\n    else: # Non-grabbable primitives: WATER, STONE, WORKSHOPs, BOUNDARY\n        # If the primitive is at the current position, the goal is achieved.\n        # No USE action is needed as these are typically environmental features.\n        if grid[cx, cy, primitive_id] > 0:\n            return path_so_far\n\n    # --- EXPLORE NEIGHBORS ---\n    for action, (dx, dy, new_dir) in move_actions_info.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos_tuple = (nx, ny)\n      next_state_tuple = (nx, ny, new_dir)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if this (position, direction) state has already been visited\n      if next_state_tuple in visited:\n        continue\n\n      # Determine if the next cell contains an impassable obstacle.\n      is_impassable_obstacle = False\n      \n      # 1. Check for BOUNDARY, which is always an impassable obstacle if present.\n      if boundary_id is not None and grid[nx, ny, boundary_id] > 0:\n          is_impassable_obstacle = True\n      \n      # 2. Check for other non-grabbable items.\n      # A cell is an obstacle if it contains a non-grabbable item AND that item\n      # is NOT the target primitive (because we might want to move onto the target\n      # non-grabbable, e.g., a WORKSHOP or WATER, if it's our goal).\n      if not is_impassable_obstacle: # Only proceed if not already marked impassable by BOUNDARY\n          for kind_id in all_non_grabbable_ids:\n              if kind_id != primitive_id and grid[nx, ny, kind_id] > 0:\n                  is_impassable_obstacle = True\n                  break\n      \n      if is_impassable_obstacle:\n        continue # Skip this move if it leads to an impassable obstacle\n\n      # If the move is valid, add the new state to the queue\n      visited.add(next_state_tuple)\n      queue.append((nx, ny, new_dir, path_so_far + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:23:11.397298", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index.\n  # env.world.cookbook.index provides a mapping from string names to integer IDs.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness.\n  # This ensures the action integers correspond to the environment's current mapping.\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas (dr, dc) for convenience for the 4 cardinal directions,\n  # mapped to their corresponding action constants.\n  DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases the row index\n      DOWN: (1, 0),   # Moving DOWN increases the row index\n      LEFT: (0, -1),  # Moving LEFT decreases the column index\n      RIGHT: (0, 1)   # Moving RIGHT increases the column index\n  }\n\n  # 1. Check if the agent is already next to the primitive.\n  # The `next_to` method checks if the primitive is in the 3x3 neighborhood\n  # around the agent's current position.\n  if current_state.next_to(primitive_id):\n      # If adjacent, and the primitive is grabbable, a single 'USE' action is sufficient.\n      # Only grabbable items can be 'collected'.\n      if primitive_id in env.world.grabbable_indices:\n          actions.append(USE)\n      return actions # Return even if not grabbable (e.g., trying to collect 'water' returns []),\n                     # or if USE was just appended.\n\n  # 2. Find all locations of the target primitive on the grid.\n  # We iterate through the entire grid to identify all cells where the primitive is present.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # If the primitive_id occupies this cell (indicated by a 1 in its grid layer),\n          # add its coordinates to our list of target locations.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  # In this case, an empty list of actions is returned.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell that is adjacent to any of the primitive locations.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here]).\n  q = collections.deque([(current_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths,\n  # ensuring we find the shortest path.\n  visited = {current_pos} \n\n  # This variable will store the list of actions forming the shortest path\n  # to a cell adjacent to the target primitive, once it's discovered.\n  target_adj_pos_path = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is adjacent to any of the primitive locations.\n      # Adjacency is defined by a Manhattan distance of 1 (horizontally or vertically).\n      # From such a position, the 'USE' action can be applied to interact with the primitive.\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # Found the shortest path to an adjacent cell.\n              break # Break from this inner loop as we've found our primary target path.\n      \n      if target_adj_pos_path is not None:\n          break # Exit the BFS loop once the shortest path to an adjacent cell has been found.\n\n      # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the new potential position.\n\n          # Check bounds: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is considered non-traversable if it contains any item\n          # whose kind index is in the world's `non_grabbable_indices` set.\n          # These typically represent obstacles like 'BOUNDARY', 'WATER', or 'WORKSHOP' structures\n          # that the agent cannot move through.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item.\n                  is_traversable = False\n                  break # This neighbor is an obstacle, so stop checking and mark as not traversable.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # If the neighbor has not been visited, add it to the queue to explore later.\n          # This prevents cycles and ensures the shortest path is found.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc)) # Mark as visited.\n              new_path = path + [action_dir] # Extend the current path with the action taken to reach here.\n              q.append(((nr, nc), new_path)) # Add the new state (position and path) to the queue.\n    \n  # 4. If a path to an adjacent cell was found during BFS,\n  #    extend the actions list with this path and then append a 'USE' action\n  #    if the primitive is actually grabbable.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      # Only append the 'USE' action if the primitive is listed as a grabbable item\n      # in the CraftWorld configuration. This prevents trying to 'collect' non-grabbable\n      # entities like water or boundaries.\n      if primitive_id in env.world.grabbable_indices:\n          actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:23:12.715852", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:24:01.211755", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current position (x, y) i.e. (col, row)\n  start_dir = current_state.dir # Agent's initial facing direction (int, e.g., 0=UP, 1=DOWN, etc.)\n\n  # Get relevant indices from the cookbook\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the target primitive. If it doesn't exist, return empty.\n  primitive_idx = cookbook.index.get(primitive)\n  if primitive_idx is None:\n      return []\n\n  # Get the index for boundary, assumed to be an obstacle for movement.\n  # Handle cases where \"boundary\" might not be in the cookbook's index.\n  boundary_idx = cookbook.index.get(\"boundary\")\n  has_boundary = (boundary_idx is not None)\n\n  # Define movement actions and their corresponding (delta_x, delta_y)\n  # (delta_x, delta_y) corresponds to (delta_col, delta_row).\n  # In CraftWorld, performing a movement action (UP/DOWN/LEFT/RIGHT)\n  # also sets the agent's facing direction to that of the performed move.\n  moves_map = {\n      craft.UP: (0, -1),   # Move up: row decreases (y decreases)\n      craft.DOWN: (0, 1),    # Move down: row increases (y increases)\n      craft.LEFT: (-1, 0),   # Move left: col decreases (x decreases)\n      craft.RIGHT: (1, 0)    # Move right: col increases (x increases)\n  }\n\n  # Get grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # Helper function to calculate the coordinates of the cell the agent is facing\n  # Given agent at pos_xy = (x, y) and facing 'direction'\n  def _get_facing_coords(pos_xy, direction):\n      x, y = pos_xy\n      if direction == craft.UP:\n          return x, y - 1\n      elif direction == craft.DOWN:\n          return x, y + 1\n      elif direction == craft.LEFT:\n          return x - 1, y\n      elif direction == craft.RIGHT:\n          return x + 1, y\n      return x, y # Should not be reached with valid directions\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y), current_direction, path_taken_so_far)\n  # 'current_direction' is the direction the agent is FACING at (current_x, current_y)\n  # after having reached that position.\n  queue = collections.deque([(start_pos, start_dir, [])])\n  \n  # Visited set stores ((x, y), direction) tuples to prevent cycles and redundant exploration.\n  # This ensures we find the shortest path in terms of actions and reach the desired facing.\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (x, y), current_dir, path = queue.popleft()\n\n    # --- Goal Check: Can we USE the primitive from the current position and direction? ---\n    # Calculate the coordinates of the cell the agent is currently facing\n    fx, fy = _get_facing_coords((x, y), current_dir)\n\n    # Check if the facing cell is within grid bounds\n    if 0 <= fx < grid_width and 0 <= fy < grid_height:\n      # Check if the primitive is present at the cell the agent is FACING\n      # grid[fx, fy, primitive_idx] > 0 indicates presence of the primitive at that location.\n      if grid[fx, fy, primitive_idx] > 0:\n        # If the primitive is directly in front, the next action should be USE\n        return path + [craft.USE]\n\n    # --- Explore possible movements from the current state ---\n    for action_move, (dx_move, dy_move) in moves_map.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n      \n      # After performing 'action_move', the agent's direction will be 'action_move' itself\n      # (e.g., moving UP makes the agent face UP).\n      next_dir = action_move \n      next_state_tuple = (next_pos, next_dir)\n\n      # Check validity of the next_pos:\n      # 1. Bounds check: Ensure new position is within the grid\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Traversability check: Ensure the cell is not an obstacle (e.g., boundary)\n      if has_boundary and grid[next_x, next_y, boundary_idx] > 0:\n        continue # Cannot move into a boundary cell\n      \n      # 3. Visited check: Avoid revisiting already explored (position, direction) states\n      if next_state_tuple in visited:\n        continue\n\n      # If all checks pass, add the new state to the queue and mark as visited\n      visited.add(next_state_tuple)\n      queue.append((next_pos, next_dir, path + [action_move]))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:24:02.472746", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  grid = current_state.grid\n  \n  # 1. Get the integer index for the primitive\n  i_primitive = world.cookbook.index[primitive]\n\n  # Get indices for impassable terrain\n  # Boundary and Water are typically impassable\n  boundary_idx = world.cookbook.index.index(\"boundary\")\n  water_idx = world.water_index\n\n  # Define possible movement directions and their corresponding actions\n  # (delta_row, delta_col) -> action\n  move_deltas_and_actions = [\n      (-1, 0), # UP: Decreases row index\n      (1, 0),  # DOWN: Increases row index\n      (0, -1), # LEFT: Decreases column index\n      (0, 1)   # RIGHT: Increases column index\n  ]\n  delta_to_action = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n\n  start_pos = current_state.pos\n  grid_height, grid_width, _ = grid.shape\n\n  # Step 1: Identify all cells on the grid that contain the primitive.\n  primitive_locations = []\n  for r in range(grid_height):\n      for c in range(grid_width):\n          # Check if the primitive exists at this specific (r, c) location\n          if grid[r, c, i_primitive] > 0: # Check if count is greater than 0\n              primitive_locations.append((r, c))\n  \n  if not primitive_locations:\n      # The primitive does not exist anywhere on the current grid\n      return []\n\n  # Step 2: Determine all \"valid_use_positions\".\n  # These are cells where the agent can stand such that the primitive\n  # is within its 3x3 neighborhood (including the cell the agent is on).\n  # This corresponds to positions where CraftState.next_to(i_primitive) would be True.\n  valid_use_positions = set()\n  for pr, pc in primitive_locations:\n      # Iterate through the 3x3 neighborhood centered at (pr, pc)\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              target_r, target_c = pr + dr_offset, pc + dc_offset\n              # Ensure the target position is within grid boundaries\n              if 0 <= target_r < grid_height and 0 <= target_c < grid_width:\n                  valid_use_positions.add((target_r, target_c))\n\n  # Step 3: Perform BFS to find the shortest path from the agent's start_pos\n  # to any of the valid_use_positions, respecting impassable terrain.\n  queue = collections.deque([(start_pos, [])]) # (current_pos, path_of_actions)\n  visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant exploration\n\n  found_path = None\n\n  while queue:\n    curr_pos, path = queue.popleft()\n\n    # If the current position is one of the valid interaction spots, we've found our path\n    if curr_pos in valid_use_positions:\n      found_path = path\n      break \n\n    # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n    for dr, dc in move_deltas_and_actions:\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check 1: Grid boundaries\n      if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n        continue\n\n      # Check 2: Impassable terrain (boundary or water)\n      if grid[next_r, next_c, boundary_idx] > 0 or grid[next_r, next_c, water_idx] > 0:\n          continue # Cannot move into a boundary or water cell\n\n      # Check 3: Avoid revisiting already explored positions\n      if next_pos not in visited:\n        visited.add(next_pos)\n        action_to_take = delta_to_action[(dr, dc)] \n        queue.append((next_pos, path + [action_to_take]))\n\n  if found_path is None:\n    # No path found to any valid interaction spot for the primitive\n    return []\n  \n  # After reaching the target interaction location, a 'USE' action is required\n  # to actually collect or interact with the primitive.\n  found_path.append(craft.USE)\n  \n  return found_path", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:24:31.949360", "function_name": "collect", "function_body": "  current_state = env._current_state\n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Map action names to their corresponding integer IDs for readability and consistency.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Step 1: Check immediate vicinity.\n  # If the agent is already within reach of the primitive (3x3 neighborhood),\n  # the most efficient action is simply to 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Step 2: Locate all occurrences of the primitive on the grid.\n  # We need to know where the target primitive is in the environment.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] # Stores (x, y) coordinates\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # The grid stores counts for each kind at each cell. If the count > 0, the primitive is present.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # Step 3: Define \"goal cells\" for the pathfinding.\n  # A goal cell is any position from which the agent can successfully 'USE' the primitive.\n  # In CraftWorld, 'USE' applies to the 3x3 neighborhood around the agent.\n  # So, for each primitive location (px, py), any cell (gx, gy) in its 3x3 neighborhood\n  # is a valid goal cell.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid boundaries\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # Step 4: Perform Breadth-First Search (BFS) to find the shortest path.\n  # BFS is used because it guarantees finding the shortest path in an unweighted graph\n  # (where each movement action has a cost of 1).\n  start_pos = current_state.pos\n  \n  # The queue stores tuples of (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # 'visited' set keeps track of positions already explored to prevent cycles and redundant work.\n  visited = {start_pos} \n\n  # Define possible movement directions and their corresponding action IDs.\n  # (delta_x, delta_y) -> action_id\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Moving up (decreasing Y)\n      ((0, 1), DOWN),   # Moving down (increasing Y)\n      ((-1, 0), LEFT),  # Moving left (decreasing X)\n      ((1, 0), RIGHT),  # Moving right (increasing X)\n  ]\n\n  # Identify impassable terrain.\n  # The agent cannot move into cells occupied by certain non-grabbable items.\n  # Workshops are generally traversable even if non-grabbable, so we exclude them.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our designated goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # The path leads to a cell from which 'USE' can be applied.\n      return path + [USE]\n\n    # Explore valid neighboring cells for movement.\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      new_pos = (nx, ny)\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is occupied by impassable terrain.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If any impassable kind is present at the new position, it's blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited yet, add it to the queue\n      # along with the path taken to reach it.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and the queue is empty without finding any path to a goal cell,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:24:33.157398", "function_name": "collect", "function_body": "  current_state = env._current_state\n  # Retrieve the integer index corresponding to the primitive name.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get the integer mappings for all possible actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Step 1: Check for immediate collection ---\n  # If the agent is already adjacent to the primitive (within its 3x3 neighborhood),\n  # the most efficient action is simply to 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Step 2: Locate all occurrences of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of all cells containing the primitive.\n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a value greater than 0, it exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Step 3: Determine \"Goal Cells\" for BFS ---\n  # A \"goal cell\" is any grid location from which the agent can apply the 'USE' action\n  # to collect the target primitive. Since 'USE' affects a 3x3 area around the agent,\n  # any cell (gx, gy) that has a primitive (px, py) within its 3x3 neighborhood\n  # is a valid goal cell for the pathfinding BFS.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell (gx, gy) is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Step 4: Perform Breadth-First Search (BFS) for the shortest path ---\n  # The BFS will find the shortest sequence of movement actions from the agent's\n  # current position to any of the identified 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited grid positions to prevent infinite loops and redundant work.\n  visited = {start_pos} \n\n  # Define all possible movement directions (delta X, delta Y) and their corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain. These are entities that the agent cannot move onto.\n  # In CraftWorld, non-grabbable items that are NOT workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable,\n      # even though they cannot be picked up.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action to the path and return the complete action sequence.\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells from the current position.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within the grid dimensions.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if the new position is out of bounds.\n\n      # 2. Impassability Check: Determine if the new position contains any impassable entity.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break # No need to check other impassable kinds for this cell.\n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark the new position as visited.\n        # Enqueue the new position along with the updated path to reach it.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes (queue becomes empty) and no path to a goal cell was found,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:25:06.362858", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Immutable state information for planning the path\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This ID is used to locate it on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Grid dimensions for boundary checks\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment. These are constant integer IDs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action moves agent forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # 'LEFT' action turns agent 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # 'RIGHT' action turns agent 90 degrees right\n  USE_ACTION = action_map['USE']            # 'USE' action interacts with cell in front\n\n  # Define direction vectors and turning rules for the agent's movement mechanics.\n  # DIR_TO_DRDC: Maps agent's direction (0-3) to a (delta_row, delta_column) vector,\n  # indicating the coordinates of the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (row, col+1)\n      1: (-1, 0),  # Facing UP (North): (row-1, col)\n      2: (0, -1),  # Facing LEFT (West): (row, col-1)\n      3: (1, 0)    # Facing DOWN (South): (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT(0) -> UP(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT(0) -> DOWN(3)\n\n  # Get indices of entities that the agent cannot walk onto.\n  # This includes boundaries, water, and workshops.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS (Breadth-First Search) Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # This represents a state (agent's position and orientation) and the path (sequence of actions) to achieve it.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  target_path_to_adjacency = None # This variable will store the action sequence if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacency = path_so_far\n              break # Path found! Terminate BFS as we found the shortest path.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_r, next_c = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is within bounds and this new (position, direction) state\n      # has not been visited yet.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # The agent cannot walk onto:\n          #   a) The primitive itself (interaction is from an adjacent square, not by stepping on it).\n          #   b) Any non-grabbable entities (like boundaries, water, or specific workshops that are impassable).\n          is_walkable = True\n          if initial_grid[next_r, next_c, primitive_id] > 0: # Cannot walk onto the primitive itself\n              is_walkable = False\n          else:\n              for kind_idx in non_walkable_kinds_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n\n          if is_walkable:\n              # If walkable, add the new state to the queue and mark it as visited.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent to and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path_to_adjacency is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path_to_adjacency is not None:\n      actions_list.extend(target_path_to_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:25:07.512785", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with enhanced comments for clarity.\"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Immutable state information from the current environment, used for pathfinding.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial (row, col) position\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This ID is used to locate\n  # the primitive within the grid's n_kinds dimension.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks during movement.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are constants representing the discrete actions the agent can take.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right.\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front.\n\n  # Direction vectors (dr, dc) that describe the cell directly \"in front\" of the agent\n  # based on its current facing direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating the agent's direction when performing turn actions.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that are considered \"non-grabbable\" and typically\n  # block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  # This represents a unique state of the agent (where it is and which way it's facing)\n  # and the sequence of actions that led to this state.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position_tuple, direction_int) pairs that have\n  # already been explored to prevent redundant computations and infinite loops (cycles).\n  # This ensures we find the shortest path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_found = None # This will store the action sequence if a path to the goal is found.\n\n  # Start Breadth-First Search (BFS) traversal.\n  while queue:\n      (current_r, current_c), path_actions = queue.popleft()\n      current_pos = (current_r, current_c)\n\n      # 1. Goal Check: Is the primitive directly in front of the agent?\n      # Our goal for pathfinding is to reach a state where the agent is adjacent to the primitive\n      # and facing it, so it can be collected with a 'USE' action.\n      front_dr, front_dc = DIR_TO_DRDC[initial_dir] # Note: Should use current_dir, not initial_dir\n      # Correction: use `current_dir` from the popped state, not global `initial_dir`.\n      # Re-evaluate previous solution for v1 for this: yes, it correctly uses `current_dir`.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir] \n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the target primitive exists in this cell.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_found = path_actions\n              break # Shortest path to adjacency found, terminate BFS.\n\n      # 2. Explore Possible Next Actions from the Current State:\n      # Agent can move forward, turn left, or turn right.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward (direction stays the same).\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_r + move_dr, current_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the potential next position is valid (within bounds)\n      # and if this new (position, direction) state has not been visited yet.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the `next_pos` cell is walkable.\n          # A cell is NOT walkable if:\n          # 1. It contains the target primitive itself (agent collects from adjacent, not by stepping on it).\n          # 2. It contains any of the globally defined non-grabbable/impassable entities.\n          is_walkable = True\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n          else:\n              for kind_idx in non_walkable_kinds_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n          \n          if is_walkable:\n              # If the cell is walkable, add this new state to the queue for further exploration\n              # and mark it as visited to avoid revisiting.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left (position remains unchanged).\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this (current_pos, new_direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right (position remains unchanged).\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this (current_pos, new_direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (agent adjacent to and facing the primitive) was found,\n  # append the final 'USE' action to complete the collection process.\n  if target_path_found is not None:\n      actions_list.extend(target_path_found)\n      actions_list.append(USE_ACTION)\n  \n  # Return the sequence of actions. If no path was found, actions_list will be empty.\n  return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:26:20.781521", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get immutable initial state properties of the environment\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This relies on the DSL providing a valid primitive name, so no KeyError handling here.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions. Assuming initial_grid.shape is (num_rows, num_cols, n_kinds).\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Map action names to their integer indices as defined by the CraftLab environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move one step forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Define direction vectors (dr, dc) for changes in (row, column) based on agent's facing direction.\n  # Directions are 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN.\n  # This mapping is consistent with a (row, col) coordinate system where row increases downwards, col increases rightwards.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1) - moves right\n      1: (-1, 0),  # Facing UP: (row-1, col) - moves up\n      2: (0, -1),  # Facing LEFT: (row, col-1) - moves left\n      3: (1, 0)    # Facing DOWN: (row+1, col) - moves down\n  }\n\n  # Define how agent's integer direction index changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # Convert the set to a list for efficient NumPy array indexing.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is adjacent and ready to be used.\n  path_to_primitive_adjacency = None \n\n  # Start BFS traversal\n  while queue:\n      # Dequeue the current state and the path taken to reach it.\n      (current_row, current_col), current_dir_val = queue.popleft()[0] # The current state tuple (pos, dir)\n      path_so_far = queue.popleft()[1] # The list of actions to reach this state\n      # Correction: The previous line was incorrect. The queue stores `((pos, dir), path)`, so popleft() returns the whole tuple.\n      # Let's fix the unpacking to reflect `(state, path)` structure:\n      (current_pos_rc, current_dir_val), path_so_far = queue.popleft() \n      current_row, current_col = current_pos_rc\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (i.e., ready for a 'USE' action).\n      dr_front, dc_front = DIR_TO_DRDC[current_dir_val]\n      front_row, front_col = current_row + dr_front, current_col + dc_front\n      \n      # Check if the cell directly in front is within the grid boundaries.\n      if 0 <= front_row < num_rows and 0 <= front_col < num_cols:\n          # If the primitive is present in this cell, we have found our target state.\n          if initial_grid[front_row, front_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_so_far\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # --- Try Move Forward action ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir_val]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir_val # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is within bounds and if this (position, direction) state has already been visited.\n      if (0 <= next_row < num_rows and 0 <= next_col < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entities (e.g., boundaries, water, workshops).\n          # A sum > 0 implies at least one non-walkable item is present at that cell.\n          if non_walkable_kinds_indices and np.sum(initial_grid[next_row, next_col, non_walkable_kinds_indices]) > 0:\n              is_walkable = False\n          # Also, ensure the agent does not walk directly onto the primitive itself, as it needs to be collected from an adjacent square using 'USE'.\n          elif initial_grid[next_row, next_col, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left action ---\n      next_dir_left = TURN_LEFT_MAP[current_dir_val]\n      # Turning only changes the direction, not the agent's position.\n      if (current_pos_rc, next_dir_left) not in visited:\n          visited.add((current_pos_rc, next_dir_left))\n          queue.append(((current_pos_rc, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right action ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir_val]\n      # Turning only changes the direction, not the agent's position.\n      if (current_pos_rc, next_dir_right) not in visited:\n          visited.add((current_pos_rc, next_dir_right))\n          queue.append(((current_pos_rc, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes (either a path is found or the queue becomes empty):\n  # If a path to the primitive's adjacency was found, append the 'USE' action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T04:26:21.944382", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  grid = current_state.grid # numpy.ndarray of shape (num_rows, num_cols, n_kinds)\n  initial_pos = current_state.pos  # (row, col) tuple for the agent's current position\n  initial_dir = current_state.dir  # int representing agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # (dr, dc) indicates how row and column coordinates change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kind_indices = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a given row and column are within the grid boundaries\n  def is_in_bounds(r: int, c: int) -> bool:\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  # Helper function to determine if the agent can walk onto a specific cell\n  # A cell is NOT walkable if it's out of bounds, contains any non-grabbable entity,\n  # or contains the primitive itself (agent must \"use\" from an adjacent cell).\n  def is_walkable_for_agent(r: int, c: int) -> bool:\n      if not is_in_bounds(r, c):\n          return False\n      \n      # The agent cannot walk onto the primitive itself, it must be next to it to use.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-walkable (non-grabbable) entity.\n      # np.sum is used here, if any of the non-walkable kinds are present (>0), then it's not walkable.\n      if non_walkable_kind_indices and np.sum(grid[r, c, non_walkable_kind_indices]) > 0:\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent cycles and redundant path computations.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front.\n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If so, we've found the target state (agent is adjacent and facing the primitive).\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      if is_in_bounds(front_r, front_c) and grid[front_r, front_c, primitive_id] > 0:\n          target_path = path_taken\n          break # Path to target adjacency found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction\n\n      # If the next position is walkable and this state (position + direction) hasn't been visited, add it to the queue.\n      if (is_walkable_for_agent(next_r, next_c) and\n          (next_pos, next_dir) not in visited):\n          \n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ( (current_pos, next_dir_left) not in visited ):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ( (current_pos, next_dir_right) not in visited ):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target adjacency state was found, extend the actions list with that path\n  # and then append the final USE action to collect the primitive.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:27:11.124292", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n\n  # 1. Early exit: If the primitive is already in the agent's inventory,\n  # no actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 2. Early exit: Check if the requested primitive is actually grabbable.\n  # Non-grabbable entities (like \"water\", \"boundary\", \"workshop\") cannot be collected\n  # into the inventory. Return an empty list if it's not grabbable.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Initialize grid dimensions and agent's starting position.\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current (x, y) position\n  grid_width, grid_height, _ = grid.shape\n\n  # Define movement actions and their corresponding (delta_x, delta_y) coordinates.\n  # These define how the agent's position changes for each cardinal movement action.\n  moves = {\n      craft.UP: (0, -1),   # Moving up decreases the y-coordinate\n      craft.DOWN: (0, 1),    # Moving down increases the y-coordinate\n      craft.LEFT: (-1, 0),   # Moving left decreases the x-coordinate\n      craft.RIGHT: (1, 0)    # Moving right increases the x-coordinate\n  }\n\n  # Identify all obstacle indices. These are entities the agent cannot move through.\n  # This includes boundaries, water, workshops, and any other non-grabbable items.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Breadth-First Search (BFS) setup:\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here).\n  # BFS guarantees finding the shortest path in an unweighted graph.\n  queue = collections.deque([(start_pos, [])])\n  \n  # The `visited` set keeps track of (x, y) positions that have already been\n  # explored to prevent cycles and ensure the shortest path is found efficiently.\n  visited = {start_pos}\n\n  while queue:\n    (current_x, current_y), path_to_here = queue.popleft()\n\n    # Check if the target primitive is in the 3x3 neighborhood of the current agent position.\n    # This logic mimics `CraftState.next_to()` and determines if the agent is ready to `USE`.\n    primitive_is_adjacent = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = current_x + dx_adj, current_y + dy_adj\n\n        # Ensure the checked adjacent cell is within the grid boundaries.\n        if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n          # If the primitive is found at this adjacent cell (its count is > 0),\n          # then we've reached our goal position for collection.\n          if grid[adj_x, adj_y, primitive_idx] > 0:\n            primitive_is_adjacent = True\n            break  # Primitive found, no need to check further adjacent cells.\n      if primitive_is_adjacent:\n        break  # Break from outer loop as well.\n\n    if primitive_is_adjacent:\n      # If the primitive is adjacent, the sequence of actions is the path taken\n      # to reach this position, followed by the 'USE' action to collect the item.\n      return path_to_here + [craft.USE]\n\n    # If the primitive is not yet adjacent, continue exploring valid neighboring cells for movement.\n    # Only consider cardinal directions (UP, DOWN, LEFT, RIGHT).\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = current_x + dx_move, current_y + dy_move\n      next_pos = (next_x, next_y)\n\n      # Check 1: Bounds check - Ensure the next position is within the grid dimensions.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check 2: Visited check - Avoid revisiting positions already explored.\n      if next_pos in visited:\n        continue\n\n      # Check 3: Traversability check - Ensure the next cell is not an obstacle.\n      # An obstacle cell is one that contains any non-grabbable item.\n      is_obstacle = False\n      for obstacle_kind_idx in obstacle_indices:\n        if grid[next_x, next_y, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Cannot move into an obstacle cell.\n\n      # If all checks pass, this is a valid and unvisited cell to move to.\n      # Add it to the queue with the updated path, and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_to_here + [action]))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable or does not exist on the map.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:27:12.381658", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n\n  # Optimization: If the agent already possesses the primitive in inventory,\n  # no actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Safety check: If the requested primitive is not a grabbable item\n  # (e.g., \"water\", \"workshop\", \"boundary\"), it cannot be collected into inventory.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current (x, y) position\n\n  # Define all indices that represent impassable terrain or non-grabbable\n  # objects that the agent cannot move into.\n  non_movable_obstacle_indices = env.world.non_grabbable_indices\n\n  # Define movement actions and their corresponding delta coordinates (dx, dy).\n  # These are used for grid traversal in the BFS.\n  moves = {\n      craft.UP: (0, -1),   # Moving up decreases the y-coordinate\n      craft.DOWN: (0, 1),    # Moving down increases the y-coordinate\n      craft.LEFT: (-1, 0),   # Moving left decreases the x-coordinate\n      craft.RIGHT: (1, 0)    # Moving right increases the x-coordinate\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # BFS initialization:\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The `visited` set keeps track of (x, y) positions already explored to prevent\n  # cycles and ensure the shortest path is found.\n  visited = {start_pos}\n\n  while queue:\n    (x, y), path = queue.popleft()\n\n    # Check the 3x3 neighborhood around the current agent position (x, y)\n    # for the presence of the target primitive. This includes the agent's\n    # current cell (dx_adj=0, dy_adj=0).\n    # This simulates the `CraftState.next_to` function logic.\n    found_adjacent_primitive = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n        # Ensure the adjacent cell is within the grid boundaries.\n        if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n          # Check if the target primitive is present at this adjacent cell\n          # (i.e., its count is greater than zero).\n          if grid[nx_adj, ny_adj, primitive_idx] > 0:\n            found_adjacent_primitive = True\n            break  # Primitive found in neighborhood, no need to check further adjacent cells.\n      if found_adjacent_primitive:\n        break  # Break from outer loop as well.\n\n    if found_adjacent_primitive:\n      # If the primitive is found in the immediate vicinity (3x3 neighborhood),\n      # the sequence of actions is the path taken to reach this position\n      # followed by the 'USE' action to collect the item.\n      return path + [craft.USE]\n\n    # If the primitive is not yet adjacent, explore valid neighboring cells for movement.\n    # Consider only cardinal directions (UP, DOWN, LEFT, RIGHT).\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n\n      # 1. Bounds check: Ensure the next position is within the grid dimensions.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting positions that have already been\n      # explored to find the shortest path and prevent infinite loops.\n      if next_pos in visited:\n        continue\n\n      # 3. Traversability check: Ensure the next cell is not an obstacle.\n      # The agent cannot move into a cell that contains any non-grabbable item.\n      is_obstacle = False\n      for obstacle_idx in non_movable_obstacle_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # If all checks pass, add the new valid position to the queue\n      # along with the path to reach it, and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path + [action]))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable or does not exist on the map.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T04:28:37.383055", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # --- Nested Helper Functions for Readability and Abstraction ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is walkable based on the initial grid.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check for non-grabbable blocking entities (e.g., walls, water)\n      # Iterate through the non_grabbable_indices set.\n      for kind_idx in non_grabbable_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Cell contains a non-walkable item\n\n      # Agent cannot walk onto the primitive itself; collection happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      return True\n\n  def _is_primitive_in_agent_neighborhood(agent_r, agent_c):\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood of (agent_r, agent_c)\n      on the initial grid.\n      \"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_check, agent_c + dc_check\n              # Ensure the cell being checked is within grid bounds.\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  return True\n      return False\n\n  def _simulate_action_effect(pos, direction, action_to_simulate):\n      \"\"\"Calculates the new (position, direction) tuple after performing an action.\"\"\"\n      r, c = pos\n      d = direction\n\n      if action_to_simulate == MOVE_FORWARD_ACTION:\n          dr, dc = DIR_TO_DRDC[d]\n          return (r + dr, c + dc), d\n      elif action_to_simulate == TURN_LEFT_ACTION:\n          return (r, c), TURN_LEFT_MAP[d]\n      elif action_to_simulate == TURN_RIGHT_ACTION:\n          return (r, c), TURN_RIGHT_MAP[d]\n      \n      # Should not reach here with valid actions, but return current state as fallback\n      return pos, direction\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just use the item. This leverages the CraftState.next_to method.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the shortest sequence of actions to reach a collectable state.\n\n  # BFS Loop: continues as long as there are states to explore.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      if _is_primitive_in_agent_neighborhood(r, c):\n          target_path = path_actions # Shortest path to this position found.\n          break # Terminate BFS as the goal is reached.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      possible_actions = [MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION]\n\n      for action in possible_actions:\n          next_pos, next_dir = _simulate_action_effect(current_pos, current_dir, action)\n          next_r, next_c = next_pos\n\n          # Check if the next state (position, direction) has been visited.\n          if (next_pos, next_dir) not in visited:\n              # For movement actions, also check if the target cell is walkable.\n              if action == MOVE_FORWARD_ACTION and not _is_cell_walkable(next_r, next_c):\n                  continue # Cannot move to this cell, skip this action path.\n\n              # If reachable and not visited, add to queue for exploration.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [action]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final USE action\n  # to actually perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:28:38.642942", "function_name": "collect", "function_body": "  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Define actions using the environment's action specifications for clarity\n  ACTION_MAPPING = env.action_specs()\n  MOVE_FORWARD_ACTION = ACTION_MAPPING['UP']\n  TURN_LEFT_ACTION = ACTION_MAPPING['LEFT']\n  TURN_RIGHT_ACTION = ACTION_MAPPING['RIGHT']\n  USE_ACTION = ACTION_MAPPING['USE']\n\n  # Directional offsets (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_OFFSETS = {\n      0: (0, 1),   # RIGHT: row stays, column increases\n      1: (-1, 0),  # UP: row decreases, column stays\n      2: (0, -1),  # LEFT: row stays, column decreases\n      3: (1, 0)    # DOWN: row increases, column stays\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are obtained from the CraftWorld configuration's non-grabbable set.\n  blocking_entity_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper Functions ---\n  def _is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is a valid and walkable location.\"\"\"\n      # Check if cell is within grid boundaries\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n\n      # Check if the cell contains any blocking non-grabbable entities\n      for kind_idx in blocking_entity_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # Cannot walk through this kind\n\n      # The agent cannot walk onto the primitive itself to collect it;\n      # collection happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # Cannot walk onto the primitive to collect it\n\n      return True\n\n  def _is_primitive_in_agent_neighborhood(agent_r: int, agent_c: int) -> bool:\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood centered at (agent_r, agent_c).\"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_check, agent_c + dc_check\n              # Ensure the cell being checked is within grid bounds and contains the primitive\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  return True\n      return False\n  # --- End of Helper Functions ---\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's\n  # current position, no pathfinding is needed; just execute the USE action directly.\n  # The `next_to` method of CraftState provides this check efficiently.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here ).\n  # This allows tracking both location and orientation, crucial for movement.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant\n  # computations and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the shortest sequence of actions to reach a collectable state.\n\n  # BFS Loop: Continues as long as there are states to explore.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      # A goal state means the primitive is located in any cell within the 3x3 neighborhood.\n      if _is_primitive_in_agent_neighborhood(r, c):\n          target_path_actions = path_so_far # Shortest path to this collectable position found.\n          break # Terminate BFS as the goal is reached.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Move Forward:\n      move_dr, move_dc = DIR_OFFSETS[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # If the next cell is walkable and this (position, direction) state hasn't been visited:\n      if _is_cell_walkable(next_r, next_c) and \\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir)) # Mark new state as visited.\n          queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION])) # Add to queue for exploration.\n\n      # 2. Try Turn Left:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning changes only direction, not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning changes only direction, not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final USE action\n  # to actually perform the collection.\n  if target_path_actions is not None:\n      target_path_actions.append(USE_ACTION)\n      return target_path_actions\n  else:\n      return [] # Return an empty list if no path to the primitive was found.", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T04:29:25.365832", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n          # by summing counts for all non-grabbable kinds at that cell.\n          # Only perform sum if there are non-walkable kinds defined to avoid error on empty list.\n          if non_walkable_kinds_indices_list and np.sum(initial_grid[next_r, next_c, non_walkable_kinds_indices_list]) > 0:\n              is_walkable = False\n          # Agent also cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
