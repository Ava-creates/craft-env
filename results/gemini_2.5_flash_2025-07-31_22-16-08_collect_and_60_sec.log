BFS to prevent excessive search:\n  # MAX_EXPLORED_STATES: limit on the number of unique states visited across all paths.\n  # This is a global exploration limit. If hit, we assume the item is unreachable within reasonable bounds.\n  # Max possible (pos, dir) states is WIDTH * HEIGHT * 4. We multiply by a factor for inventory variations.\n  # Increased factor to allow for more complex scenarios or larger search spaces.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 75 \n  \n  # MAX_PATH_LENGTH: limit on the length of any single path.\n  # This prevents excessively long, potentially unrewarding paths and limits memory usage from path lists.\n  # Increased factor to allow for longer valid paths.\n  MAX_PATH_LENGTH = grid_width * grid_height * 4 * 5 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it.\n    explored_states_count += 1\n\n    # Global Pruning: If the number of explored distinct states exceeds the limit, stop the entire search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # No path found within the exploration limits.\n    \n    # Path Pruning: If the current path length exceeds the maximum allowed, stop exploring this branch.\n    if len(path) >= MAX_PATH_LENGTH:\n        continue # This path is too long; do not explore further from it.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the target primitive (`i_kind`) is present in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        \n        # IMPROVEMENT for collect_v2: Handle items directly on the agent's square.\n        # If the primitive is a grabbable item and is present at the agent's current position,\n        # it can often be collected with a simple USE action without needing to face it.\n        if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n            inventory_before_use = np.copy(state.inventory)\n            _, state_after_use = state.step(USE_ACT)\n            \n            # Verify if the item was successfully collected.\n            if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                return path + [USE_ACT] # Collected from current square, no turns needed.\n\n        # Original Scenario (from v1): Primitive is in an adjacent cell and needs to be faced.\n        for target_dir in range(4): # 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If so, simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding for collection, not optimizing reward.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., needing a tool or being grabbable) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the complete sequence of actions.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # This includes movement actions (UP, DOWN, LEFT, RIGHT) and a general 'USE' action.\n    # The general 'USE' action is important if using an item at the current position (e.g., picking up a tool,\n    # or using a crafting bench to produce an intermediate item) can change the inventory or capabilities,\n    # which might be necessary for later steps to collect the primitive.\n    \n    # Explore movement actions\n    for action in move_actions:\n      _, next_state = state.step(action) # CraftState.step returns a new state object.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the defined limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T15:03:02.499644", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  # This is nested for strong encapsulation as it's only used by collect.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # Helper function to generate all possible next states and their corresponding actions\n  # from a given current state. This encapsulates the logic for exploring movements and USE actions.\n  def _get_possible_next_transitions(state, current_path):\n      transitions = []\n      grid_width, grid_height, _ = state.grid.shape\n      current_r, current_c = state.pos\n      current_dir = state.dir\n\n      # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n      for action in move_actions:\n          _, next_state = state.step(action)\n          # For movement, the 'inventory_before_action' is simply the current state's inventory.\n          transitions.append((next_state, current_path + [action], np.copy(state.inventory)))\n\n      # 2. Explore USE_ACT at current position\n      # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n      inventory_before_use_at_pos = np.copy(state.inventory)\n      grid_before_use_at_pos = np.copy(state.grid) # Capture grid state before USE\n      _, state_after_use_at_pos = state.step(USE_ACT)\n      \n      # Only consider this transition if the USE_ACT actually resulted in a state change\n      # (e.g., inventory changed, or grid changed, or position/direction changed).\n      state_changed_by_use_at_pos = not (\n          np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n          state_after_use_at_pos.pos == state.pos and\n          state_after_use_at_pos.dir == state.dir and\n          np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n      )\n      if state_changed_by_use_at_pos:\n          transitions.append((state_after_use_at_pos, current_path + [USE_ACT], inventory_before_use_at_pos))\n      \n      # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n      # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n      for target_dir in range(4): # Iterate through all four possible facing directions\n          dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n          facing_r, facing_c = current_r + dr, current_c + dc\n\n          # Check if the facing cell is within grid bounds and contains *any* entity.\n          # This ensures we only attempt to interact with existing entities.\n          if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n              turns_to_face = _get_turning_actions(current_dir, target_dir)\n              \n              # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n              # state.step() returns a new CraftState object, so this simulation is safe.\n              temp_state_before_use_step = state\n              for turn_action in turns_to_face:\n                  _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n              \n              # Capture inventory and grid states immediately before the final USE_ACT.\n              inventory_before_adj_use = np.copy(temp_state_before_use_step.inventory)\n              grid_before_adj_use = np.copy(temp_state_before_use_step.grid)\n              \n              # Perform the USE_ACT.\n              _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n              \n              # Only add this transition if the USE_ACT resulted in a change of state.\n              state_changed_by_adj_use = not (\n                  np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                  state_after_adj_use.pos == temp_state_before_use_step.pos and\n                  state_after_adj_use.dir == temp_state_before_use_step.dir and\n                  np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n              )\n              if state_changed_by_adj_use:\n                  transitions.append(\n                      (state_after_adj_use, current_path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                  )\n      return transitions\n\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  # Hashing the grid via .tobytes() provides a robust way to distinguish states where the grid layout changes.\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits to prevent excessively long searches for unfeasible goals\n  # or in very large/complex maps. These limits enhance robustness by preventing\n  # runaway computations for tasks that might be practically unreachable or too complex.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 # Max unique states to explore\n  MAX_PATH_LENGTH = 250 # Max length of action path to consider\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a limit,\n    # we stop exploring further from this path to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue \n\n    # Generate all possible next transitions from the current state using the helper function.\n    potential_next_transitions = _get_possible_next_transitions(state, path)\n\n    # Process all generated potential next transitions.\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        # This is the goal condition: inventory count of i_kind increased.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or exceeded the search limits (MAX_EXPLORED_STATES or MAX_PATH_LENGTH).\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:03:05.620565", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This includes items defined as primitives, special environment items like water/stone,\n  # and any other items explicitly marked as grabbable.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible.\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3]\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1:\n          return [RIGHT_ACT] # One right turn\n      elif diff == 3:\n          return [LEFT_ACT]  # One left turn\n      else: # diff == 2 (180-degree turn)\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The visited set must capture the full state to prevent redundant exploration,\n  # especially if grid changes without immediate inventory/position changes.\n  # State key: (grid_hash, row, col, direction, inventory_tuple)\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  # Hash the grid to include its state in the visited key.\n  # .tobytes() converts the numpy array to a bytes object, which is hashable.\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits to prevent excessively long searches for unfeasible goals\n  # or in very large/complex maps. These limits enhance robustness by preventing\n  # runaway computations for tasks that might be practically unreachable or too complex.\n  # Maximum number of unique states to explore.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 150 \n  # Maximum length of action path to consider. Paths longer than this are likely\n  # suboptimal or indicate an unreachable goal within reasonable steps.\n  MAX_PATH_LENGTH = 250 # A practical limit for a single collection task\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states or the path length exceeds a limit,\n    # we stop exploring from this path to prevent runaway searches.\n    if explored_states_count > MAX_EXPLORED_STATES or len(path) >= MAX_PATH_LENGTH:\n      continue # Do not explore further from this path\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # List to store (next_state_object, actions_to_reach_next_state, inventory_before_last_action_applied)\n    # Storing 'inventory_before_last_action_applied' is crucial for checking if the goal item\n    # was *specifically* acquired in the last step of a transition.\n    potential_next_transitions = []\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        _, next_state = state.step(action)\n        # For movement, the 'inventory_before_action' is simply the current state's inventory.\n        # Since state.step returns a new state, state.inventory is not modified, so no copy is needed.\n        potential_next_transitions.append((next_state, path + [action], state.inventory))\n\n    # 2. Explore USE_ACT at current position\n    # This handles collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    # Since state.step returns a new state, state.inventory and state.grid are not modified, so no copies are needed here.\n    inventory_before_use_at_pos = state.inventory\n    grid_before_use_at_pos = state.grid\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Only consider this transition if the USE_ACT actually resulted in a state change\n    # (e.g., inventory changed, or grid changed, or position/direction changed - though USE typically only changes inventory/grid).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n    state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them)\n    # This handles interacting with items/structures in the surrounding environment (e.g., chopping trees, mining rocks).\n    for target_dir in range(4): # Iterate through all four possible facing directions\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the facing cell is within grid bounds and contains *any* entity.\n        # This broad check allows interaction with any relevant environmental object\n        # that might yield the target primitive (e.g., 'ROCK' to get 'GOLD').\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            \n            # Simulate the turns to get the agent into the correct orientation before the USE_ACT.\n            # Create a temporary state to simulate turns without affecting the main BFS 'state'\n            temp_state_before_use_step = state\n            for turn_action in turns_to_face:\n                _, temp_state_before_use_step = temp_state_before_use_step.step(turn_action)\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            # Since step returns a new state, temp_state_before_use_step.inventory/grid are not modified, so no copies are needed.\n            inventory_before_adj_use = temp_state_before_use_step.inventory\n            grid_before_adj_use = temp_state_before_use_step.grid\n            \n            # Perform the USE_ACT.\n            _, state_after_adj_use = temp_state_before_use_step.step(USE_ACT)\n            \n            # Only add this transition if the USE_ACT resulted in a change of state.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == temp_state_before_use_step.pos and\n                state_after_adj_use.dir == temp_state_before_use_step.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # First, check if the target primitive was successfully collected in this transition.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            return next_p # Goal achieved! Return the path immediately.\n\n        # If not the goal, add the new state to the queue if it hasn't been visited yet.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Hash grid for the visited set key\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # or exceeded the search limits (MAX_EXPLORED_STATES or MAX_PATH_LENGTH).\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:03:41.979386", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with optimized 'USE' action exploration conditions.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set stores a tuple representing (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a pragmatic limit to prevent extremely long searches.\n  # The multiplier '10' accounts for different relevant inventory states that might\n  # be reached (e.g., picking up a tool) during the search for the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # Optimization: Pre-convert `world.grabbable_indices` and `world.workshop_indices`\n  # to sets for faster `O(1)` average time lookups during the BFS loop.\n  grabbable_indices_set = set(world.grabbable_indices)\n  workshop_indices_set = set(world.workshop_indices)\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, skip processing this state.\n    # This acts as a soft limit, allowing states already in the queue to be processed,\n    # but prevents the search from expanding indefinitely from very long paths.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing cell is within grid bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Reward is always 0.0 in this implementation, so we use `_`.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                # Reward is always 0.0 in this implementation, so we use `_`.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed, resource depletion) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      # Reward is always 0.0, so we use `_`.\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Optimization: More efficiently check if a 'USE' action is worth exploring.\n    # A USE action is considered potentially useful if the agent is next to any grabbable item\n    # (which could be a tool or resource) OR if the agent is currently on a workshop.\n    \n    found_any_grabbable_next_to = False\n    # Check 3x3 neighborhood for any grabbable item (excluding current cell for 'next_to' semantic).\n    # This avoids repeated calls to `state.next_to` for each grabbable_index,\n    # improving efficiency when there are many grabbable types.\n    for r_offset in [-1, 0, 1]:\n        for c_offset in [-1, 0, 1]:\n            nr, nc = current_r + r_offset, current_c + c_offset\n            # Ensure cell is within grid bounds and is not the agent's current position (itself).\n            if (0 <= nr < grid_width and 0 <= nc < grid_height and \n                (nr, nc) != (current_r, current_c)): \n                # Check if *any* grabbable item is present at this (nr, nc) location.\n                for grabbable_idx in grabbable_indices_set: # Use the pre-converted set for O(1) average lookup\n                    if state.grid[nr, nc, grabbable_idx] == 1:\n                        found_any_grabbable_next_to = True\n                        break # Found one grabbable in this cell, no need to check others for this cell\n            if found_any_grabbable_next_to:\n                break # Found a grabbable in the neighborhood, no need to check other cells\n        if found_any_grabbable_next_to:\n            break # Found a grabbable in the neighborhood, no need to check other rows\n\n    # Check if agent is currently on a workshop cell.\n    is_on_workshop = any(state.grid[current_r, current_c, idx] == 1 for idx in workshop_indices_set) # Use the pre-converted set\n\n    if found_any_grabbable_next_to or is_on_workshop:\n        inventory_before_any_use = np.copy(state.inventory)\n        # Reward is always 0.0, so we use `_`.\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change\n        # (inventory, position, or direction changed). This prevents exploring redundant states.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
