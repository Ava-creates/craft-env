{"timestamp": "2025-08-01T08:01:01.356962", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds a path to an adjacent cell of the\n  primitive and then uses the primitive. Uses BFS for pathfinding.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute (move, turn, then use).\n        Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # Grid dimensions: (rows, columns, kinds)\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) delta for row/column change when moving 'forward'\n  # 0: Right (+X), 1: Up (-Y), 2: Left (-X), 3: Down (+Y)\n  # (dr, dc) -> (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (col increases)\n      1: (-1, 0),  # Facing UP (row decreases)\n      2: (0, -1),  # Facing LEFT (col decreases)\n      3: (1, 0)    # Facing DOWN (row increases)\n  }\n\n  # Map for updating agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify all kinds that block movement (cannot be stepped on).\n  # This includes non-grabbable environment entities AND the primitive itself (agent collects by using next to it).\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id)\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_position_tuple, current_direction_int) to prevent cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the state where primitive can be used\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column\n\n      # 1. Check if the primitive is directly in front of the agent at this current state.\n      # If so, we've found our path to the pre-collection state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found, exit BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within grid bounds, hasn't been visited, and is not a blocking kind\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited and\n          not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0)):\n          \n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the pre-collection state was found, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:02:18.180515", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with slightly refined BFS structure and explicit parameter passing for clarity.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Action Mappings\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Primitive ID and Grabbability Check\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      # Primitive name not found in cookbook, cannot collect.\n      return [] \n  \n  if primitive_id not in current_state.world.grabbable_indices:\n      # This item cannot be picked up (e.g., workshops, water, stone, boundary).\n      return []\n\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 3. Movement Constants\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (dr, dc)\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Helper functions (defined within collect_v2 for encapsulation and cleaner scope)\n\n  def _is_target_state(pos, current_dir, target_grid, target_primitive_id, width, height, dir_to_drdc_map):\n      \"\"\"Checks if the agent at `pos` facing `current_dir` is adjacent to and\n      facing the `target_primitive_id` on the `target_grid`.\"\"\"\n      r, c = pos\n      front_dr, front_dc = dir_to_drdc_map[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Check bounds for the cell in front of the agent\n      if not (0 <= front_r < width and 0 <= front_c < height):\n          return False \n      \n      # Check if the cell in front contains the target primitive\n      return target_grid[front_r, front_c, target_primitive_id] > 0\n\n  def _is_walkable_cell(pos, target_grid, target_primitive_id, non_walkable_indices, width, height):\n      \"\"\"Checks if the given cell `pos` is traversable by the agent.\"\"\"\n      r, c = pos\n      # Check bounds for the cell itself\n      if not (0 <= r < width and 0 <= c < height):\n          return False\n      \n      # A cell is not walkable if it contains any non-grabbable entity,\n      # or if it contains the specific primitive we are trying to collect.\n      for kind_idx in non_walkable_indices:\n          if target_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk directly onto the primitive it's trying to collect,\n      # as it needs to be adjacent to 'use' it.\n      if target_grid[r, c, target_primitive_id] > 0:\n          return False\n          \n      return True\n\n  def _get_neighbor_transitions(current_pos, current_dir, \n                                target_grid, target_primitive_id, non_walkable_indices, width, height,\n                                move_forward_action, turn_left_action, turn_right_action,\n                                dir_to_drdc_map, turn_left_map, turn_right_map):\n      \"\"\"Generates possible next states and actions from the current state (pos, dir).\"\"\"\n      transitions = []\n\n      # Attempt to Move Forward\n      move_dr, move_dc = dir_to_drdc_map[current_dir]\n      next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_move = (next_r, next_c)\n      \n      if _is_walkable_cell(next_pos_move, target_grid, target_primitive_id, non_walkable_indices, width, height):\n          # State after move: (new_pos, same_dir)\n          transitions.append(((next_pos_move, current_dir), move_forward_action))\n\n      # Attempt to Turn Left\n      next_dir_left = turn_left_map[current_dir]\n      # State after turn: (same_pos, new_dir)\n      transitions.append(((current_pos, next_dir_left), turn_left_action))\n\n      # Attempt to Turn Right\n      next_dir_right = turn_right_map[current_dir]\n      # State after turn: (same_pos, new_dir)\n      transitions.append(((current_pos, next_dir_right), turn_right_action))\n\n      return transitions\n\n\n  def _bfs_find_path(start_pos, start_dir, target_grid, target_primitive_id, \n                      non_walkable_indices, width, height,\n                      move_forward_action, turn_left_action, turn_right_action,\n                      dir_to_drdc_map, turn_left_map, turn_right_map):\n      \"\"\"Performs BFS to find the shortest sequence of actions to reach a state\n      from which the primitive can be 'used' (collected).\"\"\"\n      \n      # BFS state: ((row, col), direction)\n      # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if current state (position and direction) makes the primitive targetable\n          if _is_target_state(current_pos, current_dir, target_grid, target_primitive_id, width, height, dir_to_drdc_map):\n              return path_actions # Shortest path to target state found\n\n          # Explore all possible transitions from the current state\n          for (next_state_node, action_taken) in _get_neighbor_transitions(\n              current_pos, current_dir, \n              target_grid, target_primitive_id, non_walkable_indices, width, height,\n              move_forward_action, turn_left_action, turn_right_action,\n              dir_to_drdc_map, turn_left_map, turn_right_map\n          ):\n              if next_state_node not in visited:\n                  visited.add(next_state_node)\n                  new_path = path_actions + [action_taken]\n                  queue.append((new_state_node, new_path))\n      \n      return None # No path found\n\n  # Main logic for collect_v2\n  target_path = None\n\n  # First, check if the agent is already in a state to collect (adjacent and facing)\n  if _is_target_state(initial_pos, initial_dir, initial_grid, primitive_id, WIDTH, HEIGHT, DIR_TO_DRDC):\n      target_path = [] # No movement actions needed, just the USE action will follow\n\n  # If not immediately at the target, perform Breadth-First Search\n  if target_path is None:\n      target_path = _bfs_find_path(initial_pos, initial_dir, initial_grid, primitive_id, \n                                   non_walkable_kinds_indices, WIDTH, HEIGHT,\n                                   MOVE_FORWARD_ACTION, TURN_LEFT_ACTION, TURN_RIGHT_ACTION,\n                                   DIR_TO_DRDC, TURN_LEFT_MAP, TURN_RIGHT_MAP)\n\n  # If a path to the target state was found (or it was an immediate goal), append the final USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:02:19.421532", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:R, 1:U, 2:L, 3:D\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Define Action Mappings\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Define Movement Constants\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (c+1)\n      1: (-1, 0),  # Facing UP, move in negative row direction (r-1)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (c-1)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (r+1)\n  }\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # 3. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      return [] # Primitive name not found in the cookbook index\n\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the item is not grabbable (e.g., water, boundary, workshops), it cannot be 'collected'.\n      return [] \n\n  # Indices of entities that cannot be walked upon by the agent\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within grid bounds\n  def _is_valid_coord(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Helper function to check if a cell is traversable by the agent\n  def _is_walkable_cell(pos):\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any non-grabbable entity (e.g., water, workshops, stone)\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk directly onto the primitive it's trying to collect; it must stop adjacent to it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper function to check if the agent is positioned and facing the target primitive\n  # such that a 'USE' action would collect it.\n  def _is_target_facing(pos, current_dir):\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of bounds\n      \n      # Check if the cell directly in front of the agent contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # Breadth-First Search (BFS) to find the shortest path to a state\n  # where the primitive can be collected (i.e., agent is adjacent and facing it).\n  def _bfs_find_path():\n      # BFS state: ((row, col), direction)\n      # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((initial_pos, initial_dir), [])])\n      # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n      visited = {(initial_pos, initial_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Check if the current state (position and direction) makes the primitive targetable\n          if _is_target_facing(current_pos, current_dir):\n              return path_actions # Found the shortest sequence of actions to reach a \"ready-to-use\" state\n\n          # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n          \n          # 1. Attempt to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          next_dir_move = current_dir # Direction does not change when moving\n\n          if _is_walkable_cell(next_pos_move):\n              new_state = (next_pos_move, next_dir_move)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [MOVE_FORWARD_ACTION]\n                  queue.append((new_state, new_path))\n\n          # 2. Attempt to Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              queue.append((new_state_left, new_path_left))\n\n          # 3. Attempt to Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found to reach a state where the primitive can be collected\n\n  # --- Main logic for `collect_v2` ---\n  target_movement_actions = None\n\n  # First, check if the agent is already in a state to collect the primitive (adjacent and facing)\n  if _is_target_facing(initial_pos, initial_dir):\n      target_movement_actions = [] # No prior movement actions are needed\n\n  # If not already in position, perform BFS to find the shortest path\n  if target_movement_actions is None:\n      target_movement_actions = _bfs_find_path()\n\n  # If a path was successfully found (or it was an immediate goal), append the final USE action\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:03:33.102181", "function_name": "collect", "function_body": "  actions_to_take = []\n\n  # Get current state information from the environment.\n  current_craft_state = env._current_state\n  grid_layout = current_craft_state.grid\n  agent_initial_pos = current_craft_state.pos  # (row, col) tuple\n  agent_initial_dir = current_craft_state.dir  # int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n\n  # Get the unique integer ID for the target primitive from the cookbook index.\n  try:\n    target_primitive_id = current_craft_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    # Return an empty list, indicating no path.\n    return []\n\n  # Grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_layout.shape # Assuming WIDTH is rows, HEIGHT is cols for grid[r,c,k]\n\n  # Map action names to their integer IDs from the environment's action specifications.\n  action_id_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_id_map['UP']     # Agent moves one step in its current facing direction.\n  ACTION_TURN_LEFT = action_id_map['LEFT']       # Agent turns 90 degrees left, position unchanged.\n  ACTION_TURN_RIGHT = action_id_map['RIGHT']     # Agent turns 90 degrees right, position unchanged.\n  ACTION_USE = action_id_map['USE']             # Agent attempts to interact with the cell in front.\n\n  # Define changes in (row, col) for each direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n  # Used to calculate next position when moving forward or checking cell in front.\n  DIRECTION_DELTAS = {\n      0: (0, 1),   # Right: (row, col+1)\n      1: (-1, 0),  # Up: (row-1, col)\n      2: (0, -1),  # Left: (row, col-1)\n      3: (1, 0)    # Down: (row+1, col)\n  }\n\n  # Define how direction changes when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # R -> U -> L -> D -> R\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Get the set of entity IDs that cannot be walked upon by the agent.\n  # These typically include boundaries, water, and workshops that act as obstacles.\n  non_walkable_entity_ids = current_craft_state.world.non_grabbable_indices\n\n  # Helper function to determine if a grid cell is valid and passable for the agent.\n  # A cell is passable if it's within bounds, doesn't contain a non-walkable entity,\n  # and is not the target primitive itself (agent must stand *adjacent* to primitive).\n  def is_cell_passable(r_coord: int, c_coord: int) -> bool:\n      # 1. Check grid boundaries.\n      if not (0 <= r_coord < GRID_WIDTH and 0 <= c_coord < GRID_HEIGHT):\n          return False\n\n      # 2. Check for non-walkable obstacles.\n      # Iterate through all non-walkable kinds and see if the cell contains any.\n      for kind_id in non_walkable_entity_ids:\n          if grid_layout[r_coord, c_coord, kind_id] > 0:\n              return False\n      \n      # 3. Prevent walking *onto* the primitive itself. The agent needs to be adjacent.\n      if grid_layout[r_coord, c_coord, target_primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS state representation: ((row, col) tuple, direction integer)\n  # Queue stores: ( (current_position, current_direction), list_of_actions_taken_to_reach_here )\n  bfs_queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # Visited set: stores (position_tuple, direction_integer) to prevent redundant exploration\n  # and infinite loops in cyclic paths.\n  visited_states = {(agent_initial_pos, agent_initial_dir)}\n\n  shortest_path_to_target = None # Will store the action sequence if found.\n\n  # Start BFS\n  while bfs_queue:\n      (current_pos, current_dir), actions_path = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Goal Check ---\n      # Check the cell directly in front of the agent at the current state.\n      # If this cell contains the target primitive, we've found a state\n      # from which the 'USE' action can collect the primitive.\n      front_dr, front_dc = DIRECTION_DELTAS[current_dir]\n      cell_in_front_r, cell_in_front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within bounds and contains the target primitive.\n      if (0 <= cell_in_front_r < GRID_WIDTH and 0 <= cell_in_front_c < GRID_HEIGHT and\n          grid_layout[cell_in_front_r, cell_in_front_c, target_primitive_id] > 0):\n          \n          shortest_path_to_target = actions_path\n          break # Goal found! Exit BFS as we've found the shortest path.\n\n      # --- Explore Next Possible States ---\n      # For each possible action (Move Forward, Turn Left, Turn Right), calculate the\n      # resulting new state (position and direction) and add it to the queue if valid and unvisited.\n\n      # 1. Try ACTION_MOVE_FORWARD:\n      next_r_move, next_c_move = current_r + DIRECTION_DELTAS[current_dir][0], \\\n                                 current_c + DIRECTION_DELTAS[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward.\n\n      if is_cell_passable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited_states:\n              visited_states.add((next_pos_move, next_dir_move))\n              bfs_queue.append(((next_pos_move, next_dir_move), actions_path + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try ACTION_TURN_LEFT:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), actions_path + [ACTION_TURN_LEFT]))\n\n      # 3. Try ACTION_TURN_RIGHT:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), actions_path + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  if shortest_path_to_target is not None:\n      # If a path to being adjacent and facing the primitive was found,\n      # append the 'USE' action to complete the collection.\n      actions_to_take.extend(shortest_path_to_target)\n      actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:03:34.469412", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function implements a Breadth-First Search (BFS) to find the shortest\n  sequence of actions (movements and turns) required for the agent to reach\n  a position where it is adjacent to the specified primitive and facing it.\n  Once such a position is found, the 'USE' action is appended to the path\n  to simulate collecting the primitive.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation\n                          environment state.\n      primitive (str): The string name of the primitive item to collect\n                       (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A list of integer action codes (from `env.action_specs()`)\n                 representing the optimal path to collect the primitive.\n                 Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  actions_list = [] # This list will store the sequence of actions to be returned.\n\n  # Retrieve essential information from the current environment state.\n  current_state = env._current_state\n  grid = current_state.grid # The current grid layout (numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds))\n  initial_pos = current_state.pos # Agent's current position (tuple: (row, col))\n  initial_dir = current_state.dir # Agent's current facing direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Determine grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Map human-readable action names to their integer IDs provided by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # Assuming 'UP' in action_specs means move forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right.\n  USE_ACTION = action_map['USE']         # Action to interact with the object in front.\n\n  # Define changes in (row, col) for each facing direction when moving forward.\n  # Direction 0: Right (col increases), 1: Up (row decreases), 2: Left (col decreases), 3: Down (row increases).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (delta_row=0, delta_col=1)\n      1: (-1, 0),  # Facing UP: (delta_row=-1, delta_col=0)\n      2: (0, -1),  # Facing LEFT: (delta_row=0, delta_col=-1)\n      3: (1, 0)    # Facing DOWN: (delta_row=1, delta_col=0)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # E.g., if facing RIGHT (0), turning left makes agent face UP (1).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # E.g., if facing RIGHT (0), turning right makes agent face DOWN (3).\n\n  # Get the set of integer indices for entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP locations).\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper function for checking cell walkability ---\n  def is_cell_valid_and_walkable(r_coord: int, c_coord: int) -> bool:\n    \"\"\"\n    Checks if a given grid cell is within bounds and free of obstacles\n    that prevent the agent from moving onto it.\n    \"\"\"\n    # 1. Check if the cell coordinates are within the grid boundaries.\n    if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n      return False\n\n    # 2. Check if the cell contains any non-grabbable (non-walkable) entity.\n    # The agent cannot move onto cells occupied by these items.\n    for kind_idx in non_walkable_indices:\n      if grid[r_coord, c_coord, kind_idx] > 0:\n        return False\n\n    # 3. Crucially, the agent cannot walk directly *onto* the primitive it intends to collect.\n    # It must be adjacent to the primitive to use it.\n    if grid[r_coord, c_coord, primitive_id] > 0:\n      return False\n    \n    # If all checks pass, the cell is safe for the agent to move into.\n    return True\n\n  # --- BFS Initialization ---\n  # The queue will store tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set will store (position_tuple, direction_int) pairs to prevent redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest sequence of actions to reach the \"goal state\".\n\n  # --- BFS Execution ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # **GOAL CHECK**: Determine if the agent is currently in a state where it can collect the primitive.\n      # This means the primitive must be in the cell directly in front of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the 'front' cell is within grid boundaries AND if it contains the target primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and \\\n         (grid[front_r, front_c, primitive_id] > 0):\n          # If true, we've found the shortest path to a position where the agent can USE the primitive.\n          target_path_actions = path_so_far\n          break # Exit the BFS loop as the shortest path is found.\n\n      # **EXPLORE NEXT STATES**: Generate possible next states by applying valid actions.\n\n      # 1. Attempt to Move Forward:\n      # Calculate the new position if the agent moves forward. Direction remains unchanged.\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change with forward movement.\n\n      # Check if the new position is valid and walkable, and if this new state (pos, dir) has not been visited.\n      if is_cell_valid_and_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move)) # Mark new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Attempt to Turn Left:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new state (pos, dir) has not been visited.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Attempt to Turn Right:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new state (pos, dir) has not been visited.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path.\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- Finalizing the Action List ---\n  # If a path to the target (adjacent and facing the primitive) was successfully found during BFS.\n  if target_path_actions is not None:\n      # Extend the found path with the 'USE' action to complete the collection.\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  # If target_path_actions is None, it means the primitive was unreachable from the current state.\n  # In this case, an empty list (initialized at the start) will be returned.\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:04:38.869495", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Map the string name of the primitive to its corresponding integer index\n  # used internally by the simulation. This will raise an error if the\n  # primitive name is not recognized, which is desired.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve integer codes for fundamental movement and interaction actions.\n  # This makes the code more readable and robust to changes in action mapping.\n  action_map = env.action_specs()\n  USE = action_map['USE']\n  \n  # Get individual action constants for clarity in pathfinding.\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n\n  # 1. Immediate Collection Check:\n  # If the agent is already in a position where it can interact with (collect)\n  # the primitive (i.e., within its 3x3 neighborhood), the only action needed is USE.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Define possible cardinal movement directions and their corresponding action indices.\n  # CraftWorld typically uses 4-directional movement (UP, DOWN, LEFT, RIGHT).\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # Define a nested helper function for Breadth-First Search (BFS) pathfinding.\n  # This encapsulates the BFS logic, improving readability and modularity.\n  def _find_path_bfs(start_pos: tuple[int, int], goal_cells: set[tuple[int, int]], \n                      grid: np.ndarray, impassable_kinds: set[int]) -> list[int]:\n      \"\"\"\n      Performs BFS to find the shortest path from start_pos to any goal_cell,\n      avoiding impassable kinds.\n\n      Args:\n          start_pos (tuple[int, int]): The agent's starting (x, y) position.\n          goal_cells (set[tuple[int, int]]): A set of (x, y) target positions.\n          grid (np.ndarray): The current state grid.\n          impassable_kinds (set[int]): Indices of entity kinds that cannot be moved onto.\n\n      Returns:\n          list[int]: The list of action indices representing the shortest path,\n                     or an empty list if no path is found.\n      \"\"\"\n      grid_width, grid_height, _ = grid.shape\n      \n      # BFS Queue: stores tuples of (current_position, list_of_actions_to_reach_this_position).\n      q = collections.deque([(start_pos, [])]) \n      # Set to keep track of visited positions to prevent infinite loops and redundant paths.\n      visited = {start_pos} \n\n      while q:\n          # Dequeue the current position and the path leading to it.\n          (cx, cy), path_to_current = q.popleft() \n\n          # If the current position is one of our target goal cells, we've found the shortest path.\n          if (cx, cy) in goal_cells:\n              return path_to_current\n\n          # Explore all valid, unvisited, and traversable neighboring cells.\n          for (dx, dy), action in DELTAS_ACTIONS:\n              nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n              new_pos = (nx, ny)\n\n              # Check 1: Boundary Check - Is the new position within the grid?\n              if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                  continue # Skip if out of bounds.\n\n              # Check 2: Impassability Check - Does the new position contain an impassable kind?\n              is_impassable_cell = False\n              for k_idx in impassable_kinds:\n                  # If an impassable kind is present at the new cell, it's blocked.\n                  if grid[nx, ny, k_idx] > 0: \n                      is_impassable_cell = True\n                      break # No need to check further kinds for this cell.\n              \n              if is_impassable_cell:\n                  continue # Skip if the cell is impassable.\n\n              # Check 3: Visited Check - Has this position already been explored?\n              if new_pos not in visited:\n                  visited.add(new_pos) # Mark as visited.\n                  # Enqueue the new position along with the updated path.\n                  q.append((new_pos, path_to_current + [action]))\n      \n      return [] # If the queue is empty and no goal was reached, no path exists.\n\n  # 2. Identify all physical locations of the primitive on the game grid.\n  grid = current_state.grid\n  \n  # Use numpy's vectorized `where` function for efficient lookup of primitive locations.\n  # `np.where` returns a tuple of arrays, where each array corresponds to the indices\n  # along a dimension. For a (WIDTH, HEIGHT, KINDS) grid, it returns (x_indices, y_indices).\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  \n  # Combine the x and y coordinates into a list of (x, y) tuples.\n  primitive_grid_locations = list(zip(primitive_x_coords, primitive_y_coords))\n\n  # If no instances of the primitive are found anywhere on the grid,\n  # it cannot be collected, so return an empty list of actions.\n  if not primitive_grid_locations:\n    return []\n\n  # 3. Define \"Goal Cells\" for the BFS:\n  # A goal cell is any traversable cell from which the agent can successfully\n  # \"collect\" the primitive using the 'USE' action. Based on `CraftState.next_to`,\n  # this includes any cell within the 3x3 neighborhood of a primitive's location.\n  goal_cells = set()\n  grid_width, grid_height, _ = grid.shape \n  for px, py in primitive_grid_locations:\n    # Iterate through all 3x3 neighbor offsets (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which cell types are impassable for agent movement.\n  # Impassable kinds are typically non-grabbable items that are not designated\n  # as 'workshop' locations (which are usually traversable).\n  # Examples: water, stone, boundaries.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform BFS using the nested helper function to find the path.\n  start_pos = current_state.pos\n  \n  path_to_goal = _find_path_bfs(start_pos, goal_cells, grid, impassable_kinds)\n  \n  if path_to_goal:\n      # If a path was found, append the 'USE' action as the final step to collect the primitive.\n      return path_to_goal + [USE]\n  else:\n      # If no path to a goal cell was found, it means the primitive is unreachable\n      # from the agent's current position, so return an empty list.\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:04:39.956484", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  Returns a list of actions to find and collect the specified primitive in the environment.\n  It uses a Breadth-First Search (BFS) to find the shortest path to a location\n  from which the primitive can be collected, then appends a 'USE' action.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The string name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of action indices (e.g., UP, DOWN, USE) to execute.\n                 Returns an empty list if the primitive is already collected,\n                 not found on the grid, or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  \n  # --- 1. Initialize Essential Data ---\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This will raise a KeyError if the primitive name is not recognized.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Map action names to their integer representations for clarity and robustness.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions for boundary checks and agent's current position.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  agent_start_pos = current_state.pos # Agent's current (x, y) position.\n\n  # --- 2. Immediate Collection Check ---\n  # If the agent is already adjacent to the primitive, no movement is needed; just 'USE'.\n  if current_state.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # --- 3. Locate All Primitive Instances on the Grid ---\n  # Find all (x, y) coordinates where the primitive currently exists.\n  primitive_locations_on_grid = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this cell (count > 0).\n      if grid[x, y, primitive_idx] > 0: \n        primitive_locations_on_grid.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it cannot be collected.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- 4. Define Reachable \"Goal Cells\" for Pathfinding ---\n  # A goal cell is any traversable cell from which the agent can successfully \n  # `USE` to collect the primitive. This includes any cell within a 3x3 neighborhood \n  # (including the primitive's own cell, if traversable).\n  target_goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_goal_cells.add((gx, gy))\n\n  # --- 5. Identify Impassable Terrain Kinds ---\n  # These are entities the agent cannot move onto. Typically, non-grabbable items\n  # that are not designated as workshops (which are often traversable interaction points).\n  impassable_entity_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- 6. Perform Breadth-First Search (BFS) for the Shortest Path ---\n  # Queue for BFS: stores (current_position (tuple), path_actions_to_reach_here (list)).\n  bfs_queue = collections.deque([(agent_start_pos, [])]) \n  # Set to track visited positions to avoid cycles and redundant exploration.\n  visited_positions = {agent_start_pos} \n\n  # Define possible moves (delta_x, delta_y) and their corresponding action indices.\n  # CraftWorld typically supports 4-directional (cardinal) movement.\n  cardinal_moves = [\n      ((0, -1), ACTION_UP),    # Move North (decreases Y)\n      ((0, 1), ACTION_DOWN),   # Move South (increases Y)\n      ((-1, 0), ACTION_LEFT),  # Move West (decreases X)\n      ((1, 0), ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  while bfs_queue:\n    current_pos, path_so_far = bfs_queue.popleft() \n    cx, cy = current_pos\n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if current_pos in target_goal_cells:\n      # Append the 'USE' action as the final step to collect the primitive.\n      return path_so_far + [ACTION_USE]\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action_to_take in cardinal_moves:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check 1: Boundary Check - Is the next position within the grid?\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the next position contain an impassable entity?\n      is_next_cell_impassable = False\n      for k_idx in impassable_entity_indices:\n          if grid[next_x, next_y, k_idx] > 0: # If this impassable kind is present at the cell.\n              is_next_cell_impassable = True\n              break # No need to check further kinds for this cell.\n      \n      if is_next_cell_impassable:\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if next_pos not in visited_positions:\n        visited_positions.add(next_pos) # Mark as visited.\n        # Enqueue the new position along with the updated path.\n        bfs_queue.append((next_pos, path_so_far + [action_to_take]))\n\n  # If the BFS completes without finding a path to any goal cell,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:05:29.577727", "function_name": "collect", "function_body": "  current_state = env._current_state \n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the integer ID for the target primitive from the environment's cookbook.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Retrieve action mappings for clearer and more robust code.\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define movement deltas associated with their corresponding actions.\n  DELTAS_AND_ACTIONS = [\n      ((-1, 0), UP),  # Move Up: Decrement row\n      ((1, 0), DOWN), # Move Down: Increment row\n      ((0, -1), LEFT), # Move Left: Decrement column\n      ((0, 1), RIGHT)  # Move Right: Increment column\n  ]\n\n  # --- Pre-checks for early exit ---\n  # 1. If the primitive is not in the set of grabbable items, it cannot be collected.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. If the agent is already adjacent to the primitive, a single 'USE' action is sufficient.\n  # The `next_to` method checks if any cell in the 3x3 neighborhood contains the primitive.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  # The goal of BFS here is to find the shortest sequence of movement actions\n  # that leads the agent to a position from which it can 'USE' (collect) the primitive.\n\n  # q: A deque used as a queue for BFS, storing (row, col) positions to explore.\n  q = collections.deque([start_pos]) \n  # visited: A set of (row, col) tuples to keep track of visited positions,\n  # preventing cycles and redundant exploration.\n  visited = {start_pos} \n  # came_from: A dictionary used to reconstruct the path once the target is found.\n  # It maps `current_pos` to a tuple: `(parent_pos, action_taken_to_reach_current_pos)`.\n  came_from = {start_pos: (None, None)} # Start position has no parent or action.\n\n  target_adjacent_pos = None # This will store the position from which 'USE' can be applied.\n  \n  while q:\n      curr_r, curr_c = q.popleft()\n      curr_pos = (curr_r, curr_c)\n\n      # Check if the current BFS node's position (`curr_pos`) is adjacent to the primitive.\n      # This check is performed manually to avoid creating `CraftState` objects in the loop.\n      is_adjacent_to_primitive = False\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              if dr_adj == 0 and dc_adj == 0: # Skip the agent's current position itself\n                  continue\n              \n              adj_r, adj_c = curr_r + dr_adj, curr_c + dc_adj\n              \n              # Check bounds for the adjacent cell\n              if not (0 <= adj_r < WIDTH and 0 <= adj_c < HEIGHT):\n                  continue\n              \n              # If the adjacent cell contains the primitive\n              if grid[adj_r, adj_c, primitive_id] == 1:\n                  is_adjacent_to_primitive = True\n                  break # Found primitive in 3x3 neighborhood\n          if is_adjacent_to_primitive:\n              break # Found primitive in 3x3 neighborhood\n      \n      if is_adjacent_to_primitive:\n          target_adjacent_pos = curr_pos\n          break # Shortest path to an adjacent position found, exit BFS.\n\n      # Explore valid neighboring cells from the current position.\n      for (dr_move, dc_move), action_val in DELTAS_AND_ACTIONS:\n          next_r, next_c = curr_r + dr_move, curr_c + dc_move\n          next_pos = (next_r, next_c)\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n\n          # Check 2: Ensure the new position is traversable (not an obstacle).\n          # A cell is considered non-traversable if it contains any item whose kind index\n          # is present in the `world.non_grabbable_indices` set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, i_kind] == 1: # If this cell is occupied by an obstacle.\n                  is_traversable = False\n                  break # This neighbor is blocked.\n          if not is_traversable:\n              continue\n\n          # Check 3: If this neighbor has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append(next_pos)\n              # Record how we reached this `next_pos` from `curr_pos`.\n              came_from[next_pos] = (curr_pos, action_val)\n\n  # --- Path Reconstruction ---\n  final_actions = []\n  if target_adjacent_pos is not None:\n      # Reconstruct the path by backtracking from the target adjacent position to the start position.\n      path_actions = []\n      current_node = target_adjacent_pos\n      while current_node != start_pos:\n          parent, action = came_from[current_node]\n          path_actions.append(action)\n          current_node = parent\n      \n      # The path is built in reverse order (from target back to start), so reverse it.\n      path_actions.reverse()\n      \n      # After reaching the adjacent position, the final action to collect is 'USE'.\n      final_actions.extend(path_actions)\n      final_actions.append(USE) \n  \n  return final_actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:05:30.825512", "function_name": "collect", "function_body": "  current_state = env._current_state \n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the integer ID for the target primitive from the environment's cookbook.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Retrieve action mappings for clearer and more robust code.\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define movement deltas associated with their corresponding actions.\n  DELTAS_AND_ACTIONS = [\n      ((-1, 0), UP),  # Move Up: Decrement row\n      ((1, 0), DOWN), # Move Down: Increment row\n      ((0, -1), LEFT), # Move Left: Decrement column\n      ((0, 1), RIGHT)  # Move Right: Increment column\n  ]\n\n  # --- Pre-checks for early exit ---\n  # 1. If the primitive is not in the set of grabbable items, it cannot be collected.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. If the agent is already adjacent to the primitive, a single 'USE' action is sufficient.\n  # Leverage the existing CraftState.next_to method for this initial check.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  # The goal of BFS here is to find the shortest sequence of movement actions\n  # that leads the agent to a position from which it can 'USE' (collect) the primitive.\n\n  # q: A deque used as a queue for BFS, storing (row, col) positions to explore.\n  q = collections.deque([start_pos]) \n  # visited: A set of (row, col) tuples to keep track of visited positions,\n  # preventing cycles and redundant exploration.\n  visited = {start_pos} \n  # parent_map: A dictionary used to reconstruct the path once the target is found.\n  # It maps `current_pos` to a tuple: `(parent_pos, action_taken_to_reach_current_pos)`.\n  parent_map = {start_pos: (None, None)} # Start position has no parent or action.\n\n  target_adjacent_pos = None # This will store the position from which 'USE' can be applied.\n  \n  while q:\n      curr_r, curr_c = q.popleft()\n      curr_pos = (curr_r, curr_c)\n\n      # Check if the current BFS node's position (`curr_pos`) is adjacent to the primitive.\n      # Replicate CraftState.next_to logic to avoid creating a new object in the loop.\n      found_target_adj_for_curr_pos = False\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              if dr_adj == 0 and dc_adj == 0: # Don't check the current position itself\n                  continue\n              check_r, check_c = curr_r + dr_adj, curr_c + dc_adj\n              # Ensure the neighbor is within grid boundaries\n              if 0 <= check_r < WIDTH and 0 <= check_c < HEIGHT:\n                  # Check if this neighbor cell contains the primitive\n                  if grid[check_r, check_c, primitive_id] == 1:\n                      target_adjacent_pos = curr_pos\n                      found_target_adj_for_curr_pos = True\n                      break # Found primitive in neighborhood, break inner loop\n          if found_target_adj_for_curr_pos:\n              break # Found primitive, break outer loop\n\n      if found_target_adj_for_curr_pos:\n          break # Shortest path to an adjacent position found, exit BFS.\n\n      # Explore valid neighboring cells from the current position.\n      for (dr_move, dc_move), action_val in DELTAS_AND_ACTIONS:\n          next_r, next_c = curr_r + dr_move, curr_c + dc_move\n          next_pos = (next_r, next_c)\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n\n          # Check 2: If this neighbor has already been visited, skip it.\n          if next_pos in visited:\n              continue\n\n          # Check 3: Ensure the new position is traversable (not an obstacle).\n          # A cell is considered non-traversable if it contains any item whose kind index\n          # is present in the `world.non_grabbable_indices` set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, i_kind] == 1: # If this cell is occupied by an obstacle.\n                  is_traversable = False\n                  break # This neighbor is blocked.\n          if not is_traversable:\n              continue\n\n          # If valid and unvisited, add to queue and mark as visited.\n          visited.add(next_pos)\n          q.append(next_pos)\n          # Record how we reached this `next_pos` from `curr_pos`.\n          parent_map[next_pos] = (curr_pos, action_val)\n\n  # --- Path Reconstruction ---\n  final_actions = []\n  if target_adjacent_pos is not None:\n      path_segments = []\n      current = target_adjacent_pos\n      # Backtrack from the target adjacent position to the start position\n      while current != start_pos:\n          parent, action = parent_map[current]\n          path_segments.append(action)\n          current = parent\n      \n      # The path is built in reverse order (from target back to start), so reverse it.\n      path_segments.reverse() \n      \n      # Add the movement actions to the final list\n      final_actions.extend(path_segments)\n      # After reaching the adjacent position, the final action is 'USE' to collect the primitive.\n      final_actions.append(USE) \n  \n  return final_actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:06:27.507222", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID (this is the desired item for inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' kind on the grid that needs to be interacted with\n  # (e.g., 'tree' to get 'wood', or 'water' to get 'water').\n  i_kind_source = -1 # Default to an invalid value\n\n  # Case A: Primitive is directly grabbable (appears on grid and can be picked up)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: Primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # These mappings reflect the environment's gathering mechanics.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\", \n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Add other mappings if the environment contains more implicit resource sources\n          # that are gathered via a USE action on a distinct grid entity.\n      }\n      source_entity_name_str = primitive_to_source_entity_name.get(primitive.lower())\n      \n      if source_entity_name_str:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name_str]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid \n          # (e.g., it's a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid, it means the primitive cannot be collected by this function's logic.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # as inventory changes (e.g., gaining a tool) can open up new possibilities.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Dynamically scale MAX_EXPLORED_STATES based on grid size and number of unique kinds.\n  # This helps manage search complexity in larger or more diverse environments.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Is the 'source' entity at the agent's current position?\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Is the 'source' entity in an adjacent cell (3x3 neighborhood)?\n    # We use `state.next_to(i_kind_source)` for an efficient check first.\n    # Then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind_source):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds AND contains the target source entity\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind_source] == 1):\n                \n                # Simulate the turning actions required to face the source entity.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the *target primitive* in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., requiring tools) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
