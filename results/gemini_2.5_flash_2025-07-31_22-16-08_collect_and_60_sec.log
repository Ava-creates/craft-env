{"timestamp": "2025-08-01T05:33:16.556910", "function_name": "collect", "function_body": "  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos    # Agent's initial position (row, col)\n  initial_dir = current_state.dir    # Agent's initial direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map action names from the DSL to their integer IDs using env.action_specs()\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # 'UP' action moves the agent forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']           # Action to interact with an adjacent item\n\n  # Define how agent's position changes based on its direction when moving forward\n  # (dr, dc) tuple represents (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column\n      1: (-1, 0),  # Facing UP: -1 to row\n      2: (0, -1),  # Facing LEFT: -1 to column\n      3: (1, 0)    # Facing DOWN: +1 to row\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # R -> D -> L -> U -> R\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOPs)\n  # Agent cannot move into cells occupied by these kinds.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Immediate Goal Check ---\n  # Check if the agent is already in a state where it can perform the USE action\n  # (i.e., the primitive is in the cell directly in front of the agent).\n  initial_front_dr, initial_front_dc = DIR_TO_DRDC[initial_dir]\n  initial_front_r, initial_front_c = initial_pos[0] + initial_front_dr, initial_pos[1] + initial_front_dc\n\n  # Check bounds for the cell in front\n  if (0 <= initial_front_r < WIDTH and 0 <= initial_front_c < HEIGHT):\n      # Check if the cell in front contains the primitive\n      if initial_grid[initial_front_r, initial_front_c, primitive_id] > 0:\n          return [USE_ACTION] # Primitive is directly reachable, just use it.\n\n  # --- BFS Initialization ---\n  # Queue stores tuples of ((current_pos, current_dir), list_of_actions_to_reach_here)\n  # 'collections' is used for deque, assuming it's imported at a higher level as per context.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores ((row, col), direction) to prevent revisiting states and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action list leading to the collectable position/orientation\n\n  # --- Start BFS ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within grid bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Determine if the new position is walkable\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive itself\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable and (next_pos, next_dir) not in visited:\n              # After moving to next_pos, check if the primitive is now directly in front.\n              front_dr, front_dc = DIR_TO_DRDC[next_dir]\n              front_r, front_c = next_r + front_dr, next_c + front_dc\n              \n              if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                  initial_grid[front_r, front_c, primitive_id] > 0):\n                  target_path_actions = path_so_far + [MOVE_FORWARD_ACTION]\n                  break # Path to a state where primitive is collectable found.\n              \n              # If not immediately collectible from this new state, add to queue for further exploration.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          # After turning, check if the primitive is now directly in front.\n          front_dr, front_dc = DIR_TO_DRDC[next_dir_left]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n              initial_grid[front_r, front_c, primitive_id] > 0):\n              target_path_actions = path_so_far + [TURN_LEFT_ACTION]\n              break # Path to a state where primitive is collectable found.\n\n          # If not immediately collectible, add to queue.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          # After turning, check if the primitive is now directly in front.\n          front_dr, front_dc = DIR_TO_DRDC[next_dir_right]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n              initial_grid[front_r, front_c, primitive_id] > 0):\n              target_path_actions = path_so_far + [TURN_RIGHT_ACTION]\n              break # Path to a state where primitive is collectable found.\n\n          # If not immediately collectible, add to queue.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a state where the agent is facing the primitive,\n  # append the USE action to complete the collection task.\n  if target_path_actions is not None:\n      # If a path was found, add the final USE action to it.\n      actions_list = list(target_path_actions) # Ensure it's a list for extend\n      actions_list.append(USE_ACTION)\n  else:\n      actions_list = [] # No path found, return empty list\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:34:32.913730", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its unique integer ID (kind index).\n  # Use .lower() for case-insensitive matching, assuming cookbook keys are lowercase.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it doesn't exist in the world\n    # in a collectible form.\n    return []\n\n  # 2. Check if the primitive is already present in the agent's inventory.\n  # If so, no collection actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if this primitive is collectible using the 'USE' action.\n  # 'Collecting' typically implies picking up grabbable items or interacting with\n  # specific environmental resources like water or stone.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected by using 'USE' (e.g., a workshop, a boundary),\n  # then this function cannot find a path to \"collect\" it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and constants based on environment specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of all movement actions for easy iteration.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_delta, col_delta) that defines the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # Facing UP: next cell is (row-1, col)\n      1: (0, 1),  # Facing RIGHT: next cell is (row, col+1)\n      2: (1, 0),  # Facing DOWN: next cell is (row+1, col)\n      3: (0, -1)  # Facing LEFT: next cell is (row, col-1)\n  }\n\n  # Helper function to calculate the minimal sequence of turning actions\n  # required to change from `current_dir` to `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # No turning needed if already facing the target direction.\n      \n      # Calculate the rotational difference, ensuring it's positive within [0, 3].\n      # This handles wrapping around, e.g., 0 to 3 is -1, which becomes 3.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One clockwise turn (e.g., UP->RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP->LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP->DOWN)\n          # This can be achieved by two turns in either direction (e.g., two RIGHTs).\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  # `q`: A deque to hold `(state_key, CraftState_object)` tuples for states to visit.\n  # We store the `CraftState_object` directly to use its `step` and `next_to` methods efficiently.\n  q = collections.deque()\n  \n  # `visited`: A set to store `(row, column, direction)` tuples. This prevents revisiting\n  # the same state (position and orientation) multiple times, which avoids cycles and\n  # ensures the shortest path is found.\n  visited = set()\n  \n  # `parent_info`: A dictionary to reconstruct the path once the goal is found.\n  # Maps `child_state_key` -> `(parent_state_key, action_taken_from_parent_to_child)`.\n  parent_info = {} \n\n  # For convenience when accessing tuple elements in `state_key`:\n  # state_key = (row_index, column_index, direction_index)\n  _ROW_IDX, _COL_IDX, _DIR_IDX = 0, 1, 2\n\n  # Get initial state key from the current agent's position and direction.\n  initial_state_key = (current_state.pos[_ROW_IDX], current_state.pos[_COL_IDX], current_state.dir)\n  \n  # Add the initial state to the queue and mark it as visited.\n  q.append((initial_state_key, current_state))\n  visited.add(initial_state_key)\n  # The initial state has no parent, so set its parent to (None, None).\n  parent_info[initial_state_key] = (None, None) \n\n  # Determine grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Set a safety limit for the number of states to explore. This prevents BFS from running\n  # indefinitely in very large or complex environments, or if a goal is truly unreachable.\n  # The total number of unique (position, direction) states is `width * height * 4`.\n  # A multiplier (e.g., 2) is added for robustness, allowing for some redundant work or\n  # exploration in complex scenarios before giving up.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 2 \n  explored_states_count = 0\n\n  # 6. Main BFS Loop.\n  while q:\n    # Dequeue the current state's key and its corresponding CraftState object.\n    state_key, state = q.popleft() \n    explored_states_count += 1\n\n    # Pruning step: If we've explored too many states, stop this branch of the search.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      # This state won't lead to a short path, and we're nearing the limit. Skip further exploration.\n      continue \n\n    # Unpack current position and direction for easier access.\n    current_r, current_c, current_dir = state_key \n\n    # Goal Check: Can the primitive be collected from the current state?\n    # First, check if the primitive `i_kind` is anywhere in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it's nearby, we need to check if the agent can face it directly.\n        # Iterate through all four possible directions the agent could face.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            # Calculate the coordinates of the cell that would be directly in front\n            # of the agent if it were facing `target_dir` from its `current_pos`.\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated 'facing' cell is within the grid boundaries\n            # AND if that specific cell actually contains an instance of the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Success! The primitive is located and can be directly faced.\n                # 1. Calculate the necessary turning actions from the `current_dir` to `target_dir`.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # 2. Reconstruct the sequence of movement actions from the initial state\n                #    up to the `state_key` (current position and direction).\n                path_to_current_pos = []\n                curr_reconstruct_key = state_key\n                # Traverse the `parent_info` dictionary backward until the initial state (parent is None).\n                while parent_info[curr_reconstruct_key][_ROW_IDX] is not None:\n                    parent_key, action_taken = parent_info[curr_reconstruct_key]\n                    path_to_current_pos.append(action_taken)\n                    curr_reconstruct_key = parent_key\n                path_to_current_pos.reverse() # Reverse the list to get actions in chronological order.\n\n                # 3. Combine all actions to form the complete collection path:\n                #    (movement path) + (turning actions) + (USE action).\n                return path_to_current_pos + turns_to_face + [USE_ACT]\n\n    # If the primitive cannot be collected from the current state (either not nearby,\n    # or nearby but not in a directly faceable and occupied cell),\n    # then explore possible next states by taking movement actions.\n    for action in move_actions:\n      # Simulate taking the action. `state.step(action)` returns a new `CraftState` object\n      # representing the state after the action, and a reward (which is 0 here).\n      _, next_state = state.step(action) \n\n      # Form the unique key for the `next_state` using its position and direction.\n      next_state_key = (next_state.pos[_ROW_IDX], next_state.pos[_COL_IDX], next_state.dir)\n\n      # If this `next_state` (position and direction) has not been visited before:\n      if next_state_key not in visited:\n        visited.add(next_state_key) # Mark it as visited.\n        # Store how this `next_state` was reached: from `state_key` by `action`.\n        parent_info[next_state_key] = (state_key, action) \n        # Add the `next_state` to the queue for future exploration.\n        q.append((next_state_key, next_state)) \n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the primitive, it means the primitive is either unreachable or uncollectible\n  # from the initial state under the current rules.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:34:34.163051", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: (CraftState object, list of actions to reach this state).\n  # Storing the CraftState object directly allows us to simulate `state.step()` efficiently.\n  q = collections.deque()\n  # The 'visited' set keeps track of (row, col, direction) tuples to prevent cycles\n  # and re-exploring states already visited via a shorter or equal path.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a maximum number of states to explore to prevent excessively long searches\n  # or infinite loops in very complex or unreachable scenarios.\n  # The total number of unique (position, direction) states is `grid_width * grid_height * 4`.\n  # A multiplier is added for robustness, allowing for some redundant state visits if pathfinding is complex.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 3 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the desired primitive is located in the 3x3 neighborhood of the agent.\n    # The `next_to` method provides an efficient pre-check.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all 4 possible directions the agent could face.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            # Calculate the coordinates of the cell that would be directly in front of the agent\n            # if it were facing `target_dir` from its current `state.pos`.\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the calculated facing cell is within grid bounds\n            # AND if that specific cell contains an instance of the desired primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # We've found the primitive on the grid and can face it.\n                # Now, crucial step: Simulate the turns and the 'USE' action\n                # to verify if collection is actually successful (e.g., if a tool is needed).\n                \n                # 1. Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Create a temporary state by applying the turns.\n                temp_state_after_turns = state # Start simulation from the current BFS state.\n                for turn_action in turns_to_face:\n                    # state.step() returns a *new* CraftState object, ensuring proper simulation.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # 2. Simulate the 'USE' action from the state where the agent is facing the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # 3. Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies that the primitive was successfully collected (e.g., if tools were present and used).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Success! The primitive was collected.\n                    # The complete sequence of actions is:\n                    # (actions to reach current state) + (turning actions) + (USE action to collect).\n                    return path + turns_to_face + [USE_ACT]\n\n    # If the primitive cannot be collected from the current position (either not nearby,\n    # or nearby but not successfully collected), explore possible movement actions.\n    for action in move_actions:\n      # Simulate the action to get the next state without modifying the current environment.\n      # `state.step(action)` correctly updates position, direction, inventory, and handles collisions.\n      _, next_state = state.step(action)\n\n      # Create a unique key for the `next_state` to check against the `visited` set.\n      # A state is considered unique if its position and direction are different.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      # If this next state has not been visited before, add it to the queue for exploration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-01T05:35:52.820863", "function_name": "collect", "function_body": "  actions = []\n\n  try:\n    prim_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos # (r, c)\n  start_dir = current_state.dir\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Action mappings\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Movement deltas and resulting directions for (dr, dc)\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  move_info = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP, new dir = North\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN, new dir = South\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT, new dir = West\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT, new dir = East\n  }\n\n  # Deltas for the cell \"in front\" of the agent based on direction\n  dir_to_fwd_delta = {\n      0: (1, 0),  # South -> (1,0)\n      1: (-1, 0), # North -> (-1,0)\n      2: (0, -1), # West -> (0,-1)\n      3: (0, 1)   # East -> (0,1)\n  }\n\n  # Categorize the target primitive\n  is_target_workshop = prim_id in env.world.workshop_indices\n  is_target_grabbable = prim_id in env.world.grabbable_indices\n\n  def is_valid_move_to_cell(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and can be walked onto.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Iterate through all kinds present at (r,c) to check for obstacles\n      for k_idx in range(N_KINDS):\n          if grid[r, c, k_idx] == 1: # If something is at this cell\n              if k_idx in env.world.non_grabbable_indices:\n                  # This is a non-grabbable item (e.g., WATER, STONE, BOUNDARY).\n                  # Agent can move onto it ONLY if it's the specific workshop target.\n                  if is_target_workshop and k_idx == prim_id:\n                      continue # Allowed to move onto this specific workshop\n                  else:\n                      return False # Cannot move onto other non-grabbables\n              elif k_idx == prim_id and is_target_grabbable:\n                  # If the cell contains the *specific* grabbable target primitive,\n                  # we cannot move onto it. We need to be adjacent to collect it.\n                  return False \n      return True\n\n  # BFS Queue: Stores tuples of (((pos_r, pos_c), agent_dir), path_so_far)\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores ((pos_r, pos_c), agent_dir) to avoid redundant exploration.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None\n  \n  while queue:\n      ((r, c), current_dir_val), path_so_far = queue.popleft()\n\n      # Check if the current state (position and direction) allows collecting the primitive\n      # The 'USE' action interacts with the cell directly in front of the agent.\n      fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n      target_cell_r, target_cell_c = r + fwd_dr, c + fwd_dc\n\n      if (0 <= target_cell_r < WIDTH and 0 <= target_cell_c < HEIGHT and\n          grid[target_cell_r, target_cell_c, prim_id] == 1):\n          # Agent is adjacent to and facing the target primitive.\n          # This position and direction allows the 'USE' action to collect it.\n          path_to_target = path_so_far\n          break # Found the shortest path to be able to USE the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, ((dr, dc), new_dir_val) in move_info.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos_tuple = (next_r, next_c)\n          next_state_tuple = (next_pos_tuple, new_dir_val)\n\n          # Only proceed if the next position is valid to move onto\n          # and this (position, direction) state has not been visited before.\n          if is_valid_move_to_cell(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if path_to_target is not None:\n      # If a path was found, append the USE action at the end to perform the collection.\n      actions = path_to_target + [ACTION_USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:35:54.130256", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  try:\n    prim_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos # (r, c)\n  start_dir = current_state.dir # Initial direction of the agent (0:S, 1:N, 2:W, 3:E)\n  grid = current_state.grid\n  W, H, _ = grid.shape\n\n  # Determine the type of primitive for collection logic\n  is_workshop = prim_id in env.world.workshop_indices\n  # A \"collectable\" resource needs an adjacent 'USE' action and must be faced.\n  # This includes grabbable items (e.g., WOOD, IRON) and non-grabbable resources (e.g., STONE, WATER).\n  # Workshops are treated differently (move onto them, no 'USE' appended by collect).\n  is_collectable_resource = (prim_id in env.world.grabbable_indices or\n                             (prim_id in env.world.non_grabbable_indices and not is_workshop))\n\n  # Map DMLab action values to (dr, dc) movement deltas AND CraftState.dir values.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # The agent's direction updates to match the last movement action.\n  ACTION_TO_MOVE_AND_DIR = {\n      UP: ((-1, 0), 1),    # Move UP, new direction is North (1)\n      DOWN: ((1, 0), 0),   # Move DOWN, new direction is South (0)\n      LEFT: ((0, -1), 2),  # Move LEFT, new direction is West (2)\n      RIGHT: ((0, 1), 3)   # Move RIGHT, new direction is East (3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply for collectable resources.\n  DIR_TO_FWD_DELTA = {\n      0: (1, 0),  # Facing South, cell in front is (row+1, col)\n      1: (-1, 0), # Facing North, cell in front is (row-1, col)\n      2: (0, -1), # Facing West, cell in front is (row, col-1)\n      3: (0, 1)   # Facing East, cell in front is (row, col+1)\n  }\n\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_traversable(r, c):\n      \"\"\"\n      Checks if the cell (r, c) can be moved into.\n      A cell is traversable if it's within grid bounds and doesn't contain a non-grabbable item\n      that is NOT the target workshop (if the target is a workshop).\n      \"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False # Out of bounds\n\n      for obs_idx in obstacle_indices:\n          if grid[r, c, obs_idx] == 1: # If this non-grabbable item is present at (r,c)\n              if is_workshop and obs_idx == prim_id:\n                  # This is the target workshop, and we are allowed to move onto it.\n                  continue\n              else:\n                  # This is a general non-grabbable obstacle or a workshop that is NOT our target.\n                  # Cannot traverse this cell.\n                  return False\n      return True # No blocking non-grabbable items found\n\n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      ((curr_r, curr_c), current_dir_val), path_so_far = queue.popleft()\n\n      # 2. Check if the current state (position and direction) satisfies the collection goal.\n      if is_workshop:\n          # For a workshop, the agent needs to be ON the workshop cell.\n          if grid[curr_r, curr_c, prim_id] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to the workshop location.\n      elif is_collectable_resource:\n          # For collectable resources (grabbable or non-grabbable like STONE/WATER),\n          # the agent must be adjacent to the primitive AND facing it to use the 'USE' action.\n          fwd_dr, fwd_dc = DIR_TO_FWD_DELTA[current_dir_val]\n          target_r, target_c = curr_r + fwd_dr, curr_c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if (0 <= target_r < W and 0 <= target_c < H and \n              grid[target_r, target_c, prim_id] == 1):\n              path_to_target = path_so_far + [USE]\n              break # Found the shortest path ending in the correct position and direction to use the primitive.\n\n      # 3. Explore neighbors by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in ACTION_TO_MOVE_AND_DIR.items():\n          dr, dc = move_delta\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos_and_dir = ((next_r, next_c), new_dir_val)\n\n          # Only proceed if the next position is valid (within bounds and traversable)\n          # and this (position, direction) state has not been visited before.\n          if is_traversable(next_r, next_c) and next_pos_and_dir not in visited:\n              visited.add(next_pos_and_dir)\n              queue.append((next_pos_and_dir, path_so_far + [action_val]))\n  \n  return path_to_target if path_to_target is not None else []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:37:25.915531", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n\n  # Check if the primitive is already in inventory.\n  # If the agent already has the primitive, no collection actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Ensure the requested primitive is actually grabbable.\n  # Non-grabbable entities (like \"water\", \"boundary\", or a \"workshop\") cannot be \"collected\" into inventory.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  grid = current_state.grid\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction (0:N, 1:E, 2:S, 3:W)\n\n  # Use the comprehensive set of non-grabbable indices from the world object\n  # to determine impassable terrain (obstacles).\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Optimization for v2: Pre-check if the primitive exists anywhere on the grid.\n  # If the primitive is not present on the map, there's no need to run the BFS.\n  # This can save computation for unreachable or non-existent items.\n  primitive_exists_on_grid = False\n  for x_grid in range(grid_width):\n      for y_grid in range(grid_height):\n          if grid[x_grid, y_grid, primitive_idx] > 0:\n              primitive_exists_on_grid = True\n              break\n      if primitive_exists_on_grid:\n          break\n  if not primitive_exists_on_grid:\n      return [] # Primitive is not on the map, so it cannot be collected.\n\n  # Define movement actions and their effects on (dx, dy) and new_direction\n  # The agent's direction is updated to face the direction of movement.\n  action_effects = {\n      craft.UP: (0, -1, 0),    # Move North (y-1), new_dir = 0 (North)\n      craft.DOWN: (0, 1, 2),     # Move South (y+1), new_dir = 2 (South)\n      craft.LEFT: (-1, 0, 3),    # Move West (x-1), new_dir = 3 (West)\n      craft.RIGHT: (1, 0, 1)     # Move East (x+1), new_dir = 1 (East)\n  }\n\n  # Mapping agent direction (0-3) to (dx, dy) for the cell *in front* of the agent\n  # This is crucial for determining where a 'USE' action will interact.\n  FWD_DX = [0, 1, 0, -1] # Delta X for facing North, East, South, West respectively\n  FWD_DY = [-1, 0, 1, 0] # Delta Y for facing North, East, South, West respectively\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y, current_dir), path_taken_so_far)\n  queue = collections.deque([((start_x, start_y, start_dir), [])])\n  # Set of visited states to prevent cycles and redundant exploration.\n  # A state now includes position AND direction, as direction affects possible actions (USE).\n  visited = {(start_x, start_y, start_dir)}\n\n  while queue:\n    (x, y, d), path = queue.popleft()\n\n    # Check if a 'USE' action is possible from the current (x, y, d) state.\n    # The 'USE' action targets the cell directly in front of the agent.\n    target_x = x + FWD_DX[d]\n    target_y = y + FWD_DY[d]\n\n    # Check if the cell in front is within grid bounds and contains the primitive.\n    # This is the \"goal\" condition for collecting.\n    if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n        grid[target_x, target_y, primitive_idx] > 0):\n      # Found the primitive directly in front, so return the path to get here\n      # plus the 'USE' action to collect it.\n      return path + [craft.USE]\n\n    # Explore valid neighbor states by performing movement actions.\n    for action, (dx_move, dy_move, new_d) in action_effects.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_state_tuple = (next_x, next_y, new_d) # New state includes new position and new direction\n\n      # 1. Bounds check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting already explored (position, direction) states\n      # to find the shortest path and prevent infinite loops.\n      if next_state_tuple in visited:\n        continue\n\n      # 3. Traversability check: Ensure the cell is not an obstacle.\n      #    A cell is an obstacle if it contains any non-grabbable item.\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_obstacle_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      # If all checks pass, add the new state to the queue and mark it as visited.\n      visited.add(next_state_tuple)\n      queue.append((next_state_tuple, path + [action]))\n\n  # If the BFS queue becomes empty and no path to the primitive (for a 'USE' action) was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:37:27.318343", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` to robustly find and collect a primitive.\n  This version pre-calculates all possible target positions and orientations\n  from which a primitive can be 'USE'd, and then runs a BFS to find the\n  shortest path to any of these target states.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n\n  # 1. Early exit if primitive is already in inventory.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 2. Early exit if the primitive is not grabbable (e.g., \"water\", \"workshop\").\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  grid = current_state.grid\n  start_x, start_y = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction (0:N, 1:E, 2:S, 3:W)\n\n  # Use the comprehensive set of non-grabbable indices from the world object\n  # to determine impassable terrain (obstacles).\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Define movement actions and their effects on (dx, dy) and new_direction.\n  # The agent's direction is updated to face the direction of movement.\n  action_effects = {\n      craft.UP: (0, -1, 0),    # Move North (y-1), new_dir = 0 (North)\n      craft.DOWN: (0, 1, 2),     # Move South (y+1), new_dir = 2 (South)\n      craft.LEFT: (-1, 0, 3),    # Move West (x-1), new_dir = 3 (West)\n      craft.RIGHT: (1, 0, 1)     # Move East (x+1), new_dir = 1 (East)\n  }\n\n  # Mapping agent direction (0-3) to (dx, dy) for the cell *in front* of the agent.\n  # This is crucial for determining where a 'USE' action will interact.\n  FWD_DX = [0, 1, 0, -1] # 0:N, 1:E, 2:S, 3:W\n  FWD_DY = [-1, 0, 1, 0]\n\n  # --- Improvement for v2: Pre-calculate all valid 'collectable' agent states ---\n  # First, find all grid locations where the primitive exists.\n  primitive_locations = []\n  for px in range(grid_width):\n    for py in range(grid_height):\n      if grid[px, py, primitive_idx] > 0:\n        primitive_locations.append((px, py))\n\n  # `goal_agent_states` will store (agent_x, agent_y, agent_direction) tuples.\n  # An agent at (ax, ay) facing `ad` can 'USE' a primitive at (px, py) if:\n  # px == ax + FWD_DX[ad] AND py == ay + FWD_DY[ad].\n  # We pre-calculate all such (ax, ay, ad) states that would allow collection.\n  goal_agent_states = set()\n\n  for px, py in primitive_locations:\n    # For each primitive location (px, py), determine the 4 adjacent agent positions\n    # and corresponding directions from which it can be collected.\n\n    # 1. Agent needs to be South of primitive, facing North (dir=0)\n    ax_s, ay_s, ad_s = px, py + 1, 0\n    if 0 <= ax_s < grid_width and 0 <= ay_s < grid_height:\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_obstacle_indices:\n        if grid[ax_s, ay_s, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if not is_obstacle:\n        goal_agent_states.add((ax_s, ay_s, ad_s))\n\n    # 2. Agent needs to be West of primitive, facing East (dir=1)\n    ax_w, ay_w, ad_w = px - 1, py, 1\n    if 0 <= ax_w < grid_width and 0 <= ay_w < grid_height:\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_obstacle_indices:\n        if grid[ax_w, ay_w, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if not is_obstacle:\n        goal_agent_states.add((ax_w, ay_w, ad_w))\n\n    # 3. Agent needs to be North of primitive, facing South (dir=2)\n    ax_n, ay_n, ad_n = px, py - 1, 2\n    if 0 <= ax_n < grid_width and 0 <= ay_n < grid_height:\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_obstacle_indices:\n        if grid[ax_n, ay_n, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if not is_obstacle:\n        goal_agent_states.add((ax_n, ay_n, ad_n))\n\n    # 4. Agent needs to be East of primitive, facing West (dir=3)\n    ax_e, ay_e, ad_e = px + 1, py, 3\n    if 0 <= ax_e < grid_width and 0 <= ay_e < grid_height:\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_obstacle_indices:\n        if grid[ax_e, ay_e, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if not is_obstacle:\n        goal_agent_states.add((ax_e, ay_e, ad_e))\n\n  # If no possible valid 'collectable' states (e.g., primitive is surrounded by obstacles),\n  # then the primitive is unreachable.\n  if not goal_agent_states:\n      return []\n\n  # BFS setup:\n  # Queue stores tuples of ((current_x, current_y, current_dir), path_taken_so_far).\n  queue = collections.deque([((start_x, start_y, start_dir), [])])\n  # Visited set stores (x, y, dir) tuples to prevent cycles and redundant exploration,\n  # ensuring the shortest path is found.\n  visited = {(start_x, start_y, start_dir)}\n\n  while queue:\n    (x, y, d), path = queue.popleft()\n\n    # Check if the current state (agent's position and direction) is one of the\n    # pre-calculated target 'collectable' states.\n    if (x, y, d) in goal_agent_states:\n      return path + [craft.USE] # Found a path to a collectable state, add USE action.\n\n    # Explore valid neighbor states by performing movement actions.\n    for action, (dx_move, dy_move, new_d) in action_effects.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_state_tuple = (next_x, next_y, new_d) # New state includes new position and new direction\n\n      # 1. Bounds check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting already explored (position, direction) states.\n      if next_state_tuple in visited:\n        continue\n\n      # 3. Traversability check: Ensure the cell is not an obstacle.\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_obstacle_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      # If all checks pass, add the new state to the queue and mark it as visited.\n      visited.add(next_state_tuple)\n      queue.append((next_state_tuple, path + [action]))\n\n  # If the BFS queue becomes empty and no path to any goal_agent_state was found,\n  # it means the primitive is unreachable from the current agent state.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T05:37:58.404597", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve integer action indices from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed to be the action for moving one step forward\n  TURN_LEFT_ACTION = action_map['LEFT']   # Action to turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT'] # Action to turn 90 degrees right\n  USE_ACTION = action_map['USE']          # Action to interact with the cell in front\n\n  # Directional changes for (delta_row, delta_col) when moving forward based on current_dir\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for agent's new direction after turning left\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # Mapping for agent's new direction after turning right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of items that block movement (e.g., boundaries, water, workshops)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- BFS Setup ---\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the primitive\n\n  # --- BFS Loop ---\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is in the cell directly in front of the agent.\n      # This is the \"goal\" state for collection (agent is ready to 'USE').\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Path to reach this state (facing the primitive)\n              break # Found the shortest path, terminate BFS\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable.\n          # A cell is walkable if it doesn't contain any non-walkable entity\n          # and the agent cannot walk onto the primitive itself (only adjacent to it).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # The agent cannot move onto the primitive itself\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target (facing the primitive) was found, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:37:59.663673", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # 'UP' is interpreted as moving forward relative to the agent's current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if next_pos is walkable\n          # A cell is walkable if it doesn't contain any non-walkable entity (e.g., boundary, water)\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive itself, only up to it to use it.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T05:38:48.745299", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get primitive index using __getitem__ to avoid modifying the index\n  # if the primitive name is not recognized. If it's not found, return an empty list.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    # The primitive name is not recognized in the cookbook's index.\n    return []\n\n  # Extract action mappings for clarity and direct use.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # If the agent is already next to the primitive, simply use it.\n  # This is the fastest path and avoids unnecessary BFS.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Find all physical locations of the primitive on the current grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's kind index has a count greater than zero at (x, y),\n      # it means an instance of the primitive exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # Determine \"goal cells\" for the pathfinding algorithm.\n  # A goal cell is any grid cell from which the agent can use the 'USE' action\n  # to collect the primitive. Based on `CraftState.next_to`, this means any\n  # cell within a 3x3 square centered around a primitive's location.\n  target_collection_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood relative to the primitive's location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate potential goal cell coordinates.\n        # Ensure the potential goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_collection_cells.add((gx, gy))\n\n  # Define which environmental kinds are considered \"impassable\" for agent movement.\n  # Non-grabbable items that are *not* workshops are generally impassable.\n  # Workshops (like BENCH) are non-grabbable but typically traversable.\n  impassable_environment_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # Execute a Breadth-First Search (BFS) to find the shortest path.\n  # The BFS aims to find a path from the agent's `start_pos` to any `target_collection_cells`.\n  start_pos = current_state.pos\n  \n  # The queue for BFS stores only positions to visit.\n  bfs_queue = collections.deque([start_pos])\n  \n  # The `visited` dictionary stores `{position: (parent_position, action_to_reach_current_pos)}`.\n  # This allows reconstructing the path efficiently by backtracking from the found goal.\n  visited_info = {start_pos: (None, None)} \n\n  # Define the possible cardinal movements and their corresponding action indices.\n  CARDINAL_MOVES_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  found_goal_pos = None\n\n  while bfs_queue:\n    current_x, current_y = bfs_queue.popleft() \n    current_pos = (current_x, current_y)\n\n    # If the current cell is one of our target collection cells, we've found the shortest path.\n    found_goal_pos = current_pos\n    if current_pos in target_collection_cells:\n      break # Exit BFS, as the shortest path to a goal cell is found.\n\n    # Explore all four cardinal neighbors from the current cell.\n    for (dx, dy), action_to_take in CARDINAL_MOVES_AND_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy # Calculate the coordinates of the next cell.\n      next_pos = (next_x, next_y)\n\n      # 1. Check: Ensure the next cell is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # 2. Check: Determine if the next cell is traversable.\n      # A cell is traversable if it does NOT contain any impassable environment kind.\n      is_next_cell_impassable = False\n      for kind_idx in impassable_environment_kinds:\n          # If the grid cell at (next_x, next_y) contains a count (>0) of an impassable kind,\n          # then this cell cannot be moved into.\n          if grid[next_x, next_y, kind_idx] > 0: \n              is_next_cell_impassable = True\n              break # Found an impassable kind, no need to check further.\n      \n      if is_next_cell_impassable:\n          continue # Skip this cell if it's impassable.\n\n      # 3. Check: Ensure the next cell has not been visited before in this BFS path.\n      if next_pos not in visited_info:\n        visited_info[next_pos] = (current_pos, action_to_take) # Store parent and action for path reconstruction.\n        bfs_queue.append(next_pos) # Enqueue the next position.\n\n  # If BFS completed and no path to a goal cell was found (i.e., found_goal_pos is still None\n  # or not in target_collection_cells, which means BFS didn't reach one),\n  # it means the primitive is currently unreachable from the agent's position.\n  if found_goal_pos is None or found_goal_pos not in target_collection_cells:\n    return []\n\n  # Reconstruct the path from `start_pos` to `found_goal_pos` using parent pointers.\n  path_actions = []\n  current_path_pos = found_goal_pos\n  # Backtrack from the goal position until the start position is reached.\n  while current_path_pos != start_pos:\n    parent_pos, action_from_parent = visited_info[current_path_pos]\n    path_actions.append(action_from_parent)\n    current_path_pos = parent_pos\n  \n  # The path was built in reverse order (from goal to start), so reverse it\n  # to get the correct sequence of actions from start to goal.\n  path_actions.reverse() \n\n  # Append the USE action at the very end to collect the primitive,\n  # now that the agent is in the correct position.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
