 current_dir = state.dir\n    \n    # Goal Check: First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:10:02.237240", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This might raise KeyError if primitive is not in the index, assuming valid input from DSL.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n          # by summing counts for all non-grabbable kinds at that cell.\n          # Only perform sum if there are non-walkable kinds defined to avoid error on empty list.\n          if non_walkable_kinds_indices_list and np.sum(initial_grid[next_r, next_c, non_walkable_kinds_indices_list]) > 0:\n              is_walkable = False\n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:10:03.467429", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This might raise KeyError if primitive is not in the index, assuming valid input from DSL.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a numpy array once for efficient indexing with np.any.\n  non_walkable_kinds_indices = np.array(list(current_state.world.non_grabbable_indices), dtype=int)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n          # Use np.any to check if *any* of the non-walkable kinds are present in the target cell.\n          if non_walkable_kinds_indices.size > 0 and np.any(initial_grid[next_r, next_c, non_walkable_kinds_indices] > 0):\n              is_walkable = False\n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:11:11.773280", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines the state exploration within the BFS, ensuring efficiency\n    by relying solely on the `visited` set to manage unique states for movement\n    and `USE` actions. It maintains the crucial inventory-aware BFS for complex\n    collection paths that might require intermediate tool acquisition.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states to prevent excessive computation in very large or complex scenarios.\n  # The factor of 10 accounts for the additional state dimensions (direction, inventory).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for CraftState.step here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is crucial for collecting intermediate items (like tools)\n    # that are not the target primitive but enable its collection.\n    # The `visited` set will inherently prevent adding redundant states\n    # where USE had no effect (as the state key wouldn't change).\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:11:13.247156", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:13:28.224160", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This heuristic limit helps prevent excessively long searches in complex scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # IMPROVEMENT for collect_v2: Make the \"Explore General USE\" action more targeted.\n    # Instead of exploring `USE` unconditionally if it changes state, only explore it if\n    # it potentially interacts with a non-target grabbable item (e.g., a tool) or a workshop.\n    \n    do_general_use_exploration = False\n    \n    # Check if agent is currently on a grabbable item that is NOT the target primitive.\n    # If so, picking it up might be an intermediate step (e.g., collecting a tool).\n    # Assuming grid is one-hot or `argmax` gives the primary item at a cell.\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0: # Check if there's any item at this position\n        item_at_pos_idx = item_at_pos_idx_flat[0] # Take the first if multiple\n        if item_at_pos_idx != i_kind and item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n    \n    # Check if agent is facing a workshop or another grabbable item (not the target primitive).\n    # Workshops are crucial for crafting and sometimes provide items or functionality.\n    # Other grabbables might be tools.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx != i_kind and \n                (item_in_front_idx in world.grabbable_indices or item_in_front_idx in world.workshop_indices)):\n                do_general_use_exploration = True\n\n    # If the general USE is deemed potentially useful, simulate and add to queue.\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:13:30.761630", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Improvement for collect_v2: Increased MAX_EXPLORED_STATES to allow for a more exhaustive search.\n  # The previous multiplier of '10' might be too restrictive for environments where longer paths\n  # or more complex intermediate inventory states are required to reach the primitive.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50 # Increased from 10 to 50\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:14:53.063896", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:14:54.259895", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n    This implementation refines the pathfinding and collection logic,\n    focusing on clarity, robustness, and minor performance gains for\n    determining impassable terrain. It uses Breadth-First Search (BFS)\n    to find the shortest sequence of actions to acquire a primitive.\n\n    Args:\n        env (env.CraftLab): The current CraftLab environment instance.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action codes (e.g., [UP, UP, USE]).\n                   Returns an empty list if the primitive is already in inventory,\n                   not present on the grid, or unreachable from the agent's current position.\n  \"\"\"\n  current_state = env._current_state\n  \n  # --- 1. Pre-computation and Initialization ---\n\n  # Map the primitive's string name to its internal integer ID.\n  # This relies on the Cookbook's index, which is robust.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve essential action indices for readability and consistency.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define cardinal movement directions and their corresponding actions.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # Determine which entity kinds are impassable for agent movement.\n  # These are typically non-grabbable items that are not workshops (which are traversable).\n  # Convert to a numpy array for efficient indexing in the BFS loop's impassability check.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  impassable_kinds_array = np.array(list(impassable_kinds)) if impassable_kinds else np.array([])\n\n  # Get current grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # --- 2. Initial Checks ---\n\n  # If the primitive is already in the agent's inventory, no actions are required.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # If the agent is already adjacent to the primitive, a single USE action is sufficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 3. Locate Primitives on Grid and Define Goal Cells ---\n\n  primitive_grid_locations = []\n  # Iterate over the grid to find all occurrences of the target primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_grid_locations:\n    return []\n\n  # Define \"goal cells\" for the BFS. These are all valid, traversable cells\n  # from which the agent can successfully `USE` to collect the primitive\n  # (i.e., any cell within the 3x3 neighborhood of a primitive's location).\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- 4. Breadth-First Search (BFS) ---\n  \n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and re-exploring paths.\n  visited = {start_pos} \n\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE] # Append USE as the final collection action.\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the new position contain an impassable kind?\n      # Efficiently check if any of the impassable_kinds are present at (nx, ny)\n      # using numpy's any() over the relevant slice of the grid.\n      if impassable_kinds_array.size > 0 and np.any(grid[nx, ny, impassable_kinds_array] > 0):\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        q.append((new_pos, path_to_current + [action])) # Enqueue new position and path.\n\n  # If the BFS completes and the queue is empty, no path to a goal cell was found.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:15:54.712183", "function_name": "collect", "function_body": "  current_state = env._current_state \n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the integer ID of the primitive from the cookbook index.\n  # Use .get() to safely handle cases where the primitive name might not exist.\n  primitive_id = env.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      return [] # Primitive name not found in the world's index\n\n  # Retrieve action mapping from the environment for robustness\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define movement deltas and their corresponding actions\n  DELTAS_AND_ACTIONS = [\n      ((-1, 0), UP),\n      ((1, 0), DOWN),\n      ((0, -1), LEFT),\n      ((0, 1), RIGHT)\n  ]\n\n  # If the primitive is not grabbable (e.g., a wall, water, workshop), it cannot be collected.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 1. Check if the agent is already next to the primitive.\n  # If so, a single 'USE' action is sufficient to collect it.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # 2. Find all locations of the target primitive on the grid.\n  # These are the potential targets for our \"adjacent to primitive\" check.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id occupies this cell\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the agent can \"USE\" the primitive.\n  #    A cell is \"usable\" if it is adjacent (Manhattan distance 1) to a primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # This will store the shortest path (list of actions) found to an adjacent cell\n  final_path_to_adjacent_pos = None \n\n  while q:\n      (curr_r, curr_c), path_so_far = q.popleft()\n      curr_pos = (curr_r, curr_c)\n\n      # Check if the current BFS node (curr_r, curr_c) is adjacent to any of the primitive locations.\n      # This is the goal condition for our pathfinding: reaching a cell from which we can USE.\n      is_adjacent_to_primitive_target = False\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 means the cells are directly adjacent (horizontally or vertically).\n          if abs(curr_r - pr) + abs(curr_c - pc) == 1: \n              final_path_to_adjacent_pos = path_so_far \n              is_adjacent_to_primitive_target = True\n              break # Exit inner loop, we found an adjacent primitive\n      \n      if is_adjacent_to_primitive_target:\n          break # Exit BFS, the shortest path to an 'usable' position is found\n\n      # Explore valid neighboring cells from the current position (curr_r, curr_c).\n      for (dr, dc), action_val in DELTAS_AND_ACTIONS:\n          next_r, next_c = curr_r + dr, curr_c + dc \n          next_pos = (next_r, next_c)\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position is traversable (not an obstacle).\n          # A cell is non-traversable if it contains any item whose kind index\n          # is in the world's non_grabbable_indices set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # Check 3: If this neighbor has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Extend the current path with the action taken to reach this new neighbor.\n              q.append((next_pos, path_so_far + [action_val]))\n    \n  # 4. Construct the final sequence of actions.\n  # If a path to an adjacent cell was found, extend the actions list with this path\n  # and then append a 'USE' action to actually collect the primitive.\n  if final_path_to_adjacent_pos is not None:\n      actions = final_path_to_adjacent_pos\n      actions.append(USE) # Once adjacent, perform the 'USE' action to collect the primitive.\n      return actions\n  else:\n      # No path found to any cell adjacent to the primitive\n      return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:15:55.875687", "function_name": "collect", "function_body": "  current_state = env._current_state \n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the integer ID for the target primitive from the environment's cookbook.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Retrieve action mappings for clearer and more robust code.\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define movement deltas associated with their corresponding actions.\n  DELTAS_AND_ACTIONS = [\n      ((-1, 0), UP),  # Move Up: Decrement row\n      ((1, 0), DOWN), # Move Down: Increment row\n      ((0, -1), LEFT), # Move Left: Decrement column\n      ((0, 1), RIGHT)  # Move Right: Increment column\n  ]\n\n  # --- Pre-checks for early exit ---\n  # 1. If the primitive is not in the set of grabbable items, it cannot be collected.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. If the agent is already adjacent to the primitive, a single 'USE' action is sufficient.\n  # The `next_to` method checks if any cell in the 3x3 neighborhood contains the primitive.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  # The goal of BFS here is to find the shortest sequence of movement actions\n  # that leads the agent to a position from which it can 'USE' (collect) the primitive.\n\n  # q: A deque used as a queue for BFS, storing (row, col) positions to explore.\n  q = collections.deque([start_pos]) \n  # visited: A set of (row, col) tuples to keep track of visited positions,\n  # preventing cycles and redundant exploration.\n  visited = {start_pos} \n  # came_from: A dictionary used to reconstruct the path once the target is found.\n  # It maps `current_pos` to a tuple: `(parent_pos, action_taken_to_reach_current_pos)`.\n  came_from = {start_pos: (None, None)} # Start position has no parent or action.\n\n  target_adjacent_pos = None # This will store the position from which 'USE' can be applied.\n  \n  while q:\n      curr_r, curr_c = q.popleft()\n      curr_pos = (curr_r, curr_c)\n\n      # Check if the current BFS node's position (`curr_pos`) is adjacent to the primitive.\n      # We create a temporary `CraftState` instance to leverage its `next_to()` method.\n      # This avoids re-implementing the adjacency check logic within the BFS itself.\n      temp_state_for_check = craft.CraftState(\n          scenario=current_state.scenario,\n          grid=grid,\n          pos=curr_pos,\n          dir=current_state.dir, # Direction and inventory are needed by constructor but don't affect `next_to`.\n          inventory=current_state.inventory \n      )\n      if temp_state_for_check.next_to(primitive_id):\n          target_adjacent_pos = curr_pos\n          break # Shortest path to an adjacent position found, exit BFS.\n\n      # Explore valid neighboring cells from the current position.\n      for (dr, dc), action_val in DELTAS_AND_ACTIONS:\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos = (next_r, next_c)\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n\n          # Check 2: Ensure the new position is traversable (not an obstacle).\n          # A cell is considered non-traversable if it contains any item whose kind index\n          # is present in the `world.non_grabbable_indices` set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, i_kind] == 1: # If this cell is occupied by an obstacle.\n                  is_traversable = False\n                  break # This neighbor is blocked.\n          if not is_traversable:\n              continue\n\n          # Check 3: If this neighbor has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append(next_pos)\n              # Record how we reached this `next_pos` from `curr_pos`.\n              came_from[next_pos] = (curr_pos, action_val)\n\n  # --- Path Reconstruction ---\n  final_actions = []\n  if target_adjacent_pos is not None:\n      # Helper function to reconstruct the path by backtracking using the `came_from` map.\n      # It starts from the `target_node` and goes back to the `start_node`, collecting actions.\n      # The actions are then reversed to get the correct chronological order.\n      def _reconstruct_path(came_from_map, current_node, start_node, final_action_to_append):\n          path = []\n          while current_node != start_node:\n              parent, action = came_from_map[current_node]\n              path.append(action)\n              current_node = parent\n          # The path is built in reverse order (from target back to start), so reverse it.\n          path.reverse()\n          # After reaching the adjacent position, the final action (e.g., 'USE') is appended.\n          path.append(final_action_to_append) \n          return path\n      \n      # Reconstruct the movement path and append the 'USE' action.\n      final_actions = _reconstruct_path(came_from, target_adjacent_pos, start_pos, USE)\n  \n  return final_actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:16:50.524062", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Store initial grid state, agent's position, and direction.\n  # These are immutable for the purpose of pathfinding in the static environment.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the specific primitive to be collected (e.g., 'WOOD', 'STONE').\n  # This ID is crucial for identifying the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Extract grid dimensions for boundary checks during pathfinding.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  # These map string action names (like 'UP', 'USE') to integer IDs recognized by `env.step()`.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Action to interact with the object in front.\n\n  # Define how agent's (row, col) changes based on its direction when moving forward.\n  # This dictionary maps a direction ID to a (delta_row, delta_col) tuple.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These maps ensure cyclic transitions (e.g., turning left from RIGHT leads to UP).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get the set of integer indices for entities that the agent cannot walk onto.\n  # This typically includes boundaries, water, and specific workshop types.\n  impassable_entity_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given cell (r, c) is a valid and walkable location for the agent.\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # First, check if the cell is within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Second, check if the cell contains any impassable entities.\n      # The agent cannot move into cells occupied by these types of objects.\n      for entity_id in impassable_entity_ids:\n          if initial_grid[r, c, entity_id] > 0:\n              return False\n      \n      # Third, the agent cannot walk onto the primitive it intends to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      # If all checks pass, the cell is safe and walkable.\n      return True\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores ( (agent_position, agent_direction), list_of_actions_taken_to_reach_this_state ).\n  # Each element defines a unique state of the agent (where it is and where it's facing) and the path to get there.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states already explored.\n  # This prevents redundant computations and infinite loops in cyclic paths, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the sequence of actions that leads the agent to be adjacent to and facing the primitive.\n  path_to_primitive_front = None \n\n  # Start the BFS traversal\n  while queue:\n      (current_pos, current_dir), actions_so_far = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the goal condition for our pathfinding: being in a position to 'USE' the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell immediately in front, we've found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_front = actions_so_far\n              break # Shortest path found; exit BFS.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the agent's new position if it moves one step forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the calculated next position is walkable and if this new (position, direction) state\n      # has not been visited yet.\n      if is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), actions_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the agent's new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new (position, direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), actions_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the agent's new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new (position, direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), actions_so_far + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path to the target state (adjacent and facing the primitive) was found,\n  # append the final 'USE' action to that path to simulate collecting the primitive.\n  # If no path was found (path_to_primitive_front remains None), an empty list is returned,\n  # indicating the primitive is currently unreachable from the agent's initial state.\n  if path_to_primitive_front is not None:\n      actions_list.extend(path_to_primitive_front)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:16:51.774083", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Pre-convert non-grabbable indices to a numpy array for efficient vectorized checking.\n  # This set includes entities like BOUNDARY, WATER, certain WORKSHOP types that the agent cannot walk onto.\n  non_walkable_kinds_indices_np = np.array(list(current_state.world.non_grabbable_indices))\n\n  # Helper function to check if a cell at (r, c) is valid for the agent to move into.\n  # This version leverages numpy for faster checks against non-walkable entities.\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      # Check if the coordinates are within the grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # The agent cannot move onto the primitive itself to collect it;\n      # it must be adjacent and then use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      # Check if the cell contains any non-walkable entity using numpy's any() for efficiency.\n      # This is faster than iterating a Python set if non_walkable_kinds_indices_np is large.\n      if len(non_walkable_kinds_indices_np) > 0 and \\\n         np.any(initial_grid[r, c, non_walkable_kinds_indices_np] > 0):\n          return False\n      \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # Each element represents a unique state (agent's position and orientation) and the path taken to reach it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration and cycles,\n  # ensuring that the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is valid and walkable, and if this new (position, direction) state\n      # has not been visited yet.\n      if _is_valid_and_walkable(next_r, next_c) and \\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Only add to queue if this (position, direction) state hasn't been visited.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Only add to queue if this (position, direction) state hasn't been visited.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:18:12.372448", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest path to a specified primitive, moves the agent adjacent to it,\n  faces it, and then returns the actions to use/collect it.\n\n  This function implements a Breadth-First Search (BFS) to find the optimal sequence of\n  movement and turn actions to position the agent for collection.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object, providing the current state\n                          and action mappings.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., [UP, UP, LEFT, USE]) to\n                 execute in the environment. Returns an empty list if the primitive is\n                 unreachable or already collected.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Retrieve the integer ID for the primitive. If not found, it's an invalid primitive.\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # The primitive name provided does not exist in the game's index.\n      return []\n\n  # Get grid dimensions (rows, columns) from the initial grid's shape.\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # Map DSL movement/turn actions (e.g., \"UP\", \"LEFT\") to their integer indices\n  # as defined by the CraftLab environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # Assuming 'UP' corresponds to moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each facing direction when moving \"forward\".\n  # This dictionary maps an agent's direction (0-3) to a (delta_row, delta_col) tuple.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (moves right)\n      1: (-1, 0),  # Facing UP: -1 to row (moves up)\n      2: (0, -1),  # Facing LEFT: -1 to column (moves left)\n      3: (1, 0)    # Facing DOWN: +1 to row (moves down)\n  }\n\n  # Define how the agent's direction changes when performing a turn action.\n  # E.g., if facing RIGHT (0) and turning LEFT, new direction is UP (1).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Sequence: Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Sequence: Right -> Down -> Left -> Up -> Right\n\n  # Get the set of integer IDs for entities that are non-grabbable and therefore\n  # block agent movement (e.g., \"BOUNDARY\", \"WATER\", \"WORKSHOP0\").\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS Setup:\n  # The queue stores states to explore. Each state is represented as:\n  # ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set tracks (position, direction) pairs to avoid re-exploring states\n  # (which could lead to infinite loops in cyclic environments) and finding non-optimal paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest sequence of actions to reach the \"ready to use\" state.\n\n  # Perform Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Extract current row and column\n\n      # 1. Check for Goal Condition: Is the primitive directly in front of the agent?\n      # If so, the agent is positioned correctly to \"use\" or \"collect\" the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc # Calculate coordinates of the cell directly in front\n\n      # Ensure the calculated front cell is within the grid boundaries.\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # Check if the primitive entity is present in the cell directly in front.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far # Store the path leading up to this goal state.\n              break # Goal reached, shortest path found, exit the BFS loop.\n\n      # 2. Explore Next Possible Actions: Move Forward, Turn Left, Turn Right.\n\n      # A. Try Moving Forward:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for movement in the agent's current direction\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Agent's direction does not change when moving forward.\n\n      # Check if the next position is within grid bounds AND this specific (position, direction)\n      # state has not been visited before.\n      if (0 <= next_r < grid_rows and 0 <= next_c < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' cell is walkable.\n          # A cell is considered not walkable if it contains any of the 'non_walkable_kind_ids'\n          # (like boundaries, water, workshops that cannot be passed through).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Also, explicitly prevent walking *onto* the primitive itself.\n          # Collection typically happens from an adjacent cell using the 'USE' action.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark this new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # B. Try Turning Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but the agent's position remains the same.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # C. Try Turning Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but the agent's position remains the same.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path to the target interaction state was found, append the final 'USE' action\n  # to the sequence of movement/turn actions.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:18:13.727488", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest sequence of actions\n    to navigate to a primitive and then \"use\" it.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current environment state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position: tuple (row, col)\n  initial_dir = current_state.dir # Agent's initial direction: int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # Get grid dimensions: initial_grid.shape provides (rows, columns, number_of_kinds)\n  num_rows, num_cols, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs.\n  # In CraftLab, 'UP' typically means moving forward in the agent's current facing direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for change in (row, column) based on agent's facing direction.\n  # This defines how the agent's position changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Map for updating the agent's direction when executing a turn action.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Rotates direction counter-clockwise (RIGHT -> UP -> LEFT -> DOWN -> RIGHT)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Rotates direction clockwise (RIGHT -> DOWN -> LEFT -> UP -> RIGHT)\n\n  # Get indices of entities that are non-grabbable and inherently block agent movement.\n  # The agent cannot walk onto cells containing these kinds (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state representation: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # The queue will store states to explore in a breadth-first manner.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set tracks (position, direction) pairs to avoid redundant computations and cycles during BFS.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest sequence of actions to reach the \"ready to use\" state.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent in the current state.\n      # This is the goal condition for the BFS: the agent is adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within the grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the cell in front contains the primitive, we have found the shortest path\n          # to a state where the agent can effectively 'USE' the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to the target interaction state found, terminate BFS.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      # Calculate the next position if the agent moves forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid bounds AND this specific (position, direction) state hasn't been visited.\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' cell is walkable.\n          # A cell is not walkable if it contains any of the 'non_walkable_kinds_indices' (e.g., boundaries, water).\n          # Also, the agent cannot walk *onto* the primitive itself; it must stand *adjacent* to it to use it.\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Explicitly prevent walking onto the primitive itself to ensure adjacency.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change the agent's position, only its direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was successfully found to the \"ready to use\" state, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:19:10.743079", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Get the current CraftState object\n  \n  # Extract relevant information from the current state and world\n  initial_grid = current_state.grid # The static grid layout for pathfinding\n  initial_pos = current_state.pos   # Agent's starting position (row, col)\n  initial_dir = current_state.dir   # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid dimensions (e.g., 20x20)\n\n  # Map action names to their integer indices using env.action_specs()\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Typically moves the agent one step in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Rotates the agent 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Rotates the agent 90 degrees right\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front of the agent\n\n  # Direction definitions: (dr, dc) tuple for changes in row and column for each direction\n  # This helps determine the cell in front of the agent, or where it moves to.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (col increases)\n      1: (-1, 0),  # Facing UP (row decreases)\n      2: (0, -1),  # Facing LEFT (col decreases)\n      3: (1, 0)    # Facing DOWN (row increases)\n  }\n\n  # Direction update maps for turns (clockwise for RIGHT, counter-clockwise for LEFT)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Right (0) -> Up (1) -> Left (2) -> Down (3) -> Right (0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right (0) -> Down (3) -> Left (2) -> Up (1) -> Right (0)\n\n  # Get indices of entities that are considered non-walkable terrain (e.g., boundaries, water, workshops)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS initialization\n  # Queue stores tuples: ((current_row, current_col), current_direction), list_of_actions_taken_to_reach_here\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores tuples: ((row, col), direction) to prevent revisiting states and infinite loops.\n  # This ensures we find the shortest path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions to reach the goal state\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state is a \"goal state\" for collecting the primitive.\n      # A goal state means the agent is adjacent to the primitive and facing it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds\n      if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Found the shortest path to a position where USE can be applied!\n\n      # 2. Explore possible next actions from the current state (move or turn)\n\n      # --- Try Move Forward ---\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within grid boundaries\n      if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n          (next_pos_move, next_dir_move) not in visited): # And this state hasn't been visited\n          \n          # Determine if the potential next cell is walkable.\n          # A cell is walkable if it's not a non-grabbable entity (like boundaries or water)\n          # AND it's not the target primitive itself (the agent must stand *next* to the primitive, not *on* it).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive itself\n          if is_walkable and initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to complete collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:19:11.960878", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract relevant information from the current state\n  grid = current_state.grid\n  agent_pos = current_state.pos # (row, col) tuple representing agent's current position\n  agent_dir = current_state.dir # Integer (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) representing agent's facing direction\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_kind_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions. The grid shape is (WIDTH, HEIGHT, num_kinds).\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map human-readable action names to their integer IDs from the environment's action_specs.\n  # These are the actions the agent can perform.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']    # Move one step forward in the current facing direction\n  ACTION_TURN_LEFT = action_map['LEFT']     # Turn 90 degrees counter-clockwise\n  ACTION_TURN_RIGHT = action_map['RIGHT']   # Turn 90 degrees clockwise\n  ACTION_USE = action_map['USE']            # Use/collect the item in the cell directly in front of the agent\n\n  # Define changes in (row, col) for each direction when the agent moves forward.\n  # This mapping helps calculate the new position after a 'MOVE_FORWARD' action.\n  DIRECTION_DELTAS = {\n      0: (0, 1),   # Facing RIGHT: (delta_row, delta_col) = (0, +1)\n      1: (-1, 0),  # Facing UP:    (delta_row, delta_col) = (-1, 0)\n      2: (0, -1),  # Facing LEFT:  (delta_row, delta_col) = (0, -1)\n      3: (1, 0)    # Facing DOWN:  (delta_row, delta_col) = (+1, 0)\n  }\n\n  # Define how the agent's direction changes when performing a 'TURN_LEFT' action.\n  # Maps old_direction -> new_direction.\n  TURN_LEFT_DIR_MAP = {\n      0: 1,  # RIGHT (0) -> UP (1)\n      1: 2,  # UP (1)    -> LEFT (2)\n      2: 3,  # LEFT (2)  -> DOWN (3)\n      3: 0   # DOWN (3)  -> RIGHT (0)\n  }\n\n  # Define how the agent's direction changes when performing a 'TURN_RIGHT' action.\n  # Maps old_direction -> new_direction.\n  TURN_RIGHT_DIR_MAP = {\n      0: 3,  # RIGHT (0) -> DOWN (3)\n      1: 0,  # UP (1)    -> RIGHT (0)\n      2: 1,  # LEFT (2)  -> UP (1)\n      3: 2   # DOWN (3)  -> LEFT (2)\n  }\n\n  # Get indices of entities that block agent movement. These are cells the agent cannot walk into.\n  # Examples include boundaries, water, or specific workshop locations.\n  non_walkable_object_ids = current_state.world.non_grabbable_indices\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # The queue stores states to explore:\n  #   ((current_row, current_col), current_direction), list_of_actions_taken_to_reach_this_state\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # The visited_states set keeps track of (position_tuple, direction_int) pairs that have already been\n  # added to the queue, preventing redundant explorations and infinite loops.\n  visited_states = {(agent_pos, agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state from which the\n  # primitive can be successfully collected (i.e., being adjacent to and facing it).\n  target_actions_path = None \n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current (position, direction) state.\n      # This is the goal condition: being in a position to perform the 'USE' action.\n      front_dr, front_dc = DIRECTION_DELTAS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the cell directly in front contains the target primitive\n          if grid[front_r, front_c, primitive_kind_id] > 0:\n              target_actions_path = path_so_far # We found the path that gets us adjacent to and facing the primitive.\n              break # Exit BFS, as the shortest path to the goal condition has been found.\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try performing a 'MOVE_FORWARD' action\n      move_dr, move_dc = DIRECTION_DELTAS[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # The direction does not change when moving forward\n\n      # Check if the next position is within grid boundaries and if this (position, direction) state hasn't been visited\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          # Determine if the cell at `next_pos_after_move` is walkable.\n          is_cell_walkable = True\n          # The agent cannot walk into cells containing non-walkable objects.\n          for kind_idx in non_walkable_object_ids:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_cell_walkable = False\n                  break\n          \n          # Additionally, the agent cannot walk *onto* the primitive it intends to collect;\n          # it must remain adjacent to it to use the 'USE' action.\n          if is_cell_walkable and grid[next_r, next_c, primitive_kind_id] > 0:\n              is_cell_walkable = False\n\n          if is_cell_walkable:\n              visited_states.add((next_pos_after_move, next_dir_after_move))\n              queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # Try performing a 'TURN_LEFT' action\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning actions do not change the agent's position, only its direction.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # Try performing a 'TURN_RIGHT' action\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning actions do not change the agent's position, only its direction.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # If a path was found to a state where the agent is adjacent to and facing the primitive,\n  # append the 'USE' action to the sequence to complete the collection process.\n  if target_actions_path is not None:\n      actions_list.extend(target_actions_path)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:21:11.896679", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # The multiplier '10' accounts for possible different inventory states at the same (pos, dir).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Improvement for v2: If we've explored too many distinct states, return empty list immediately.\n    # This prevents exhausting the queue with states beyond the heuristic limit if a path is not found.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:21:13.600341", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory_tuple is crucial as agent capabilities can change with acquired items\n  # (e.g., picking up a tool makes new interactions possible).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in very large or complex state spaces,\n  # especially when many inventory variations might be possible for a given position/direction.\n  # Increasing the multiplier from 10 to 20 allows for a deeper search for longer paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:22:03.816472", "function_name": "collect", "function_body": "  actions_sequence = [] # Initialize an empty list to store the sequence of actions.\n  \n  # Access the current state of the environment. The `_current_state` attribute\n  # holds all dynamic information like grid, agent position, and inventory.\n  current_state = env._current_state \n  game_grid = current_state.grid\n  agent_pos = current_state.pos # Agent's current (row, column) tuple.\n  \n  # Convert the human-readable primitive name (e.g., \"WOOD\", \"STONE\") into its\n  # internal integer ID. This ID is used for indexing the grid and inventory arrays.\n  # If the primitive name is not recognized (e.g., not in the cookbook), collection is impossible.\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is invalid or not found, return an empty action list.\n    return []\n\n  # Get the dimensions of the game grid. `GRID_ROWS` corresponds to the height (number of rows),\n  # and `GRID_COLS` corresponds to the width (number of columns).\n  GRID_ROWS, GRID_COLS, _ = game_grid.shape\n\n  # Retrieve the integer IDs for standard movement and interaction actions from the environment's\n  # action specifications. This ensures compatibility with the DMLab-style `env.step()` function\n  # and makes the code robust to potential changes in action ID mappings.\n  action_ids = env.action_specs()\n  ACTION_DOWN = action_ids['DOWN']\n  ACTION_UP = action_ids['UP']\n  ACTION_LEFT = action_ids['LEFT']\n  ACTION_RIGHT = action_ids['RIGHT']\n  ACTION_USE = action_ids['USE']\n\n  # Define the change in coordinates (delta_row, delta_col) for each cardinal movement action.\n  # This mapping simplifies the calculation of new positions during pathfinding.\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (-1, 0),    # Moving UP decreases the row index.\n      ACTION_DOWN: (1, 0),   # Moving DOWN increases the row index.\n      ACTION_LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      ACTION_RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n\n  # --- Phase 1: Immediate Adjacency Check ---\n  # Before embarking on a potentially expensive pathfinding search, first check if the agent\n  # is already directly adjacent to the primitive. The `current_state.next_to()` method\n  # efficiently checks the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(primitive_id):\n      # If adjacent, and the primitive is classified as 'grabbable' (i.e., it can be picked up\n      # and added to inventory, like wood or stone, as opposed to static environment features\n      # like workshops or water), then a single 'USE' action is sufficient.\n      if primitive_id in env.world.grabbable_indices:\n          actions_sequence.append(ACTION_USE)\n      # In either case (grabbable and used, or not grabbable), we're done.\n      return actions_sequence \n\n  # --- Phase 2: Locate All Primitive Instances on the Grid ---\n  # If the agent is not immediately adjacent, we need to find all locations where the primitive\n  # exists on the grid. These locations will serve as potential targets for our pathfinding algorithm.\n  all_primitive_locations = []\n  for r in range(GRID_ROWS): # Iterate through all rows of the grid.\n      for c in range(GRID_COLS): # Iterate through all columns of the grid.\n          # The `game_grid` is a 3D NumPy array where `game_grid[r, c, kind_id]`\n          # is 1 if that kind of entity is present at (r,c), and 0 otherwise.\n          if game_grid[r, c, primitive_id] == 1:\n              all_primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found anywhere on the grid, it's impossible\n  # to collect it. Return an empty list to indicate this.\n  if not all_primitive_locations:\n      return []\n\n  # --- Phase 3: Breadth-First Search (BFS) for the Shortest Path ---\n  # The goal of this BFS is to find the minimal sequence of movement actions required\n  # to reach *any* grid cell from which the agent can interact with (i.e., be cardinally\n  # adjacent to) one of the `all_primitive_locations`.\n\n  # BFS queue: Stores tuples of ((current_row, current_col), [path_of_actions_to_reach_here]).\n  # We start the search from the agent's current position with an empty path.\n  bfs_queue = collections.deque([(agent_pos, [])]) \n  \n  # `visited_cells` set: Tracks grid positions that have already been added to the queue\n  # and explored. This is crucial for preventing infinite loops in cyclic paths and\n  # for guaranteeing that the first path found is the shortest.\n  visited_cells = {agent_pos} \n\n  # This variable will store the discovered shortest sequence of movement actions\n  # that leads to a cell adjacent to the primitive. It will be populated once\n  # such a path is found.\n  shortest_movement_path_to_adjacent_cell = None \n\n  # Begin the BFS traversal.\n  while bfs_queue:\n      (current_r, current_c), path_history = bfs_queue.popleft()\n\n      # For the current cell (current_r, current_c), check if it is cardinally adjacent\n      # to any of the primitive locations found in Phase 2. Cardinal adjacency means\n      # a Manhattan distance of 1 (directly up, down, left, or right).\n      # If so, this `current_r, current_c` is a valid \"target cell\" for the agent\n      # to move to before performing the 'USE' action.\n      for target_primitive_r, target_primitive_c in all_primitive_locations:\n          # Manhattan distance check for adjacency: |r1-r2| + |c1-c2| == 1\n          if abs(current_r - target_primitive_r) + abs(current_c - target_primitive_c) == 1: \n              shortest_movement_path_to_adjacent_cell = path_history # Store the path leading to this adjacent cell.\n              break # Found a valid target for this path; no need to check other primitive locations for this path.\n      \n      # If a path to an adjacent cell has been found, we can stop the BFS.\n      # BFS guarantees that the first path found to any target state is the shortest.\n      if shortest_movement_path_to_adjacent_cell is not None:\n          break \n\n      # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT) from the `current_r, current_c`.\n      for action_direction, (dr, dc) in MOVEMENT_DELTAS.items():\n          next_r, next_c = current_r + dr, current_c + dc # Calculate the coordinates of the potential next cell.\n          next_cell_pos = (next_r, next_c)\n\n          # Validation Checks for `next_cell_pos`:\n          # 1. Boundary Check: Ensure the new position is within the grid limits.\n          if not (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n              continue # Skip this neighbor if it's outside the grid.\n          \n          # 2. Traversability Check: Determine if the agent can move onto `next_cell_pos`.\n          # Cells containing `non_grabbable_indices` (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP' structures)\n          # are considered obstacles and cannot be traversed by the agent.\n          is_cell_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              # Check if the potential next cell contains any non-grabbable item.\n              if game_grid[next_r, next_c, non_grabbable_kind_id] == 1: \n                  is_cell_traversable = False # This cell contains an obstacle.\n                  break # No need to check other non-grabbable types for this cell; it's an obstacle.\n          \n          if not is_cell_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # 3. Visited Check: If this neighbor cell has not been visited yet, add it to the queue.\n          # This prevents redundant exploration and ensures optimality of the path.\n          if next_cell_pos not in visited_cells:\n              visited_cells.add(next_cell_pos) # Mark the new position as visited.\n              # Extend the current path with the action taken to reach this `next_cell_pos`.\n              new_path_for_next_cell = path_history + [action_direction] \n              bfs_queue.append((next_cell_pos, new_path_for_next_cell)) # Add the new state (position and path) to the queue.\n    \n  # --- Phase 4: Construct the Final Action Sequence ---\n  # If BFS successfully found a path to a cell adjacent to the primitive:\n  if shortest_movement_path_to_adjacent_cell is not None:\n      # First, append all the movement actions required to reach that adjacent cell.\n      actions_sequence.extend(shortest_movement_path_to_adjacent_cell)\n      \n      # Then, if the primitive is an item that can actually be picked up (e.g., \"WOOD\", \"IRON\"),\n      # append the 'USE' action to perform the collection. We explicitly avoid appending 'USE'\n      # for non-grabbable entities like \"WATER\" or \"WORKSHOP0\" even if the agent reaches a cell\n      # adjacent to them, as these cannot be \"collected\" into inventory.\n      if primitive_id in env.world.grabbable_indices:\n          actions_sequence.append(ACTION_USE) \n  \n  return actions_sequence", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:22:05.069305", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Returns a list of actions to find and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions = []\n  \n  # Access the current state of the environment. This state object contains\n  # the current grid layout, agent's position, and inventory, along with references\n  # to the CraftWorld configuration (cookbook, non-grabbable items, etc.).\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos # Agent's current (row, column) position.\n  \n  # 1. Resolve the primitive name (string) to its corresponding integer ID.\n  # This ID is used internally in the grid and by the world's `cookbook` and `index`.\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook's index, it's an unknown item\n    # and therefore cannot be collected. Return an empty list of actions.\n    return []\n\n  # Extract grid dimensions from the grid's shape.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Obtain the integer representations for standard movement and interaction actions\n  # from the environment's `action_specs`. This ensures compatibility with the\n  # `env.step()` function, which expects these integer IDs.\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define coordinate changes (deltas) for each cardinal movement action.\n  # These are used to calculate the new (row, column) position after taking an action.\n  MOVE_DELTAS = {\n      UP: (-1, 0),    # (row_change, col_change) for moving UP.\n      DOWN: (1, 0),   # (row_change, col_change) for moving DOWN.\n      LEFT: (0, -1),  # (row_change, col_change) for moving LEFT.\n      RIGHT: (0, 1)   # (row_change, col_change) for moving RIGHT.\n  }\n\n  # --- Step 2: Immediate collection check ---\n  # First, check if the agent is already within collecting range (3x3 neighborhood)\n  # of the primitive. The `current_state.next_to()` method performs this check efficiently.\n  if current_state.next_to(primitive_id):\n      # If adjacent, and the primitive is an item that can actually be picked up\n      # (as opposed to, say, a static structure like a workshop or water),\n      # then a single 'USE' action is sufficient.\n      if primitive_id in env.world.grabbable_indices:\n          actions.append(USE)\n      # In either case (grabbable and used, or not grabbable but adjacent),\n      # we can return immediately as no further movement is needed.\n      return actions \n\n  # --- Step 3: Locate all instances of the target primitive on the grid ---\n  # We need to find all possible locations where the desired primitive exists.\n  # This list forms the set of potential targets for our pathfinding algorithm.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # If the grid layer corresponding to `primitive_id` has a value of 1 at (r, c),\n          # it signifies that the primitive is present in that cell.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If, after scanning the entire grid, no instances of the primitive are found,\n  # it's impossible to collect it. Return an empty list of actions.\n  if not primitive_locations:\n      return []\n\n  # --- Step 4: Breadth-First Search (BFS) for the shortest path ---\n  # The BFS aims to find the minimum number of movement actions required to reach\n  # any grid cell from which the agent can successfully `USE` (collect) the primitive.\n  # This means finding a path to a cell that is cardinally adjacent to any primitive location.\n\n  # The BFS queue stores tuples: `((row, column), [list_of_actions_to_reach_this_point])`.\n  bfs_queue = collections.deque([(current_pos, [])]) \n  # `visited_positions` is a set to keep track of grid cells already explored.\n  # This prevents infinite loops in cyclic paths and ensures the shortest path is found.\n  visited_positions = {current_pos} \n\n  # This variable will store the final sequence of movement actions once the\n  # shortest path to an adjacent, traversable cell is discovered.\n  shortest_path_to_adj_cell = None \n\n  # Start the BFS exploration.\n  while bfs_queue:\n      (current_r, current_c), path_so_far = bfs_queue.popleft()\n\n      # For the current cell `(current_r, current_c)` in the BFS, check if it is\n      # cardinally adjacent (Manhattan distance of 1) to any of the primitive locations.\n      # If so, this cell is a valid target from which the 'USE' action can be applied.\n      for target_primitive_r, target_primitive_c in primitive_locations:\n          if abs(current_r - target_primitive_r) + abs(current_c - target_primitive_c) == 1: \n              shortest_path_to_adj_cell = path_so_far # Store the path leading to this adjacent cell.\n              break # Found a valid target; no need to check other primitive locations for this path.\n      \n      if shortest_path_to_adj_cell is not None:\n          break # If the shortest path to an adjacent cell has been found, exit the BFS.\n\n      # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT) from the `current_pos`.\n      for action_direction, (dr, dc) in MOVE_DELTAS.items():\n          next_r, next_c = current_r + dr, current_c + dc # Calculate the coordinates of the potential next cell.\n          next_pos = (next_r, next_c)\n\n          # Validate the `next_pos`:\n          # a. Boundary check: Ensure the new position is within the grid limits.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue # Skip this neighbor if it's out of bounds.\n          \n          # b. Traversability check: Determine if the agent can move onto `next_pos`.\n          # A cell is non-traversable if it contains any item whose ID is in the\n          # `env.world.non_grabbable_indices` set (e.g., walls, water, workshops).\n          is_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, non_grabbable_kind_id] == 1: \n                  is_traversable = False # This cell contains an obstacle.\n                  break # No need to check other non-grabbable types for this cell.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # c. Visited check: If this neighbor has not been visited yet, add it to the queue.\n          # This ensures that BFS finds the shortest path by processing layers level by level.\n          if next_pos not in visited_positions:\n              visited_positions.add(next_pos) # Mark the position as visited.\n              # Extend the current path with the action taken to reach this `next_pos`.\n              new_path_so_far = path_so_far + [action_direction] \n              bfs_queue.append((next_pos, new_path_so_far)) # Add the new state to the queue.\n    \n  # --- Step 5: Construct the final sequence of actions ---\n  # If the BFS successfully found a path to an adjacent, traversable cell:\n  if shortest_path_to_adj_cell is not None:\n      # First, append all the movement actions required to reach the target adjacent cell.\n      actions.extend(shortest_path_to_adj_cell)\n      \n      # Then, if the primitive itself is a grabbable item (e.g., wood, stone, iron),\n      # append the 'USE' action to actually collect it. Non-grabbable entities\n      # like workshops or water cannot be \"collected\" in this manner.\n      if primitive_id in env.world.grabbable_indices:\n          actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:22:50.046045", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Pre-computation and Initialization ---\n\n  # Map the primitive's string name to its internal integer ID.\n  # This relies on the Cookbook's index, which is robust for mapping names to IDs.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve essential action indices for readability and consistency.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define cardinal movement directions and their corresponding actions.\n  # This mapping helps in iterating through possible moves in BFS.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # Determine which entity kinds are impassable for agent movement.\n  # These are typically non-grabbable items that are *not* workshops (workshops are traversable).\n  # Convert to a numpy array for efficient indexing in the BFS loop's impassability check.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  impassable_kinds_array = np.array(list(impassable_kinds)) if impassable_kinds else np.array([])\n\n  # Get current grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # --- 2. Initial Checks ---\n\n  # If the primitive is already in the agent's inventory, no actions are required.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # If the agent is already adjacent to the primitive, a single USE action is sufficient.\n  # This check helps in immediately resolving cases where the agent is in position.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 3. Locate Primitives on Grid and Define Goal Cells ---\n\n  primitive_grid_locations = []\n  # Iterate over the entire grid to find all occurrences of the target primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_grid_locations:\n    return []\n\n  # Define \"goal cells\" for the BFS. These are all valid, traversable cells\n  # from which the agent can successfully `USE` to collect the primitive.\n  # The 'USE' action affects a 3x3 neighborhood, so any cell within that neighborhood\n  # of a primitive's location is a valid goal to move to before using.\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the candidate goal cell is within grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- 4. Breadth-First Search (BFS) for Shortest Path ---\n  \n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and redundant exploration.\n  visited = {start_pos} \n\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of the designated goal cells,\n    # we've found the shortest path to a collection point.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action as the final step to collect the primitive.\n      return path_to_current + [USE] \n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the new position contain an impassable kind?\n      # We use numpy.any() for an efficient check across all impassable_kinds_array elements.\n      # The `impassable_kinds_array.size > 0` condition prevents errors if the array is empty.\n      if impassable_kinds_array.size > 0 and np.any(grid[nx, ny, impassable_kinds_array] > 0):\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored in a shorter or equal path?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        q.append((new_pos, path_to_current + [action])) # Enqueue new position and its accumulated path.\n\n  # If the BFS completes and the queue is empty, it means no path to a goal cell was found.\n  # Therefore, the primitive is unreachable from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:22:51.150795", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Pre-computation and Initialization ---\n\n  # Map the primitive's string name to its internal integer ID.\n  # This relies on the Cookbook's index, which is robust.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve essential action indices for readability and consistency.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define cardinal movement directions and their corresponding actions.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # Determine which entity kinds are impassable for agent movement.\n  # These are typically non-grabbable items that are not workshops (which are traversable).\n  # Convert to a numpy array for efficient indexing in the BFS loop's impassability check.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n  impassable_kinds_array = np.array(list(impassable_kinds)) if impassable_kinds else np.array([])\n\n  # Get current grid dimensions for boundary checks.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # --- 2. Initial Checks ---\n\n  # If the primitive is already in the agent's inventory, no actions are required.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # If the agent is already adjacent to the primitive, a single USE action is sufficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 3. Locate Primitives on Grid and Define Goal Cells ---\n\n  primitive_grid_locations = []\n  # Iterate over the grid to find all occurrences of the target primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_grid_locations:\n    return []\n\n  # Define \"goal cells\" for the BFS. These are all valid, traversable cells\n  # from which the agent can successfully `USE` to collect the primitive\n  # (i.e., any cell within the 3x3 neighborhood of a primitive's location).\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- 4. Breadth-First Search (BFS) ---\n  \n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and re-exploring paths.\n  visited = {start_pos} \n\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE] # Append USE as the final collection action.\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the new position contain an impassable kind?\n      # Efficiently check if any of the impassable_kinds are present at (nx, ny)\n      # using numpy's any() over the relevant slice of the grid.\n      if impassable_kinds_array.size > 0 and np.any(grid[nx, ny, impassable_kinds_array] > 0):\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        q.append((new_pos, path_to_current + [action])) # Enqueue new position and path.\n\n  # If the BFS completes and the queue is empty, no path to a goal cell was found.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:24:22.985648", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid_snapshot = current_state.grid # Use a clearer name for the static grid state\n  initial_pos = current_state.pos    # Agent's starting position (row, col)\n  initial_dir = current_state.dir    # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Early exit: If the primitive name is not valid (not in the index)\n  # or if it's not a grabbable item (e.g., a workshop or boundary),\n  # we cannot 'collect' it using the USE action in this context,\n  # as 'collect' implies adding to inventory.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  # Extract grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_snapshot.shape\n\n  # Map DSL action names to their integer IDs provided by the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' typically means move forward in current dir.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors (delta_row, delta_col) for agent movement.\n  # The agent's direction (dir) is usually an integer: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT: moving forward increases column index by 1.\n      1: (-1, 0),  # Facing UP: moving forward decreases row index by 1.\n      2: (0, -1),  # Facing LEFT: moving forward decreases column index by 1.\n      3: (1, 0)    # Facing DOWN: moving forward increases row index by 1.\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT (Counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT (Clockwise)\n\n  # Define a set of entity kinds that the agent cannot walk onto.\n  # This set includes:\n  # 1. Environment's general non-grabbable items (e.g., boundaries, water, workshops).\n  # 2. The target primitive itself, as the 'USE' action requires being adjacent, not on top.\n  impassable_for_movement_kinds = current_state.world.non_grabbable_indices.copy()\n  impassable_for_movement_kinds.add(primitive_id) \n\n  # BFS state representation: ((row, col), direction).\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and ensure that the shortest path (in terms of action count) is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions leading to the collection point.\n\n  # Perform Breadth-First Search to find the shortest path to the primitive.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Goal Check: Determine if the agent is currently in a \"goal state\"\n      # where the primitive can be collected. A goal state means the primitive\n      # is directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc # Coordinates of the cell directly in front.\n      \n      # Check if the cell in front is within the grid boundaries.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the cell directly in front contains the target primitive.\n          if grid_snapshot[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # A path to the collection point has been found!\n              break # Exit BFS as the shortest path is guaranteed by BFS.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n      \n      # --- Explore Move Forward action ---\n      # Calculate the next position if the agent moves forward. The direction remains unchanged.\n      move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n      next_r_fwd, next_c_fwd = r + move_dr, c + move_dc\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir\n\n      # Check if the potential next state (position, direction) is valid and hasn't been visited.\n      if (0 <= next_r_fwd < GRID_WIDTH and 0 <= next_c_fwd < GRID_HEIGHT and\n          (next_pos_fwd, next_dir_fwd) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any entity that is impassable for movement.\n          for kind_idx in impassable_for_movement_kinds:\n              if grid_snapshot[next_r_fwd, next_c_fwd, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos_fwd, next_dir_fwd))\n              queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Explore Turn Left action ---\n      # Turning only changes the agent's direction, not its position.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Explore Turn Right action ---\n      # Turning only changes the agent's direction, not its position.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a valid path to the primitive was found (or if the agent started in a collectible state),\n  # extend the `actions_list` with the path and then append the `USE_ACTION`.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:24:24.200749", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state \n  grid_snapshot = current_state.grid # The static grid layout at the beginning of the search.\n  initial_pos = current_state.pos    # Agent's starting (row, col) coordinates.\n  initial_dir = current_state.dir    # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Early exit: If the primitive name is not valid (not in the index) \n  # or if it's not a grabbable item (e.g., a workshop, boundary, or water),\n  # we cannot 'collect' it using the 'USE' action in this context.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  # Retrieve grid dimensions for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid_snapshot.shape # Using GRID_ROWS, GRID_COLS for clarity\n\n  # Map string action names to their corresponding integer IDs using the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' typically moves the agent forward.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item in front.\n\n  # Define changes in (row, col) for each direction when moving forward.\n  # (dir: (delta_row, delta_col))\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # (current_dir: new_dir_after_turn)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT (counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT (clockwise)\n\n  # Get the set of entity indices that the agent cannot walk through.\n  # These are defined as non-grabbable items in the CraftWorld.\n  non_walkable_entities = current_state.world.non_grabbable_indices\n\n  # BFS setup:\n  # Queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (agent_position_tuple, agent_direction_int) to avoid cycles and redundant exploration.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the final sequence of actions if a path is found.\n\n  # Start Breadth-First Search.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current position.\n\n      # 1. Goal Check:\n      # Check if the primitive is in the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc # Calculate coordinates of the cell in front.\n      \n      # Ensure the 'front' cell is within grid boundaries.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the target primitive is found in the cell directly in front,\n          # we have found the shortest path to a collection point.\n          if grid_snapshot[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Store the path leading to this position.\n              break # Exit BFS; shortest path guaranteed by BFS.\n\n      # 2. Explore possible next actions from the current state.\n      \n      # --- Action: Move Forward (MOVE_FORWARD_ACTION) ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n      next_r_fwd, next_c_fwd = r + move_dr, c + move_dc\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir # Direction doesn't change on move.\n\n      # Check if the potential next position is within boundaries and the new state hasn't been visited.\n      if (0 <= next_r_fwd < GRID_ROWS and 0 <= next_c_fwd < GRID_COLS and\n          (next_pos_fwd, next_dir_fwd) not in visited):\n          \n          is_walkable = True\n          # Check if the cell at `next_pos_fwd` contains any non-walkable entities.\n          for kind_idx in non_walkable_entities:\n              if grid_snapshot[next_r_fwd, next_c_fwd, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Crucially, ensure the agent does not walk *onto* the primitive itself.\n          # The 'USE' action requires the agent to be adjacent, not on top of, the item.\n          if grid_snapshot[next_r_fwd, next_c_fwd, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos_fwd, next_dir_fwd))\n              queue.append(((next_pos_fwd, next_dir_fwd), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Action: Turn Left (TURN_LEFT_ACTION) ---\n      # Turning changes direction, but not position.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if the new state (same position, new direction) has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Action: Turn Right (TURN_RIGHT_ACTION) ---\n      # Turning changes direction, but not position.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if the new state (same position, new direction) has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a valid path to a collection point was found, append the 'USE' action.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:25:30.233757", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the cookbook, it cannot be collected.\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Improvements over collect_v1 ===\n\n  # 1. Early exit if the primitive doesn't exist anywhere on the initial grid.\n  # This avoids unnecessary BFS computations when the goal is impossible from the start.\n  if not np.any(initial_grid[:, :, primitive_id] > 0):\n      return []\n\n  # 2. Early exit if the target primitive is not a grabbable item.\n  # Non-grabbable items (like WORKSHOP, WATER, BOUNDARY) cannot be \"collected\" into inventory\n  # via the 'USE' action in the same way as grabbable primitives.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Define action map early as it's needed for the `next_to` check and subsequent BFS.\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  # 3. Early exit if the primitive is already in the agent's 3x3 neighborhood.\n  # If already adjacent, a single 'USE' action is sufficient, assuming 'USE' can\n  # identify and collect any grabbable item in the 3x3 vicinity.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n  # ====================================\n\n  # Remaining action definitions and BFS logic from collect_v1\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n\n  # Mapping agent's direction to (dr, dc) change for moving forward.\n  # 0: RIGHT, 1: UP, 2: LEFT, 3: DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves +1 in column\n      1: (-1, 0),  # Facing UP: moves -1 in row\n      2: (0, -1),  # Facing LEFT: moves -1 in column\n      3: (1, 0)    # Facing DOWN: moves +1 in row\n  }\n\n  # Mapping for turns (new_direction = TURN_MAP[current_direction])\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify obstacles: entities the agent cannot walk onto.\n  # This includes non-grabbable items (like workshops, water, boundaries) and\n  # also the primitive itself (agent collects from adjacent tile, not by occupying it).\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  # Add the primitive's ID to obstacles if it's a grabbable item, as the agent shouldn't walk on it.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # To store the action sequence once the goal state is found.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent\n\n      # 1. Check if the current state is a goal state for collection:\n      # The goal in collect_v1 is defined as the primitive being directly in front of the agent,\n      # allowing the 'USE' action to collect it.\n      \n      # Calculate coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the primitive is present in the cell directly in front\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Found the shortest path to this position+direction.\n              break # Terminate BFS as the shortest path is found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward action:\n      next_r_move, next_c_move = r + front_dr, c + front_dc # Position after attempting to move forward\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains unchanged after moving forward\n\n      # Check if the new position is within grid boundaries and if this specific\n      # (position, direction) state has not been visited to avoid redundant paths.\n      if (0 <= next_r_move < WIDTH and 0 <= next_c_move < HEIGHT and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it's not occupied by any 'obstacle' kind.\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_MAP[current_dir] # New direction after turning left\n      # Turning does not change the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_MAP[current_dir] # New direction after turning right\n      # Turning does not change the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectible position (where the primitive is directly in front) was found,\n  # append the 'USE' action to the sequence to actually collect it.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
