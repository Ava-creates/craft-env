{"timestamp": "2025-08-01T13:15:24.028438", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (e.g., \"wood\", \"water\") to its integer ID used by the simulation.\n  # If the primitive name is not found in the world's index, it's an invalid target,\n  # so no actions can be taken to collect it.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # The primitive name provided is not recognized by the environment.\n    return []\n\n  # 2. Check if the agent already possesses the primitive in its inventory.\n  # If the goal is already satisfied (primitive is in inventory), no actions are necessary for collection.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if this primitive is something that can actually be \"collected\"\n  # via the 'USE' action within the game's mechanics.\n  # \"Grabbable indices\" include items that can be picked up from the ground.\n  # \"Water\" and \"Stone\" are specific environmental resources collected by 'USE'.\n  # Other entities like \"WORKSHOP0\", \"BOUNDARY\", etc., are typically not collected into inventory\n  # by simply using them.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target primitive is not designed to be collected using 'USE' action in this manner,\n  # this function cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants (integer IDs) and utility mappings for agent movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # Group movement actions for easier iteration during BFS.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # This dictionary maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding change in (row, column) to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (moves towards smaller row index, i.e., North)\n      1: (0, 1),  # RIGHT (moves towards larger column index, i.e., East)\n      2: (1, 0),  # DOWN (moves towards larger row index, i.e., South)\n      3: (0, -1)  # LEFT (moves towards smaller column index, i.e., West)\n  }\n\n  # Helper function to calculate the minimal sequence of turning actions (LEFT/RIGHT)\n  # required to change the agent's `current_dir` to face `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction, no turns needed.\n      \n      # Calculate the difference in directions, handling the circular nature of directions (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # A difference of 1 implies a single clockwise turn (e.g., UP(0) to RIGHT(1)).\n          return [RIGHT_ACT]\n      elif diff == 3: # A difference of 3 implies a single counter-clockwise turn (e.g., UP(0) to LEFT(3)).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) to DOWN(2)).\n          # This can be achieved by two consecutive right turns or two consecutive left turns.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # The queue for states to explore: stores (CraftState object, path_to_reach_state).\n  # The `visited` set tracks states already processed to prevent redundant exploration and cycles.\n  # A state is defined by (agent_row, agent_col, agent_direction, current_inventory_as_tuple).\n  # Inventory (a numpy array) must be converted to a hashable tuple.\n  visited = set()\n\n  # Start BFS from the agent's initial state in the environment.\n  # Convert initial inventory (numpy array) to a tuple for inclusion in the visited set key.\n  initial_inventory_tuple = tuple(current_state.inventory) \n  q.append((current_state, [])) # Add the starting state and an empty path.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Set a pragmatic limit on the number of states to explore.\n  # This prevents extremely long searches or infinite loops in complex or unsolvable scenarios.\n  # The heuristic multiplier '4' accounts for directions, and '10' for various relevant inventory states\n  # (e.g., acquiring and using different tools or intermediate items, which is relevant for crafting but less so for simple collection).\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path to collect the primitive.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path that led to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the defined limit, stop exploring\n    # from this branch to prevent performance issues. This means either the path is too long\n    # or the primitive is effectively unreachable within practical limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Skip processing this state, but allow BFS to continue with other states already in the queue.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the target primitive (`i_kind`) from the current `state`?\n    # This involves checking if the primitive is in an adjacent cell.\n    if state.next_to(i_kind):\n        # If the primitive is adjacent, iterate through all four possible directions (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT).\n        # We need to find which specific direction (if any) points to the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after potentially turning) is within grid bounds\n            # and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If the primitive is found in the cell pointed to by `target_dir`:\n                # 1. Calculate the turning actions required to face that direction.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Simulate the turning actions. In CraftLab, rewards for simple moves are 0.0.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # 2. Record the agent's inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying if the 'USE' action successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # 3. Simulate the 'USE' action. This is the action that attempts to collect the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # 4. Crucial Verification: Check if the count of the target primitive in the inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # accounting for any internal game rules (e.g., tools needed, resource depletion, etc.).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collection was successful, we have found the shortest path!\n                    # Return the combined sequence of actions: path to `state` + turns + `USE`.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Expand the current `state` by trying all possible actions:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate taking the movement action to obtain the `next_state`.\n      _, next_state = state.step(action)\n      \n      # Create a hashable key for the `next_state` by converting its inventory\n      # (a numpy array) to a tuple.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this `next_state` has not been visited before, add it to the queue\n      # for future exploration and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. The 'USE' action from the agent's current position.\n    # This is important for scenarios where using an item at the agent's current location\n    # (e.g., picking up a required tool, using a workshop to craft a prerequisite for collection)\n    # changes the state in a way that enables the subsequent collection of the primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if performing the 'USE' action actually resulted in a meaningful change\n    # to the agent's state (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if 'USE' had no effect in this context.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # If this new state (resulting from 'USE') has not been visited, add it to the queue.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it indicates that the primitive is currently unreachable or uncollectible from the initial state\n  # under the current game rules and environment configuration within the exploration limits.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:15:25.581876", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to the CraftWorld configuration, including cookbook, indices.\n\n  # 1. Convert the primitive name (e.g., \"wood\", \"stone\") to its integer ID.\n  # This ID is used consistently within the simulation's grid and inventory.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the world's index, it's an invalid target.\n    # No actions can be taken to collect it.\n    return []\n\n  # 2. Check if the agent already possesses the primitive in its inventory.\n  # If the collection goal is already satisfied, no actions are necessary.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if this primitive is something that can be \"collected\" using the 'USE' action.\n  # This function specifically implements collection via movement to an item's location and then using 'USE'.\n  # Grabbable entities (like items on the ground) and primary resources (water, stone) are collected this way.\n  # Other entities (e.g., workshops, boundaries, crafted items) are not typically collected into inventory via 'USE'.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target primitive is not designated as collectible by 'USE' in the game mechanics,\n  # this `collect` function (which relies on 'USE') cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants (integer IDs) from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # Group movement actions for easier iteration during BFS.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # This dictionary maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding change in (row, column) to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to calculate the minimum sequence of turning actions (LEFT/RIGHT)\n  # needed to change the agent's `current_dir` to face `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction.\n      \n      # Calculate the difference in directions, handling the circular nature (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) to RIGHT(1)).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) to LEFT(3)).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) to DOWN(2)).\n          # This can be achieved by two consecutive right turns or two consecutive left turns.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # The queue for states to explore: stores (CraftState object, path_to_reach_state).\n  \n  # The `visited` set tracks states already processed to prevent redundant exploration and cycles.\n  # A state is uniquely defined by (agent_row, agent_col, agent_direction, current_inventory_as_tuple).\n  # Inventory (a numpy array) must be converted to a hashable tuple for inclusion in the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory) \n  q.append((current_state, [])) # (State object, list of action IDs to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Set a pragmatic limit on the number of states to explore.\n  # This prevents excessively long searches or infinite loops in complex or unsolvable scenarios.\n  # Heuristic: grid size * 4 (for directions) * 10 (for variations in inventory relevant to collection).\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest path to collect the primitive.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path that led to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the defined limit, skip processing\n    # this state to manage computational resources. This implies the path is too long\n    # or the primitive is practically unreachable within these limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the target primitive (`i_kind`) from the current `state`?\n    # This involves checking if the primitive is in an adjacent cell and then attempting to 'USE' it.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT).\n        # We need to find which specific direction (if any) points to the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after potentially turning) is within grid bounds\n            # and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If the primitive is found in the cell pointed to by `target_dir`:\n                # 1. Calculate and simulate the turning actions required to face that direction.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Simulating turns results in 0.0 reward in CraftLab.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # 2. Record the agent's inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying if the 'USE' action successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # 3. Simulate the 'USE' action. This is the action that attempts to collect the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # 4. Crucial Verification: Check if the count of the target primitive in the inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # accounting for any internal game rules (e.g., tools needed, resource depletion).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collection was successful, we have found the shortest path!\n                    # Return the combined sequence of actions: path to `state` + turns + `USE`.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Expand the current `state` by trying all possible actions:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate taking the movement action to obtain the `next_state`.\n      _, next_state = state.step(action)\n      \n      # Create a hashable key for the `next_state` by converting its inventory\n      # (a numpy array) to a tuple. This is vital because inventory changes define distinct states.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this `next_state` has not been visited before, add it to the queue\n      # for future exploration and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. The 'USE' action from the agent's current position (even if not directly facing the primitive).\n    # This is important for scenarios where using an item at the agent's current location\n    # (e.g., picking up a required tool, using a workbench to craft a prerequisite) changes the state\n    # in a way that enables the subsequent collection of the primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if performing the 'USE' action actually resulted in a meaningful change\n    # to the agent's state (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if 'USE' had no effect in this context.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # If this new state (resulting from 'USE') has not been visited, add it to the queue.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it indicates that the primitive is currently unreachable or uncollectible from the initial state\n  # under the current game rules and environment configuration.\n  return []", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:16:12.882971", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple (r, c)\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions. Assuming grid.shape is (num_rows, num_cols, num_kinds)\n  # Based on CraftScenario init: grid: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  # WIDTH maps to rows, HEIGHT maps to columns.\n  NUM_ROWS, NUM_COLS, _ = initial_grid.shape\n\n  # If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions to their integer indices using the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the cell in front of the agent or where the agent moves.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: no row change, +1 to column\n      1: (-1, 0),  # Facing UP: -1 to row, no column change\n      2: (0, -1),  # Facing LEFT: no row change, -1 to column\n      3: (1, 0)    # Facing DOWN: +1 to row, no column change\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right (0) -> Up (1) -> Left (2) -> Down (3) -> Right (0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right (0) -> Down (3) -> Left (2) -> Up (1) -> Right (0)\n\n  # Pre-compute the set of all item kinds that block agent movement.\n  # This includes entities that cannot be walked upon (e.g., boundaries, workshops)\n  # and the target primitive itself (agent must stand *adjacent* to it, not on it).\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id) # The primitive itself blocks movement\n  \n  # Convert to a NumPy array for efficient checking using np.any()\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # Initialize Breadth-First Search (BFS) structures:\n  # queue stores ( (agent_position_tuple, agent_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # visited set stores (agent_position_tuple, agent_direction_int) to avoid cycles and re-exploring states\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions_so_far = queue.popleft()\n      r, c = current_pos # Unpack current row and column\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # This is the goal condition for our BFS: agent is adjacent and facing the target.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid bounds before checking its contents.\n      if (0 <= front_r < NUM_ROWS and 0 <= front_c < NUM_COLS):\n          # If the cell directly in front contains the primitive, we've found our target.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions_so_far\n              break # Path to target found, exit BFS\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward (equivalent to 'UP' action for movement)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within grid bounds.\n      if (0 <= next_r < NUM_ROWS and 0 <= next_c < NUM_COLS):\n          # Check if this new (position, direction) state has not been visited before.\n          if (next_pos, next_dir) not in visited:\n              # Check if the `next_pos` is walkable (i.e., does not contain any blocking kinds).\n              # np.any() returns True if any element in the slice is > 0, indicating a blocking item.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n                  # If all checks pass, it's a valid move. Add to visited set and queue.\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions_so_far + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions_so_far + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  # to actually collect the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:16:14.042947", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # EARLY EXIT: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (x)\n      1: (-1, 0),  # Facing UP: -1 to row (y)\n      2: (0, -1),  # Facing LEFT: -1 to column (x)\n      3: (1, 0)    # Facing DOWN: +1 to row (y)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Pre-compute the set of all item kinds that block movement.\n  # This includes inherently non-grabbable entities (like boundaries, water, workshops)\n  # AND the specific primitive we are trying to collect (agent should stand *next to* it, not *on* it).\n  blocking_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids_set.add(primitive_id) # Add the target primitive as a blocking kind for movement\n  blocking_kind_indices = np.array(list(blocking_kind_ids_set), dtype=int)\n\n  # BFS state: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward (equivalent to 'UP' in action_specs for movement)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos contains any blocking kind using the pre-computed array.\n              # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n                  # If all checks pass, it's a valid move. Add to queue.\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:17:34.385786", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses at least one unit of the target item, no collection is needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive is inherently collectible via the 'USE' action.\n  # Items like workshops, boundaries, or fixed terrain features are generally not collected into inventory.\n  # Collectible items include 'grabbable_indices' (e.g., wood, iron, grass, rock, gold, gem),\n  # and specific environmental resources like 'water' and 'stone'.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes and spatial transformations for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps agent direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases col (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases col (moves West)\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference, handling circularity of directions (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive turns in the same direction\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # The queue stores tuples of (CraftState, path_to_reach_this_state).\n  q = collections.deque() \n  \n  # The 'visited' set tracks explored unique states to prevent cycles and redundant work.\n  # A state is uniquely defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory is included because acquiring items (e.g., tools) changes agent capabilities,\n  # leading to distinct reachable states even from the same physical location.\n  visited = set()\n\n  # Prepare the initial state for BFS.\n  # Convert numpy array to tuple for hashability in the 'visited' set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  \n  # Add the initial state and an empty path to the queue.\n  q.append((current_state, []))\n  # Mark the initial state as visited.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and for setting the max explored states.\n  grid_width, grid_height, _ = current_state.grid.shape \n  \n  # MAX_EXPLORED_STATES is a heuristic limit to prevent infinite loops or excessively long searches\n  # in very large or complex state spaces, especially when many inventory variations might be possible.\n  # This value is a multiplier based on the grid size and number of directions, providing a generous limit.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 # Increased multiplier for v2 for deeper exploration\n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest action sequence.\n  while q:\n    # Dequeue the current state and the list of actions (path) taken to reach it.\n    state, path = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit,\n    # return an empty list, indicating failure to find a path within the specified limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return []\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: Can the primitive be collected from the current `state`?\n    # This checks if the target primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all 4 possible agent orientations.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) is valid\n            # and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the actions needed to turn to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turns on a temporary state derived from the current `state`.\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # We only care about the resulting state, not intermediate rewards for pathfinding.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Record inventory *before* attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n                \n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Crucial Verification: Did the primitive count in inventory increase?\n                # This confirms the 'USE' action successfully collected the item,\n                # accounting for game rules (e.g., requiring a tool).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a successful path has been found. Reconstruct and return it.\n                    # The full path includes actions to reach the current state, turns, and the final USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore next possible states by applying all valid actions from the current state.\n    # This includes movement actions and the general 'USE' action (e.g., to pick up tools or craft intermediates).\n    # `USE_ACT` is considered here as a general state transition action, not just the goal action.\n    actions_to_consider = move_actions + [USE_ACT] \n    \n    for action in actions_to_consider:\n        # Simulate the action to get the next state.\n        _, next_state = state.step(action) \n        \n        # Create a unique key for the new state, including its inventory.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # If this new state hasn't been visited, add it to the queue for further exploration.\n        # This prevents redundant work and ensures finding the shortest path.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            # Add the next state and its extended path to the BFS queue.\n            q.append((next_state, path + [action]))\n\n  # 7. If the BFS loop finishes and the queue becomes empty without finding a solution,\n  # it means the target primitive is unreachable from the initial state under the given conditions\n  # and within the exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:17:37.492451", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by slightly increasing the maximum explored states\n  and refining comments for clarity.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state and world configuration.\n        primitive (str): The name of the primitive item (e.g., \"wood\", \"water\", \"stone\") to collect.\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is already in inventory or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access the CraftWorld instance for indices and recipes\n\n  # 1. Map the string name of the primitive to its unique integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Pre-check: If the agent already possesses at least one unit of the target primitive,\n  # no collection actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Validation: Determine if this primitive is designed to be collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable_indices) and specific natural resources\n  # like water or stone, which are typically gathered by 'using' them when adjacent.\n  # Non-collectible entities (e.g., workshops, boundaries, fixed terrain) are filtered out.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    # The target primitive is not something that can be collected using the 'USE' action.\n    # It might be a crafting station, terrain, or an item that needs to be crafted, not collected.\n    return []\n\n  # 4. Define numerical action codes and spatial transformation rules for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps agent direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # Facing Up: row decreases\n      1: (0, 1),  # Facing Right: col increases\n      2: (1, 0),  # Facing Down: row increases\n      3: (0, -1)  # Facing Left: col decreases\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # required to change from the current agent direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction\n      \n      # Calculate the difference in directions, wrapping around the 4 possible directions.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP to DOWN). Two turns in same direction.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # `q`: A deque to store (CraftState, list_of_actions_to_reach_this_state) tuples.\n  q = collections.deque()\n  \n  # `visited`: A set to keep track of explored unique states to prevent cycles and redundant work.\n  # A state is uniquely defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Including the inventory tuple is crucial because agent capabilities (e.g., having a tool)\n  # can change and influence future actions/reachability.\n  visited = set()\n\n  # Prepare the initial state for BFS. The path to the initial state is empty.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # Add the starting state to the queue and mark it as visited.\n  q.append((current_state, []))\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape # Get grid dimensions for boundary checks.\n  \n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in very large state spaces\n  # or in cases where the primitive is effectively unreachable within a reasonable number of steps.\n  # This value has been slightly increased from v1 for potentially deeper exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 70 # Grid positions * directions * inventory variations heuristic\n  explored_states_count = 0\n\n  # 6. BFS Loop: Systematically explore the state space.\n  while q:\n    # Dequeue the current state and the path of actions taken to reach it.\n    state, path = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of distinct states explored exceeds the predefined limit,\n    # terminate the search. This prevents the search from running indefinitely.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return []\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: From the `current_state`, can the target primitive be collected?\n    # This involves checking if the primitive is in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all 4 possible agent orientations to see if any faces the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) is within grid bounds\n            # and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the turning actions needed to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turns on a temporary state derived from the current BFS state.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n                \n                # Simulate the 'USE' action from the correctly oriented temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial Verification: Check if the count of the target primitive in the inventory\n                # increased after the 'USE' action. This confirms actual collection.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collection was successful, a complete path has been found.\n                    # Concatenate the path to `current_state`, the turns, and the final 'USE' action.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Expand the search: Consider all possible actions (movements and a general 'USE')\n    # from the current `state`.\n    \n    # 6a. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the movement.\n      next_inventory_tuple = tuple(next_state.inventory) # Capture inventory for state key.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this resulting state has not been visited before, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Append the action to the current path.\n    \n    # 6b. Explore the general 'USE' action.\n    # This is important if 'USE' can, for example, pick up a tool or change inventory\n    # in a way that enables future collection steps, even if not directly collecting `i_kind`.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action actually resulted in a change of state (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if 'USE' had no effect.\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        # If this new state (after a general 'USE') has not been visited, add it to the queue.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue is empty without finding a solution,\n  # it implies that the target primitive is unreachable from the initial state given the game rules.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:18:34.575379", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses at least one unit of the target item, no collection is needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive is inherently collectible via the 'USE' action.\n  # Items explicitly defined as 'grabbable' (e.g., wood, iron) and specific environmental\n  # resources like 'water' or 'stone' can be gathered into inventory.\n  # Non-collectible items (e.g., workshops, boundaries, fixed terrain) are filtered out here.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not a type that can be collected using the 'USE' action, return an empty path.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes and spatial transformations for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # Define all actions that the agent can perform during the BFS pathfinding.\n  # This includes movement actions and the 'USE' action, which can be for collection,\n  # crafting, or interacting with the environment (e.g., picking up a tool).\n  all_possible_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT, USE_ACT] \n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the grid cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1 (moves North on grid)\n      1: (0, 1),  # RIGHT: col + 1 (moves East on grid)\n      2: (1, 0),  # DOWN: row + 1 (moves South on grid)\n      3: (0, -1)  # LEFT: col - 1 (moves West on grid)\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # required to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # A 180-degree turn can be achieved by two consecutive turns in the same direction.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # The queue stores tuples of (CraftState, path_to_reach_this_state).\n  q = collections.deque() \n  \n  # The 'visited' set tracks explored unique states to prevent cycles and redundant work.\n  # A state is uniquely defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Including inventory is crucial as acquiring items (e.g., tools, intermediate crafts) can\n  # change agent capabilities and unlock new interactions, leading to distinct reachable states.\n  visited = set()\n\n  # Prepare the initial state for BFS.\n  # Convert the numpy inventory array to a tuple for hashability, required for set membership.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  \n  # Add the initial state and an empty path (no actions taken yet) to the queue.\n  q.append((current_state, []))\n  # Mark the initial state as visited.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks during state exploration.\n  grid_width, grid_height, _ = current_state.grid.shape \n  \n  # MAX_EXPLORED_STATES is a heuristic limit to prevent infinite loops or excessively long searches\n  # in very large or complex state spaces. This value is a multiplier based on the grid size\n  # and the number of directions, providing a generous but bounded limit to the search depth.\n  # For collect_v2, the multiplier is set to 25 to allow for deeper exploration compared to collect_v1 (which used 15).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 25 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest action sequence.\n  while q:\n    # Dequeue the current state and the list of actions (path) taken to reach it.\n    state, path = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the heuristic limit,\n    # terminate the search and return an empty list, indicating no path found within limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return []\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: Can the primitive be collected from the current `state`?\n    # First, use `state.next_to` for a quick check if the primitive is within the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all 4 possible agent orientations.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetically turning) is within grid bounds\n            # and specifically contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the exact sequence of actions needed to turn to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions on a temporary state to get the state right before 'USE'.\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # We only care about the resulting state, not intermediate rewards, for pathfinding.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Record the inventory state *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n                \n                # Simulate the 'USE' action from the correctly oriented temporary state.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Crucial Verification: Did the count of the primitive in the inventory actually increase?\n                # This confirms successful collection, accounting for any internal game rules\n                # (e.g., requiring a specific tool or resource availability/depletion).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a successful path has been found. Reconstruct and return it.\n                    # The full path includes actions to reach the current state, necessary turns, and the final USE action.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore next possible states by applying all valid actions from the current state.\n    for action in all_possible_actions:\n        # Simulate the action to get the next state, without applying it to the actual environment.\n        _, next_state = state.step(action) \n        \n        # Create a unique key for the new state, including its position, direction, and inventory.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # If this new state (defined by its unique key) has not been visited before,\n        # add it to the queue for further exploration. This prevents redundant work and cycles.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            # Add the next state and its extended path to the BFS queue.\n            q.append((next_state, path + [action]))\n\n  # 7. If the BFS loop finishes and the queue becomes empty without finding a solution,\n  # it means the target primitive is unreachable from the initial state under the given conditions\n  # and within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:18:36.154387", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses at least one unit of the target item, no collection is needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive is inherently collectible via the 'USE' action.\n  # Items like workshops, boundaries, or fixed terrain features are generally not collected into inventory.\n  # Collectible items include 'grabbable_indices' (e.g., wood, iron, grass, rock, gold, gem),\n  # and specific environmental resources like 'water' and 'stone'.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes and spatial transformations for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n  all_possible_actions = move_actions + [USE_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps agent direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases col (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases col (moves West)\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference, handling circularity of directions (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive turns in the same direction\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # The queue stores tuples of (CraftState, path_to_reach_this_state).\n  q = collections.deque() \n  \n  # The 'visited' set tracks explored unique states to prevent cycles and redundant work.\n  # A state is uniquely defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory is included because acquiring items (e.g., tools) changes agent capabilities,\n  # leading to distinct reachable states even from the same physical location.\n  visited = set()\n\n  # Prepare the initial state for BFS.\n  # Convert numpy array to tuple for hashability in the 'visited' set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  \n  # Add the initial state and an empty path to the queue.\n  q.append((current_state, []))\n  # Mark the initial state as visited.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and for setting the max explored states.\n  grid_width, grid_height, _ = current_state.grid.shape \n  \n  # MAX_EXPLORED_STATES is a heuristic limit to prevent infinite loops or excessively long searches\n  # in very large or complex state spaces, especially when many inventory variations might be possible.\n  # This value is a multiplier based on the grid size and number of directions, providing a generous limit.\n  # Increased multiplier from 15 (v1) to 20 for v2 for even deeper exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest action sequence.\n  while q:\n    # Dequeue the current state and the list of actions (path) taken to reach it.\n    state, path = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit,\n    # return an empty list, indicating failure to find a path within the specified limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return []\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: Can the primitive be collected from the current `state`?\n    # This checks if the target primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all 4 possible agent orientations.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) is valid\n            # and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the actions needed to turn to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turns on a temporary state derived from the current `state`.\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # We only care about the resulting state, not intermediate rewards for pathfinding.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Record inventory *before* attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n                \n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Crucial Verification: Did the primitive count in inventory increase?\n                # This confirms the 'USE' action successfully collected the item,\n                # accounting for game rules (e.g., requiring a tool).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a successful path has been found. Reconstruct and return it.\n                    # The full path includes actions to reach the current state, turns, and the final USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore next possible states by applying all valid actions from the current state.\n    for action in all_possible_actions:\n        # Simulate the action to get the next state.\n        _, next_state = state.step(action) \n        \n        # Create a unique key for the new state, including its inventory.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # If this new state hasn't been visited, add it to the queue for further exploration.\n        # This prevents redundant work and ensures finding the shortest path.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            # Add the next state and its extended path to the BFS queue.\n            q.append((next_state, path + [action]))\n\n  # 7. If the BFS loop finishes and the queue becomes empty without finding a solution,\n  # it means the target primitive is unreachable from the initial state under the given conditions\n  # and within the exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:20:25.138187", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limits excessive computation.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Improvement in v2: If we've explored too many distinct states,\n    # terminate the search immediately and return an empty path,\n    # indicating no path was found within the allowed computational budget.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Hard limit: search failed within budget\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:20:26.676680", "function_name": "collect", "function_body": "  \"\"\"Finds a sequence of actions to collect a specified primitive item in the environment.\n\n  This function uses a Breadth-First Search (BFS) algorithm to explore the\n  state space, considering the agent's position, direction, and crucially, its\n  inventory. The inventory is part of the state in the BFS because acquiring\n  certain items (e.g., tools) might be necessary to collect other primitives.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance.\n      primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"stone\").\n\n  Returns:\n      List[int]: A list of action indices (integers) that, when executed,\n                 should lead to the agent successfully collecting at least one\n                 unit of the specified primitive. Returns an empty list if\n                 the primitive is already collected or if no path is found.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access the CraftWorld configuration for indices and recipes\n\n  # 1. Map the primitive name to its integer ID.\n  # This is the first step to ensure we're looking for a known entity in the game.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed, satisfying the goal immediately.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally \"collectible\" via the 'USE' action.\n  # Not all entities in the game are meant to be picked up or harvested (e.g., workshops, boundaries).\n  # This heuristic significantly prunes the search space by avoiding attempts to collect\n  # non-grabbable environment features. Only items in `grabbable_indices` or specific\n  # resources like water/stone are typically collectible this way.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  if not is_collectible_via_use:\n    # If it's not a type of item meant to be collected by 'USE', no path exists through this function.\n    return []\n\n  # 4. Define action constants and utility mappings.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # Facing UP: row - 1\n      1: (0, 1),  # Facing RIGHT: col + 1\n      2: (1, 0),  # Facing DOWN: row + 1\n      3: (0, -1)  # Facing LEFT: col - 1\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already correctly oriented\n\n      # Calculate the minimal number of turns (1 or 2) considering circularity (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # One clockwise turn (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two successive RIGHT turns\n\n  # 5. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: (CraftState object, list of actions taken to reach this state).\n  q = collections.deque()\n  # The 'visited' set stores hashable representations of states to prevent cycles and\n  # redundant exploration. A state must include position, direction, AND inventory,\n  # as inventory changes (e.g., acquiring a tool) can unlock new interactions or paths.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Set a heuristic limit for the number of explored states to prevent excessive computation\n  # in very large or complex environments where a path might not exist or be extremely long.\n  # The factor '10' is an arbitrary multiplier to allow for some variations in inventory states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10\n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer until the goal is met or the queue is exhausted.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its path\n    explored_states_count += 1\n\n    # Pruning: If the search has explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Skip expanding this branch, but continue processing other queued states.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: If the primitive is within the 3x3 neighborhood of the agent,\n    # attempt to collect it directly from this state.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to precisely locate the primitive.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after simulated turns) is within grid bounds\n            # AND contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                # Simulate applying the turning actions to get the intermediate state after turning.\n                for turn_action in turns_to_face:\n                    # Reward from turning is typically 0.0; we only care about the new state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state before attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the state where the agent is facing the primitive.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Did the 'USE' action *actually* increase the primitive's count\n                # in the inventory? This accounts for game mechanics where 'USE' might fail\n                # (e.g., missing a required tool) or interact with something else,\n                # ensuring we only return a path that leads to successful collection.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Goal achieved! Return the complete action sequence.\n\n    # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Add new, unvisited states to the queue for further exploration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Additionally, explore the 'USE' action from the current position, even if not directly\n    # facing the target primitive. This is crucial for scenarios where 'USE' might pick up\n    # an intermediate item (like a tool at the agent's feet) or interact with an object\n    # (e.g., a workshop) that changes the inventory and enables future collection of the target primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n\n    # Only add the state resulting from 'USE' if it genuinely changed something\n    # (inventory, position, or direction). This avoids adding redundant states to the BFS queue\n    # if the 'USE' action had no effect in the current context.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable under the current conditions and search limits.\n  return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:21:59.907868", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest sequence of actions to\n  navigate the agent to a position adjacent to the specified primitive and then\n  collect it using the 'USE' action.\n  \n  This implementation uses a Breadth-First Search (BFS) to find the optimal\n  (shortest) path considering agent movement (forward, turn left, turn right)\n  and environmental constraints (non-walkable terrain).\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state of the environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs to be executed by the environment.\n                   Returns an empty list if the primitive is already in inventory\n                   or if no path to collect the primitive is found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, column) tuple\n  initial_dir = current_state.dir  # Agent's starting facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']      # Moving \"UP\" implies moving forward relative to agent's direction\n  TURN_LEFT_ACTION = action_map['LEFT']       # Turning left\n  TURN_RIGHT_ACTION = action_map['RIGHT']     # Turning right\n  USE_ACTION = action_map['USE']              # Interact with object in front\n\n  # Define changes in (row, col) for each direction (0:R, 1:U, 2:L, 3:D)\n  # This mapping is crucial for calculating the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Determine all entity kinds that the agent cannot walk *onto*.\n  # This includes non-grabbable environment entities (like walls, water, workshops)\n  # and the primitive itself, as the agent must stand *adjacent* to it, not on it, to collect.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array for efficient checking on the grid using np.any\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores tuples of ( (agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (agent_position_tuple, agent_direction_int) to prevent cycles\n  # and re-processing states, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action sequence leading to the state\n                              # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a grid cell is valid for agent movement.\n  # This function is nested to easily access `initial_grid`, `non_walkable_for_movement_array`, etc.\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain non-walkable items.\"\"\"\n      # Check if cell is out of bounds\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # Check if the cell contains any non-walkable entity.\n      # `np.any` returns True if any element along the last axis (kinds) for the given\n      # non_walkable_for_movement_array indices is greater than 0.\n      if non_walkable_for_movement_array.size > 0 and \\\n         np.any(initial_grid[r, c, non_walkable_for_movement_array] > 0):\n          return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the target primitive is directly in front of the agent at the current state.\n      # If so, we've found a path to be adjacent and facing the primitive, so we can use it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid bounds and contains the primitive.\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_actions = path_to_current_state\n          break # BFS guarantees this is the shortest path to this condition.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n      \n      # Attempt to Move Forward (equivalent to 'UP' action)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction doesn't change on forward movement\n\n      if (next_pos, next_dir_after_move) not in visited:\n          if _is_cell_walkable(next_r, next_c):\n              visited.add((next_pos, next_dir_after_move))\n              queue.append(((next_pos, next_dir_after_move), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left ('LEFT' action)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right ('RIGHT' action)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found that brings the agent adjacent to and facing the primitive,\n  # append the 'USE' action to actually collect it.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:22:01.042815", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using BFS to find the shortest path to collect a primitive.\n\n    Improvements over v1 are minor, focusing on clarity, minor robustness checks,\n    and ensuring all necessary parameters for helper functions are explicitly passed.\n    The core BFS logic remains the same as it is already optimal for shortest path.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect.\n\n    Returns:\n        List[int]: A sequence of integer action codes (e.g., UP, LEFT, USE) to navigate\n                   to and collect the specified primitive. Returns an empty list if\n                   the primitive is already in inventory or is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  # This will raise a KeyError if `primitive` is not a known item, which is desired.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Map symbolic actions from action_specs to their integer indices for easier use.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down).\n  # This mapping is crucial for calculating the next position when moving forward\n  # and determining the cell directly in front of the agent for interaction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Define how the agent's direction changes when performing a 'TURN_LEFT' or 'TURN_RIGHT' action.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Determine all entity kinds that the agent cannot walk *onto*.\n  # This set typically includes boundaries, water, workshops, and importantly,\n  # the primitive resource nodes themselves (e.g., a tree, a rock) which you stand adjacent to.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert this set to a NumPy array for efficient checking against the grid's kind dimension.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n  # Helper nested function to determine if a given grid cell is traversable by the agent.\n  # This helps encapsulate the logic and keep the main BFS loop cleaner.\n  def _is_cell_traversable(r, c, grid, non_walkable_ids_array, grid_width, grid_height):\n      \"\"\"\n      Checks if the cell at (r, c) is within grid bounds and does not contain any\n      non-traversable entity kinds.\n      \"\"\"\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False # Outside grid, thus not traversable.\n      \n      # Check if the cell contains any entity kind that blocks movement.\n      # np.any is efficient here, checking if any `kind` at (r,c) is in `non_walkable_ids_array`\n      # and has a count greater than 0.\n      if non_walkable_ids_array.size > 0 and np.any(grid[r, c, non_walkable_ids_array] > 0):\n          return False # Contains a non-traversable item.\n      return True\n\n  # Initialize BFS structures:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (current_position_tuple, current_direction_int) to prevent cycles and redundant paths.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Begin Breadth-First Search\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos # Unpack current row and column.\n\n      # 1. Immediate Goal Check: Is the primitive directly in front of the agent from the current state?\n      # Calculate the coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the \"front\" cell is within grid bounds AND contains the target primitive.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state # We found the path!\n          break # Exit the BFS loop as the shortest path is found.\n\n      # 2. Explore Possible Next Actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is valid (traversable) and the (pos, dir) state hasn't been visited.\n      if (next_pos, next_dir) not in visited:\n          if _is_cell_traversable(next_r, next_c, initial_grid, non_walkable_for_movement_array, WIDTH, HEIGHT):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a `target_path` was found, it means the agent can reach a position\n  # where the primitive is directly in front. We then append the USE_ACTION.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n  # If no path was found (target_path is still None), actions_list remains empty,\n  # which correctly indicates the primitive is unreachable.\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:22:41.662306", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Uses BFS to find the primitive and collect it.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Grid dimensions\n  NUM_ROWS, NUM_COLS, _ = initial_grid.shape\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define what constitutes \"non-walkable\" terrain for agent movement.\n  # This includes entities that cannot be picked up (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # and the primitive itself (agent must be adjacent to it, not on it, to USE).\n  non_walkable_kind_ids = list(current_state.world.non_grabbable_indices | {primitive_id})\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores ( (state_tuple), list_of_actions_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state_tuple) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the action sequence leading to the state\n                              # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < NUM_ROWS and 0 <= front_c < NUM_COLS and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path_actions = path_actions\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_r + move_dr, current_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (0 <= next_r < NUM_ROWS and 0 <= next_c < NUM_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next position is walkable (i.e., does not contain any non_walkable_kind_ids)\n          # Using NumPy's any() for efficient check across multiple channels\n          is_walkable = not np.any(initial_grid[next_r, next_c, non_walkable_kind_ids] > 0)\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:22:42.892757", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  blocking_kinds_for_movement = set(current_state.world.non_grabbable_indices)\n  blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert to a list for efficient NumPy indexing\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # Helper function to check if a cell is walkable using NumPy for efficiency\n  def _is_cell_walkable(r, c, grid, rows, cols, blocking_kinds_list):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain blocking items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any blocking item exists in this cell using NumPy's any\n      # grid[r, c, blocking_kinds_list] will select the channels corresponding to blocking kinds.\n      # ( > 0 ) checks if any of these kinds are present at the cell.\n      if np.any(grid[r, c, blocking_kinds_list] > 0):\n          return False # Contains a blocking item\n      return True\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing grid dimensions and combined blocking kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, num_rows, num_cols, blocking_kinds_for_movement_list):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:23:17.359487", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # (row, col)\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (dr, dc) = (0, 1) - column increases\n      1: (-1, 0),  # Facing UP: (dr, dc) = (-1, 0) - row decreases\n      2: (0, -1),  # Facing LEFT: (dr, dc) = (0, -1) - column decreases\n      3: (1, 0)    # Facing DOWN: (dr, dc) = (1, 0) - row increases\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r_coord, c_coord) is walkable.\n  # A cell is not walkable if it's out of bounds, contains a non-grabbable entity,\n  # or contains the target primitive itself (agent must be adjacent to use it).\n  def _is_walkable_cell(r_coord: int, c_coord: int) -> bool:\n      # Check grid boundaries\n      if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n          return False\n      \n      # Check if cell contains any entity that blocks movement (e.g., boundary, water)\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r_coord, c_coord, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk onto the primitive it wants to collect.\n      # It must be adjacent to the primitive to perform the 'USE' action.\n      if initial_grid[r_coord, c_coord, primitive_id] > 0:\n          return False\n\n      return True\n\n  # BFS queue: stores ((current_r, current_c), current_dir), list_of_actions_to_reach_here\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (current_pos_tuple, current_dir_int) to prevent redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None # To store the path of actions once the target is found\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the target condition:\n      # The target primitive must be directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Option A: Try Moving Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      # Check if the potential next position is walkable and not visited\n      if _is_walkable_cell(next_r, next_c):\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              visited.add((next_pos_after_move, next_dir_after_move))\n              queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Option B: Try Turning Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Option C: Try Turning Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # append the USE action to the sequence.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:23:18.539913", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # (row, col)\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  # This helps determine the cell in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (dr, dc) = (0, 1) - column increases\n      1: (-1, 0),  # Facing UP: (dr, dc) = (-1, 0) - row decreases\n      2: (0, -1),  # Facing LEFT: (dr, dc) = (0, -1) - column decreases\n      3: (1, 0)    # Facing DOWN: (dr, dc) = (1, 0) - row increases\n  }\n\n  # Maps for updating direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a cell at (r, c) is traversable by the agent.\n  # A cell is traversable if it's within bounds and does not contain blocking entities,\n  # nor the target primitive itself (agent must be adjacent to use it).\n  def is_traversable(r_coord, c_coord):\n      # Check grid boundaries\n      if not (0 <= r_coord < WIDTH and 0 <= c_coord < HEIGHT):\n          return False\n      \n      # Check for any non-grabbable items that inherently block movement\n      for kind_idx in non_walkable_kind_ids:\n          if initial_grid[r_coord, c_coord, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive it wants to collect; it must be adjacent to use it.\n      if initial_grid[r_coord, c_coord, primitive_id] > 0:\n          return False\n\n      return True\n\n  # BFS queue: stores ((current_r, current_c), current_dir), list_of_actions_to_reach_here\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (current_pos_tuple, current_dir_int) to prevent redundant exploration\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_adjacent_primitive = None # To store the shortest path of actions\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the target condition:\n      # The target primitive must be directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell directly in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # --- Option A: Try Moving Forward ---\n      next_r, next_c = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_after_move = (next_r, next_c)\n      next_dir_after_move = current_dir # Direction does not change when moving forward\n\n      if is_traversable(next_r, next_c):\n          if (next_pos_after_move, next_dir_after_move) not in visited:\n              visited.add((next_pos_after_move, next_dir_after_move))\n              queue.append(((next_pos_after_move, next_dir_after_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Option B: Try Turning Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Option C: Try Turning Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # append the USE action to the sequence.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:24:19.662387", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version implements a Breadth-First Search (BFS) to find the shortest\n    sequence of movement and turn actions to position the agent directly adjacent\n    to the target primitive, facing it. Once in position, a 'USE' action is appended.\n    It handles cases where the primitive is not collectible.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute. Returns an empty list\n                   if the primitive is not grabbable or unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  # This will raise a KeyError if the primitive string is invalid, which is desired behavior\n  # as per the problem description's implicit assumption that DSL inputs are valid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Essential Pre-check: Determine if the target primitive is actually collectible.\n  # Items are 'collectible' if they are in the 'grabbable_indices' list.\n  # Non-grabbable items (like BOUNDARY, WATER, WORKSHOPs) cannot be collected with 'USE'.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive cannot be picked up, no actions can lead to its collection.\n      return []\n\n  # Retrieve critical environment state information for BFS\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Grid dimensions (WIDTH, HEIGHT)\n\n  # Map DSL action names to their numerical IDs from the environment's action specifications.\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define movement deltas for each direction: (delta_row, delta_column)\n  # (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DELTA_POS = {\n      0: (0, 1),   # Right: +1 column\n      1: (-1, 0),  # Up: -1 row\n      2: (0, -1),  # Left: -1 column\n      3: (1, 0)    # Down: +1 row\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_NEXT_DIR = {0: 1, 1: 2, 2: 3, 3: 0}   # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_NEXT_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define cells that the agent cannot walk *onto*. This includes non-grabbable\n  # entities (like walls, water, workshops) and the primitive itself, as the\n  # agent needs to be *adjacent* to it to use/collect it, not on top of it.\n  non_walkable_indices_set = current_state.world.non_grabbable_indices.union({primitive_id})\n  # Convert to a list for efficient NumPy array indexing.\n  non_walkable_indices = list(non_walkable_indices_set)\n\n  # BFS state: ((current_row, current_col), current_direction), list_of_actions_taken\n  bfs_queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_position, agent_direction).\n  visited_states = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence to reach a collectible state.\n  path_to_collection_point = None \n\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the agent is currently positioned to 'USE' the primitive:\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DELTA_POS[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # 1. Check if the cell directly in front is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # 2. Check if the primitive is present in that front cell (count > 0)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_collection_point = current_path_actions\n              break # Found the shortest path to a position from which the primitive can be collected.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # --- Try moving forward ---\n      move_dr, move_dc = DIR_TO_DELTA_POS[current_dir]\n      next_r, next_c = current_r + move_dr, current_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check validity for moving forward:\n      # 1. Next position is within grid bounds.\n      # 2. The (next_pos, next_dir) state has not been visited before.\n      # 3. The next position is walkable (i.e., does not contain any non-walkable entities).\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir_after_move) not in visited_states):\n          \n          # Check if any non-walkable kind is present at the next position.\n          # np.any returns True if any element in the specified slice is True (i.e., count > 0).\n          if not np.any(initial_grid[next_r, next_c, non_walkable_indices] > 0):\n              visited_states.add((next_pos, next_dir_after_move))\n              bfs_queue.append(((next_pos, next_dir_after_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # --- Try turning left ---\n      next_dir_left = TURN_LEFT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append(((current_pos, next_dir_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # --- Try turning right ---\n      next_dir_right = TURN_RIGHT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append(((current_pos, next_dir_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # If a path was found that positions the agent correctly, append the 'USE' action.\n  if path_to_collection_point is not None:\n      actions_list.extend(path_to_collection_point)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:24:20.865194", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` for finding and collecting a primitive item.\n\n  This function uses a Breadth-First Search (BFS) to find the shortest sequence\n  of actions (moves and turns) to position the agent adjacent to the target\n  primitive and facing it, then appends a 'USE' action to collect it.\n\n  Args:\n      env (env.CraftLab): The CraftLab object representing the current game environment.\n      primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"IRON\").\n\n  Returns:\n      List[int]: A sequence of integer action IDs (from env.action_specs())\n                 required to find and collect the specified primitive.\n                 Returns an empty list if the primitive is not grabbable or unreachable.\n  \"\"\"\n  actions_list = []\n  # Access the current state of the environment through the CraftLab wrapper\n  current_state = env._current_state \n  \n  # Map the string primitive name to its integer ID using the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Pre-check: Determine if the target primitive is actually collectible (grabbable).\n  # Items like BOUNDARY, WATER, STONE, and WORKSHOPS are fixed environmental features\n  # and cannot be picked up using the 'USE' action. If the primitive is not grabbable,\n  # no collection actions can be performed, so an empty list is returned immediately.\n  if primitive_id not in current_state.world.grabbable_indices:\n      # If the primitive is not something that can be 'picked up', return an empty path.\n      return []\n\n  # Extract initial state information for pathfinding\n  initial_grid = current_state.grid # The current layout of the world\n  initial_agent_pos = current_state.pos # Agent's starting (row, col) position\n  initial_agent_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape # Get dimensions of the grid\n\n  # Map DSL actions (semantic names) to their corresponding integer indices\n  # as defined by the environment's action_specs.\n  action_specs = env.action_specs()\n  ACTION_MOVE_FORWARD = action_specs['UP']    # In Craft, 'UP' means moving forward relative to agent's direction.\n  ACTION_TURN_LEFT = action_specs['LEFT']\n  ACTION_TURN_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define changes in (row, col) coordinates for movement based on current facing direction.\n  # This mapping simplifies calculating the next position after a 'MOVE_FORWARD' action.\n  # (dr, dc) = (delta_row, delta_column)\n  DIRECTION_TO_DELTA_POS = {\n      0: (0, 1),   # Facing RIGHT (0): moving forward increases column (col + 1)\n      1: (-1, 0),  # Facing UP (1): moving forward decreases row (row - 1)\n      2: (0, -1),  # Facing LEFT (2): moving forward decreases column (col - 1)\n      3: (1, 0)    # Facing DOWN (3): moving forward increases row (row + 1)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # These are cyclical mappings (0->1->2->3->0 for left, 0->3->2->1->0 for right).\n  TURN_LEFT_NEXT_DIR = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_NEXT_DIR = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all grid entity indices that block agent movement.\n  # This set includes non-grabbable items (e.g., boundaries, water, workshops)\n  # and crucially, the target `primitive_id` itself. The agent cannot move onto\n  # a square containing the item it intends to 'USE'; it must be adjacent to it.\n  # We convert to a list for efficient NumPy advanced indexing later.\n  non_walkable_kind_ids = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # Breadth-First Search (BFS) for the shortest path to a collectible state.\n  # The BFS queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent\n  # redundant exploration and infinite loops (cycles) in the search.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # Variable to store the action sequence once the target state\n  # (agent is adjacent to and facing the primitive) is found.\n  shortest_path_to_primitive = None \n\n  while bfs_queue:\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_row, current_col = current_pos\n\n      # Check if the agent is currently positioned to 'USE' the primitive:\n      # This means the primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_TO_DELTA_POS[current_dir]\n      cell_in_front_row, cell_in_front_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= cell_in_front_row < GRID_WIDTH and 0 <= cell_in_front_col < GRID_HEIGHT):\n          # Check if the primitive is present in the cell directly in front (indicated by a count > 0)\n          if initial_grid[cell_in_front_row, cell_in_front_col, primitive_id] > 0:\n              shortest_path_to_primitive = current_path_actions\n              break # Shortest path to a 'collectible' position found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try moving forward\n      # Calculate the next position after moving forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_POS[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_position = (next_row, next_col)\n      next_direction_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check validity of the next state:\n      # a. Within grid boundaries\n      # b. This (position, direction) state has not been visited before\n      if (0 <= next_row < GRID_WIDTH and 0 <= next_col < GRID_HEIGHT and\n          (next_position, next_direction_after_move) not in visited_states):\n          \n          # c. Check if the next position is walkable (i.e., it does not contain any blocking entities).\n          # np.any returns True if any of the specified blocking kinds are present at (next_row, next_col).\n          if not np.any(initial_grid[next_row, next_col, non_walkable_kind_ids] > 0):\n              visited_states.add((next_position, next_direction_after_move))\n              bfs_queue.append(((next_position, next_direction_after_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # 2. Try turning left\n      next_direction_left = TURN_LEFT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_direction_left) not in visited_states):\n          visited_states.add((current_pos, next_direction_left))\n          bfs_queue.append(((current_pos, next_direction_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # 3. Try turning right\n      next_direction_right = TURN_RIGHT_NEXT_DIR[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_direction_right) not in visited_states):\n          visited_states.add((current_pos, next_direction_right))\n          bfs_queue.append(((current_pos, next_direction_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # If a path was successfully found to a position where the agent can 'USE' the primitive,\n  # append the 'USE' action to the sequence to complete the collection process.\n  if shortest_path_to_primitive is not None:\n      actions_list.extend(shortest_path_to_primitive)\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:25:42.352745", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the string `primitive` name to its integer ID used in the game.\n  try:\n    primitive_kind_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the world's index, it's an invalid target.\n    # Return an empty list, as it cannot be collected.\n    return []\n\n  # 2. Check if the target primitive is already present in the agent's inventory.\n  # If it is, the goal is already satisfied, so no actions are needed.\n  if current_state.inventory[primitive_kind_id] > 0:\n      return []\n\n  # 3. Determine if this primitive is designed to be \"collected\" via the 'USE' action.\n  # Collectible items typically include grabbable objects (e.g., tools, crafted items)\n  # and specific environmental resources (e.g., water, stone) that can be gathered.\n  # Items like workshops, boundaries, or bridges are generally not picked up into inventory.\n  is_collectible_via_use = (\n      primitive_kind_id in world.grabbable_indices or \n      primitive_kind_id == world.water_index or \n      primitive_kind_id == world.stone_index\n  )\n  \n  # If the target primitive is not designed to be collected via 'USE', we cannot fulfill this request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Extract action integer IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACTION = action_map[\"UP\"]\n  DOWN_ACTION = action_map[\"DOWN\"]\n  LEFT_ACTION = action_map[\"LEFT\"]\n  RIGHT_ACTION = action_map[\"RIGHT\"]\n  USE_ACTION = action_map[\"USE\"]\n\n  # Group basic movement actions for easier iteration.\n  movement_actions = [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n  # Mapping from agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to (row_change, col_change) for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases (North)\n      1: (0, 1),  # RIGHT: col increases (East)\n      2: (1, 0),  # DOWN: row increases (South)\n      3: (0, -1)  # LEFT: col decreases (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns required to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the target direction\n\n      # Calculate the difference between current and target directions.\n      # Adding 4 and taking modulo 4 handles circularity (0-3) and ensures a positive result.\n      direction_diff = (target_dir - current_dir + 4) % 4\n      \n      if direction_diff == 1: # Target is one step clockwise (e.g., from UP (0) to RIGHT (1))\n          return [RIGHT_ACTION]\n      elif direction_diff == 3: # Target is one step counter-clockwise (e.g., from UP (0) to LEFT (3))\n          return [LEFT_ACTION]\n      else: # direction_diff == 2, implying a 180-degree turn (e.g., from UP (0) to DOWN (2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACTION, RIGHT_ACTION] # Arbitrarily use two RIGHT_ACTIONs\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue to store (CraftState, list of actions taken to reach this state)\n  \n  # Set to keep track of visited states to prevent redundant exploration and infinite loops.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Including inventory is crucial as agent capabilities (e.g., holding a tool) change state.\n  visited_states = set()\n\n  # Add the initial environment state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory) # Convert numpy array to tuple for hashability\n  q.append((current_state, []))\n  visited_states.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and for setting an exploration limit.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit on the number of distinct (pos, dir, inventory) states to explore.\n  # This prevents the BFS from running indefinitely in very large or complex scenarios,\n  # especially if many unique inventory combinations are possible.\n  # Multiplier of 20 allows for deeper exploration than standard (pos,dir) space.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_count = 0\n\n  # 6. Main BFS Loop: Continues until the queue is empty or the primitive is collected.\n  while q:\n    current_sim_state, current_path_actions = q.popleft() # Dequeue the current state and its path\n    explored_count += 1\n\n    # Pruning: If the number of explored states exceeds the limit, stop further expansion from this branch.\n    if explored_count > MAX_EXPLORED_STATES:\n      continue \n\n    agent_row, agent_col = current_sim_state.pos\n    agent_direction = current_sim_state.dir\n    \n    # --- Goal Check: Can we collect the target primitive from this `current_sim_state`? ---\n    # Check if the target primitive is located in the agent's 3x3 neighborhood.\n    if current_sim_state.next_to(primitive_kind_id):\n        # If it is, iterate through all four possible facing directions (UP, RIGHT, DOWN, LEFT)\n        # to see if the agent can directly face and then 'USE' the primitive.\n        for potential_target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[potential_target_dir]\n            # Calculate the coordinates of the cell directly in front of the agent if facing `potential_target_dir`.\n            cell_in_front_r, cell_in_front_c = agent_row + dr, agent_col + dc\n\n            # Check if this cell is within grid boundaries AND contains the target primitive.\n            if (0 <= cell_in_front_r < grid_width and 0 <= cell_in_front_c < grid_height and \n                current_sim_state.grid[cell_in_front_r, cell_in_front_c, primitive_kind_id] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                turns_needed = _get_turning_actions(agent_direction, potential_target_dir)\n                \n                # Create a temporary state by applying the turns to the current BFS state.\n                temp_state_after_turns = current_sim_state \n                for turn_action in turns_needed:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record the inventory *before* attempting the USE action. This is vital\n                # to verify that the USE action successfully increased the primitive's count.\n                inventory_before_use_attempt = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the state after turning.\n                _, state_after_use_attempt = temp_state_after_turns.step(USE_ACTION)\n\n                # Verify collection success: The count of the primitive in inventory must have increased.\n                # This accounts for any underlying game mechanics (e.g., needing a tool) handled by CraftState.step.\n                if state_after_use_attempt.inventory[primitive_kind_id] > inventory_before_use_attempt[primitive_kind_id]:\n                    # Path found! Return the accumulated path plus the turning actions and the final USE action.\n                    return current_path_actions + turns_needed + [USE_ACTION]\n\n    # --- State Exploration: Expand to neighboring states ---\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in movement_actions:\n      _, next_sim_state = current_sim_state.step(action)\n      # Convert next state's inventory to a tuple for hashability in the visited set.\n      next_inventory_tuple = tuple(next_sim_state.inventory) \n      next_state_key = (next_sim_state.pos[0], next_sim_state.pos[1], next_sim_state.dir, next_inventory_tuple)\n\n      # If this new state hasn't been visited, add it to the queue and mark as visited.\n      if next_state_key not in visited_states:\n        visited_states.add(next_state_key)\n        q.append((next_sim_state, current_path_actions + [action]))\n    \n    # Separately explore the 'USE' action from the current position.\n    # This is important if using an item at the current location changes the inventory\n    # (e.g., picking up a tool, crafting an intermediate item) which might enable future collection\n    # of the target primitive, even if 'USE' doesn't directly collect the target primitive itself.\n    inventory_at_current_state = np.copy(current_sim_state.inventory)\n    _, state_after_current_use_action = current_sim_state.step(USE_ACTION)\n    \n    # Only add the state resulting from 'USE' if it actually changed meaningfully.\n    # This avoids redundant exploration if 'USE' had no effect (e.g., using nothing important).\n    if not (np.array_equal(state_after_current_use_action.inventory, inventory_at_current_state) and\n            state_after_current_use_action.pos == current_sim_state.pos and\n            state_after_current_use_action.dir == current_sim_state.dir):\n\n        next_inventory_tuple_after_use = tuple(state_after_current_use_action.inventory)\n        next_state_key_after_use = (state_after_current_use_action.pos[0], state_after_current_use_action.pos[1], state_after_current_use_action.dir, next_inventory_tuple_after_use)\n\n        # Add the 'USE' state to the queue if it's a new, meaningful state.\n        if next_state_key_after_use not in visited_states:\n            visited_states.add(next_state_key_after_use)\n            q.append((state_after_current_use_action, current_path_actions + [USE_ACTION]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current environment\n  # conditions within the defined exploration limit.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:25:44.091972", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  This function implements a Breadth-First Search (BFS) to find the shortest\n  sequence of actions (movements and 'USE') required to collect a specified\n  primitive item into the agent's inventory. The search considers changes\n  in the agent's position, direction, and crucially, its inventory, as\n  acquiring certain items (like tools) might enable collection of others.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The name of the primitive resource to collect (e.g., \"wood\", \"stone\", \"water\").\n\n    Returns:\n        List[int]: A list of integer action codes representing the sequence\n                   of steps to collect the primitive. Returns an empty list\n                   if the primitive is already collected, is not collectible\n                   via 'USE', or is unreachable within the search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to CraftWorld instance for cookbook, indices etc.\n\n  # 1. Map the primitive name (string) to its integer ID.\n  # The cookbook's index stores these mappings.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the world's cookbook,\n    # it's an invalid target for collection.\n    return []\n\n  # 2. Early Exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no further actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is logically \"collectible\" via the 'USE' action.\n  # This typically includes grabbable items (e.g., crafted components, tools)\n  # and specific environmental resources that can be directly gathered (like water or stone).\n  # Non-collectible entities (e.g., workshops, boundaries, non-interactive elements)\n  # should not be targeted by this function.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target primitive cannot be collected via the 'USE' action,\n  # we cannot fulfill this request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integer IDs and directional mappings for agent movement.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's internal direction integer\n  # (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT) to the (row_change, col_change)\n  # needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases (moves North)\n      1: (0, 1),  # RIGHT: col increases (moves East)\n      2: (1, 0),  # DOWN: row increases (moves South)\n      3: (0, -1)  # LEFT: col decreases (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turns required\n  # for the agent to change its current facing direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the target direction.\n      \n      # Calculate the difference in directions (0-3), handling circularity.\n      # Adding 4 and taking modulo 4 ensures the result is positive and correct.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., from UP (0) to RIGHT (1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., from UP (0) to LEFT (3))\n          return [LEFT_ACT]\n      else: # diff == 2, signifies a 180-degree turn (e.g., from UP (0) to DOWN (2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily use two RIGHT_ACTs for 180-turn.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue for BFS: stores (CraftState, list_of_actions_to_reach_state)\n  \n  # 'visited' set keeps track of states already explored to prevent cycles and redundant work.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Including inventory in the state key is crucial because possessing different items\n  # (e.g., tools) changes the actions that are possible or effective, making it a distinct state.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit on the number of states to explore. This prevents infinite loops\n  # in very large or complex scenarios and bounds computation time. The factor of 20\n  # allows for significant exploration, accounting for diverse inventory states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the primitive is successfully collected.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it.\n    explored_states_count += 1\n\n    # Pruning: If the search has explored too many states, abort this branch\n    # to avoid excessive computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check ---\n    # Check if the target primitive is within the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations.\n        # This is to determine if facing a particular direction allows direct interaction.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (if agent faces `target_dir`)\n            # is within grid bounds AND contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start from the current BFS state.\n                for turn_action in turns_to_face:\n                    # Apply each turn action to update the temporary state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Capture the agent's inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying if the 'USE' action successfully collected the item.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. CraftState.step handles internal logic\n                # like requiring specific tools (e.g., axe for wood).\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Verify collection: The count of the primitive in the inventory\n                # must have increased for the collection to be considered successful.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Path found! Return the sequence of actions: BFS path + turns + USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- State Exploration ---\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the action to get the next state.\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory for hashability.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state has not been visited before (considering inventory),\n      # add it to the visited set and the BFS queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Also explore the 'USE' action from the current position generally.\n    # This is vital because 'USE' might pick up a tool (e.g., an axe) that changes\n    # the agent's capabilities, even if it doesn't directly collect the target primitive.\n    # Such inventory changes can open up new paths or enable future collections.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from 'USE' if it actually changed the state meaningfully.\n    # This prevents adding redundant states to the queue if 'USE' had no effect (e.g.,\n    # using nothing, or failing to use due to missing tools/object).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # If this 'USE'-resultant state is new, add it to visited and the queue.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop finishes and no path was found (i.e., the queue is empty),\n  # it means the primitive is unreachable from the initial state under the\n  # current game conditions and within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:26:59.962395", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function uses Breadth-First Search (BFS) to find the shortest path for the agent\n    to reach a position adjacent to the target primitive and face it. Once such a position\n    is reached, a 'USE' action is appended to the action sequence to perform the collection.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance, providing access to\n                            the current game state (grid, agent position, inventory, etc.).\n        primitive (str): The string name of the primitive resource to be collected\n                         (e.g., \"WOOD\", \"STONE\", \"WATER\").\n\n    Returns:\n        List[int]: A sequence of integer action codes (e.g., UP, LEFT, USE)\n                   that the agent should execute. Returns an empty list if the\n                   primitive is not found, or is unreachable.\n  \"\"\"\n  actions_list = [] # This list will accumulate the actions to be returned.\n  \n  # Access the current state of the environment. This object holds all dynamic\n  # information like the current grid, agent's position, direction, and inventory.\n  current_state = env._current_state \n\n  # Extract static and dynamic information from the current state for pathfinding.\n  initial_grid = current_state.grid  # The current layout of the game world.\n  initial_pos = current_state.pos    # Agent's starting (row, col) position.\n  initial_dir = current_state.dir    # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Resolve the string primitive name to its integer ID using the game's cookbook index.\n  # This ID is crucial for looking up the primitive on the grid.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized by the game, it cannot be collected.\n      # Return an empty list, indicating no actions can be taken.\n      return []\n\n  # Get the dimensions of the grid for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map symbolic action names (used in the DSL and environment interface) to their\n  # corresponding integer action codes that the `env.step()` method expects.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' typically moves the agent forward.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to collect/interact with an object.\n\n  # Define how agent's (row, col) coordinates change based on its current direction\n  # when it moves forward.\n  # Direction mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases.\n      1: (-1, 0),  # Facing UP: row decreases.\n      2: (0, -1),  # Facing LEFT: column decreases.\n      3: (1, 0)    # Facing DOWN: row increases.\n  }\n\n  # Identify all entity kinds that inherently block agent movement.\n  # These are typically 'non-grabbable' items like boundaries, water, or workshops,\n  # which the agent cannot walk *onto*.\n  blocking_terrain_ids = current_state.world.non_grabbable_indices\n\n  # --- Helper function for walkability checks ---\n  def _is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within bounds and free of obstacles\n      for the agent to move onto.\n      \"\"\"\n      # 1. Check if the coordinates are within the grid boundaries.\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n\n      # 2. Check if the cell contains any permanent blocking terrain (e.g., water, boundary).\n      for kind_idx in blocking_terrain_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Importantly, the agent should not walk directly onto the specific primitive\n      # it intends to collect (e.g., you stand next to a tree to chop it, not on it).\n      # This applies if the primitive is not already covered by `blocking_terrain_ids`.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # The queue stores states to explore: ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set keeps track of (position, direction) pairs already explored\n  # to prevent cycles and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the final sequence of movement/turn actions\n  # needed to get the agent adjacent to the primitive and facing it.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      # Dequeue the current state and the path taken to reach it.\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Check if the cell in front is within bounds and actually contains the target primitive.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          # If so, we've found the shortest path to a 'USE'-ready position.\n          path_to_primitive_adjacency = path_so_far\n          break # Exit BFS; the shortest path has been found.\n\n      # --- Explore possible next actions (Move Forward, Turn Left, Turn Right) ---\n\n      # 1. Try moving forward (UP action)\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving.\n\n      if _is_cell_walkable(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning left (LEFT action)\n      # Calculate the new direction after turning left (counter-clockwise rotation).\n      next_dir_left = (current_dir + 1) % 4 \n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning right (RIGHT action)\n      # Calculate the new direction after turning right (clockwise rotation).\n      next_dir_right = (current_dir - 1 + 4) % 4 # '+4' ensures positive result for modulo.\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- Finalizing the action list ---\n  # If a path to the primitive's adjacency was found, extend the actions_list with it\n  # and then append the 'USE' action to perform the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  # Return the complete sequence of actions. This list will be empty if the\n  # primitive was unreachable or not found on the grid.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:27:01.208633", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment.\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are general obstacles the agent cannot walk through.\n  base_non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a cell at (r, c) is a valid and walkable location for the agent.\n  def _is_walkable_cell(r, c):\n      \"\"\"Checks if the given grid cell (r, c) is within bounds and does not contain\n      any blocking entities or the primitive itself (as agent stands next to it).\"\"\"\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < GRID_ROWS and 0 <= c < GRID_COLS):\n          return False\n\n      # 2. Check if the cell contains any non-grabbable entity that blocks movement.\n      for kind_idx in base_non_walkable_kind_ids:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Agent cannot walk directly *onto* the primitive it intends to collect.\n      # It must be adjacent to use it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # --- Improvement for v2: Pre-compute all valid target agent states ---\n  # A \"target agent state\" is a combination of (agent_position, agent_direction)\n  # from which the agent can execute the 'USE' action to collect the primitive.\n  # This means the agent is one step away from the primitive and facing it.\n\n  target_agent_states = set()\n\n  # 1. Find all grid locations where the target primitive exists.\n  # np.argwhere returns an array of (row, col) coordinates.\n  primitive_locations = np.argwhere(initial_grid[:, :, primitive_id] > 0)\n\n  # 2. For each primitive location, determine all possible agent states (pos, dir)\n  # from which that primitive could be collected.\n  for prim_r, prim_c in primitive_locations:\n      # Iterate through all 4 possible directions the agent could be facing.\n      for agent_dir_candidate in range(4):\n          # Determine the (dr, dc) that represents 'forward' for this agent_dir_candidate.\n          dr, dc = DIR_TO_DRDC[agent_dir_candidate]\n\n          # The agent's position (agent_r, agent_c) must be such that (agent_r + dr, agent_c + dc) == (prim_r, prim_c).\n          # Therefore, (agent_r, agent_c) = (prim_r - dr, prim_c - dc).\n          agent_r_candidate, agent_c_candidate = prim_r - dr, prim_c - dc\n          \n          # Check if this calculated candidate agent position is a valid and walkable cell.\n          if _is_walkable_cell(agent_r_candidate, agent_c_candidate):\n              target_agent_states.add(((agent_r_candidate, agent_c_candidate), agent_dir_candidate))\n              \n  # If no primitive locations are found or all adjacent positions are unreachable,\n  # the target_agent_states set will be empty. In this case, no path can be found.\n  if not target_agent_states:\n      return []\n\n  # BFS Initialization:\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores (position_tuple, direction_int) to avoid redundant exploration\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the shortest action sequence once a target state is found.\n  path_to_adjacent_primitive = None \n\n  # Start Breadth-First Search traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # Goal Check: Is the current agent state one of our pre-computed target states?\n      if ((current_pos, current_dir) in target_agent_states):\n          path_to_adjacent_primitive = path_so_far\n          break # Shortest path to a 'USE'-ready position found.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Option 1: Move Forward (maps to 'UP' action in CraftLab)\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      if _is_walkable_cell(next_r_move, next_c_move):\n          if (next_pos_move, next_dir_move) not in visited:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # Option 2: Turn Left (maps to 'LEFT' action)\n      next_dir_left = (current_dir + 1) % 4 # Cycle directions counter-clockwise (0->1, 1->2, 2->3, 3->0)\n      # Position remains the same when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # Option 3: Turn Right (maps to 'RIGHT' action)\n      next_dir_right = (current_dir - 1 + 4) % 4 # Cycle directions clockwise (0->3, 1->0, 2->1, 3->2)\n      # Position remains the same when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:27:49.954243", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version refines the pathfinding logic using a Breadth-First Search (BFS) approach\n  to find the shortest sequence of actions to reach and collect a primitive.\n  It introduces a clear helper function for walkability checks to enhance readability.\n\n  Args:\n      env (env.CraftLab): The CraftLab object containing the current game state.\n      primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action indices (e.g., MOVE_FORWARD, TURN_LEFT, USE)\n                 to execute to find and collect the specified primitive. Returns an empty\n                 list if the primitive is unreachable.\n  \"\"\"\n  actions_list = [] # This list will store the sequence of action IDs to be returned.\n  current_state = env._current_state # Get the current state of the crafting environment.\n\n  # --- Extract key information from the current CraftState ---\n  grid = current_state.grid  # The 3D NumPy array representing the world grid (rows, columns, item_kinds).\n  agent_pos = current_state.pos    # Agent's current position as a (row, column) tuple.\n  agent_dir = current_state.dir    # Agent's current facing direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN).\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This ID is crucial for identifying the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Determine grid dimensions for boundary checks during pathfinding.\n  grid_rows, grid_cols, _ = grid.shape\n\n  # --- Retrieve integer action IDs from the environment's action specifications ---\n  # These are the numeric codes (0-4) that correspond to specific actions in the game.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In this DMLab-style env, 'UP' means move forward.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees clockwise.\n  USE_ACTION = action_map['USE']            # Interact with the cell directly in front of the agent.\n\n  # --- Define agent movement and turning mechanics ---\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector.\n  # This vector represents the change in coordinates for the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_DIR_MAP / TURN_RIGHT_DIR_MAP: Map current direction to the new direction after a turn.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Get indices of entities that block agent movement.\n  # The agent cannot walk onto cells containing these kinds (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper function to determine if a grid cell is walkable ---\n  def is_cell_walkable(r, c, target_primitive_kind_id):\n      \"\"\"Checks if a given grid cell (r, c) is a valid and walkable position for the agent.\n      \n      Args:\n          r (int): Row index of the cell.\n          c (int): Column index of the cell.\n          target_primitive_kind_id (int): The ID of the primitive we are trying to collect.\n                                          This is important because the agent cannot walk *onto*\n                                          the primitive itself; it needs to be adjacent.\n\n      Returns:\n          bool: True if the cell is walkable, False otherwise.\n      \"\"\"\n      # 1. Check if the position is within grid boundaries.\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # 2. Check if the cell contains the target primitive.\n      # The agent must be adjacent to the primitive to 'USE' it, not occupy the same cell.\n      if grid[r, c, target_primitive_kind_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      # Iterate through the indices of known non-walkable kinds. If any are present, the cell is not walkable.\n      for kind_idx in non_walkable_kinds_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # --- BFS Initialization ---\n  # The queue stores tuples: ((current_agent_position, current_agent_direction), list_of_actions_taken_to_reach_here).\n  # A \"state\" for BFS is defined by (position, direction) because the outcome of actions depends on both.\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # The 'visited' set stores (position, direction) tuples to prevent redundant exploration,\n  # avoid cycles, and ensure the shortest path is found (a property of BFS for unweighted steps).\n  visited = {(agent_pos, agent_dir)}\n\n  # This variable will store the sequence of actions once a path is found\n  # that leads the agent to be adjacent to and facing the primitive.\n  path_to_primitive_adjacency = None \n\n  # --- Start BFS traversal ---\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Goal Check: Is the target primitive directly in front of the agent from the current state?\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      \n      # Calculate coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # If the primitive is present in this front cell (i.e., its count is > 0),\n          # we have found the desired adjacency state.\n          if grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken # Store the path leading to this adjacent state.\n              break # Target state found, exit the BFS loop as we found the shortest path.\n\n      # 2. Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions lead to new agent states (position and/or direction).\n\n      # --- Try Move Forward action ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row_fwd, next_col_fwd = current_row + move_dr, current_col + move_dc\n      next_pos_fwd = (next_row_fwd, next_col_fwd)\n      next_dir_fwd = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid and walkable,\n      # and if this specific (position, direction) state has not been visited yet.\n      if is_cell_walkable(next_row_fwd, next_col_fwd, primitive_id) and \\\n         (next_pos_fwd, next_dir_fwd) not in visited:\n          visited.add((next_pos_fwd, next_dir_fwd)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path, including the MOVE_FORWARD_ACTION.\n          queue.append(((next_pos_fwd, next_dir_fwd), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left action ---\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left.\n      next_pos_left = current_pos # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if (next_pos_left, next_dir_left) not in visited:\n          visited.add((next_pos_left, next_dir_left)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path, including the TURN_LEFT_ACTION.\n          queue.append(((next_pos_left, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right action ---\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right.\n      next_pos_right = current_pos # Position does not change when turning.\n\n      # Check if this new (position, direction) state has not been visited.\n      if (next_pos_right, next_dir_right) not in visited:\n          visited.add((next_pos_right, next_dir_right)) # Mark new state as visited.\n          # Add the new state to the queue with the updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((next_pos_right, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # --- Finalizing the action list ---\n  # After BFS completes (either target found or queue empty),\n  # if a path to the primitive's adjacency was found, append the final 'USE' action.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:27:51.335168", "function_name": "collect", "function_body": "  actions_list = [] # Initialize an empty list to store the sequence of actions.\n  current_state = env._current_state # Get the current state of the CraftLab environment.\n\n  # Extract essential information from the current state for pathfinding.\n  grid = current_state.grid  # The 3D numpy array representing the environment grid.\n  agent_pos = current_state.pos    # Agent's current (row, column) coordinates.\n  agent_dir = current_state.dir    # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Get the integer ID for the target primitive (e.g., 'WOOD' -> 5) from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Determine grid dimensions (number of rows and columns) for boundary checks.\n  grid_rows, grid_cols, _ = grid.shape\n\n  # Retrieve the integer action codes from the environment's action specifications.\n  # These codes are used when adding actions to the `actions_list`.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move the agent forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn the agent 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn the agent 90 degrees clockwise.\n  USE_ACTION = action_map['USE']            # Action to interact with the block directly in front of the agent.\n\n  # Define directional vectors for movement. These are deltas (dr, dc) for each direction.\n  # The agent's direction corresponds to: 0 (Right), 1 (Up), 2 (Left), 3 (Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: row stays same, column increases\n      1: (-1, 0),  # Up: row decreases, column stays same\n      2: (0, -1),  # Left: row stays same, column decreases\n      3: (1, 0)    # Down: row increases, column stays same\n  }\n\n  # Define mappings for how the agent's direction changes when turning.\n  # This ensures correct cyclic behavior for directions (0 -> 1 -> 2 -> 3 -> 0).\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Facing Right (0) -> turns Up (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Facing Right (0) -> turns Down (3)\n\n  # Get the set of integer indices for entities that cannot be walked upon (e.g., walls, water).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (row, col) is valid for the agent to move into.\n  def is_cell_walkable(r, c):\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return False\n      \n      # 2. Check if the cell contains any non-walkable entities.\n      # If the cell has a positive count for any non-grabbable kind, it's not walkable.\n      for kind_idx in non_walkable_kinds_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      \n      # 3. Crucially, the agent collects primitives by being *adjacent* to them and using 'USE'.\n      # Therefore, the agent should NOT move directly onto a cell containing the primitive itself.\n      if grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True # If all checks pass, the cell is walkable.\n\n  # BFS (Breadth-First Search) Setup:\n  # The queue stores tuples: ((current_position, current_direction), list_of_actions_taken_to_reach_this_state).\n  # A \"state\" for BFS is defined by both the agent's position and its orientation.\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states already explored.\n  # This prevents redundant computations and ensures the shortest path is found in an unweighted graph.\n  visited = {(agent_pos, agent_dir)}\n\n  # This variable will store the actions leading to the state where the agent is\n  # positioned directly adjacent to and facing the primitive.\n  path_to_primitive_adjacency = None \n\n  # Start the BFS traversal\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Check if the cell in front is within grid boundaries.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # If the target primitive is present in this front cell (count > 0),\n          # we have found the desired state for collection.\n          if grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken # Store the path found.\n              break # Exit BFS, as the shortest path to the goal state is found.\n\n      # --- Explore possible next actions from the current state ---\n\n      # 1. Try 'MOVE_FORWARD_ACTION':\n      # Calculate the agent's next position if it moves forward. Direction remains the same.\n      next_move_row, next_move_col = current_row + DIR_TO_DRDC[current_dir][0], current_col + DIR_TO_DRDC[current_dir][1]\n      next_move_pos = (next_move_row, next_move_col)\n      next_move_dir = current_dir # Direction doesn't change on move\n\n      # Check if the new state (position, direction) has not been visited and the cell is walkable.\n      if ((next_move_pos, next_move_dir) not in visited and \n          is_cell_walkable(next_move_row, next_move_col)):\n          \n          visited.add((next_move_pos, next_move_dir)) # Mark new state as visited.\n          # Add the new state to the queue along with the path extended by MOVE_FORWARD_ACTION.\n          queue.append(((next_move_pos, next_move_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try 'TURN_LEFT_ACTION':\n      # Calculate the agent's new direction after turning left. Position remains the same.\n      next_turn_left_dir = TURN_LEFT_DIR_MAP[current_dir]\n      next_turn_left_pos = current_pos # Position doesn't change on turn\n\n      # Check if the new state (position, direction) has not been visited.\n      if (next_turn_left_pos, next_turn_left_dir) not in visited:\n          visited.add((next_turn_left_pos, next_turn_left_dir)) # Mark new state as visited.\n          # Add the new state to the queue along with the path extended by TURN_LEFT_ACTION.\n          queue.append(((next_turn_left_pos, next_turn_left_dir), path_taken + [TURN_LEFT_ACTION]))\n\n      # 3. Try 'TURN_RIGHT_ACTION':\n      # Calculate the agent's new direction after turning right. Position remains the same.\n      next_turn_right_dir = TURN_RIGHT_DIR_MAP[current_dir]\n      next_turn_right_pos = current_pos # Position doesn't change on turn\n\n      # Check if the new state (position, direction) has not been visited.\n      if (next_turn_right_pos, next_turn_right_dir) not in visited:\n          visited.add((next_turn_right_pos, next_turn_right_dir)) # Mark new state as visited.\n          # Add the new state to the queue along with the path extended by TURN_RIGHT_ACTION.\n          queue.append(((next_turn_right_pos, next_turn_right_dir), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After the BFS loop completes:\n  # If a path to being adjacent to and facing the primitive was found:\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency) # Add all navigation actions.\n      actions_list.append(USE_ACTION) # Append the final 'USE' action to collect the primitive.\n\n  return actions_list # Return the complete sequence of actions.", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:28:46.182829", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to locate a specified primitive in the environment,\n    move adjacent to it, face it, and then use the 'USE' action to collect it.\n    This function implements a Breadth-First Search (BFS) to determine the optimal path.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The string name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., MOVE_FORWARD, TURN_LEFT, USE)\n                   that the agent should execute. Returns an empty list if the primitive\n                   is not found or is unreachable from the current agent state.\n  \"\"\"\n  actions_sequence = [] # This list will accumulate the actions to be returned\n  current_state = env._current_state # Get the current state of the environment\n\n  # Retrieve essential information from the current state for pathfinding.\n  # The grid represents the world layout: grid[row, col, kind_id] gives count of kind_id at (row,col)\n  grid = current_state.grid \n  # Agent's current position as a (row, column) tuple\n  initial_agent_pos = current_state.pos \n  # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n  initial_agent_dir = current_state.dir \n\n  # Obtain the unique integer ID for the target primitive from the game's cookbook.\n  # This ID is used to query the grid and identify the primitive.\n  try:\n    primitive_kind_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name does not exist in the cookbook, it cannot be collected.\n    # Return an empty list indicating that no actions can be taken.\n    return []\n  \n  # Get the dimensions of the grid for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names (from the DSL) to their corresponding integer values required by env.step().\n  action_mappings = env.action_specs()\n  # 'UP' action in CraftLab typically means \"move forward\" in the agent's current direction.\n  MOVE_FORWARD = action_mappings['UP'] \n  TURN_LEFT = action_mappings['LEFT']\n  TURN_RIGHT = action_mappings['RIGHT']\n  USE_ITEM = action_mappings['USE'] # Action to interact with/collect an item in front\n\n  # Define how moving forward changes the agent's (row, col) position based on its direction.\n  # This dictionary maps direction integer to (delta_row, delta_col).\n  # Direction 0: RIGHT (increases column)\n  # Direction 1: UP (decreases row)\n  # Direction 2: LEFT (decreases column)\n  # Direction 3: DOWN (increases row)\n  DIRECTION_TO_DELTA_POS = {\n      0: (0, 1),   # Right (0): (r, c+1)\n      1: (-1, 0),  # Up (1):    (r-1, c)\n      2: (0, -1),  # Left (2):  (r, c-1)\n      3: (1, 0)    # Down (3):  (r+1, c)\n  }\n\n  # Define how turning left changes the agent's direction.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  # Define how turning right changes the agent's direction.\n  # Directions cycle: 0 -> 3 -> 2 -> 1 -> 0\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entity kinds that the agent cannot walk over.\n  # This includes fixed environment elements (boundaries, water, workshops).\n  # Crucially, the target `primitive_kind_id` itself is also added here.\n  # The agent needs to stop *adjacent* to the primitive and then 'USE' it,\n  # rather than occupying the same cell as the primitive.\n  non_walkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  non_walkable_kind_ids.add(primitive_kind_id) \n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: ((current_agent_position, current_agent_direction), list_of_actions_taken_to_reach_this_state).\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # The 'visited' set prevents infinite loops and redundant computation by tracking states already explored.\n  # A state is defined by the agent's (position, direction) tuple.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the action sequence once the primitive is found and the agent is correctly positioned.\n  found_target_path = None \n\n  # Start the BFS exploration.\n  while bfs_queue:\n      # Dequeue the current state (position, direction) and the path that led to it.\n      (current_pos, current_dir), current_path_actions = bfs_queue.popleft()\n      current_pos_r, current_pos_c = current_pos # Deconstruct tuple for convenience\n\n      # 1. Check if the current state is the goal state: agent is adjacent to the primitive and facing it.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      delta_r_front, delta_c_front = DIRECTION_TO_DELTA_POS[current_dir]\n      front_cell_r, front_cell_c = current_pos_r + delta_r_front, current_pos_c + delta_c_front\n      \n      # Ensure the 'front' cell is within the grid boundaries.\n      if (0 <= front_cell_r < GRID_ROWS and 0 <= front_cell_c < GRID_COLS):\n          # If the cell in front contains the target primitive, we have found our goal position.\n          if grid[front_cell_r, front_cell_c, primitive_kind_id] > 0:\n              found_target_path = current_path_actions # Store the sequence of actions that led here.\n              break # Exit the BFS loop as the shortest path has been found.\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right).\n\n      # Try moving Forward:\n      # Calculate the next position if the agent moves forward. Direction doesn't change.\n      next_pos_r, next_pos_c = current_pos_r + delta_r_front, current_pos_c + delta_c_front\n      next_agent_pos = (next_pos_r, next_pos_c)\n      next_agent_dir = current_dir # Direction remains unchanged after a forward move.\n\n      # Check if the potential new state is valid and unvisited.\n      if (0 <= next_pos_r < GRID_ROWS and 0 <= next_pos_c < GRID_COLS and\n          (next_agent_pos, next_agent_dir) not in visited_states):\n          \n          # Check if the cell the agent wants to move into is walkable.\n          is_cell_walkable = True\n          for kind_id in non_walkable_kind_ids:\n              if grid[next_pos_r, next_pos_c, kind_id] > 0:\n                  is_cell_walkable = False\n                  break # Found an unwalkable item, no need to check others in this cell.\n          \n          if is_cell_walkable:\n              # If walkable and unvisited, add to visited and queue.\n              visited_states.add((next_agent_pos, next_agent_dir))\n              bfs_queue.append(((next_agent_pos, next_agent_dir), current_path_actions + [MOVE_FORWARD]))\n\n      # Try turning Left:\n      # Calculate the new direction after turning left. Position remains the same.\n      next_agent_dir_left = TURN_LEFT_DIRECTION_MAP[current_dir]\n      # Check if this new state (same position, new direction) has been visited.\n      if ((current_pos_r, current_pos_c), next_agent_dir_left) not in visited_states:\n          # If unvisited, add to visited and queue.\n          visited_states.add(((current_pos_r, current_pos_c), next_agent_dir_left))\n          bfs_queue.append(((current_pos_r, current_pos_c), current_path_actions + [TURN_LEFT]))\n\n      # Try turning Right:\n      # Calculate the new direction after turning right. Position remains the same.\n      next_agent_dir_right = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      # Check if this new state has been visited.\n      if ((current_pos_r, current_pos_c), next_agent_dir_right) not in visited_states:\n          # If unvisited, add to visited and queue.\n          visited_states.add(((current_pos_r, current_pos_c), next_agent_dir_right))\n          bfs_queue.append(((current_pos_r, current_pos_c), current_path_actions + [TURN_RIGHT]))\n\n  # After the BFS loop completes:\n  # If a path was found to position the agent adjacent to and facing the primitive,\n  # append the 'USE' action to that path and return the complete sequence.\n  if found_target_path is not None:\n      actions_sequence.extend(found_target_path)\n      actions_sequence.append(USE_ITEM)\n  \n  return actions_sequence", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:28:47.385042", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Extract current state information\n  # The grid is typically indexed as grid[row, col, kind_id]\n  grid = current_state.grid \n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    # Return an empty list indicating the task cannot be performed.\n    return []\n  \n  # Determine grid dimensions (number of rows, number of columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  # 'UP' action typically means moving forward in the agent's current direction.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item (e.g., chop, mine)\n\n  # Define how agent's (row, col) position changes when moving forward based on direction.\n  # This maps current_dir to a (delta_row, delta_col) tuple.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP:   (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right (cyclical).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right(0) -> Up(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right(0) -> Down(3)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Crucially, the primitive itself is also added here, as the agent needs to stop\n  # *adjacent* to it and face it to use the 'USE' action, not walk directly onto its cell.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup:\n  # The queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the target state is found.\n\n  # Start BFS to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current_pos into row and column\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent.\n      # This is the goal condition for pathfinding: being adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the calculated 'front' cell is within grid boundaries.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the path to the collection point.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path leading to this \"adjacent and facing\" state.\n              break # Exit BFS, as the shortest path to the goal state has been found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries AND if this (position, direction) state has not been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the cell at `next_pos` is walkable.\n          # A cell is unwalkable if it contains any entity kind specified in `unwalkable_kind_ids`.\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              # If the cell is walkable and the state is unvisited, add it to the visited set and the queue.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS search completes:\n  # If a `target_path_actions` was found (meaning the primitive was located and a path to it exists),\n  # append the `USE_ACTION` to the sequence to actually collect the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  \n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:29:43.575579", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Define the comprehensive set of all entity kinds that can be collected via the 'USE' action.\n  # This includes explicit primitive resources, grabbable items, water, and stone.\n  # This set is used for both the initial check of the target primitive and for checking\n  # if any useful item (like a tool) can be picked up on the way to the target.\n  all_useable_and_collectible_kinds = set(world.cookbook.primitives).union(world.grabbable_indices).union({world.water_index, world.stone_index})\n  \n  # If the target primitive itself is not of a type that can be collected via 'USE',\n  # then this `collect` function cannot satisfy the request.\n  if i_kind not in all_useable_and_collectible_kinds:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (20) allows for broader exploration, especially for tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps.\n    \n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check if *any* of the `all_useable_and_collectible_kinds` are present in the cell directly in front.\n        # This covers grabbable items, water, stone, and other primitive resources that might be needed.\n        is_something_useable_in_front = False\n        for k_idx_to_check in all_useable_and_collectible_kinds:\n            if state.grid[facing_r, facing_c, k_idx_to_check] == 1:\n                is_something_useable_in_front = True\n                break\n\n        # Only attempt USE_ACT if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add to queue only if the USE action resulted in a meaningful state change.\n            # A meaningful change means inventory or position/direction was updated.\n            # Inventory change is the primary signal for resource collection.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
