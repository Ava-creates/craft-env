{"timestamp": "2025-08-01T08:37:07.420606", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the internal CraftState object\n\n  # Extract essential information from the current state for pathfinding\n  initial_grid = current_state.grid # The static grid layout\n  initial_pos = current_state.pos   # Agent's current (row, col) position\n  initial_dir = current_state.dir   # Agent's current facing direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  # Use try-except for robustness, though the DSL implies valid primitive names.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # Return an empty list of actions in this case.\n      return []\n\n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names to their integer indices for robustness and clarity\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed to move agent one step in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Rotates agent 90 degrees left (counter-clockwise)\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Rotates agent 90 degrees right (clockwise)\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front\n\n  # Pre-defined changes in (row, col) for each direction\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Set of entity kinds that represent non-walkable terrain (e.g., boundaries, water, workshops)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS Initialization\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set: stores (position_tuple, direction_int) to prevent redundant exploration\n  # and guarantee the shortest path is found for unweighted edges.\n  visited = {(initial_pos, initial_dir)}\n\n  # Stores the path found to the goal state (adjacent and facing the primitive)\n  path_to_adjacent_primitive = None \n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the current state is a \"goal state\" for collection:\n      # Is the agent positioned such that the target primitive is directly in front of it?\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell directly in front is within grid bounds\n      if 0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS:\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Shortest path to a 'USE' position found!\n\n      # 2. Explore possible next actions from the current state: Move, Turn Left, Turn Right\n\n      # --- Try Move Forward ---\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains the same after moving forward\n\n      # Check if the potential next position is valid and unvisited\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is walkable if it doesn't contain any non-grabbable entities\n          # AND it's not the target primitive itself (agent must stand *next* to, not *on*, the primitive).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, ensure the agent doesn't walk onto the primitive it intends to collect\n          if is_walkable and initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      # Calculate new direction using modular arithmetic for counter-clockwise rotation\n      # R(0)->U(1), U(1)->L(2), L(2)->D(3), D(3)->R(0)\n      next_dir_left = (current_dir + 1) % 4\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      # Calculate new direction using modular arithmetic for clockwise rotation\n      # R(0)->D(3), U(1)->R(0), L(2)->U(1), D(3)->L(2)\n      next_dir_right = (current_dir - 1 + 4) % 4 # Add 4 to ensure positive result before modulo\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:37:54.429144", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Extract immutable state information for BFS planning\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This mapping is crucial for identifying the target on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment (these are constant action IDs).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' means move forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Interact with the cell in front.\n\n  # Define direction vectors for movement and turning rules (constants for agent's movement mechanics).\n  # DIR_TO_DRDC: Maps agent's current direction (0-3) to a (delta_row, delta_column) vector,\n  # which indicates the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a specific grid cell is walkable.\n  # A cell is walkable if it's within bounds and does not contain the primitive itself\n  # or any non-grabbable entity.\n  def _is_walkable_cell(r, c):\n      # 1. Check if the coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False \n\n      # 2. Check if the cell contains the target primitive. Agent cannot walk onto the primitive.\n      # (Interaction is from an adjacent square using the USE action).\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      # 3. Check if the cell contains any non-grabbable (and thus impassable) entities.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      return True # If all checks pass, the cell is walkable.\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  # This represents an agent's state (position and orientation) and the path to achieve it.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the action sequence if a path is found.\n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Goal check: Is the target primitive directly in front of the agent from the current state?\n      # This is the \"goal state\" for our pathfinding: being positioned to interact with the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found a path that leads the agent\n          # to be adjacent to and facing the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! Terminate BFS.\n\n      # Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the next position is walkable and this new (position, direction) state\n      # has not been visited yet.\n      if _is_walkable_cell(next_r, next_c) and (next_pos, next_dir) not in visited:\n          # If walkable and unvisited, add the new state to the queue and mark it as visited.\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          # Add the new state to the queue and mark as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to the target (adjacent and facing the primitive) was found,\n  # extend the found path with the final 'USE' action to collect the primitive.\n  # If no path was found (target_path is None), an empty list is returned,\n  # indicating the primitive is unreachable from the current state.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:37:55.583795", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  Finds a path for the agent to move to a position adjacent to the specified\n  primitive, facing it, and then perform a 'USE' action to collect it.\n  Uses Breadth-First Search (BFS) to find the shortest sequence of actions.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment wrapper.\n      primitive (str): The name (string identifier) of the primitive item to collect.\n\n  Returns:\n      List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                 Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Get the current state of the environment.\n  \n  # Extract static information from the current state for pathfinding.\n  # This avoids repeated access to dynamic state during BFS.\n  grid = current_state.grid # The static grid layout for pathfinding.\n  initial_pos = current_state.pos # Agent's starting (row, col) position.\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This ID is used to locate the primitive on the grid.\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    # Return empty list as it's unreachable in this context.\n    return []\n  \n  # Grid dimensions for boundary checks.\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve action mapping from the environment. These are constant integer IDs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Move one step forward in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees counter-clockwise.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees clockwise.\n  USE_ACTION = action_map['USE']            # Interact with the cell in front.\n\n  # Define direction vectors for movement and turning rules.\n  # DIR_TO_DRDC: Maps agent's direction (0-3) to a (delta_row, delta_column) vector.\n  # This vector indicates the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # TURN_LEFT_MAP / TURN_RIGHT_MAP: Map current direction to the new direction after a turn.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement.\n  # The agent cannot walk onto cells containing these entities.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS State Representation:\n  # A state is defined by (agent's_position_tuple, agent's_direction_int).\n  # The queue stores tuples: (state, list_of_actions_to_reach_this_state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores states (pos, dir) to avoid redundant computations\n  # and guarantee finding the shortest path by preventing cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacent_state = None # Stores the action sequence to reach the pre-collection state.\n\n  # --- BFS Traversal ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # This is the goal condition for our pathfinding: agent is positioned to collect.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in this cell, we have found the desired pre-collection state.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacent_state = path_so_far\n              break # Path found! Terminate BFS as we found the shortest path.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward ---\n      # Calculate the next potential position and direction.\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change when moving forward.\n\n      # Check validity: within bounds and not previously visited.\n      if (0 <= next_r_move < num_rows and 0 <= next_c_move < num_cols and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Check if the potential next cell is walkable.\n          # A cell is NOT walkable if it contains:\n          # a) The primitive itself (agent collects it from adjacent square, not by stepping on it).\n          # b) Any non-grabbable entity (e.g., boundaries, water, certain workshops).\n          is_walkable = not (\n              grid[next_r_move, next_c_move, primitive_id] > 0 or\n              any(grid[next_r_move, next_c_move, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices)\n          )\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position remains the same when turning.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- After BFS Completion ---\n  # If a path was found to an adjacent-and-facing state:\n  if target_path_to_adjacent_state is not None:\n      actions_list.extend(target_path_to_adjacent_state)\n      actions_list.append(USE_ACTION) # Append the final 'USE' action to collect the primitive.\n      \n  # If no path was found (target_path_to_adjacent_state remains None),\n  # actions_list will be empty, correctly indicating the primitive is unreachable.\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:38:49.860964", "function_name": "collect", "function_body": "  actions_list = [] # This will store the final sequence of actions.\n\n  # Retrieve current state information from the environment.\n  current_state = env._current_state \n  grid_snapshot = current_state.grid       # The 3D NumPy array representing the world grid.\n  initial_pos = current_state.pos          # Agent's starting (row, col) coordinates.\n  initial_dir = current_state.dir          # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Convert the primitive's string name to its integer ID using the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Pre-check: If the primitive is invalid (not in index) or not a grabbable item,\n  # it cannot be collected. Return an empty list immediately.\n  # Grabbable items are those that can be picked up using the 'USE' action.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  # Get grid dimensions (height, width) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid_snapshot.shape \n\n  # Map symbolic action names to their corresponding integer IDs, as defined by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # 'UP' action typically means moving forward relative to agent's facing.\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']     # Action to collect an item in front.\n\n  # Define directional vectors for agent movement based on its current facing direction.\n  # (direction: (delta_row, delta_col))\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (0): Moves one column to the right.\n      1: (-1, 0),  # Facing UP (1): Moves one row up (decreasing row index).\n      2: (0, -1),  # Facing LEFT (2): Moves one column to the left.\n      3: (1, 0)    # Facing DOWN (3): Moves one row down (increasing row index).\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # (current_direction: new_direction)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT (counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT (clockwise)\n\n  # Get the set of entity indices that the agent cannot walk through (e.g., water, workshops, boundaries).\n  # These are defined as non-grabbable items that act as obstacles.\n  non_walkable_obstacles = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within grid boundaries.\n  def _is_valid_grid_coord(r, c):\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  # Helper function to check if a cell at (r, c) is traversable.\n  # An agent cannot walk onto an obstacle or onto the item it intends to collect.\n  def _is_cell_traversable(r, c):\n      if not _is_valid_grid_coord(r, c):\n          return False\n      \n      # Check for presence of non-walkable obstacles.\n      for kind_idx in non_walkable_obstacles:\n          if grid_snapshot[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent must stand *adjacent* to the primitive to collect it, not on top of it.\n      if grid_snapshot[r, c, primitive_id] > 0:\n          return False # Cannot walk onto the target primitive itself.\n          \n      return True\n  \n  # Helper function to check if the target primitive is directly in front of the agent.\n  # This defines the \"goal state\" for our BFS pathfinding: a state from which 'USE' can be called.\n  def _is_primitive_facing(agent_pos, agent_dir):\n      r, c = agent_pos\n      # Calculate coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[agent_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is valid and contains the primitive.\n      if not _is_valid_grid_coord(front_r, front_c):\n          return False\n      \n      return grid_snapshot[front_r, front_c, primitive_id] > 0\n\n  # BFS Setup:\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (agent_position_tuple, agent_direction_int) to avoid redundant\n  # exploration and cycles, ensuring the shortest path is found.\n  visited_states = {(initial_pos, initial_dir)}\n\n  shortest_path_to_primitive_facing_state = None # To store the found path before the final 'USE' action.\n\n  # Begin BFS.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      \n      # Check if the current state is one from which the primitive can be collected.\n      if _is_primitive_facing(current_pos, current_dir):\n          shortest_path_to_primitive_facing_state = path_actions\n          break # Shortest path found, exit BFS.\n\n      # Explore possible next actions (Move Forward, Turn Left, Turn Right).\n\n      # 1. Try Moving Forward\n      move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n      next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir # Direction does not change on move.\n\n      if _is_cell_traversable(next_r_fwd, next_c_fwd):\n          next_state_fwd = (next_pos_fwd, next_dir_fwd)\n          if next_state_fwd not in visited_states:\n              visited_states.add(next_state_fwd)\n              queue.append((next_state_fwd, path_actions + [MOVE_FORWARD]))\n\n      # 2. Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (current_pos, next_dir_left) # Position remains same.\n\n      if next_state_left not in visited_states:\n          visited_states.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT]))\n\n      # 3. Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (current_pos, next_dir_right) # Position remains same.\n\n      if next_state_right not in visited_states:\n          visited_states.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path was found to a primitive-facing state, append the final 'USE' action.\n  if shortest_path_to_primitive_facing_state is not None:\n      actions_list.extend(shortest_path_to_primitive_facing_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:38:51.055043", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Pre-check: If the primitive name is not valid (not in the index) \n  # or if it's not a grabbable item (e.g., a workshop, boundary, or water),\n  # we cannot 'collect' it using the 'USE' action. Return an empty list of actions.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  # Retrieve grid dimensions for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map string action names to their corresponding integer IDs using the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftLab, 'UP' typically moves the agent forward.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item in front.\n\n  # Define changes in (row, col) for each direction when moving forward.\n  # (dir: (delta_row, delta_col))\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (0): (row, col+1)\n      1: (-1, 0),  # Facing UP (1): (row-1, col)\n      2: (0, -1),  # Facing LEFT (2): (row, col-1)\n      3: (1, 0)    # Facing DOWN (3): (row+1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  # (current_dir: new_dir_after_turn)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles counter-clockwise: RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles clockwise: RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get the set of entity indices that the agent cannot walk through.\n  # These are defined as non-grabbable items in the CraftWorld (e.g., water, workshops, boundaries).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper functions to encapsulate common logic and improve readability.\n\n  def _is_valid_grid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given row and column coordinates are within the grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_cell_target_facing(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the given agent `pos` and `current_dir`, the `primitive_id`\n      is located in the cell directly in front of the agent. This indicates\n      that a 'USE' action would successfully collect it.\n      \"\"\"\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is within grid boundaries.\n      if not _is_valid_grid_coord(front_r, front_c):\n          return False\n      \n      # Check if the target primitive is present in the cell directly in front (count > 0).\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_cell_walkable(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Checks if the given cell `pos` is traversable by the agent.\n      An agent cannot walk onto non-grabbable items or directly onto the primitive\n      it intends to collect (as 'USE' requires being adjacent, not on top of, the item).\n      \"\"\"\n      r, c = pos\n      # Ensure the cell itself is within grid boundaries.\n      if not _is_valid_grid_coord(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any non-walkable entity.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk directly onto the primitive it's trying to collect;\n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  # BFS (Breadth-First Search) for pathfinding:\n  # The BFS queue stores tuples:\n  # ( (agent_current_position_tuple, agent_current_direction_int), list_of_actions_taken_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (agent_position_tuple, agent_direction_int) to prevent\n  # redundant exploration and cycles, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the sequence of actions to reach a 'ready-to-use' state\n  # (i.e., adjacent to and facing the primitive).\n  target_path_to_adjacent_cell = None \n\n  # Optimization: First, check if the agent is already in the correct state to collect\n  # the primitive from its initial position and direction.\n  if _is_cell_target_facing(initial_pos, initial_dir):\n      target_path_to_adjacent_cell = [] # No prior movement actions are needed.\n\n  # If not immediately at the target, perform BFS to find the shortest path.\n  if target_path_to_adjacent_cell is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Explore all possible next actions from the current state:\n          \n          # --- Action: Move Forward (MOVE_FORWARD_ACTION) ---\n          move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction does not change when moving.\n\n          # Check if the potential next position is walkable and if this new state hasn't been visited.\n          if _is_cell_walkable(next_pos_fwd):\n              new_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if new_state_fwd not in visited:\n                  visited.add(new_state_fwd)\n                  new_path_fwd = path_actions + [MOVE_FORWARD_ACTION]\n                  \n                  # After \"hypothetically\" moving to `next_pos_fwd`, check if this new state\n                  # allows for immediate collection (i.e., agent is facing the primitive).\n                  if _is_cell_target_facing(next_pos_fwd, next_dir_fwd):\n                      target_path_to_adjacent_cell = new_path_fwd\n                      break # Shortest path found; exit BFS.\n                  \n                  queue.append((new_state_fwd, new_path_fwd))\n\n          # --- Action: Turn Left (TURN_LEFT_ACTION) ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes.\n          \n          # Check if the new state (same position, new direction) has not been visited.\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              \n              # After turning, check if this new state allows for immediate collection.\n              if _is_cell_target_facing(current_pos, next_dir_left):\n                  target_path_to_adjacent_cell = new_path_left\n                  break # Shortest path found; exit BFS.\n              \n              queue.append((new_state_left, new_path_left))\n\n          # --- Action: Turn Right (TURN_RIGHT_ACTION) ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes.\n          \n          # Check if the new state (same position, new direction) has not been visited.\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              \n              # After turning, check if this new state allows for immediate collection.\n              if _is_cell_target_facing(current_pos, next_dir_right):\n                  target_path_to_adjacent_cell = new_path_right\n                  break # Shortest path found; exit BFS.\n              \n              queue.append((new_state_right, new_path_right))\n\n  # After BFS completes (either a path was found or all reachable states were explored):\n  # If a valid path to an adjacent, facing cell was found, append the final 'USE' action.\n  if target_path_to_adjacent_cell is not None:\n      actions_list.extend(target_path_to_adjacent_cell)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:39:35.671557", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest sequence of actions\n  (movements and turns) to position the agent directly facing the target\n  primitive, then appends the 'USE' action to collect it.\n    \n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action IDs that, when executed, should\n                 lead to the collection of the specified primitive. Returns an\n                 empty list if the primitive is not collectable or unreachable.\n  \"\"\"\n  actions_list = []\n\n  # Get initial state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid  # The 3D NumPy array representing the current world grid\n  initial_pos = current_state.pos  # Agent's starting (row, col) coordinates\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Convert the primitive's string name to its integer ID using the cookbook's index.\n  # Use .get() for safer lookup, returning None if the primitive name isn't found.\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n\n  # Pre-check: If the primitive ID is invalid or if it's not a grabbable item,\n  # it cannot be collected. Return an empty list immediately.\n  # Grabbable items are those that can be picked up using the 'USE' action.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Get grid dimensions (rows, columns) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map symbolic action names to their corresponding integer IDs, as defined by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' typically means moving forward relative to agent's facing.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']     # Action to collect an item in front.\n\n  # Define directional vectors: (delta_row, delta_col) for each agent direction ID.\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (0): Moving forward increases column index.\n      1: (-1, 0),  # Facing UP (1): Moving forward decreases row index.\n      2: (0, -1),  # Facing LEFT (2): Moving forward decreases column index.\n      3: (1, 0)    # Facing DOWN (3): Moving forward increases row index.\n  }\n\n  # Define how the agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT (counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT (clockwise)\n\n  # Identify entities that the agent cannot walk through.\n  # This includes general non-grabbable items (e.g., boundaries, water, workshops).\n  # Crucially, the agent cannot walk *onto* the primitive itself; it must be adjacent to it.\n  non_walkable_kinds = current_state.world.non_grabbable_indices.copy()\n  non_walkable_kinds.add(primitive_id) # The target primitive is also an obstacle to movement.\n\n  # --- Helper Functions for BFS Conditions and Transitions ---\n\n  def is_valid_coord(r, c):\n      \"\"\"Checks if the given (row, col) coordinates are within the grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def is_cell_traversable(r, c):\n      \"\"\"Checks if the cell at (r, c) is a valid and walkable location for the agent.\"\"\"\n      if not is_valid_coord(r, c):\n          return False\n      \n      # Check if the cell contains any object that blocks movement.\n      for kind_idx in non_walkable_kinds:\n          if grid[r, c, kind_idx] > 0:\n              return False\n      return True\n  \n  def is_primitive_directly_facing(agent_pos, agent_dir):\n      \"\"\"Determines if the target primitive is in the cell immediately in front of the agent.\n      This defines the 'goal state' for our BFS pathfinding.\"\"\"\n      r, c = agent_pos\n      dr, dc = DIRECTION_VECTORS[agent_dir]\n      front_r, front_c = r + dr, c + dc # Coordinates of the cell directly in front.\n      \n      # Ensure the 'front' cell is within bounds and contains the primitive.\n      if not is_valid_coord(front_r, front_c):\n          return False\n      \n      return grid[front_r, front_c, primitive_id] > 0\n\n  # --- Breadth-First Search (BFS) Implementation ---\n\n  # The queue for BFS stores tuples:\n  # ((agent_position_tuple, agent_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (agent_position_tuple, agent_direction_int) to avoid\n  # revisiting states, which prevents cycles and ensures the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  shortest_path_to_facing_state = None # This will store the action sequence to the collection point.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      \n      # 1. Goal Check: If the agent is in a state where the primitive can be collected (i.e., facing it).\n      if is_primitive_directly_facing(current_pos, current_dir):\n          shortest_path_to_facing_state = path_actions\n          break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # A. Try Moving Forward:\n      move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n      next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_state_fwd = (next_pos_fwd, current_dir) # Direction remains unchanged.\n\n      if is_cell_traversable(next_r_fwd, next_c_fwd) and next_state_fwd not in visited:\n          visited.add(next_state_fwd)\n          queue.append((next_state_fwd, path_actions + [MOVE_FORWARD_ACTION]))\n\n      # B. Try Turning Left:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (current_pos, next_dir_left) # Position remains unchanged.\n\n      if next_state_left not in visited:\n          visited.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT_ACTION]))\n\n      # C. Try Turning Right:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (current_pos, next_dir_right) # Position remains unchanged.\n\n      if next_state_right not in visited:\n          visited.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a valid path to a primitive-facing state was found,\n  # extend the actions list with this path and append the final 'USE' action.\n  if shortest_path_to_facing_state is not None:\n      actions_list.extend(shortest_path_to_facing_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:39:36.773441", "function_name": "collect", "function_body": "  actions_list = [] # This will store the final sequence of actions.\n\n  # Retrieve current state information from the environment.\n  current_state = env._current_state \n  grid_snapshot = current_state.grid       # The 3D NumPy array representing the world grid.\n  initial_pos = current_state.pos          # Agent's starting (row, col) coordinates.\n  initial_dir = current_state.dir          # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN).\n\n  # Convert the primitive's string name to its integer ID using the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Pre-check: If the primitive is invalid (not in index) or not a grabbable item,\n  # it cannot be collected. Return an empty list immediately.\n  # Grabbable items are those that can be picked up using the 'USE' action.\n  if primitive_id is None or primitive_id not in current_state.world.grabbable_indices: \n      return []\n\n  # Get grid dimensions (height, width) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = grid_snapshot.shape \n\n  # Map symbolic action names to their corresponding integer IDs, as defined by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # 'UP' action typically means moving forward relative to agent's facing.\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']     # Action to collect an item in front.\n\n  # Define directional vectors for agent movement based on its current facing direction.\n  # (direction: (delta_row, delta_col))\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (0): Moves one column to the right.\n      1: (-1, 0),  # Facing UP (1): Moves one row up (decreasing row index).\n      2: (0, -1),  # Facing LEFT (2): Moves one column to the left.\n      3: (1, 0)    # Facing DOWN (3): Moves one row down (increasing row index).\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # (current_direction: new_direction)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycles: RIGHT -> UP -> LEFT -> DOWN -> RIGHT (counter-clockwise)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycles: RIGHT -> DOWN -> LEFT -> UP -> RIGHT (clockwise)\n\n  # Get the set of entity indices that the agent cannot walk through (e.g., water, workshops, boundaries).\n  # These are defined as non-grabbable items that act as obstacles.\n  non_walkable_obstacles = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within grid boundaries.\n  def _is_valid_grid_coord(r, c):\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  # Helper function to check if a cell at (r, c) is traversable.\n  # An agent cannot walk onto an obstacle or onto the item it intends to collect.\n  def _is_cell_traversable(r, c):\n      if not _is_valid_grid_coord(r, c):\n          return False\n      \n      # Check for presence of non-walkable obstacles.\n      for kind_idx in non_walkable_obstacles:\n          if grid_snapshot[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent must stand *adjacent* to the primitive to collect it, not on top of it.\n      if grid_snapshot[r, c, primitive_id] > 0:\n          return False # Cannot walk onto the target primitive itself.\n          \n      return True\n  \n  # Helper function to check if the target primitive is directly in front of the agent.\n  # This defines the \"goal state\" for our BFS pathfinding: a state from which 'USE' can be called.\n  def _is_primitive_facing(agent_pos, agent_dir):\n      r, c = agent_pos\n      # Calculate coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[agent_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is valid and contains the primitive.\n      if not _is_valid_grid_coord(front_r, front_c):\n          return False\n      \n      return grid_snapshot[front_r, front_c, primitive_id] > 0\n\n  # BFS Setup:\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (agent_position_tuple, agent_direction_int) to avoid redundant\n  # exploration and cycles, ensuring the shortest path is found.\n  visited_states = {(initial_pos, initial_dir)}\n\n  shortest_path_to_primitive_facing_state = None # To store the found path before the final 'USE' action.\n\n  # Begin BFS.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      \n      # Check if the current state is one from which the primitive can be collected.\n      if _is_primitive_facing(current_pos, current_dir):\n          shortest_path_to_primitive_facing_state = path_actions\n          break # Shortest path found, exit BFS.\n\n      # Explore possible next actions (Move Forward, Turn Left, Turn Right).\n\n      # 1. Try Moving Forward\n      move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n      next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_fwd = (next_r_fwd, next_c_fwd)\n      next_dir_fwd = current_dir # Direction does not change on move.\n\n      if _is_cell_traversable(next_r_fwd, next_c_fwd):\n          next_state_fwd = (next_pos_fwd, next_dir_fwd)\n          if next_state_fwd not in visited_states:\n              visited_states.add(next_state_fwd)\n              queue.append((next_state_fwd, path_actions + [MOVE_FORWARD]))\n\n      # 2. Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_state_left = (current_pos, next_dir_left) # Position remains same.\n\n      if next_state_left not in visited_states:\n          visited_states.add(next_state_left)\n          queue.append((next_state_left, path_actions + [TURN_LEFT]))\n\n      # 3. Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_state_right = (current_pos, next_dir_right) # Position remains same.\n\n      if next_state_right not in visited_states:\n          visited_states.add(next_state_right)\n          queue.append((next_state_right, path_actions + [TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path was found to a primitive-facing state, append the final 'USE' action.\n  if shortest_path_to_primitive_facing_state is not None:\n      actions_list.extend(shortest_path_to_primitive_facing_state)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:40:21.139470", "function_name": "collect", "function_body": "  actions_to_take = []\n  current_state = env._current_state\n\n  # Extract current state information\n  grid = current_state.grid  # (rows, columns, kinds) numpy array\n  initial_pos = current_state.pos  # (row, col) tuple\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for agent directions and their corresponding (delta_row, delta_col) movements.\n  # This maps a direction integer to how coordinates change when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: (row, col+1)\n      1: (-1, 0),  # UP: (row-1, col)\n      2: (0, -1),  # LEFT: (row, col-1)\n      3: (1, 0)    # DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {\n      0: 1,  # Right -> Up\n      1: 2,  # Up -> Left\n      2: 3,  # Left -> Down\n      3: 0   # Down -> Right\n  }\n  TURN_RIGHT_MAP = {\n      0: 3,  # Right -> Down\n      1: 0,  # Up -> Right\n      2: 1,  # Left -> Up\n      3: 2   # Down -> Left\n  }\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # Convert to a list for consistent indexing with numpy.\n  non_walkable_kind_indices = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a given (row, col) is within the grid boundaries.\n  def is_in_bounds(r: int, c: int) -> bool:\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  # Helper function to determine if the agent can move onto a specific cell.\n  # A cell is NOT walkable if it's out of bounds, contains any non-grabbable entity,\n  # or contains the target primitive itself (agent must be adjacent to 'use', not on top).\n  def is_walkable(r: int, c: int) -> bool:\n      if not is_in_bounds(r, c):\n          return False\n      \n      # Agent cannot walk directly onto the primitive it wants to collect.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-grabbable entity that blocks movement.\n      # np.sum is efficient for checking if any of the specified kinds are present.\n      if non_walkable_kind_indices and np.sum(grid[r, c, non_walkable_kind_indices]) > 0:\n          return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  visited_states = {(initial_pos, initial_dir)}\n\n  path_to_primitive_adjacency = None # Stores the action sequence to be adjacent and facing the primitive.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we have found the target 'adjacency' state.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + dr_front, current_col + dc_front\n      \n      # Verify the cell in front is within bounds and contains the target primitive.\n      if (is_in_bounds(front_cell_row, front_cell_col) and \n          grid[front_cell_row, front_cell_col, primitive_id] > 0):\n          \n          path_to_primitive_adjacency = path_so_far\n          break # Target found, exit the BFS loop.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right)\n      #    and add valid, unvisited next states to the queue.\n\n      # A. Try Move Forward action:\n      next_row_move, next_col_move = current_row + dr_front, current_col + dc_front\n      next_pos_move = (next_row_move, next_col_move)\n      next_dir_move = current_dir # Direction doesn't change when moving straight.\n\n      if (is_walkable(next_row_move, next_col_move) and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          visited_states.add((next_pos_move, next_dir_move))\n          queue.append(((next_pos_move, next_dir_move), path_so_far + [ACTION_MOVE_FORWARD]))\n\n      # B. Try Turn Left action:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position remains unchanged when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [ACTION_TURN_LEFT]))\n\n      # C. Try Turn Right action:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position remains unchanged when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to being adjacent to the primitive was found, append the 'USE' action\n  # to the collected path to finalize the primitive collection.\n  if path_to_primitive_adjacency is not None:\n      actions_to_take.extend(path_to_primitive_adjacency)\n      actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:40:22.496487", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Extract grid, agent's initial position, and direction from the current state.\n  grid = current_state.grid  # numpy.ndarray of shape (rows, columns, kinds)\n  initial_pos = current_state.pos  # (row, col) tuple\n  initial_dir = current_state.dir  # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks.\n  num_rows, num_cols, _ = grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for agent directions and their corresponding (delta_row, delta_col) movements.\n  # This maps a direction integer to how coordinates change when moving \"forward\".\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kind_indices = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a given (row, col) is within the grid boundaries.\n  def is_in_bounds(r: int, c: int) -> bool:\n      return 0 <= r < num_rows and 0 <= c < num_cols\n\n  # Helper function to determine if the agent can move onto a specific cell.\n  # A cell is NOT walkable if it's out of bounds, contains any non-grabbable entity,\n  # or contains the target primitive itself (agent must be adjacent to 'use', not on top).\n  def is_cell_walkable(r: int, c: int) -> bool:\n      if not is_in_bounds(r, c):\n          return False\n      \n      # Agent cannot walk directly onto the primitive it wants to collect.\n      if grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-grabbable entity that blocks movement.\n      for kind_idx in non_walkable_kind_indices:\n          if grid[r, c, kind_idx] > 0:\n              return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations\n  # and prevent cycles, ensuring the shortest path is found.\n  visited_states = {(initial_pos, initial_dir)}\n\n  path_to_primitive_adjacency = None # This will store the sequence of actions to reach the state where the primitive is in front.\n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we have found the target 'adjacency' state, and the path to reach it.\n      delta_r_front, delta_c_front = DIR_TO_DELTA_RC[current_dir]\n      front_cell_row, front_cell_col = current_row + delta_r_front, current_col + delta_c_front\n      \n      # Verify the cell in front is within bounds and contains the target primitive.\n      if (is_in_bounds(front_cell_row, front_cell_col) and \n          grid[front_cell_row, front_cell_col, primitive_id] > 0):\n          \n          path_to_primitive_adjacency = path_taken\n          break # Target found, exit the BFS loop.\n\n      # 2. Explore possible next actions (Move Forward, Turn Left, Turn Right)\n      #    from the current state and add valid, unvisited next states to the queue.\n\n      # A. Try Move Forward action:\n      next_row_move, next_col_move = current_row + delta_r_front, current_col + delta_c_front\n      next_pos_move = (next_row_move, next_col_move)\n      next_dir_move = current_dir # Agent's direction remains unchanged after moving straight.\n\n      if (is_cell_walkable(next_row_move, next_col_move) and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          visited_states.add((next_pos_move, next_dir_move))\n          queue.append(((next_pos_move, next_dir_move), path_taken + [ACTION_MOVE_FORWARD]))\n\n      # B. Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Agent's position remains unchanged when turning.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [ACTION_TURN_LEFT]))\n\n      # C. Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Agent's position remains unchanged when turning.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [ACTION_TURN_RIGHT]))\n\n  # After BFS completes:\n  # If a path to being adjacent to the primitive was found, append the 'USE' action\n  # to the collected path to finalize the primitive collection.\n  if path_to_primitive_adjacency is not None:\n      return path_to_primitive_adjacency + [ACTION_USE]\n  else:\n      # If the primitive is unreachable, return an empty list of actions.\n      return []", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:41:25.886800", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mappings from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # If the primitive name does not correspond to a valid ID, return an empty list\n  if primitive_id is None: \n      return []\n\n  # Indices of entities that cannot be walked upon (e.g., water, workshops, stone)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Define constants for agent movement and rotation\n  # DIR_TO_DRDC: Maps agent's direction (0:R, 1:U, 2:L, 3:D) to (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n  # TURN_LEFT_MAP: Maps current direction to new direction after turning left\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  # TURN_RIGHT_MAP: Maps current direction to new direction after turning right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  def _is_target_state(pos, current_dir):\n      \"\"\"Checks if the agent, at `pos` and `current_dir`, is positioned such that\n      the target primitive is directly in front and can be collected.\n      \"\"\"\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Check if the cell in front is within grid boundaries\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False \n      \n      # Check if the cell directly in front contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_walkable_cell(pos):\n      \"\"\"Checks if the given cell (row, col) is traversable by the agent.\"\"\"\n      r, c = pos\n      # Check if the cell is within grid boundaries\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # A cell is not walkable if it contains any non-grabbable entity\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive it's trying to collect;\n      # it must stop adjacent to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  # Breadth-First Search (BFS) to find the shortest path to the primitive.\n  # The state in BFS is (agent_position, agent_direction).\n  \n  # Queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])]) \n  \n  # Visited set stores (agent_position_tuple, agent_direction_int) to prevent cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the shortest sequence of actions to reach a targetable state\n\n  # First, check if the agent is already in a position to collect the primitive (e.g., primitive is right in front)\n  if _is_target_state(initial_pos, initial_dir):\n      target_path = [] # No movement actions needed, just the USE action will follow\n\n  # If not immediately at the target, perform BFS to find the path\n  if target_path is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n\n          # Explore possible next states by trying each action: Move Forward, Turn Left, Turn Right\n          \n          # 1. Try to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          next_dir_move = current_dir # Direction doesn't change on move\n\n          if _is_walkable_cell(next_pos_move):\n              new_state_node = (next_pos_move, next_dir_move)\n              if new_state_node not in visited:\n                  visited.add(new_state_node)\n                  new_path_actions = path_actions + [MOVE_FORWARD_ACTION]\n                  \n                  # Check if this new state allows collecting the primitive\n                  if _is_target_state(next_pos_move, next_dir_move):\n                      target_path = new_path_actions\n                      break # Found the shortest path, exit BFS\n                  \n                  queue.append((new_state_node, new_path_actions))\n\n          # 2. Try to Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_node_left = (current_pos, next_dir_left) # Position remains same, only direction changes\n          if new_state_node_left not in visited:\n              visited.add(new_state_node_left)\n              new_path_actions_left = path_actions + [TURN_LEFT_ACTION]\n              \n              # Check if this new state allows collecting the primitive\n              if _is_target_state(current_pos, next_dir_left):\n                  target_path = new_path_actions_left\n                  break # Found the shortest path, exit BFS\n              \n              queue.append((new_state_node_left, new_path_actions_left))\n\n          # 3. Try to Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_node_right = (current_pos, next_dir_right) # Position remains same, only direction changes\n          if new_state_node_right not in visited:\n              visited.add(new_state_node_right)\n              new_path_actions_right = path_actions + [TURN_RIGHT_ACTION]\n              \n              # Check if this new state allows collecting the primitive\n              if _is_target_state(current_pos, next_dir_right):\n                  target_path = new_path_actions_right\n                  break # Found the shortest path, exit BFS\n              \n              queue.append((new_state_node_right, new_path_actions_right))\n          \n          if target_path is not None:\n              break # Exit BFS if path found in any of the explorations\n\n  # If a path to a targetable state was found, append the final USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:41:27.156004", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # --- Action Mappings from CraftLab environment ---\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # --- Identify the primitive's ID and non-walkable entities ---\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      # This primitive name is not recognized in the world's index.\n      # This case should ideally be prevented by the DSL's validation.\n      return [] \n\n  # Entities that the agent cannot walk over (e.g., water, stone, workshops).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Movement Constants ---\n  # Direction mapping: (dr, dc) defines coordinate changes for each facing direction.\n  # 0:Right, 1:Up, 2:Left, 3:Down\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: positive column\n      1: (-1, 0),  # Facing UP: negative row\n      2: (0, -1),  # Facing LEFT: negative column\n      3: (1, 0)    # Facing DOWN: positive row\n  }\n  # Maps for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # --- Define the BFS State Node for clarity ---\n  # An AgentState node in the BFS represents the agent's (position, direction).\n  AgentState = collections.namedtuple('AgentState', ['pos', 'direction'])\n\n  # --- Helper Functions (using closure for grid data, IDs, and constants) ---\n\n  def _is_valid_coords(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates are within the environment's bounds.\"\"\"\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  def _is_collectable_in_front(agent_state: AgentState) -> bool:\n      \"\"\"Checks if the primitive is directly in front of the agent, making it\n      ready to be 'USE'd (collected) from the current agent_state.\"\"\"\n      r, c = agent_state.pos\n      current_dir = agent_state.direction\n      \n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Check if the cell in front is within bounds\n      if not _is_valid_coords(front_r, front_c):\n          return False \n      \n      # Check if the cell in front contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_walkable_cell(pos_tuple: tuple[int, int]) -> bool:\n      \"\"\"Checks if the given cell (row, col) can be entered and occupied by the agent.\n      Agent cannot walk onto non-grabbable items or the primitive it intends to collect.\"\"\"\n      r, c = pos_tuple\n      if not _is_valid_coords(r, c):\n          return False\n      \n      # A cell is not walkable if it contains any entity that is non-grabbable.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent must stand adjacent to the primitive to collect it, not on top of it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  # --- Breadth-First Search (BFS) Implementation ---\n  # BFS finds the shortest sequence of (move/turn) actions to reach a state\n  # where the target primitive is directly in front of the agent.\n\n  start_agent_state = AgentState(pos=initial_pos, direction=initial_dir)\n  \n  # Queue stores (AgentState, list_of_actions_to_reach_this_state).\n  # `AgentState` (pos, direction) represents a unique node in the search graph.\n  queue = collections.deque([(start_agent_state, [])]) \n  \n  # Set of `AgentState`s already visited to prevent cycles and re-exploring longer paths.\n  visited = {start_agent_state}\n\n  shortest_path_to_primitive_adjacent = None \n\n  # 1. First, check if the agent is already in a state to collect the primitive.\n  if _is_collectable_in_front(start_agent_state):\n      shortest_path_to_primitive_adjacent = [] # No movement actions needed\n\n  # 2. If not immediately collectable, perform BFS to find the path.\n  if shortest_path_to_primitive_adjacent is None:\n      while queue:\n          current_agent_state, path_actions = queue.popleft()\n\n          # Explore possible next agent states by taking one action (move forward, turn left, turn right).\n          \n          # Try moving forward:\n          move_dr, move_dc = DIR_TO_DRDC[current_agent_state.direction]\n          next_r_move, next_c_move = current_agent_state.pos[0] + move_dr, current_agent_state.pos[1] + move_dc\n          next_pos_move = (next_r_move, next_c_move)\n          next_agent_state_move = AgentState(pos=next_pos_move, direction=current_agent_state.direction) # Direction is unchanged\n          \n          if _is_walkable_cell(next_pos_move) and next_agent_state_move not in visited:\n              visited.add(next_agent_state_move)\n              new_path_actions = path_actions + [MOVE_FORWARD_ACTION]\n              \n              if _is_collectable_in_front(next_agent_state_move):\n                  shortest_path_to_primitive_adjacent = new_path_actions\n                  break # Path found, exit BFS\n              \n              queue.append((next_agent_state_move, new_path_actions))\n\n          # Try turning left:\n          next_dir_left = TURN_LEFT_MAP[current_agent_state.direction]\n          next_agent_state_left = AgentState(pos=current_agent_state.pos, direction=next_dir_left) # Position unchanged\n          if next_agent_state_left not in visited:\n              visited.add(next_agent_state_left)\n              new_path_actions = path_actions + [TURN_LEFT_ACTION]\n\n              if _is_collectable_in_front(next_agent_state_left):\n                  shortest_path_to_primitive_adjacent = new_path_actions\n                  break # Path found, exit BFS\n              \n              queue.append((next_agent_state_left, new_path_actions))\n\n          # Try turning right:\n          next_dir_right = TURN_RIGHT_MAP[current_agent_state.direction]\n          next_agent_state_right = AgentState(pos=current_agent_state.pos, direction=next_dir_right) # Position unchanged\n          if next_agent_state_right not in visited:\n              visited.add(next_agent_state_right)\n              new_path_actions = path_actions + [TURN_RIGHT_ACTION]\n              \n              if _is_collectable_in_front(next_agent_state_right):\n                  shortest_path_to_primitive_adjacent = new_path_actions\n                  break # Path found, exit BFS\n              \n              queue.append((next_agent_state_right, new_path_actions))\n          \n          # If a path was found and the break was hit in an inner `if` block,\n          # this `break` ensures we exit the main `while queue` loop as well.\n          if shortest_path_to_primitive_adjacent is not None:\n              break \n\n  # 3. Finalize the action list: If a path was found, append the final USE action.\n  if shortest_path_to_primitive_adjacent is not None:\n      actions_list.extend(shortest_path_to_primitive_adjacent)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:42:31.464343", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version adds a check to ensure the primitive is grabbable and\n  further clarifies the pathfinding logic with detailed comments.\n\n  Args:\n      env (env.CraftLab): The CraftLab object.\n      primitive (str): The name of the primitive to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's initial direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None:\n      # This case indicates the primitive name is not recognized by the world.\n      # Though the DSL context implies valid primitive names, it's a defensive check.\n      return [] \n  \n  # Essential check: If the item is not grabbable (e.g., \"water\", \"stone\", \"WORKSHOP0\"),\n  # it cannot be 'collected' using the 'USE' action.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Define Action Mappings from the environment's action space\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' moves forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect the item\n\n  # 3. Define Movement and Turning Constants\n  # Maps agent's direction (0-3) to a change in row (dr) and column (dc) for a forward move.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move positive in column (c+1)\n      1: (-1, 0),  # Facing UP (1): move negative in row (r-1)\n      2: (0, -1),  # Facing LEFT (2): move negative in column (c-1)\n      3: (1, 0)    # Facing DOWN (3): move positive in row (r+1)\n  }\n  # Maps current direction to new direction after turning left.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # Maps current direction to new direction after turning right.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Indices of entities that the agent cannot walk over (e.g., boundaries, water, workshops).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for BFS Pathfinding\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates (r, c) are within the valid bounds.\"\"\"\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"Checks if the given cell (r, c) is traversable by the agent.\n      An agent cannot walk onto non-grabbable entities or directly onto the primitive\n      it intends to collect (it must stop adjacent to it).\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check if the cell contains any non-grabbable (and thus non-walkable) entities.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent must be adjacent to, not on top of, the primitive to collect it.\n      # Therefore, a cell containing the primitive itself is not a walkable destination for the agent's body.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  def _is_target_facing(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"Checks if, from the given position and direction, the target primitive\n      is directly in front of the agent, making it ready for a 'USE' action.\n      \"\"\"\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir] # Get the relative coordinates for the cell in front\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # The cell in front is outside grid boundaries\n      \n      # The primitive must be present in the cell directly in front of the agent.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) Implementation\n\n  # BFS state is represented as: ((row, col), direction).\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration and cycles,\n  # ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_movement_actions = None # This will store the sequence of actions to reach the 'ready-to-use' state.\n\n  # Optimization: Check if the agent is already in the target state at the beginning.\n  if _is_target_facing(initial_pos, initial_dir):\n      target_movement_actions = [] # No prior movement actions are needed.\n\n  # If not immediately at the target, perform BFS to find the shortest path.\n  if target_movement_actions is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n          \n          # 5a. Try Moving Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          next_dir_move = current_dir # Direction remains unchanged when moving.\n\n          if _is_walkable_cell(next_pos_move): # Check if the intended next cell is traversable.\n              new_state = (next_pos_move, next_dir_move)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [MOVE_FORWARD_ACTION]\n                  # If this new state is the target state, we found the shortest path.\n                  if _is_target_facing(next_pos_move, next_dir_move):\n                      target_movement_actions = new_path\n                      break # Exit BFS, as the shortest path is found.\n                  queue.append((new_state, new_path)) # Add to queue for further exploration.\n\n          # 5b. Try Turning Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes.\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              # If this new state is the target state, we found the shortest path.\n              if _is_target_facing(current_pos, next_dir_left):\n                  target_movement_actions = new_path_left\n                  break # Exit BFS.\n              queue.append((new_state_left, new_path_left))\n\n          # 5c. Try Turning Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes.\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              # If this new state is the target state, we found the shortest path.\n              if _is_target_facing(current_pos, next_dir_right):\n                  target_movement_actions = new_path_right\n                  break # Exit BFS.\n              queue.append((new_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List\n  # If a path was successfully found (either immediately or via BFS), append the final 'USE' action.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:42:32.750253", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # 0:R, 1:U, 2:L, 3:D\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # 1. Define Action Mappings\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 2. Define Movement Constants\n  # Direction to Delta Row/Delta Column for agent movement\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, moves to (r, c+1)\n      1: (-1, 0),  # Facing UP, moves to (r-1, c)\n      2: (0, -1),  # Facing LEFT, moves to (r, c-1)\n      3: (1, 0)    # Facing DOWN, moves to (r+1, c)\n  }\n  # Maps for turning left/right, updating agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # 3. Get Primitive ID and Check Grabbability\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: \n      # Primitive name not found in the cookbook index, cannot collect.\n      return [] \n\n  # Only items in `grabbable_indices` can be \"collected\" into inventory via the USE action.\n  # For example, workshops or water are not grabbable.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] \n\n  # Indices of entities that cannot be walked upon by the agent\n  # These typically include boundary, water, stone, and workshops.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if coordinates are within grid bounds\n  def _is_valid_coord(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Helper function to check if a cell is traversable by the agent\n  def _is_walkable_cell(pos):\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False # Cell is out of grid bounds\n      \n      # A cell is not walkable if it contains any non-grabbable entity (obstacle).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # For collecting, the agent must stop ADJACENT to the primitive, not on top of it.\n      # So, a cell containing the primitive itself is considered non-walkable for pathfinding.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Helper function to check if the agent is positioned and facing the target primitive\n  # such that a 'USE' action would collect it.\n  def _is_target_facing(pos, current_dir):\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # Cell in front is out of grid bounds\n      \n      # Check if the cell directly in front of the agent contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # Breadth-First Search (BFS) to find the shortest path of movement/turning actions\n  # to reach a state where the agent is adjacent to and facing the primitive.\n  def _bfs_find_path():\n      # Queue stores: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n      queue = collections.deque([((initial_pos, initial_dir), [])])\n      # Visited set stores: (position_tuple, direction_int) to prevent redundant exploration and cycles.\n      visited = {(initial_pos, initial_dir)}\n\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n          \n          # If the current state allows collection, we've found the shortest path to this state.\n          if _is_target_facing(current_pos, current_dir):\n              return path_actions \n\n          # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n          \n          # 1. Attempt to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_move = (next_r, next_c)\n          next_dir_move = current_dir # Direction doesn't change when moving\n\n          if _is_walkable_cell(next_pos_move): # Check if the next cell is traversable\n              new_state = (next_pos_move, next_dir_move)\n              if new_state not in visited:\n                  visited.add(new_state)\n                  new_path = path_actions + [MOVE_FORWARD_ACTION]\n                  queue.append((new_state, new_path))\n\n          # 2. Attempt to Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_actions + [TURN_LEFT_ACTION]\n              queue.append((new_state_left, new_path_left))\n\n          # 3. Attempt to Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_actions + [TURN_RIGHT_ACTION]\n              queue.append((new_state_right, new_path_right))\n      \n      return None # No path found to reach a state where the primitive can be collected\n\n  # --- Main logic for `collect_v2` ---\n  target_movement_actions = None\n\n  # First, check if the agent is already in the optimal state for collection (adjacent and facing).\n  if _is_target_facing(initial_pos, initial_dir):\n      target_movement_actions = [] # No prior movement actions are needed\n\n  # If not already in position, perform BFS to find the shortest path of movement actions.\n  if target_movement_actions is None:\n      target_movement_actions = _bfs_find_path()\n\n  # If a path was successfully found (or it was an immediate goal), append the final USE action.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:42:55.128767", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer ID for the specified primitive name.\n  # This relies on the cookbook's index mapping string names to integer IDs.\n  primitive_id = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve the integer codes for movement and interaction actions from the environment's action specifications.\n  action_codes = env.action_specs()\n  UP = action_codes['UP']\n  DOWN = action_codes['DOWN']\n  LEFT = action_codes['LEFT']\n  RIGHT = action_codes['RIGHT']\n  USE = action_codes['USE']\n\n  # --- Step 1: Immediate Collection Check ---\n  # If the agent is already in a position where it can use/collect the primitive\n  # (i.e., within a 3x3 neighborhood of an item of that kind), return a single 'USE' action.\n  if current_state.next_to(primitive_id):\n    return [USE]\n\n  # --- Step 2: Locate all instances of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # A list to store (x, y) coordinates where the primitive is present.\n  primitive_locations_on_grid = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the count of the primitive at this cell is greater than zero.\n      if grid[x, y, primitive_id] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Step 3: Determine target \"collection\" cells ---\n  # These are the cells from which the agent can execute the 'USE' action to collect the primitive.\n  # This includes any cell within the 3x3 neighborhood of a primitive's location.\n  valid_use_positions = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through a 3x3 square centered at (px, py)\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        tx, ty = px + dx, py + dy # Calculate the potential target cell coordinates\n        \n        # Ensure the potential target cell is within the grid boundaries.\n        if 0 <= tx < grid_width and 0 <= ty < grid_height:\n          valid_use_positions.add((tx, ty))\n\n  # --- Step 4: Identify impassable cell types for movement ---\n  # CraftWorld defines certain non-grabbable items (excluding workshops, which are traversable)\n  # as obstacles for agent movement.\n  impassable_object_ids = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- Step 5: Perform Breadth-First Search (BFS) for the shortest path ---\n  # The goal is to find the shortest sequence of movement actions to reach any `valid_use_positions`.\n  start_agent_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_to_reach_current_position).\n  bfs_queue = collections.deque([(start_agent_pos, [])]) \n  # Set to keep track of visited grid positions to avoid cycles and redundant paths.\n  visited_grid_positions = {start_agent_pos} \n\n  # Define the cardinal movement deltas and their corresponding action codes.\n  # This mapping helps in exploring neighbors efficiently during BFS.\n  movement_deltas_actions = [\n      ((0, -1), UP),    # North: (x, y-1)\n      ((0, 1), DOWN),   # South: (x, y+1)\n      ((-1, 0), LEFT),  # West:  (x-1, y)\n      ((1, 0), RIGHT),  # East:  (x+1, y)\n  ]\n\n  while bfs_queue:\n    (current_x, current_y), path_taken = bfs_queue.popleft() \n\n    # If the current position is one of our valid collection points,\n    # we've found the shortest path. Append 'USE' and return.\n    if (current_x, current_y) in valid_use_positions:\n      return path_taken + [USE]\n\n    # Explore all four cardinal neighbors from the current position.\n    for (dx, dy), action_code in movement_deltas_actions:\n      next_x, next_y = current_x + dx, current_y + dy\n      next_position = (next_x, next_y)\n\n      # Check 1: Boundary check - Is the next position within the grid?\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Traversability check - Is the next position blocked by an impassable object?\n      is_blocked = False\n      for obj_id in impassable_object_ids:\n          # If an impassable object is present at (next_x, next_y) with a count > 0, it's blocked.\n          if grid[next_x, next_y, obj_id] > 0: \n              is_blocked = True\n              break # No need to check further object IDs for this cell.\n      \n      if is_blocked:\n          continue # Skip if the cell is blocked.\n\n      # Check 3: Visited check - Has this position already been explored?\n      if next_position not in visited_grid_positions:\n        visited_grid_positions.add(next_position) # Mark as visited.\n        # Enqueue the new position along with the updated path.\n        bfs_queue.append((next_position, path_taken + [action_code]))\n\n  # If the BFS completes and the queue becomes empty without finding any path\n  # to a `valid_use_positions`, it means the primitive is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:42:56.435087", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Map the string name of the primitive to its corresponding integer index.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get the integer codes for movement and interaction actions.\n  action_codes = env.action_specs()\n  UP = action_codes['UP']\n  DOWN = action_codes['DOWN']\n  LEFT = action_codes['LEFT']\n  RIGHT = action_codes['RIGHT']\n  USE = action_codes['USE']\n\n  # 1. Immediate Collection Check:\n  # If the agent is currently adjacent to or on the same cell as the primitive,\n  # it only needs to perform the 'USE' action.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Locate all instances of the primitive on the game grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # A primitive is considered present at (x,y) if its count is greater than 0.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's unreachable.\n  if not primitive_locations:\n    return []\n\n  # 3. Determine \"Goal Positions\" for the agent.\n  # These are any cells from which the agent can use the 'USE' action to collect the primitive.\n  # This includes any cell within a 3x3 neighborhood of a primitive's location.\n  agent_goal_positions = set()\n  for px, py in primitive_locations:\n    # Check 3x3 neighborhood around the primitive.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal position is within grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          agent_goal_positions.add((gx, gy))\n\n  # 4. Identify entity kinds that block agent movement.\n  # Non-grabbable items are generally impassable, except for workshops, which are non-grabbable\n  # but typically traversable by the agent.\n  movement_blocking_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current location to any of the defined goal positions.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores tuples of (current_position, list_of_actions_to_reach_this_position).\n  bfs_queue = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant computations.\n  visited_cells = {start_pos} \n\n  # Define cardinal movements and their corresponding action indices.\n  # (delta_x, delta_y), action_code\n  move_directions = [\n      ((0, -1), UP),    # North\n      ((0, 1), DOWN),   # South\n      ((-1, 0), LEFT),  # West\n      ((1, 0), RIGHT),  # East\n  ]\n\n  while bfs_queue:\n    current_pos, path_so_far = bfs_queue.popleft() \n    cx, cy = current_pos\n\n    # If the current position is one of our goal positions, we found the shortest path.\n    if current_pos in agent_goal_positions:\n      # Append the 'USE' action as the final step to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in move_directions:\n      nx, ny = cx + dx, cy + dy # Calculate the new position\n      next_pos = (nx, ny)\n\n      # Check 1: Is the new position within grid boundaries?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Is the new position traversable (i.e., not blocked by an impassable kind)?\n      is_blocked = False\n      for kind_idx in movement_blocking_kinds:\n          # If a blocking kind is present at the new cell, it's impassable.\n          if grid[nx, ny, kind_idx] > 0: \n              is_blocked = True\n              break\n      \n      if is_blocked:\n          continue # Skip if the cell is blocked.\n\n      # Check 3: Has this position already been visited during the BFS?\n      if next_pos not in visited_cells:\n        visited_cells.add(next_pos) # Mark as visited\n        # Add the new position and the updated path to the queue for further exploration.\n        bfs_queue.append((next_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue is empty without reaching any goal position,\n  # it means the primitive is unreachable from the agent's current location.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:43:39.371240", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This implementation uses Breadth-First Search (BFS) to find the shortest\n    sequence of movements and turns to reach a position adjacent to the primitive\n    and facing it, followed by a 'USE' action.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive resource to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute in the environment.\n                   Returns an empty list if the primitive is not recognized or unreachable.\n  \"\"\"\n  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment.\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # This ID is used to locate the primitive on the grid.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized by the world's cookbook,\n      # it cannot be collected. Return an empty list of actions.\n      # print(f\"Warning: Primitive '{primitive}' not found in cookbook index.\") # For debugging\n      return []\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  # This makes the code more readable and robust to changes in action mapping.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed to move agent one step in current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Rotates agent 90 degrees left (counter-clockwise).\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Rotates agent 90 degrees right (clockwise).\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front (collects primitive).\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  # These deltas are applied to the agent's current position to find the cell\n  # directly in front of the agent (for 'USE' action) or where it would move.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col + 1).\n      1: (-1, 0),  # Facing UP: -1 to row (row - 1).\n      2: (0, -1),  # Facing LEFT: -1 to column (col - 1).\n      3: (1, 0)    # Facing DOWN: +1 to row (row + 1).\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  # The agent cannot move into these cells. Examples: 'BOUNDARY', 'WATER', 'WORKSHOP'.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  # This allows us to reconstruct the path once the target is found.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to prevent redundant exploration\n  # and ensure that the first path found by BFS is indeed the shortest path.\n  visited = {(initial_pos, initial_dir)}\n\n  # Variable to store the actions leading to the state where the agent is adjacent to\n  # and facing the primitive. Initialized to None, indicating no path found yet.\n  path_to_adjacent_primitive = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the current state is a \"goal state\" for collection:\n      # A goal state is defined as being positioned such that the target primitive\n      # is directly in front of the agent (and thus can be collected with 'USE').\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell directly in front is within grid bounds.\n      if 0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS:\n          # Check if the cell in front contains the target primitive.\n          # The value initial_grid[r, c, kind_id] > 0 means that 'kind_id' exists at (r,c).\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Shortest path to a 'USE' position found! Exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move, Turn Left, Turn Right.\n      # For each action, calculate the next state (position and direction) and check if it's valid and new.\n\n      # --- Try Move Forward (UP action) ---\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains the same after moving forward.\n\n      # Check if the potential next position is valid (within bounds) and has not been visited\n      # with the same orientation (to ensure shortest path).\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is walkable if:\n          # a) It does not contain any non-grabbable entities (e.g., water, boundary).\n          # b) It is NOT the target primitive itself. The agent typically stands *next* to,\n          #    not *on*, the primitive to collect it with 'USE'.\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, ensure the agent doesn't walk onto the primitive it intends to collect.\n          if is_walkable and initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              # Add the new state to visited and queue if it's a valid move.\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left (LEFT action) ---\n      # Calculate new direction for counter-clockwise rotation:\n      # R(0) -> U(1), U(1) -> L(2), L(2) -> D(3), D(3) -> R(0)\n      next_dir_left = (current_dir + 1) % 4\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right (RIGHT action) ---\n      # Calculate new direction for clockwise rotation:\n      # R(0) -> D(3), U(1) -> R(0), L(2) -> U(1), D(3) -> L(2)\n      # Adding 4 ensures the result is positive before modulo for Python's % operator.\n      next_dir_right = (current_dir - 1 + 4) % 4 \n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection process.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found or was unreachable.\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:43:40.620214", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the internal CraftState object\n\n  # Extract essential information from the current state for pathfinding\n  initial_grid = current_state.grid # The static grid layout\n  initial_pos = current_state.pos   # Agent's current (row, col) position\n  initial_dir = current_state.dir   # Agent's current facing direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  # Use try-except for robustness, though the DSL implies valid primitive names.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # Return an empty list of actions in this case.\n      return []\n\n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names to their integer indices for robustness and clarity\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Assumed to move agent one step in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Rotates agent 90 degrees left (counter-clockwise)\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Rotates agent 90 degrees right (clockwise)\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front\n\n  # Pre-defined changes in (row, col) for each direction\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Set of entity kinds that represent non-walkable terrain (e.g., boundaries, water, workshops)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # BFS Initialization\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set: stores (position_tuple, direction_int) to prevent redundant exploration\n  # and guarantee the shortest path is found for unweighted edges.\n  visited = {(initial_pos, initial_dir)}\n\n  # Stores the path found to the goal state (adjacent and facing the primitive)\n  path_to_adjacent_primitive = None \n\n  # Start BFS traversal\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      current_r, current_c = current_pos\n\n      # 1. Check if the current state is a \"goal state\" for collection:\n      # Is the agent positioned such that the target primitive is directly in front of it?\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = current_r + front_dr, current_c + front_dc\n      \n      # Ensure the cell directly in front is within grid bounds\n      if 0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS:\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_adjacent_primitive = path_so_far\n              break # Shortest path to a 'USE' position found!\n\n      # 2. Explore possible next actions from the current state: Move, Turn Left, Turn Right\n\n      # --- Try Move Forward ---\n      next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains the same after moving forward\n\n      # Check if the potential next position is valid and unvisited\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is walkable if it doesn't contain any non-grabbable entities\n          # AND it's not the target primitive itself (agent must stand *next* to, not *on*, the primitive).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, ensure the agent doesn't walk onto the primitive it intends to collect\n          if is_walkable and initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      # Calculate new direction using modular arithmetic for counter-clockwise rotation\n      # R(0)->U(1), U(1)->L(2), L(2)->D(3), D(3)->R(0)\n      next_dir_left = (current_dir + 1) % 4\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      # Calculate new direction using modular arithmetic for clockwise rotation\n      # R(0)->D(3), U(1)->R(0), L(2)->U(1), D(3)->L(2)\n      next_dir_right = (current_dir - 1 + 4) % 4 # Add 4 to ensure positive result before modulo\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a state where the agent is adjacent and facing the primitive,\n  # append the 'USE' action to complete the collection.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:45:07.108090", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This heuristic limit helps prevent excessively long searches in complex scenarios,\n  # especially when inventory changes are part of the state.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- V2 IMPROVEMENT: Generalized Goal Check 1 ---\n    # Goal Check 1: Check if the target primitive is directly under the agent.\n    # We remove the `i_kind in world.grabbable_indices` constraint from V1,\n    # as some primitives might be collected by USE when standing on them, even if not 'grabbable'\n    # in the strict sense (e.g., specific resource nodes like \"water\" or \"stone\" might be collected this way).\n    if state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count of i_kind increased.\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Check for primitive in adjacent cells (cardinal directions).\n    # This check remains important for items that need to be faced and interacted with (e.g., trees, workshops).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # --- V2 IMPROVEMENT: Refined `do_general_use_exploration` heuristic ---\n    # Explore the USE action from the current position generally.\n    # This is crucial for collecting items indirectly (e.g., harvesting wood from a tree),\n    # or picking up intermediate tools, or interacting with workshops.\n    # The `state.step(USE_ACT)` handles the complex game logic for what happens.\n    # This block applies a heuristic to only explore USE when an \"interesting\" object\n    # is at the agent's current position or in front of the agent.\n    do_general_use_exploration = False\n    \n    # Check if agent is currently on a relevant item. This includes the target primitive itself,\n    # any grabbable item (like a tool), any workshop, or any other primitive resource that might\n    # be interacted with via USE at the current location.\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0:\n        item_at_pos_idx = item_at_pos_idx_flat[0]\n        if (item_at_pos_idx == i_kind or # Agent is on the target primitive\n            item_at_pos_idx in world.grabbable_indices or # Agent is on a grabbable item (e.g., a tool)\n            item_at_pos_idx in world.workshop_indices or # Agent is on a workshop\n            item_at_pos_idx in world.cookbook.primitives): # Agent is on any other primitive resource (e.g. grass)\n            do_general_use_exploration = True\n    \n    # Check if agent is facing a relevant item. This covers cases where the item needs to be\n    # in front of the agent to be interacted with via USE.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx == i_kind or # Agent is facing the target primitive\n                item_in_front_idx in world.grabbable_indices or \n                item_in_front_idx in world.workshop_indices or\n                item_in_front_idx in world.cookbook.primitives): # Agent is facing any other primitive resource (e.g. tree)\n                do_general_use_exploration = True\n\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change\n        # (inventory changed, or position/direction changed). This prevents adding\n        # many redundant states where USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:45:10.809732", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES compared to v1, allowing for potentially deeper searches\n  # and more diverse inventory states in complex collection tasks.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count of i_kind increased.\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` for initial detection, then precise facing.\n    # This specifically targets cases where the primitive itself is a distinct object in the world\n    # that can be interacted with to collect it (e.g., picking up a tool, using USE on water/stone source).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is crucial for collecting items indirectly (e.g., harvesting wood from a tree),\n    # or picking up intermediate tools, or interacting with workshops.\n    # The `state.step(USE_ACT)` handles the complex game logic for what happens.\n    # We always attempt to USE and rely on the state change check to prune redundant branches.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add to queue if the USE action resulted in a meaningful state change.\n    # This is key to ensuring that the BFS explores only productive USE actions\n    # without relying on specific heuristics about what's in front/under the agent.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:45:50.337568", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Improvement for v2: Ensure the primitive is actually grabbable ===\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive is an entity that cannot be picked up (e.g., WORKSHOP, WATER, BOUNDARY),\n  # it cannot be \"collected\". In such cases, return an empty list immediately.\n  # The `grabbable_indices` is the authoritative source for what can be picked up.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to agent's facing\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This mapping is also used to determine the coordinates of the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: cell in front is (r, c+1)\n      1: (-1, 0),  # Facing UP: cell in front is (r-1, c)\n      2: (0, -1),  # Facing LEFT: cell in front is (r, c-1)\n      3: (1, 0)    # Facing DOWN: cell in front is (r+1, c)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are true obstacles that the agent cannot walk through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state (position + direction)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # === Target Condition for v2: Primitive is directly in front of the agent ===\n      # This aligns with the common understanding that 'USE' interacts with the cell ahead.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r, target_c = r + front_dr, c + front_dc\n\n      is_primitive_in_front = False\n      if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and\n          initial_grid[target_r, target_c, primitive_id] > 0):\n          is_primitive_in_front = True\n\n      if is_primitive_in_front:\n          target_path = path_actions\n          break # Path to a suitable position and direction found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # This is the same as front_dr, front_dc for movement\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it doesn't contain any non-grabbable entity (e.g., boundary, water, workshops).\n          # These are true obstacles.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # As in collect_v1 (and improved for v2), we do NOT check if the primitive itself blocks movement here.\n          # The agent can walk onto a cell containing a collectible primitive (e.g., grass, wood).\n          # This assumes that walkable primitives do not act as obstacles for movement.\n          # Only `non_grabbable_indices` (like walls, water, workshops) truly block movement.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:45:51.471951", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Ensure the primitive is actually grabbable. If it's not (e.g., a workshop or water),\n  # it cannot be \"collected\" by picking it up into inventory.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to agent's facing\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This mapping is also used to determine the coordinates of the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: cell in front is (r, c+1)\n      1: (-1, 0),  # Facing UP: cell in front is (r-1, c)\n      2: (0, -1),  # Facing LEFT: cell in front is (r, c-1)\n      3: (1, 0)    # Facing DOWN: cell in front is (r+1, c)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are true obstacles that the agent cannot walk through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state (position + direction)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at the current state.\n      # This is the target condition for the BFS: reach a state (position, direction)\n      # where the primitive is in the cell immediately ahead, so 'USE' can collect it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r, target_c = r + front_dr, c + front_dc\n\n      is_primitive_in_front = False\n      if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and\n          initial_grid[target_r, target_c, primitive_id] > 0):\n          is_primitive_in_front = True\n\n      if is_primitive_in_front:\n          target_path = path_actions\n          break # Path to a suitable position and direction found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # This is the same as front_dr, front_dc for movement\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it doesn't contain any non-grabbable entity (e.g., boundary, water, workshops).\n          # These are true obstacles. Collectible primitives (like WOOD, STONE) are generally walkable.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:46:39.656580", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index corresponding to the primitive name.\n  # Using `env.world.cookbook.index[primitive]` (which calls `__getitem__`)\n  # is preferred over `env.world.cookbook.index.index(primitive)`.\n  # `__getitem__` will return the index if the primitive is known, or None if not.\n  # `index.index()` (the method) would create a new index if the primitive isn't\n  # already registered, which is an undesirable side effect for a lookup function.\n  primitive_idx = env.world.cookbook.index[primitive] \n  \n  # If the primitive is not recognized (i.e., `primitive_idx` is None),\n  # it cannot be collected. Return an empty list of actions.\n  if primitive_idx is None:\n    return []\n\n  # --- Improvement for `collect` semantics ---\n  # If the primitive is a non-grabbable item (e.g., WATER, STONE, WORKSHOP),\n  # it cannot be \"collected\" into the inventory. The `collect` DSL primitive\n  # implies adding the item to the agent's inventory.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # If the agent's inventory already contains the primitive, no collection\n  # actions are needed. This avoids redundant movement and 'USE' actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Map action names to their integer representations.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Immediate Collection Check ---\n  # If the agent is already adjacent to the primitive, the most direct\n  # action is to simply 'USE' it. The `next_to` method checks the 3x3 neighborhood.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Locate all primitive occurrences on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive exists at the current grid cell (x, y).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not present anywhere on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Determine \"Goal Cells\" for Pathfinding ---\n  # A \"goal cell\" is any grid position from which the agent can successfully\n  # perform the 'USE' action to collect the primitive. The 'USE' action affects\n  # a 3x3 area around the agent. Thus, for each primitive instance (px, py),\n  # any cell (gx, gy) in its 3x3 neighborhood is a valid goal cell.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Breadth-First Search (BFS) for the Shortest Path ---\n  # Find the shortest sequence of movement actions from the agent's current\n  # position to any of the determined 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to track visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define all possible movement directions (delta X, delta Y) and their\n  # corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain types. These are entities that block agent movement.\n  # In CraftWorld, non-grabbable items that are not workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable,\n      # even though they cannot be picked up.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  # Start BFS.\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    # Append the 'USE' action to complete the collection sequence.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within grid limits.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue \n\n      # 2. Impassability Check: Determine if the new position contains impassable entities.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break \n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Enqueue the new position along with the extended path.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes and no path to any goal cell was found, the primitive\n  # is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:46:40.914751", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index corresponding to the primitive name.\n  # Using `env.world.cookbook.index[primitive]` (which calls `__getitem__`)\n  # is preferred over `env.world.cookbook.index.index(primitive)`.\n  # `__getitem__` will return the index if the primitive is known, or None if not.\n  # `index.index()` (the method) would create a new index if the primitive isn't\n  # already registered, which is an undesirable side effect for a lookup function.\n  primitive_idx = env.world.cookbook.index[primitive] \n  \n  # If the primitive is not recognized (i.e., `primitive_idx` is None),\n  # it cannot be collected. Return an empty list of actions.\n  if primitive_idx is None:\n    return []\n\n  # If the agent's inventory already contains the primitive, no collection\n  # actions are needed. This avoids redundant movement and 'USE' actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Map action names to their integer representations.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Immediate Collection Check ---\n  # If the agent is already adjacent to the primitive, the most direct\n  # action is to simply 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Locate all primitive occurrences on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive exists at the current grid cell (x, y).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not present anywhere on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Determine \"Goal Cells\" for Pathfinding ---\n  # A \"goal cell\" is any grid position from which the agent can successfully\n  # perform the 'USE' action to collect the primitive. The 'USE' action affects\n  # a 3x3 area around the agent. Thus, for each primitive instance (px, py),\n  # any cell (gx, gy) in its 3x3 neighborhood is a valid goal cell.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Breadth-First Search (BFS) for the Shortest Path ---\n  # Find the shortest sequence of movement actions from the agent's current\n  # position to any of the determined 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to track visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define all possible movement directions (delta X, delta Y) and their\n  # corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain types. These are entities that block agent movement.\n  # In CraftWorld, non-grabbable items that are not workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable,\n      # even though they cannot be picked up.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  # Start BFS.\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    # Append the 'USE' action to complete the collection sequence.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within grid limits.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue \n\n      # 2. Impassability Check: Determine if the new position contains impassable entities.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break \n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Enqueue the new position along with the extended path.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes and no path to any goal cell was found, the primitive\n  # is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:48:23.433840", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Adds a check to ensure the primitive is actually grabbable before attempting to collect.\n  \"\"\"\n  current_state = env._current_state\n  \n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- NEW FOR V2: Check if the primitive is actually grabbable ---\n  # If the primitive's index is not in the set of grabbable indices defined by the world,\n  # it means this item cannot be picked up and added to inventory.\n  # In such cases, collection is impossible, so return an empty action list.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Map action names to their integer IDs for clarity\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Helper Mappings for Directions and Movements ---\n  # CraftState dir: 0=North (Y-), 1=East (X+), 2=South (Y+), 3=West (X-)\n\n  # Maps (dx, dy) vector from agent's position to a target position\n  # to the direction the agent must be facing to hit that target.\n  DXDY_TO_AGENT_DIR = {\n      (0, -1): 0, # Target is North of agent -> agent faces North (dir 0)\n      (1, 0): 1,  # Target is East of agent  -> agent faces East (dir 1)\n      (0, 1): 2,   # Target is South of agent -> agent faces South (dir 2)\n      (-1, 0): 3, # Target is West of agent  -> agent faces West (dir 3)\n  }\n\n  # Maps movement action to the (dx, dy) change in position and the resulting agent direction.\n  # In this environment, moving UP (action 1) also sets the agent's direction to North (dir 0).\n  MOVE_ACTIONS_DETAILS = {\n      UP: ((0, -1), 0),    # Action: UP, Delta: (0, -1), New Dir: 0 (North)\n      DOWN: ((0, 1), 2),   # Action: DOWN, Delta: (0, 1), New Dir: 2 (South)\n      LEFT: ((-1, 0), 3),  # Action: LEFT, Delta: (-1, 0), New Dir: 3 (West)\n      RIGHT: ((1, 0), 1),  # Action: RIGHT, Delta: (1, 0), New Dir: 1 (East)\n  }\n  \n  # Direction vectors corresponding to agent's direction index (0:N, 1:E, 2:S, 3:W)\n  # Used to determine the cell directly in front of the agent.\n  DIR_INDEX_TO_DXDY = {\n      0: (0, -1), # North: (x, y-1)\n      1: (1, 0),  # East: (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0), # West: (x-1, y)\n  }\n\n  # --- Step 1: Immediate Collection Check ---\n  # Check if the primitive is directly in front of the agent, allowing immediate collection.\n  cx, cy = current_state.pos\n  current_dir_idx = current_state.dir\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Determine the coordinates of the cell directly in front of the agent\n  if current_dir_idx in DIR_INDEX_TO_DXDY:\n      dx_front, dy_front = DIR_INDEX_TO_DXDY[current_dir_idx]\n      target_x, target_y = cx + dx_front, cy + dy_front\n      \n      # If the target cell is within grid bounds and contains the primitive,\n      # the agent can use the 'USE' action right away.\n      if (0 <= target_x < grid_width and 0 <= target_y < grid_height and \n          grid[target_x, target_y, primitive_idx] > 0):\n          return [USE]\n\n  # --- Step 2: Identify All Primitive Locations on the Grid ---\n  # Iterate through the entire grid to find all occurrences of the target primitive.\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0: # If the primitive's layer at (x,y) has a positive count\n        all_primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not all_primitive_locations:\n      return []\n\n  # --- Step 3: Define Goal States for BFS ---\n  # A \"goal state\" for our Breadth-First Search (BFS) is a tuple (agent_x, agent_y, agent_direction)\n  # from which the 'USE' action can successfully collect the primitive.\n  # This implies the agent must be in a cell cardinally adjacent to the primitive and facing it.\n  goal_states = set()\n  # Relative coordinates for cardinal neighbors (where the agent can stand relative to a primitive)\n  CARDINAL_NEIGHBORS = [(0, -1), (0, 1), (-1, 0), (1, 0)] # North, South, West, East of the primitive\n\n  for px, py in all_primitive_locations:\n    for dx_rel, dy_rel in CARDINAL_NEIGHBORS:\n      # Calculate the candidate agent position (gx, gy) adjacent to the primitive\n      gx, gy = px + dx_rel, py + dy_rel \n\n      # Ensure the candidate agent position is within grid boundaries\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # Determine the direction the agent at (gx, gy) needs to face to look at (px, py).\n      # This is the vector from the agent's potential position to the primitive's position.\n      vec_to_primitive_x, vec_to_primitive_y = px - gx, py - gy\n      \n      # If this vector corresponds to a valid cardinal direction for the agent\n      if (vec_to_primitive_x, vec_to_primitive_y) in DXDY_TO_AGENT_DIR:\n        required_agent_dir = DXDY_TO_AGENT_DIR[(vec_to_primitive_x, vec_to_primitive_y)]\n        # Add this specific agent state (position and direction) as a valid goal\n        goal_states.add((gx, gy, required_agent_dir))\n\n  # If no valid goal states can be determined (unlikely if primitives exist, but as a safeguard)\n  if not goal_states:\n      return []\n\n  # --- Step 4: Perform BFS to Find the Shortest Path ---\n  start_pos_x, start_pos_y = current_state.pos\n  start_agent_dir = current_state.dir\n  \n  # BFS queue: Stores (x, y, agent_direction) tuples representing states to visit\n  q = collections.deque([(start_pos_x, start_pos_y, start_agent_dir)])\n  \n  # Visited set/dict: Stores {(x, y, agent_direction): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  # This mapping allows us to reconstruct the path later by backtracking.\n  visited = {(start_pos_x, start_pos_y, start_agent_dir): (None, None, None, None)}\n\n  # Define impassable terrain: these are non-grabbable items that are not workshops.\n  # The agent cannot move into cells occupied by these.\n  impassable_terrain_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  found_goal_state = None # Placeholder to store the first goal state found by BFS\n\n  while q:\n    cx, cy, c_dir = q.popleft() # Dequeue the current state\n    current_bfs_state = (cx, cy, c_dir)\n\n    # If the current state is one of our target goal states, we've found the shortest path.\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break # Exit BFS, path found\n\n    # Explore possible moves (UP, DOWN, LEFT, RIGHT) from the current state\n    for action, (d_pos, n_dir) in MOVE_ACTIONS_DETAILS.items():\n      dx, dy = d_pos\n      nx, ny = cx + dx, cy + dy # Calculate the new position after the move\n      new_bfs_state = (nx, ny, n_dir) # The new state includes the agent's new position and direction\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is traversable (i.e., not occupied by impassable terrain)\n      is_new_pos_impassable = False\n      for k_idx in impassable_terrain_indices:\n          if grid[nx, ny, k_idx] > 0: # If the new cell contains an impassable kind\n              is_new_pos_impassable = True\n              break\n      \n      if is_new_pos_impassable:\n          continue # Cannot move to this cell, skip to next action\n\n      # If this new state (position and direction) has not been visited yet, add it to the queue\n      if new_bfs_state not in visited:\n        visited[new_bfs_state] = (cx, cy, c_dir, action) # Record parent state and the action taken to reach here\n        q.append(new_bfs_state)\n\n  # If the BFS completes and no path to a goal state was found, the primitive is unreachable.\n  if found_goal_state is None:\n    return []\n\n  # --- Step 5: Reconstruct Path and Append USE Action ---\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state to the initial state using the 'visited' map.\n  while current_path_state != (start_pos_x, start_pos_y, start_agent_dir):\n    parent_x, parent_y, parent_dir, action_taken = visited[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Reverse the path to get actions in the correct chronological order\n\n  # Finally, append the 'USE' action, as the agent is now in the correct position and orientation.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:48:24.598997", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Map action names to their integer IDs for clarity and easy access\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # --- Helper Mappings for Directions and Movements ---\n  # CraftState directions: 0=North (Y-), 1=East (X+), 2=South (Y+), 3=West (X-)\n\n  # Maps a relative (dx, dy) vector FROM agent's position TO a target position\n  # to the direction the agent must be facing to directly 'USE' that target.\n  # Example: If target is at (0,-1) relative to agent, agent must face North (dir 0).\n  AGENT_DIR_FOR_TARGET_DXDY = {\n      (0, -1): 0, # Target North of agent -> agent faces North\n      (1, 0): 1,  # Target East of agent  -> agent faces East\n      (0, 1): 2,  # Target South of agent -> agent faces South\n      (-1, 0): 3, # Target West of agent  -> agent faces West\n  }\n\n  # Maps a movement action to its corresponding (dx, dy) change in position and \n  # the resulting agent direction after the move.\n  # Example: Moving UP (action 1) results in a (0, -1) position delta and makes agent face North (dir 0).\n  MOVE_ACTION_TO_DELTA_AND_NEW_DIR = {\n      UP: ((0, -1), 0),    # Action: UP, Delta: (0, -1), New Dir: 0 (North)\n      DOWN: ((0, 1), 2),   # Action: DOWN, Delta: (0, 1), New Dir: 2 (South)\n      LEFT: ((-1, 0), 3),  # Action: LEFT, Delta: (-1, 0), New Dir: 3 (West)\n      RIGHT: ((1, 0), 1),  # Action: RIGHT, Delta: (1, 0), New Dir: 1 (East)\n  }\n  \n  # Maps an agent's current direction index to the (dx, dy) vector of the cell it is facing.\n  # Used for checking the cell directly in front of the agent.\n  AGENT_DIR_TO_FACING_DXDY = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0), # West\n  }\n\n  cx, cy = current_state.pos\n  current_dir_idx = current_state.dir\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # --- Step 1: Immediate Collection Check ---\n  # If the primitive is directly in front of the agent, and the agent is facing it,\n  # it can be collected immediately with a single USE action.\n  dx_front, dy_front = AGENT_DIR_TO_FACING_DXDY[current_dir_idx]\n  target_x_front, target_y_front = cx + dx_front, cy + dy_front\n  \n  if (0 <= target_x_front < grid_width and 0 <= target_y_front < grid_height and \n      grid[target_x_front, target_y_front, primitive_idx] > 0):\n      return [USE]\n\n  # --- Step 2: Identify All Primitive Locations on the Grid ---\n  # Scan the entire grid to find all occurrences of the target primitive.\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not all_primitive_locations:\n      return []\n\n  # --- Step 3: Define Goal States for BFS (Position + Facing Direction) ---\n  # A \"goal state\" for the BFS is an (agent_x, agent_y, agent_direction) tuple\n  # from which the 'USE' action would successfully collect the primitive.\n  # This implies the agent must be in a cell *cardinally adjacent* to the primitive\n  # AND facing towards it.\n  goal_states = set()\n  # Relative (dx, dy) vectors for cardinal neighbors (where agent can stand relative to primitive)\n  CARDINAL_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)] \n\n  for px, py in all_primitive_locations:\n    for dx_neighbor, dy_neighbor in CARDINAL_DELTAS:\n      # Calculate a candidate agent position (gx, gy) that is adjacent to the primitive.\n      # (dx_neighbor, dy_neighbor) here is the vector from the primitive's location to the agent's potential location.\n      gx, gy = px + dx_neighbor, py + dy_neighbor \n\n      # Ensure the candidate agent position is within the grid boundaries.\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # Determine the direction the agent at (gx, gy) needs to face to look directly at (px, py).\n      # This is the vector from the agent's potential position to the primitive's position.\n      vec_agent_to_primitive_x, vec_agent_to_primitive_y = px - gx, py - gy\n      \n      # Check if this vector corresponds to a valid agent facing direction.\n      if (vec_agent_to_primitive_x, vec_agent_to_primitive_y) in AGENT_DIR_FOR_TARGET_DXDY:\n        required_agent_dir = AGENT_DIR_FOR_TARGET_DXDY[(vec_agent_to_primitive_x, vec_agent_to_primitive_y)]\n        goal_states.add((gx, gy, required_agent_dir))\n\n  # If no valid goal states can be identified (e.g., primitive is completely surrounded by impassable terrain),\n  # then it's not possible to collect it.\n  if not goal_states:\n      return []\n\n  # --- Step 4: Perform Breadth-First Search (BFS) ---\n  # The BFS aims to find the shortest sequence of actions to reach any of the `goal_states`.\n  start_pos_x, start_pos_y = current_state.pos\n  start_agent_dir = current_state.dir\n  \n  # BFS queue: Stores (x, y, agent_direction) tuples representing states to explore.\n  # Each tuple defines a unique state (agent's position and orientation).\n  q = collections.deque([(start_pos_x, start_pos_y, start_agent_dir)])\n  \n  # Visited set/dictionary: Keeps track of states already added to the queue to avoid cycles\n  # and redundant exploration. Stores (state: (parent_state, action_to_reach_state)) for path reconstruction.\n  visited = {(start_pos_x, start_pos_y, start_agent_dir): (None, None, None, None)}\n\n  # Identify impassable terrain: These are non-grabbable items that the agent cannot move onto.\n  # Workshops are typically traversable for agent movement, even if they are non-grabbable.\n  impassable_terrain_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  found_goal_state = None # Placeholder to store the first goal state discovered by BFS\n\n  while q:\n    cx, cy, c_dir = q.popleft() # Dequeue the current state for exploration\n    current_bfs_state = (cx, cy, c_dir)\n\n    # If the current state matches one of our predefined goal states, we've found the shortest path.\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break \n\n    # Explore all possible movement actions from the current state.\n    for action, (d_pos, n_dir) in MOVE_ACTION_TO_DELTA_AND_NEW_DIR.items():\n      dx, dy = d_pos\n      nx, ny = cx + dx, cy + dy # Calculate the new position after taking the action\n      new_bfs_state = (nx, ny, n_dir) # The new state (position and resulting direction)\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position contains any impassable terrain.\n      is_new_pos_impassable = False\n      for k_idx in impassable_terrain_indices:\n          if grid[nx, ny, k_idx] > 0: # If the cell contains an impassable kind, it cannot be traversed.\n              is_new_pos_impassable = True\n              break\n      \n      if is_new_pos_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If this new state hasn't been visited yet, add it to the queue for future exploration.\n      if new_bfs_state not in visited:\n        visited[new_bfs_state] = (cx, cy, c_dir, action) # Record parent state and the action taken to reach here\n        q.append(new_bfs_state)\n\n  # If the BFS queue becomes empty and no goal state was found, the primitive is unreachable.\n  if found_goal_state is None:\n    return []\n\n  # --- Step 5: Reconstruct the Path and Append the 'USE' Action ---\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state to the initial state using the 'visited' history.\n  while current_path_state != (start_pos_x, start_pos_y, start_agent_dir):\n    parent_x, parent_y, parent_dir, action_taken = visited[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (parent_x, parent_y, parent_dir)\n  \n  path_actions.reverse() # Reverse the list to get actions in the correct chronological order.\n\n  # Finally, append the 'USE' action, as the agent is now in a position and orientation\n  # from which it can collect the primitive.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:49:17.643674", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  # Assumed: 'UP' action moves the agent forward in its current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement = set(non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, rows, cols, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell\n      # Assumes grid[r, c, kind_idx] > 0 means the item is present.\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing grid dimensions and non-walkable kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:49:18.817663", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  # Convert to a numpy array for efficient indexing in the `_is_cell_walkable` check\n  non_walkable_for_movement_indices = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable using numpy array indexing\n  def _is_cell_walkable_optimized(r, c, grid, rows, cols, non_walkable_idx_array):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell using numpy.any for efficiency\n      if np.any(grid[r, c, non_walkable_idx_array] > 0):\n          return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      # Note: We specifically check for primitive_id here, not generic non-walkable.\n      # The agent needs to be able to *see* the primitive to collect it.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the optimized helper to check walkability\n          if _is_cell_walkable_optimized(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement_indices):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:50:19.312331", "function_name": "collect", "function_body": "  actions = []\n\n  # Access the current state of the environment.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's initial facing direction\n\n  # Resolve the primitive name string to its corresponding integer ID.\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mappings from the environment's action_specs.\n  _action_specs = env.action_specs()\n  ACTION_DOWN = _action_specs['DOWN']\n  ACTION_UP = _action_specs['UP']\n  ACTION_LEFT = _action_specs['LEFT']\n  ACTION_RIGHT = _action_specs['RIGHT']\n  ACTION_USE = _action_specs['USE']\n\n  # Define movement deltas for cardinal directions, mapping action constants to (dr, dc) tuples.\n  # This mapping is used to determine new positions and the direction the agent faces after a move.\n  DELTAS_MAP = {\n      ACTION_UP: (-1, 0),    # Moving UP decreases the row index.\n      ACTION_DOWN: (1, 0),   # Moving DOWN increases the row index.\n      ACTION_LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      ACTION_RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n  \n  # List of all possible movement actions (for BFS exploration).\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Essential check: If the primitive is not grabbable, it cannot be collected into inventory.\n  # If we try to collect a non-grabbable item (like 'WATER'), we return an empty list.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 1. Immediate Check: Is the agent already positioned and facing the primitive?\n  # Calculate the cell directly in front of the agent based on its current position and direction.\n  r_front, c_front = current_pos[0] + DELTAS_MAP[initial_dir][0],\\\n                     current_pos[1] + DELTAS_MAP[initial_dir][1]\n\n  # Check if the 'front' cell is within grid boundaries.\n  if (0 <= r_front < WIDTH and 0 <= c_front < HEIGHT):\n      # If the cell in front contains the primitive, a single 'USE' action is sufficient.\n      if grid[r_front, c_front, primitive_id] == 1:\n          actions.append(ACTION_USE)\n          return actions\n\n  # 2. Find all locations of the target primitive on the grid.\n  primitive_locations = set() # Use a set for faster lookups\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.add((r, c))\n\n  # If the primitive isn't found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a state ((row, col), direction) from which the primitive can be collected.\n  # A state in BFS is ((current_row, current_col), current_facing_direction).\n  # The queue stores tuples: (state, [list_of_actions_to_reach_here]).\n  q = collections.deque([(((current_pos), initial_dir), [])]) \n  \n  # The `visited` set tracks (position, direction) pairs already explored\n  # to prevent cycles and ensure the shortest path in terms of steps.\n  visited = {(current_pos, initial_dir)} \n\n  target_path = None # This will store the action sequence to the collection-ready state.\n\n  while q:\n      ((r, c), current_dir), path = q.popleft()\n\n      # Goal Check: Is the current (position, direction) state suitable for collecting?\n      # Calculate the cell that the agent is currently facing.\n      dr_facing, dc_facing = DELTAS_MAP[current_dir]\n      front_r, front_c = r + dr_facing, c + dc_facing\n\n      # If the cell in front is within bounds and contains the primitive, we found our target.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT) and\\\n         ((front_r, front_c) in primitive_locations):\n          target_path = path # Found the shortest path to this collection-ready state.\n          break # Exit BFS, the optimal path is found.\n\n      # Explore valid neighboring cells by performing movement actions.\n      for move_action in MOVE_ACTIONS:\n          dr_move, dc_move = DELTAS_MAP[move_action]\n          nr, nc = r + dr_move, c + dc_move # Calculate the potential new position.\n          new_dir = move_action # The agent's direction will be updated to the direction of movement.\n          next_state_in_bfs = ((nr, nc), new_dir)\n\n          # Boundary Check: Ensure the new position is within the grid limits.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Traversability Check:\n          # A cell is non-traversable if it contains any item from the `non_grabbable_indices` set.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # Visited Check: If this (position, direction) state has not been visited, add it to the queue.\n          if next_state_in_bfs not in visited:\n              visited.add(next_state_in_bfs) \n              new_path = path + [move_action] \n              q.append((next_state_in_bfs, new_path)) \n    \n  # 4. Construct the final sequence of actions.\n  if target_path is not None:\n      actions.extend(target_path)\n      actions.append(ACTION_USE) # Once positioned and facing, perform the 'USE' action.\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:50:20.582770", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's starting facing direction\n\n  # Resolve the primitive name string to its corresponding integer ID.\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mappings from the environment's action_specs.\n  _action_specs = env.action_specs()\n  ACTION_DOWN = _action_specs['DOWN']\n  ACTION_UP = _action_specs['UP']\n  ACTION_LEFT = _action_specs['LEFT']\n  ACTION_RIGHT = _action_specs['RIGHT']\n  ACTION_USE = _action_specs['USE']\n\n  # Define movement deltas for cardinal directions, mapping action constants to (dr, dc) tuples.\n  # This mapping is used to determine new positions and the direction the agent faces after a move.\n  DELTAS_MAP = {\n      ACTION_UP: (-1, 0),    # Moving UP decreases the row index.\n      ACTION_DOWN: (1, 0),   # Moving DOWN increases the row index.\n      ACTION_LEFT: (0, -1),  # Moving LEFT decreases the column index.\n      ACTION_RIGHT: (0, 1)   # Moving RIGHT increases the column index.\n  }\n  \n  # List of all possible movement actions (for BFS exploration).\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Essential check: If the primitive is not grabbable, it cannot be collected into inventory.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 1. Immediate Check: Can the primitive be collected from the current (position, direction) state?\n  # Calculate the cell directly in front of the agent based on its current position and initial facing direction.\n  dr_facing, dc_facing = DELTAS_MAP[initial_dir]\n  r_front, c_front = current_pos[0] + dr_facing, current_pos[1] + dc_facing\n\n  # Check if the 'front' cell is within grid boundaries and contains the primitive.\n  if (0 <= r_front < WIDTH and 0 <= c_front < HEIGHT):\n      if grid[r_front, c_front, primitive_id] == 1:\n          actions.append(ACTION_USE)\n          return actions\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a state ((row, col), direction) from which the primitive can be collected.\n  # A state in BFS is ((current_row, current_col), current_facing_direction).\n  # The queue stores tuples: (state, [list_of_actions_to_reach_here]).\n  q = collections.deque([((current_pos, initial_dir), [])]) \n  \n  # The `visited` set tracks (position, direction) pairs already explored\n  # to prevent cycles and ensure the shortest path in terms of steps.\n  visited = {(current_pos, initial_dir)} \n\n  target_path = None # This will store the action sequence to the collection-ready state.\n\n  while q:\n      # Dequeue current state and path\n      ((r, c), current_dir_in_state), path = q.popleft()\n\n      # Explore valid neighboring cells by performing movement actions.\n      for move_action in MOVE_ACTIONS:\n          # A move action changes the agent's position AND sets its new facing direction.\n          dr_move, dc_move = DELTAS_MAP[move_action]\n          nr, nc = r + dr_move, c + dc_move # Calculate the potential new position.\n          new_dir_in_state = move_action # The agent's new facing direction will be the direction of movement.\n          next_bfs_state = ((nr, nc), new_dir_in_state)\n\n          # Boundary Check: Ensure the new position is within grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Traversability Check:\n          # A cell is non-traversable if it contains any item from the `non_grabbable_indices` set.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # If this (position, direction) state has not been visited, add it to the queue.\n          if next_bfs_state not in visited:\n              visited.add(next_bfs_state) \n              new_path = path + [move_action] \n\n              # GOAL CHECK: After moving to (nr, nc) and facing new_dir_in_state, \n              # can we collect the primitive?\n              # Calculate the cell that the agent would be facing from this new state.\n              dr_facing_after_move, dc_facing_after_move = DELTAS_MAP[new_dir_in_state]\n              front_r_after_move, front_c_after_move = nr + dr_facing_after_move, nc + dc_facing_after_move\n\n              # If the cell in front is within bounds and contains the primitive, we found our target.\n              if (0 <= front_r_after_move < WIDTH and 0 <= front_c_after_move < HEIGHT) and\\\n                 (grid[front_r_after_move, front_c_after_move, primitive_id] == 1):\n                  target_path = new_path # Found the shortest path to this collection-ready state.\n                  break # Exit the inner for loop (shortest path found for this target)\n              \n              # If not the goal state, add this new state to the queue for further exploration.\n              q.append((next_bfs_state, new_path)) \n      \n      # If target_path was found in the inner loop, break from the outer while loop as well.\n      if target_path is not None:\n          break \n\n  # 3. Construct the final sequence of actions.\n  if target_path is not None:\n      actions.extend(target_path)\n      actions.append(ACTION_USE) # Once positioned and facing, perform the 'USE' action.\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:51:28.484452", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (state_object, path_list)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # Adjusted this value to be more conservative, failing faster if a path is very long.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    # This makes the function return immediately if the search space becomes too large,\n    # preventing excessively long computations.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # No path found within reasonable limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    # Crucially, step() returns a *new* state, ensuring previous states are not mutated.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:51:30.003824", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  # Convert the primitive name to lowercase to match cookbook's index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that are explicitly defined as grabbable (can be picked up),\n  # or specific environmental resources like \"water\" or \"stone\" which are interacted with via USE.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory\n  # using the 'USE' action in this context.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected using 'USE' action, we do not proceed with a search for it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1 (North)\n      1: (0, 1),  # RIGHT: col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1 (South)\n      3: (0, -1)  # LEFT: col - 1 (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # required to change from the current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      # Determine the shortest sequence of turns.\n      if diff == 1: # One clockwise turn (e.g., UP -> RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP -> LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive turns in either direction (e.g., RIGHT, RIGHT) will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state. The queue stores (CraftState, list_of_actions_to_reach_this_state).\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Initial path is empty.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # This value can be tuned based on typical grid sizes and desired performance.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path of actions taken to reach it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit, stop to prevent\n    # excessive computation time, assuming a path within this limit should be found.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Skip further processing from this path, but allow other paths to be explored if within limit.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the target primitive (`i_kind`) is present in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all possible agent orientations to see if one faces the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If so, simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding for collection, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., needing a tool) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the complete sequence of actions (path to state + turns + USE).\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # 1. Movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # CraftState.step returns a new state object.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action])) # Add new state and extended path to queue.\n    \n    # 2. General 'USE' action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool from the ground)\n    # can change the inventory or capabilities, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the 'USE' action resulted in a meaningful state change (inventory, position, or direction).\n    # This avoids adding redundant states to the queue if 'USE' had no effect (e.g., using it in an empty space).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # within the search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:52:57.021408", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Retrieve the integer ID for the target primitive from the world's cookbook index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it's an invalid target.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory, it's considered \"collected\".\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if this primitive is semantically \"collectible\" via the 'USE' action.\n  # Collectible items typically include grabbable objects (e.g., tools, crafted components)\n  # and specific environmental resources (e.g., water, stone) that can be gathered.\n  # Items like workshops, boundaries, or bridges are generally not meant to be collected into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target primitive cannot be collected via the 'USE' action, we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integer IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of basic movement actions.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to (row_change, col_change) for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases (moves North)\n      1: (0, 1),  # RIGHT: col increases (moves East)\n      2: (1, 0),  # DOWN: row increases (moves South)\n      3: (0, -1)  # LEFT: col decreases (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target\n\n      # Calculate the difference, ensuring positive result by adding 4 and modulo 4.\n      # This handles circularity (e.g., from 3 (LEFT) to 0 (UP) is a difference of 1 clockwise).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn)\n          # Two turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs for 180-turn\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue for BFS, storing (CraftState, list of actions to reach this state)\n  \n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, direction, inventory_tuple).\n  # Inventory (numpy.ndarray) is converted to a tuple for hashability.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and heuristic exploration limit.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit on the number of states to explore to prevent excessive computation\n  # in very large or complex scenarios. This prevents infinite loops in cases where\n  # optimal path finding is intractable. Roughly 10 times the number of unique\n  # (position, direction) states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the primitive is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its accumulated path\n    explored_states_count += 1\n\n    # Pruning: If we've explored beyond our defined limit, skip further expansion from this branch.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check ---\n    # Check if the target primitive is in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it is, iterate through all four possible facing directions to see if\n        # we can directly face and USE the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front of the agent (if facing `target_dir`)\n            # is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate and simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start from the current state (from BFS queue)\n                for turn_action in turns_to_face:\n                    # Apply each turn action. Reward is typically 0 for movement/turns.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Capture inventory *before* attempting the USE action. This is crucial\n                # for verifying if the USE action successfully collected the item.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Verify collection: The count of the primitive in inventory must have increased.\n                # This accounts for any underlying game mechanics (e.g., needing a tool) handled by CraftState.step.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Path found: Return the sequence of actions to reach, turn, and use.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- State Exploration ---\n    # Explore possible movement actions from the current state.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory for hashing\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Add the new state to the queue if it hasn't been visited yet.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Separately explore the 'USE' action from the current position.\n    # This is important for cases where using an item at the current location changes the inventory\n    # (e.g., picking up a tool like an axe, which then enables collection of other primitives later),\n    # but doesn't necessarily collect the target primitive itself.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from 'USE' if it actually changed meaningfully.\n    # This avoids redundant exploration if 'USE' had no effect (e.g., using nothing).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add the 'USE' state to the queue if it's new.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop finishes and no path was found, it means the primitive is unreachable\n  # from the initial state under the current game conditions within the explored state limit.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:52:58.203460", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:53:51.957849", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This relies on the 'primitive' string being a valid key in the world's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  # These are standard actions defined in CraftLab's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Moves agent one step forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turns agent 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turns agent 90 degrees right\n  USE_ACTION = action_map['USE']            # Interacts with the cell directly in front\n\n  # Direction vectors (dr, dc) corresponding to agent's facing direction.\n  # (dr, dc) defines the change in (row, column) for moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mappings for updating agent's direction when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., RIGHT (0) -> UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., RIGHT (0) -> DOWN (3)\n\n  # Get indices of entities that block agent movement.\n  # These are typically `BOUNDARY`, `WATER`, and `WORKSHOP_X` locations.\n  # Convert to a list for efficient indexing with NumPy.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to determine if a given grid cell (r, c) is valid and walkable for the agent.\n  def is_valid_and_walkable_cell(r: int, c: int) -> bool:\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Agent cannot walk *onto* the primitive itself.\n      # The `USE` action is performed from an adjacent square.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      # Summing the counts for all non-grabbable kinds at this cell.\n      if non_walkable_kinds_indices and np.sum(initial_grid[r, c, non_walkable_kinds_indices]) > 0:\n          return False\n          \n      return True\n\n  # BFS (Breadth-First Search) Initialization:\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations and infinite loops.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the shortest sequence of actions to reach a state\n  # where the agent is adjacent to and facing the target primitive.\n  path_to_primitive_adjacent = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state, and the path is complete.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its content.\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # If the primitive is present in this front cell, we've reached the goal state.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Path to adjacency found, exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Move Forward:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the potential next position is valid and walkable, and if this (position, direction)\n      # state has not been visited yet.\n      if is_valid_and_walkable_cell(next_row, next_col) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  # If no path is found (e.g., primitive is unreachable or doesn't exist), actions_list remains empty.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:53:53.151523", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices_list = list(current_state.world.non_grabbable_indices)\n\n  # Helper function to check if a grid cell is valid and walkable for the agent\n  def is_valid_and_walkable_cell(r, c):\n      # Check if the position is within grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Agent cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # Check if the cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n      # by summing counts for all non-grabbable kinds at that cell.\n      # This ensures the agent doesn't try to move onto obstacles.\n      if non_walkable_kinds_indices_list and np.sum(initial_grid[r, c, non_walkable_kinds_indices_list]) > 0:\n          return False\n          \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is valid and walkable, and this (position, direction) state hasn't been visited\n      if is_valid_and_walkable_cell(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:55:17.920543", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world # Access to CraftWorld instance for cookbook, indices, etc.\n\n  # 1. Get the integer ID for the target primitive from the world's cookbook.\n  # Convert primitive name to lowercase as indexing uses lowercase names.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it's an invalid target.\n    return []\n\n  # 2. Early Exit: Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive is designed to be \"collectible\" via the 'USE' action.\n  # This includes items that can be picked up (grabbable_indices) and specific environmental\n  # resources like \"water\" or \"stone\" that are gathered by using them.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the primitive is not collectible via 'USE', we cannot fulfill this request.\n  # This correctly handles cases like trying to \"collect\" a workshop or a boundary.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define Action Mappings and Direction Deltas.\n  action_map = env.action_specs() # Get the mapping from action names to integer IDs.\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of all basic movement actions.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to determine the minimal sequence of turning actions (LEFT/RIGHT)\n  # required to change from the current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP to DOWN)\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice.\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue for BFS: stores tuples of (CraftState, list_of_actions_to_reach_this_state).\n  \n  # 'visited' set to keep track of explored states and prevent cycles/redundant work.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory (numpy.ndarray) must be converted to a tuple to be hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions from the current state for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Define a heuristic limit for the number of states to explore.\n  # This prevents the search from running indefinitely in complex or unachievable scenarios.\n  # It's roughly (number of positions * number of directions) * a factor for inventory variations.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the target primitive is collected.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path leading to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the limit, stop exploring this branch.\n    # This ensures the search terminates within reasonable time.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check: Can we collect the target primitive from this `state`? ---\n    # `state.next_to(i_kind)` checks if the target primitive is anywhere in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If it is, iterate through all four possible agent orientations to see if\n        # directly facing and using the primitive is possible.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (if facing `target_dir`) is within\n            # grid bounds and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start from the current state from BFS.\n                for turn_action in turns_to_face:\n                    # Apply each turn action to simulate the state after turning.\n                    # Reward is 0 for movements and turns in this environment.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Capture the inventory *before* attempting the 'USE' action.\n                # This is crucial for verifying if 'USE' successfully collected the item.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical Verification: Check if the count of the primitive in inventory actually increased.\n                # This confirms successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Path found! Return the sequence of actions: original path + turns + USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- State Exploration: Explore possible next states via actions ---\n\n    # Explore basic movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the action.\n      next_inventory_tuple = tuple(next_state.inventory) # Hashable inventory for visited set.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state (position, direction, inventory) hasn't been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Separately explore the 'USE' action from the current position.\n    # This is important for scenarios where using an item at the current location\n    # (e.g., picking up a tool like an axe, interacting with a crafting bench)\n    # changes the inventory or state, enabling subsequent collection of the target primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from 'USE' if it caused a meaningful change.\n    # This avoids redundant exploration if 'USE' was a no-op (e.g., using nothing).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add the new state to the queue if it's truly new.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:55:19.721874", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its integer ID using the world's cookbook index.\n  # This ensures we are working with the canonical ID used internally by the simulation.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not found, it's an invalid target for collection.\n    return []\n\n  # 2. Early exit condition: If the agent already possesses the target primitive in its inventory,\n  # no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is inherently collectible via the 'USE' action in the game.\n  # This includes items that can be picked up (`grabbable_indices`) and specific\n  # environmental resources like water or stone. Items like workshops or boundaries\n  # are typically static environment features and not meant to be collected.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item cannot be collected using the 'USE' action, we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define constant integer IDs for actions and spatial relationships.\n  # These IDs are obtained from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of basic movement actions for iteration.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to change from its `current_dir` to a `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference that correctly\n      # represents the shortest turn (e.g., from 3 to 0 is 1 step clockwise).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose two RIGHT_ACTs\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque() # Queue to store tuples of (CraftState, list_of_actions_to_reach_this_state)\n  \n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory (a numpy.ndarray) is converted to an immutable tuple for hashability.\n  # Including inventory is critical because acquiring tools or other items changes\n  # the agent's capabilities and thus, what future actions are possible.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions from the current state for boundary checks and to set\n  # a heuristic limit on the number of states to explore.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit for BFS exploration. This prevents the search from running\n  # indefinitely in very complex or large state spaces. The value is set to\n  # approximately 15 times the number of unique (position, direction) states,\n  # allowing for paths that involve collecting multiple intermediate tools or moves.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 15 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues as long as there are states to explore in the queue\n  # and the target primitive has not yet been collected.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path leading to it\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the heuristic limit,\n    # skip further expansion from this branch to manage computational resources.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations\n        # (UP, RIGHT, DOWN, LEFT) to determine if facing one of them would put the\n        # primitive directly in front of the agent.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions to get the agent into the correct orientation.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # The reward for turning is typically 0.0, so it's ignored here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                # This is crucial for verifying if 'USE' successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Check if the count of the target primitive in\n                # the inventory *increased* after the 'USE' action. This confirms\n                # successful collection, accounting for any game rules (e.g., needing\n                # a specific tool) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found. Return the full sequence\n                    # of actions: path to reach the location, turns to face, and the final USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      # Convert the inventory of the new state to a tuple for hashability in the `visited` set.\n      next_inventory_tuple = tuple(next_state.inventory) \n      # Create a unique key for the visited set.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited before, add it to the queue and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This is distinct from the 'USE' in the goal check. This general 'USE' handles scenarios\n    # where using an item at the current location might change the inventory\n    # (e.g., picking up a tool like an axe or shears), enabling future collection of other primitives,\n    # even if it doesn't directly collect the *target* primitive.\n    inventory_before_current_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change (inventory, position, or direction). This prevents adding\n    # redundant states to the queue if 'USE' had no effect (e.g., using nothing or\n    # using an item that doesn't change the state).\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_current_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is unreachable from the\n  # initial state under the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T08:56:17.647913", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Store initial grid, agent's position, and direction.\n  # The grid is treated as static for the purpose of pathfinding to the primitive.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, column) tuple\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This makes the code robust to changes in action integer values.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # In CraftWorld, 'UP' typically means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']           # Action to collect/interact with an item\n\n  # Define how agent's position changes for each direction when moving forward.\n  # Maps direction ID to (delta_row, delta_column).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move +1 in column\n      1: (-1, 0),  # Facing UP (1): move -1 in row\n      2: (0, -1),  # Facing LEFT (2): move -1 in column\n      3: (1, 0)    # Facing DOWN (3): move +1 in row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings ensure the direction cycles correctly (0 -> 1 -> 2 -> 3 -> 0).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Determine which entities act as movement obstacles.\n  # The agent cannot move into cells containing these entity types.\n  # 1. Non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) are always obstacles.\n  obstacles_for_movement = set(current_state.world.non_grabbable_indices)\n  \n  # 2. If the target primitive is a grabbable item (e.g., WOOD, STONE),\n  #    the agent typically collects it from an adjacent tile using 'USE',\n  #    rather than by walking onto its tile. Therefore, the primitive itself\n  #    acts as an obstacle for direct movement onto its cell.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_for_movement.add(primitive_id)\n  \n  # Optimization: If the primitive is already within the agent's immediate vicinity\n  # (3x3 neighborhood, as checked by `CraftState.next_to`), it can be collected directly.\n  # Return only the USE action in this case.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ((position_tuple, direction_int), list_of_actions_to_reach_here)\n  # This allows tracking both the agent's spatial location and its orientation.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set prevents revisiting states (position, direction) to avoid cycles\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  path_to_collect_pos = None # Will store the action sequence once a collectible state is found.\n\n  # Main BFS loop: Continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      ((curr_r, curr_c), curr_dir), path_actions = queue.popleft()\n\n      # Check if the current agent position (curr_r, curr_c) is a \"goal state\" for collection.\n      # A goal state means the primitive is present in any cell within the 3x3 neighborhood\n      # centered around the agent's current position on the initial grid.\n      is_primitive_adjacent = False\n      for dr_check in [-1, 0, 1]:  # Iterate over relative row offsets\n          for dc_check in [-1, 0, 1]:  # Iterate over relative column offsets\n              check_r, check_c = curr_r + dr_check, curr_c + dc_check\n              # Ensure the checked cell is within grid boundaries.\n              if (0 <= check_r < GRID_ROWS and 0 <= check_c < GRID_COLS and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_primitive_adjacent = True\n                  break # Primitive found in neighborhood, no need to check other cells.\n          if is_primitive_adjacent:\n              break # Break outer loop too if found.\n\n      if is_primitive_adjacent:\n          path_to_collect_pos = path_actions # Store the path leading to this collectible state.\n          break # Path found, terminate BFS.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      dr, dc = DIR_TO_DRDC[curr_dir]\n      next_r, next_c = curr_r + dr, curr_c + dc\n      next_pos = (next_r, next_c)\n      next_dir_move = curr_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within grid bounds and not already visited\n      # with the same direction).\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir_move) not in visited):\n          \n          # Check if the cell at `next_pos` contains any obstacle.\n          is_cell_walkable = True\n          for kind_idx in obstacles_for_movement:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_cell_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_cell_walkable:\n              visited.add((next_pos, next_dir_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[curr_dir]\n      # Turning only changes direction, not position.\n      if ((curr_r, curr_c), next_dir_left) not in visited:\n          visited.add(((curr_r, curr_c), next_dir_left))", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T08:56:18.890506", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version refines the goal condition for collection. Instead of simply reaching a position\n  adjacent to the primitive, it specifically searches for a state (agent position AND direction)\n  from which the agent can directly 'USE' (interact with) the primitive, by facing it.\n  This aligns with typical CraftWorld interaction mechanics where the 'USE' action\n  applies to the cell directly in front of the agent.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # Retrieve integer action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' typically means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to interact with/collect an item\n\n  # Mapping from agent's direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) to\n  # the change in (row, column) when moving forward or interacting with the cell in front.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Mappings to update agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entities that block agent movement.\n  # 1. Non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) are always impassable.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # 2. If the primitive itself is a grabbable item (e.g., WOOD, STONE),\n  #    the agent should not walk onto its tile to collect it; it needs to be adjacent and use it.\n  #    Therefore, add the primitive's ID to obstacles to ensure pathfinding stops before entering its cell.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: `((position_tuple, direction_int), list_of_actions_to_reach_here)`\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set tracks states (position, direction) to prevent revisiting\n  # and ensure the shortest path is found by avoiding cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence if a collectible state is found.\n\n  # Main BFS loop: Continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Determine the coordinates of the cell directly in front of the agent.\n      face_dr, face_dc = DIR_TO_DRDC[current_dir]\n      cell_in_front_r, cell_in_front_c = r + face_dr, c + face_dc\n\n      # This is the new, refined goal condition for the BFS:\n      # Check if the cell in front is within grid boundaries AND contains the target primitive.\n      is_collectible_from_current_state = False\n      if (0 <= cell_in_front_r < WIDTH and 0 <= cell_in_front_c < HEIGHT and\n          initial_grid[cell_in_front_r, cell_in_front_c, primitive_id] > 0):\n          is_collectible_from_current_state = True\n\n      # If the agent is in a state from which it can 'USE' the primitive,\n      # we have found our target path.\n      if is_collectible_from_current_state:\n          target_path = path_actions\n          break # Path found, terminate BFS.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this (position, direction) state has not been visited yet.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the cell at `next_pos` contains any obstacle.\n          is_walkable = True\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable state (position + direction) was found (`target_path` is not None),\n  # extend the actions list with this path and append the final 'USE' action.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T08:57:01.478929", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Pre-computation and Early Exits ---\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # Using __getitem__ (square bracket access) ensures that if the primitive name\n  # is not recognized, it returns None, which is then handled.\n  primitive_id = env.world.cookbook.index[primitive]\n  if primitive_id is None:\n    # If the primitive is not a known entity in the environment's cookbook,\n    # it cannot be collected.\n    return []\n\n  # If the agent already possesses at least one unit of the target primitive,\n  # there's no need to collect more, so return an empty action list.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Map human-readable action names to their corresponding integer action IDs\n  # as understood by the `env.step()` method.\n  action_ids = env.action_specs()\n  ACTION_UP = action_ids['UP']\n  ACTION_DOWN = action_ids['DOWN']\n  ACTION_LEFT = action_ids['LEFT']\n  ACTION_RIGHT = action_ids['RIGHT']\n  ACTION_USE = action_ids['USE']\n\n  # --- 2. Immediate Collection Check ---\n  # Check if the primitive is already within the agent's 3x3 interaction range.\n  # If so, a single 'USE' action is sufficient to collect it.\n  if current_state.next_to(primitive_id):\n    return [ACTION_USE]\n\n  # --- 3. Grid Analysis: Locate Primitives and Define Impassable Areas ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape # Dimensions of the game grid.\n  \n  # Find all (x, y) coordinates on the grid where the primitive exists.\n  # np.where is an efficient way to get indices of non-zero elements in a specific channel.\n  primitive_grid_x, primitive_grid_y = np.where(grid[:, :, primitive_id] > 0)\n  primitive_locations = list(zip(primitive_grid_x, primitive_grid_y))\n\n  # If no instances of the primitive are present on the grid, it's uncollectable.\n  if not primitive_locations:\n    return []\n\n  # Determine all possible \"goal cells\" for the agent. A goal cell is any location\n  # from which the agent can successfully use the 'USE' action to collect the primitive.\n  # This typically means any cell in the 3x3 neighborhood of a primitive's location.\n  target_goal_cells = set()\n  for px, py in primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate potential goal cell coordinates.\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_goal_cells.add((gx, gy))\n\n  # Identify entity kinds that block agent movement. These are typically\n  # non-grabbable items that are not designated workshops (which are often traversable).\n  # Convert to a list for efficient NumPy array indexing.\n  impassable_entity_ids = list(\n      set(env.world.non_grabbable_indices) - set(env.world.workshop_indices))\n\n  # --- 4. Pathfinding using Breadth-First Search (BFS) ---\n  agent_start_pos = current_state.pos # Agent's current (x, y) position.\n\n  # BFS Queue: Stores tuples of (current_position, list_of_actions_to_reach_here).\n  # This allows direct path reconstruction once the goal is found.\n  bfs_queue = collections.deque([(agent_start_pos, [])])\n  \n  # Set to keep track of visited grid positions to avoid cycles and redundant exploration,\n  # ensuring the shortest path is found.\n  explored_positions = {agent_start_pos}\n\n  # Define cardinal movement directions and their corresponding action IDs.\n  cardinal_movements = [\n      ((0, -1), ACTION_UP),    # Change in Y: -1 (Up)\n      ((0, 1), ACTION_DOWN),   # Change in Y: +1 (Down)\n      ((-1, 0), ACTION_LEFT),  # Change in X: -1 (Left)\n      ((1, 0), ACTION_RIGHT),  # Change in X: +1 (Right)\n  ]\n\n  while bfs_queue:\n    (cx, cy), current_path = bfs_queue.popleft() # Get current position and path.\n\n    # If the current position is one of the target goal cells, we've found the shortest path.\n    if (cx, cy) in target_goal_cells:\n      # Append the 'USE' action, as the agent is now in position to collect.\n      return current_path + [ACTION_USE]\n\n    # Explore all possible valid moves from the current position.\n    for (dx, dy), action_to_take in cardinal_movements:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the next cell.\n      next_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the next position is within the grid.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # 2. Impassability Check: Ensure the next cell is traversable.\n      # Only perform this check if there are actual impassable kinds defined.\n      is_next_cell_impassable = False\n      if impassable_entity_ids:\n          # Check if any impassable entity is present at the next cell's location.\n          # `grid[nx, ny, impassable_entity_ids]` slices the grid to get counts\n          # of only the impassable kinds at (nx, ny). `np.any` checks if any count is > 0.\n          if np.any(grid[nx, ny, impassable_entity_ids] > 0): \n              is_next_cell_impassable = True\n      \n      if is_next_cell_impassable:\n          continue # Skip this move if the cell is blocked.\n\n      # 3. Visited Check: Only explore cells that haven't been visited yet to find the shortest path.\n      if next_pos not in explored_positions:\n        explored_positions.add(next_pos) # Mark as visited.\n        # Add the next position and the updated path to the queue for further exploration.\n        bfs_queue.append((next_pos, current_path + [action_to_take]))\n\n  # If the BFS completes (queue is empty) without finding a path to any goal cell,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:57:02.575758", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  # Using __getitem__ (`env.world.cookbook.index[primitive]`) is preferred as it\n  # gracefully returns `None` if the primitive name is not found, avoiding side effects.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # If the primitive is not a recognized entity in the game world, it cannot be collected.\n    return [] \n  \n  # Early exit optimization: If the agent already possesses at least one of the primitive\n  # in its inventory, no collection actions are necessary.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Map action names to their corresponding integer values for clearer code.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # Verify if the agent is currently positioned such that the primitive is within\n  # its immediate 3x3 neighborhood (including the agent's cell). If so, a single\n  # 'USE' action is sufficient to collect it.\n  if current_state.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # 2. Locate all existing instances of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Use NumPy's `where` function to efficiently find all (x, y) coordinates\n  # where the target primitive is present (count > 0).\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  \n  # Combine the x and y coordinates into a list of (x, y) tuple locations.\n  primitive_locations_on_grid = list(zip(primitive_x_coords, primitive_y_coords))\n\n  # If no instances of the primitive are found on the map, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 3. Define \"Goal Cells\" for the Breadth-First Search (BFS).\n  # A \"goal cell\" is any grid position from which the agent can successfully\n  # perform the 'USE' action to collect the target primitive. Since 'USE' affects\n  # a 3x3 area, these goal cells are the neighbors (including diagonals and itself)\n  # of any primitive location.\n  bfs_goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          bfs_goal_cells.add((gx, gy))\n\n  # 4. Identify entity kinds that block agent movement.\n  # These are typically non-grabbable items that are *not* workshop locations,\n  # as workshops are generally traversable despite being non-grabbable.\n  # Convert to a list for efficient indexing in NumPy.\n  impassable_entity_indices = list(set(env.world.non_grabbable_indices) - set(env.world.workshop_indices))\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The BFS queue stores tuples of (current_position, list_of_actions_to_reach_here).\n  bfs_queue = collections.deque([(current_state.pos, [])])\n  \n  # A set to keep track of visited positions to prevent infinite loops and ensure\n  # the shortest path is discovered by exploring layer by layer.\n  visited_positions = {current_state.pos} \n\n  # Define all possible cardinal movements (change in x, change in y)\n  # and their corresponding action indices.\n  CARDINAL_MOVE_ACTIONS = [\n      ((0, -1), ACTION_UP),    # Move North (decrease Y)\n      ((0, 1), ACTION_DOWN),   # Move South (increase Y)\n      ((-1, 0), ACTION_LEFT),  # Move West (decrease X)\n      ((1, 0), ACTION_RIGHT),  # Move East (increase X)\n  ]\n\n  while bfs_queue:\n    (current_x, current_y), actions_path = bfs_queue.popleft()\n\n    # If the current position is one of the designated goal cells, we've found\n    # the shortest path to a location from which the primitive can be collected.\n    if (current_x, current_y) in bfs_goal_cells:\n      # Append the 'USE' action to complete the collection sequence.\n      return actions_path + [ACTION_USE]\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action_for_move in CARDINAL_MOVE_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy\n      next_position = (next_x, next_y)\n\n      # 1. Boundary Check: Ensure the potential next position is within the grid.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Impassability Check: Determine if the cell at `next_position` is traversable.\n      # This involves checking if any of the `impassable_entity_indices` are present there.\n      is_next_cell_impassable = False\n      if impassable_entity_indices: # Only perform check if there are any defined impassable kinds.\n          is_next_cell_impassable = np.any(grid[next_x, next_y, impassable_entity_indices] > 0)\n      \n      if is_next_cell_impassable:\n        continue # Skip this move if the cell is blocked.\n\n      # 3. Visited Check: Only explore if the cell has not been visited in this BFS.\n      if next_position not in visited_positions:\n        visited_positions.add(next_position)\n        # Add the new position and the updated action path to the queue.\n        bfs_queue.append((next_position, actions_path + [action_for_move]))\n\n  # If the BFS completes (queue is empty) and no path to any goal cell was found,\n  # the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:58:59.904714", "function_name": "collect", "function_body": "  # Constants for cardinal directions (often 0:N, 1:E, 2:S, 3:W)\n  DIR_N, DIR_E, DIR_S, DIR_W = 0, 1, 2, 3\n\n  # Helper function to get action integer IDs\n  # Defined inside to adhere to \"only return code that will fit in that function\"\n  def _get_action_ids(env_action_specs):\n    # This list mirrors the MOVE_ACTION_DATA structure defined below\n    # to extract action names programmatically.\n    _temp_move_names = ['UP', 'DOWN', 'LEFT', 'RIGHT']\n    action_ids = {name: env_action_specs[name] for name in _temp_move_names}\n    action_ids['USE'] = env_action_specs['USE']\n    return action_ids\n\n  # Helper function to find all locations of a primitive on the grid\n  def _find_primitive_locations(grid, primitive_idx):\n    grid_width, grid_height, _ = grid.shape\n    locations = []\n    for x in range(grid_width):\n      for y in range(grid_height):\n        if grid[x, y, primitive_idx] > 0:\n          locations.append((x, y))\n    return locations\n\n  # Helper function to determine impassable kinds\n  def _get_impassable_kinds(world):\n    # Impassable kinds are non-grabbable items that are NOT workshops.\n    # Workshops are generally traversable despite being non-grabbable.\n    return set(world.non_grabbable_indices) - set(world.workshop_indices)\n\n  # Helper function to calculate the cell the agent is facing\n  def _get_target_cell_from_agent_state(cx, cy, c_dir):\n    if c_dir == DIR_N: return cx, cy - 1 # Facing North: target is directly above\n    if c_dir == DIR_E: return cx + 1, cy # Facing East: target is directly to the right\n    if c_dir == DIR_S: return cx, cy + 1 # Facing South: target is directly below\n    if c_dir == DIR_W: return cx - 1, cy # Facing West: target is directly to the left\n    return -1, -1 # Should not happen with valid directions\n\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This will raise a KeyError if the primitive name is not valid, as expected.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Map action names to their integer IDs from the environment's action_specs.\n  action_ids = _get_action_ids(env.action_specs())\n  # Store the USE action ID separately for clarity when appending to path.\n  USE_ACTION = action_ids['USE']\n\n  # Define movement deltas, their corresponding action name, and the new direction after the move.\n  # This data structure is used to generate possible transitions in the BFS.\n  MOVE_ACTION_DATA = [\n      ((0, -1), 'UP', DIR_N),    # Move North (decreases Y) and face North\n      ((0, 1), 'DOWN', DIR_S),   # Move South (increases Y) and face South\n      ((-1, 0), 'LEFT', DIR_W),  # Move West (decreases X) and face West\n      ((1, 0), 'RIGHT', DIR_E),  # Move East (increases X) and face East\n  ]\n\n  # Optimization: If the agent's inventory already contains the primitive,\n  # no actions are needed to collect it. Return an empty list.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Identify all grid locations where the primitive exists by scanning the entire grid.\n  primitive_locations = _find_primitive_locations(current_state.grid, primitive_idx)\n  \n  # If no instances of the primitive are found on the grid, it's unreachable.\n  # Return an empty list of actions.\n  if not primitive_locations:\n    return []\n\n  # Determine which entity kinds make a cell impassable for agent movement.\n  # This set will be used to filter out invalid moves during BFS.\n  impassable_kinds = _get_impassable_kinds(env.world)\n\n  # Perform Breadth-First Search (BFS) to find the shortest path to the primitive.\n  # The BFS state is defined as a tuple (x, y, current_direction) because the 'USE'\n  # action is direction-dependent.\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # BFS queue: stores ( (current_x, current_y, current_dir), path_of_actions_to_reach_here )\n  # Each element in the queue represents a reachable state and the sequence of actions\n  # taken to reach that state from the start.\n  q = collections.deque([((start_pos_x, start_pos_y, start_dir), [])]) \n  \n  # Visited set: stores (x, y, dir) tuples to prevent revisiting states and cycles,\n  # ensuring the shortest path is found.\n  visited = {(start_pos_x, start_pos_y, start_dir)} \n\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  while q:\n    (cx, cy, c_dir), path_so_far = q.popleft() # Get the current state and its path\n\n    # Check if the agent is currently in a state where it can successfully 'USE'\n    # to collect the primitive. This means the cell directly in front of the agent\n    # must contain the primitive.\n    target_cell_x, target_cell_y = _get_target_cell_from_agent_state(cx, cy, c_dir)\n    \n    # Validate the target cell: it must be within grid boundaries and contain the primitive.\n    if (0 <= target_cell_x < grid_width and 0 <= target_cell_y < grid_height and\n        current_state.grid[target_cell_x, target_cell_y, primitive_idx] > 0):\n      # If these conditions are met, the agent is positioned and facing correctly.\n      # Append the USE action to the current path and return it as the solution.\n      return path_so_far + [USE_ACTION]\n\n    # Explore valid neighboring states (movement actions) from the current state.\n    for (dx, dy), action_name, new_dir in MOVE_ACTION_DATA:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position after a move\n      new_state_tuple = (nx, ny, new_dir) # The new state includes the new position and direction\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (i.e., not impassable terrain).\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          # If any impassable kind is present at the new cell, it's impassable.\n          if current_state.grid[nx, ny, k_idx] > 0:\n              is_impassable_cell = True\n              break\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # If the new state (position + direction) has not been visited yet,\n      # add it to the queue for further exploration.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        # Get the actual integer action ID from our mapped actions.\n        action_id = action_ids[action_name] \n        q.append((new_state_tuple, path_so_far + [action_id]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any\n  # state from which the primitive can be collected, it means the primitive is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T08:59:01.123467", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook's index.\n  # Using the __getitem__ method (e.g., `cookbook.index[primitive]`) is preferred\n  # over `.index(primitive)` because `__getitem__` returns None if the item\n  # is not found, whereas `.index(primitive)` would add the item to the index\n  # if it doesn't already exist, which is not the desired behavior for 'collect'.\n  primitive_idx = env.world.cookbook.index[primitive]\n  \n  # If the primitive name is not recognized in the environment's index,\n  # it cannot be collected, so return an empty list of actions.\n  if primitive_idx is None:\n    return []\n  \n  # Retrieve action mappings for clarity and to ensure correct action indices are used.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define standard integer constants for agent directions.\n  DIR_N, DIR_E, DIR_S, DIR_W = 0, 1, 2, 3\n\n  # Optimization: If the agent's inventory already contains the primitive,\n  # no actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 1. Identify all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  # Iterate through the entire grid to find all cells containing the specified primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell (count > 0).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's unreachable.\n  if not primitive_locations:\n    return []\n\n  # 2. Determine which entity kinds make a cell impassable for agent movement.\n  # Impassable kinds are typically non-grabbable items. Workshops are usually\n  # non-grabbable but often represent walkable/interactable locations, so they\n  # are explicitly excluded from the impassable set.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The BFS state now includes (x, y, current_direction) because the 'USE' action\n  # is assumed to be direction-dependent (i.e., it acts on the cell the agent is facing).\n  start_pos_x, start_pos_y = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # The queue for BFS stores tuples of:\n  # ( (current_x, current_y, current_dir), list_of_actions_taken_to_reach_this_state )\n  q = collections.deque([((start_pos_x, start_pos_y, start_dir), [])]) \n  # A set to keep track of visited states ((x, y, dir) tuples) to prevent cycles\n  # and redundant exploration, ensuring the shortest path is found.\n  visited = {(start_pos_x, start_pos_y, start_dir)} \n\n  # Define possible cardinal moves (delta_x, delta_y), their corresponding action indices,\n  # and the new direction the agent faces after performing that move.\n  MOVE_DATA = [\n      ((0, -1), UP, DIR_N),    # Move North (decreases Y), face North\n      ((0, 1), DOWN, DIR_S),   # Move South (increases Y), face South\n      ((-1, 0), LEFT, DIR_W),  # Move West (decreases X), face West\n      ((1, 0), RIGHT, DIR_E),  # Move East (increases X), face East\n  ]\n\n  while q:\n    (cx, cy, c_dir), path_so_far = q.popleft() # Get the current state and path\n\n    # Check if the agent is currently in a position and orientation where it can\n    # successfully 'USE' to collect the primitive. This requires determining\n    # the cell directly in front of the agent based on its current direction.\n    target_cell_x, target_cell_y = -1, -1 # Initialize with invalid coordinates\n    if c_dir == DIR_N: # Facing North, the cell in front is (cx, cy-1)\n      target_cell_x, target_cell_y = cx, cy - 1\n    elif c_dir == DIR_E: # Facing East, the cell in front is (cx+1, cy)\n      target_cell_x, target_cell_y = cx + 1, cy\n    elif c_dir == DIR_S: # Facing South, the cell in front is (cx, cy+1)\n      target_cell_x, target_cell_y = cx, cy + 1\n    elif c_dir == DIR_W: # Facing West, the cell in front is (cx-1, cy)\n      target_cell_x, target_cell_y = cx - 1, cy\n    \n    # If the determined target cell is within grid boundaries AND contains the primitive,\n    # then the agent can collect it from its current state.\n    if (0 <= target_cell_x < grid_width and 0 <= target_cell_y < grid_height and\n        grid[target_cell_x, target_cell_y, primitive_idx] > 0):\n      # Agent is in a valid state to collect the primitive. Append the USE action\n      # and return the complete action sequence.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring states achievable by movement actions.\n    for (dx, dy), action, new_dir in MOVE_DATA:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      new_state_tuple = (nx, ny, new_dir) # The new state includes the new position and direction\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (i.e., not an impassable terrain type).\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          # If any impassable kind is present at the new cell, it's blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable_cell = True\n              break\n      \n      if is_impassable_cell:\n          continue # Cannot move to this cell.\n\n      # If the new state (position and direction) has not been visited yet,\n      # add it to the queue for further exploration.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_state_tuple, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any\n  # collectible state, it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:00:29.782931", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive. This will raise KeyError if the primitive name\n  # is not recognized by the cookbook, but for DSL tasks, valid primitive names are assumed.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  ACTION_DOWN = _action_specs['DOWN']\n  ACTION_UP = _action_specs['UP']\n  ACTION_LEFT = _action_specs['LEFT']\n  ACTION_RIGHT = _action_specs['RIGHT']\n  ACTION_USE = _action_specs['USE']\n\n  # Define movement deltas corresponding to the cardinal actions\n  MOVE_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # --- Helper functions for improved readability and modularity ---\n\n  # Checks if a given (row, col) coordinate is within the grid boundaries.\n  def is_in_bounds(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Checks if a given cell (r, c) is traversable by the agent.\n  # A cell is traversable if it's in bounds and does not contain any non-grabbable entity.\n  def is_traversable(r, c):\n      if not is_in_bounds(r, c):\n          return False # Out of bounds is not traversable\n      # Check if the cell contains any obstacle (non-grabbable item)\n      for kind_idx in env.world.non_grabbable_indices:\n          if grid[r, c, kind_idx] == 1:\n              return False # Contains an obstacle, so not traversable\n      return True\n\n  # --- Core logic for collecting the primitive ---\n\n  # Early exit: Ensure the primitive can actually be collected (is in grabbable_indices).\n  # If not, no actions can lead to its collection.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 1. Immediate check: If the agent is already adjacent to the primitive, a single 'USE' action suffices.\n  if current_state.next_to(primitive_id):\n      actions.append(ACTION_USE)\n      return actions\n\n  # 2. Identify all locations where the target primitive exists on the grid.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive isn't anywhere on the map, it can't be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Determine all \"target use positions\". These are traversable cells from which\n  #    the agent can interact (USE) with an adjacent primitive.\n  target_use_positions = set()\n  for pr, pc in primitive_locations:\n      for dr, dc in MOVE_DELTAS.values(): # Check all 4 adjacent cells\n          adj_r, adj_c = pr + dr, pc + dc\n          # A cell is a target use position if it's traversable for the agent\n          # (this includes boundary checks via is_traversable).\n          if is_traversable(adj_r, adj_c):\n              target_use_positions.add((adj_r, adj_c))\n    \n  # If there are no valid (traversable) positions from which to use the primitive, it's uncollectable.\n  if not target_use_positions:\n      return []\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the `target_use_positions`.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, [path_to_position])\n  visited = {current_pos} # Set of visited positions to avoid redundant paths and cycles\n\n  shortest_path_to_target = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current cell is one of our target use positions, we've found the shortest path.\n      if (r, c) in target_use_positions:\n          shortest_path_to_target = path \n          break \n\n      # Explore valid unvisited neighboring cells.\n      for action_dir, (dr, dc) in MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc \n\n          # Only proceed if the new position is traversable and hasn't been visited yet.\n          if is_traversable(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              q.append(((nr, nc), path + [action_dir]))\n    \n  # 5. Construct the final sequence of actions.\n  # If a path to a target use position was found, append the path actions\n  # and then the 'USE' action to collect the primitive.\n  if shortest_path_to_target is not None:\n      actions.extend(shortest_path_to_target)\n      actions.append(ACTION_USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:00:30.964275", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by refactoring traversability check.\"\"\"\n  actions = []\n  \n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  _action_specs = env.action_specs()\n  USE = _action_specs['USE']\n\n  # Mapping of movement actions to deltas (row_change, col_change)\n  MOVE_ACTIONS = {\n      _action_specs['UP']: (-1, 0),\n      _action_specs['DOWN']: (1, 0),\n      _action_specs['LEFT']: (0, -1),\n      _action_specs['RIGHT']: (0, 1)\n  }\n\n  # Ensure the primitive is actually grabbable.\n  # Items like 'WATER', 'BOUNDARY', 'WORKSHOP' are not grabbable and should not be collected this way.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Helper function to check if a cell is traversable.\n  # This refactors the traversability logic into a dedicated helper,\n  # improving readability and maintainability for collect_v2.\n  def _is_cell_traversable(r: int, c: int) -> bool:\n      # Check 1: Ensure the position is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check 2: Ensure the cell does not contain any non-grabbable item (obstacle).\n      # Non-grabbable items typically include boundaries, water, workshops, etc.,\n      # which cannot be moved onto.\n      for i_kind in env.world.non_grabbable_indices:\n          if grid[r, c, i_kind] == 1: \n              return False # This cell contains an obstacle\n      return True # Cell is within bounds and does not contain obstacles\n\n  # 1. Check if the agent is already next to the primitive.\n  # If `next_to` returns True, a single 'USE' action is sufficient to collect it.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # A cell contains the primitive if its value at primitive_id index is 1.\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it's uncollectable from the world.\n  if not primitive_locations:\n      return []\n\n  # 3. Pre-compute all valid \"target use positions\".\n  # A \"target use position\" is a grid cell from which the agent can apply 'USE'\n  # to collect the desired primitive. This cell must be adjacent to a primitive\n  # location AND must be traversable by the agent.\n  target_use_positions = set()\n  for pr, pc in primitive_locations:\n      # Iterate through all 4 cardinal directions to find adjacent cells.\n      for action_dir, (dr, dc) in MOVE_ACTIONS.items(): \n          adj_r, adj_c = pr + dr, pc + dc\n          # Only add if the adjacent cell is traversable.\n          if _is_cell_traversable(adj_r, adj_c):\n              target_use_positions.add((adj_r, adj_c))\n    \n  # If there are no traversable spots from which to use the primitive, it's uncollectable.\n  if not target_use_positions:\n      return []\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the pre-computed `target_use_positions`.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  shortest_path_to_target_pos = None # This will store the shortest action sequence found\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Goal check: If the current BFS node (r, c) is one of our pre-computed target positions.\n      if (r, c) in target_use_positions:\n          shortest_path_to_target_pos = path \n          break # Shortest path to an 'usable' position found, exit BFS\n\n      # Explore valid neighboring cells from the current position (r, c).\n      for action_dir, (dr, dc) in MOVE_ACTIONS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position\n\n          # If the new position is traversable and has not been visited yet, add it to the queue.\n          if _is_cell_traversable(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              # Extend the current path with the action taken to reach this new neighbor.\n              q.append(((nr, nc), path + [action_dir]))\n    \n  # 5. Construct the final sequence of actions.\n  # If a path to a target use position was found, extend the actions list with this path\n  # and then append a 'USE' action to actually collect the primitive.\n  if shortest_path_to_target_pos is not None:\n      actions.extend(shortest_path_to_target_pos)\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:01:34.929963", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:01:38.479414", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID for the target item (what we want in inventory).\n  try:\n    i_kind_target = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind_target] > 0:\n      return []\n\n  # 3. Determine the 'source' kind on the grid that needs to be interacted with\n  # to yield the target primitive. This distinction is crucial for primitives\n  # like \"wood\" (target) which comes from \"tree\" (source).\n  i_kind_source = -1 # Default to an invalid value\n\n  # Case A: The primitive itself is directly grabbable (can be picked up directly from the grid)\n  # or is a special resource like water/stone that directly corresponds to a grid block.\n  if i_kind_target in world.grabbable_indices:\n      i_kind_source = i_kind_target\n  elif i_kind_target == world.water_index:\n      i_kind_source = world.water_index\n  elif i_kind_target == world.stone_index:\n      i_kind_source = world.stone_index\n  else:\n      # Case B: The primitive is obtained from a *different* source entity on the grid.\n      # This requires a mapping from the desired primitive (e.g., \"wood\") to its source entity (e.g., \"tree\").\n      # This addresses a regression in v1 and restores v0's capability for derived primitives.\n      primitive_to_source_entity_name = {\n          \"wood\": \"tree\",\n          \"iron\": \"iron_ore\",\n          \"grass\": \"grass_block\", \n          \"rock\": \"rock_block\", # Assuming 'rock' primitive comes from 'rock_block' source\n          \"gold\": \"gold_ore\",\n          \"gem\": \"gem_ore\",\n          # Add other mappings as per environment's implicit gathering rules\n      }\n      source_entity_name = primitive_to_source_entity_name.get(primitive.lower())\n      \n      if source_entity_name:\n          try:\n              i_kind_source = world.cookbook.index[source_entity_name]\n          except KeyError:\n              # The source entity (e.g., 'tree') itself is not recognized in the cookbook index.\n              # This means either the environment does not contain this source or the mapping is incorrect.\n              return []\n      else:\n          # If it's not a direct grabbable/resource AND no specific source entity mapping exists,\n          # then this primitive is not collectible via a simple 'USE' action on the grid \n          # (e.g., it's a workshop, boundary, or exclusively craftable).\n          return []\n\n  # If i_kind_source is still invalid after all checks, it means the primitive cannot be collected.\n  if i_kind_source == -1:\n      return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice for a 180-degree turn\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key,\n  # as inventory changes can open up new possibilities (e.g., gaining a tool).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # A more robust upper bound for explored states to handle larger maps and more complex scenarios.\n  # This helps prevent excessively long searches while still allowing for reasonable exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) * 3 \n  # Increased the multiplier slightly from v0's (1 + len(world.cookbook.kinds)) to provide more allowance.\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Is the 'source' entity (i_kind_source) at the agent's current position?\n    # This covers cases like picking up a loose item that is directly the source.\n    if state.grid[current_r, current_c, i_kind_source] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        \n        # Verify successful collection: check if the *target primitive's* count increased in inventory.\n        # This is crucial because using on a source might produce the target, or something else.\n        if state_after_use_on_self.inventory[i_kind_target] > inventory_before_use_on_self[i_kind_target]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Is the 'source' entity (i_kind_source) in an adjacent cell?\n    # Iterate through cardinal directions to find the specific cell containing the source entity.\n    # state.next_to(i_kind_source) provides a quick check, but we need to find the specific cell\n    # and orient towards it.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds and contains the target source entity\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n            state.grid[facing_r, facing_c, i_kind_source] == 1):\n            \n            # Simulate the turning actions required to face the source entity.\n            temp_state_after_turns = state \n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the *target primitive* in inventory actually increase?\n            # This verifies successful collection, accounting for any internal game rules\n            # (e.g., requiring tools, or multiple uses) implemented in `CraftState.step`.\n            if state_after_use.inventory[i_kind_target] > inventory_before_use[i_kind_target]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state. Such changes might be\n    # necessary for later steps to collect the *target* primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:02:26.320044", "function_name": "collect", "function_body": "  \"\"\"Finds and collects a specified primitive resource in the CraftLab environment.\n\n  This function uses a Breadth-First Search (BFS) to find the shortest sequence\n  of movement and turning actions to position the agent adjacent to and facing\n  the target primitive. Once positioned, it appends a 'USE' action to the\n  sequence to simulate collection.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object, from which the\n                          current game state (grid, agent position, inventory)\n                          is extracted.\n      primitive (str): The string name of the primitive resource to collect\n                       (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., CraftLab.action_specs()\n                 values like UP, LEFT, RIGHT, USE) representing the sequence\n                 of steps to collect the primitive. Returns an empty list\n                 if the primitive cannot be found, is unreachable, or\n                 if the primitive name is invalid.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # (row, col)\n  initial_dir = current_state.dir # 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Robustly get the integer ID for the target primitive from the cookbook index.\n  # If the primitive name is not recognized, it cannot be collected.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return [] # Return an empty list if the primitive name is invalid.\n  \n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names to their integer indices for clarity and robustness.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assumed to move agent one step in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Get the set of indices for non-grabbable entities (e.g., boundaries, water, workshops).\n  # These are entities the agent cannot walk over.\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n\n  # Direction mapping: (delta_row, delta_column) for agent's facing direction.\n  # This helps calculate the cell directly in front or the next position when moving forward.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column\n      1: (-1, 0),  # Facing UP: -1 to row\n      2: (0, -1),  # Facing LEFT: -1 to column\n      3: (1, 0)    # Facing DOWN: +1 to row\n  }\n\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function performing a Breadth-First Search (BFS) to find\n      the shortest sequence of movement and turning actions. The goal is to\n      reach a state where the agent is immediately adjacent to and facing\n      the target primitive.\n      \"\"\"\n      # BFS Queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to prevent redundant exploration\n      # and guarantee the shortest path is found for unweighted edges.\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          # Pop the current state and its accumulated path from the queue.\n          (current_pos, current_dir), path_actions = queue.popleft()\n          current_r, current_c = current_pos\n\n          # 1. Check if the current state satisfies the goal condition:\n          # Is the target primitive present in the cell directly in front of the agent?\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = current_r + front_dr, current_c + front_dc\n\n          # Ensure the cell directly in front is within grid bounds\n          if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found! Return the sequence of actions to reach this 'USE' position.\n\n          # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n          # --- Try Move Forward ---\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Direction does not change when moving forward.\n\n          # Check if the potential next position is valid (within grid bounds)\n          # and if this (position, direction) state has not been visited yet.\n          if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n              (next_pos, next_dir) not in visited):\n              \n              # Determine if the next cell is walkable.\n              is_walkable = True\n              # An agent cannot walk onto cells containing non-grabbable entities.\n              for kind_idx in non_grabbable_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # Additionally, an agent should not walk *onto* the primitive it intends to collect;\n              # it must be adjacent to it to 'USE' it.\n              if is_walkable and initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # --- Try Turn Left ---\n          # Calculate new direction using modular arithmetic for counter-clockwise rotation:\n          # R(0)->U(1), U(1)->L(2), L(2)->D(3), D(3)->R(0)\n          next_dir_left = (current_dir + 1) % 4\n          # Position does not change when turning.\n          if (current_pos, next_dir_left) not in visited:\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # --- Try Turn Right ---\n          # Calculate new direction using modular arithmetic for clockwise rotation:\n          # R(0)->D(3), U(1)->R(0), L(2)->U(1), D(3)->L(2)\n          next_dir_right = (current_dir - 1 + 4) % 4 # Add 4 to ensure positive result before modulo\n          # Position does not change when turning.\n          if (current_pos, next_dir_right) not in visited:\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states.\n\n  # Call the nested BFS helper function to find the movement/turn sequence to the primitive.\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to be adjacent to and facing the primitive was found,\n  # append the 'USE' action to complete the collection process.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:02:27.567632", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Robustly get the integer ID for the target primitive from the cookbook index.\n  # If the primitive name is not recognized, it cannot be collected, so return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return []\n  \n  # Get grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names to their integer indices for clarity and robustness\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' corresponds to moving forward relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Get indices of entities that cannot be walked upon\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # This defines how position changes when moving \"forward\" for each direction.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function to find a sequence of movement/turn actions (using BFS)\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \"\"\"\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles.\n      # This ensures the shortest path is found for unweighted graph edges.\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          # Pop the current state and the path taken to reach it\n          (current_pos, current_dir), path_actions = queue.popleft()\n          current_r, current_c = current_pos\n\n          # 1. Check if the current state satisfies the target condition for 'USE':\n          # The primitive must be in the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = current_r + front_dr, current_c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n          if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n              (next_pos, next_dir) not in visited):\n              \n              # Determine if the next position is walkable:\n              is_walkable = True\n              # An agent cannot walk onto cells containing non-grabbable entities\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # An agent also cannot walk onto the target primitive itself (it needs to be adjacent to 'USE' it)\n              if is_walkable and initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # Try Turn Left\n          # Calculate new direction using modular arithmetic for counter-clockwise rotation\n          # (0:Right -> 1:Up, 1:Up -> 2:Left, 2:Left -> 3:Down, 3:Down -> 0:Right)\n          next_dir_left = (current_dir + 1) % 4\n          # Turning does not change position.\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # Try Turn Right\n          # Calculate new direction using modular arithmetic for clockwise rotation\n          # (0:Right -> 3:Down, 1:Up -> 0:Right, 2:Left -> 1:Up, 3:Down -> 2:Left)\n          # Adding 4 ensures the result of (current_dir - 1) is non-negative before modulo.\n          next_dir_right = (current_dir - 1 + 4) % 4\n          # Turning does not change position.\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the sequence of movement/turn actions.\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to position the agent adjacent to and facing the primitive was found,\n  # append the 'USE' action to complete the collection.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:03:00.307701", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Attempt to get the primitive's integer ID from the world's cookbook index.\n  # If the primitive name is not found, it's an invalid target, so return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      return []\n\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape  # Get dimensions of the grid\n\n  # Retrieve numerical action IDs from the environment's action_specs.\n  # 'UP' is typically used for moving forward in the current facing direction.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Mapping of agent's direction (0-3) to corresponding change in (row, column) coordinates.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases (col + 1)\n      1: (-1, 0),  # Facing UP: row decreases (row - 1)\n      2: (0, -1),  # Facing LEFT: column decreases (col - 1)\n      3: (1, 0)    # Facing DOWN: row increases (row + 1)\n  }\n\n  # Maps for updating agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get the set of indices for entities that cannot be walked upon (e.g., boundaries, water, workshops).\n  blocking_kind_indices = current_state.world.non_grabbable_indices\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # BFS state: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state)\n  # The queue stores states to be explored.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The `visited` set tracks (position, direction) pairs to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the shortest action sequence to reach the \"ready to use\" state.\n\n  # --- BFS Main Loop ---\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r_curr, c_curr = current_pos\n\n      # Check if the primitive is directly in front of the agent in the *current* BFS state.\n      # This is the primary goal condition for the BFS: to find a path to a cell\n      # adjacent to the primitive, with the agent facing it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      r_front, c_front = r_curr + front_dr, c_curr + front_dc\n      \n      # Check if the cell directly in front is within grid boundaries.\n      if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS):\n          # If the cell in front contains the target primitive, we've found the shortest path.\n          if initial_grid[r_front, c_front, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to the target interaction state found, exit BFS.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n      \n      # 1. Try moving Forward\n      # Calculate the next position after moving forward. Agent's direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r_curr + move_dr, c_curr + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir\n\n      # Check if the `next_pos` is within grid boundaries and this specific (position, direction)\n      # state has not been visited yet.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the `next_pos` cell is walkable.\n          # A cell is considered unwalkable if it contains any 'blocking_kind' (e.g., BOUNDARY, WATER, WORKSHOP)\n          # OR if it contains the target `primitive_id` itself (agent must stand *adjacent* to it, not on it, to USE).\n          is_walkable = True\n          for kind_idx in blocking_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Prevent walking onto the primitive itself.\n          # This is crucial for grabbable items (like WOOD) and also ensures we don't try to walk\n          # onto a non-grabbable item if it's erroneously passed as a \"primitive\".\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes only the agent's direction, not its position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes only the agent's direction, not its position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # --- After BFS Completion ---\n  # If a path was found to the \"ready to use\" state (target_path_actions is not None),\n  # append the final 'USE' action to complete the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:03:01.561921", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Attempt to get the primitive's integer ID from the world's cookbook index.\n  # If the primitive name is not found, it's an invalid target, so return an empty list.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # The requested primitive name does not exist in the world's index.\n      return []\n\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Grid dimensions (rows, columns)\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # 'UP' typically corresponds to moving forward in the current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how position (row, col) changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Map for updating the agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # Agent cannot walk onto cells containing these kinds.\n  blocking_kind_indices = current_state.world.non_grabbable_indices\n\n  # BFS state representation: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  # The queue stores states to explore.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set tracks (position, direction) pairs to avoid redundant computations and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the shortest sequence of actions to reach the \"ready to use\" state.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent in the current state.\n      # This is the \"goal\" condition for the BFS (agent is adjacent and facing the primitive).\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the shortest path\n          # to a state where the agent can 'USE' the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path to the target interaction state found, terminate BFS.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid bounds and this (pos, dir) state hasn't been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the 'next_pos' cell is walkable.\n          # A cell is not walkable if it contains any 'blocking_kind' (like boundaries, water).\n          # Also, the agent cannot walk *onto* the primitive itself; it must stand *adjacent* to it.\n          is_walkable = True\n          for kind_idx in blocking_kind_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # Prevent walking onto the primitive itself. This applies to grabbable items (like WOOD)\n          # and also provides a redundant check for non-grabbable items if they are the primitive.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to the \"ready to use\" state, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:04:54.630858", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Immutable state information for BFS planning\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # This will raise a KeyError if 'primitive' is not a valid item name in the world.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Grid dimensions for boundary checks.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) corresponding to agent's facing direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: (row, col+1)\n      1: (-1, 0),  # UP: (row-1, col)\n      2: (0, -1),  # LEFT: (row, col-1)\n      3: (1, 0)    # DOWN: (row+1, col)\n  }\n\n  # Mappings for updating agent's direction when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Pre-process non-walkable entity indices into a NumPy array for efficient checks.\n  # These are entities the agent cannot walk over (e.g., BOUNDARY, WATER, WORKSHOPs).\n  non_walkable_entity_ids_np = np.array(list(current_state.world.non_grabbable_indices))\n\n  # Helper function to determine if a given grid cell (r, c) is a valid and walkable location for the agent.\n  def is_valid_and_walkable_cell(r: int, c: int) -> bool:\n      # 1. Check if the cell coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Agent cannot walk *onto* the primitive itself. The 'USE' action is performed from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check if the cell contains any non-walkable (non-grabbable) entities.\n      # This uses numpy's `any` function for efficiency.\n      if len(non_walkable_entity_ids_np) > 0:\n          if np.any(initial_grid[r, c, non_walkable_entity_ids_np] > 0):\n              return False\n          \n      return True\n\n  # BFS (Breadth-First Search) Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant computations and cycles,\n  # ensuring the shortest path is found.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the shortest sequence of actions to reach a state\n  # where the agent is adjacent to and facing the target primitive.\n  path_to_primitive_adjacent = None \n\n  # Start BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # --- Goal Check ---\n      # Check if the target primitive is directly in front of the agent from the current state.\n      # This is the desired pre-collection state for the 'USE' action.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its content.\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # If the primitive is present in this front cell, we've reached our goal.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Shortest path to adjacency found, terminate BFS.\n\n      # --- Explore Possible Next Actions ---\n      # From the current state, try all valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Moving Forward (MOVE_FORWARD_ACTION):\n      # Calculate the next position if the agent moves forward. Direction remains unchanged.\n      next_row_move, next_col_move = current_row + DIR_TO_DRDC[current_dir][0], current_col + DIR_TO_DRDC[current_dir][1]\n      next_pos_move = (next_row_move, next_col_move)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # If the next cell is valid and walkable, and this (position, direction) state hasn't been visited yet,\n      # add it to the queue for further exploration.\n      if is_valid_and_walkable_cell(next_row_move, next_col_move) and (next_pos_move, next_dir_move) not in visited:\n          visited.add((next_pos_move, next_dir_move)) # Mark as visited.", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:04:55.762195", "function_name": "collect", "function_body": "  # This function aims to find a path to a specified primitive and collect it.\n  # It uses a Breadth-First Search (BFS) algorithm to find the shortest sequence\n  # of actions (movements and turns) that positions the agent adjacent to and\n  # facing the target primitive, followed by a 'USE' action.\n\n  # Initialize the list to store the sequence of actions.\n  actions_list = []\n\n  # Get the current state of the environment. The BFS will plan based on this\n  # initial, static view of the world.\n  current_state = env._current_state\n  initial_grid = current_state.grid  # The grid layout (numpy.ndarray)\n  initial_agent_pos = current_state.pos  # Agent's starting (row, col) tuple\n  initial_agent_dir = current_state.dir  # Agent's starting direction (int: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN)\n\n  # Retrieve the integer ID for the target `primitive` from the world's cookbook index.\n  # This ID is crucial for identifying the primitive on the grid.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the cookbook's index, it's an invalid primitive.\n      # Return an empty list, as it's impossible to collect an unknown primitive.\n      return []\n  \n  # Get the dimensions of the grid for boundary checks.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Map action names (strings) to their corresponding integer IDs.\n  # These IDs are constant across the CraftWorld environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Agent moves one step forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Agent turns 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Agent turns 90 degrees right.\n  USE_ACTION = action_map['USE']            # Agent interacts with the cell directly in front.\n\n  # Define how agent's (row, column) coordinates change based on its facing direction.\n  # This helps calculate the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (change in row, change in col) is (0, +1)\n      1: (-1, 0),  # Facing UP: (-1, 0)\n      2: (0, -1),  # Facing LEFT: (0, -1)\n      3: (1, 0)    # Facing DOWN: (+1, 0)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # E.g., RIGHT (0) becomes UP (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # E.g., RIGHT (0) becomes DOWN (3)\n\n  # Get the indices of all entities that the agent cannot walk onto.\n  # This includes boundaries, water, and workshop locations.\n  # Converting to a NumPy array makes checking presence in a cell more efficient.\n  non_walkable_kinds_indices = np.array(list(current_state.world.non_grabbable_indices))\n\n  def is_cell_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is within bounds and traversable by the agent.\n      A cell is considered unwalkable if:\n      1. It's outside the grid boundaries.\n      2. It contains the target primitive itself (agent must be adjacent, not on top).\n      3. It contains any other non-grabbable/impassable entity (e.g., water, boundary).\n      \"\"\"\n      # 1. Check grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # 2. Prevent walking onto the primitive. The agent collects from an adjacent square.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n\n      # 3. Check for other non-walkable entities.\n      # `non_walkable_kinds_indices` might be empty if the environment has no impassable objects.\n      if non_walkable_kinds_indices.size > 0: # Check if the array is not empty\n          # `np.any` is used for efficiency: if any non-walkable item is present, the cell is blocked.\n          if np.any(initial_grid[r, c, non_walkable_kinds_indices] > 0):\n              return False\n          \n      return True\n\n  # BFS Initialization:\n  # The queue stores tuples of `((agent_position, agent_direction), list_of_actions_taken)`.\n  # This allows us to reconstruct the path once the target is found.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The `visited` set keeps track of (position, direction) states already explored.\n  # This prevents cycles and ensures the shortest path is found.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the shortest action sequence to reach the state\n  # where the agent is immediately adjacent to and facing the target primitive.\n  path_to_primitive_adjacent = None \n\n  # Start the BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # --- Goal Check ---\n      # Check if the cell directly in front of the agent contains the target primitive.\n      # If so, we've found the desired pre-collection state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # First, ensure the cell in front is within the grid boundaries.\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # If the target primitive is found in the cell directly in front,\n          # we have found the shortest path to be ready for collection.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Shortest path found, terminate BFS.\n\n      # --- Explore Next Actions ---\n      # From the current state, consider all possible valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Moving Forward:\n      # Calculate the new position if the agent moves forward. Direction remains the same.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos_after_move = (next_row, next_col)\n      next_dir_after_move = current_dir # Direction does not change.\n\n      # If the new position is walkable and this specific (position, direction) state\n      # has not been visited before, add it to the queue for exploration.\n      if is_cell_walkable(next_row, next_col) and (next_pos_after_move, next_dir_after_move) not in visited:\n          visited.add((next_pos_after_move, next_dir_after_move))\n          queue.append(((next_pos_after_move, next_dir_after_move), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turning Left:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_after_left_turn = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only affects direction, not position.\n      state_after_left_turn = (current_pos, next_dir_after_left_turn)\n\n      # If this new state (same position, new direction) has not been visited, add it to the queue.\n      if state_after_left_turn not in visited:\n          visited.add(state_after_left_turn)\n          queue.append((state_after_left_turn, path_taken + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turning Right:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_after_right_turn = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only affects direction, not position.\n      state_after_right_turn = (current_pos, next_dir_after_right_turn)\n\n      # If this new state has not been visited, add it to the queue.\n      if state_after_right_turn not in visited:\n          visited.add(state_after_right_turn)\n          queue.append((state_after_right_turn, path_taken + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes, if a path to the primitive's adjacent cell was found:\n  if path_to_primitive_adjacent is not None:\n      # Extend the collected actions with the path found.\n      actions_list.extend(path_to_primitive_adjacent)\n      # Append the final 'USE' action to actually collect the primitive.\n      actions_list.append(USE_ACTION)\n  \n  # If no path was found (e.g., primitive is unreachable or doesn't exist on the grid),\n  # `actions_list` will remain empty, which correctly signifies failure to collect.\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:06:18.461203", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # --- Improvement for V2 over V1: Removed the restrictive `is_collectible_via_use` check. ---\n  # This allows the BFS to explore paths where a primitive might be obtained by\n  # interacting with an *environmental object* (e.g., harvesting wood from a tree),\n  # even if the primitive itself is not directly grabbable or a special case like water/stone.\n  # The general `USE_ACT` exploration within the BFS, combined with the\n  # inventory increase check, is now solely responsible for determining collectibility.\n  # This makes the `collect` function more general and robust to different ways of obtaining primitives.\n\n  # 3. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row - 1, col (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES to allow for a more exhaustive search in potentially\n  # larger or more complex environments where the primitive might be farther away\n  # or require more intermediate steps/inventory changes to reach.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check 1: Check if the primitive is directly under the agent's feet and is grabbable.\n    # This applies to items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count of i_kind increased.\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check 2: Check for primitive in adjacent cells (cardinal directions) that can be interacted with.\n    # This covers cases like harvesting resources (e.g., water, stone, or wood from a tree), or\n    # picking up items that are next to the agent.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is crucial for collecting items indirectly (e.g., harvesting wood from a tree),\n    # or picking up intermediate tools, or interacting with workshops.\n    # The `state.step(USE_ACT)` handles the complex game logic for what happens.\n    # This block applies a heuristic to only explore USE when an \"interesting\" object\n    # is at the agent's current position or in front of the agent.\n    do_general_use_exploration = False\n\n    # Check if agent is currently on a grabbable item (it could be the target or a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0:\n        item_at_pos_idx = item_at_pos_idx_flat[0]\n        if item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n\n    # Check if agent is facing a workshop, a grabbable item, or another primitive resource.\n    # Interacting with workshops, picking up tools, or harvesting resources (like trees for wood)\n    # are key scenarios covered here.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n\n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx in world.grabbable_indices or\n                item_in_front_idx in world.workshop_indices or\n                item_in_front_idx in world.cookbook.primitives): # Check if facing any known primitive resource\n                do_general_use_exploration = True\n\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action resulted in a meaningful state change.\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:06:22.210366", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # --- Improvement for collect_v2: The restrictive `is_collectible_via_use` check\n  # from collect_v1 is removed. This allows the BFS to explore paths where a primitive\n  # might be obtained by interacting with an environmental object (e.g., harvesting wood\n  # from a tree), even if the primitive itself is not directly grabbable or a special\n  # case like water/stone. The general `USE_ACT` exploration within the BFS, combined\n  # with the inventory increase check, is now solely responsible for determining collectibility. ---\n\n  # 3. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row + 1, col (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 4. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES remains at 100 times the basic state space from collect_v1.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 100 \n  explored_states_count = 0\n\n  # 5. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This allows for more complex\n    # collection scenarios involving tools or environmental interactions.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 6. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:07:14.334406", "function_name": "collect", "function_body": "  \"\"\"Computes a sequence of actions to find and collect a specified grabbable primitive.\n  It uses Breadth-First Search (BFS) to find the shortest path to a cell\n  adjacent to any instance of the primitive, and then appends a 'USE' action.\n\n  This version refines `collect_v1` by making variable access more direct and\n  ensuring clear variable names for improved readability, while retaining the\n  robust and optimal BFS pathfinding logic.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment object representing the current game state.\n      primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"IRON\").\n\n  Returns:\n      List[int]: A list of integer action codes (UP, DOWN, LEFT, RIGHT, USE)\n                 representing the optimal sequence to collect the primitive.\n                 Returns an empty list if the primitive is not grabbable,\n                 or if no path to an adjacent primitive is found.\n  \"\"\"\n  # 1. Initialize State and Environment Information\n  # Access current state details directly for clarity and potential minor efficiency.\n  current_state = env._current_state \n  game_grid = current_state.grid\n  agent_position = current_state.pos # Agent's (row, column) starting position\n  grid_rows, grid_cols, _ = game_grid.shape # Dimensions of the grid\n\n  # Get the unique integer ID for the target primitive from the environment's cookbook.\n  # This ID is crucial for identifying the primitive on the grid.\n  target_primitive_id = env.world.cookbook.index[primitive]\n\n  # Retrieve action mapping from the environment to convert symbolic actions\n  # (e.g., 'UP', 'USE') into their integer representations.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the possible movements as (delta_row, delta_col) along with their corresponding actions.\n  # This structure is convenient for iterating through adjacent cells in the BFS.\n  movement_deltas_with_actions = [\n      ((-1, 0), ACTION_UP),    # Move Up: row decreases\n      ((1, 0), ACTION_DOWN),   # Move Down: row increases\n      ((0, -1), ACTION_LEFT),  # Move Left: column decreases\n      ((0, 1), ACTION_RIGHT)   # Move Right: column increases\n  ]\n\n  # 2. Pre-checks for immediate collection or impossibility\n  # Check if the target primitive is even grabbable. If not, it cannot be collected\n  # via the 'USE' action, so return an empty list of actions.\n  if target_primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Check if the agent is already adjacent to the primitive.\n  # The `next_to` method checks the 3x3 neighborhood around the agent's current position.\n  # If true, only a 'USE' action is required, representing the shortest possible path.\n  if current_state.next_to(target_primitive_id):\n      return [ACTION_USE]\n\n  # 3. Breadth-First Search (BFS) to find the shortest path to a collection point\n  # The queue will store tuples: (current_position (row, col), list_of_actions_taken_to_reach_this_position).\n  # The `visited_positions` set keeps track of cells already added to the queue,\n  # preventing redundant computations and cycles, ensuring the shortest path is found.\n  bfs_queue = collections.deque([(agent_position, [])]) \n  visited_positions = {agent_position} \n\n  # Variables to store the result of the BFS.\n  found_path_to_collection_spot = False\n  optimal_movement_sequence = []\n\n  while bfs_queue:\n      (r_current, c_current), path_to_current_pos = bfs_queue.popleft()\n\n      # Create a temporary CraftState object for the current BFS node's position.\n      # This allows us to leverage the `next_to` method, which efficiently checks adjacency.\n      # Only the position needs to be updated for this check; other state attributes\n      # (grid, direction, inventory) remain constant during pathfinding.\n      temp_bfs_state = craft.CraftState(\n          scenario=current_state.scenario,\n          grid=game_grid,\n          pos=(r_current, c_current),\n          dir=current_state.dir,       # Agent's direction doesn't affect `next_to` check\n          inventory=current_state.inventory # Inventory doesn't affect `next_to` check\n      )\n\n      # If the current position in the BFS is adjacent to the target primitive,\n      # we have found the shortest sequence of movements to a spot from which\n      # the primitive can be collected.\n      if temp_bfs_state.next_to(target_primitive_id):\n          optimal_movement_sequence = path_to_current_pos\n          found_path_to_collection_spot = True\n          break  # Exit BFS: the shortest path is discovered.\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dr, dc), move_action in movement_deltas_with_actions:\n          r_next, c_next = r_current + dr, c_current + dc # Calculate the next potential position\n          next_pos_tuple = (r_next, c_next)\n\n          # --- Path Validity Checks for the Next Position ---\n          # 1. Boundary Check: Ensure the next position is within the grid's bounds.\n          if not (0 <= r_next < grid_rows and 0 <= c_next < grid_cols):\n              continue\n\n          # 2. Traversability Check: Ensure the next position is not an impassable obstacle.\n          # An obstacle is any cell containing a non-grabbable entity (e.g., \"WATER\", \"BOUNDARY\").\n          is_traversable = True\n          for non_grabbable_kind_id in env.world.non_grabbable_indices:\n              # If the cell is occupied by any non-grabbable item, it's not traversable.\n              if game_grid[r_next, c_next, non_grabbable_kind_id] == 1: \n                  is_traversable = False\n                  break \n          if not is_traversable:\n              continue \n          \n          # 3. Visited Check: Avoid revisiting positions already processed or queued.\n          # This is crucial for BFS to guarantee the shortest path and prevent infinite loops.\n          if next_pos_tuple not in visited_positions:\n              visited_positions.add(next_pos_tuple) # Mark as visited\n              # Add the new valid position to the queue with the updated path.\n              bfs_queue.append((next_pos_tuple, path_to_current_pos + [move_action]))\n\n  # 4. Construct the Final Action Sequence\n  # The sequence of actions to return starts with the optimal movements found by BFS.\n  final_action_sequence = optimal_movement_sequence\n\n  # If BFS successfully found a path to a cell adjacent to the primitive,\n  # append the 'USE' action to perform the collection.\n  if found_path_to_collection_spot:\n      final_action_sequence.append(ACTION_USE)\n  \n  return final_action_sequence", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:07:15.456127", "function_name": "collect", "function_body": "  current_state = env._current_state \n  grid = current_state.grid\n  agent_start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  primitive_id = env.world.cookbook.index[primitive]\n\n  ACTION_MAP = env.action_specs()\n  MOVE_UP = ACTION_MAP['UP']\n  MOVE_DOWN = ACTION_MAP['DOWN']\n  MOVE_LEFT = ACTION_MAP['LEFT']\n  MOVE_RIGHT = ACTION_MAP['RIGHT']\n  ACTION_USE = ACTION_MAP['USE']\n\n  # Define possible movement directions (delta row, delta col) and their associated actions.\n  MOVEMENT_DIRECTIONS = [\n      ((-1, 0), MOVE_UP),    # Up\n      ((1, 0), MOVE_DOWN),   # Down\n      ((0, -1), MOVE_LEFT),  # Left\n      ((0, 1), MOVE_RIGHT)   # Right\n  ]\n\n  # 1. Pre-checks and Immediate Collection\n  # If the primitive is not grabbable (e.g., water, workshop, boundary), it cannot be collected.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # If the agent is already adjacent to the primitive (within a 3x3 neighborhood),\n  # only a 'USE' action is needed. This is the shortest path.\n  if current_state.next_to(primitive_id):\n      return [ACTION_USE]\n\n  # 2. Breadth-First Search (BFS) for Shortest Path\n  # The queue stores tuples: (current_position (r, c), list_of_actions_taken_to_reach_here).\n  # The `visited` set prevents revisiting locations, ensuring the shortest path is found.\n  q = collections.deque([(agent_start_pos, [])]) \n  visited = {agent_start_pos} \n\n  shortest_path_actions = []\n  target_reachable = False # Flag to indicate if a path to an adjacent primitive was found.\n\n  while q:\n      (current_r, current_c), path_actions_so_far = q.popleft()\n\n      # Optimization: Directly check if current_pos is adjacent to the target primitive\n      # (within a 3x3 neighborhood, including diagonals), avoiding CraftState object creation.\n      is_adjacent_to_primitive = False\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              check_r, check_c = current_r + dr_adj, current_c + dc_adj\n              # Ensure the cell being checked is within grid bounds\n              if 0 <= check_r < grid_width and 0 <= check_c < grid_height:\n                  # If the cell contains the primitive\n                  if grid[check_r, check_c, primitive_id] == 1:\n                      is_adjacent_to_primitive = True\n                      break # Found primitive in neighborhood, no need to check further for this (current_r, current_c)\n          if is_adjacent_to_primitive:\n              break # Found primitive in neighborhood, break outer loop\n\n      if is_adjacent_to_primitive:\n          shortest_path_actions = path_actions_so_far\n          target_reachable = True\n          break  # Exit BFS: the shortest path to an adjacent cell has been found.\n\n      # Explore all valid neighboring cells from the current position.\n      for (dr, dc), action_to_take in MOVEMENT_DIRECTIONS:\n          next_r, next_c = current_r + dr, current_c + dc\n          next_pos = (next_r, next_c)\n\n          # --- Validity Checks for Next Position ---\n          # Check 1: Boundary Check - Ensure next_pos is within grid dimensions.\n          if not (0 <= next_r < grid_width and 0 <= next_c < grid_height):\n              continue\n\n          # Check 2: Traversability Check - Ensure next_pos is not an impassable obstacle.\n          # Impassable obstacles are defined as any cell containing a non-grabbable entity.\n          is_traversable = True\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[next_r, next_c, kind_idx] == 1: \n                  is_traversable = False\n                  break \n          if not is_traversable:\n              continue \n          \n          # Check 3: Visited Check - Avoid re-exploring positions already visited in BFS.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path_actions_so_far + [action_to_take]))\n\n  # 3. Construct the Final Action Sequence\n  final_actions_sequence = shortest_path_actions\n\n  # If a path was successfully found to a cell adjacent to the primitive,\n  # append the 'USE' action to complete the collection.\n  if target_reachable:\n      final_actions_sequence.append(ACTION_USE)\n  \n  return final_actions_sequence", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:08:07.731141", "function_name": "collect", "function_body": "  actions_list = []\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Store initial grid, agent's position, and direction.\n  # The grid is treated as static for the purpose of pathfinding.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, column) tuple\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive. This ID is used to locate the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This makes the code robust to changes in action integer values.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']  # DSL 'UP' typically means 'move forward'\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']  # Action to collect/interact with an item\n\n  # Define how agent's position changes for each direction when moving forward.\n  # Maps direction ID to (delta_row, delta_column).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: move +1 in column\n      1: (-1, 0),  # Facing UP: move -1 in row\n      2: (0, -1),  # Facing LEFT: move -1 in column\n      3: (1, 0)    # Facing DOWN: move +1 in row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings ensure the direction cycles correctly (0 -> 1 -> 2 -> 3 -> 0).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Determine which entities act as movement obstacles.\n  # 1. Non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) inherently block movement.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  # 2. If the target primitive itself is a grabbable item (e.g., WOOD, STONE),\n  #    the agent cannot walk onto its tile to collect it; it must be adjacent.\n  #    Therefore, the primitive's own ID also acts as an obstacle for movement.\n  #    This check is safe as adding an element already present in a set has no effect.\n  obstacles_to_movement_indices.add(primitive_id)\n  \n  # Optimization: If the primitive is already within the agent's immediate vicinity (3x3 neighborhood),\n  # it can be collected directly. Return only the USE action.\n  # The `CraftState.next_to` method provides this check efficiently.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: `((position_tuple, direction_int), list_of_actions_to_reach_here)`\n  # This allows tracking the agent's spatial location and orientation.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set prevents revisiting states (position, direction) to avoid cycles\n  # and ensure the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the action sequence once a collectible state is found.\n\n  # Main BFS loop: Continues until the queue is empty or a path is found.\n  while queue:\n      # Dequeue the current state and the path leading to it.\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current agent position (r, c) is a \"goal state\" for collection.\n      # A goal state means the primitive is present in any cell within the 3x3 neighborhood\n      # centered around the agent's current position on the initial grid.\n      is_collectible_from_current_pos = False\n      for dr_check in [-1, 0, 1]:  # Iterate over relative row offsets\n          for dc_check in [-1, 0, 1]:  # Iterate over relative column offsets\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectible_from_current_pos = True\n                  break # Primitive found in neighborhood, no need to check other cells for this position.\n          if is_collectible_from_current_pos:\n              break # Break outer loop too if found.\n\n      if is_collectible_from_current_pos:\n          target_path_actions = path_so_far # Store the path leading to this collectible state.\n          break # Path found, terminate BFS.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within grid bounds and not already visited\n      # with the same direction).\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the cell at `next_pos` contains any obstacle.\n          is_walkable = True\n          for kind_idx in obstacles_to_movement_indices:\n              # An important distinction: if the cell *itself* contains the primitive,\n              # it's considered an obstacle for walking, but it's a target for collection\n              # when adjacent. The `obstacles_to_movement_indices` set handles this.\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found (`target_path_actions` is not None),\n  # extend the actions list with this path and append the final 'USE' action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:08:09.041351", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Store initial grid, agent's position, and direction.\n  # The grid is considered static for pathfinding within this function.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, column) tuple\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions (rows, columns) for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This makes the code robust to changes in the underlying action integer values.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Typically moves agent forward in its current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # Action to collect/interact with an item\n\n  # Define how agent's position changes for each direction when moving forward.\n  # Maps direction ID to (delta_row, delta_column).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: move +1 in column\n      1: (-1, 0),  # Facing UP: move -1 in row\n      2: (0, -1),  # Facing LEFT: move -1 in column\n      3: (1, 0)    # Facing DOWN: move +1 in row\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These mappings ensure the direction cycles correctly (0 -> 1 -> 2 -> 3 -> 0).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Determine which entity kinds act as movement obstacles.\n  # This set includes:\n  # 1. All non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP_X locations).\n  # 2. The target primitive itself, IF it's a grabbable item. The agent cannot walk\n  #    onto the primitive's cell but must be adjacent to it to \"USE\" it.\n  movement_obstacles_indices = set(current_state.world.non_grabbable_indices)\n  if primitive_id in current_state.world.grabbable_indices:\n      movement_obstacles_indices.add(primitive_id)\n  \n  # Optimization: If the primitive is already within the agent's immediate vicinity (3x3 neighborhood),\n  # no complex pathfinding is needed; just return the 'USE' action.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for shortest pathfinding.\n  # The queue stores tuples: `((position_tuple, direction_int), list_of_actions_to_reach_here)`\n  # This allows tracking both the agent's spatial location and its orientation.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The `visited` set prevents revisiting states (position, direction) to avoid cycles\n  # and ensure that the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Will store the action sequence once a collectible state is found.\n\n  # Main BFS loop: Continues until the queue is empty or a path to a collectible state is found.\n  while queue:\n      # Dequeue the current state (position, direction) and the path leading to it.\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos # Unpack current position into row (r) and column (c)\n\n      # Check if the current agent position (r, c) is a \"goal state\" for collection.\n      # A goal state means the primitive is present in any cell within the 3x3 neighborhood\n      # centered around the agent's current position on the *initial grid*.\n      is_collectible_from_current_pos = False\n      for dr_check in [-1, 0, 1]:  # Iterate over relative row offsets\n          for dc_check in [-1, 0, 1]:  # Iterate over relative column offsets\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid boundaries.\n              if (0 <= check_r < GRID_ROWS and 0 <= check_c < GRID_COLS and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectible_from_current_pos = True\n                  break # Primitive found in neighborhood, no need to check other cells for this position.\n          if is_collectible_from_current_pos:\n              break # Break outer loop too if found.\n\n      if is_collectible_from_current_pos:\n          target_path_actions = path_so_far # Store the path leading to this collectible state.\n          break # Path found, terminate BFS.\n\n      # Explore possible next states by applying valid actions: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try MOVE_FORWARD_ACTION:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is valid (within grid bounds and not already visited\n      # with the same direction).\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir_move) not in visited):\n          \n          # Check if the cell at `next_pos` contains any movement obstacle.\n          is_walkable = True\n          for obstacle_id in movement_obstacles_indices:\n              if initial_grid[next_r, next_c, obstacle_id] > 0:\n                  is_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move)) # Mark the new state as visited.\n              # Add the new state to the queue with the updated path.\n              queue.append(((next_pos, next_dir_move), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try TURN_LEFT_ACTION:\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try TURN_RIGHT_ACTION:\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found (`target_path_actions` is not None),\n  # extend the actions list with this path and append the final 'USE' action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:09:18.360199", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive from the cookbook's index.\n  # This will typically raise a KeyError if the primitive name is not recognized.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings for clarity and to ensure correct action indices are used.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['RIGHT'] # Note: Corrected typo, assuming 'LEFT' means 'LEFT'\n  RIGHT = action_map['LEFT'] # Note: Corrected typo, assuming 'RIGHT' means 'RIGHT'\n  USE = action_map['USE']\n\n  # Fix the typo above: It should be LEFT=action_map['LEFT'] and RIGHT=action_map['RIGHT']\n  # Corrected actions mapping for clarity:\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Phase 1: Immediate Checks & Early Exits ---\n\n  # 1. If the agent's inventory already contains the primitive, no collection is needed.\n  # This is the most efficient check to avoid unnecessary computation.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Agent already possesses the item.\n\n  # 2. If the agent is currently adjacent to the primitive, it can be collected immediately.\n  # The `next_to` method checks the 3x3 neighborhood around the agent's position.\n  if current_state.next_to(primitive_idx):\n    return [USE] # Agent is in position to interact; execute USE action.\n\n  # --- Phase 2: Pathfinding Setup ---\n\n  # 3. Identify all grid locations where instances of the primitive exist.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Use NumPy's `where` function for efficient identification of primitive locations.\n  # This returns arrays of x and y coordinates where the primitive_idx layer has a value > 0.\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  \n  primitive_locations = []\n  for x, y in zip(primitive_x_coords, primitive_y_coords):\n      primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's currently unreachable.\n  if not primitive_locations:\n    return []\n\n  # 4. Define \"goal cells\" for the Breadth-First Search (BFS).\n  # A goal cell is any cell from which the agent can successfully collect the primitive.\n  # Since `CraftState.next_to` checks the 3x3 neighborhood (including the agent's own cell),\n  # any cell within this 3x3 vicinity of a primitive location is a valid target for pathfinding.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through all 3x3 neighbors relative to the primitive's location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries before adding.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 5. Determine which entity kinds make a cell impassable for agent movement.\n  # Impassable items are generally non-grabbable entities that are not workshops.\n  # Workshops are considered traversable interaction points.\n  # Convert to a list for efficient NumPy indexing during the traversal check.\n  impassable_kinds_indices = list(set(env.world.non_grabbable_indices) - set(env.world.workshop_indices))\n\n  # --- Phase 3: Breadth-First Search (BFS) for Shortest Path ---\n\n  start_pos = current_state.pos\n  \n  # The BFS queue stores tuples of (current_position (x, y), path_taken_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  \n  # A set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  # These represent moving North, South, West, East respectively.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our designated goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action as the final step, as the agent is now in a valid position\n      # to collect/interact with the primitive.\n      return path_so_far + [USE]\n\n    # Explore all four cardinal neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_kinds_indices`.\n      # Using `np.any` on a slice of the grid is an efficient way to check multiple kinds.\n      is_impassable_cell = False\n      if impassable_kinds_indices: # Only perform the check if there are actual impassable kinds\n          # Slice the grid at (nx, ny) across only the relevant impassable kind layers.\n          # If any value in this slice is > 0, it means an impassable item is present.\n          is_impassable_cell = np.any(grid[nx, ny, impassable_kinds_indices] > 0)\n      \n      if is_impassable_cell:\n          continue # Skip this cell as it cannot be traversed.\n\n      # If the new position is valid (within bounds and traversable) and has not been visited,\n      # add it to the queue for future exploration.\n      new_pos = (nx, ny)\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action]))\n\n  # --- Phase 4: No Path Found ---\n\n  # If the BFS completes and the queue becomes empty without finding a path to any goal cell,\n  # it means the primitive is unreachable from the current agent's position given the constraints.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:09:19.572772", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect a primitive item in the passed env.\n    This version refines pathfinding and collection logic for robustness and clarity.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current simulation state.\n        primitive (str): The name of the primitive item (e.g., \"WOOD\", \"WATER\", \"WORKSHOP0\")\n                         to locate and interact with.\n\n    Returns:\n        List[int]: A sequence of action indices (e.g., UP, DOWN, LEFT, RIGHT, USE)\n                   that, when executed, lead the agent to collect/interact with\n                   the specified primitive. Returns an empty list if the primitive\n                   is already in inventory (for grabbable items) or is unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Shorter alias for frequent access to world attributes\n\n  # 1. Map primitive name to its integer index\n  # The .index() method of CraftWorld.cookbook.index ensures we get a valid\n  # integer ID for the primitive, adding it to the internal index if not present.\n  primitive_idx = world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings from the environment's action_specs for clarity\n  # and to ensure correct action indices are used.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 2. Early Exit 1: If the primitive is a 'grabbable' item and already in the agent's inventory.\n  # This optimization prevents unnecessary movement/collection for items already possessed.\n  # Note: Non-grabbable items (like WORKSHOP or WATER) won't typically increase inventory count,\n  # so this check is primarily for collectible resources.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n    return [] # Agent already possesses the item.\n\n  # 3. Early Exit 2: If the agent is already in a position to \"use\" (collect/interact with) the primitive.\n  # `CraftState.next_to` checks if any instance of `primitive_idx` is in the 3x3 neighborhood\n  # around the agent's current position (including the agent's own cell).\n  if current_state.next_to(primitive_idx):\n    return [USE] # Agent is correctly positioned; just perform the USE action.\n\n  # 4. Locate all instances of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # Use numpy.where for efficient identification of all (x, y) coordinates\n  # where the primitive's specific layer in the grid has a value greater than 0.\n  primitive_x_coords, primitive_y_coords = np.where(grid[:, :, primitive_idx] > 0)\n  \n  # Combine the x and y coordinates into a list of (x, y) tuple locations.\n  primitive_locations = list(zip(primitive_x_coords, primitive_y_coords))\n\n  # If no instances of the primitive are found on the grid at all, it's unreachable.\n  if not primitive_locations:\n    return []\n\n  # 5. Define \"goal cells\" for the Breadth-First Search (BFS).\n  # A goal cell is any grid cell from which the agent can successfully `USE` the primitive.\n  # Since `next_to` checks the 3x3 neighborhood, any cell within the 3x3 vicinity\n  # of an actual primitive instance is a valid goal cell for the agent to reach.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through all 9 cells of the 3x3 neighborhood (including the center).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 6. Determine which entity kinds make a cell impassable for agent movement.\n  # Impassable items are generally non-grabbable entities that are NOT workshops.\n  # Workshops, although non-grabbable, are typically traversable and act as interaction points.\n  # This set difference operation is efficient for determining obstacles.\n  impassable_kinds_indices = list(set(world.non_grabbable_indices) - set(world.workshop_indices))\n  \n  # 7. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # The BFS queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited grid positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Dequeue the current position and the path leading to it.\n\n    # If the current position is one of our goal cells, we have found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action, as the agent is now in a position to interact with the primitive.\n      return path_so_far + [USE]\n\n    # Explore all valid neighboring cells (cardinal directions only).\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Ensure the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Determine if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_kinds_indices`.\n      is_impassable_cell = False\n      if impassable_kinds_indices: # Only perform this check if there are actual impassable kinds.\n          # np.any efficiently checks if any of the specified impassable kinds are present\n          # at the target cell (i.e., their count > 0).\n          is_impassable_cell = np.any(grid[nx, ny, impassable_kinds_indices] > 0)\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is blocked.\n\n      # Check 3: If the new position is valid and has not been visited yet, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any goal cell,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:10:15.919771", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Dynamically scale MAX_EXPLORED_STATES based on n_kinds.\n  # This factor (1 + len(world.cookbook.kinds)) aims to account for the increased state space\n  # when inventory changes can lead to new possibilities for collecting items, especially tools.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Check for primitive directly under the agent's feet.\n    if state.grid[current_r, current_c, i_kind] == 1: # The item is present at agent's current position\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count increased after USE action\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # === IMPROVEMENT for collect_v2: Targeted exploration of the USE action ===\n    # Only explore the USE action if it's potentially interacting with a useful\n    # intermediate item (like a tool) or a workshop, not just any state change.\n    \n    do_general_use_exploration = False\n    \n    # Check if agent is currently on a grabbable item that is NOT the target primitive.\n    # Picking this up might be an intermediate step (e.g., collecting a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0: # Check if there's any item at this position\n        item_at_pos_idx = item_at_pos_idx_flat[0] # Take the first if multiple\n        if item_at_pos_idx != i_kind and item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n    \n    # Check if agent is facing a workshop or another grabbable item (not the target primitive).\n    # Workshops are crucial for crafting and sometimes provide items or functionality.\n    # Other grabbables might be tools.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx != i_kind and \n                (item_in_front_idx in world.grabbable_indices or item_in_front_idx in world.workshop_indices)):\n                do_general_use_exploration = True\n\n    # If the general USE is deemed potentially useful, simulate and add to queue.\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add to queue if the USE action had a meaningful effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:10:17.864061", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Dynamically scale MAX_EXPLORED_STATES based on n_kinds.\n  # The factor '10' from collect_v1 is replaced by 'len(world.cookbook.kinds)' to better account\n  # for the potential complexity of inventory states, as more distinct items in the world\n  # mean more possible inventory combinations that might need to be explored.\n  # Adding 1 to ensure the multiplier is at least 1.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * (1 + len(world.cookbook.kinds)) \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Check for primitive directly under the agent's feet.\n    if state.grid[current_r, current_c, i_kind] == 1: # The item is present at agent's current position\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection: inventory count increased after USE action\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # IMPROVEMENT for collect_v2: Make the \"Explore General USE\" action more targeted.\n    # Instead of exploring `USE` unconditionally if it changes state, only explore it if\n    # it potentially interacts with a non-target grabbable item (e.g., a tool) or a workshop.\n    \n    do_general_use_exploration = False\n    \n    # Check if agent is currently on a grabbable item that is NOT the target primitive.\n    # If so, picking it up might be an intermediate step (e.g., collecting a tool).\n    item_at_pos_idx_flat = np.where(state.grid[current_r, current_c, :] == 1)[0]\n    if item_at_pos_idx_flat.size > 0: \n        item_at_pos_idx = item_at_pos_idx_flat[0] \n        if item_at_pos_idx != i_kind and item_at_pos_idx in world.grabbable_indices:\n            do_general_use_exploration = True\n    \n    # Check if agent is facing a workshop or another grabbable item (not the target primitive).\n    # Workshops are crucial for crafting and sometimes provide items or functionality.\n    # Other grabbables might be tools.\n    dr, dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + dr, current_c + dc\n    \n    if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        item_in_front_idx_flat = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        if item_in_front_idx_flat.size > 0:\n            item_in_front_idx = item_in_front_idx_flat[0]\n            if (item_in_front_idx != i_kind and \n                (item_in_front_idx in world.grabbable_indices or item_in_front_idx in world.workshop_indices)):\n                do_general_use_exploration = True\n\n    # If the general USE is deemed potentially useful based on context,\n    # then simulate and add to queue if it results in a meaningful state change.\n    if do_general_use_exploration:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n        # This prevents adding redundant states to the queue if USE had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:11:13.842292", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  # Assumed: 'UP' action moves the agent forward in its current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement = set(non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, rows, cols, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell\n      # Assumes grid[r, c, kind_idx] > 0 means the item is present.\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing grid dimensions and non-walkable kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:11:14.979625", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  # 'UP' action typically means moving forward in the current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement = set(non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, rows, cols, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell\n      # Assumes grid[r, c, kind_idx] > 0 means the item is present.\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Perform Breadth-First Search to find the shortest path to an adjacent primitive\n  while queue:\n      ((r, c), current_dir), path_to_current_state = queue.popleft()\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # If the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          # Found the path to be adjacent and facing the primitive.\n          # BFS guarantees this is the shortest path in terms of actions.\n          break \n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_forward = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if _is_cell_walkable(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement):\n          if (next_pos, next_dir_forward) not in visited:\n              visited.add((next_pos, next_dir_forward))\n              queue.append(((next_pos, next_dir_forward), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((r, c), next_dir_left) not in visited:\n          visited.add(((r, c), next_dir_left))\n          queue.append(((r, c), next_dir_left, path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((r, c), next_dir_right) not in visited:\n          visited.add(((r, c), next_dir_right))\n          queue.append(((r, c), next_dir_right, path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:11:36.690987", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state, grid, and agent's position from the environment\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Retrieve the integer ID for the target primitive from the cookbook's index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mappings for clarity and robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for each cardinal action\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # --- Pre-computation: Create an obstacle map ---\n  # This map marks cells that are non-traversable (e.g., boundary, water, workshops).\n  # Pre-computing this once improves efficiency during BFS pathfinding.\n  is_obstacle_map = np.zeros((WIDTH, HEIGHT), dtype=bool)\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          is_obstacle_map[r, c] = any(grid[r, c, kind_idx] == 1 \n                                      for kind_idx in env.world.non_grabbable_indices)\n\n\n  # --- Step 1: Immediate Check ---\n  # If the agent is already positioned next to the primitive, a single 'USE' action is sufficient.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # --- Step 2: Locate All Primitive Instances on the Grid ---\n  # Iterate through the grid to find all (row, col) coordinates where the primitive exists.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # --- Step 3: Breadth-First Search (BFS) for the Shortest Path ---\n  # The goal of BFS here is to find the shortest path to *any cell adjacent*\n  # to *any instance* of the target primitive.\n  \n  # Queue for BFS: stores tuples of ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  \n  # Set to keep track of visited positions to prevent infinite loops and redundant explorations\n  visited = {current_pos} \n\n  # Variable to store the shortest path found to an adjacent cell.\n  # This will be populated once the BFS finds its goal.\n  shortest_path_to_adj = None \n\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # Check if the current cell (r, c) is adjacent to any of the primitive locations.\n      # Being adjacent means Manhattan distance is 1. From such a cell, 'USE' can be performed.\n      is_adjacent_to_primitive_target = False\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              shortest_path_to_adj = path_so_far # Found the shortest path to this adjacent cell\n              is_adjacent_to_primitive_target = True\n              break # No need to check other primitive locations from this 'r, c' if one is found\n      \n      if is_adjacent_to_primitive_target:\n          break # Exit the BFS loop; the shortest path has been found\n\n      # Explore valid neighboring cells (UP, DOWN, LEFT, RIGHT)\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate coordinates of the neighbor\n\n          # Boundary Check: Ensure the neighbor is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Obstacle Check: Use the pre-computed `is_obstacle_map` for efficiency.\n          if is_obstacle_map[nr, nc]:\n              continue # Skip to the next neighbor if this one is an obstacle\n          \n          # Visited Check: Only proceed if this neighbor has not been visited yet\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              # Add the neighbor to the queue with the extended path\n              q.append(((nr, nc), path_so_far + [action_dir]))\n    \n  # --- Step 4: Construct the Final Sequence of Actions ---\n  # If a path to an adjacent cell was found during BFS:\n  if shortest_path_to_adj is not None:\n      actions.extend(shortest_path_to_adj) # Add the movement actions\n      actions.append(USE) # Append the 'USE' action to collect the primitive\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:11:38.109017", "function_name": "collect", "function_body": "  actions = []\n  \n  # 1. Retrieve current environment state and essential IDs.\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos # Agent's current (row, column) position\n  \n  # Get the integer ID for the specified primitive string.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get grid dimensions.\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names to their integer values.\n  action_specs = env.action_specs()\n  DOWN = action_specs['DOWN']\n  UP = action_specs['UP']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Define movement deltas for the four cardinal directions.\n  MOVEMENT_DELTAS = {\n      UP: (-1, 0),    \n      DOWN: (1, 0),   \n      LEFT: (0, -1),  \n      RIGHT: (0, 1)   \n  }\n\n  # 2. Pre-compute an obstacle map for efficient traversability checks.\n  #    A cell is an obstacle if it contains any non-grabbable entity.\n  is_obstacle_map = np.zeros((GRID_ROWS, GRID_COLS), dtype=bool)\n  for r in range(GRID_ROWS):\n      for c in range(GRID_COLS):\n          is_obstacle_map[r, c] = any(grid[r, c, kind_idx] == 1 \n                                      for kind_idx in env.world.non_grabbable_indices)\n\n  # 3. Immediate check: If the agent is already adjacent to the primitive.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 4. Locate all occurrences of the target primitive on the grid.\n  primitive_locations = []\n  for r in range(GRID_ROWS):\n      for c in range(GRID_COLS):\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found, return empty actions.\n  if not primitive_locations:\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell *adjacent* to any of the primitive locations.\n\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} \n  shortest_path_to_adjacent = None \n\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # Check if the current cell (r, c) is adjacent to any primitive location.\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              shortest_path_to_adjacent = path_so_far \n              break \n      \n      if shortest_path_to_adjacent is not None:\n          break \n\n      # Explore valid neighboring cells.\n      for action_dir, (dr, dc) in MOVEMENT_DELTAS.items():\n          nr, nc = r + dr, c + dc \n\n          # Boundary check.\n          if not (0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS):\n              continue\n          \n          # Obstacle check using the pre-computed map.\n          if is_obstacle_map[nr, nc]:\n              continue \n          \n          # If not visited, add to queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc)) \n              new_path = path_so_far + [action_dir] \n              q.append(((nr, nc), new_path)) \n    \n  # 6. Construct the final action sequence.\n  if shortest_path_to_adjacent is not None:\n      actions.extend(shortest_path_to_adjacent)\n      actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T09:12:28.395122", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version further refines the pathfinding logic to find the shortest\n  sequence of actions to collect a specified primitive. It robustly handles\n  initial agent state, environmental obstacles, and confirms grabbability\n  of the target item.\n\n  Args:\n      env (env.CraftLab): The CraftLab object.\n      primitive (str): The name of the primitive to collect.\n\n  Returns:\n      List[int]: A sequence of action indices to execute to collect the primitive.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Get the current CraftState from the CraftLab environment.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get grid dimensions. `grid.shape` returns (rows, columns, kinds).\n  grid_rows, grid_cols, _ = initial_grid.shape\n\n  # 1. Get Primitive ID and Check Grabbability\n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index.get(primitive) # Use .get() for safer access.\n\n  # If the primitive name is not found in the cookbook's index, it's an invalid target.\n  if primitive_id is None:\n      return [] \n  \n  # Crucial check: If the item is not grabbable (e.g., \"water\", \"boundary\", \"workbench\"),\n  # it cannot be 'collected' using the 'USE' action. This prevents trying to collect non-items.\n  # 'grabbable_indices' is a list of int indices, so check for membership.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Define Action Mappings from the environment's action space.\n  # These map abstract actions (like \"move forward\") to integer codes understood by env.step().\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' typically moves the agent forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to collect the item once adjacent and facing it.\n\n  # 3. Define Movement and Turning Constants for agent's navigation.\n  # DIR_TO_DRDC: Maps agent's direction (0:Right, 1:Up, 2:Left, 3:Down) to a change in row (dr) and column (dc) for a forward move.\n  # (dr, dc) = (row_change, col_change)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n  # TURN_LEFT_MAP: Maps current direction to the new direction after turning left.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up -> Left -> Down -> Right\n  # TURN_RIGHT_MAP: Maps current direction to the new direction after turning right.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Indices of entities that the agent cannot walk over (e.g., boundaries, water, workshops).\n  # These are generally the 'environment' entities or non-grabbables that are static obstacles.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for BFS Pathfinding Logic\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates (r, c) are within the valid grid boundaries.\"\"\"\n      return 0 <= r < grid_rows and 0 <= c < grid_cols\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"Checks if the given cell (r, c) is traversable by the agent's body.\n      An agent cannot walk onto cells containing non-grabbable entities or\n      onto the primitive it intends to collect (it must stop adjacent to it).\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False # Cannot walk off the grid.\n      \n      # Check if the cell contains any entity that blocks movement.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # This cell is an obstacle.\n      \n      # The agent's body cannot occupy the same cell as the primitive it wants to pick up.\n      # It must be adjacent to it.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # Cannot walk ONTO the primitive.\n          \n      return True # The cell is safe to move into.\n\n  def _is_target_facing(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"Checks if, from the given position and direction, the target primitive\n      is located in the cell directly in front of the agent, making it ready\n      for a 'USE' action.\n      \"\"\"\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir] # Get the relative coordinates for the cell directly ahead.\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # The cell in front is outside grid boundaries, so no primitive there.\n      \n      # The primitive must be present in the cell directly in front of the agent.\n      # Check if the primitive_id layer at (front_r, front_c) has a count > 0.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) Implementation for shortest path.\n\n  # BFS state is represented as: ((row, col), direction).\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  # This ensures that BFS finds the shortest path by not re-processing states already reached via a shorter or equal path.\n  visited = {(initial_pos, initial_dir)}\n\n  target_movement_actions = None # This will store the sequence of actions to reach the 'ready-to-use' state.\n\n  # Optimization: Check if the agent is already in the target 'ready-to-use' state at the very beginning.\n  if _is_target_facing(initial_pos, initial_dir):\n      target_movement_actions = [] # No prior movement/turn actions are needed.\n\n  # If not immediately at the target, perform BFS to find the shortest path.\n  # BFS continues until the target state is found or the queue is exhausted.\n  while queue and target_movement_actions is None:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      \n      # Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # 5a. Try Moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Get movement vector for current direction.\n      next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_move = (next_r, next_c)\n      next_dir_move = current_dir # Direction remains unchanged when moving.\n\n      if _is_walkable_cell(next_pos_move): # Check if the intended next cell is traversable.\n          new_state = (next_pos_move, next_dir_move)\n          if new_state not in visited: # Avoid re-visiting states or re-adding to queue.\n              visited.add(new_state)\n              new_path = path_actions + [MOVE_FORWARD_ACTION]\n              \n              # Check if this new state places the agent next to and facing the primitive.\n              if _is_target_facing(next_pos_move, next_dir_move):\n                  target_movement_actions = new_path # Found the shortest path to the target.\n                  break # Exit BFS loop immediately.\n              queue.append((new_state, new_path)) # Add to queue for further exploration.\n\n      # 5b. Try Turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      new_state_left = (current_pos, next_dir_left) # Position remains the same, only direction changes.\n      if new_state_left not in visited:\n          visited.add(new_state_left)\n          new_path_left = path_actions + [TURN_LEFT_ACTION]\n          if _is_target_facing(current_pos, next_dir_left): # Check if turning puts agent in target state.\n              target_movement_actions = new_path_left\n              break # Exit BFS.\n          queue.append((new_state_left, new_path_left))\n\n      # 5c. Try Turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      new_state_right = (current_pos, next_dir_right) # Position remains the same, only direction changes.\n      if new_state_right not in visited:\n          visited.add(new_state_right)\n          new_path_right = path_actions + [TURN_RIGHT_ACTION]\n          if _is_target_facing(current_pos, next_dir_right): # Check if turning puts agent in target state.\n              target_movement_actions = new_path_right\n              break # Exit BFS.\n          queue.append((new_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List\n  # If a path was successfully found (either immediately at start or via BFS),\n  # append the final 'USE' action to the movement path.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:12:29.514154", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's initial direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Extract grid dimensions for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # 1. Resolve Primitive ID and Perform Essential Grabbability Checks\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # The DSL ensures 'primitive' is a valid string name.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Crucial safety check: If the resolved ID is not associated with a grabbable item\n  # (e.g., \"water\", \"stone\", \"WORKSHOP0\" which are non-grabbable environment elements),\n  # then it cannot be collected. Return an empty list as it's an unachievable goal\n  # for this function's purpose.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Map DSL-like Actions to Environment-Specific Integer Indices\n  # These mappings are consistent across CraftWorld environments.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action moves the agent forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to collect/interact with an item in front.\n\n  # 3. Define Agent Movement and Turning Logic Constants\n  # These constants describe how the agent's position and direction change.\n  # `DIR_TO_DRDC`: Maps agent's direction (0-3) to a tuple (delta_row, delta_col) for a forward move.\n  # 0: Right (+col), 1: Up (-row), 2: Left (-col), 3: Down (+row).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n  # `TURN_LEFT_MAP`: Maps current direction to the new direction after turning left.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Example: Right (0) -> Up (1)\n  # `TURN_RIGHT_MAP`: Maps current direction to the new direction after turning right.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Example: Right (0) -> Down (3)\n\n  # Cache indices of entities that block agent movement (e.g., walls, water, workshops).\n  # The agent cannot traverse these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for Breadth-First Search (BFS) Pathfinding Logic\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates (row, col) are within the valid grid bounds.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can physically move into the given cell (r, c).\n      A cell is walkable if:\n      1. It's within grid boundaries.\n      2. It does not contain any non-grabbable (and thus non-walkable) entities.\n      3. It does not contain the primitive itself, as the agent collects from *adjacent* cells,\n         not by occupying the primitive's cell.\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check for any non-grabbable (blocking) entities in the cell.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # This cell is blocked.\n      \n      # Ensure the agent doesn't try to walk onto the primitive itself.\n      # The 'USE' action operates on the cell *in front* of the agent.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # This cell contains the primitive, agent cannot walk onto it.\n          \n      return True # The cell is traversable.\n\n  def _is_target_facing_state(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the given agent position and direction, the target primitive\n      is located directly in the cell in front of the agent, making it ready for a 'USE' action.\n      \"\"\"\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # The cell in front is outside grid boundaries.\n      \n      # Return True if the primitive exists in the cell directly in front.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) to Find Shortest Path\n  # BFS guarantees finding the shortest path in terms of number of actions when all actions have equal cost.\n\n  # `queue`: Stores tuples of `(agent_state, path_to_state)`.\n  # `agent_state` is `((row, col), direction)`.\n  # `path_to_state` is a list of integer action codes.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # `visited`: Stores `agent_state` tuples `((row, col), direction)` to avoid cycles\n  # and re-exploring paths, ensuring optimality.\n  visited = {(initial_pos, initial_dir)}\n\n  # `target_movement_actions`: Will store the sequence of actions leading to a state\n  # where the agent is ready to use the 'USE' action.\n  target_movement_actions = None \n\n  # Optimization: Check if the agent is already in the 'ready-to-use' state at the start.\n  if _is_target_facing_state(initial_pos, initial_dir):\n      target_movement_actions = [] # No preceding movement actions are needed.\n\n  # If not immediately at the target, proceed with BFS.\n  if target_movement_actions is None:\n      while queue:\n          (current_pos, current_dir), path_so_far = queue.popleft()\n          \n          # Explore all possible next actions from the `current_state`:\n          # Move Forward, Turn Left, Turn Right.\n\n          # 5a. Attempt to Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_after_move = (next_r, next_c)\n          next_dir_after_move = current_dir # Direction does not change when moving.\n\n          if _is_walkable_cell(next_pos_after_move): # Check if the destination cell is traversable.\n              new_state_after_move = (next_pos_after_move, next_dir_after_move)\n              if new_state_after_move not in visited:\n                  visited.add(new_state_after_move)\n                  new_path = path_so_far + [MOVE_FORWARD_ACTION]\n                  # If this new state makes the agent ready to collect, we found the shortest path.\n                  if _is_target_facing_state(next_pos_after_move, next_dir_after_move):\n                      target_movement_actions = new_path\n                      break # Shortest path found, terminate BFS.\n                  queue.append((new_state_after_move, new_path)) # Add to queue for further exploration.\n\n          # 5b. Attempt to Turn Left\n          next_dir_after_turn_left = TURN_LEFT_MAP[current_dir]\n          # Position remains unchanged when turning, only direction updates.\n          new_state_after_turn_left = (current_pos, next_dir_after_turn_left) \n          if new_state_after_turn_left not in visited:\n              visited.add(new_state_after_turn_left)\n              new_path = path_so_far + [TURN_LEFT_ACTION]\n              # Check if this new orientation makes the agent ready to collect.\n              if _is_target_facing_state(current_pos, next_dir_after_turn_left):\n                  target_movement_actions = new_path\n                  break # Shortest path found, terminate BFS.\n              queue.append((new_state_after_turn_left, new_path))\n\n          # 5c. Attempt to Turn Right\n          next_dir_after_turn_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains unchanged when turning, only direction updates.\n          new_state_after_turn_right = (current_pos, next_dir_after_turn_right)\n          if new_state_after_turn_right not in visited:\n              visited.add(new_state_after_turn_right)\n              new_path = path_so_far + [TURN_RIGHT_ACTION]\n              # Check if this new orientation makes the agent ready to collect.\n              if _is_target_facing_state(current_pos, next_dir_after_turn_right):\n                  target_movement_actions = new_path\n                  break # Shortest path found, terminate BFS.\n              queue.append((new_state_after_turn_right, new_path))\n      \n  # 6. Construct the Final Action List\n  # If a path was successfully found (i.e., `target_movement_actions` is not None),\n  # append the final 'USE' action to the movement sequence.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:13:55.685394", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function implements a Breadth-First Search (BFS) to find the shortest\n  sequence of movement and turning actions for the agent to reach a position\n  adjacent to the specified primitive, facing it, and then performing the 'USE'\n  action to collect it.\n\n  It handles cases where the primitive is unreachable, or not a grabbable item.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance, providing access\n                          to the current game state (grid, inventory, agent pos/dir)\n                          and world configuration (cookbook, action mappings).\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"IRON\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., [UP, LEFT, USE]) that,\n                 when executed, lead to the collection of the primitive.\n                 Returns an empty list if the primitive is not grabbable or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  agent_initial_pos = current_state.pos\n  agent_initial_dir = current_state.dir # Agent's initial direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # 1. Resolve Primitive ID and Perform Essential Grabbability Checks\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # The DSL guarantees 'primitive' is a valid string name, so it will be in the index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # If the resolved ID is not associated with a grabbable item (e.g., \"WATER\", \"WORKSHOP0\"),\n  # then it cannot be collected using the 'USE' action in this context.\n  # Return an empty list, as this goal is unachievable via 'collect'.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Map DSL-like Actions to Environment-Specific Integer Indices\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']    # 'UP' action moves agent forward in current direction.\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']            # The action to collect/interact with an item in front.\n\n  # 3. Define Agent Movement and Turning Logic Constants\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # `DIRECTION_VECTORS`: Maps agent's direction (0-3) to a tuple (delta_row, delta_col) for a forward move.\n  # 0: Right (+col), 1: Up (-row), 2: Left (-col), 3: Down (+row).\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n  # `TURN_LEFT_MAP`: Maps current direction to the new direction after turning left.\n  # Example: Right (0) -> Up (1). This is a counter-clockwise rotation.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} \n  # `TURN_RIGHT_MAP`: Maps current direction to the new direction after turning right.\n  # Example: Right (0) -> Down (3). This is a clockwise rotation.\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Cache indices of entities that block agent movement (e.g., walls, water, workshops).\n  # These are generally the non-grabbable items that also cannot be walked upon.\n  impassable_terrain_kinds = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for Pathfinding Logic\n\n  def _is_valid_grid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates (row, col) are within the valid grid bounds.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_cell_walkable(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can physically move into the given cell (r, c).\n      A cell is considered walkable if:\n      1. It's within grid boundaries.\n      2. It does not contain any 'impassable terrain' entities.\n      3. It does not contain the *target primitive itself*, because the agent\n         collects by using the 'USE' action *adjacent* to the primitive, not by\n         occupying the primitive's cell.\n      \"\"\"\n      r, c = pos\n      if not _is_valid_grid_coord(r, c):\n          return False\n      \n      # Check for any blocking entities in the cell.\n      for kind_idx in impassable_terrain_kinds:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # This cell contains an impassable object.\n      \n      # Crucial: Agent cannot walk onto the primitive itself.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # This cell contains the target primitive.\n          \n      return True # The cell is traversable.\n\n  def _is_ready_to_collect(agent_pos: tuple[int, int], agent_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the given agent position and direction, the target primitive\n      is located directly in the cell in front of the agent, making it ready for\n      a 'USE' action.\n      \"\"\"\n      r, c = agent_pos\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIRECTION_VECTORS[agent_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_grid_coord(front_r, front_c):\n          return False # The cell in front is outside grid boundaries.\n      \n      # Return True if the primitive exists in the cell directly in front.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) to Find Shortest Path\n  # State in BFS: ((agent_row, agent_col), agent_direction)\n  # Queue element: (current_agent_state, list_of_actions_to_reach_this_state)\n\n  queue = collections.deque([((agent_initial_pos, agent_initial_dir), [])])\n  \n  # Visited set: Stores agent_state tuples to avoid redundant exploration and cycles.\n  visited = {(agent_initial_pos, agent_initial_dir)}\n\n  path_to_collection_point = None # This will store the sequence of actions to get ready for 'USE'.\n\n  # Optimization: Check if the agent is already in the 'ready-to-collect' state at the start.\n  if _is_ready_to_collect(agent_initial_pos, agent_initial_dir):\n      path_to_collection_point = [] # No preceding movement actions are needed.\n\n  # If not immediately at the target, proceed with BFS to find the shortest path.\n  if path_to_collection_point is None:\n      while queue:\n          (current_pos, current_dir), path_so_far = queue.popleft()\n          \n          # Explore all possible next actions from the `current_state`:\n          # Move Forward, Turn Left, Turn Right.\n\n          # 5a. Try Moving Forward\n          move_dr, move_dc = DIRECTION_VECTORS[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction does not change after moving.\n\n          if _is_cell_walkable(next_pos_fwd):\n              new_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if new_state_fwd not in visited:\n                  visited.add(new_state_fwd)\n                  new_path_fwd = path_so_far + [ACTION_MOVE_FORWARD]\n                  \n                  # Check if moving forward brought us to a state ready for collection.\n                  if _is_ready_to_collect(next_pos_fwd, next_dir_fwd):\n                      path_to_collection_point = new_path_fwd\n                      break # Shortest path found, terminate BFS.\n                  queue.append((new_state_fwd, new_path_fwd))\n\n          # 5b. Try Turning Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Position remains unchanged when turning, only direction updates.\n          new_state_left = (current_pos, next_dir_left) \n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_so_far + [ACTION_TURN_LEFT]\n              \n              # Check if turning left made us ready for collection.\n              if _is_ready_to_collect(current_pos, next_dir_left):\n                  path_to_collection_point = new_path_left\n                  break # Shortest path found, terminate BFS.\n              queue.append((new_state_left, new_path_left))\n\n          # 5c. Try Turning Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains unchanged when turning, only direction updates.\n          new_state_right = (current_pos, next_dir_right)\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_so_far + [ACTION_TURN_RIGHT]\n              \n              # Check if turning right made us ready for collection.\n              if _is_ready_to_collect(current_pos, next_dir_right):\n                  path_to_collection_point = new_path_right\n                  break # Shortest path found, terminate BFS.\n              queue.append((new_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List\n  final_actions_list = []\n  if path_to_collection_point is not None:\n      # If a path was found, add the movement/turning actions.\n      final_actions_list.extend(path_to_collection_point)\n      # Finally, append the 'USE' action to collect the primitive.\n      final_actions_list.append(ACTION_USE)\n\n  return final_actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:13:56.791435", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with detailed comments and clarity.\"\"\"\n\n  actions_list = [] # This will store the final sequence of actions to return.\n  \n  # Get the current state of the environment.\n  current_state = env._current_state \n  initial_grid = current_state.grid       # The static grid layout at the start of the search.\n  initial_pos = current_state.pos         # Agent's starting (row, col) position.\n  initial_dir = current_state.dir         # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Extract grid dimensions for boundary checks.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # 1. Resolve Primitive ID and Perform Essential Grabbability Checks\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # The DSL ensures 'primitive' is a valid string name, but its 'collectability' needs validation.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # If the resolved ID is not associated with a grabbable item (e.g., it's a \"water\" or \"workshop\"),\n  # it cannot be collected using the 'USE' action. Return an empty list as this goal is unachievable\n  # for this specific 'collect' function.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Map DSL-like Actions to Environment-Specific Integer Indices\n  # These mappings are standard for the CraftLab environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' action moves the agent forward in its current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']            # The action to collect/interact with an item in front.\n\n  # 3. Define Agent Movement and Turning Logic Constants\n  # These constants describe how the agent's position and direction change based on actions.\n  # `DIR_TO_DRDC`: Maps agent's direction (0-3) to a tuple (delta_row, delta_col) for a forward move.\n  # Directions: 0=Right (+col), 1=Up (-row), 2=Left (-col), 3=Down (+row).\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n  # `TURN_LEFT_MAP`: Maps current direction to the new direction after turning left (counter-clockwise).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # E.g., Right (0) -> Up (1)\n  # `TURN_RIGHT_MAP`: Maps current direction to the new direction after turning right (clockwise).\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # E.g., Right (0) -> Down (3)\n\n  # Cache indices of entities that block agent movement (e.g., walls, water, workshops).\n  # The agent cannot physically move into these cells.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # 4. Helper Functions for Breadth-First Search (BFS) Pathfinding Logic\n\n  def _is_valid_coord(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid coordinates (row, col) are within the valid grid boundaries.\"\"\"\n      return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS\n\n  def _is_walkable_cell(pos: tuple[int, int]) -> bool:\n      \"\"\"\n      Determines if the agent can physically move into the given cell (r, c).\n      A cell is walkable if:\n      1. It's within grid boundaries.\n      2. It does not contain any entities that are designated as non-grabbable\n         (which typically implies non-walkable, like walls, workshops, water).\n      3. It does not contain the `primitive_id` itself, as the agent collects\n         from *adjacent* cells, not by occupying the primitive's cell.\n      \"\"\"\n      r, c = pos\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Check for any non-grabbable (blocking) entities in the cell.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False # This cell contains a blocking obstacle.\n      \n      # The agent should not walk *onto* the primitive it intends to collect.\n      # The 'USE' action is performed on the cell *in front* of the agent.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False # This cell contains the target primitive, agent cannot occupy it.\n          \n      return True # The cell is traversable for the agent.\n\n  def _is_target_facing_state(pos: tuple[int, int], current_dir: int) -> bool:\n      \"\"\"\n      Checks if, from the given agent position and direction, the target primitive\n      is located directly in the cell in front of the agent, making it ready for a 'USE' action.\n      \"\"\"\n      r, c = pos\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      if not _is_valid_coord(front_r, front_c):\n          return False # The cell in front is outside grid boundaries.\n      \n      # Return True if the primitive exists (quantity > 0) in the cell directly in front.\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  # 5. Breadth-First Search (BFS) for Pathfinding\n  # BFS guarantees finding the shortest path (in terms of action count) because\n  # all actions (move, turn) are treated as having equal cost.\n\n  # `queue`: Stores tuples of `(agent_state, path_to_state)`.\n  # `agent_state` is `((row, col), direction)`.\n  # `path_to_state` is a list of integer action codes (the sequence of actions taken to reach this state).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # `visited`: Stores `agent_state` tuples `((row, col), direction)` to prevent:\n  #   - Re-exploring already visited states (optimality).\n  #   - Infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  # `target_movement_actions`: This will store the sequence of actions that leads\n  # the agent to a position and orientation where it can successfully perform the 'USE' action.\n  target_movement_actions = None \n\n  # Optimization: Check if the agent is already in the 'ready-to-use' state at the very beginning.\n  if _is_target_facing_state(initial_pos, initial_dir):\n      target_movement_actions = [] # No preceding movement actions are needed.\n\n  # If not immediately at the target, proceed with the BFS search.\n  if target_movement_actions is None:\n      while queue:\n          (current_pos, current_dir), path_so_far = queue.popleft()\n          \n          # Explore all three possible next actions from the `current_state`:\n          # 1. Move Forward, 2. Turn Left, 3. Turn Right.\n\n          # --- 5a. Explore Move Forward action ---\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r_fwd, next_c_fwd = current_pos[0] + move_dr, current_pos[1] + move_dc\n          next_pos_fwd = (next_r_fwd, next_c_fwd)\n          next_dir_fwd = current_dir # Direction does not change when moving.\n\n          # Check if the potential destination cell is walkable and the resulting state is new.\n          if _is_walkable_cell(next_pos_fwd):\n              new_state_fwd = (next_pos_fwd, next_dir_fwd)\n              if new_state_fwd not in visited:\n                  visited.add(new_state_fwd)\n                  new_path_fwd = path_so_far + [MOVE_FORWARD_ACTION]\n                  \n                  # If this new state makes the agent ready to collect the primitive,\n                  # we have found the shortest path.\n                  if _is_target_facing_state(next_pos_fwd, next_dir_fwd):\n                      target_movement_actions = new_path_fwd\n                      break # Terminate BFS as the shortest path is guaranteed.\n                  \n                  # Otherwise, add this new state to the queue for further exploration.\n                  queue.append((new_state_fwd, new_path_fwd))\n\n          # --- 5b. Explore Turn Left action ---\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          # Position remains unchanged when turning, only direction updates.\n          new_state_left = (current_pos, next_dir_left) \n          \n          # Check if this new state (same position, new direction) has been visited.\n          if new_state_left not in visited:\n              visited.add(new_state_left)\n              new_path_left = path_so_far + [TURN_LEFT_ACTION]\n              \n              # If this new orientation makes the agent ready to collect.\n              if _is_target_facing_state(current_pos, next_dir_left):\n                  target_movement_actions = new_path_left\n                  break # Shortest path found, terminate BFS.\n              \n              # Add to queue if not a goal state yet.\n              queue.append((new_state_left, new_path_left))\n\n          # --- 5c. Explore Turn Right action ---\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          # Position remains unchanged when turning.\n          new_state_right = (current_pos, next_dir_right)\n          \n          # Check if this new state has been visited.\n          if new_state_right not in visited:\n              visited.add(new_state_right)\n              new_path_right = path_so_far + [TURN_RIGHT_ACTION]\n              \n              # If this new orientation makes the agent ready to collect.\n              if _is_target_facing_state(current_pos, next_dir_right):\n                  target_movement_actions = new_path_right\n                  break # Shortest path found, terminate BFS.\n              \n              # Add to queue if not a goal state yet.\n              queue.append((new_state_right, new_path_right))\n      \n  # 6. Construct the Final Action List\n  # If a path was successfully found (i.e., `target_movement_actions` is not None),\n  # append the final 'USE' action to the discovered movement sequence.\n  if target_movement_actions is not None:\n      actions_list.extend(target_movement_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:15:01.337752", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs typically means \"move forward\"\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement_set = set(non_grabbable_indices)\n  non_walkable_for_movement_set.add(primitive_id)\n  \n  # Convert to a numpy array once for efficient grid checking during BFS.\n  # This is an optimization for potentially faster checks compared to iterating a Python set.\n  non_walkable_for_movement_array = np.array(list(non_walkable_for_movement_set), dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Check bounds first\n          if 0 <= next_r < num_rows and 0 <= next_c < num_cols:\n              # Check if the next_pos contains any blocking kind using the pre-computed numpy array.\n              # np.any efficiently checks if any non-walkable item exists in the cell's `kind` dimension.\n              if not np.any(initial_grid[next_r, next_c, non_walkable_for_movement_array] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:15:02.620049", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # Extract grid dimensions: (rows, columns)\n  grid_rows, grid_cols, _ = initial_grid.shape \n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  \n  # Combine all non-walkable indices into a single set for efficiency, including the primitive itself.\n  # The agent cannot walk *onto* the primitive; it must be adjacent to use it.\n  all_non_walkable_indices = set(non_grabbable_indices)\n  all_non_walkable_indices.add(primitive_id) \n  # Convert to a numpy array once for efficient grid checking during BFS.\n  non_walkable_array_for_check = np.array(list(all_non_walkable_indices), dtype=int)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < grid_rows and 0 <= next_c < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next_pos contains any blocking kind using the pre-computed numpy array.\n          # np.any efficiently checks if any non-walkable item exists in the cell's `kind` dimension.\n          if not np.any(initial_grid[next_r, next_c, non_walkable_array_for_check] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:15:56.054615", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:15:57.172839", "function_name": "collect", "function_body": "  actions_sequence = []\n\n  # Get the current state of the environment from the CraftLab instance.\n  current_state = env._current_state\n  grid = current_state.grid # The grid layout: numpy.ndarray of shape (HEIGHT, WIDTH, n_kinds)\n  agent_pos = current_state.pos # Agent's current (row, col) position: tuple(int, int)\n  agent_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN): int\n\n  # Attempt to retrieve the integer ID for the target primitive from the world's cookbook index.\n  # If the primitive name is not recognized or does not exist in the game's index,\n  # no actions can be generated to collect it.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is invalid, return an empty list of actions.\n      return []\n\n  grid_height, grid_width, _ = grid.shape\n\n  # Map the symbolic action names (as defined in the DSL and environment)\n  # to their corresponding integer action IDs used by the `env.step()` method.\n  action_ids = env.action_specs()\n  ACTION_MOVE_FORWARD = action_ids['UP']    # Assumes 'UP' means move in the current facing direction.\n  ACTION_TURN_LEFT = action_ids['LEFT']\n  ACTION_TURN_RIGHT = action_ids['RIGHT']\n  ACTION_USE = action_ids['USE']            # Action to interact with the cell directly in front of the agent.\n\n  # Define changes in (row, col) coordinates for each facing direction when moving forward.\n  # Direction 0: RIGHT (positive column change)\n  # Direction 1: UP (negative row change)\n  # Direction 2: LEFT (negative column change)\n  # Direction 3: DOWN (positive row change)\n  DIRECTION_VECTORS = {\n      0: (0, 1),   # Facing RIGHT (dr=0, dc=+1)\n      1: (-1, 0),  # Facing UP (dr=-1, dc=0)\n      2: (0, -1),  # Facing LEFT (dr=0, dc=-1)\n      3: (1, 0)    # Facing DOWN (dr=+1, dc=0)\n  }\n\n  # Define how the agent's direction changes when performing 'TURN_LEFT' or 'TURN_RIGHT' actions.\n  # These maps ensure cyclical rotation through the four directions.\n  TURN_LEFT_EFFECT = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., If facing RIGHT (0), turning LEFT makes agent face UP (1).\n  TURN_RIGHT_EFFECT = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., If facing RIGHT (0), turning RIGHT makes agent face DOWN (3).\n\n  # Retrieve the set of integer indices for entities that are considered \"non-grabbable\".\n  # The agent cannot move onto cells occupied by these kinds (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest action sequence.\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  \n  # The visited_states set stores (position_tuple, direction_int) pairs.\n  # This prevents redundant exploration of the same state and avoids infinite loops in cyclic environments.\n  visited_states = {(agent_pos, agent_dir)}\n\n  # This variable will store the action sequence that leads the agent to a state\n  # where it is adjacent to the primitive and correctly facing it, ready for the 'USE' action.\n  path_to_pre_use_state = None\n\n  while queue:\n      (current_pos, current_dir), current_path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is located in the grid cell directly in front of the agent.\n      # This is the primary goal condition for our BFS.\n      dr_front, dc_front = DIRECTION_VECTORS[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # First, ensure that the 'front' cell coordinates are within the grid boundaries.\n      if (0 <= front_r < grid_height and 0 <= front_c < grid_width):\n          # If the grid cell directly in front contains the target primitive,\n          # we have found the shortest path to the desired \"ready to use\" state.\n          if grid[front_r, front_c, primitive_id] > 0:\n              path_to_pre_use_state = current_path_actions\n              break # Shortest path found, terminate the BFS.\n\n      # Explore all possible next states by trying each valid action:\n      # 1. Move Forward, 2. Turn Left, 3. Turn Right.\n\n      # --- 1. Attempt to Move Forward ---\n      next_r_move, next_c_move = r + dr_front, c + dc_front\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # The agent's direction does not change when moving forward.\n\n      # Check if the calculated next position is within the grid boundaries\n      # and if this specific (position, direction) state has not been visited before.\n      if (0 <= next_r_move < grid_height and 0 <= next_c_move < grid_width and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          # Determine if the target cell for the forward movement is walkable.\n          # A cell is considered non-walkable if:\n          #   a) It contains any entity from the `non_walkable_kinds_indices` (e.g., boundary, water).\n          #   b) It contains the `primitive_id` itself, as the agent needs to stand *next to* the primitive, not on it.\n          is_walkable = True\n          \n          # Check for blocking non-grabbable entities in the target cell.\n          for kind_idx in non_walkable_kinds_indices:\n              if grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # If the cell is still considered walkable, check if it contains the primitive itself.\n          # The agent must not walk *onto* the primitive to collect it; it must be adjacent.\n          if is_walkable and grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False\n\n          # If the cell is determined to be walkable, add this new state to the BFS queue.\n          if is_walkable:\n              visited_states.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), current_path_actions + [ACTION_MOVE_FORWARD]))\n\n      # --- 2. Attempt to Turn Left ---\n      next_dir_left = TURN_LEFT_EFFECT[current_dir]\n      # Turning actions do not change the agent's position, only its direction.\n      if ((current_pos, next_dir_left) not in visited_states):\n          visited_states.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), current_path_actions + [ACTION_TURN_LEFT]))\n\n      # --- 3. Attempt to Turn Right ---\n      next_dir_right = TURN_RIGHT_EFFECT[current_dir]\n      # Turning actions do not change the agent's position, only its direction.\n      if ((current_pos, next_dir_right) not in visited_states):\n          visited_states.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), current_path_actions + [ACTION_TURN_RIGHT]))\n\n  # After the BFS completes, if a path to the pre-USE state was found,\n  # append the final 'USE' action to that path.\n  if path_to_pre_use_state is not None:\n      actions_sequence.extend(path_to_pre_use_state)\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:16:50.846769", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This implementation uses Breadth-First Search (BFS) to find the shortest sequence of\n    movement and turning actions that lead the agent to a position adjacent to the\n    target primitive, facing it. Once such a position is reached, a 'USE' action is\n    appended to collect the primitive.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current simulation state.\n        primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices (e.g., [UP, LEFT, USE]) to execute.\n                   Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the current state from the CraftLab environment\n\n  # Extract key information from the current state\n  grid = current_state.grid # The full grid layout (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # If the primitive name is not valid or doesn't exist in the index, return empty list.\n      return []\n\n  num_rows, num_cols, _ = grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices for execution\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in CraftLab typically means move in current facing direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  # This mapping is used to calculate the agent's new position when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row changes by 0, col changes by +1)\n      1: (-1, 0),  # Facing UP:    (row changes by -1, col changes by 0)\n      2: (0, -1),  # Facing LEFT:  (row changes by 0, col changes by -1)\n      3: (1, 0)    # Facing DOWN:  (row changes by +1, col changes by 0)\n  }\n\n  # Define how direction index changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right(0)->Up(1)->Left(2)->Down(3)->Right(0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right(0)->Down(3)->Left(2)->Up(1)->Right(0)\n\n  # Identify entities that block agent movement (e.g., boundaries, water, workshops).\n  # The agent cannot move onto these cells.\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  \n  # Create a set of all indices that block agent movement.\n  # The primitive itself is also considered non-walkable, as the agent needs to be\n  # adjacent to it (not on top of it) to use/collect it.\n  blocking_kinds_for_movement_set = set(non_grabbable_indices)\n  blocking_kinds_for_movement_set.add(primitive_id)\n  \n  # Convert the set of blocking kinds to a NumPy array for efficient checking.\n  # Using np.any() with this array allows for quick checks if a cell contains any blocking kind.\n  blocking_kinds_for_movement_array = np.array(list(blocking_kinds_for_movement_set), dtype=int)\n\n\n  # BFS initialization\n  # Queue stores tuples: ((agent_row, agent_col), agent_direction), [list_of_actions_taken_to_reach_this_state]\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # Visited set stores ((agent_row, agent_col), agent_direction) tuples.\n  # This prevents revisiting states and finding suboptimal paths (ensures shortest path).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the action sequence once the goal is reached.\n\n  while queue:\n      # Pop the current state and the path taken to reach it from the front of the queue\n      (current_pos_tuple, current_direction_int), path_taken_so_far = queue.popleft()\n      r, c = current_pos_tuple # Unpack current row and column\n\n      # 1. Check if the primitive is directly in front of the agent at this current state\n      # Calculate the coordinates of the cell that is one step \"forward\" from the agent's current position and direction\n      front_dr, front_dc = DIR_TO_DRDC[current_direction_int]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the \"front\" cell is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          grid[front_r, front_c, primitive_id] > 0): # Check if the primitive exists at this specific location\n          \n          target_path_actions = path_taken_so_far # Store the path leading to this \"adjacent and facing\" state\n          break # Goal reached: agent is adjacent to the primitive and facing it. Exit BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # --- Try Move Forward Action ---\n      move_dr, move_dc = DIR_TO_DRDC[current_direction_int]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos_tuple = (next_r, next_c)\n      next_direction_int = current_direction_int # Moving forward does not change facing direction\n\n      # Check if the next position is valid (within grid bounds) AND has not been visited with this direction\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos_tuple, next_direction_int) not in visited):\n          \n          # Additionally, check if the next position is walkable (i.e., does not contain any blocking kinds).\n          # np.any() is used here to efficiently check if any of the `blocking_kinds_for_movement_array`\n          # have a count greater than 0 in the `next_r, next_c` cell.\n          if not np.any(grid[next_r, next_c, blocking_kinds_for_movement_array] > 0):\n              visited.add((next_pos_tuple, next_direction_int))\n              queue.append(((next_pos_tuple, next_direction_int), path_taken_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      next_direction_left = TURN_LEFT_MAP[current_direction_int]\n      # Turning does not change position, only direction.\n      if ((current_pos_tuple, next_direction_left) not in visited):\n          visited.add((current_pos_tuple, next_direction_left))\n          queue.append(((current_pos_tuple, next_direction_left), path_taken_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      next_direction_right = TURN_RIGHT_MAP[current_direction_int]\n      # Turning does not change position, only direction.\n      if ((current_pos_tuple, next_direction_right) not in visited):\n          visited.add((current_pos_tuple, next_direction_right))\n          queue.append(((current_pos_tuple, next_direction_right), path_taken_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T09:16:52.028201", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # In this environment, 'UP' means move forward relative to current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  # This mapping helps calculate the cell coordinates in front of the agent or when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how the agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right (0) -> Up (1) -> Left (2) -> Down (3) -> Right (0)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right (0) -> Down (3) -> Left (2) -> Up (1) -> Right (0)\n\n  # Identify entities that block agent movement. These are cells the agent cannot walk onto.\n  # This includes non-grabbable items (like BOUNDARY, WATER, WORKSHOPs) and the primitive itself.\n  # The agent needs to be *adjacent* to the primitive to collect it, not on top of it.\n  non_walkable_indices_set = set(current_state.world.non_grabbable_indices)\n  non_walkable_indices_set.add(primitive_id)\n  \n  # Convert the set of non-walkable indices to a numpy array for efficient checking against grid cells.\n  non_walkable_array = np.array(list(non_walkable_indices_set), dtype=int)\n\n  # BFS State: ((current_row, current_col), current_direction_int)\n  # The queue stores tuples: (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The visited set stores states to prevent redundant computations and infinite loops.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the goal state.\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check for Goal Condition: Is the primitive directly in front of the agent?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid bounds.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is present in the cell directly in front of the agent.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_to_current_state\n              break # Goal reached, found the shortest path.\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if this new state (position, direction) has not been visited yet.\n      if (next_pos, next_dir) not in visited:\n          # Check if the next position is within grid boundaries.\n          if 0 <= next_r < num_rows and 0 <= next_c < num_cols:\n              # Check if the next position is walkable (i.e., does not contain any blocking entities).\n              # `np.any` efficiently checks if any non-walkable item exists in the cell's `kind` dimension.\n              if not np.any(initial_grid[next_r, next_c, non_walkable_array] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach a state where the agent is adjacent to and facing the primitive,\n  # append the 'USE' action to actually collect it.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:18:13.779879", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # (rows, columns, kinds)\n\n  # Optimization/Robustness: Check if the primitive is already in the inventory.\n  # If it is, no actions are needed to collect it.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Robustness: Check if the primitive is actually grabbable. If not, it cannot be collected.\n  # This prevents attempts to 'collect' non-grabbable items like boundaries or workshops.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  # Get indices of entities that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Constants for agent movement and turning logic\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for updating agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Extract action indices from the action_map\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n\n  # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_found = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the target condition:\n      # The primitive must be in the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Ensure the cell in front is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the cell in front contains the target primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_found = path_actions\n              break # Path found, break from BFS\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_after_move) not in visited):\n          \n          # Determine if the next position is walkable:\n          # - Cannot contain any entities globally defined as non-walkable (e.g., boundaries, water, workshops).\n          # - Cannot be the target primitive itself (agent steps *adjacent* to it, not *onto* it, before using).\n          is_walkable = True\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Also, ensure we don't walk onto the primitive we want to collect.\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_after_move))\n              queue.append(((next_pos, next_dir_after_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action is assumed to \"collect\" the primitive once the agent is in the correct position.\n  if target_path_found is not None:\n      actions_list.extend(target_path_found)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:18:15.227762", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines the BFS pathfinding logic for clarity and robustness,\n    ensuring the agent navigates to a position adjacent to and facing the target primitive,\n    then performs a 'USE' action to collect it.\n    \n    Args:\n        env (env.CraftLab): The CraftLab environment object.\n        primitive (str): The string name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is not found or unreachable.\n  \"\"\"\n  actions_to_collect = []\n  current_state = env._current_state\n  \n  # Retrieve essential information from the current state and world configuration\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos # (row, col) tuple\n  initial_agent_dir = current_state.dir # Integer: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  try:\n      target_primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # This case should ideally be prevented by the DSL's grammar or a prior check.\n      return []\n\n  # Get grid dimensions (rows, columns)\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # Agent moves one step forward in its current direction\n  TURN_LEFT = action_map['LEFT']     # Agent turns 90 degrees left\n  TURN_RIGHT = action_map['RIGHT']   # Agent turns 90 degrees right\n  USE_ACTION = action_map['USE']     # Agent interacts with the cell directly in front\n\n  # Define how agent's position changes based on direction (dr, dc)\n  # Index 0: Right (positive column), 1: Up (negative row), 2: Left (negative column), 3: Down (positive row)\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Right: (dr=0, dc=+1)\n      1: (-1, 0),  # Up:    (dr=-1, dc=0)\n      2: (0, -1),  # Left:  (dr=0, dc=-1)\n      3: (1, 0)    # Down:  (dr=+1, dc=0)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Current_dir -> New_dir: R->U, U->L, L->D, D->R\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Current_dir -> New_dir: R->D, D->L, L->U, U->R\n\n  # Identify non-walkable terrain types (e.g., BOUNDARY, WATER, WORKSHOPS)\n  # These are entities the agent cannot move onto.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # --- BFS for shortest path to target primitive's adjacency ---\n  # Queue stores tuples: ((current_row, current_col), current_direction), list_of_actions_taken\n  search_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant searches and cycles\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  path_to_adjacent_primitive = None # Will store the action sequence if found\n\n  while search_queue:\n      (current_pos_rc, current_dir), path_actions = search_queue.popleft()\n      r, c = current_pos_rc\n\n      # 1. Check if the current agent state (position & direction) meets the target condition:\n      # The agent is adjacent to AND facing the target primitive.\n      dr_front, dc_front = DIRECTION_TO_DELTA_RC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n\n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the target primitive is present in the cell directly in front\n          if initial_grid[front_r, front_c, target_primitive_id] > 0:\n              path_to_adjacent_primitive = path_actions\n              break # Found the path to position/face the primitive!\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_RC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change on forward movement\n\n      # Check bounds and if this state (pos, dir) has been visited\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          # Determine if the 'next_pos_move' cell is walkable\n          is_walkable = True\n          # Cannot walk onto generally non-walkable features (e.g., boundaries, water, workshops)\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Cannot walk *onto* the specific target primitive itself; must remain adjacent\n          if is_walkable and initial_grid[next_r_move, next_c_move, target_primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited_states.add((next_pos_move, next_dir_move))\n              search_queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos_rc, next_dir_left) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_left))\n          search_queue.append(((current_pos_rc, next_dir_left), path_actions + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning does not change position.\n      if ((current_pos_rc, next_dir_right) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_right))\n          search_queue.append(((current_pos_rc, next_dir_right), path_actions + [TURN_RIGHT]))\n\n  # If a path to the primitive's adjacency was found, append the 'USE' action\n  # to the sequence, as 'USE' is how primitives are collected.\n  if path_to_adjacent_primitive is not None:\n      actions_to_collect.extend(path_to_adjacent_primitive)\n      actions_to_collect.append(USE_ACTION)\n\n  return actions_to_collect", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T09:19:36.254495", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This version refines the Breadth-First Search (BFS) approach from `collect_v1`\n    for better clarity and robustness, ensuring efficient pathfinding to\n    collect specified primitive items within the CraftWorld environment.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state of the game.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of action indices (e.g., UP, DOWN, USE) to execute.\n                   Returns an empty list if the primitive is already collected,\n                   cannot be collected, or is unreachable within search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  # The cookbook stores mappings from names (lowercase) to their integer indices.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the game's item index, it's invalid.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses at least one unit of the target item, no collection is needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Check: Determine if this primitive is inherently collectible via the 'USE' action.\n  # Not all items can be \"collected\" into inventory. This typically applies to:\n  #   - Items explicitly marked as grabbable (e.g., tools, crafted items found on ground).\n  #   - Specific environmental resources that are gathered by using them (e.g., \"water\", \"stone\").\n  #   Items like workshops, boundaries, or fixed terrain features are generally not collected.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected using the 'USE' action, we don't proceed with pathfinding.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define numerical action codes and spatial transformations.\n  action_map = env.action_specs() # Get the mapping from action names to integer IDs.\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) that represents the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (North)\n      1: (0, 1),  # RIGHT: Increases col (East)\n      2: (1, 0),  # DOWN: Increases row (South)\n      3: (0, -1)  # LEFT: Decreases col (West)\n  }\n\n  # Helper function to compute the shortest sequence of turning actions (LEFT/RIGHT)\n  # needed to change the agent's current facing direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the desired direction.\n      \n      # Calculate the difference in directions, handling the circular nature (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., from UP (0) to RIGHT (1)).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., from UP (0) to LEFT (3)).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., from UP (0) to DOWN (2)).\n          # Two consecutive turns in either direction will achieve this (e.g., RIGHT, RIGHT).\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  q = collections.deque() # The queue for BFS, storing (CraftState, unique_state_key) tuples.\n  # `visited` set tracks already explored unique states to prevent cycles and redundant work.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Inventory is converted to a tuple because numpy arrays are not hashable for set/dict keys.\n  visited = set()\n  # `came_from` dictionary reconstructs the path by mapping a state_key to\n  # (the key of the previous state, the action taken to reach the current state).\n  came_from = {} \n\n  # Prepare the initial state for BFS.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # Add the initial state to the queue and mark it as visited.\n  q.append((current_state, initial_state_key))\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # `MAX_EXPLORED_STATES` is a heuristic limit to prevent the search from running indefinitely\n  # in very large or complex state spaces where a solution might be very far or non-existent.\n  # This value roughly accounts for position, direction, and some reasonable variations in inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 # For robustness, adjusted higher.\n  explored_states_count = 0\n\n  # 6. BFS Loop: Explore states layer by layer to find the shortest action sequence.\n  while q:\n    # Dequeue the current state and its unique key for processing.\n    state, current_state_key = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit,\n    # we assume a path cannot be found efficiently or doesn't exist within reasonable bounds.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # Return empty list, indicating failure to find a path within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Condition Check: Can the primitive be collected from the current `state`?\n    # First, verify if the target primitive `i_kind` is present in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all possible agent orientations (0-3) to see\n        # if any direction would face the primitive directly.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) is within grid bounds\n            # AND contains an instance of the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If a primitive is directly faced, simulate the turning actions to achieve this orientation.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # Apply each turning action sequentially to get the state just before 'USE'.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Record the inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n\n                # Simulate the 'USE' action. This is where collection (or crafting) happens.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Crucial Verification: Check if the 'USE' action successfully increased\n                # the count of the target primitive in the inventory. This accounts for\n                # game mechanics like requiring a tool for collection (e.g., axe for wood).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a successful path has been found. Reconstruct and return it.\n                    final_path = []\n                    temp_key = current_state_key\n                    # Reconstruct the path by backtracking from the current state key to the initial state key\n                    # using the `came_from` dictionary.\n                    while temp_key != initial_state_key:\n                        prev_key, action = came_from[temp_key]\n                        final_path.insert(0, action) # Insert at the beginning to build the path in correct order.\n                        temp_key = prev_key\n                    \n                    # The complete path includes the actions to reach the current state,\n                    # the turns to face the primitive, and finally the 'USE' action.\n                    return final_path + turns_to_face + [USE_ACT]\n\n    # Explore next possible states by applying allowed actions from the current state.\n    # Consider both movement actions and the general 'USE' action.\n    # The 'USE' action is included as it might pick up tools or items at the current spot,\n    # which could change the inventory and unlock future collection possibilities.\n    actions_to_consider = move_actions + [USE_ACT]\n    \n    for action in actions_to_consider:\n        _, next_state = state.step(action) # `step` returns a new CraftState object.\n        \n        # Create a unique key for the new state.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        # If this new state hasn't been visited yet, add it to the queue for exploration.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            came_from[next_state_key] = (current_state_key, action) # Store how we got to this state.\n            q.append((next_state, next_state_key)) # Add to the BFS queue.\n\n  # 7. If the BFS loop finishes and the queue becomes empty without finding a solution,\n  # it means the target primitive is unreachable from the initial state under the given conditions\n  # and within the defined search limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:19:38.088579", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  # Convert the primitive name to lowercase to match cookbook's index.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that are explicitly defined as grabbable (can be picked up),\n  # or specific environmental resources like \"water\" or \"stone\" which are interacted with via USE.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory\n  # using the 'USE' action in this context.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected using 'USE' action, we do not proceed with a search for it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1 (North)\n      1: (0, 1),  # RIGHT: col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1 (South)\n      3: (0, -1)  # LEFT: col - 1 (West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # required to change from the current direction to a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference in the range [0, 3].\n      diff = (target_dir - current_dir + 4) % 4\n      \n      # Determine the shortest sequence of turns.\n      if diff == 1: # One clockwise turn (e.g., UP -> RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP -> LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP -> DOWN)\n          # Two consecutive turns in either direction (e.g., RIGHT, RIGHT) will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] \n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # `visited` set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  visited = set()\n  # `came_from` dictionary for efficient path reconstruction (avoids costly list copies).\n  came_from = {} # Maps state_key -> (previous_state_key, action_taken_to_reach_current_state)\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # The queue stores the (CraftState object, its unique key, path_length_to_reach_this_state).\n  q.append((current_state, initial_state_key, 0)) # Initial path length is 0.\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for BFS to prevent excessive search:\n  # MAX_EXPLORED_STATES: limit on the number of unique states visited.\n  # MAX_PATH_LENGTH: limit on the length of any path explored.\n  # These values are chosen to balance search completeness and performance.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 # Number of (pos, dir) * some factor for inventory variations\n  MAX_PATH_LENGTH = grid_width * grid_height * 4 * 2 # Roughly twice the number of (pos, dir) states as a safety margin\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    # Dequeue the current state, its unique key, and the path length to reach it.\n    state, current_state_key, path_len = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If the number of explored distinct states exceeds the limit, stop.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # No path found within the exploration limits.\n    \n    # Pruning: If the current path length exceeds the maximum allowed, stop exploring this branch.\n    if path_len >= MAX_PATH_LENGTH:\n        continue # This path is too long; do not explore further from it.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # First, check if the target primitive (`i_kind`) is present in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # If it's nearby, iterate through all possible agent orientations to see if one faces the primitive.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after hypothetical turn) contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # If so, simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding for collection, not optimizing reward.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Store inventory before attempting USE to verify successful collection.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., needing a tool) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, reconstruct and return the complete sequence of actions.\n                    final_path = []\n                    temp_key = current_state_key\n                    # Reconstruct path by tracing back from the current state key to the initial state key.\n                    while temp_key != initial_state_key:\n                        prev_key, action = came_from[temp_key]\n                        final_path.insert(0, action) # Insert at the beginning to build path in correct order\n                        temp_key = prev_key\n                    return final_path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions from the current state:\n    # This includes movement actions (UP, DOWN, LEFT, RIGHT) and a general 'USE' action.\n    # The general 'USE' action is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory or capabilities, which might be necessary for later steps to collect the primitive.\n    actions_to_consider = move_actions + [USE_ACT]\n    \n    for action in actions_to_consider:\n        _, next_state = state.step(action) # CraftState.step returns a new state object.\n        \n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            came_from[next_state_key] = (current_state_key, action)\n            q.append((next_state, next_state_key, path_len + 1)) # Add new state and extended path to queue.\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the defined limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T09:20:27.464758", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X) that block agent movement\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Helper Functions for Readability and Modularity ---\n  def _is_position_valid(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is within grid bounds.\"\"\"\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is walkable based on the initial grid.\n      A cell is not walkable if it contains any non-grabbable blocking entity (e.g., boundary, water).\n      \"\"\"\n      if not _is_position_valid(r, c):\n          return False  # Out of bounds\n\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Cell contains a non-walkable item\n      return True\n\n  def _can_collect_from_position(r, c):\n      \"\"\"Checks if the target primitive is in the 3x3 neighborhood of (r, c)\n      on the initial grid.\n      \"\"\"\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              if (_is_position_valid(check_r, check_c) and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  return True\n      return False\n  # --- End of Helper Functions ---\n\n  # Optimization: If the primitive is already in the 3x3 neighborhood of the agent's current position,\n  # no pathfinding is needed; just use the item. This leverages the CraftState.next_to method.\n  # (Note: current_state.next_to() is equivalent to _can_collect_from_position(initial_pos[0], initial_pos[1]))\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here ).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) pairs to avoid redundant computations\n  # and infinite loops in cyclic paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the shortest sequence of actions to reach a collectable state.\n\n  # BFS Loop: continues as long as there are states to explore.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position is a \"goal\" state for collection.\n      if _can_collect_from_position(r, c):\n          target_path = path_actions # Shortest path to this position found.\n          break # Terminate BFS as the goal is reached.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_mf, next_c_mf = r + move_dr, c + move_dc\n      next_pos_mf = (next_r_mf, next_c_mf)\n      next_dir_mf = current_dir # Moving forward does not change facing direction\n\n      if _is_cell_walkable(next_r_mf, next_c_mf): # Check if the cell is walkable\n          if (next_pos_mf, next_dir_mf) not in visited: # Check if this state has been visited\n              visited.add((next_pos_mf, next_dir_mf))\n              queue.append(((next_pos_mf, next_dir_mf), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_tl = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_tl) not in visited):\n          visited.add((current_pos, next_dir_tl))\n          queue.append(((current_pos, next_dir_tl), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_tr = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_tr) not in visited):\n          visited.add((current_pos, next_dir_tr))\n          queue.append(((current_pos, next_dir_tr), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the final USE action\n  # to actually perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
