 row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks (row, col, direction, inventory_tuple, grid_hash).\n  # Including grid_hash is crucial for states where USE actions change the environment\n  # (e.g., removing obstacles, crafting an item on the grid).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) # Hash grid for initial state\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple, initial_grid_hash))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limit prevents excessive computation\n  # for very large or complex environments where a path might not exist or is too long.\n  # Adjusted multiplier for v2 to allow for more complex scenarios.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 200 # Increased multiplier from 100 in v1\n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop adding new ones.\n    # This acts as a safeguard against overly long searches.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Continues processing existing items in queue but won't add new ones\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Goal Check: Can we collect the primitive from this `state`? ---\n    # This check is performed at each visited state to find the shortest path.\n\n    # 1. Attempt collection by using at the agent's current position.\n    # This covers cases where the item is \"at the feet\" and grabbable.\n    inventory_before_self_use = np.copy(state.inventory)\n    _, state_after_self_use = state.step(USE_ACT)\n    if state_after_self_use.inventory[i_kind] > inventory_before_self_use[i_kind]:\n        return path + [USE_ACT] # Primitive collected!\n\n    # 2. Attempt collection from an adjacent cell by turning to face it and using.\n    # Iterate through all 4 cardinal directions to check adjacent cells.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Check if the cell we would face is within grid bounds AND contains the primitive.\n        if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n            state.grid[facing_r, facing_c, i_kind] == 1):\n\n            # Simulate the turning actions to face the primitive.\n            temp_state_after_turns = state\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_facing_use = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action in the new facing direction.\n            _, state_after_facing_use = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the primitive in inventory actually increase?\n            if state_after_facing_use.inventory[i_kind] > inventory_before_facing_use[i_kind]:\n                return path + turns_to_face + [USE_ACT] # Primitive collected!\n\n    # --- Explore Next States (Movement and General USE for tools/intermediate steps) ---\n    # If the primitive wasn't collected immediately from the 'state', explore future possibilities.\n\n    current_inventory_tuple = tuple(state.inventory)\n    current_grid_hash = hash(state.grid.tobytes())\n    # This is a key for the current state to check if the next state is truly different.\n    current_state_key_for_comparison = (state.pos[0], state.pos[1], state.dir, current_inventory_tuple, current_grid_hash)\n\n\n    for action in all_possible_actions: # Includes movement and USE_ACT\n      _, next_state = state.step(action)\n\n      # Generate the unique key for the next state.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple, next_grid_hash)\n\n      # Add to queue only if the next state is distinct from the current one (i.e., the action had an effect)\n      # AND it has not been visited before.\n      # This handles cases where an action (like moving into a wall or using air) results in no state change,\n      # preventing cycles or redundant exploration of identical states.\n      if next_state_key != current_state_key_for_comparison and next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 4, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T14:38:44.237161", "function_name": "collect", "function_body": "  # Retrieve the current state and world configuration from the environment.\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Convert the string `primitive` name to its internal integer ID.\n  # This mapping is essential for interacting with the simulation's grid and inventory.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not valid or known, collection is impossible.\n    return []\n\n  # 2. Check if the primitive is already present in the agent's inventory.\n  # If so, no actions are needed, and an empty list of actions is returned.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the target `primitive` is an entity that can be collected via the 'USE' action.\n  # This includes items defined as 'grabbable' in the world configuration, as well as specific\n  # environmental resources like 'water' and 'stone' that are collected by interacting with them.\n  # Other entities (e.g., workshops, boundaries) are static features, not collectible inventory items.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item cannot be collected by 'USE' (e.g., it's a workshop), then it's an invalid target for this function.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Initialize action constants and helper data for navigation.\n  # These action IDs are dynamic and retrieved from the environment's specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # A list of basic movement actions to iterate through during state exploration.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from agent's integer direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to\n  # the corresponding (row_change, col_change) tuple for the cell directly in front.\n  # This is used to determine which grid cell the agent is \"facing\".\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row (moves North on a standard grid)\n      1: (0, 1),  # RIGHT: Increases column (moves East)\n      2: (1, 0),  # DOWN: Increases row (moves South)\n      3: (0, -1)  # LEFT: Decreases column (moves West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to change its orientation from `current_dir` to `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # No turns needed if already facing the target direction.\n\n      # Calculate the difference, handling the cyclical nature of directions (0-3).\n      # `(diff + 4) % 4` ensures a positive result representing the shortest turn.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One step clockwise turn (e.g., UP(0) to RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # One step counter-clockwise turn (e.g., UP(0) to LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) to DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily use two RIGHT turns.\n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  # `q` is a deque (double-ended queue) storing tuples of (CraftState, list_of_actions_taken_to_reach_this_state).\n  q = collections.deque() \n  \n  # `visited` set tracks states already explored to prevent infinite loops and redundant computation.\n  # A state is defined by the agent's position (row, col), its direction, and its current inventory.\n  # The inventory (a NumPy array) is converted to an immutable tuple to be hashable for the set.\n  # Including inventory in the state key is crucial as acquiring tools (e.g., an axe) changes\n  # the agent's capabilities and thus, affects reachable future states and actions.\n  visited = set()\n\n  # Add the initial environment state to the BFS queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and to help define an exploration limit.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limit on the number of distinct states to explore during BFS.\n  # This prevents the search from running indefinitely in extremely complex or large environments.\n  # The multiplier (e.g., 10 or 15) allows for paths that might involve acquiring intermediate tools.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. Main BFS Loop: Continues as long as there are states in the queue to explore\n  # and a path to collect the target primitive has not yet been found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the action path leading to it.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the predefined limit,\n    # skip further expansion from this path to manage computational resources.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # If the primitive is nearby, iterate through all four possible agent orientations (UP, RIGHT, DOWN, LEFT).\n        # We need to find an orientation that places the primitive directly in front of the agent.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir] # Calculate delta for the cell directly in front.\n            facing_r, facing_c = current_r + dr, current_c + dc # Coordinates of the cell directly in front.\n\n            # Verify that the cell directly in front is:\n            # a) within the grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions needed to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions to get the agent into the correct orientation.\n                # `temp_state_after_turns` will hold the state after all turns.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # The reward for turning actions is typically 0.0 in this environment, so it's ignored.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store a copy of the inventory *before* attempting the 'USE' action.\n                # This is a critical step for verifying if the 'USE' action successfully collected the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical Verification: Check if the count of the target primitive in the inventory\n                # *increased* after the 'USE' action. This confirms successful collection,\n                # accounting for any game-specific rules (e.g., needing a specific tool, or resource depletion).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found. Return the complete sequence of actions:\n                    # the path to reach the location, the turns to face the primitive, and the final USE action.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT) from the current `state`.\n    for action in move_actions:\n      _, next_state = state.step(action) # Simulate the movement.\n      \n      # Convert the inventory of the `next_state` to an immutable tuple for use as a hashable key.\n      next_inventory_tuple = tuple(next_state.inventory) \n      \n      # Create a unique key for the `visited` set for the new state.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this `next_state` (defined by its position, direction, and inventory) has not been visited before,\n      # add it to the queue for future exploration and mark it as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This exploration path is distinct from the goal-specific 'USE' check above.\n    # It handles scenarios where using an item at the current location might change the inventory\n    # (e.g., picking up an axe, or using an item that creates a new resource), which could\n    # enable future collection of the target primitive or other intermediate steps.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change in the agent's state (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if the 'USE' action had no effect.\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's a new, unvisited state.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is unreachable from the\n  # initial state under the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:38:45.762217", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` for finding and collecting a primitive.\n    \n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The string name of the primitive to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute to collect the primitive.\n                   Returns an empty list if the primitive is already collected or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Resolve the primitive name to its canonical integer ID.\n  # This ID is used internally by the simulation to represent different entity kinds.\n  try:\n    primitive_kind_id = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized in the world's index, it's an invalid target.\n    return []\n\n  # 2. Check initial inventory: If the primitive is already possessed, no actions are needed.\n  if current_state.inventory[primitive_kind_id] > 0:\n      return []\n\n  # 3. Determine if the target primitive is an item that can be collected via the 'USE' action.\n  # This includes items defined as 'grabbable' (e.g., tools, crafted items) and specific\n  # environmental resources like water or stone. Non-collectible entities (e.g., workshops, boundaries)\n  # should not trigger a collection attempt.\n  is_collectible_item = (\n      primitive_kind_id in world.grabbable_indices or \n      primitive_kind_id == world.water_index or \n      primitive_kind_id == world.stone_index\n  )\n  \n  # If the item cannot be collected by 'USE' (e.g., it's a static environment feature),\n  # then this function cannot fulfill the request.\n  if not is_collectible_item:\n    return []\n\n  # 4. Define action constants and directional offsets for state transitions.\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  movement_actions = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Map agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to its corresponding (row_delta, col_delta)\n  # for the cell directly in front of the agent.\n  DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # Facing North, row decreases\n      1: (0, 1),  # Facing East, column increases\n      2: (1, 0),  # Facing South, row increases\n      3: (0, -1)  # Facing West, column decreases\n  }\n\n  # Helper function to compute the minimum turning actions to align agent's direction.\n  def _calculate_turns(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction\n\n      # Calculate the rotational difference, ensuring it's positive and handles wrap-around.\n      # e.g., (0 - 3 + 4) % 4 = 1 (UP to LEFT is 1 LEFT turn, or 3 RIGHT turns)\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP -> RIGHT)\n          return [ACTION_RIGHT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP -> LEFT)\n          return [ACTION_LEFT]\n      else: # diff == 2 (180-degree turn, e.g., UP -> DOWN)\n          # Two consecutive turns in the same direction will achieve a 180-degree rotation.\n          return [ACTION_RIGHT, ACTION_RIGHT] # Arbitrarily choosing right turns\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  # Queue stores (CraftState, list_of_actions_to_reach_this_state).\n  bfs_queue = collections.deque()\n  \n  # Set to track visited states. A state is uniquely defined by (row, col, direction, inventory_tuple).\n  # Inventory is converted to a tuple to make it hashable for set membership checking.\n  visited_states = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  bfs_queue.append((current_state, []))\n  visited_states.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for BFS exploration. This prevents unbounded searches in complex environments.\n  # It's set to a multiple of possible (position, direction) states. The multiplier (e.g., 10) allows\n  # for some depth in exploring paths that might involve acquiring intermediate tools.\n  MAX_EXPLORATION_LIMIT = grid_width * grid_height * 4 * 10 \n  states_explored_count = 0\n\n  # 6. BFS Loop: Continue as long as there are states to explore and the limit is not exceeded.\n  while bfs_queue:\n    current_bfs_state, current_path = bfs_queue.popleft()\n    states_explored_count += 1\n\n    # Pruning: If the exploration limit is reached, stop expanding from this branch.\n    if states_explored_count > MAX_EXPLORATION_LIMIT:\n      continue \n\n    agent_row, agent_col = current_bfs_state.pos\n    agent_dir = current_bfs_state.dir\n    \n    # --- Goal Check: Attempt to collect the primitive from the current state ---\n    # Check if the target primitive is located in the agent's immediate 3x3 neighborhood.\n    if current_bfs_state.next_to(primitive_kind_id):\n        # If nearby, iterate through all four possible agent orientations to see if\n        # facing any of them puts the primitive directly in front.\n        for desired_facing_dir in range(4): \n            delta_r, delta_c = DIR_TO_DELTA_FRONT[desired_facing_dir]\n            cell_in_front_r, cell_in_front_c = agent_row + delta_r, agent_col + delta_c\n\n            # Verify that the cell directly in front is:\n            # a) within grid boundaries, and b) actually contains the target primitive.\n            if (0 <= cell_in_front_r < grid_width and 0 <= cell_in_front_c < grid_height and \n                current_bfs_state.grid[cell_in_front_r, cell_in_front_c, primitive_kind_id] == 1):\n                \n                # Calculate the turning actions needed to face the primitive.\n                required_turns = _calculate_turns(agent_dir, desired_facing_dir)\n                \n                # Simulate these turning actions to reach the correct orientation.\n                state_after_turns = current_bfs_state \n                for turn_action in required_turns:\n                    _, state_after_turns = state_after_turns.step(turn_action)\n\n                # Capture inventory *before* 'USE' to verify successful collection.\n                inventory_before_use_attempt = np.copy(state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use_action = state_after_turns.step(ACTION_USE)\n\n                # Crucial verification: Check if the count of the target primitive\n                # in the inventory *increased* after the 'USE' action. This confirms\n                # actual collection, accounting for game mechanics (e.g., tools required).\n                if state_after_use_action.inventory[primitive_kind_id] > inventory_before_use_attempt[primitive_kind_id]:\n                    # A path to collect the primitive has been found. Return the full action sequence.\n                    return current_path + required_turns + [ACTION_USE]\n\n    # --- Explore New States: Generate successor states by applying actions ---\n    # 1. Explore movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in movement_actions:\n      _, next_state = current_bfs_state.step(action)\n      # Create a unique key for the next state, including inventory for hashability.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, tuple(next_state.inventory))\n\n      # If this state has not been visited before, add it to the queue and mark as visited.\n      if next_state_key not in visited_states:\n        visited_states.add(next_state_key)\n        bfs_queue.append((next_state, current_path + [action]))\n    \n    # 2. Explore the general 'USE' action from the current position.\n    # This is important as 'USE' might pick up a tool or change the environment\n    # in a way that enables future collection of the target primitive, even if\n    # it doesn't directly collect the target primitive itself.\n    inventory_before_general_use = np.copy(current_bfs_state.inventory)\n    _, state_after_general_use = current_bfs_state.step(ACTION_USE)\n    \n    # Only add the state resulting from 'USE' if it caused a meaningful change\n    # (i.e., inventory, position, or direction changed). This avoids exploring\n    # redundant states where 'USE' had no effect.\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == current_bfs_state.pos and\n            state_after_general_use.dir == current_bfs_state.dir):\n\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], \n                          state_after_general_use.dir, tuple(state_after_general_use.inventory))\n\n        # Add this new state to the queue if it hasn't been visited.\n        if next_state_key not in visited_states:\n            visited_states.add(next_state_key)\n            bfs_queue.append((state_after_general_use, current_path + [ACTION_USE]))\n\n  # 7. If the BFS queue is exhausted and no path was found to collect the primitive,\n  # it indicates that the primitive is unreachable from the initial state under\n  # the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:40:07.112386", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T14:40:08.213755", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # Helper function to calculate the shortest sequence of turning actions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      # Action map is accessible from the outer scope where it's defined below.\n      if current_dir == target_dir:\n          return []\n      # Calculate difference ensuring it's positive and within [0, 3] for turns.\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # Clockwise turn (e.g., UP to RIGHT)\n          return [action_map[\"RIGHT\"]]\n      elif diff == 3: # Counter-clockwise turn (e.g., UP to LEFT)\n          return [action_map[\"LEFT\"]]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN)\n          # Two right turns (or two left turns) are shortest for a 180-degree turn.\n          return [action_map[\"RIGHT\"], action_map[\"RIGHT\"]]\n\n  # Delta coordinates for each direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) relative to agent's position (row_delta, col_delta).\n  _DIRECTION_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row decreases, col stays same\n      1: (0, 1),  # RIGHT: row stays same, col increases\n      2: (1, 0),  # DOWN: row increases, col stays same\n      3: (0, -1)  # LEFT: row stays same, col decreases\n  }\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Determine if this primitive is *actually* collectible into inventory.\n  # This ensures we only search for items that can be picked up or harvested.\n  is_primitive_resource = i_kind in world.cookbook.primitives\n  is_special_collectible_environment = (i_kind == world.water_index or i_kind == world.stone_index)\n  is_grabbable = i_kind in world.grabbable_indices\n\n  if not (is_primitive_resource or is_special_collectible_environment or is_grabbable):\n      # The requested primitive is not collectible via a direct \"collect\" action (e.g., a workshop).\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      # Primitive is already collected, no actions needed.\n      return []\n\n  # 4. Define action integers from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set tracks unique states to prevent cycles and redundant work.\n  # A state is defined by (grid_hash, row, col, direction, inventory_tuple).\n  # `grid.tobytes()` is used for hashing the grid, which is crucial because `USE_ACT` can modify the grid.\n  visited = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  q.append((current_state, [])) # Queue stores (CraftState object, path_to_reach_this_state)\n  visited.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n\n  # Adaptive search limits for improved robustness in larger/more complex scenarios.\n  # MAX_UNIQUE_STATES_TO_VISIT: Limits the total number of unique states processed.\n  # This prevents excessive memory usage and computation time in intractable cases.\n  MAX_UNIQUE_STATES_TO_VISIT = grid_rows * grid_cols * 4 * 200 # Increased factor from v1 for wider exploration.\n  \n  # MAX_PATH_LENGTH: Limits the length of any path considered.\n  # Prevents extremely long action sequences, which are often suboptimal or indicate unreachability.\n  MAX_PATH_LENGTH = (grid_rows + grid_cols) * 7 # Increased buffer from v1 for more complex paths.\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft()\n\n    # Pruning: If the current path exceeds the maximum allowed length,\n    # stop exploring this branch as it's too long or likely non-optimal.\n    if len(path) >= MAX_PATH_LENGTH:\n        continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    potential_next_transitions = [] # Stores (next_state_object, actions_taken, inventory_before_last_action)\n\n    # --- Generate all potential next states from the current state ---\n\n    # 1. Explore Movement Actions (UP, DOWN, LEFT, RIGHT)\n    for action in move_actions:\n        # Capture inventory *before* the move, even though moves don't change inventory,\n        # for consistent logic with USE_ACT checks.\n        inventory_before_move = np.copy(state.inventory) \n        _, next_state = state.step(action) # Simulate the action.\n        potential_next_transitions.append((next_state, path + [action], inventory_before_move))\n\n    # 2. Explore USE_ACT at the agent's current position.\n    # This covers collecting items directly from the cell the agent is standing on (e.g., grabbable items).\n    inventory_before_use_at_pos = np.copy(state.inventory)\n    grid_before_use_at_pos = np.copy(state.grid)\n    _, state_after_use_at_pos = state.step(USE_ACT)\n    \n    # Check if the USE_ACT resulted in any meaningful change (e.g., inventory increased, grid modified).\n    state_changed_by_use_at_pos = not (\n        np.array_equal(state_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        state_after_use_at_pos.pos == state.pos and\n        state_after_use_at_pos.dir == state.dir and\n        np.array_equal(state_after_use_at_pos.grid, grid_before_use_at_pos)\n    )\n    if state_changed_by_use_at_pos:\n        potential_next_transitions.append((state_after_use_at_pos, path + [USE_ACT], inventory_before_use_at_pos))\n    \n    # 3. Explore USE_ACT on adjacent cells (after turning to face them).\n    # This handles interacting with entities in the surrounding environment that require facing them\n    # (e.g., chopping trees, mining rocks, collecting water/stone from adjacent tiles).\n    for target_dir_idx in range(4): # Iterate through all four possible facing directions (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n        row_delta, col_delta = _DIRECTION_TO_DELTA_FRONT[target_dir_idx]\n        facing_r, facing_c = current_r + row_delta, current_c + col_delta\n\n        # Preliminary check: Is the cell the agent would face within grid bounds and does it contain *any* entity?\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(state.grid[facing_r, facing_c, :] == 1):\n            turns_to_face = _get_turning_actions(current_dir, target_dir_idx)\n            \n            # Optimization: Instead of simulating each turn with state.step(), directly construct\n            # a new CraftState with the desired target direction. This avoids creating intermediate\n            # CraftState objects for each turning action, reducing overhead.\n            state_turned = env.CraftState(\n                scenario=state.scenario,\n                grid=state.grid, # Grid is unchanged by simply turning.\n                pos=state.pos,   # Position is unchanged by simply turning.\n                dir=target_dir_idx, # Set the desired facing direction.\n                inventory=state.inventory # Inventory is unchanged by simply turning.\n            )\n            \n            # Capture inventory and grid states immediately before the final USE_ACT.\n            # These are effectively copies of the *original* state's attributes from 'state',\n            # accessed via 'state_turned'.\n            inventory_before_adj_use = np.copy(state_turned.inventory)\n            grid_before_adj_use = np.copy(state_turned.grid)\n            \n            # Perform the USE_ACT on this newly constructed 'state_turned' object.\n            _, state_after_adj_use = state_turned.step(USE_ACT)\n            \n            # Check if USE_ACT on the adjacent cell resulted in a meaningful state change.\n            state_changed_by_adj_use = not (\n                np.array_equal(state_after_adj_use.inventory, inventory_before_adj_use) and\n                state_after_adj_use.pos == state_turned.pos and\n                state_after_adj_use.dir == state_turned.dir and\n                np.array_equal(state_after_adj_use.grid, grid_before_adj_use)\n            )\n            if state_changed_by_adj_use:\n                potential_next_transitions.append(\n                    (state_after_adj_use, path + turns_to_face + [USE_ACT], inventory_before_adj_use)\n                )\n\n    # --- Process all generated potential next transitions ---\n    for next_s, next_p, inv_before_action in potential_next_transitions:\n        # Check if the target primitive was successfully collected in this specific transition.\n        # This is the primary success condition for the 'collect' function.\n        if next_s.inventory[i_kind] > inv_before_action[i_kind]:\n            # Goal achieved! Return the shortest path immediately (guaranteed by BFS).\n            return next_p\n\n        # If the goal was not achieved in this step, add the new state to the queue\n        # if it hasn't been visited yet and we are within search limits.\n        next_inventory_tuple = tuple(next_s.inventory)\n        next_grid_hash = hash(next_s.grid.tobytes()) # Re-hash the grid for the new state, as it might have changed.\n        next_state_key = (next_grid_hash, next_s.pos[0], next_s.pos[1], next_s.dir, next_inventory_tuple)\n\n        if next_state_key not in visited and len(visited) < MAX_UNIQUE_STATES_TO_VISIT:\n            visited.add(next_state_key)\n            q.append((next_s, next_p))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T14:41:35.144830", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with potentially deeper exploration.\n\n    This function uses a Breadth-First Search (BFS) to find the shortest sequence of actions\n    (movements and 'USE' actions) required to collect a specified primitive item. It considers\n    the agent's position, direction, and inventory as part of its state to accurately model\n    how actions change the environment and agent capabilities.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"stone\").\n\n    Returns:\n        List[int]: A list of action indices (integers) representing the path to collect the primitive.\n                   Returns an empty list if the primitive is already collected or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to global world configuration, including item indices and properties.\n\n  # 1. Map the primitive name to its integer ID.\n  # Convert to lowercase for robust lookup, as names in `cookbook.index` are typically lowercase.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it implies it cannot be collected.\n    return []\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If the goal is already satisfied, no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is a type that can be collected via the 'USE' action.\n  # Only certain kinds of items (grabbables, water, stone) are intended to be \"collected\"\n  # into inventory by using them. Workshops, boundaries, etc., are not collectible in this manner.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or # Items that can be picked up (e.g., tools, crafted items)\n      i_kind == world.water_index or     # Special case for water\n      i_kind == world.stone_index        # Special case for stone\n  )\n\n  # If the target item is not a type that can be collected via 'USE', then this function cannot collect it.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping from agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North: decreases row)\n      1: (0, 1),  # RIGHT (East: increases col)\n      2: (1, 0),  # DOWN (South: increases row)\n      3: (0, -1)  # LEFT (West: decreases col)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the desired direction.\n\n      # Calculate the rotational difference, handling modular arithmetic for 0-3 directions.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # One clockwise turn (e.g., UP to RIGHT)\n          return [RIGHT_ACT]\n      elif diff == 3: # One counter-clockwise turn (e.g., UP to LEFT)\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP to DOWN). Two turns in same direction.\n          return [RIGHT_ACT, RIGHT_ACT] # Or [LEFT_ACT, LEFT_ACT], choice doesn't matter for path length.\n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  q = collections.deque() # The queue for BFS, storing (state, path_to_state) tuples.\n  # The `visited` set stores a hashable representation of states to prevent redundant exploration.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_as_tuple).\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory) # Convert inventory array to hashable tuple.\n  q.append((current_state, [])) # Initial state with an empty path.\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions for boundary checks and setting exploration limits.\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit on the number of distinct states to explore. This helps prevent\n  # excessively long computations in very large or unreachable scenarios.\n  # The multiplier (25) accounts for exploration of different inventory configurations\n  # (e.g., acquiring tools that enable further collection).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 25\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated action path.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the predefined limit,\n    # skip further processing from this path to manage computational cost.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # --- Goal Check & Collection Attempt ---\n    # We check two main scenarios for collecting the target primitive:\n    # 1. The primitive is directly under the agent (and is grabbable).\n    # 2. The primitive is in an adjacent cell (requires turning to face and then USE).\n\n    # Scenario 1: Primitive is directly under the agent.\n    # This applies primarily to items classified as `grabbable_indices` that can be picked up from the same tile.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT) # Simulate picking up from current position.\n\n        # Verify that the 'USE' action actually increased the count of the target primitive.\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Found a path by picking up from the current cell.\n\n    # Scenario 2: Primitive is in an adjacent cell.\n    # `state.next_to(i_kind)` broadly checks the 3x3 neighborhood. If true, we then find its exact direction.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to see if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds AND contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Simulate the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start simulating from the current state.\n                for turn_action in turns_to_face:\n                    # Apply turns sequentially, updating the temporary state for simulation.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the final 'USE' action to verify collection success.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state (after turns).\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # implicitly accounting for any internal game logic (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # --- Explore Possible Future States (Movement and General 'USE') ---\n\n    # 1. Explore Movement Actions: Add new states resulting from moving to the queue.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert inventory for hashable state key.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # 2. Explore General 'USE' Action: Attempting a 'USE' from the current state.\n    # This is vital for picking up other grabbable items (like tools) or interacting\n    # with environment elements (e.g., workshops) that might enable later collection.\n    # We first determine if there's *any* potentially 'useable' item directly in front.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check if the cell in front is within grid bounds.\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        is_something_useable_in_front = False\n        \n        # Check all kinds present at the cell directly in front.\n        kinds_present_at_front = np.where(state.grid[facing_r, facing_c, :] == 1)[0]\n        \n        for kind_idx in kinds_present_at_front:\n            # If any of these kinds are grabbable, water, or stone, then 'USE' might be productive.\n            if (kind_idx in world.grabbable_indices or\n                kind_idx == world.water_index or\n                kind_idx == world.stone_index):\n                is_something_useable_in_front = True\n                break\n\n        # Only attempt the 'USE' action if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory) # Snapshot inventory before this general USE.\n            _, state_after_current_use = state.step(USE_ACT) # Simulate the general USE action.\n            \n            # Add the state after a general 'USE' action to the queue only if it resulted in\n            # a meaningful change (i.e., inventory updated, or position/direction changed).\n            # This prevents exploring redundant states where 'USE' did nothing.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state within the exploration limits.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T14:41:38.509523", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (from DSL) to its integer ID in the environment's index.\n  # Convert to lowercase to match typical index keys.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early Exit: If the primitive is already in the agent's inventory,\n  # no actions are needed. The goal is already satisfied.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the target 'primitive' (as defined by the DSL) is actually\n  # a collectible resource in the game. This explicitly checks against the\n  # types of primitives that can be acquired and excludes non-collectible\n  # environment features (like BOUNDARY or WORKSHOPs).\n  is_a_collectible_resource = (\n      i_kind in world.cookbook.primitives or  # e.g., WOOD, IRON, GRASS, ROCK, GOLD, GEM\n      i_kind == world.water_index or         # Explicitly check for WATER\n      i_kind == world.stone_index            # Explicitly check for STONE\n  )\n\n  # If the target is not a collectible resource according to the game's definition\n  # of primitives, return an empty path as it cannot be collected via this function.\n  if not is_a_collectible_resource:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT) to\n  # the (row_change, col_change) needed to find the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North): Decreases row index\n      1: (0, 1),  # RIGHT (East): Increases column index\n      2: (1, 0),  # DOWN (South): Increases row index\n      3: (0, -1)  # LEFT (West): Decreases column index\n  }\n\n  # Helper function to compute the shortest sequence of turns required to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the desired direction.\n\n      # Calculate the rotational difference, considering directions wrap around (0-3).\n      # Adding 4 ensures positive result for modulo operation.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP to RIGHT).\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP to LEFT).\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP to DOWN).\n          # Two successive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples of (current_CraftState, path_to_reach_this_state).\n  q = collections.deque()\n  # The 'visited' set tracks unique states to prevent redundant exploration and cycles.\n  # A state is defined by a hashable tuple: (row, col, direction, inventory_tuple).\n  # inventory_tuple is a hashable representation of the agent's inventory array.\n  visited = set()\n\n  # Add the initial state to the queue and visited set to start the BFS.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit on the number of states to explore. This prevents excessively\n  # long computations in very large or potentially unreachable scenarios.\n  # A fixed large number is chosen for predictability across different grid sizes.\n  MAX_EXPLORED_STATES = 50000 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated action path.\n    explored_states_count += 1\n\n    # Pruning: If the number of explored states exceeds the heuristic limit,\n    # skip this path to prevent runaway computation.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check: Can the target primitive be collected from the current state? ---\n    # We check two main scenarios:\n    # 1. The primitive is directly under the agent (only applicable if it's grabbable).\n    # 2. The primitive is in an adjacent cell, requiring the agent to face it and 'USE'.\n\n    # Scenario 1: Primitive is directly under the agent.\n    # This is relevant for items that can be picked up from the same cell the agent occupies.\n    # Note: `grabbable_indices` includes items that can be picked up when walked over,\n    # and also items that are crafted (which are distinct from 'primitives' in DSL).\n    # We still need to check if the specific `i_kind` is in `grabbable_indices` AND\n    # present at the current location to allow direct pickup.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory) # Capture inventory before 'USE'.\n        _, state_after_use = state.step(USE_ACT) # Simulate picking up the item.\n\n        # Verify that the 'USE' action actually increased the primitive's count in inventory.\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Success: return the path including this 'USE' action.\n\n    # Scenario 2: Primitive is in an adjacent cell, requiring facing it.\n    # `state.next_to(i_kind)` broadly checks the 3x3 neighborhood for the primitive.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to see if the primitive is directly in front.\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions required to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    # Apply turns sequentially to get the state after turning.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the turned state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # implicitly accounting for any preconditions (e.g., requiring tools) handled\n                # by the `CraftState.step` method.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the full path including turns and the final USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Explore Movement Actions ---\n    # For each possible cardinal movement action, simulate the step and add the new state\n    # to the queue if it has not been visited before (considering inventory changes).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Convert array to hashable tuple.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # --- Explore General 'USE' Action ---\n    # This is critical for picking up other grabbable items (like tools) or interacting\n    # with workshops/environment features that might not be the target primitive itself,\n    # but are necessary preconditions for later collection.\n    \n    # Capture inventory before 'USE' to check if anything changed.\n    inventory_before_any_use = np.copy(state.inventory)\n    # Simulate the 'USE' action from the current state.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Only add the state after a general 'USE' action to the queue if it resulted in\n    # a meaningful change (i.e., inventory updated, or position/direction changed).\n    # This prevents exploring redundant states where 'USE' did nothing.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state\n  # under the given game rules and agent capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
