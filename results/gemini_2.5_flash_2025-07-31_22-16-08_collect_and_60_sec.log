{"timestamp": "2025-08-01T02:09:13.531931", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  agent_start_pos_x, agent_start_pos_y = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Map string action names to their integer IDs for clarity\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get the integer ID for the target primitive, converting to lowercase\n  # as names in the cookbook index are typically lowercase.\n  try:\n    target_primitive_id = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # If the primitive name is not found in the index, it's invalid.\n    return []\n\n  # Categorize the target primitive based on how it's collected:\n  # 1. Grabbable: Can be picked up by standing on it and using 'USE'. (e.g., WOOD, IRON)\n  # 2. Adjacent-Interactable: Requires being in a 3x3 neighborhood (including self) and sometimes 'USE'.\n  #    (e.g., WATER, STONE require USE; WORKSHOPS just require presence).\n  is_grabbable_target = target_primitive_id in env.world.grabbable_indices\n  is_adjacent_interactable_target = (target_primitive_id == env.world.water_index or\n                                     target_primitive_id == env.world.stone_index or\n                                     target_primitive_id in env.world.workshop_indices)\n\n  # Special case: 'boundary' is an impassable entity and cannot be collected.\n  if target_primitive_id == env.world.cookbook.index.index(\"boundary\"):\n      return []\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((agent_start_pos_x, agent_start_pos_y), [])])\n  # The 'visited' set keeps track of grid positions already explored to prevent cycles.\n  visited = {(agent_start_pos_x, agent_start_pos_y)}\n\n  # Movement deltas for x, y coordinates and corresponding action codes\n  # (dx, dy, action_code)\n  move_options = [\n      (0, -1, ACTION_UP),    # Move North (UP)\n      (0, 1, ACTION_DOWN),   # Move South (DOWN)\n      (-1, 0, ACTION_LEFT),  # Move West (LEFT)\n      (1, 0, ACTION_RIGHT)   # Move East (RIGHT)\n  ]\n\n  while queue:\n    current_x, current_y = queue[0][0] # Current position (x, y) being explored\n    path_actions_so_far = queue[0][1]  # Path taken to reach (current_x, current_y)\n    queue.popleft()\n\n    # --- Check if the target primitive can be collected from the current BFS position ---\n    collection_condition_met = False\n    actions_to_append_for_collection = []\n\n    if is_grabbable_target:\n      # For grabbable items, the agent must be directly on the cell containing the item.\n      if grid[current_x, current_y, target_primitive_id] > 0:\n        collection_condition_met = True\n        actions_to_append_for_collection = [ACTION_USE] # Collecting requires a USE action.\n    elif is_adjacent_interactable_target:\n      # For adjacent-interactable items, agent needs to be in a 3x3 neighborhood.\n      found_in_neighborhood = False\n      for dx_offset in [-1, 0, 1]:\n        for dy_offset in [-1, 0, 1]:\n          neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n          # Ensure neighbor is within grid boundaries.\n          if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n            # Check if the neighbor cell contains the target primitive.\n            if grid[neighbor_x, neighbor_y, target_primitive_id] > 0:\n              found_in_neighborhood = True\n              break # Found in vicinity, no need to check other neighbors.\n        if found_in_neighborhood:\n          break # Break outer loop if primitive found.\n\n      if found_in_neighborhood:\n        collection_condition_met = True\n        # Water and Stone also require a USE action for collection. Workshops do not.\n        if target_primitive_id == env.world.water_index or target_primitive_id == env.world.stone_index:\n          actions_to_append_for_collection = [ACTION_USE]\n\n    # If the collection condition is met at the current position, return the path.\n    if collection_condition_met:\n      return path_actions_so_far + actions_to_append_for_collection\n\n    # --- Explore neighboring cells to find a path to the target ---\n    for dx_move, dy_move, action_code in move_options:\n      next_x, next_y = current_x + dx_move, current_y + dy_move\n      next_pos = (next_x, next_y)\n\n      # 1. Check if the next position is within grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Check if the next position has already been visited during BFS.\n      if next_pos in visited:\n        continue\n\n      # 3. Determine if the next position is an impassable obstacle.\n      is_impassable_obstacle = False\n      for obstacle_kind_id in env.world.non_grabbable_indices:\n        # If the cell contains an entity that is typically non-grabbable.\n        if grid[next_x, next_y, obstacle_kind_id] > 0:\n          # Special rule: If this \"obstacle\" is actually the target primitive itself,\n          # AND that target is an adjacent-interactable type (like water, stone, workshop),\n          # then the agent *can* move onto this cell to be adjacent/on it.\n          if (obstacle_kind_id == target_primitive_id) and is_adjacent_interactable_target:\n            # This specific non-grabbable entity is our goal and allows traversal, so it's not an obstacle.\n            pass\n          else:\n            # It's a true blocking obstacle (e.g., boundary, or another non-grabbable entity not our target).\n            is_impassable_obstacle = True\n            break # Found an impassable obstacle, no need to check other kinds in this cell.\n      \n      if is_impassable_obstacle:\n        continue # Skip this path if it leads to an impassable obstacle.\n\n      # If the next position is valid and traversable, add it to the queue for further exploration.\n      visited.add(next_pos) # Mark as visited.\n      new_path = list(path_actions_so_far) # Create a new path list for this branch.\n      new_path.append(action_code) # Add the action taken to reach this new position.\n      queue.append((next_pos, new_path))\n\n  # If the BFS completes and the queue is empty, it means no path to collect the primitive was found.\n  return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:10:14.466993", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  MOVE_UP = action_map['UP']\n  MOVE_DOWN = action_map['DOWN']\n  MOVE_LEFT = action_map['LEFT']\n  MOVE_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  MOVE_ACTIONS = [MOVE_UP, MOVE_DOWN, MOVE_LEFT, MOVE_RIGHT]\n\n  # 1. Get target primitive's integer index\n  try:\n    target_kind_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's an unknown item.\n    return []\n\n  initial_state = env._current_state\n  \n  # Determine if the target is grabbable (can be picked up by standing on it and USE)\n  is_grabbable = target_kind_idx in env.world.grabbable_indices\n\n  # Grid dimensions (WIDTH is first dimension, HEIGHT is second)\n  WIDTH, HEIGHT, _ = initial_state.grid.shape\n\n  # Mapping from agent's direction integer to (dr, dc) for checking the cell in front\n  # DMLab-style directions: 0: UP, 1: RIGHT, 2: DOWN, 3: LEFT\n  dir_to_delta = {\n      0: (-1, 0),  # UP (North)\n      1: (0, 1),   # RIGHT (East)\n      2: (1, 0),   # DOWN (South)\n      3: (0, -1)   # LEFT (West)\n  }\n\n  # 2. BFS setup for pathfinding\n  # The queue stores tuples of (current_CraftState_object, list_of_actions_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n  \n  # The visited set stores a unique representation of a state to prevent revisiting\n  # and cycles. A state is defined by (agent_position_row, agent_position_col, agent_direction).\n  visited = set()\n\n  # Maximum number of steps to search. This prevents excessively long computations\n  # for unreachable items or very large maps.\n  MAX_SEARCH_DEPTH = 75 \n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # If the current path exceeds the maximum search depth, prune this branch.\n    if len(current_path) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Create a unique key for the current state to add to the visited set.\n    # We only care about position and direction for pathfinding to the item.\n    state_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n\n    # If this state has already been visited, skip it.\n    if state_key in visited:\n      continue\n    \n    # Mark the current state as visited.\n    visited.add(state_key)\n\n    # --- Goal Condition Check: Can we collect the primitive from this state with 'USE'? ---\n    r, c = current_state.pos\n    grid = current_state.grid # Reference to the current grid for checking\n\n    if is_grabbable:\n      # For grabbable items, the agent must be standing on the item's cell.\n      # The 'USE' action picks up items from the current cell.\n      if grid[r, c, target_kind_idx] > 0:\n        return current_path + [USE_ACTION]\n    else:\n      # For non-grabbable items (e.g., workshops, stone blocks to be mined),\n      # the agent must be adjacent to and facing the item to 'USE' it.\n      dr, dc = dir_to_delta[current_state.dir]\n      front_r, front_c = r + dr, c + dc\n\n      # Check if the cell in front is within grid bounds\n      if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n        if grid[front_r, front_c, target_kind_idx] > 0:\n          return current_path + [USE_ACTION]\n\n    # --- Explore Neighbors: Try all valid movement actions ---\n    for action in MOVE_ACTIONS:\n      # current_state.step(action) returns a *new* CraftState instance\n      # and the reward (which is not used for pathfinding here).\n      # The step method handles collisions and impassable terrain; if a move\n      # is invalid, the position/direction in next_state will often be unchanged.\n      _reward, next_state = current_state.step(action)\n      \n      # Generate the state key for the potential next state.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      # Only add the next state to the queue if it has not been visited yet.\n      # This prevents cycles and ensures the shortest path due to BFS property.\n      if next_state_key not in visited:\n        queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the item is unreachable within the defined search depth or is not present.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:10:15.460839", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  MOVE_DOWN = action_map['DOWN']\n  MOVE_UP = action_map['UP']\n  MOVE_LEFT = action_map['LEFT']\n  MOVE_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Mapping from direction integer (DMLab style: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # to (dr, dc) delta for the cell directly in front of the agent.\n  dir_to_delta = {\n      0: (-1, 0), # UP\n      1: (0, 1),  # RIGHT\n      2: (1, 0),  # DOWN\n      3: (0, -1)  # LEFT\n  }\n\n  try:\n    # Get the integer ID for the target primitive from the cookbook's index.\n    target_kind_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it's impossible to collect.\n    return []\n\n  # Determine if the target primitive is a grabbable item (can be picked up by standing on it).\n  is_target_grabbable = target_kind_idx in env.world.grabbable_indices\n\n  initial_state = env._current_state\n  \n  # BFS Queue: stores tuples of (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n  \n  # Visited set: stores (row, col, direction) tuples to avoid cycles and redundant paths.\n  visited = set()\n  \n  # Maximum search depth to prevent excessively long searches or infinite loops\n  # in very complex or impossible scenarios.\n  MAX_SEARCH_DEPTH = 75 \n\n  # Define all possible movement actions.\n  movement_actions = [MOVE_DOWN, MOVE_UP, MOVE_LEFT, MOVE_RIGHT]\n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # If the current path length exceeds the maximum search depth, stop exploring this branch.\n    if len(current_path) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Create a unique key for the current state to check against the visited set.\n    # A state is defined by the agent's position and direction.\n    state_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n\n    # If this state has already been visited, skip it as we've found a shorter or equal path.\n    if state_key in visited:\n      continue\n    \n    # Mark the current state as visited.\n    visited.add(state_key)\n\n    # --- Goal Check: Determine if the agent is in a position to 'USE' the primitive ---\n    current_pos_r, current_pos_c = current_state.pos\n    grid = current_state.grid # Access the current grid to check cell contents.\n\n    if is_target_grabbable:\n        # For grabbable items (like WOOD, IRON, etc.), the agent must be standing directly\n        # on the cell containing the item to pick it up with a 'USE' action.\n        if grid[current_pos_r, current_pos_c, target_kind_idx] > 0:\n            return current_path + [USE_ACTION]\n    else:\n        # For non-grabbable items (like STONE, WORKSHOPS, etc.), the agent typically\n        # needs to be adjacent to and facing the item to 'USE' it.\n        \n        # Calculate the coordinates of the cell directly in front of the agent.\n        dr_front, dc_front = dir_to_delta[current_state.dir]\n        front_r, front_c = current_pos_r + dr_front, current_pos_c + dc_front\n\n        # Get grid dimensions to check bounds before accessing `grid`.\n        WIDTH, HEIGHT, _ = grid.shape\n        if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n            # Check if the cell in front of the agent contains the target primitive.\n            if grid[front_r, front_c, target_kind_idx] > 0:\n                return current_path + [USE_ACTION]\n\n    # --- Explore Neighbors: Try all valid movement actions ---\n    for action in movement_actions:\n      # Use current_state.step(action) to get the next state.\n      # This method correctly handles collisions with impassable terrain (e.g., boundary, water)\n      # by returning a new state that is identical to the current_state if the move is invalid.\n      _reward, next_state = current_state.step(action)\n      \n      # Generate the state key for the next state.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      # Add the next state to the queue only if it has not been visited yet.\n      # This check also prevents adding duplicate states that result from invalid moves\n      # (where next_state is effectively the same as current_state).\n      if next_state_key not in visited:\n        queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the item is unreachable within the defined search depth or is not present.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:11:24.042773", "function_name": "collect", "function_body": "  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # Enhancement for collect_v1/v2: Ensure the primitive is actually grabbable.\n  # The \"collect\" action implies adding an item to inventory. If the primitive\n  # is not grabbable (e.g., a boundary, workshop, or uncollectible environment feature),\n  # then this function cannot fulfill its purpose for that primitive.\n  if primitive_idx not in env.world.grabbable_indices:\n      # Return an empty list to indicate that this primitive cannot be \"collected\"\n      # into the agent's inventory. This prevents infinite loops trying to collect\n      # an uncollectible item.\n      return []\n\n  actions_map = env.action_specs()\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  state = env._current_state\n  \n  # 1. Check if the primitive is already in the agent's inventory\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # 2. If the agent is already next to the primitive, just use it\n  if state.next_to(primitive_idx):\n      return [ACTION_USE]\n\n  # 3. Get grid information\n  grid = state.grid\n  current_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 4. Identify all locations of the primitive on the grid\n  primitive_locations = set()\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive_idx] == 1:\n              primitive_locations.add((x, y))\n  \n  if not primitive_locations:\n      # Primitive not found anywhere on the map, cannot collect.\n      return []\n\n  # 5. Define target cells for BFS (cells from which the 'USE' action would be effective)\n  # These are any cells within the 3x3 neighborhood of any primitive_location.\n  bfs_targets = set()\n  for px, py in primitive_locations:\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              tx, ty = px + dx, py + dy\n              # Check bounds for the potential target cell\n              if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n                  bfs_targets.add((tx, ty))\n  \n  # BFS: Find the shortest path from current_pos to any cell in bfs_targets\n  # Queue stores tuples of (position, list_of_actions_to_reach_this_position)\n  queue = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  path_found = False\n  final_path_actions = []\n\n  # Possible movements: (dx, dy, action_value)\n  moves = [\n      (0, -1, ACTION_UP),    # Move Up (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move Down (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases X)\n      (1, 0, ACTION_RIGHT)   # Move Right (increases X)\n  ]\n\n  while queue:\n      current_pos_bfs, current_path_bfs = queue.popleft()\n\n      # Check if the current BFS position is one of our target cells (i.e., adjacent to a primitive)\n      if current_pos_bfs in bfs_targets:\n          # Path to a usable location found! Append ACTION_USE to collect.\n          final_path_actions = current_path_bfs + [ACTION_USE]\n          path_found = True\n          break\n\n      # Explore neighbors\n      for dx, dy, action_val in moves:\n          next_x, next_y = current_pos_bfs[0] + dx, current_pos_bfs[1] + dy\n          next_pos_bfs = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries\n          if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n              # Check if the next position contains any non-grabbable (and thus potentially blocking) item\n              is_blocked = False\n              for i_kind_check in env.world.non_grabbable_indices:\n                  if grid[next_x, next_y, i_kind_check] == 1:\n                      is_blocked = True\n                      break\n              \n              # If not blocked and not yet visited, add to queue for exploration\n              if not is_blocked and next_pos_bfs not in visited:\n                  visited.add(next_pos_bfs)\n                  new_path_bfs = current_path_bfs + [action_val]\n                  queue.append((next_pos_bfs, new_path_bfs))\n\n  # Return the found path or an empty list if no path was found\n  return final_path_actions if path_found else []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:11:25.017792", "function_name": "collect", "function_body": "  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  \n  actions_map = env.action_specs()\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  state = env._current_state\n  \n  # 1. Check if the primitive is already in the agent's inventory\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # 2. If the agent is already next to the primitive, just use it\n  if state.next_to(primitive_idx):\n      return [ACTION_USE]\n\n  # 3. Get grid information\n  grid = state.grid\n  current_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 4. Identify all locations of the primitive on the grid\n  primitive_locations = set()\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive_idx] == 1:\n              primitive_locations.add((x, y))\n  \n  if not primitive_locations:\n      # Primitive not found on the map, cannot collect.\n      return []\n\n  # 5. Define target cells for BFS (cells from which the 'USE' action would be effective)\n  # A cell (tx, ty) is a target if it's within the 3x3 neighborhood of any primitive_location.\n  # This corresponds to the condition checked by state.next_to(primitive_idx).\n  bfs_targets = set()\n  for px, py in primitive_locations:\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              tx, ty = px + dx, py + dy\n              # Check bounds for the potential target cell\n              if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n                  bfs_targets.add((tx, ty))\n  \n  # BFS: Find the shortest path from current_pos to any cell in bfs_targets\n  # Queue stores tuples of (position, list_of_actions_to_reach_this_position)\n  queue = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  path_found = False\n  final_path_actions = []\n\n  # Possible movements: (dx, dy, action_value)\n  moves = [\n      (0, -1, ACTION_UP),    # Move Up (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move Down (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases X)\n      (1, 0, ACTION_RIGHT)   # Move Right (increases X)\n  ]\n\n  while queue:\n      current_pos_bfs, current_path_bfs = queue.popleft()\n\n      # Check if the current position is one of our target cells\n      if current_pos_bfs in bfs_targets:\n          # Path to a usable location found!\n          final_path_actions = current_path_bfs + [ACTION_USE]\n          path_found = True\n          break\n\n      # Explore neighbors\n      for dx, dy, action_val in moves:\n          next_x, next_y = current_pos_bfs[0] + dx, current_pos_bfs[1] + dy\n          next_pos_bfs = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries\n          if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n              # Check if the next position contains any non-grabbable (and thus potentially blocking) item\n              is_blocked = False\n              for i_kind_check in env.world.non_grabbable_indices:\n                  if grid[next_x, next_y, i_kind_check] == 1:\n                      is_blocked = True\n                      break\n              \n              # If not blocked and not visited, add to queue\n              if not is_blocked and next_pos_bfs not in visited:\n                  visited.add(next_pos_bfs)\n                  new_path_bfs = current_path_bfs + [action_val]\n                  queue.append((next_pos_bfs, new_path_bfs))\n\n  # Return the found path or an empty list if no path was found\n  return final_path_actions if path_found else []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:12:19.413075", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Get the integer index for the primitive\n  cookbook_index = env.world.cookbook.index\n  primitive_idx = cookbook_index.get(primitive) # Use .get() to avoid KeyError, returns None if not found\n  if primitive_idx is None:\n    return []\n\n  # 2. Check if primitive is already in inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Check if the primitive is grabbable. If not, 'USE' won't collect it.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # 4. Define non-traversable indices.\n  # These are entities that cannot be walked through. Workshops are typically traversable.\n  non_traversable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Get action mappings (DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4)\n  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n  \n  # 6. Define movements and their corresponding actions (dx, dy)\n  move_actions_with_deltas = [\n      (action_map['UP'], (0, -1)),\n      (action_map['DOWN'], (0, 1)),\n      (action_map['LEFT'], (-1, 0)),\n      (action_map['RIGHT'], (1, 0)),\n  ]\n\n  # Helper function to check if a target kind is in the 3x3 neighborhood of a given position.\n  # This replaces the need to instantiate `CraftState` objects repeatedly, improving performance.\n  def _check_next_to_optimized(pos, target_kind_idx, current_grid, grid_w, grid_h):\n      px, py = pos\n      # Check 3x3 neighborhood (including the center cell)\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = px + dx, py + dy\n              # Ensure neighbor cell is within grid bounds\n              if 0 <= nx < grid_w and 0 <= ny < grid_h:\n                  # Check if the target kind is present in this neighbor cell\n                  if current_grid[nx, ny, target_kind_idx] == 1:\n                      return True\n      return False\n\n  # 7. BFS initialization\n  # Queue stores (position_tuple, list_of_actions_to_reach_this_pos)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores position_tuple to avoid cycles and redundant paths\n  visited = {start_pos}\n\n  while queue:\n    current_pos, path_actions = queue.popleft()\n    cx, cy = current_pos\n\n    # 8. Check if the primitive is within the 3x3 neighborhood of the current_pos.\n    # If so, we are in a position to 'USE' it.\n    if _check_next_to_optimized(current_pos, primitive_idx, grid, grid_width, grid_height):\n      return path_actions + [USE_ACTION]\n\n    # 9. Explore traversable neighbors to find a path\n    for action_id, (dx_move, dy_move) in move_actions_with_deltas:\n      next_x, next_y = cx + dx_move, cy + dy_move\n      next_pos = (next_x, next_y)\n\n      # Check bounds for the next position\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Out of bounds\n\n      # Check if already visited\n      if next_pos in visited:\n        continue\n\n      # Check traversability: Is this next cell blocked by any non-traversable terrain?\n      is_blocked = False\n      for kind_idx in non_traversable_indices:\n          if grid[next_x, next_y, kind_idx] == 1: # If the kind is present in this cell\n              is_blocked = True\n              break\n      if is_blocked:\n        continue # Cannot move into a blocked cell\n\n      # If traversable and not visited, add to queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_actions + [action_id]))\n\n  # 10. If the BFS queue becomes empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:12:20.437655", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n\n  # 1. Get the integer index for the primitive\n  cookbook_index = env.world.cookbook.index\n  try:\n    primitive_idx = cookbook_index[primitive]\n  except KeyError:\n    # Primitive name not found in the cookbook, cannot collect\n    return []\n\n  # 2. Check if primitive is already in inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Check if the primitive is grabbable. If not, 'USE' won't collect it.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # 4. Define non-traversable indices.\n  # Cells containing these kinds are considered blocked for movement.\n  # Workshops are generally non-grabbable but are traversable.\n  non_traversable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Get action mappings (DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4)\n  action_map = env.action_specs()\n  \n  # 6. Define movements and their corresponding actions (dx, dy) and resulting direction.\n  # We assume craft.py defines NORTH, SOUTH, EAST, WEST constants for direction.\n  # The 'MOVE' actions in CraftLab change both position and agent's facing direction.\n  # Assuming standard mapping for direction constants:\n  # craft.NORTH: (0, -1) -> UP action\n  # craft.SOUTH: (0, 1) -> DOWN action\n  # craft.WEST: (-1, 0) -> LEFT action\n  # craft.EAST: (1, 0) -> RIGHT action\n  try:\n      NORTH_DIR = craft.NORTH\n      SOUTH_DIR = craft.SOUTH\n      EAST_DIR = craft.EAST\n      WEST_DIR = craft.WEST\n  except AttributeError:\n      # Fallback if craft.NORTH etc. are not explicitly defined in craft module,\n      # which might happen if they are internal. This is a heuristic guess\n      # based on common CraftWorld/DMLab conventions, but relies on internal constants.\n      # For a robust solution, these constants should be provided or exposed.\n      # Assuming 0=NORTH, 1=EAST, 2=SOUTH, 3=WEST based on CraftWorld conventions.\n      NORTH_DIR = 0\n      EAST_DIR = 1\n      SOUTH_DIR = 2\n      WEST_DIR = 3\n\n\n  # Mapping (action_id, (dx, dy) for movement, resulting_direction_constant)\n  move_actions_info = [\n      (action_map['UP'], (0, -1), NORTH_DIR),\n      (action_map['DOWN'], (0, 1), SOUTH_DIR),\n      (action_map['LEFT'], (-1, 0), WEST_DIR),\n      (action_map['RIGHT'], (1, 0), EAST_DIR),\n  ]\n\n  # Mapping direction constants to (dx, dy) deltas for checking the cell \"in front\"\n  dir_to_delta = {\n      NORTH_DIR: (0, -1),\n      SOUTH_DIR: (0, 1),\n      EAST_DIR: (1, 0),\n      WEST_DIR: (-1, 0),\n  }\n  \n  grid_width, grid_height, _ = grid.shape\n\n  # 7. BFS initialization\n  # Queue stores (position_tuple, current_direction_int, list_of_actions_to_reach_this_pos)\n  queue = collections.deque([(start_pos, current_state.dir, [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant searches for the same state\n  visited = {(start_pos, current_state.dir)}\n\n  while queue:\n    current_pos, current_dir, path_actions = queue.popleft()\n    cx, cy = current_pos\n\n    # 8. Goal check: Is the primitive directly in front of the agent at current_pos with current_dir?\n    dx_front, dy_front = dir_to_delta[current_dir]\n    front_x, front_y = cx + dx_front, cy + dy_front\n\n    # Check bounds for the cell in front\n    if (0 <= front_x < grid_width and 0 <= front_y < grid_height):\n        # Check if the primitive is present in the cell directly in front\n        if grid[front_x, front_y, primitive_idx] == 1:\n            # Found it! Add the USE action and return the path.\n            return path_actions + [action_map['USE']]\n\n    # 9. Explore traversable neighbors by moving\n    for action_id, (dx_move, dy_move), next_dir in move_actions_info:\n      next_x, next_y = cx + dx_move, cy + dy_move\n      next_pos = (next_x, next_y)\n      \n      # Check bounds for the next position\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Out of bounds\n\n      # Check traversability: Is this next cell blocked by any non-traversable terrain?\n      is_blocked = False\n      for kind_idx in non_traversable_indices:\n          if grid[next_x, next_y, kind_idx] == 1: # If the kind is present in this cell\n              is_blocked = True\n              break\n      if is_blocked:\n        continue # Cannot move into a blocked cell\n        \n      # If traversable and not visited (new position-direction state), add to queue\n      if (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        queue.append((next_pos, next_dir, path_actions + [action_id]))\n\n  # 10. If the BFS queue becomes empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:13:33.105599", "function_name": "collect", "function_body": "  actions = []\n\n  # 0. Check if the primitive is already in the inventory.\n  # If the goal item is already in inventory, no actions are needed.\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_inventory = env._current_state.inventory\n  if current_inventory[primitive_idx] > 0:\n      return [] # Already collected, return empty action list.\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine if the primitive is grabbable (can be walked on and picked up)\n  # or non-grabbable (requires being adjacent and USE action, e.g., mining stone/water, using workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Map DMLab action values to (dr, dc) movement deltas AND CraftState.dir values.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # The agent's direction updates to match the last movement action.\n  action_to_move_and_dir = {\n      UP: ((-1, 0), 1),    # Move UP, new direction is North (1)\n      DOWN: ((1, 0), 0),   # Move DOWN, new direction is South (0)\n      LEFT: ((0, -1), 2),  # Move LEFT, new direction is West (2)\n      RIGHT: ((0, 1), 3)   # Move RIGHT, new direction is East (3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply for non-grabbable items.\n  dir_to_fwd_delta = {\n      0: (1, 0),  # Facing South, cell in front is (row+1, col)\n      1: (-1, 0), # Facing North, cell in front is (row-1, col)\n      2: (0, -1), # Facing West, cell in front is (row, col-1)\n      3: (0, 1)   # Facing East, cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item.\n      # Agent can walk onto grabbable items (e.g., WOOD, IRON), but not non-grabbable ones.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      ((r, c), current_dir_val), path_so_far = queue.popleft()\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be on the same cell\n          # as the primitive to collect it. The final action will be USE after reaching the cell.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to a cell containing the grabbable item.\n      else:\n          # For non-grabbable items (e.g., STONE, WATER, WORKSHOP), the agent must be\n          # adjacent to the primitive AND facing it to use the 'USE' action.\n          fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path ending in the correct position and direction to use the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in action_to_move_and_dir.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only proceed if the next position is valid (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_valid_move(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if path_to_target:\n      # If a path was found, append the USE action at the end to perform the collection.\n      # This assumes USE is always the final action, consistent with the DSL's single COLLECT verb.\n      actions = path_to_target + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:13:34.128933", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_pos = initial_state.pos\n  start_dir = initial_state.dir # Initial direction of the agent\n  global_grid = initial_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine if the primitive is grabbable (can be walked on and picked up)\n  # or non-grabbable (requires being adjacent and USE action, e.g., mining stone/water, using workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Define movement actions and their corresponding new positions and directions.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # The agent's direction updates to match the last movement action.\n  move_actions_info = [\n      (UP,    (-1, 0), 1),  # Action, (dr, dc), new_dir_val\n      (DOWN,  (1, 0),  0),\n      (LEFT,  (0, -1), 2),\n      (RIGHT, (0, 1),  3)\n  ]\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply.\n  dir_to_forward_delta = {\n      0: (1, 0),  # Facing South (dir 0), cell in front is (row+1, col)\n      1: (-1, 0), # Facing North (dir 1), cell in front is (row-1, col)\n      2: (0, -1), # Facing West (dir 2), cell in front is (row, col-1)\n      3: (0, 1)   # Facing East (dir 3), cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_walkable(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item.\n      # Agent can walk onto grabbable items (e.g., WOOD, IRON), but not non-grabbable ones.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_to_current_state (list of actions) )\n  # The state includes direction because 'USE' depends on facing the target.\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  visited = {(start_pos, start_dir)}\n\n  found_path_pre_use = None # This will store the sequence of actions to reach the state *before* the 'USE' action.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current (position, direction) state is a \"pre-USE\" state for collection.\n      is_target_reachable_from_current_state = False\n      if primitive_is_grabbable:\n          # For grabbable items, the agent needs to be on the same cell as the primitive.\n          # We check if the current cell (r, c) contains the primitive.\n          if global_grid[r, c, primitive_idx] == 1:\n              is_target_reachable_from_current_state = True\n      else:\n          # For non-grabbable items, the agent must be adjacent to the primitive AND facing it.\n          fwd_dr, fwd_dc = dir_to_forward_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              is_target_reachable_from_current_state = True\n\n      if is_target_reachable_from_current_state:\n          found_path_pre_use = path_so_far\n          break # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (dr, dc), new_dir_val in move_actions_info:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val) # BFS state includes position and direction\n\n          # Only proceed if the next position is walkable (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if found_path_pre_use is not None:\n      # If a path to the \"pre-USE\" state was found, append the USE action at the end.\n      actions = found_path_pre_use + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:14:03.819685", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get the integer ID for the target primitive from the cookbook index\n  # Assume primitive name is always valid per DSL specification.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n\n  # Get current state details\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Determine if the target primitive is grabbable. Grabbable items need a USE action to be collected.\n  # Non-grabbable items (like workshops, water) are \"collected\" by simply reaching their location.\n  grabbable_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_primitive = (primitive_id in grabbable_ids_set)\n\n  # Identify kinds that act as obstacles. These are non-grabbable entities\n  # that the agent cannot pass through.\n  # Note: The target primitive, even if non-grabbable (e.g., WORKSHOP),\n  # should not be considered an obstacle if it's the target, as the agent\n  # needs to reach its location.\n  obstacle_kinds_ids = env.world.non_grabbable_indices\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy) for movement, mapping to action index\n  move_deltas = {\n      ACTION_UP: (0, -1),   # Moving up decreases y-coordinate\n      ACTION_DOWN: (0, 1),  # Moving down increases y-coordinate\n      ACTION_LEFT: (-1, 0), # Moving left decreases x-coordinate\n      ACTION_RIGHT: (1, 0)  # Moving right increases x-coordinate\n  }\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_position (tuple), path_taken_so_far (list of actions))\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores positions (tuples) to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop to find the shortest path to the primitive\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the current cell contains the target primitive\n    # We check grid[cx, cy, primitive_id] > 0 to see if there's any amount of the primitive.\n    if grid[cx, cy, primitive_id] > 0:\n      # Found the primitive. Now, decide if a USE action is needed.\n      if is_grabbable_primitive:\n        return path_so_far + [ACTION_USE] # Path to position + USE action\n      else:\n        return path_so_far # Path to position, no USE needed for non-grabbable\n\n    # Explore neighbors (possible next moves)\n    for action, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Check for obstacles at the next position.\n      # A cell is an obstacle if it contains any non-grabbable item\n      # that is *not* the primitive we are trying to collect.\n      is_obstacle_cell = False\n      for kind_id in obstacle_kinds_ids:\n        # If the cell contains an obstacle kind, AND that obstacle kind is NOT our target primitive,\n        # then it's truly an impassable obstacle.\n        if kind_id != primitive_id and grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break\n      \n      if is_obstacle_cell:\n        continue # Skip this move if it leads to an impassable obstacle\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:14:04.817571", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  # Use .lower() for robustness, as internal names might be lowercase.\n  try:\n    primitive_id = env.world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the environment's cookbook, cannot collect.\n    return []\n\n  # Get current state details\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Determine if the target primitive is grabbable (i.e., can be picked up and added to inventory).\n  # Items like WOOD, IRON are grabbable and require a 'USE' action.\n  # Items like WATER, STONE, WORKSHOPS are typically non-grabbable environmental features;\n  # \"collecting\" them means simply reaching their location.\n  grabbable_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_target = (primitive_id in grabbable_ids_set)\n\n  # Identify obstacles: these are non-grabbable items that the agent cannot move through.\n  # The `non_grabbable_indices` attribute provides a set of such IDs.\n  # The pathfinding logic must ensure the agent doesn't try to move onto these,\n  # unless the obstacle is the target primitive itself (e.g., moving onto a workshop).\n  obstacle_ids_set = env.world.non_grabbable_indices\n\n  # Define possible movements and their corresponding actions (dx, dy)\n  move_deltas = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_position_tuple, path_taken_so_far_as_action_list)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores positions (x, y tuples) to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop to find the shortest path to the primitive\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is at the current position.\n    # grid[cx, cy, primitive_id] > 0 means the primitive exists at this specific location.\n    if grid[cx, cy, primitive_id] > 0:\n      # Found the primitive.\n      if is_grabbable_target:\n        # If it's grabbable, append a USE_ACTION to pick it up.\n        return path_so_far + [ACTION_USE]\n      else:\n        # If it's not grabbable (e.g., a workshop, water), simply reaching the location is enough.\n        return path_so_far # Just return the path to the location\n\n    # Explore neighbors (possible next moves)\n    for action, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Check for obstacles at the next position.\n      # A cell is considered an obstacle if it contains any non-grabbable item\n      # that is NOT the primitive we are trying to collect. This allows moving\n      # onto the target primitive's tile even if it's generally non-grabbable\n      # (e.g., moving onto a workshop if 'WORKSHOP0' is the target).\n      is_obstacle_cell = False\n      for kind_id in obstacle_ids_set:\n        # If the cell contains an obstacle kind AND that kind is not our target primitive, then it's an obstacle.\n        if kind_id != primitive_id and grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break\n      \n      if is_obstacle_cell:\n        continue # Skip this move if it leads to an obstacle\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:15:06.120150", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state details\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive\n  try:\n    # Ensure primitive name is lowercased to match cookbook index\n    primitive_id = env.world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Define indices for non-grabbable entities (potential obstacles for movement).\n  # These are items that block passage.\n  non_grabbable_kinds = env.world.non_grabbable_indices\n\n  # Define possible moves and their corresponding actions (dx, dy, action)\n  # (dx, dy) represents change in (x, y) coordinates\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (y-1)\n      (0, 1, ACTION_DOWN),   # Move South (y+1)\n      (-1, 0, ACTION_LEFT),  # Move West (x-1)\n      (1, 0, ACTION_RIGHT)   # Move East (x+1)\n  ]\n\n  # BFS initialization\n  # Queue stores tuples: (current_position, path_taken_so_far_as_action_list)\n  queue = collections.deque([(current_pos, [])])\n  # Visited set stores positions (tuples of (x, y)) to avoid cycles and redundant exploration\n  visited = {current_pos}\n\n  # BFS loop to find the shortest path to a cell containing the primitive\n  while queue:\n    (cx, cy), path_so_far = queue.popleft()\n\n    # Check if the target primitive is at the current position (or just entered its cell).\n    # We are looking for a cell that contains the primitive, so we can USE it.\n    if current_grid[cx, cy, primitive_id] > 0:\n      # Found the primitive. Now, add the USE action to collect/interact with it.\n      return path_so_far + [ACTION_USE]\n\n    # Explore neighbors (possible next moves)\n    for dx, dy, action_move in move_actions:\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Check for obstacles at the next position.\n      # A cell is an obstacle if it contains any non-grabbable item that is NOT the primitive we are trying to collect.\n      is_obstacle_cell = False\n      for kind_id in non_grabbable_kinds:\n        # If the cell contains an item of this 'kind_id' AND this 'kind_id' is not our target primitive,\n        # then this cell is considered an obstacle for movement.\n        # This allows us to path TO the primitive even if the primitive itself is a non-grabbable entity (e.g., a workshop).\n        if kind_id != primitive_id and current_grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break # Found an obstacle, no need to check other kinds in this cell\n      \n      if is_obstacle_cell:\n        continue # Skip this move if it leads to an obstacle\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_move]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:15:07.102072", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  try:\n    # Convert primitive name (e.g., \"wood\") to its integer ID\n    # The DSL uses capitalized names (WOOD), but cookbook.index expects lowercase.\n    primitive_id = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # If the primitive name is not recognized in the cookbook, it cannot be collected.\n    return []\n\n  # Determine if the target primitive is grabbable (can be picked up) or non-grabbable (interacted with, like a workshop)\n  is_primitive_grabbable = primitive_id in env.world.grabbable_indices\n  \n  # Prepare the obstacle grid for pathfinding.\n  # A cell is considered an obstacle if it contains any non-grabbable item that blocks movement.\n  # Importantly, if the target primitive itself is non-grabbable (e.g., a WORKSHOP),\n  # we should be able to walk onto its tile to interact with it. Other non-grabbable items remain obstacles.\n  obstacle_grid = np.zeros((grid_width, grid_height), dtype=bool)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  for x in range(grid_width):\n    for y in range(grid_height):\n      for kind_idx in non_grabbable_indices:\n        # If the current 'kind_idx' is the target primitive AND the primitive is non-grabbable,\n        # we assume it's traversable for interaction (e.g., walking onto a WORKSHOP).\n        if not is_primitive_grabbable and kind_idx == primitive_id:\n          continue # This specific non-grabbable primitive does not block movement to its tile\n\n        # If this cell contains any other non-grabbable item (or if the target primitive is grabbable),\n        # then it's an obstacle.\n        if grid[x, y, kind_idx] > 0: \n          obstacle_grid[x, y] = True\n          break # This cell is an obstacle, no need to check other kinds for it\n\n  # BFS (Breadth-First Search) initialization\n  # Queue stores tuples: (current_position (x, y), list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores (x, y) positions to prevent cycles and redundant exploration\n  visited = {start_pos} \n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  move_actions = [\n      (0, -1, ACTION_UP),    # (dx, dy, action_id)\n      (0, 1, ACTION_DOWN),\n      (-1, 0, ACTION_LEFT),\n      (1, 0, ACTION_RIGHT)\n  ]\n\n  while queue:\n    (cx, cy), actions_so_far = queue.popleft()\n\n    # Determine if the current position satisfies the goal condition for collection.\n    # The goal condition differs based on whether the primitive is grabbable.\n    is_goal_achieved_at_current_pos = False\n\n    if is_primitive_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the goal is to be directly ON its cell.\n      if grid[cx, cy, primitive_id] > 0:\n        is_goal_achieved_at_current_pos = True\n    else:\n      # If the primitive is non-grabbable (e.g., WORKSHOP, WATER, STONE),\n      # the goal is to be ADJACENT to it (within a 3x3 neighborhood, including current cell).\n      # This simulates the CraftState.next_to() behavior.\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n          # Check bounds for the adjacent cell\n          if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n            if grid[nx_adj, ny_adj, primitive_id] > 0:\n              is_goal_achieved_at_current_pos = True\n              break # Found the primitive in the neighborhood, so goal achieved\n        if is_goal_achieved_at_current_pos:\n          break # Exit outer loop if goal condition is met\n\n    if is_goal_achieved_at_current_pos:\n      # If the current position allows for collection/interaction, return the path followed by a USE action.\n      return actions_so_far + [ACTION_USE]\n\n    # Explore valid neighboring cells\n    for dx, dy, action_move in move_actions:\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Check if the next position is an obstacle based on our obstacle_grid\n      if obstacle_grid[nx, ny]:\n        continue\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_pos)\n      queue.append((next_pos, actions_so_far + [action_move]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:16:17.053450", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Map movement action indices to their corresponding direction integer\n  # as stored in CraftState.dir (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  ACTION_TO_DIR = {\n      UP_ACTION: 0,    # Action 1 (UP) leads to direction 0 (UP)\n      RIGHT_ACTION: 1, # Action 3 (RIGHT) leads to direction 1 (RIGHT)\n      DOWN_ACTION: 2,  # Action 0 (DOWN) leads to direction 2 (DOWN)\n      LEFT_ACTION: 3,  # Action 2 (LEFT) leads to direction 3 (LEFT)\n  }\n\n  # Get relevant IDs from the environment's world and cookbook\n  cookbook = env.world.cookbook\n  try:\n      primitive_id = cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # Get the current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's current facing direction\n\n  # Grid dimensions (WIDTH is first dimension, HEIGHT is second)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define IDs of entities that are considered strictly impassable for agent movement.\n  # This includes boundary, water, and typically stone (as it's often a resource block\n  # that is mined, not walked through).\n  impassable_terrain_ids = {\n      cookbook.index.index(\"boundary\"),\n      env.world.water_index,\n  }\n  if \"stone\" in cookbook.index.contents: # Check if 'stone' exists in the index\n      impassable_terrain_ids.add(env.world.stone_index)\n\n  # Helper function to check if a position (r, c) is valid for the agent to stand on.\n  # This means it must be within grid bounds and not contain any impassable terrain.\n  def is_valid_walk_pos(r, c):\n    # Check if the position is within the grid boundaries.\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n    # Check if the cell at (r, c) contains any of the defined impassable terrain types.\n    for imp_id in impassable_terrain_ids:\n        if grid[r, c, imp_id] > 0:\n            return False # This cell contains an impassable block\n    return True\n\n  # Determine if the primitive itself is grabbable (can be picked up by standing on its cell and using USE).\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Pre-compute all locations on the grid where the target primitive exists.\n  primitive_locations = [] # List of (row, col) tuples\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0:\n              primitive_locations.append((r, c))\n\n  # If there are no instances of the primitive found on the grid, it's impossible to collect.\n  if not primitive_locations:\n      return []\n\n  # Define possible movement deltas (dr, dc) for each movement action.\n  move_deltas = {\n      UP_ACTION: (-1, 0), # Move UP: row by -1\n      DOWN_ACTION: (1, 0), # Move DOWN: row by +1\n      LEFT_ACTION: (0, -1), # Move LEFT: col by -1\n      RIGHT_ACTION: (0, 1) # Move RIGHT: col by +1\n  }\n\n  # Map delta from agent position to item position to the required agent direction.\n  # This is used for non-grabbable items where the agent needs to face the item.\n  DELTA_FACING_TO_DIR = {\n      (-1, 0): 0, # Item is North, agent faces UP (dir 0)\n      (0, 1): 1,  # Item is East, agent faces RIGHT (dir 1)\n      (1, 0): 2,  # Item is South, agent faces DOWN (dir 2)\n      (0, -1): 3  # Item is West, agent faces LEFT (dir 3)\n  }\n\n  # Pre-compute all valid ((agent_pos_r, agent_pos_c), agent_direction_id) states\n  # from which a single 'USE' action would successfully collect the primitive.\n  target_use_states = set()\n  for pr, pc in primitive_locations: # Iterate through each primitive instance location\n      if is_grabbable:\n          # If the item is grabbable, the agent needs to stand on the same cell (pr, pc).\n          # The agent's direction does not typically matter for picking up grabbable items.\n          if is_valid_walk_pos(pr, pc): # Ensure agent can actually walk onto this cell.\n              # Add all 4 possible agent directions to the target states for this position,\n              # as any direction works when standing on a grabbable item.\n              for d_id in range(4): # Directions: 0 (UP), 1 (RIGHT), 2 (DOWN), 3 (LEFT)\n                  target_use_states.add(((pr, pc), d_id))\n      else:\n          # If the item is non-grabbable (e.g., stone, workshop), the agent must be\n          # adjacent to it and facing it to 'USE' it.\n          # Check all 4 adjacent cells around the primitive's location.\n          for dr_adj, dc_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              # Calculate the proposed agent position (ar, ac)\n              ar, ac = pr + dr_adj, pc + dc_adj\n              \n              # Check if this calculated agent position is valid to stand on.\n              if is_valid_walk_pos(ar, ac):\n                  # Calculate the delta from the agent's proposed position to the primitive's position.\n                  # This delta determines the direction the agent needs to face.\n                  facing_r_delta = pr - ar\n                  facing_c_delta = pc - ac\n                  \n                  # Get the required direction ID from the pre-defined mapping.\n                  required_dir_val = DELTA_FACING_TO_DIR.get((facing_r_delta, facing_c_delta), -1)\n                  \n                  if required_dir_val != -1: # Ensure a valid direction was found\n                      target_use_states.add(((ar, ac), required_dir_val))\n\n  # If no valid target states are found (e.g., primitive is entirely surrounded by impassable terrain),\n  # then it's impossible to collect.\n  if not target_use_states:\n      return []\n\n  # Initialize BFS: State is ((current_position (r,c), current_direction (int)), path_of_actions (list)).\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Keep track of visited (position, direction) pairs to prevent cycles and find shortest path.\n  visited = {((start_pos, start_dir))}\n\n  while queue:\n    (r, c), current_dir = queue.popleft()[0]\n    path = queue.popleft()[1] # Correctly pop path as well\n\n    # --- Goal Check ---\n    # If the current agent state (position and direction) is one from which 'USE' would succeed,\n    # we have found the shortest path to collect the primitive.\n    if ((r, c), current_dir) in target_use_states:\n        return path + [USE_ACTION] # Append the final USE action and return the complete path.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT).\n    for action, (dr, dc) in move_deltas.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      # When the agent moves, its facing direction updates to the direction of movement.\n      next_dir = ACTION_TO_DIR[action] \n\n      # Only explore this new state if the next position is walkable and this\n      # (position, direction) state has not been visited before.\n      if is_valid_walk_pos(next_r, next_c) and (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        # Add the new state to the queue, appending the current action to the path.\n        queue.append(((next_pos, next_dir), path + [action]))\n\n  # If the BFS queue becomes empty and no path to a collectable primitive was found,\n  # it means the primitive is unreachable or doesn't exist in a collectable state.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:16:18.023451", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Map movement action indices to their corresponding DMLab direction integer\n  # as stored in CraftState.dir (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT).\n  # The agent's direction updates to the direction of the last movement.\n  ACTION_TO_NEW_AGENT_DIR = {\n      UP_ACTION: 0,      # If agent takes UP action, its new direction is UP (0)\n      RIGHT_ACTION: 1,   # If agent takes RIGHT action, its new direction is RIGHT (1)\n      DOWN_ACTION: 2,    # If agent takes DOWN action, its new direction is DOWN (2)\n      LEFT_ACTION: 3,    # If agent takes LEFT action, its new direction is LEFT (3)\n  }\n\n  # Map DMLab direction ID to the (dr, dc) delta that points *in front* of the agent.\n  # Used for non-grabbable items where agent must face the item.\n  DIR_TO_LOOK_DELTA = {\n      0: (-1, 0), # UP (dr=-1, dc=0)\n      1: (0, 1),  # RIGHT (dr=0, dc=1)\n      2: (1, 0),  # DOWN (dr=1, dc=0)\n      3: (0, -1)  # LEFT (dr=0, dc=-1)\n  }\n\n  cookbook = env.world.cookbook\n  try:\n      primitive_id = cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n\n  # Grid dimensions (WIDTH is first dimension, HEIGHT is second)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define IDs of entities that are considered strictly impassable for agent movement.\n  # These are cells the agent cannot walk *onto*.\n  impassable_terrain_ids = {\n      cookbook.index.index(\"boundary\"),\n      env.world.water_index,\n      env.world.stone_index # Stone blocks movement until mined from adjacent cells\n  }\n\n  def is_valid_walk_pos(r, c):\n    \"\"\"Checks if an agent can walk onto position (r, c).\n    A position is valid if it's within grid bounds and does not contain impassable terrain.\n    \"\"\"\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False # Out of bounds\n    for impassable_id in impassable_terrain_ids:\n        if grid[r, c, impassable_id] > 0:\n            return False # Contains an impassable block\n    return True\n\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Pre-compute all locations on the grid where the target primitive exists.\n  primitive_locations = [] # List of (row, col) tuples\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0:\n              primitive_locations.append((r, c))\n\n  # If no instances of the primitive are found on the grid, it's impossible to collect.\n  if not primitive_locations:\n      return []\n\n  # Define possible movement deltas (row_change, col_change) for each action.\n  move_deltas = {\n      UP_ACTION: (-1, 0),\n      DOWN_ACTION: (1, 0),\n      LEFT_ACTION: (0, -1),\n      RIGHT_ACTION: (0, 1)\n  }\n\n  # Step 1: Pre-compute all (agent_pos, agent_dir) states from which a 'USE' action\n  # would successfully collect the primitive. These are the target states for our BFS.\n  target_collection_states = set() # Stores ((row, col), direction) tuples\n\n  for pr, pc in primitive_locations: # Iterate through each primitive instance location\n      if is_grabbable:\n          # If the item is grabbable, the agent needs to be ON the cell (pr, pc).\n          # The agent's direction typically does not matter for picking up grabbable items.\n          if is_valid_walk_pos(pr, pc): # Ensure agent can actually walk onto this cell.\n              # Add all 4 possible agent directions, as any direction works when standing on a grabbable item.\n              for d_id in ACTION_TO_NEW_AGENT_DIR.values(): # 0, 1, 2, 3\n                  target_collection_states.add(((pr, pc), d_id))\n      else:\n          # If the item is non-grabbable (e.g., stone, workshops), the agent must be\n          # adjacent to it and facing it to 'USE' it.\n          for facing_dir_id, (dr_look, dc_look) in DIR_TO_LOOK_DELTA.items():\n              # Calculate the required agent position (ar, ac) such that if the agent\n              # is at (ar, ac) and faces `facing_dir_id`, it will be looking at (pr, pc).\n              # (ar + dr_look, ac + dc_look) = (pr, pc)  => (ar, ac) = (pr - dr_look, pc - dc_look)\n              ar, ac = pr - dr_look, pc - dc_look\n              \n              # Check if this calculated agent position is valid to stand on.\n              if is_valid_walk_pos(ar, ac):\n                  target_collection_states.add(((ar, ac), facing_dir_id))\n\n  # If no possible target collection states are found, the primitive is either\n  # unreachable or doesn't exist in a collectable configuration.\n  if not target_collection_states:\n      return []\n\n  # Step 2: Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  # from the current agent state to any of the `target_collection_states`.\n  # Queue stores: ( (current_position (r,c), current_direction (int)), path_of_actions (list) )\n  queue = collections.deque([((start_pos, start_dir), [])])\n  # Keep track of visited (position, direction) pairs to prevent cycles and find shortest path.\n  visited = {((start_pos, start_dir))}\n\n  while queue:\n    (r, c), current_dir, path = queue.popleft()\n\n    # --- Goal Check ---\n    # If the current agent state (position and direction) is one from which 'USE' would succeed,\n    # we have found the shortest path to collect the primitive.\n    if ((r, c), current_dir) in target_collection_states:\n        return path + [USE_ACTION] # Append the final USE action and return the complete path.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT).\n    for action, (dr, dc) in move_deltas.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n      \n      # When the agent moves, its facing direction updates to the direction of movement.\n      next_dir = ACTION_TO_NEW_AGENT_DIR[action] \n\n      # Only explore this new state if the next position is walkable and this\n      # (position, direction) state has not been visited before.\n      if is_valid_walk_pos(next_r, next_c) and (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        # Add the new state to the queue, appending the current action to the path.\n        queue.append(((next_pos, next_dir), path + [action]))\n\n  # If the BFS queue becomes empty and no path to a collectable primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:17:41.165325", "function_name": "collect", "function_body": "    actions_list = []\n    current_state = env._current_state\n    # Use the current grid state for pathfinding.\n    # We assume the grid environment is static during the execution of this `collect` function.\n    grid = current_state.grid\n    initial_pos = current_state.pos\n    initial_dir = current_state.dir\n\n    primitive_id = current_state.world.cookbook.index[primitive]\n    WIDTH, HEIGHT, _ = grid.shape\n\n    action_map = env.action_specs()\n    # Map DSL movement/turn actions to their integer indices.\n    # In DMLab-style environments, 'UP' often corresponds to moving forward in the current direction.\n    MOVE_FORWARD_ACTION = action_map['UP']\n    TURN_LEFT_ACTION = action_map['LEFT']\n    TURN_RIGHT_ACTION = action_map['RIGHT']\n    USE_ACTION = action_map['USE']\n\n    # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n    # Defines how position changes when moving \"forward\" in a given direction.\n    DIR_TO_DRDC = {\n        0: (0, 1),   # Facing RIGHT (positive column)\n        1: (-1, 0),  # Facing UP (negative row)\n        2: (0, -1),  # Facing LEFT (negative column)\n        3: (1, 0)    # Facing DOWN (positive row)\n    }\n\n    # Maps for turning left/right, updating the agent's direction (0-3)\n    TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n    TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n    # Get indices of non-grabbable items that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n    non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n    def is_cell_walkable(r: int, c: int) -> bool:\n        \"\"\"\n        Checks if a cell (r, c) is within grid bounds and does not contain non-walkable entities.\n        An agent cannot walk onto a primitive it's trying to collect; it must stand adjacent to it.\n        \"\"\"\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False\n        \n        # Check if the cell contains any non-walkable kind (e.g., boundary, deep water)\n        for kind_idx in non_walkable_kinds_indices:\n            if grid[r, c, kind_idx] > 0:\n                return False\n        \n        # The agent should not walk directly onto the primitive it intends to collect\n        # if that primitive represents a solid block (e.g., WOOD, STONE, GRASS).\n        # It needs to be adjacent and use an action to \"collect\" it.\n        if grid[r, c, primitive_id] > 0:\n            return False\n            \n        return True\n\n    # BFS state: ((row, col), direction), path_actions\n    # Queue stores tuples: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n    queue = collections.deque([((initial_pos, initial_dir), [])])\n    # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n    visited = {(initial_pos, initial_dir)}\n\n    target_path = None # Stores the action list to reach the target state (adjacent to primitive)\n\n    while queue:\n        (current_pos, current_dir), path_actions = queue.popleft()\n        r, c = current_pos\n\n        # Check if the primitive is directly in front of the agent at the current state (r, c, current_dir).\n        # This is the target condition: agent is in a position to USE the primitive.\n        front_dr, front_dc = DIR_TO_DRDC[current_dir]\n        front_r, front_c = r + front_dr, c + front_dc\n        \n        # Verify the cell in front is within bounds and contains the target primitive.\n        if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n            grid[front_r, front_c, primitive_id] > 0):\n            target_path = path_actions\n            break # Shortest path to target found\n\n        # Explore possible next actions: Move Forward, Turn Left, Turn Right\n        \n        # --- 1. Try Move Forward ---\n        move_dr, move_dc = DIR_TO_DRDC[current_dir]\n        next_r_move, next_c_move = r + move_dr, c + move_dc\n        next_pos_move = (next_r_move, next_c_move)\n        next_dir_move = current_dir # Moving forward does not change facing direction\n\n        # Check walkability and if the state has been visited\n        if is_cell_walkable(next_r_move, next_c_move) and \\\n           (next_pos_move, next_dir_move) not in visited:\n            visited.add((next_pos_move, next_dir_move))\n            queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n        # --- 2. Try Turn Left ---\n        next_dir_left = TURN_LEFT_MAP[current_dir]\n        # Turning does not change position, only direction.\n        if ((current_pos, next_dir_left) not in visited):\n            visited.add((current_pos, next_dir_left))\n            queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n        # --- 3. Try Turn Right ---\n        next_dir_right = TURN_RIGHT_MAP[current_dir]\n        # Turning does not change position, only direction.\n        if ((current_pos, next_dir_right) not in visited):\n            visited.add((current_pos, next_dir_right))\n            queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n    # If a path was found to an adjacent cell facing the primitive, append the USE action.\n    if target_path is not None:\n        actions_list.extend(target_path)\n        actions_list.append(USE_ACTION)\n\n    return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:17:42.175628", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable entities like boundaries, water, or workshops\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:19:01.009040", "function_name": "collect", "function_body": "  # 1. Get primitive ID\n  # Use env.world.cookbook.index to get the integer ID for the primitive string\n  try:\n    primitive_idx = env.world.cookbook.index(primitive)\n  except KeyError:\n    # If primitive is not in the cookbook, it cannot be collected.\n    return []\n\n  # 2. Get current state details\n  _state = env._current_state\n  grid = _state.grid\n  start_pos = _state.pos\n  \n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 3. Get action mappings\n  # Action IDs from env.action_specs()\n  action_map = env.action_specs()\n  \n  # Movement deltas to action IDs\n  move_actions = {\n      (0, -1): action_map['UP'],\n      (0, 1): action_map['DOWN'],\n      (-1, 0): action_map['LEFT'],\n      (1, 0): action_map['RIGHT']\n  }\n  \n  # Directions for iterating neighbors (4-directional movement)\n  directions_deltas = [(0, -1), (0, 1), (-1, 0), (1, 0)] # UP, DOWN, LEFT, RIGHT\n\n  # 4. Define impassable cells\n  # Water and Boundary are typically impassable for movement.\n  impassable_kinds = set()\n  if hasattr(env.world, 'water_index'):\n      impassable_kinds.add(env.world.water_index)\n  if 'BOUNDARY' in env.world.cookbook.contents:\n      impassable_kinds.add(env.world.cookbook.index('BOUNDARY'))\n\n  # BFS Setup\n  queue = collections.deque([(start_pos, [])]) # Queue stores (current_pos, path_actions)\n  visited = {start_pos} # Set of visited (x, y) tuples to prevent cycles and redundant exploration\n\n  target_path = None # Stores the sequence of actions once a path is found\n\n  while queue:\n    current_pos, path = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if current_pos is adjacent to the primitive (goal state for BFS)\n    # The `CraftState.next_to(i_kind)` method checks a 3x3 neighborhood *excluding* the agent's current position.\n    is_adjacent_to_primitive = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n        # Check bounds, ensure it's a neighbor (not self), and contains the primitive\n        if (0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT and \n            (dx_adj != 0 or dy_adj != 0) and \n            grid[nx_adj, ny_adj, primitive_idx] == 1):\n          is_adjacent_to_primitive = True\n          break\n      if is_adjacent_to_primitive:\n        break\n\n    if is_adjacent_to_primitive:\n      # If adjacent, append the USE action and we've found our path\n      target_path = path + [action_map['USE']]\n      break # Path found, exit BFS\n\n    # Explore neighbors (move actions)\n    for dx, dy in directions_deltas:\n      next_pos = (cx + dx, cy + dy)\n      nx, ny = next_pos\n\n      # Check bounds\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Check if cell is traversable (not an impassable obstacle)\n      # A cell is blocked if it contains any of the explicitly defined impassable kinds.\n      is_blocked = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] == 1:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue # Cannot move into this cell\n\n      # If the cell hasn't been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [move_actions[(dx, dy)]]\n        queue.append((next_pos, new_path))\n\n  return target_path if target_path else []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:19:02.008728", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get action mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 2. Get the integer ID of the primitive\n  try:\n    primitive_idx = env.world.cookbook.index(primitive)\n  except KeyError:\n    # Primitive name not found in cookbook (e.g., misspelled, or not registered)\n    return []\n\n  # 3. Get current state details\n  current_state = env._current_state\n  current_grid = current_state.grid\n  agent_x, agent_y = current_state.pos\n  \n  # Get grid dimensions (numpy.ndarray.shape returns (dim0, dim1, ...))\n  grid_width = current_grid.shape[0]\n  grid_height = current_grid.shape[1]\n\n  target_x, target_y = -1, -1\n  min_dist = float('inf')\n\n  # 4. Find the closest instance of the primitive on the grid\n  # Iterate through the grid to find all locations of the primitive\n  # and then determine the one closest to the agent's current position.\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if the primitive_idx is present at this (x, y) location.\n          # We assume grid[x, y, k] > 0 means kind k is present at (x, y).\n          if current_grid[x, y, primitive_idx] > 0:\n              dist = abs(x - agent_x) + abs(y - agent_y) # Manhattan distance\n              if dist < min_dist:\n                  min_dist = dist\n                  target_x, target_y = x, y\n  \n  # 5. If the primitive is not found anywhere on the grid, return an empty list.\n  if target_x == -1:\n      return []\n\n  # 6. Generate movement actions to reach the target's cell.\n  # This simple path generation strategy moves horizontally first, then vertically.\n  # It does not account for obstacles (e.g., walls), but assumes direct movement is possible.\n  \n  # Set a reasonable limit on the number of actions to prevent excessively long sequences,\n  # which might occur if a target is unreachable due to obstacles or very far.\n  # For a grid of WxH, the max Manhattan distance is (W-1) + (H-1).\n  MAX_ACTIONS_PATH = (grid_width + grid_height) * 2 \n  \n  # Move in X-direction\n  while agent_x != target_x:\n      if agent_x < target_x:\n          actions.append(RIGHT)\n          agent_x += 1\n      else: # agent_x > target_x\n          actions.append(LEFT)\n          agent_x -= 1\n      if len(actions) > MAX_ACTIONS_PATH:\n          return [] # Path too long, potentially unreachable\n\n  # Move in Y-direction\n  while agent_y != target_y:\n      if agent_y < target_y:\n          actions.append(DOWN)\n          agent_y += 1\n      else: # agent_y > target_y\n          actions.append(UP)\n          agent_y -= 1\n      if len(actions) > MAX_ACTIONS_PATH:\n          return [] # Path too long, potentially unreachable\n\n  # 7. Once the agent's simulated position (agent_x, agent_y) has reached the target cell,\n  # append the USE action to interact with/collect the primitive.\n  actions.append(USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:20:31.815419", "function_name": "collect", "function_body": "  obs = env.observations()\n  grid = obs['features_dict']['features_global']\n  \n  # Agent's current position (r, c)\n  # Convert to tuple for hashability in the visited set\n  agent_pos = tuple(obs['features_dict']['pos']) \n  \n  # Agent's current direction (int: 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT)\n  # `direction` in features_dict is a one-hot array, convert to int\n  agent_dir_int = np.argmax(obs['features_dict']['direction']) \n\n  # Get grid dimensions\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Get the integer ID for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index(primitive)\n  \n  # If the primitive name is not recognized or maps to index 0 (invalid/not found)\n  # Check if primitive_idx is 0 and it's not actually the item mapped to 0 (e.g., \"*invalid*\")\n  if primitive_idx == 0 and primitive != env.world.cookbook.get(0): \n      return [] # Primitive not recognized or invalid index\n\n  # Map action names to their integer IDs from the environment\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement actions and their corresponding (dr, dc) deltas.\n  # These deltas represent the change in (row, col) for each movement action.\n  MOVE_DELTAS = {\n      UP_ACTION: (-1, 0),\n      DOWN_ACTION: (1, 0),\n      LEFT_ACTION: (0, -1),\n      RIGHT_ACTION: (0, 1)\n  }\n\n  # Map (dr, dc) deltas to agent's internal direction integer (0-3).\n  # This mapping is crucial because `CraftState.step` updates `dir` based on the move,\n  # setting `dir` to the direction of the executed movement.\n  DIR_DELTA_TO_AGENT_DIR_INT = {\n      (-1, 0): 0, # UP\n      (1, 0): 1,  # DOWN\n      (0, -1): 2, # LEFT\n      (0, 1): 3   # RIGHT\n  }\n  \n  # Find all grid locations where the primitive exists\n  primitive_locations = set()\n  for r in range(HEIGHT):\n    for c in range(WIDTH):\n      # `grid[r, c, primitive_idx]` will be 1 if the primitive is at (r, c), else 0.\n      if grid[r, c, primitive_idx] > 0: \n        primitive_locations.add((r, c))\n\n  if not primitive_locations:\n    # The primitive is not present anywhere on the map\n    return [] \n\n  # BFS for shortest path (considering both position and agent's facing direction)\n  # State for BFS: (current_pos (r,c), current_direction (int), path_actions (list of ints))\n  q = collections.deque([(agent_pos, agent_dir_int, [])])\n  # Visited states: (position (r,c), direction (int)) to avoid revisiting redundant states\n  visited = {(agent_pos, agent_dir_int)}\n\n  final_actions = [] # Stores the resulting list of actions\n\n  while q:\n    curr_pos, curr_dir, path = q.popleft()\n\n    # Determine the cell directly in front of the agent based on its current position and direction.\n    facing_delta = (0,0) # Initialize in case curr_dir is invalid, though it shouldn't be\n    for delta_tuple, d_int in DIR_DELTA_TO_AGENT_DIR_INT.items():\n        if d_int == curr_dir:\n            facing_delta = delta_tuple\n            break\n    \n    target_cell_in_front = (curr_pos[0] + facing_delta[0], curr_pos[1] + facing_delta[1])\n\n    # If the cell directly in front of the agent contains the primitive,\n    # then we have found a valid state from which to 'USE' and collect the primitive.\n    if target_cell_in_front in primitive_locations:\n      final_actions = path + [USE_ACTION]\n      return final_actions # Found the shortest path to collect\n\n    # Explore all possible movement actions from the current position\n    for move_action, (dr, dc) in MOVE_DELTAS.items():\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      # Check if the next position is within grid boundaries.\n      # Assumption: All cells within boundaries are traversable by the agent.\n      # The `env.step` method is responsible for handling actual collisions or impassable terrain.\n      if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n        continue # Cannot move out of bounds\n\n      # The agent's direction will be updated to the direction of the executed move.\n      next_dir = DIR_DELTA_TO_AGENT_DIR_INT[(dr, dc)]\n      \n      # If this (position, direction) state has not been visited before, add it to queue.\n      if (next_pos, next_dir) not in visited:\n        visited.add((next_pos, next_dir))\n        q.append((next_pos, next_dir, path + [move_action]))\n\n  # If the queue becomes empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:20:32.838855", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get the integer ID of the primitive\n  try:\n      primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n      # Primitive name not found in cookbook, cannot collect.\n      return []\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the ID for 'BOUNDARY' to avoid moving into it\n  # Assuming 'BOUNDARY' is always in the cookbook index\n  boundary_id = env.world.cookbook.index[\"BOUNDARY\"]\n\n  # 2. Find all locations of the primitive on the grid\n  primitive_locs = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          if grid[r, c, primitive_id] > 0:\n              primitive_locs.append((r, c))\n\n  if not primitive_locs:\n      # Primitive not found anywhere on the grid\n      return []\n\n  # 3. Determine target cells (cells adjacent to any primitive location)\n  target_cells = set()\n  for pr, pc in primitive_locs:\n      # Check 4 cardinal neighbors\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          adj_r, adj_c = pr + dr, pc + dc\n          # Ensure neighbor is within bounds and not a boundary\n          if (0 <= adj_r < WIDTH and \n              0 <= adj_c < HEIGHT and \n              grid[adj_r, adj_c, boundary_id] == 0): # Assuming 0 means no boundary\n              target_cells.add((adj_r, adj_c))\n\n  if not target_cells:\n      # No reachable adjacent cells to any primitive found (e.g., primitive is surrounded by boundaries)\n      return []\n\n  # 4. Perform BFS to find the shortest path to any target_cell\n  queue = collections.deque([(start_pos, [])]) # (current_pos, path_of_actions)\n  visited = {start_pos}\n\n  # Define possible movements and their corresponding actions\n  # (dr, dc, action_value) for UP, DOWN, LEFT, RIGHT\n  # action_specs: DOWN->0, UP->1, LEFT->2, RIGHT->3\n  move_actions_map = {\n      (-1, 0): env.action_specs['UP'],    # Move UP (row decreases)\n      (1, 0): env.action_specs['DOWN'],   # Move DOWN (row increases)\n      (0, -1): env.action_specs['LEFT'],  # Move LEFT (col decreases)\n      (0, 1): env.action_specs['RIGHT']   # Move RIGHT (col increases)\n  }\n\n  path_to_primitive_adj_cell = []\n\n  while queue:\n      current_pos, path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # If current position is one of the target cells, we found our path\n      if current_pos in target_cells:\n          path_to_primitive_adj_cell = path_so_far\n          break\n\n      # Explore neighbors\n      for (dr, dc), action_val in move_actions_map.items():\n          nr, nc = r + dr, c + dc\n          next_pos = (nr, nc)\n\n          # Check if valid move: within bounds, not visited, and not a boundary\n          if (0 <= nr < WIDTH and 0 <= nc < HEIGHT and\n              next_pos not in visited and\n              grid[nr, nc, boundary_id] == 0):\n              \n              visited.add(next_pos)\n              new_path = path_so_far + [action_val]\n              queue.append((next_pos, new_path))\n  \n  if path_to_primitive_adj_cell:\n      # Found a path to a cell adjacent to the primitive, now add the USE action\n      actions = path_to_primitive_adj_cell + [env.action_specs['USE']]\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:21:30.265840", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are entities the agent cannot walk *onto*.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable entities (like boundaries, water, or workshops)\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n          # This specifically handles cases where the primitive itself might be a non-walkable terrain type (e.g., WATER, STONE).\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:21:31.280438", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_agent_pos = current_state.pos  # Agent's initial position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve integer action IDs from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ITEM = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction\n  # (dr, dc) indicates how row and column change when moving \"forward\" in a specific direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are entities the agent cannot walk onto.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacent = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_cell_row < num_rows and 0 <= front_cell_col < num_cols):\n          # Check if the primitive is present in this front cell\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacent = path_taken\n              break # Path to adjacency found, no need to explore further from this branch\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid and has not been visited with this orientation\n      if (0 <= next_row < num_rows and 0 <= next_col < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # It's not walkable if it contains any non-grabbable entity (boundary, water, workshop, etc.)\n          # or if it contains the primitive itself (as we need to be adjacent to 'use' it).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          if initial_grid[next_row, next_col, primitive_id] > 0: # Cannot walk onto the primitive itself\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT]))\n\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ITEM)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:22:33.511441", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function uses a Breadth-First Search (BFS) to find the shortest sequence of actions\n    that leads the agent to a position adjacent to the specified primitive, facing it,\n    and then appends a 'USE' action to collect it.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs to execute, or an empty list if the primitive\n                   is unreachable or cannot be collected.\n  \"\"\"\n  actions_list = []\n\n  # Get the current state of the environment from the CraftLab wrapper\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid layout at the beginning of the search\n  initial_agent_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_agent_dir = current_state.dir # Agent's starting direction (int: 0-RIGHT, 1-UP, 2-LEFT, 3-DOWN)\n\n  # Get the integer ID for the target primitive from the world's cookbook index.\n  # This ID is crucial for checking the presence of the primitive in grid cells.\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None:\n      # If the primitive name is not recognized, it cannot be collected.\n      return [] \n\n  # Retrieve grid dimensions (number of rows, number of columns)\n  NUM_ROWS, NUM_COLS, _ = initial_grid.shape\n\n  # Map human-readable action names to their integer IDs provided by the environment's action_specs.\n  # These mappings are used to translate symbolic actions into numerical actions for `env.step()`.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Commonly interpreted as \"move forward in current direction\"\n  TURN_LEFT_ACTION = action_map['LEFT']     # Turn 90 degrees counter-clockwise\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Turn 90 degrees clockwise\n  USE_ACTION = action_map['USE']            # Interact with the cell directly in front of the agent\n\n  # Define direction vectors (delta_row, delta_column) for agent movement.\n  # This mapping helps calculate the next position when the agent moves \"forward\"\n  # based on its current facing direction.\n  # Directions: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moving forward increases column index\n      1: (-1, 0),  # Facing UP:    moving forward decreases row index\n      2: (0, -1),  # Facing LEFT:  moving forward decreases column index\n      3: (1, 0)    # Facing DOWN:  moving forward increases row index\n  }\n\n  # Define how the agent's direction changes when performing a turn action.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycle: RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Cycle: RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that are considered \"non-grabbable\" and typically block agent movement.\n  # The agent cannot move into a cell occupied by these kinds (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples representing a state and the path to reach it:\n  # ( (current_row, current_col, current_direction), [actions_taken_to_reach_this_state] )\n  queue = collections.deque([((initial_agent_pos[0], initial_agent_pos[1], initial_agent_dir), [])])\n\n  # The 'visited' set keeps track of (row, col, direction) tuples to prevent revisiting states\n  # and to ensure the shortest path is found by avoiding cycles.\n  visited = set([(initial_agent_pos[0], initial_agent_pos[1], initial_agent_dir)])\n\n  # This variable will store the final sequence of actions leading to the primitive being in front.\n  path_to_primitive_adjacent = None \n\n  while queue:\n      (r, c, current_dir), path_actions = queue.popleft()\n\n      # 1. Check for Goal Condition: Is the primitive directly in front of the agent in the current state?\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_r, front_cell_c = r + front_dr, c + front_dc\n      \n      # Ensure the calculated front cell is within grid boundaries.\n      if (0 <= front_cell_r < NUM_ROWS and 0 <= front_cell_c < NUM_COLS):\n          # Check if the primitive is present in this front cell (occupancy > 0).\n          if initial_grid[front_cell_r, front_cell_c, primitive_id] > 0:\n              path_to_primitive_adjacent = path_actions\n              break # Goal found! Exit the BFS loop as the shortest path is guaranteed.\n\n      # 2. Explore Possible Next Actions from the Current State: Move Forward, Turn Left, Turn Right\n      \n      # --- Try Move Forward Action ---\n      # Calculate the next position if the agent moves forward.\n      next_r_move, next_c_move = r + DIR_TO_DRDC[current_dir][0], c + DIR_TO_DRDC[current_dir][1]\n      next_dir_move = current_dir # Moving forward does not change the agent's facing direction.\n      next_state_move = (next_r_move, next_c_move, next_dir_move)\n\n      # Check if the potential next position is within grid bounds AND\n      # if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_r_move < NUM_ROWS and 0 <= next_c_move < NUM_COLS and\n          next_state_move not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is NOT walkable if it contains any \"non-grabbable\" entity (e.g., boundary, water).\n          # It is also NOT walkable if it contains the primitive itself, because the agent needs to be\n          # adjacent to the primitive to 'USE' it, not on top of it.\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Explicitly check if the cell contains the target primitive\n          if initial_grid[next_r_move, next_c_move, primitive_id] > 0:\n              is_walkable = False \n\n          if is_walkable:\n              # Add the new, valid state to the visited set and the queue for further exploration.\n              visited.add(next_state_move)\n              queue.append((next_state_move, path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      next_state_turn_left = (r, c, next_dir_left) # Turning only changes direction, not position.\n      if next_state_turn_left not in visited:\n          visited.add(next_state_turn_left)\n          queue.append((next_state_turn_left, path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      next_state_turn_right = (r, c, next_dir_right) # Turning only changes direction, not position.\n      if next_state_turn_right not in visited:\n          visited.add(next_state_turn_right)\n          queue.append((next_state_turn_right, path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS loop, if a path to an adjacent and facing position was found,\n  # append the 'USE' action to complete the collection task.\n  if path_to_primitive_adjacent is not None:\n      actions_list.extend(path_to_primitive_adjacent)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:22:34.524521", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This function uses a Breadth-First Search (BFS) to find the shortest sequence of\n    movement actions to reach a position adjacent to the specified primitive,\n    followed by a 'USE' action to collect it.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action indices to execute. An empty list\n                   is returned if the primitive is unreachable or not found on the grid.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Access the underlying CraftState for detailed info\n\n  initial_grid = current_state.grid # (rows, columns, kinds) numpy array\n  initial_agent_pos = current_state.pos  # Agent's starting position (row, col)\n  initial_agent_dir = current_state.dir  # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  # This maps string names (e.g., \"WOOD\") to their integer representations.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions for boundary checks\n  grid_rows, grid_cols, _ = initial_grid.shape # Correctly parse shape as (rows, columns, ...)\n\n  # Retrieve integer action IDs from the environment's action specifications\n  # These are the numeric codes for actions like moving forward, turning, and using.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell directly in front\n\n  # Direction vectors (dr, dc) for agent's facing direction.\n  # These define how row and column coordinates change when moving \"forward\".\n  # Mapping: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 for left turns.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # The agent cannot walk onto cells containing these kinds.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS Initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  # A state includes both position and orientation because actions (like 'USE') depend on direction,\n  # and possible next positions depend on current direction.\n  queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The visited set stores (position_tuple, direction_int) to avoid redundant computations, cycles,\n  # and ensure finding the shortest path (BFS guarantees this for unweighted graphs).\n  visited = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the sequence of actions to reach the state where the primitive is in front.\n  path_to_primitive_adjacency = None \n\n  while queue:\n      (current_pos, current_dir), path_taken = queue.popleft()\n      current_row, current_col = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If it is, we've found our target \"adjacency\" state for collection.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_cell_row, front_cell_col = current_row + front_dr, current_col + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_cell_row < grid_rows and 0 <= front_cell_col < grid_cols):\n          # Check if the primitive is present in this front cell.\n          if initial_grid[front_cell_row, front_cell_col, primitive_id] > 0:\n              path_to_primitive_adjacency = path_taken\n              break # Target state found, stop BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      # These actions change the agent's state (position and/or direction).\n\n      # Try Move Forward action:\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_row, next_col = current_row + move_dr, current_col + move_dc\n      next_pos = (next_row, next_col)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the potential next position is valid (within grid bounds)\n      # and if this specific (position, direction) state has not been visited yet.\n      if (0 <= next_row < grid_rows and 0 <= next_col < grid_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # A cell is not walkable if it contains any non-grabbable entity (like a wall, water, workshop),\n          # or if it contains the primitive itself (agent must be adjacent to 'use', not on top).\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_row, next_col, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive it wants to collect.\n          if initial_grid[next_row, next_col, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir)) # Mark new state as visited\n              # Add to queue with the updated path, including the MOVE_FORWARD_ACTION.\n              queue.append(((next_pos, next_dir), path_taken + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir] # Calculate new direction after turning left\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_LEFT_ACTION.\n          queue.append(((current_pos, next_dir_left), path_taken + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir] # Calculate new direction after turning right\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark new state as visited\n          # Add to queue with updated path, including the TURN_RIGHT_ACTION.\n          queue.append(((current_pos, next_dir_right), path_taken + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes (either target found or queue empty):\n  # If a path to the target adjacency state was found, append the USE action to complete the collection.\n  if path_to_primitive_adjacency is not None:\n      actions_list.extend(path_to_primitive_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:23:15.855352", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Validate the primitive and retrieve its index from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in the cookbook index, cannot collect.\n    return []\n\n  # The 'collect' DSL keyword is intended for grabbable items (resources that go into inventory).\n  # Non-grabbable entities like workshops (for crafting), water, or boundaries cannot be 'collected'.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get essential state information for pathfinding and interaction.\n  current_state = env._current_state\n  current_agent_pos = current_state.pos  # Agent's current (row, col) position\n  grid = current_state.grid              # The current grid layout (occupancy map)\n  grid_height, grid_width, _ = grid.shape # Dimensions of the grid\n\n  # Define action constants and movement directions for clarity and consistency.\n  # These map (delta_row, delta_col) to the corresponding action index defined in craft.py.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  # List of cardinal direction vectors for iterating through neighbors in BFS.\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  \n  # Offsets for a 3x3 neighborhood around a cell, including the center (0,0).\n  # This is used to define valid standing positions ('collectible spots') relative to a primitive.\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Helper function to check if a given grid cell (r, c) is traversable by the agent.\n  def is_traversable(r: int, c: int) -> bool:\n    \"\"\"Checks if the cell at (r, c) is within grid bounds and free of blocking entities.\"\"\"\n    # Ensure coordinates are within the grid boundaries.\n    if not (0 <= r < grid_height and 0 <= c < grid_width):\n      return False\n\n    # Water is explicitly a non-traversable entity.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Check for other non-grabbable entities that block movement.\n    # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are typically non-grabbable but traversable.\n    # Other non-grabbable items (like implicit boundary walls) are blocking.\n    for k_idx in env.world.non_grabbable_indices:\n      # If the non-grabbable item is not a workshop and not water, and it's present at the cell, it's blocking.\n      if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n        if grid[r, c, k_idx] == 1:\n          return False # Found a blocking, non-grabbable obstacle.\n    return True # Cell is within bounds and free of blocking obstacles, thus traversable.\n\n  # 2. Immediate Collection Check:\n  # If the agent is already positioned to collect the primitive (i.e., it's \"next to\" it),\n  # only a 'USE' action is needed. This is an important optimization to avoid pathfinding.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Locate all instances of the target primitive on the grid.\n  # `np.where` efficiently returns the row and column indices where the primitive's layer is active (value 1).\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  primitive_locations_on_grid = list(zip(primitive_rows, primitive_cols))\n\n  if not primitive_locations_on_grid:\n    # The primitive does not exist anywhere on the current map, so it cannot be collected.\n    return []\n\n  # 4. Identify all \"collectible spots\".\n  # A collectible spot is any traversable grid cell from which the agent can be\n  # 'next to' at least one instance of the target primitive. This means the spot\n  # must be within a 3x3 neighborhood of a primitive, and the agent can move there.\n  collectible_spots = set()\n  for pr, pc in primitive_locations_on_grid:\n    # Iterate through all 3x3 offsets relative to the primitive's location.\n    for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n      potential_agent_r, potential_agent_c = pr + dr, pc + dc\n      \n      # If this potential standing position is traversable, it's a valid collectible spot.\n      if is_traversable(potential_agent_r, potential_agent_c):\n        collectible_spots.add((potential_agent_r, potential_agent_c))\n\n  if not collectible_spots:\n    # No reachable (traversable) spots identified from which the agent can collect the primitive.\n    # This might happen if all primitives are surrounded by non-traversable terrain.\n    return []\n\n  # 5. Breadth-First Search (BFS) to find the shortest path to any collectible spot.\n  # BFS guarantees finding the shortest path in terms of number of steps on an unweighted grid.\n  \n  # The queue for BFS stores tuples: (current_position_tuple, list_of_actions_to_reach_here).\n  q = collections.deque([(current_agent_pos, [])])\n  # Set to keep track of visited grid cells to prevent infinite loops and redundant explorations.\n  visited_cells = {current_agent_pos}\n  \n  shortest_path_to_spot = None # This will store the sequence of actions if a path is found.\n\n  while q:\n    (r, c), current_path_actions = q.popleft()\n\n    # If the current position is one of the target collectible spots, we've found the shortest path.\n    if (r, c) in collectible_spots:\n      shortest_path_to_spot = current_path_actions\n      break # Exit BFS; the first path found is guaranteed to be the shortest.\n\n    # Explore all four cardinal neighbors (Up, Down, Left, Right).\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      # Only enqueue a new cell if it hasn't been visited yet and is traversable.\n      if (next_r, next_c) not in visited_cells:\n        if is_traversable(next_r, next_c):\n          visited_cells.add((next_r, next_c)) # Mark the cell as visited.\n          # Add the new state to the queue, extending the path with the action taken to reach it.\n          q.append(((next_r, next_c), current_path_actions + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct the final sequence of actions.\n  if shortest_path_to_spot:\n    # First, append all movement actions required to reach the chosen collectible spot.\n    actions.extend(shortest_path_to_spot)\n    # Once at the collectible spot, perform the 'USE' action to pick up the primitive.\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:23:16.846638", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:24:24.164004", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  \n  # If the primitive name is not found in the cookbook's index, it cannot be collected.\n  if primitive_id is None:\n      return []\n\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  \n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = grid.shape \n\n  # Get action mappings from the environment\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  # BFS setup:\n  # Queue stores tuples: ((row, col), [list_of_actions_to_reach_this_pos])\n  q = collections.deque([(current_pos, [])]) \n  # Visited set stores (row, col) tuples to prevent revisiting cells\n  visited = {current_pos}\n\n  # Define possible movements (dr, dc, action_index)\n  # (delta_row, delta_col, corresponding_action to move there)\n  move_deltas = [\n      (1, 0, DOWN),  # Move Down (increase row)\n      (-1, 0, UP),   # Move Up (decrease row)\n      (0, 1, RIGHT), # Move Right (increase col)\n      (0, -1, LEFT)  # Move Left (decrease col)\n  ]\n\n  while q:\n      (r, c), path_actions = q.popleft()\n\n      # If the current cell (r, c) contains the target primitive,\n      # we have found a path to it. The next action is USE to collect.\n      if grid[r, c, primitive_id] > 0:\n          return path_actions + [USE]\n\n      # Explore neighbors\n      for dr, dc, action in move_deltas:\n          nr, nc = r + dr, c + dc # Next row, next col\n          next_pos = (nr, nc)\n\n          # 1. Check if the next position is within grid boundaries\n          if not (0 <= nr < width and 0 <= nc < height):\n              continue\n          \n          # 2. Check for obstacles: A cell is considered an obstacle if it contains\n          #    any non-grabbable environment item (e.g., WATER, WORKSHOP) AND\n          #    that item is NOT the primitive we are trying to collect.\n          is_obstacle = False\n          # Iterate through all \"environment\" (non-grabbable) items defined in the cookbook\n          for env_item_id in env.world.cookbook.environment:\n              # If the next cell contains this environment item...\n              if grid[nr, nc, env_item_id] > 0:\n                  # And this environment item is NOT the primitive we are searching for...\n                  if env_item_id != primitive_id:\n                      is_obstacle = True\n                      break # Found an untraversable obstacle\n          \n          if is_obstacle:\n              continue # Cannot move to this cell because it's an obstacle\n\n          # 3. If the cell is traversable and not yet visited, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path_actions + [action]))\n\n  # If the BFS completes and the primitive was not found anywhere reachable\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:24:25.155675", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n\n  # Get action integer mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Convert primitive string to its integer index using the cookbook\n  primitive_idx = env.world.cookbook.index(primitive)\n\n  # Get grid dimensions (assuming grid is WIDTH x HEIGHT x N_KINDS)\n  width, height, _ = grid.shape\n\n  # 2. Find all locations of the primitive on the grid\n  # np.where returns (row_indices, col_indices) for a 2D array.\n  # If grid is (width, height, n_kinds), then grid[:, :, primitive_idx] is (width, height).\n  # So, `y_indices` (rows) correspond to the height dimension, `x_indices` (cols) to the width dimension.\n  primitive_grid_cols, primitive_grid_rows = np.where(grid[:, :, primitive_idx] == 1)\n  \n  target_positions = set() # Use a set for efficient lookup\n  for i in range(len(primitive_grid_rows)):\n      # Store as (x, y) coordinates\n      target_positions.add((primitive_grid_cols[i], primitive_grid_rows[i]))\n  \n  if not target_positions:\n      # Primitive not found on the grid\n      return []\n\n  # If the primitive is already at the current position and it's grabbable,\n  # immediately return a USE action.\n  if start_pos in target_positions and primitive_idx in env.world.grabbable_indices:\n      return [USE]\n\n  # BFS setup\n  queue = collections.deque([(start_pos, [])]) # (current_pos, path_of_actions_to_reach_here)\n  visited = {start_pos} # Set of visited positions (x, y)\n\n  # Define movement deltas and their corresponding actions\n  # (dx, dy, action_id)\n  possible_moves = [\n      (0, -1, UP),    # UP: (x, y-1)\n      (0, 1, DOWN),   # DOWN: (x, y+1)\n      (-1, 0, LEFT),  # LEFT: (x-1, y)\n      (1, 0, RIGHT)   # RIGHT: (x+1, y)\n  ]\n\n  while queue:\n      current_pos, path_actions = queue.popleft()\n      x, y = current_pos\n\n      for dx, dy, action_id in possible_moves:\n          next_x, next_y = x + dx, y + dy\n          next_pos = (next_x, next_y)\n\n          # Check boundaries\n          if not (0 <= next_x < width and 0 <= next_y < height):\n              continue\n\n          # Check if visited\n          if next_pos in visited:\n              continue\n          \n          # If the next_pos contains the primitive, we found the shortest path to it.\n          if next_pos in target_positions:\n              final_actions = path_actions + [action_id]\n              # If the item is grabbable, add a USE action after moving to its location\n              if primitive_idx in env.world.grabbable_indices:\n                  final_actions.append(USE)\n              return final_actions # Return the path immediately\n\n          # If not a target, add to queue and visited set for further exploration\n          visited.add(next_pos)\n          queue.append((next_pos, path_actions + [action_id]))\n\n  # If the BFS completes and no path to the primitive was found (e.g., unreachable)\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:25:39.253738", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version allows the agent to path through cells containing the target primitive,\n  if that primitive is a 'grabbable' item (e.g., WOOD, STONE), instead of treating it as an obstacle.\n  The agent must still end up in a position *adjacent* to the primitive to collect it.\n  \"\"\"\n  actions_sequence = [] # The list to accumulate the sequence of actions to be returned.\n\n  # Retrieve the current state of the environment. This object holds the\n  # dynamic aspects of the simulation like the grid, agent's pose, and inventory.\n  current_craft_state = env._current_state\n\n  # Store the initial conditions of the grid and agent for BFS.\n  # The grid is treated as static during the pathfinding phase of BFS.\n  initial_grid = current_craft_state.grid\n  initial_agent_pos = current_craft_state.pos # (row, col) tuple\n  initial_agent_dir = current_craft_state.dir # Integer (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Map the primitive string name to its unique integer ID, as used in the grid.\n  primitive_id = current_craft_state.world.cookbook.index[primitive]\n\n  # Get the dimensions of the grid for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This makes the action selection more robust to potential changes in action ID values.\n  action_name_to_id = env.action_specs()\n  ACTION_MOVE_FORWARD = action_name_to_id['UP']    # DSL 'UP' means move forward in current direction\n  ACTION_TURN_LEFT = action_name_to_id['LEFT']\n  ACTION_TURN_RIGHT = action_name_to_id['RIGHT']\n  ACTION_USE = action_name_to_id['USE']            # Action to collect/interact with items\n\n  # Define how agent's (row, column) coordinates change when moving forward\n  # for each of the four possible facing directions.\n  # Direction (key) -> (delta_row, delta_column)\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT (0): (r, c+1)\n      1: (-1, 0),  # Facing UP (1): (r-1, c)\n      2: (0, -1),  # Facing LEFT (2): (r, c-1)\n      3: (1, 0)    # Facing DOWN (3): (r+1, c)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # Current Direction (key) -> New Direction (value)\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # --- V2 Improvement: Obstacle Definition ---\n  # In `collect_v1`, the target primitive itself was added to `blocking_entity_ids`\n  # if it was grabbable, meaning the agent could not path *onto* its cell.\n  # For `collect_v2`, we implement the improvement:\n  # Only non-grabbable items (e.g., boundaries, water, workshops) are considered obstacles.\n  # Grabbable items, including the target primitive, are now considered traversable.\n  blocking_entity_ids = set(current_craft_state.world.non_grabbable_indices)\n  # The line `if primitive_id in current_craft_state.world.grabbable_indices: blocking_entity_ids.add(primitive_id)`\n  # is intentionally *omitted* from this version.\n  \n  # --- Early Exit Optimization ---\n  # Check if the primitive is already within the agent's immediate 3x3 neighborhood.\n  # If so, a single 'USE' action is sufficient.\n  if current_craft_state.next_to(primitive_id):\n      return [ACTION_USE]\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples:\n  #   ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state)\n  # This allows us to track both spatial location and orientation of the agent.\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set stores (position, direction) pairs that have already been\n  # explored. This prevents cycles and ensures the shortest path is found by\n  # avoiding redundant processing of states.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  shortest_path_to_collectible_state = None # To store the path when a goal is found.\n\n  # --- Main BFS Loop ---\n  while bfs_queue:\n      # Dequeue the current agent state and the sequence of actions that led to it.\n      (current_pos, current_dir), actions_taken_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Goal Check: Is the agent currently in a position to collect the primitive? ---\n      # This means the primitive must be present in any cell within the 3x3 square\n      # centered on the agent's current (r, c) position, on the initial grid.\n      is_collectible_from_current_pos = False\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              check_r, check_c = current_r + dr_offset, current_c + dc_offset\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT):\n                  # Check if the primitive exists at this potential collection point.\n                  if initial_grid[check_r, check_c, primitive_id] > 0:\n                      is_collectible_from_current_pos = True\n                      break # Found the primitive in the neighborhood, no need to check further cells.\n          if is_collectible_from_current_pos:\n              break # Break outer loop too if found.\n\n      if is_collectible_from_current_pos:\n          # We have found the shortest path to a state where the agent is adjacent\n          # to the primitive. This path consists of movement and turn actions.\n          shortest_path_to_collectible_state = actions_taken_so_far\n          break # Goal reached, terminate BFS.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n\n      # 1. Try ACTION_MOVE_FORWARD:\n      delta_r_move, delta_c_move = DIR_TO_DELTA_RC[current_dir]\n      next_r_after_move, next_c_after_move = current_r + delta_r_move, current_c + delta_c_move\n      next_pos_after_move = (next_r_after_move, next_c_after_move)\n      next_dir_after_move = current_dir # Direction doesn't change when moving forward.\n\n      # Check if the new position is within grid bounds and if this (pos, dir) state hasn't been visited.\n      if (0 <= next_r_after_move < GRID_WIDTH and 0 <= next_c_after_move < GRID_HEIGHT and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          # Check if the cell at `next_pos_after_move` is walkable (i.e., not an obstacle).\n          is_walkable_path = True\n          for obstacle_id in blocking_entity_ids:\n              if initial_grid[next_r_after_move, next_c_after_move, obstacle_id] > 0:\n                  is_walkable_path = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable_path:\n              visited_states.add((next_pos_after_move, next_dir_after_move)) # Mark new state as visited.\n              # Add the new state and its path to the BFS queue.\n              bfs_queue.append((\n                  (next_pos_after_move, next_dir_after_move),\n                  actions_taken_so_far + [ACTION_MOVE_FORWARD]\n              ))\n\n      # 2. Try ACTION_TURN_LEFT:\n      next_dir_after_left_turn = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_after_left_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_left_turn))\n          bfs_queue.append((\n              (current_pos, next_dir_after_left_turn),\n              actions_taken_so_far + [ACTION_TURN_LEFT]\n          ))\n\n      # 3. Try ACTION_TURN_RIGHT:\n      next_dir_after_right_turn = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_after_right_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_right_turn))\n          bfs_queue.append((\n              (current_pos, next_dir_after_right_turn),\n              actions_taken_so_far + [ACTION_TURN_RIGHT]\n          ))\n\n  # --- Final Action Sequence Assembly ---\n  # If a path was successfully found (i.e., the primitive is reachable),\n  # append the final 'USE' action to the movement sequence.\n  if shortest_path_to_collectible_state is not None:\n      actions_sequence.extend(shortest_path_to_collectible_state)\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:25:40.264003", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by allowing the agent to walk over grabbable primitive items.\n\n  This function employs a Breadth-First Search (BFS) to find the shortest\n  sequence of movements and turns for the agent to reach a position adjacent\n  to (or on top of) the target primitive. Once adjacent, a 'USE' action is\n  appended to the path to simulate collection. The search considers grid\n  boundaries and non-grabbable obstacles (e.g., water, workshops, boundaries),\n  but specifically *allows* the agent to walk over cells containing grabbable\n  primitive items (e.g., wood, stone, iron). This change enables more direct\n  paths where such primitives might otherwise block passage.\n\n  Args:\n      env (env.CraftLab): The current CraftLab environment instance.\n      primitive (str): The string name of the primitive item to be collected.\n\n  Returns:\n      List[int]: A list of integer action codes that lead the agent to collect\n                 the specified primitive. Returns an empty list if the primitive\n                 is not found or is unreachable.\n  \"\"\"\n  actions_sequence = []\n\n  # Retrieve the current state of the environment. This object holds the\n  # dynamic aspects of the simulation like the grid, agent's pose, and inventory.\n  current_craft_state = env._current_state\n\n  # Store the initial conditions of the grid and agent for BFS.\n  # The grid is treated as static during the pathfinding phase of BFS.\n  initial_grid = current_craft_state.grid\n  initial_agent_pos = current_craft_state.pos # (row, col) tuple\n  initial_agent_dir = current_craft_state.dir # Integer (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Map the primitive string name to its unique integer ID, as used in the grid.\n  primitive_id = current_craft_state.world.cookbook.index[primitive]\n\n  # Get the dimensions of the grid for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Retrieve the mapping from action names (strings) to their integer codes.\n  # This makes the action selection more robust to potential changes in action ID values.\n  action_name_to_id = env.action_specs()\n  ACTION_MOVE_FORWARD = action_name_to_id['UP']    # DSL 'UP' means move forward in current direction\n  ACTION_TURN_LEFT = action_name_to_id['LEFT']\n  ACTION_TURN_RIGHT = action_name_to_id['RIGHT']\n  ACTION_USE = action_name_to_id['USE']            # Action to collect/interact with items\n\n  # Define how agent's (row, column) coordinates change when moving forward\n  # for each of the four possible facing directions.\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # Facing RIGHT (0): (r, c+1)\n      1: (-1, 0),  # Facing UP (1): (r-1, c)\n      2: (0, -1),  # Facing LEFT (2): (r, c-1)\n      3: (1, 0)    # Facing DOWN (3): (r+1, c)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify entity kinds that block agent movement.\n  # In collect_v1, grabbable primitive_id was also added to this set if applicable.\n  # For collect_v2, we explicitly only consider non-grabbable entities as blocking.\n  # This allows the agent to walk over cells containing grabbable primitives (e.g., WOOD, STONE),\n  # which can lead to shorter paths.\n  blocking_entity_ids = set(current_craft_state.world.non_grabbable_indices)\n  \n  # --- Early Exit Optimization ---\n  # Check if the primitive is already within the agent's immediate 3x3 neighborhood.\n  # If so, a single 'USE' action is sufficient.\n  if current_craft_state.next_to(primitive_id):\n      return [ACTION_USE]\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples:\n  #   ((agent_position_tuple, agent_direction_int), list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The 'visited' set stores (position, direction) pairs to prevent cycles and\n  # ensure the shortest path is found.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  shortest_path_to_collectible_state = None # To store the path when a goal is found.\n\n  # --- Main BFS Loop ---\n  while bfs_queue:\n      # Dequeue the current agent state and the sequence of actions that led to it.\n      (current_pos, current_dir), actions_taken_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # --- Goal Check: Is the agent currently in a position to collect the primitive? ---\n      # This means the primitive must be present in any cell within the 3x3 square\n      # centered on the agent's current (r, c) position, on the initial grid.\n      is_collectible_from_current_pos = False\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              check_r, check_c = current_r + dr_offset, current_c + dc_offset\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < GRID_WIDTH and 0 <= check_c < GRID_HEIGHT):\n                  # Check if the primitive exists at this potential collection point.\n                  if initial_grid[check_r, check_c, primitive_id] > 0:\n                      is_collectible_from_current_pos = True\n                      break # Found the primitive in the neighborhood, no need to check further cells.\n          if is_collectible_from_current_pos:\n              break # Break outer loop too if found.\n\n      if is_collectible_from_current_pos:\n          # We have found the shortest path to a state where the agent is adjacent\n          # to (or on) the primitive. This path consists of movement and turn actions.\n          shortest_path_to_collectible_state = actions_taken_so_far\n          break # Goal reached, terminate BFS.\n\n      # --- Explore Possible Next Actions (Move Forward, Turn Left, Turn Right) ---\n\n      # 1. Try ACTION_MOVE_FORWARD:\n      delta_r_move, delta_c_move = DIR_TO_DELTA_RC[current_dir]\n      next_r_after_move, next_c_after_move = current_r + delta_r_move, current_c + delta_c_move\n      next_pos_after_move = (next_r_after_move, next_c_after_move)\n      next_dir_after_move = current_dir # Direction doesn't change when moving forward.\n\n      # Check if the new position is within grid bounds and if this (pos, dir) state hasn't been visited.\n      if (0 <= next_r_after_move < GRID_WIDTH and 0 <= next_c_after_move < GRID_HEIGHT and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          # Check if the cell at `next_pos_after_move` is walkable (i.e., not an obstacle).\n          # A cell is walkable if it does not contain any entity from blocking_entity_ids.\n          is_walkable_path = True\n          for obstacle_id in blocking_entity_ids:\n              if initial_grid[next_r_after_move, next_c_after_move, obstacle_id] > 0:\n                  is_walkable_path = False\n                  break # This cell contains an obstacle, so it's not walkable.\n\n          if is_walkable_path:\n              visited_states.add((next_pos_after_move, next_dir_after_move)) # Mark new state as visited.\n              # Add the new state and its path to the BFS queue.\n              bfs_queue.append((\n                  (next_pos_after_move, next_dir_after_move),\n                  actions_taken_so_far + [ACTION_MOVE_FORWARD]\n              ))\n\n      # 2. Try ACTION_TURN_LEFT:\n      next_dir_after_left_turn = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_after_left_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_left_turn))\n          bfs_queue.append((\n              (current_pos, next_dir_after_left_turn),\n              actions_taken_so_far + [ACTION_TURN_LEFT]\n          ))\n\n      # 3. Try ACTION_TURN_RIGHT:\n      next_dir_after_right_turn = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_after_right_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_right_turn))\n          bfs_queue.append((\n              (current_pos, next_dir_after_right_turn),\n              actions_taken_so_far + [ACTION_TURN_RIGHT]\n          ))\n\n  # --- Final Action Sequence Assembly ---\n  # If a path was successfully found (i.e., the primitive is reachable),\n  # append the final 'USE' action to the movement sequence.\n  if shortest_path_to_collectible_state is not None:\n      actions_sequence.extend(shortest_path_to_collectible_state)\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:26:12.612510", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid layout at the start of the collection task\n  initial_pos = current_state.pos   # Agent's starting position (row, col)\n  initial_dir = current_state.dir   # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive (e.g., 'WOOD' -> 5)\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid dimensions (e.g., 25, 25, n_kinds)\n\n  # Get the integer mappings for specific actions from the environment's action_specs.\n  # 'UP' is typically used for moving forward in the agent's current direction.\n  # 'LEFT' and 'RIGHT' are for turning. 'USE' is for interacting with the cell in front.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes when moving forward based on its current direction.\n  # Direction mapping: (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) -> (dr, dc)\n  # (dr, dc) represents the change in (row, column) coordinates.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases\n      1: (-1, 0),  # Facing UP: row decreases\n      2: (0, -1),  # Facing LEFT: column decreases\n      3: (1, 0)    # Facing DOWN: row increases\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify indices of entities that the agent cannot walk onto (e.g., walls, water, workshops).\n  # These are considered obstacles for movement.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Breadth-First Search (BFS) for shortest path ---\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a state where USE can be applied.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent\n\n      # 1. Check if the primitive is directly in front of the agent at the current (pos, dir).\n      # If it is, then we've found a path to a collectable position.\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the primitive exists in the cell directly in front.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Path to reach this state.\n              break # Shortest path found, terminate BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # A. Try Move Forward action\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Check if the next position is within bounds and this (position, direction) state has not been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          # Determine if the next position is walkable.\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable entities (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP_X').\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk onto the primitive itself (it needs to be adjacent to 'USE' it).\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move)) # Mark new state as visited.\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue.\n\n      # B. Try Turn Left action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # C. Try Turn Right action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the 'USE' action to perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # The final action is to 'USE' the primitive.\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:26:13.619229", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get grid dimensions\n\n  # Get the integer mappings for actions from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # In CraftWorld, 'UP' typically means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction\n  # This helps calculate the cell directly in front of the agent (for USE)\n  # and the new position after a MOVE_FORWARD action.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify non-walkable entities (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # The agent cannot move onto cells containing these kinds.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable position.\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # This is the \"goal\" condition for which we append the USE_ACTION.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid bounds.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the primitive is present in the cell in front.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Path to reach this state.\n              break # Shortest path found, terminate BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it does not contain any non-grabbable entity.\n          # Also, the agent cannot walk *onto* the primitive itself; it needs to be adjacent to use it.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          if initial_grid[next_r, next_c, primitive_id] > 0: # Cannot walk on the primitive itself.\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move))\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found, extend the actions with the path\n  # and append the USE action to perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:27:13.112747", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape # _ for n_kinds, which is implicitly used in grid indexing\n\n  # Initialize the list of actions to be returned\n  actions = []\n\n  # Get the integer ID for the primitive from the cookbook's index.\n  # If the primitive name is not recognized (e.g., misspelled), it cannot be collected.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    return [] # Return an empty list if the primitive is unknown\n\n  # Define action constants, assuming they are available from the 'craft' module,\n  # which typically defines integer codes for actions (e.g., craft.UP = 1, craft.USE = 4).\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Map (delta_row, delta_column) offsets for cardinal moves to their corresponding action constants.\n  # This facilitates exploring neighbors in the Breadth-First Search (BFS).\n  CARDINAL_MOVES_MAP = {\n      (-1, 0): ACTION_UP,    # Move up (decreases row index)\n      (1, 0): ACTION_DOWN,   # Move down (increases row index)\n      (0, -1): ACTION_LEFT,  # Move left (decreases column index)\n      (0, 1): ACTION_RIGHT  # Move right (increases column index)\n  }\n\n  # --- Handle uncollectible or non-interactive primitives ---\n  # Water is an example of an environment primitive that cannot be \"collected\"\n  # by agent movement or a 'USE' action; it typically acts as an impassable obstacle.\n  if primitive_idx == env.world.water_index:\n    return []\n  \n  # Other non-grabbable items that are not workshops (e.g., 'BOUNDARY') are generally\n  # static obstacles that cannot be collected or interacted with in a 'collect' sense.\n  # This constraint is further reinforced by the `is_traversable` function below.\n\n  # --- Categorize the primitive to determine its interaction logic ---\n  # Grabbable resources are items the agent can pick up or harvest (e.g., WOOD, STONE, dropped crafted items).\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices \n  # Workshops are locations the agent needs to stand on to perform crafting (e.g., WORKSHOP0, BENCH).\n  is_workshop = primitive_idx in env.world.workshop_indices             \n\n  # Helper function to determine if a given grid cell (r, c) is traversable by the agent.\n  # A cell is traversable if the agent can move onto it without being blocked.\n  def is_traversable(r, c):\n    # 1. Check if the coordinates (r, c) are within the valid grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # 2. Check for specific blocking elements at this cell.\n    # Water is always considered an impassable obstacle for movement.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # 3. Iterate through all 'kinds' (items/entities) present at the cell (r, c).\n    # If any of these kinds are designated as 'non_grabbable' AND are NOT workshops,\n    # then they are considered blocking obstacles for agent movement.\n    kinds_at_cell = np.where(grid[r, c] == 1)[0] # Get indices of all kinds present at (r,c)\n    for k_idx in kinds_at_cell:\n        if k_idx in env.world.non_grabbable_indices:\n            # Workshops (e.g., WORKSHOP0) are non-grabbable but are traversable.\n            # The agent can move onto a workshop to interact (e.g., craft).\n            # Any other non-grabbable item (like 'BOUNDARY' but not water) is a barrier.\n            if k_idx not in env.world.workshop_indices:\n                return False # This cell contains a non-traversable, blocking obstacle\n    return True\n\n  # 1. Identify all exact locations on the grid where the target primitive exists.\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1: # Check if the primitive's bit is set at (r,c)\n        primitive_grid_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the current map, it cannot be collected.\n  if not primitive_grid_locations:\n    return []\n\n  # 2. Determine the set of target positions for the Breadth-First Search (BFS).\n  # These are the cells where the agent needs to be located to effectively \"collect\" the primitive.\n  target_bfs_positions = set()\n  \n  if is_grabbable_resource:\n    # For grabbable resources (e.g., WOOD, STONE, GRASS), the agent needs to be\n    # adjacent to the resource (within a 3x3 neighborhood, including diagonals)\n    # to perform a 'USE' action (e.g., chop, mine, pick up).\n    NEIGHBORHOOD_OFFSETS_3x3 = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n    ]\n    for pr, pc in primitive_grid_locations: # For each specific instance of the primitive\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3: # Check all 9 cells in the 3x3 neighborhood\n        nr, nc = pr + dr, pc + dc # Calculate potential agent standing position\n        # The agent must be able to travers to this neighbor cell.\n        if is_traversable(nr, nc):\n          target_bfs_positions.add((nr, nc))\n  elif is_workshop:\n    # For workshops (e.g., WORKSHOP0, BENCH), the agent needs to move directly *onto*\n    # the workshop cell to interact with it (e.g., craft).\n    for pr, pc in primitive_grid_locations:\n      # The workshop location itself must be traversable. Workshops are generally designed to be.\n      if is_traversable(pr, pc):\n        target_bfs_positions.add((pr, pc))\n  else:\n    # If the primitive is neither a grabbable resource nor a workshop, it's considered\n    # uncollectible by this function's logic (e.g., 'BOUNDARY').\n    return []\n\n  # If no reachable target positions are found (e.g., primitive is surrounded by impassable terrain),\n  # then the primitive cannot be collected.\n  if not target_bfs_positions:\n    return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the identified target positions.\n  # The queue stores tuples of (current_position (r,c), path_taken_actions_so_far).\n  q = collections.deque([(start_pos, [])])\n  # 'visited' set keeps track of grid cells already processed to avoid cycles and redundant paths.\n  visited = {start_pos}\n  path_to_target = None # This will store the shortest sequence of actions to reach a target cell.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell is one of our desired target positions, we have found the shortest path.\n    if (r, c) in target_bfs_positions:\n      path_to_target = current_path\n      break # Exit BFS as the shortest path is found\n\n    # Explore valid cardinal neighbors (Up, Down, Left, Right)\n    for (dr, dc), action_val in CARDINAL_MOVES_MAP.items():\n      next_r, next_c = r + dr, c + dc # Calculate neighbor coordinates\n      \n      # Check if the neighbor cell is within bounds, has not been visited yet, and is traversable.\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c)) # Mark the neighbor as visited\n          # Add the neighbor to the queue with the updated path, including the action taken to reach it.\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  # 4. Construct the final sequence of actions to return.\n  if path_to_target:\n    actions.extend(path_to_target)\n    # If the primitive is a grabbable resource, a 'USE' action is required\n    # after reaching the spot to actually collect it into inventory.\n    if is_grabbable_resource:\n      actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:27:14.091101", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This function implements a Breadth-First Search (BFS) algorithm to find the shortest\n    path from the agent's current position to a location suitable for interacting with\n    the specified primitive. It then appends a 'USE' action if the primitive is a\n    grabbable resource.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment object, providing access to\n                            the current state, world configuration, and action definitions.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A sequence of integer action codes (from `craft` module) that, when executed,\n                   will lead the agent to collect the primitive. Returns an empty list\n                   if the primitive is unreachable, not present, or uncollectible.\n  \"\"\"\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's current (row, column) position\n  grid_width, grid_height, _ = grid.shape # Grid dimensions (n_kinds is not needed for size)\n\n  # Initialize an empty list to store the sequence of actions to be returned.\n  actions = []\n\n  # 1. Map the primitive name (string) to its integer ID using the cookbook's index.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the environment's index, it cannot be collected.\n    return []\n\n  # 2. Define action constants from the 'craft' module for clarity and direct use.\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Mapping of (delta_row, delta_column) offsets to the corresponding cardinal movement action.\n  CARDINAL_MOVES_MAP = {\n      (-1, 0): ACTION_UP,    # Move up: decreases row index\n      (1, 0): ACTION_DOWN,   # Move down: increases row index\n      (0, -1): ACTION_LEFT,  # Move left: decreases column index\n      (0, 1): ACTION_RIGHT   # Move right: increases column index\n  }\n\n  # 3. Handle specific uncollectible primitive types early.\n  # Water is typically an environmental feature that cannot be collected or moved onto directly.\n  # \"BOUNDARY\" represents out-of-bounds, not an indexable primitive.\n  if primitive_idx == env.world.water_index:\n    return []\n\n  # 4. Determine the interaction type for the primitive based on its category in CraftWorld.\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # If the primitive is neither a grabbable resource nor a workshop, it's likely\n  # an uncollectible environmental element (e.g., a static background \"STONE\" that\n  # isn't a gatherable resource). In such cases, no collection action is possible.\n  if not is_grabbable_resource and not is_workshop:\n      return []\n\n  # 5. Helper function to determine if a given grid cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n    # Check if the coordinates are within the defined grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Check for blocking elements at this specific cell.\n    # Water cells are generally impassable obstacles.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Iterate through all object kinds present at the current cell (r, c).\n    # A cell is considered blocked if it contains any non-grabbable item that is\n    # NOT a workshop and NOT water (as workshops are traversable and water is handled).\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for k_idx in kinds_at_cell:\n        if k_idx in env.world.non_grabbable_indices:\n            # Workshops (e.g., WORKSHOP0) are typically traversable by the agent.\n            # Water is explicitly checked above. Other non-grabbable items block movement.\n            if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                return False # This cell contains a non-traversable obstacle.\n    return True\n\n  # 6. Identify all initial locations on the grid where the target primitive exists.\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # If the primitive is not present anywhere on the current map, it cannot be collected.\n    return []\n\n  # 7. Determine the set of target positions for the Breadth-First Search (BFS).\n  # These are the cells where the agent needs to be located to \"collect\" the primitive.\n  target_bfs_positions = set()\n  \n  if is_grabbable_resource:\n    # For grabbable resources (e.g., WOOD, STONE, GRASS), the agent needs to be\n    # in any of the 8 adjacent cells (3x3 neighborhood, including the resource's cell if traversable)\n    # to be able to use the 'USE' action to pick it up.\n    NEIGHBORHOOD_OFFSETS_3x3 = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1] # Generates offsets for a 3x3 square\n    ]\n    for pr, pc in primitive_grid_locations: # For each specific instance of the primitive\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3: # Check all 9 cells around it (including itself)\n        nr, nc = pr + dr, pc + dc # Calculate potential agent standing position\n        if is_traversable(nr, nc): # Only add traversable cells to the target set\n          target_bfs_positions.add((nr, nc))\n  elif is_workshop:\n    # For workshops (e.g., WORKSHOP0), the agent needs to move directly *onto* the workshop cell.\n    # Only consider workshop locations that are themselves traversable.\n    for pr, pc in primitive_grid_locations:\n      if is_traversable(pr, pc):\n        target_bfs_positions.add((pr, pc))\n  \n  if not target_bfs_positions:\n    # If no reachable target positions are found for the agent to move to, return empty.\n    return []\n\n  # 8. Perform a Breadth-First Search (BFS) to find the shortest path from start_pos\n  # to any of the target_bfs_positions.\n  # The queue stores tuples of (current_position, path_taken_actions_so_far).\n  q = collections.deque([(start_pos, [])])\n  # The 'visited' set keeps track of grid cells already processed to avoid cycles and redundant paths.\n  visited = {start_pos}\n  path_to_target = None # This will store the shortest sequence of actions found.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell is one of our desired target positions, we have found the shortest path.\n    if (r, c) in target_bfs_positions:\n      path_to_target = current_path\n      break # Exit BFS as the shortest path to *any* target is found.\n\n    # Explore valid cardinal neighbors (Up, Down, Left, Right).\n    # Diagonal moves are typically not allowed for agent movement in CraftWorld.\n    for (dr, dc), action_val in CARDINAL_MOVES_MAP.items():\n      next_r, next_c = r + dr, c + dc # Calculate neighbor coordinates\n      \n      # Check if the neighbor cell is within bounds, has not been visited yet, and is traversable.\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c)) # Mark the neighbor as visited.\n          # Add the neighbor to the queue with the updated path.\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  # 9. Construct the final sequence of actions to return based on the BFS result.\n  if path_to_target is not None:\n    actions.extend(path_to_target)\n    # If the primitive is a grabbable resource, a 'USE' action is required\n    # after reaching the collection spot to pick it up or harvest it.\n    if is_grabbable_resource:\n      actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:28:08.249098", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Finds the shortest path to a `primitive` on the grid and returns the\n  sequence of actions to reach and, if grabbable, collect it.\n  \n  Args:\n      env (env.CraftLab): The CraftLab environment instance.\n      primitive (str): The name of the primitive item or feature to collect\n                       (e.g., \"WOOD\", \"WORKSHOP0\", \"WATER\").\n\n  Returns:\n      List[int]: A sequence of integer action IDs (UP, DOWN, LEFT, RIGHT, USE)\n                 to perform the collection. Returns an empty list if the primitive\n                 cannot be found or is inaccessible.\n  \"\"\"\n  # 1. Action Mapping: Get integer IDs for basic movement and interaction actions.\n  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Define movement deltas for BFS (dx, dy) corresponding to actions.\n  move_deltas = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # 2. Current State Information: Extract necessary details from the environment.\n  current_state = env._current_state\n  current_grid = current_state.grid\n  start_pos = current_state.pos  # Agent's initial (x, y) position\n  grid_width, grid_height, _ = current_grid.shape # Dimensions of the grid\n\n  # 3. Primitive Identification: Convert the primitive name to its internal integer ID.\n  try:\n    # Use the cookbook's index to get the unique integer ID for the primitive.\n    # This will raise a KeyError if the primitive name is not recognized.\n    primitive_id = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is not valid, it cannot be collected.\n    return []\n\n  # 4. Determine primitive properties: Is it grabbable or an environmental feature?\n  grabbable_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_target = (primitive_id in grabbable_ids_set)\n\n  # 5. Identify Impassable Kinds: These are entities that typically block movement.\n  # We convert to a set for efficient lookup.\n  impassable_kind_ids = set(env.world.non_grabbable_indices)\n\n  # 6. Breadth-First Search (BFS) Initialization:\n  # The queue will store (position, list_of_actions_taken) tuples.\n  queue = collections.deque([(start_pos, [])])\n  # The visited set prevents cycles and redundant processing of grid cells.\n  visited = {start_pos}\n\n  # BFS Loop: Explore the grid to find the shortest path to the primitive.\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is present at the current cell.\n    # The grid stores counts, so > 0 indicates presence.\n    if current_grid[cx, cy, primitive_id] > 0:\n      # Primitive found! Construct the final sequence of actions.\n      if is_grabbable_target:\n        # If the primitive is grabbable (e.g., WOOD, IRON), append a USE action\n        # to pick it up once the agent reaches its location.\n        return path_so_far + [ACTION_USE]\n      else:\n        # If it's a non-grabbable feature (e.g., WORKSHOP0, WATER, BOUNDARY),\n        # \"collecting\" it simply means reaching its location. No USE action is needed.\n        return path_so_far\n\n    # Explore all valid neighboring cells from the current position.\n    for action_to_move, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      # a. Boundary Check: Ensure the next position is within the grid limits.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # b. Visited Check: Skip if this cell has already been processed in BFS.\n      if next_pos in visited:\n        continue\n\n      # c. Obstacle Check: Determine if the next cell is traversable.\n      is_obstacle_cell = False\n      for kind_id in impassable_kind_ids:\n        # A cell is an obstacle if it contains an impassable item that is NOT the\n        # specific primitive we are trying to collect. This distinction allows the\n        # agent to move onto a target tile (like a WORKSHOP) even if that kind\n        # is generally considered non-traversable for other purposes.\n        if kind_id != primitive_id and current_grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break  # Found an obstacle in this direction, stop checking other kinds.\n      \n      if is_obstacle_cell:\n        continue  # Cannot move to this cell because it's blocked.\n\n      # If the next position is valid and traversable, add it to the queue\n      # and mark it as visited for future reference.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_to_move]))\n\n  # If the BFS completes and the queue becomes empty without finding the primitive,\n  # it means the primitive is either not on the map or is completely inaccessible.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:28:09.226123", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state details from the environment\n  current_state = env._current_state\n  current_grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Convert the primitive name (string) to its corresponding integer index ID.\n  # Use .lower() for robustness and the __getitem__ method (via []) for lookup.\n  # This returns an integer ID or None if the item is not found.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  if primitive_id is None:\n    # If the primitive name is not found in the cookbook's index, it cannot be collected.\n    return []\n\n  # Determine if the target primitive is grabbable (can be picked up with ACTION_USE).\n  # Items like 'WOOD' or 'IRON' are grabbable, while 'WORKSHOP0' or 'WATER' are not.\n  grabbable_kind_ids_set = set(env.world.grabbable_indices)\n  is_grabbable_target = (primitive_id in grabbable_kind_ids_set)\n\n  # Get indices for entities that are generally impassable (non-grabbable and block agent movement).\n  # This set typically includes things like \"water\", \"stone\", \"workshop\", \"boundary\".\n  impassable_kind_ids_set = set(env.world.non_grabbable_indices)\n\n  # BFS initialization for pathfinding.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The visited set stores positions (x, y) to avoid cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Define possible moves, their corresponding (dx, dy) deltas, and action IDs.\n  move_actions_with_deltas = [\n      (ACTION_UP, (0, -1)),    # Move North (decreases y-coordinate)\n      (ACTION_DOWN, (0, 1)),   # Move South (increases y-coordinate)\n      (ACTION_LEFT, (-1, 0)),  # Move West (decreases x-coordinate)\n      (ACTION_RIGHT, (1, 0)),  # Move East (increases x-coordinate)\n  ]\n\n  while queue:\n    current_pos, path_so_far = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is present at the current cell.\n    # The grid stores counts of items, so we check if the count is greater than 0.\n    if current_grid[cx, cy, primitive_id] > 0:\n      # The primitive has been found at the current location.\n      if is_grabbable_target:\n        # If it's a grabbable item (e.g., WOOD, IRON), we append ACTION_USE to pick it up.\n        return path_so_far + [ACTION_USE]\n      else:\n        # If it's a non-grabbable feature (e.g., WORKSHOP0, WATER),\n        # \"collecting\" it simply means reaching its location. No ACTION_USE is needed.\n        return path_so_far\n\n    # Explore all valid neighboring cells from the current position.\n    for action_to_take, (dx, dy) in move_actions_with_deltas:\n      nx, ny = cx + dx, cy + dy  # Calculate the neighbor's coordinates\n      next_pos = (nx, ny)\n\n      # 1. Check if the neighbor position is within the grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # 2. Check if the neighbor cell has already been visited in this BFS.\n      if next_pos in visited:\n        continue\n\n      # 3. Check if the neighbor cell contains any impassable obstacles.\n      # A cell is considered an obstacle if it contains any item from `impassable_kind_ids_set`\n      # that is *not* the `primitive_id` we are trying to collect. This allows the agent\n      # to pathfind onto the target primitive's tile even if the target itself is generally\n      # non-grabbable (e.g., moving onto a workshop tile when trying to \"collect\" a workshop).\n      is_obstacle_cell = False\n      for kind_id in impassable_kind_ids_set:\n        # If the cell contains an impassable kind that is *not* our target primitive AND its count is > 0\n        if kind_id != primitive_id and current_grid[nx, ny, kind_id] > 0:\n          is_obstacle_cell = True\n          break  # Found a blocking obstacle, no need to check further items in this cell\n      \n      if is_obstacle_cell:\n        continue  # Skip this neighbor if it's an impassable obstacle\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue with the updated path and mark it as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action_to_take]))\n\n  # If the BFS completes and the primitive was not found anywhere accessible on the grid,\n  # return an empty list, indicating that it cannot be collected from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:28:40.459677", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # --- Improvement for collect_v2: Ensure the primitive is actually grabbable ---\n  # If the primitive is not in the set of grabbable indices, it cannot be collected\n  # into the inventory, so an empty list of actions is returned.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Check if the agent is already next to the primitive\n  # If so, a single 'USE' action is sufficient to collect it.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid\n  # We collect all (row, col) coordinates where the primitive is located.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id occupies this cell (value is 1)\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  # The BFS will naturally handle this case by not finding a path,\n  # so the explicit check `return [] if not primitive_locations else []` from v1 is removed.\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the agent can \"USE\" the primitive.\n  #    A cell is \"usable\" if it is adjacent (Manhattan distance 1) to a primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  target_adj_pos_path = None # This will store the shortest path found to an adjacent cell\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current BFS node (r, c) is adjacent to any of the primitive locations.\n      # This is the goal condition for our pathfinding: reaching a cell from which we can USE.\n      is_adjacent_to_primitive_target = False\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 means the cells are directly adjacent (horizontally or vertically).\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # Found the shortest path to this adjacent cell\n              is_adjacent_to_primitive_target = True\n              break # Exit inner loop, we found an adjacent primitive\n      \n      if is_adjacent_to_primitive_target:\n          break # Exit BFS, the shortest path to an 'usable' position is found\n\n      # Explore valid neighboring cells from the current position (r, c).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position is traversable (not an obstacle).\n          # A cell is non-traversable if it contains any item whose kind index\n          # is in the world's non_grabbable_indices set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # Check 3: If this neighbor has not been visited yet, add it to the queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              # Extend the current path with the action taken to reach this new neighbor.\n              q.append(((nr, nc), path + [action_dir]))\n    \n  # 4. Construct the final sequence of actions.\n  # If a path to an adjacent cell was found, extend the actions list with this path\n  # and then append a 'USE' action to actually collect the primitive.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      actions.append(USE) # Once adjacent, perform the 'USE' action to collect the primitive.\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:28:41.433104", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # --- Improvement for collect_v2: Ensure the primitive is actually grabbable ---\n  # If the primitive is not in the set of grabbable indices, it cannot be collected\n  # into the inventory, so an empty list of actions is returned.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Check if the agent is already next to the primitive\n  # If so, a single 'USE' action is sufficient to collect it.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid\n  # We collect all (row, col) coordinates where the primitive is located.\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id occupies this cell (value is 1)\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  # The BFS will naturally handle this case by not finding a path,\n  # so the explicit check `return [] if not primitive_locations else []` is omitted.\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell from which the agent can \"USE\" the primitive.\n  #    A cell is \"usable\" if it is adjacent (Manhattan distance 1) to a primitive location.\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  target_adj_pos_path = None # This will store the shortest path found to an adjacent cell\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current BFS node (r, c) is adjacent to any of the primitive locations.\n      # This is the goal condition for our pathfinding: reaching a cell from which we can USE.\n      is_adjacent_to_primitive_target = False\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 means the cells are directly adjacent (horizontally or vertically).\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # Found the shortest path to this adjacent cell\n              is_adjacent_to_primitive_target = True\n              break # Exit inner loop, we found an adjacent primitive\n      \n      if is_adjacent_to_primitive_target:\n          break # Exit BFS, the shortest path to an 'usable' position is found\n\n      # Explore valid neighboring cells from the current position (r, c).\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the coordinates of the potential new position\n\n          # Check 1: Ensure the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check 2: Ensure the new position is traversable (not an obstacle).\n          # A cell is non-traversable if it contains any item whose kind index\n          # is in the world's non_grabbable_indices set (e.g., BOUNDARY, WATER, WORKSHOPS).\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # Check 3: If this neighbor has not been visited yet, add it to the queue.\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              # Extend the current path with the action taken to reach this new neighbor.\n              q.append(((nr, nc), path + [action_dir]))\n    \n  # 4. Construct the final sequence of actions.\n  # If a path to an adjacent cell was found, extend the actions list with this path\n  # and then append a 'USE' action to actually collect the primitive.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      actions.append(USE) # Once adjacent, perform the 'USE' action to collect the primitive.\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:29:14.875013", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index\n    return []\n\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 2. Determine primitive type\n  is_grabbable_primitive = primitive_idx in env.world.grabbable_indices\n  is_workshop_primitive = primitive_idx in env.world.workshop_indices\n\n  # If the primitive is not grabbable and not a workshop, it's not something\n  # the 'collect' function is designed to handle (e.g., a boundary, or just water)\n  if not is_grabbable_primitive and not is_workshop_primitive:\n    return []\n\n  # 3. Helper function for traversability of a grid cell (r, c)\n  def is_traversable(r, c):\n    # Check bounds\n    if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n      return False\n\n    # Check for impassable items at (r, c)\n    # A cell is impassable if it contains any non-grabbable item that is NOT a workshop.\n    # Water is a common example. Stone might be, depending on configuration.\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for kind_at_cell_idx in kinds_at_cell:\n      if kind_at_cell_idx in env.world.non_grabbable_indices and \\\n         kind_at_cell_idx not in env.world.workshop_indices:\n        return False\n    return True\n  \n  # Map (dr, dc) for cardinal directions to action constants\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # 4. Early exit if already at a desired state\n  if is_grabbable_primitive:\n    if current_state.next_to(primitive_idx):\n      actions.append(craft.USE)\n      return actions\n  elif is_workshop_primitive:\n    # Check if current position is on a workshop tile of the target type\n    if grid[current_pos[0], current_pos[1], primitive_idx] == 1:\n      return [] # Already at the workshop, no actions needed to \"collect\" it.\n\n  # 5. Find all grid locations where the primitive exists\n  target_primitive_locations = []\n  for r in range(WIDTH):\n    for c in range(HEIGHT):\n      if grid[r, c, primitive_idx] == 1:\n        target_primitive_locations.append((r, c))\n\n  if not target_primitive_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 6. Define \"collectible spots\" (where the agent needs to be to collect/interact)\n  collectible_spots = set()\n  \n  # Offsets for 3x3 neighborhood (including center)\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for pr, pc in target_primitive_locations:\n    if is_grabbable_primitive:\n      # For grabbable items, any traversable cell in the 3x3 neighborhood\n      # of the primitive is a collectible spot (where agent can stand to USE).\n      for dr, dc in NEIGHBORHOOD_OFFSETS:\n        nr, nc = pr + dr, pc + dc\n        if is_traversable(nr, nc):\n          collectible_spots.add((nr, nc))\n    elif is_workshop_primitive:\n      # For workshops, the agent needs to be *on* the workshop tile itself.\n      if is_traversable(pr, pc):\n        collectible_spots.add((pr, pc))\n  \n  if not collectible_spots:\n    # No reachable or valid collectible spots found.\n    return []\n\n  # 7. BFS to find shortest path to any collectible spot\n  q = collections.deque([(current_pos, [])]) # (position, path_taken_actions)\n  visited = {current_pos}\n  path_found = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is a collectible spot, we found the path\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break\n\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if is_traversable(next_r, next_c) and (next_r, next_c) not in visited:\n        visited.add((next_r, next_c))\n        q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 8. Construct final action list\n  if path_found:\n    actions.extend(path_found)\n    if is_grabbable_primitive:\n      actions.append(craft.USE) # Once at the adjacent spot, use to collect.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:29:15.888944", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in cookbook index\n    return []\n\n  # Ensure the primitive is actually grabbable and collectible via COLLECT_FUNC\n  # The DSL's `collect` implies picking up, so it's only for grabbable items.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Get current state information\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action constants from craft module for clarity\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n\n  # Helper function to check if a grid cell is traversable\n  def _is_traversable(r, c):\n      # Check bounds\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False\n      \n      # Check for impassable items at (r, c)\n      # Iterate through all kinds present at the cell (if multiple items can share a cell)\n      # For simplicity, we check if any non-grabbable obstacle occupies the cell.\n      # Water and stone are common obstacles. Workshops are usually traversable.\n      # The grid stores one-hot encoding per kind at (r,c), so grid[r,c,kind_idx] == 1 means that kind is there.\n      \n      # Check for water\n      if grid[r, c, env.world.water_index] == 1:\n          return False\n      \n      # Check for other non-grabbable obstacles (excluding workshops which are typically traversable)\n      for k_idx in env.world.non_grabbable_indices:\n          if k_idx != env.world.water_index and k_idx not in env.world.workshop_indices:\n              if grid[r, c, k_idx] == 1:\n                  # Found a non-grabbable obstacle at this cell\n                  return False \n      return True\n\n  # 2. Check if already next to the primitive\n  # The `next_to` method checks if the primitive_idx is in the 3x3 neighborhood.\n  # If so, we just need to use the item.\n  if current_state.next_to(primitive_idx):\n    actions.append(ACTION_USE)\n    return actions\n\n  # 3. Find all target primitive locations on the grid\n  target_primitive_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        target_primitive_locations.append((r, c))\n\n  if not target_primitive_locations:\n    # Primitive not found anywhere on the map\n    return []\n\n  # 4. Identify all \"collectible\" spots\n  # A spot (nr, nc) is collectible if standing on it allows the agent to be\n  # \"next to\" the target primitive (i.e., the primitive is within the 3x3 view).\n  collectible_spots = set()\n  \n  # Relative coordinates for a 3x3 neighborhood around a point (including the point itself)\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS:\n      nr, nc = pr + dr, pc + dc\n      \n      if _is_traversable(nr, nc):\n          collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable spots identified where the agent can be next to the primitive\n    return []\n\n  # 5. BFS to find the shortest path from current_pos to any collectible spot\n  q = collections.deque([(current_pos, [])]) # (position, path_taken_actions)\n  visited = {current_pos}\n  path_found = None\n\n  # Map (dr, dc) for cardinal directions to action constants\n  ACTION_MAP = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is a collectible spot, we found the path\n    if (r, c) in collectible_spots:\n      path_found = current_path\n      break\n\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if _is_traversable(next_r, next_c) and (next_r, next_c) not in visited:\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct final action list\n  if path_found:\n    actions.extend(path_found)\n    actions.append(ACTION_USE) # Once at the adjacent spot, use the item.\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:30:25.897373", "function_name": "collect", "function_body": "  # 1. Get the integer index for the primitive string\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape  # grid is (WIDTH, HEIGHT, n_kinds)\n\n  # Get action mappings from the environment\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define movement deltas (dx, dy) for (x, y) coordinates based on action IDs\n  action_deltas = {\n      ACTION_DOWN: (0, 1),   # Increasing Y (moving down on screen)\n      ACTION_UP: (0, -1),  # Decreasing Y (moving up on screen)\n      ACTION_LEFT: (-1, 0),  # Decreasing X (moving left on screen)\n      ACTION_RIGHT: (1, 0)   # Increasing X (moving right on screen)\n  }\n\n  # Helper function to determine if a cell is traversable by the agent\n  # A cell is traversable if it's within bounds and does not contain any non-grabbable (impassable) entities.\n  def is_traversable(x, y, current_state):\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any impassable objects (e.g., walls, water)\n      for k_idx in env.world.non_grabbable_indices:\n          if current_state.grid[x, y, k_idx] > 0:\n              return False  # Contains an impassable object\n      return True  # Cell is traversable\n\n  # Helper function to check if a cell (x, y) is cardinally adjacent to the target primitive\n  def is_cardinally_adjacent_to_primitive(x, y, current_state, target_primitive_idx):\n      # Check 4 cardinal directions: Up, Down, Left, Right\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and current_state.grid[nx, ny, target_primitive_idx] > 0:\n              return True  # Found the primitive in a cardinal neighbor\n      return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # The goal is to reach a traversable cell that is cardinally adjacent to the primitive.\n  queue = collections.deque([(current_pos, [])])  # Queue stores (current_position, path_actions_so_far)\n  visited = {current_pos}  # Keep track of visited positions to avoid cycles\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # If the current position is cardinally adjacent to the primitive,\n      # we have found our target location. Append the USE action and return the path.\n      if is_cardinally_adjacent_to_primitive(x, y, state, primitive_idx):\n          return path + [ACTION_USE]\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dx, dy) in action_deltas.items():\n          new_x, new_y = x + dx, y + dy\n          new_pos = (new_x, new_y)\n\n          # If the new position has already been visited, skip it\n          if new_pos in visited:\n              continue\n\n          # If the new position is traversable, add it to the queue and mark as visited\n          if is_traversable(new_x, new_y, state):\n              visited.add(new_pos)\n              queue.append((new_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:30:26.900742", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current position (x, y)\n\n  # Get relevant indices from the cookbook\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  boundary_idx = cookbook.index.index(\"boundary\") # Index for boundary, assumed to be an obstacle\n\n  # Define movement actions and their corresponding (delta_x, delta_y)\n  # (x corresponds to column, y corresponds to row)\n  moves = {\n      craft.UP: (0, -1),   # Move up: y decreases\n      craft.DOWN: (0, 1),    # Move down: y increases\n      craft.LEFT: (-1, 0),   # Move left: x decreases\n      craft.RIGHT: (1, 0)    # Move right: x increases\n  }\n\n  # Get grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y), path_taken_so_far)\n  queue = collections.deque([(start_pos, [])])\n  # Set of visited positions to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  while queue:\n    (x, y), path = queue.popleft()\n\n    # Check if the target primitive is in the 3x3 neighborhood of the current position\n    # This mimics the logic of CraftState.next_to\n    found_adjacent_primitive = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n        # Check if the adjacent cell is within grid bounds\n        if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n          # Check if the primitive is present at this adjacent cell\n          if grid[nx_adj, ny_adj, primitive_idx] > 0:\n            found_adjacent_primitive = True\n            break # Found primitive in neighborhood, no need to check further adjacent cells\n      if found_adjacent_primitive:\n        break # Found primitive, break out of outer loop too\n\n    if found_adjacent_primitive:\n      # If the primitive is adjacent, the next action should be USE\n      return path + [craft.USE]\n\n    # Explore neighbors (UP, DOWN, LEFT, RIGHT) for movement\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n\n      # Check validity of the next_pos:\n      # 1. Bounds check: Ensure new position is within the grid\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting already explored positions to find shortest path\n      if next_pos in visited:\n        continue\n\n      # 3. Traversability check: Ensure the cell is not an obstacle (e.g., boundary)\n      if grid[next_x, next_y, boundary_idx] > 0:\n        continue # Cannot move into a boundary cell\n\n      # If all checks pass, add the new position to the queue and mark as visited\n      visited.add(next_pos)\n      queue.append((next_pos, path + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:31:33.849383", "function_name": "collect", "function_body": "  \"\"\"Further improved version of `collect_v1` for finding and collecting a primitive item.\n\n  This function determines the shortest sequence of actions (movements) required\n  for the agent to reach a position where it can interact with the specified\n  primitive. It leverages a Breadth-First Search (BFS) for pathfinding.\n  If the primitive is a 'grabbable' resource, a 'USE' action is appended\n  at the end of the path to simulate collection.\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance, providing access to\n                          the current state, world configuration (cookbook, indices),\n                          and action definitions.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"WORKSHOP0\").\n\n  Returns:\n      List[int]: A list of integer action codes (from `craft` module, e.g., `craft.UP`,\n                 `craft.USE`) representing the sequence of actions to take.\n                 Returns an empty list if:\n                 - The primitive name is not recognized.\n                 - The primitive is inherently uncollectable or non-interactable (e.g., pure environment features).\n                 - The primitive is not found on the current grid.\n                 - No traversable path exists to a suitable interaction location.\n  \"\"\"\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's current (row, column) position\n  grid_width, grid_height, _ = grid.shape # Dimensions of the grid\n\n  # Initialize the list to store the sequence of actions to be returned.\n  actions_sequence = []\n\n  # 1. Map the primitive name (string) to its integer ID using the cookbook's index.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the environment's index, it cannot be collected.\n    return []\n\n  # 2. Define action constants and a mapping for cardinal movements.\n  # These constants come from the 'craft' module, providing clear, readable action values.\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Map (delta_row, delta_column) offsets to their corresponding cardinal movement actions.\n  # This mapping is used during BFS to convert relative moves into specific actions.\n  CARDINAL_MOVES_MAP = {\n      (-1, 0): ACTION_UP,    # Moving up means decreasing the row index.\n      (1, 0): ACTION_DOWN,   # Moving down means increasing the row index.\n      (0, -1): ACTION_LEFT,  # Moving left means decreasing the column index.\n      (0, 1): ACTION_RIGHT   # Moving right means increasing the column index.\n  }\n\n  # 3. Categorize the primitive based on its interaction type within the CraftWorld.\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # 4. Early exit for primitives that are not designed to be 'collected' or interacted with\n  # via agent movement followed by a 'USE' action. This includes static environmental\n  # features that are neither grabbable nor workshops (e.g., solid ground, some types of stone).\n  # Also, if the primitive itself is water, it's generally uncollectible.\n  if (not is_grabbable_resource and not is_workshop) or primitive_idx == env.world.water_index:\n      return []\n\n  # 5. Helper function to determine if a given grid cell (r, c) is traversable by the agent.\n  # A cell is traversable if it's within grid boundaries and does not contain impassable obstacles.\n  def is_traversable(r, c):\n    # Check 1: Ensure coordinates are within the defined grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Check 2: Water cells are typically impassable obstacles.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Check 3: Other blocking entities.\n    # Iterate through all object kinds present at the current cell (r, c).\n    # A cell is considered blocked if it contains any non-grabbable item that is\n    # NOT a workshop. Workshops are typically traversable for interaction.\n    kinds_at_cell = np.where(grid[r, c] == 1)[0] # Get indices of all items present at (r,c)\n    for k_idx in kinds_at_cell:\n        # If an item is non-grabbable AND it's not a workshop, it's an obstacle.\n        if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n            # (Note: water_index is already handled by the explicit check above.)\n            return False # This cell contains a non-traversable obstacle.\n    return True\n\n  # 6. Identify all grid locations where instances of the target primitive exist.\n  primitive_locations_on_grid = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      # If the primitive's kind is present at this cell, add its coordinates.\n      if grid[r, c, primitive_idx] == 1:\n        primitive_locations_on_grid.append((r, c))\n\n  if not primitive_locations_on_grid:\n    # If no instances of the primitive are found on the current map, it cannot be collected.\n    return []\n\n  # 7. Determine the set of desired target positions for the agent's BFS.\n  # These are the specific cells where the agent needs to be located to effectively\n  # interact with and 'collect' the primitive.\n  bfs_target_cells = set()\n  \n  if is_grabbable_resource:\n    # For grabbable items (e.g., WOOD, IRON, GRASS), the agent generally needs\n    # to be in an adjacent cell (within a 3x3 neighborhood, including the\n    # resource's own cell if traversable) to be able to 'USE' it.\n    NEIGHBORHOOD_OFFSETS_3x3 = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1] # Generates all 9 relative positions for a 3x3 square.\n    ]\n    for pr, pc in primitive_locations_on_grid: # Iterate through each instance of the primitive.\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3: # Check all cells around this primitive instance.\n        nr, nc = pr + dr, pc + dc # Calculate potential agent standing position.\n        if is_traversable(nr, nc): # Only add traversable cells to the target set.\n          bfs_target_cells.add((nr, nc))\n  \n  elif is_workshop:\n    # For workshops (e.g., WORKSHOP0, WORKSHOP1), the agent typically needs to\n    # move directly *onto* the workshop cell to interact with it.\n    for pr, pc in primitive_locations_on_grid:\n      if is_traversable(pr, pc): # Ensure the workshop cell itself is traversable.\n        bfs_target_cells.add((pr, pc))\n  \n  if not bfs_target_cells:\n    # If, after checking all primitive locations, no reachable target cells are found\n    # for the agent to move to, then the primitive is effectively unreachable.\n    return []\n\n  # 8. Perform Breadth-First Search (BFS) to find the shortest path from the\n  # agent's current position to any of the determined `bfs_target_cells`.\n  # The queue will store tuples of: (current_position (tuple), path_actions_so_far (list)).\n  q = collections.deque([(start_pos, [])])\n  # The `visited` set keeps track of grid cells already processed to prevent cycles\n  # and redundant exploration, ensuring the shortest path is found.\n  visited = {start_pos}\n  shortest_path_actions = None # This will store the sequence of actions for the shortest path found.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell (r, c) is one of our desired target BFS positions,\n    # we have successfully found the shortest path.\n    if (r, c) in bfs_target_cells:\n      shortest_path_actions = current_path\n      break # Exit BFS immediately as the shortest path to *any* target has been found.\n\n    # Explore all four cardinal neighbors (Up, Down, Left, Right).\n    # Diagonal moves are typically not allowed for agent movement in CraftWorld.\n    for (dr, dc), action_val in CARDINAL_MOVES_MAP.items():\n      next_r, next_c = r + dr, c + dc # Calculate the coordinates of the neighbor cell.\n      \n      # Check if the neighbor cell is valid:\n      # 1. Has not been visited yet (to ensure shortest path and prevent loops).\n      # 2. Is traversable by the agent (using the `is_traversable` helper function).\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c)) # Mark the neighbor as visited.\n          # Add the neighbor to the queue with its updated path (current path + the action to get there).\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  # 9. Construct the final action sequence to return based on the BFS result.\n  if shortest_path_actions is not None:\n    # Add the movement actions found by BFS to the sequence.\n    actions_sequence.extend(shortest_path_actions)\n    \n    # If the primitive is a grabbable resource, a 'USE' action is necessary\n    # after reaching the target location to actually pick it up or harvest it.\n    if is_grabbable_resource:\n      actions_sequence.append(ACTION_USE)\n  \n  return actions_sequence", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:31:34.825470", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's current (row, column) position\n  grid_width, grid_height, _ = grid.shape # Grid dimensions (n_kinds is not needed for size)\n\n  # Initialize an empty list to store the sequence of actions to be returned.\n  actions = []\n\n  # 1. Map the primitive name (string) to its integer ID using the cookbook's index.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the environment's index, it cannot be collected.\n    return []\n\n  # 2. Define action constants from the 'craft' module for clarity and direct use.\n  ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE = (\n      craft.UP, craft.DOWN, craft.LEFT, craft.RIGHT, craft.USE\n  )\n  \n  # Mapping of (delta_row, delta_column) offsets to the corresponding cardinal movement action.\n  CARDINAL_MOVES_MAP = {\n      (-1, 0): ACTION_UP,    # Move up: decreases row index\n      (1, 0): ACTION_DOWN,   # Move down: increases row index\n      (0, -1): ACTION_LEFT,  # Move left: decreases column index\n      (0, 1): ACTION_RIGHT   # Move right: increases column index\n  }\n\n  # 3. Handle specific uncollectible primitive types early.\n  # Water is typically an environmental feature that cannot be collected or moved onto directly.\n  # \"BOUNDARY\" represents out-of-bounds, not an indexable primitive.\n  if primitive_idx == env.world.water_index:\n    return []\n\n  # 4. Determine the interaction type for the primitive based on its category in CraftWorld.\n  is_grabbable_resource = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # If the primitive is neither a grabbable resource nor a workshop, it's likely\n  # an uncollectible environmental element (e.g., a static background \"STONE\" that\n  # isn't a gatherable resource). In such cases, no collection action is possible.\n  if not is_grabbable_resource and not is_workshop:\n      return []\n\n  # 5. Helper function to determine if a given grid cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n    # Check if the coordinates are within the defined grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Check for blocking elements at this specific cell.\n    # Water cells are generally impassable obstacles.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Iterate through all object kinds present at the current cell (r, c).\n    # A cell is considered blocked if it contains any non-grabbable item that is\n    # NOT a workshop and NOT water (as workshops are traversable and water is handled).\n    kinds_at_cell = np.where(grid[r, c] == 1)[0]\n    for k_idx in kinds_at_cell:\n        if k_idx in env.world.non_grabbable_indices:\n            # Workshops (e.g., WORKSHOP0) are typically traversable by the agent.\n            # Water is explicitly checked above. Other non-grabbable items block movement.\n            if k_idx not in env.world.workshop_indices and k_idx != env.world.water_index:\n                return False # This cell contains a non-traversable obstacle.\n    return True\n\n  # 6. Identify all initial locations on the grid where the target primitive exists.\n  primitive_grid_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_grid_locations.append((r, c))\n\n  if not primitive_grid_locations:\n    # If the primitive is not present anywhere on the current map, it cannot be collected.\n    return []\n\n  # 7. Determine the set of target positions for the Breadth-First Search (BFS).\n  # These are the cells where the agent needs to be located to \"collect\" the primitive.\n  target_bfs_positions = set()\n  \n  if is_grabbable_resource:\n    # For grabbable resources (e.g., WOOD, STONE, GRASS), the agent needs to be\n    # in any of the 8 adjacent cells (3x3 neighborhood, including the resource's cell if traversable)\n    # to be able to use the 'USE' action to pick it up.\n    NEIGHBORHOOD_OFFSETS_3x3 = [\n        (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1] # Generates offsets for a 3x3 square\n    ]\n    for pr, pc in primitive_grid_locations: # For each specific instance of the primitive\n      for dr, dc in NEIGHBORHOOD_OFFSETS_3x3: # Check all 9 cells around it (including itself)\n        nr, nc = pr + dr, pc + dc # Calculate potential agent standing position\n        if is_traversable(nr, nc): # Only add traversable cells to the target set\n          target_bfs_positions.add((nr, nc))\n  elif is_workshop:\n    # For workshops (e.g., WORKSHOP0), the agent needs to move directly *onto* the workshop cell.\n    # Only consider workshop locations that are themselves traversable.\n    for pr, pc in primitive_grid_locations:\n      if is_traversable(pr, pc):\n        target_bfs_positions.add((pr, pc))\n  \n  if not target_bfs_positions:\n    # If no reachable target positions are found for the agent to move to, return empty.\n    return []\n\n  # 8. Perform a Breadth-First Search (BFS) to find the shortest path from start_pos\n  # to any of the target_bfs_positions.\n  # The queue stores tuples of (current_position, path_taken_actions_so_far).\n  q = collections.deque([(start_pos, [])])\n  # The 'visited' set keeps track of grid cells already processed to avoid cycles and redundant paths.\n  visited = {start_pos}\n  path_to_target = None # This will store the shortest sequence of actions found.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell is one of our desired target positions, we have found the shortest path.\n    if (r, c) in target_bfs_positions:\n      path_to_target = current_path\n      break # Exit BFS as the shortest path to *any* target is found.\n\n    # Explore valid cardinal neighbors (Up, Down, Left, Right).\n    # Diagonal moves are typically not allowed for agent movement in CraftWorld.\n    for (dr, dc), action_val in CARDINAL_MOVES_MAP.items():\n      next_r, next_c = r + dr, c + dc # Calculate neighbor coordinates\n      \n      # Check if the neighbor cell is within bounds, has not been visited yet, and is traversable.\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c)) # Mark the neighbor as visited.\n          # Add the neighbor to the queue with the updated path.\n          q.append(((next_r, next_c), current_path + [action_val]))\n\n  # 9. Construct the final sequence of actions to return based on the BFS result.\n  if path_to_target is not None:\n    actions.extend(path_to_target)\n    # If the primitive is a grabbable resource, a 'USE' action is required\n    # after reaching the collection spot to pick it up or harvest it.\n    if is_grabbable_resource:\n      actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:32:52.448175", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos = current_state.pos\n\n  # Get primitive index\n  # Use .get() with a default to avoid KeyError if primitive is unknown (though DSL ensures valid primitives)\n  primitive_idx = env.world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n    return [] # Should not happen with valid DSL, but good for robustness\n\n  # Determine if the primitive is grabbable\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # --- Initial check: Is the agent already at/next to the primitive? ---\n  if is_grabbable:\n    # If a grabbable item, agent needs to be next to it and USE.\n    if current_state.next_to(primitive_idx):\n      return [env.action_specs()['USE']]\n  else:\n    # If a non-grabbable item (like a workshop, water), \"collecting\" means being on that spot.\n    if current_grid[current_pos[0], current_pos[1], primitive_idx] == 1.0:\n      return [] # Already at the location, no actions needed.\n\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Define possible movements and their corresponding actions\n  # Action IDs from CraftLab.action_specs(): DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  move_deltas = {\n      (-1, 0): env.action_specs()['UP'],\n      (1, 0): env.action_specs()['DOWN'],\n      (0, -1): env.action_specs()['LEFT'],\n      (0, 1): env.action_specs()['RIGHT']\n  }\n\n  # --- BFS setup ---\n  q = collections.deque([(current_pos)]) # Queue stores (row, col)\n  visited = {current_pos}\n  parent = {current_pos: None} # child_pos -> parent_pos\n  action_to_reach = {} # child_pos -> action_from_parent_to_child\n\n  final_agent_pos = None # The position the agent needs to reach\n\n  # --- BFS loop ---\n  while q:\n    curr_r, curr_c = q.popleft()\n\n    # For non-grabbable items: Check if agent is currently ON the primitive.\n    # This check is done when `curr_r, curr_c` is popped from the queue,\n    # meaning it's the shortest path to this cell.\n    if not is_grabbable and current_grid[curr_r, curr_c, primitive_idx] == 1.0:\n      final_agent_pos = (curr_r, curr_c)\n      break # Found the target position, break from BFS\n\n    # Explore neighbors\n    for (dr, dc), action_val in move_deltas.items():\n      next_r, next_c = curr_r + dr, curr_c + dc\n      next_pos = (next_r, next_c)\n\n      # Check boundary conditions\n      if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n        continue\n      \n      # If `next_pos` has already been visited, we've found a shorter or equal path to it,\n      # so skip to prevent redundant processing and ensure shortest path.\n      if next_pos in visited:\n        continue\n\n      # For grabbable items: Check if moving to `next_pos` makes the agent adjacent to the primitive.\n      # This is the target condition for grabbable items.\n      if is_grabbable:\n        # Check the 3x3 neighborhood around `next_pos` for the primitive\n        is_adjacent_to_primitive = False\n        for r_offset in [-1, 0, 1]:\n          for c_offset in [-1, 0, 1]:\n            check_r, check_c = next_r + r_offset, next_c + c_offset\n            if (0 <= check_r < grid_height and 0 <= check_c < grid_width and\n                current_grid[check_r, check_c, primitive_idx] == 1.0):\n              is_adjacent_to_primitive = True\n              break\n          if is_adjacent_to_primitive:\n            break\n        \n        if is_adjacent_to_primitive:\n          # This `next_pos` is the first (shortest-path) cell from which the agent can grab the item.\n          # Record it and mark as visited to prevent further exploration.\n          visited.add(next_pos)\n          parent[next_pos] = (curr_r, curr_c)\n          action_to_reach[next_pos] = action_val\n          final_agent_pos = next_pos\n          break # Exit inner (dr, dc) loop as we've found our target path\n\n      # If no target found yet within this iteration (either non-grabbable not at `curr_pos`,\n      # or grabbable not adjacent to `next_pos`):\n      # Add `next_pos` to queue for further exploration.\n      visited.add(next_pos)\n      q.append(next_pos)\n      parent[next_pos] = (curr_r, curr_c)\n      action_to_reach[next_pos] = action_val\n    \n    # If `final_agent_pos` was found in the inner loop, break from the outer BFS loop as well.\n    if final_agent_pos:\n      break\n\n  # --- Path Reconstruction ---\n  if final_agent_pos is None:\n    return [] # No path found to the primitive\n\n  actions_list = []\n  curr = final_agent_pos\n  # Reconstruct path from target back to start\n  while curr != current_pos:\n    if curr not in action_to_reach:\n      # This indicates an error in BFS or path reconstruction, should not happen if final_agent_pos was set.\n      return [] \n    action = action_to_reach[curr]\n    actions_list.append(action)\n    curr = parent[curr]\n  \n  actions_list.reverse() # Path was built backwards, reverse to get correct order\n\n  # --- Add USE action if necessary ---\n  if is_grabbable:\n    actions_list.append(env.action_specs()['USE'])\n\n  return actions_list", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:32:53.442115", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  # Get current state and relevant environment data\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, n_kinds = grid.shape\n\n  # Get primitive index\n  primitive_idx = env.world.cookbook.index(primitive)\n  if primitive_idx is None:\n      # Primitive not found in cookbook, cannot collect\n      return []\n\n  # Get action mappings\n  action_specs = env.action_specs()\n  UP = action_specs['UP']\n  DOWN = action_specs['DOWN']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Map move actions to (dx, dy) deltas\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  # Get boundary index for walkability check. If 'BOUNDARY' isn't a recognized kind,\n  # we assume all cells are traversable unless otherwise blocked by game mechanics.\n  boundary_idx = env.world.cookbook.index('BOUNDARY')\n\n  # BFS setup\n  queue = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_here)\n  visited = {start_pos}\n\n  while queue:\n      curr_pos, path_actions = queue.popleft()\n\n      # Check if the current position is within 3x3 neighborhood of the primitive.\n      # The `CraftState.next_to` method checks the 3x3 region. We simulate this check.\n      found_target_adjacent = False\n      for dx_check in [-1, 0, 1]:\n          for dy_check in [-1, 0, 1]:\n              check_x, check_y = curr_pos[0] + dx_check, curr_pos[1] + dy_check\n              \n              # Ensure check coordinates are within grid bounds\n              if (0 <= check_x < grid_width and\n                  0 <= check_y < grid_height):\n                  # Check if the primitive exists at the current 'check' location\n                  if grid[check_x, check_y, primitive_idx] > 0:\n                      found_target_adjacent = True\n                      break # Found primitive in neighborhood, agent can now perform USE\n          if found_target_adjacent:\n              break\n\n      if found_target_adjacent:\n          # If the agent is in a position to collect the primitive, perform USE\n          return path_actions + [USE]\n\n      # Explore neighbors\n      for action, (dx, dy) in move_deltas.items():\n          next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n          next_x, next_y = next_pos\n\n          # Check if the next position is within grid bounds\n          # And if it's not a boundary (if boundary is defined)\n          if (0 <= next_x < grid_width and\n              0 <= next_y < grid_height and\n              (boundary_idx is None or grid[next_x, next_y, boundary_idx] == 0) and\n              next_pos not in visited):\n\n              visited.add(next_pos)\n              new_path_actions = path_actions + [action]\n              queue.append((next_pos, new_path_actions))\n\n  # If the queue is exhausted and no path to the primitive was found\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:34:16.504008", "function_name": "collect", "function_body": "  # Action mappings from CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Direction mappings (North, East, South, West)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Delta for (row, col) changes based on direction\n  # This maps an agent's direction to the (dr, dc) tuple for moving forward.\n  DIR_TO_DELTA = {\n      DIR_NORTH: (-1, 0),  # Decreasing row (up in grid)\n      DIR_EAST: (0, 1),    # Increasing col (right in grid)\n      DIR_SOUTH: (1, 0),   # Increasing row (down in grid)\n      DIR_WEST: (0, -1)    # Decreasing col (left in grid)\n  }\n\n  state = env._current_state\n  grid = state.grid\n  H, W, _ = grid.shape\n\n  # Get the integer index for the target primitive\n  primitive_idx = env.world.cookbook.index(primitive)\n  \n  # If the primitive is already in the inventory, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # Get indices for non-walkable terrain.\n  # \"water\" is explicitly available. \"boundary\" might be.\n  water_idx = env.world.water_index\n  try:\n      boundary_idx = env.world.cookbook.index(\"BOUNDARY\")\n  except KeyError:\n      boundary_idx = -1 # Sentinel if \"BOUNDARY\" is not a named kind\n\n  def is_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is traversable.\"\"\"\n      if not (0 <= r < H and 0 <= c < W):\n          return False # Out of bounds\n      # Check if the cell contains non-walkable entities\n      if water_idx != -1 and grid[r, c, water_idx] > 0:\n          return False # Contains water\n      if boundary_idx != -1 and grid[r, c, boundary_idx] > 0:\n          return False # Contains explicit boundary\n      # Add other non-walkable items here if necessary (e.g., specific workshops not usable as paths)\n      return True\n\n  # BFS to find the shortest path to a primitive.\n  # State in BFS: ((row, col, direction), [actions_list_to_reach_this_state])\n  start_pos = state.pos\n  start_dir = state.dir\n  \n  queue = collections.deque([((start_pos[0], start_pos[1], start_dir), [])])\n  visited = set([(start_pos[0], start_pos[1], start_dir)]) # (r, c, d) tuples\n\n  target_actions = None # To store the found sequence of actions\n\n  while queue:\n      (r, c, d), path = queue.popleft()\n\n      # Check if we are currently next to the primitive and facing it.\n      # If so, the next action is USE, and we've found our path.\n      dr_forward, dc_forward = DIR_TO_DELTA[d]\n      target_r, target_c = r + dr_forward, c + dc_forward\n\n      if (0 <= target_r < H and 0 <= target_c < W and \n          grid[target_r, target_c, primitive_idx] > 0):\n          target_actions = path + [ACTION_USE]\n          break # Path found, exit BFS\n\n      # Explore possible next states by applying actions:\n\n      # 1. Move Forward (ACTION_UP)\n      nr_up, nc_up = r + dr_forward, c + dc_forward\n      if is_walkable(nr_up, nc_up) and (nr_up, nc_up, d) not in visited:\n          visited.add((nr_up, nc_up, d))\n          queue.append(((nr_up, nc_up, d), path + [ACTION_UP]))\n\n      # 2. Move Backward (ACTION_DOWN)\n      nr_down, nc_down = r - dr_forward, c - dc_forward # Opposite of forward\n      if is_walkable(nr_down, nc_down) and (nr_down, nc_down, d) not in visited:\n          visited.add((nr_down, nc_down, d))\n          queue.append(((nr_down, nc_down, d), path + [ACTION_DOWN]))\n\n      # 3. Turn Left (ACTION_LEFT)\n      nd_left = (d - 1 + 4) % 4 # Ensure direction wraps around 0-3\n      if (r, c, nd_left) not in visited: # Position doesn't change, only direction\n          visited.add((r, c, nd_left))\n          queue.append(((r, c, nd_left), path + [ACTION_LEFT]))\n\n      # 4. Turn Right (ACTION_RIGHT)\n      nd_right = (d + 1) % 4 # Ensure direction wraps around 0-3\n      if (r, c, nd_right) not in visited: # Position doesn't change, only direction\n          visited.add((r, c, nd_right))\n          queue.append(((r, c, nd_right), path + [ACTION_RIGHT]))\n\n  # Return the found path or an empty list if unreachable\n  if target_actions:\n      return target_actions\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:34:17.520338", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  \n  # Get the integer index for the primitive string\n  primitive_idx = env.world.cookbook.index(primitive)\n\n  # Determine if the primitive is one that can be \"grabbed\" (requires USE action)\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  agent_pos = current_state.pos # (x, y)\n\n  # Check if the agent is already in a position to collect the primitive.\n  # If next_to is true for the primitive_idx:\n  #   - If grabbable, add USE action.\n  #   - If not grabbable (e.g., WORKSHOP, WATER), it means we have \"collected\" (reached) it, so no further actions needed.\n  if current_state.next_to(primitive_idx):\n    if is_grabbable:\n      return [craft.USE]\n    else:\n      return [] # Already \"collected\" (reached) non-grabbable primitive\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive_idx] == 1:\n        primitive_locations.append((x, y))\n  \n  # If the primitive is not found anywhere, return empty actions\n  if not primitive_locations:\n    return []\n\n  # Determine all possible \"interaction cells\" where the agent could stand\n  # to be in the 3x3 neighborhood of a primitive instance.\n  interaction_cells = set()\n  for px, py in primitive_locations:\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx, ny = px + dx_adj, py + dy_adj\n        # Check boundaries for candidate interaction cells\n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n          interaction_cells.add((nx, ny))\n  \n  # If no valid interaction cells are found (e.g., primitive is outside grid, though unlikely)\n  if not interaction_cells:\n      return []\n\n  # BFS for pathfinding\n  # (current_x, current_y), list_of_actions_so_far\n  queue = collections.deque([(agent_pos, [])]) \n  visited = {agent_pos} # Set to store visited (x, y) tuples\n\n  # Mapping action constants to (dx, dy) changes\n  # Based on action_specs: DOWN->0, UP->1, LEFT->2, RIGHT->3\n  # And assuming (x, y) grid where x is horizontal, y is vertical, (0,0) is top-left\n  # UP: (x, y-1) -> dy = -1\n  # DOWN: (x, y+1) -> dy = 1\n  # LEFT: (x-1, y) -> dx = -1\n  # RIGHT: (x+1, y) -> dx = 1\n  MOVE_DELTAS = {\n      craft.DOWN: (0, 1),   \n      craft.UP: (0, -1),  \n      craft.LEFT: (-1, 0),  \n      craft.RIGHT: (1, 0),   \n  }\n  # List of movement actions (order doesn't matter for BFS)\n  MOVE_ACTIONS = [craft.DOWN, craft.UP, craft.LEFT, craft.RIGHT] \n\n  final_path_actions = None\n\n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Check if the current cell is one of the desired interaction cells.\n    # If the agent is at (curr_x, curr_y), then current_state.next_to(primitive_idx) would be True.\n    if (curr_x, curr_y) in interaction_cells:\n      final_path_actions = path_so_far\n      break # Path found\n\n    for action_type in MOVE_ACTIONS:\n      dx, dy = MOVE_DELTAS[action_type]\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if already visited\n      if (next_x, next_y) in visited:\n        continue\n      \n      # For simplicity, assuming all cells within bounds are traversable for movement.\n      # The simulation's `step` method handles collisions/impassable terrain if any.\n\n      visited.add((next_x, next_y))\n      queue.append(((next_x, next_y), path_so_far + [action_type]))\n  \n  if final_path_actions is None:\n    return [] # Cannot reach any primitive instance\n\n  # If a path was found and the primitive is grabbable, add the USE action at the end.\n  if is_grabbable:\n    final_path_actions.append(craft.USE)\n  \n  return final_path_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:35:49.502183", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  initial_grid = env._current_state.grid\n  initial_pos = env._current_state.pos  # (x, y) or (col, row)\n  \n  # Grid dimensions based on (WIDTH, HEIGHT, n_kinds)\n  # For a grid of shape (WIDTH, HEIGHT, n_kinds),\n  # grid[x, y] accesses the kinds at column x, row y.\n  grid_width = initial_grid.shape[0]\n  grid_height = initial_grid.shape[1]\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  \n  # BFS State: (current_position_tuple, path_taken_list)\n  # Position tuple is (x, y) / (col, row)\n  queue = collections.deque([(initial_pos, [])])\n  visited = {initial_pos} # Set of visited (x, y) positions\n\n  best_path_to_primitive = None\n\n  # Define movement actions and their (dx, dy) changes\n  # (dx, dy) = (change in x-coordinate, change in y-coordinate)\n  # UP: moves along y-axis negatively (y-1)\n  # DOWN: moves along y-axis positively (y+1)\n  # LEFT: moves along x-axis negatively (x-1)\n  # RIGHT: moves along x-axis positively (x+1)\n  moves = [\n      (craft.UP, (0, -1)),\n      (craft.DOWN, (0, 1)),\n      (craft.LEFT, (-1, 0)),\n      (craft.RIGHT, (1, 0))\n  ]\n\n  while queue:\n    current_pos, path = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if current_pos is next to the primitive\n    # This means any cell in the 3x3 neighborhood (including current) contains the primitive.\n    found_primitive_adjacent = False\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx_n, ny_n = cx + dx_n, cy + dy_n\n        \n        # Check boundary for the neighboring cell\n        if 0 <= nx_n < grid_width and 0 <= ny_n < grid_height:\n          # Check if the primitive exists at this neighboring cell\n          if initial_grid[nx_n, ny_n, primitive_id] == 1:\n            found_primitive_adjacent = True\n            break # Found an adjacent primitive, no need to check other neighbors for this position\n      if found_primitive_adjacent:\n        break # Exit outer loop as well\n\n    if found_primitive_adjacent:\n      # Found a path to a cell adjacent to the primitive.\n      # Since this is BFS, this path is the shortest.\n      if primitive_id in grabbable_indices:\n        # If the primitive is grabbable, add a USE action to collect it.\n        path.append(craft.USE) \n      best_path_to_primitive = path\n      break # Exit BFS loop, as the shortest path to goal is found.\n\n    # Explore valid neighbors by trying movement actions\n    for action, (dx, dy) in moves:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check boundary conditions for the new position\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # New position is out of bounds\n\n      # Check if the new position is occupied by a non-grabbable obstacle\n      is_obstacle = False\n      for k_idx in non_grabbable_indices:\n        if initial_grid[nx, ny, k_idx] == 1: # If this kind of obstacle exists at (nx, ny)\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # New position is blocked by an obstacle\n\n      # If the new position is valid and not an obstacle, add it to the queue if not visited\n      if new_pos not in visited:\n        visited.add(new_pos)\n        queue.append((new_pos, path + [action]))\n  \n  # Return the shortest path found, or an empty list if no path exists.\n  return best_path_to_primitive if best_path_to_primitive is not None else []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:35:50.499965", "function_name": "collect", "function_body": "  from collections import deque\n\n  def _bfs_to_collect_target(start_pos: tuple[int, int], target_idx: int, grid: np.ndarray, world_obj: craft.CraftWorld) -> list[int] | None:\n      \"\"\"\n      Performs a Breadth-First Search to find a path to a location\n      from which the target primitive can be collected (i.e., it's in the 3x3 neighborhood).\n\n      Args:\n          start_pos: The agent's starting (x, y) position.\n          target_idx: The integer index of the primitive to collect.\n          grid: The current grid state (WIDTH, HEIGHT, n_kinds).\n          world_obj: The CraftWorld instance, providing indices for water/stone.\n\n      Returns:\n          A list of action integers (UP, DOWN, LEFT, RIGHT) to reach the position,\n          followed by ACTION_USE, or None if no path is found.\n      \"\"\"\n      width, height = grid.shape[0], grid.shape[1]\n\n      q = deque([(start_pos, [])]) # (current_pos, path_so_far_actions)\n      visited = {start_pos}\n\n      # Maps action ID to delta_pos for movement\n      ACTION_DELTAS = {\n          craft.ACTION_DOWN: (0, 1),\n          craft.ACTION_UP: (0, -1),\n          craft.ACTION_LEFT: (-1, 0),\n          craft.ACTION_RIGHT: (1, 0)\n      }\n\n      # Directions for checking 3x3 neighborhood (including center)\n      # The agent needs to be at a (cx, cy) such that (px, py) is target and px,py is in 3x3 neighborhood of cx,cy\n      NEIGHBOR_DELTAS_3x3 = [\n          (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n      ]\n\n      while q:\n          current_pos, path = q.popleft()\n          cx, cy = current_pos\n\n          # Check if any cell in the 3x3 neighborhood of current_pos contains the target primitive\n          # This simulates `CraftState.next_to(target_idx)`\n          for ndx, ndy in NEIGHBOR_DELTAS_3x3:\n              px, py = cx + ndx, cy + ndy\n              if 0 <= px < width and 0 <= py < height and grid[px, py, target_idx] > 0:\n                  # Found a path to a position (current_pos) from which the primitive is \"next_to\".\n                  # Append the USE action and return the full sequence.\n                  return path + [craft.ACTION_USE]\n\n          # Explore neighbors for movement\n          for action_id, (move_dx, move_dy) in ACTION_DELTAS.items():\n              nx, ny = cx + move_dx, cy + move_dy\n\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  # Avoid moving onto water or stone, as these are typically impassable obstacles.\n                  if grid[nx, ny, world_obj.water_index] > 0 or grid[nx, ny, world_obj.stone_index] > 0:\n                      continue # Cannot move onto water or stone\n\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [action_id]))\n\n      return None # No path found\n\n  primitive_idx = env.world.cookbook.index(primitive)\n  current_state = env._current_state\n\n  # Perform BFS to find the path to the primitive\n  path_actions = _bfs_to_collect_target(\n      start_pos=current_state.pos,\n      target_idx=primitive_idx,\n      grid=current_state.grid,\n      world_obj=env.world # Pass the CraftWorld object for water/stone indices\n  )\n\n  if path_actions is None:\n    return [] # No path found to the primitive\n  else:\n    return path_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:37:22.182518", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos  # (x, y) in grid coordinates (col, row)\n  \n  grid_width, grid_height, _ = grid.shape # Extract dimensions from the grid shape\n\n  # Indices of entities that cannot be traversed through (e.g., boundaries, workshops, water if not swimmable)\n  obstacle_indices = env.world.non_grabbable_indices \n  \n  # Determine if the primitive itself is a grabbable item that can be picked up into inventory\n  is_primitive_grabbable = (primitive_id in env.world.grabbable_indices)\n  \n  # BFS State: (current_position_tuple, list_of_actions_to_reach_here)\n  # Position tuple is (x, y) / (col, row)\n  queue = collections.deque([(initial_pos, [])])\n  visited = {initial_pos} # Set of visited (x, y) positions to prevent cycles and redundant paths\n\n  # Define possible movement actions and their corresponding (dx, dy) coordinate changes\n  # (dx, dy) represents (change in x-coordinate, change in y-coordinate)\n  move_actions_with_deltas = [\n      (craft.UP, (0, -1)),    # Moving UP decreases the y-coordinate\n      (craft.DOWN, (0, 1)),   # Moving DOWN increases the y-coordinate\n      (craft.LEFT, (-1, 0)),  # Moving LEFT decreases the x-coordinate\n      (craft.RIGHT, (1, 0))   # Moving RIGHT increases the x-coordinate\n  ]\n\n  # Deltas to check the 3x3 neighborhood around the agent's current position,\n  # including the agent's own cell (0,0). This is used to determine if the primitive\n  # is 'next_to' the agent for the USE action.\n  adjacent_check_deltas = [\n      (-1, -1), (0, -1), (1, -1), # Top row of 3x3 neighborhood\n      (-1, 0),  (0, 0),  (1, 0),  # Middle row (includes current cell)\n      (-1, 1),  (0, 1),  (1, 1)   # Bottom row\n  ]\n\n  while queue:\n    current_pos, path_to_current_pos = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if the target primitive is located in any cell within the 3x3 neighborhood\n    # of the current position (cx, cy).\n    is_primitive_in_neighborhood = False\n    for dx_adj, dy_adj in adjacent_check_deltas:\n      nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n      \n      # Ensure the neighboring cell (nx_adj, ny_adj) is within grid boundaries\n      if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n        # Check if the primitive_id occupies this specific neighboring cell\n        if grid[nx_adj, ny_adj, primitive_id] == 1:\n          is_primitive_in_neighborhood = True\n          break # Found the primitive adjacent to or at the current position\n      if is_primitive_in_neighborhood:\n        break # Exit the outer loop as well, as an adjacent primitive has been found\n\n    if is_primitive_in_neighborhood:\n      # If the primitive is found in the neighborhood, this is the shortest path to be\n      # \"next to\" it (or on it). BFS guarantees this path is optimal in terms of moves.\n      \n      # Create a mutable copy of the path to append the USE action if necessary.\n      final_actions = list(path_to_current_pos) \n      \n      if is_primitive_grabbable:\n        # If the primitive can be collected (is grabbable), add the USE action\n        # as the final step to \"collect\" it.\n        final_actions.append(craft.USE) \n      return final_actions # Return the complete sequence of actions\n\n    # If the primitive is not in the current neighborhood, explore possible moves\n    for action, (dx, dy) in move_actions_with_deltas:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # 1. Check if the new position is within the grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # New position is out of bounds, skip this move\n\n      # 2. Check if the new position is blocked by any obstacle type\n      is_new_pos_obstructed = False\n      for k_idx in obstacle_indices:\n        # If any obstacle kind exists at the new position, it's considered blocked\n        if grid[nx, ny, k_idx] == 1: \n          is_new_pos_obstructed = True\n          break\n      if is_new_pos_obstructed:\n        continue # New position is an obstacle, skip this move\n\n      # 3. If the new position is valid (in-bounds and not obstructed) and not yet visited,\n      # add it to the BFS queue for further exploration.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        # Create a new path by appending the current action to the parent's path\n        queue.append((new_pos, path_to_current_pos + [action]))\n  \n  # If the BFS completes and the queue becomes empty without finding a path to the primitive,\n  # it means the primitive is unreachable from the initial position given the current grid.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:37:23.161987", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:38:20.295864", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Specifically, this version ensures the agent not only reaches a position\n  adjacent to the primitive but also is oriented to face the primitive\n  before executing the 'USE' action.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This mapping is used to calculate the cell *in front* of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (c)\n      1: (-1, 0),  # Facing UP, move in negative row direction (r)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (c)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (r)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define obstacles for movement:\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  \n  # If the target primitive itself is a grabbable item (e.g., WOOD, STONE),\n  # the agent should generally not walk directly onto its tile but instead\n  # interact with it from an adjacent position. Therefore, add it as an obstacle.\n  # This is crucial for 'collect' actions that use the 'USE' primitive to pick up items.\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id)\n  \n  # Optimization: If the primitive is already directly in front of the agent\n  # and is a grabbable item (as implied by 'collect'), just use it.\n  r, c = initial_pos\n  dr_facing, dc_facing = DIR_TO_DRDC[initial_dir]\n  front_r, front_c = r + dr_facing, c + dc_facing\n\n  if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n      initial_grid[front_r, front_c, primitive_id] > 0 and\n      primitive_id in current_state.world.grabbable_indices):\n      return [USE_ACTION]\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # *** NEW TARGET CONDITION for collect_v2 ***\n      # Check if the current position and direction allow collection of the primitive.\n      # This means the primitive must be in the cell directly in front of the agent\n      # AND it must be a grabbable item (as 'collect' implies picking up).\n      dr_facing, dc_facing = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_facing, c + dc_facing\n      \n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0 and\n          primitive_id in current_state.world.grabbable_indices):\n          \n          target_path = path_actions\n          break # Path to a position *and orientation* from which the primitive can be collected is found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any obstacle defined in obstacles_to_movement_indices\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position and orientation, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:38:21.294040", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (c)\n      1: (-1, 0),  # Facing UP, move in negative row direction (r)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (c)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (r)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # IMPORTANT CHANGE FOR V2:\n  # Define obstacles strictly as non-grabbable entities.\n  # This means grabbable primitives (like WOOD, STONE) are now considered traversable,\n  # allowing the agent to walk *onto* their tiles if needed for pathfinding,\n  # rather than only walking *around* them. This aligns with the \"improvement\"\n  # implied in the comments of `collect_v0` for `v2`.\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  # The logic from v1 that added `primitive_id` to `obstacles_to_movement_indices`\n  # if it was grabbable is explicitly omitted here.\n\n\n  # Optimization: If the primitive is already collectible from the current position, just use it.\n  # The `next_to` method checks the 3x3 neighborhood around the agent's position.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current position (r, c) is suitable for collecting the primitive.\n      # This means the primitive must be in the 3x3 neighborhood of (r, c).\n      # This logic manually replicates `CraftState.next_to` for efficiency within BFS.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if found_collectable_position:\n              break\n\n      if found_collectable_position:\n          target_path = path_actions\n          break # Path to a position from which the primitive can be collected is found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any obstacle defined in obstacles_to_movement_indices\n          for kind_idx in obstacles_to_movement_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:39:31.180225", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # The `collect` DSL command is specifically designed for grabbable resources (e.g., WOOD, STONE)\n  # that can be picked up and added to the agent's inventory. Workshops are for crafting,\n  # and boundaries/water are impassable or uncollectible.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve current state details for pathfinding.\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings for movement.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS exploration.\n  \n  # Offsets for checking the 3x3 neighborhood around a primitive,\n  # used to define 'collectible spots' where the agent can stand.\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Pre-compute a set of indices that represent truly blocking entities.\n  # This avoids repeated checks for water and workshops inside the `is_traversable` loop.\n  blocking_kind_indices = set()\n  for k_idx in env.world.non_grabbable_indices:\n      # Water is handled separately as a universal blocker.\n      # Workshops are generally traversable. Other non-grabbable items block movement.\n      if k_idx != env.world.water_index and k_idx not in env.world.workshop_indices:\n          blocking_kind_indices.add(k_idx)\n\n  # Helper function to determine if a grid cell is traversable.\n  def is_traversable(r, c):\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain blocking entities.\"\"\"\n      # Check bounds first.\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False\n\n      # Water is always an impassable obstacle.\n      if grid[r, c, env.world.water_index] == 1:\n          return False\n\n      # Check if any blocking kind is present at this cell.\n      # Use `np.where` to find all kinds present at (r,c) and check for intersection with blocking_kind_indices.\n      kinds_at_cell = np.where(grid[r, c] == 1)[0]\n      for k_idx in kinds_at_cell:\n          if k_idx in blocking_kind_indices:\n              return False\n      return True\n\n  # 2. Immediate Collection Check: If the agent is already adjacent to the primitive,\n  #    a single `USE` action is sufficient. This is an important optimization.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Locate all instances of the target primitive on the grid.\n  # `np.where` provides efficient indexing for this.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  target_primitive_locations = list(zip(primitive_rows, primitive_cols))\n\n  if not target_primitive_locations:\n    # The primitive is not present anywhere on the current map.\n    return []\n\n  # 4. Identify all \"collectible spots\": these are traversable grid cells from which\n  #    the agent can interact with the primitive (i.e., be in its 3x3 neighborhood).\n  collectible_spots = set()\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n      nr, nc = pr + dr, pc + dc # Candidate cell for the agent to stand on\n\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable or valid spots found where the agent can stand to collect the primitive.\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the `collectible_spots`.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, path_taken_actions_so_far)\n  visited = {current_pos} # Keep track of visited cells to prevent cycles and redundant paths.\n  path_to_collect_spot = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell is one of the target collectible spots, we've found the shortest path.\n    if (r, c) in collectible_spots:\n      path_to_collect_spot = current_path\n      break # Exit BFS as the optimal path is found.\n\n    # Explore valid cardinal (Up, Down, Left, Right) neighbors.\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct the final sequence of actions.\n  if path_to_collect_spot:\n    actions.extend(path_to_collect_spot)\n    # After reaching the collectible spot, a 'USE' action is required to acquire the grabbable primitive.\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:39:32.158352", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Resolve primitive name to its internal integer ID using the cookbook's index.\n  #    If the name is not recognized or if it's not a grabbable item,\n  #    then it cannot be 'collected' by this function's definition.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in the cookbook's index (e.g., misspelling).\n    return []\n\n  # The 'collect' DSL command is specifically designed for grabbable items\n  # (resources that typically go into the agent's inventory via a 'USE' action).\n  # Workshops (used for 'craft') and environmental features like water/boundary\n  # are not considered 'collectible' in this context.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve essential current state information from the environment.\n  current_state = env._current_state\n  agent_current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape # Unpack grid dimensions\n\n  # Define mappings for movement actions and grid offsets for navigation and spatial checks.\n  # `ACTION_MAP` links (dr, dc) tuple (change in row, change in column) to environment action constants.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Used for BFS to explore neighbors.\n  # `NEIGHBORHOOD_OFFSETS_3x3` covers a 3x3 area, including the center,\n  # representing positions from which an agent can 'USE' an adjacent item.\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Helper function to determine if a specific grid cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n    # Ensure the coordinates are within the grid boundaries.\n    if not (0 <= r < grid_width and 0 <= c < grid_height):\n      return False\n\n    # Water is typically an impassable obstacle.\n    if grid[r, c, env.world.water_index] == 1:\n      return False\n\n    # Check for any other non-grabbable entities that block movement.\n    # Workshops are generally traversable for interaction, so they don't block movement.\n    # Water is already handled above.\n    for k_idx in env.world.non_grabbable_indices:\n      if k_idx != env.world.water_index and k_idx not in env.world.workshop_indices:\n        if grid[r, c, k_idx] == 1:\n          return False # This cell contains a non-traversable obstacle.\n    return True\n\n  # 2. Immediate Collection Check:\n  #    If the agent is already in a position to 'USE' the primitive (i.e., adjacent to it),\n  #    a single 'USE' action is the most efficient solution.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Locate all instances of the target primitive on the current grid.\n  #    `np.where` provides an efficient way to find all (row, column) coordinates\n  #    where the primitive's kind is present (value is 1).\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  primitive_grid_locations = list(zip(primitive_rows, primitive_cols))\n\n  if not primitive_grid_locations:\n    # The primitive is not present anywhere on the current map.\n    return []\n\n  # 4. Identify all \"collectible spots\":\n  #    These are traversable grid cells from which the agent can successfully\n  #    interact with (i.e., 'USE') any instance of the target primitive.\n  #    For grabbable items, this implies being in the 3x3 neighborhood of the item.\n  collectible_spots = set()\n  for pr, pc in primitive_grid_locations: # For each detected instance of the primitive\n    for dr, dc in NEIGHBORHOOD_OFFSETS_3x3: # Check all 9 cells in its vicinity\n      potential_agent_pos_r, potential_agent_pos_c = pr + dr, pc + dc\n      if is_traversable(potential_agent_pos_r, potential_agent_pos_c):\n        collectible_spots.add((potential_agent_pos_r, potential_agent_pos_c))\n\n  if not collectible_spots:\n    # No traversable positions from which the agent can collect the primitive were found.\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the identified collectible spots.\n  q = collections.deque([(agent_current_pos, [])]) # Queue stores (current_position, path_of_actions_so_far)\n  visited = {agent_current_pos} # Set to keep track of visited cells to prevent cycles and redundant paths.\n  shortest_path_to_collectible = None # This will store the shortest sequence of actions found.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell is one of our target collectible spots, we've found the shortest path.\n    if (r, c) in collectible_spots:\n      shortest_path_to_collectible = current_path\n      break # Exit BFS, as the shortest path is guaranteed by BFS properties.\n\n    # Explore valid cardinal neighbors (Up, Down, Left, Right).\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      # Check if the neighbor is within grid bounds, has not been visited, and is traversable.\n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c)) # Mark the neighbor as visited.\n          # Add the neighbor to the queue with the updated path, including the action to reach it.\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct the final sequence of actions to return.\n  if shortest_path_to_collectible:\n    actions.extend(shortest_path_to_collectible)\n    # After reaching the collectible spot, perform the 'USE' action to collect the primitive.\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:40:36.142598", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index.getitem(primitive)\n  if primitive_id is None:\n    # Primitive not found in the cookbook, cannot collect it.\n    return []\n\n  action_map = env.action_specs()\n  # Ensure all required actions are present in the action map.\n  if not all(k in action_map for k in ['UP', 'DOWN', 'LEFT', 'RIGHT', 'USE']):\n    return [] # Malformed action map or missing essential actions.\n\n  move_actions_list = [action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT']]\n\n  # BFS: queue stores (current_CraftState, path_taken_so_far)\n  # We store the CraftState object itself to correctly use its .step() method\n  # which handles game logic like collisions and boundary checks.\n  q = collections.deque()\n  start_state = env._current_state\n  q.append((start_state, []))\n\n  # visited set stores (row, col) tuples to avoid re-exploring positions\n  # and prevent infinite loops. For simple movement, position is sufficient.\n  visited = {start_state.pos} \n\n  while q:\n    current_state, path_to_current = q.popleft()\n\n    # Check if the primitive is within the 3x3 neighborhood of the current agent position.\n    if current_state.next_to(primitive_id):\n      # If so, append the 'USE' action and return the complete path.\n      return path_to_current + [action_map['USE']]\n\n    # Explore possible movement actions from the current state.\n    for action in move_actions_list:\n      # Simulate taking an action using the CraftState's step method.\n      # The reward is not relevant for pathfinding in this context.\n      _reward, new_state = current_state.step(action)\n      \n      # Check two conditions for adding a new state to the queue:\n      # 1. new_state.pos != current_state.pos: This ensures the move was successful\n      #    (e.g., agent didn't walk into a wall or impassable object).\n      # 2. new_state.pos not in visited: This prevents cycles and avoids re-exploring\n      #    paths to already visited locations if a shorter path was found previously.\n      if new_state.pos != current_state.pos and new_state.pos not in visited:\n        visited.add(new_state.pos)\n        q.append((new_state, path_to_current + [action]))\n\n  # If the queue becomes empty and the primitive was not found/collected,\n  # it means the primitive is unreachable from the starting position.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:40:37.188618", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  primitive_idx = world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n  \n  # Action to delta_r, delta_c map for movement\n  _MOVE_DELTAS = {\n      env.action_specs()['DOWN']: (1, 0),\n      env.action_specs()['UP']: (-1, 0),\n      env.action_specs()['LEFT']: (0, -1),\n      env.action_specs()['RIGHT']: (0, 1),\n  }\n  \n  # Identify impassable terrain for pathfinding.\n  # Agent typically cannot move onto cells occupied by these non-grabbable items.\n  impassable_object_indices = world.non_grabbable_indices\n\n  q = collections.deque([(current_state.pos, [])]) # Queue stores ( (r, c), path_so_far )\n  visited = {current_state.pos} # Set of visited positions\n\n  # Helper function to check if a cell (r_agent, c_agent) is adjacent to the target primitive.\n  # \"Adjacent\" means within the 3x3 neighborhood, including the agent's current cell.\n  def is_adjacent_to_primitive(grid, r_agent, c_agent, p_idx, width, height):\n      for dr_nb in [-1, 0, 1]:\n          for dc_nb in [-1, 0, 1]:\n              nr, nc = r_agent + dr_nb, c_agent + dc_nb\n              # Check bounds for the neighbor cell\n              if 0 <= nr < width and 0 <= nc < height:\n                  # Check if the neighbor cell contains the primitive\n                  if grid[nr, nc, p_idx] == 1:\n                      return True\n      return False\n\n  # BFS loop to find the shortest path\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current position is adjacent to the target primitive\n      if is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n          # We found a path to a position from which we can interact with the primitive.\n          final_actions = list(path) # Make a copy of the path\n\n          # Determine if a 'USE' action is needed after reaching the adjacent position.\n          # The DSL's 'collect' implies acquiring the primitive.\n          # For grabbable items (like WOOD, IRON, etc.), WATER, or STONE, a 'USE' action is required\n          # to extract or pick up the resource.\n          # For workshops or boundaries, just being next to them is sufficient for 'collect'.\n          is_grabbable = primitive_idx in world.grabbable_indices\n          is_water_or_stone = (primitive_idx == world.water_index or primitive_idx == world.stone_index)\n          is_workshop = primitive_idx in world.workshop_indices\n          is_boundary = primitive_idx == world.cookbook.index['BOUNDARY']\n\n          if is_grabbable or is_water_or_stone:\n              final_actions.append(env.action_specs()['USE'])\n          # For workshops and boundaries, no USE action is appended as part of \"collect\".\n          # Crafting at workshops is handled by the `craft` function.\n\n          return final_actions\n      \n      # Explore neighbors for movement\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          # Check if the new position is within grid bounds\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the new position has already been visited\n          if (nr, nc) in visited:\n              continue\n\n          # Check traversability of the new position:\n          # A cell is generally considered traversable if it does not contain any impassable objects.\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[nr, nc, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell\n\n          # If traversable and not visited, add it to the queue\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action_id]))\n\n  # If the queue becomes empty and no path is found, return an empty list\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:41:51.398554", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` for more accurate walkability.\n  Specifically, distinguishes between collectible primitives that can be walked upon (e.g., WOOD, GRASS)\n  and those that act as impassable obstacles from which collection must happen adjacently (e.g., STONE, ROCK).\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Ensure the primitive is actually grabbable. If not, it cannot be collected.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT\n      1: (-1, 0),  # Facing UP\n      2: (0, -1),  # Facing LEFT\n      3: (1, 0)    # Facing DOWN\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define explicitly \"solid\" primitives that are grabbable but typically not walkable.\n  # This is based on common CraftWorld interpretations where some resources act like walls.\n  SOLID_PRIMITIVE_NAMES = {\"STONE\", \"ROCK\", \"GOLD\", \"GEM\"}\n  \n  # Determine the set of entity kinds that block agent movement.\n  # This set *always* includes non-grabbable environment features (like BOUNDARY, WATER, WORKSHOPS).\n  blocking_kind_ids = set(current_state.world.non_grabbable_indices)\n  \n  # If the target primitive itself is a \"solid\" type, the agent cannot walk onto its square.\n  # Add its ID to the set of blocking kinds for movement.\n  if primitive in SOLID_PRIMITIVE_NAMES:\n      blocking_kind_ids.add(primitive_id)\n\n  # Optimization: If the primitive is already collectible from the current position, just use it.\n  # The `next_to` method checks the 3x3 neighborhood around the agent's position.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # BFS for shortest path from initial_pos/dir to a position from which primitive can be collected.\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current (r, c) position is suitable for collecting the primitive.\n      # This means the primitive must be present in the 3x3 neighborhood of (r, c) on the initial grid.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the checked cell is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if found_collectable_position:\n              break\n\n      if found_collectable_position:\n          target_path = path_actions\n          break # Path to a position from which the primitive can be collected is found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable_to_next_cell = True\n          # Check if the next cell contains any kind that blocks movement (e.g., BOUNDARY, WATER, WORKSHOPS,\n          # or the target primitive itself if it's a solid type like STONE).\n          for kind_idx in blocking_kind_ids:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_to_next_cell = False\n                  break\n          \n          if is_walkable_to_next_cell:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action to complete the task.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:41:52.410145", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This version assumes the 'USE' action works on the cell directly in front of the agent.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # === Improvement from v1: Ensure the primitive is actually grabbable ===\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive is an entity that cannot be picked up (e.g., WORKSHOP, WATER, BOUNDARY),\n  # it cannot be \"collected\". In such cases, return an empty list immediately.\n  # The `grabbable_indices` is the authoritative source for what can be picked up.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' action typically means 'move forward' relative to agent's facing\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This mapping is also used to determine the coordinates of the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: cell in front is (r, c+1)\n      1: (-1, 0),  # Facing UP: cell in front is (r-1, c)\n      2: (0, -1),  # Facing LEFT: cell in front is (r, c-1)\n      3: (1, 0)    # Facing DOWN: cell in front is (r+1, c)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are true obstacles that the agent cannot walk through.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction)\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state (position + direction)\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # === Improvement for v2: Check if the primitive is directly in front of the agent ===\n      # This is the target condition for the BFS: reach a state (position, direction)\n      # where the primitive is in the cell immediately ahead.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r, target_c = r + front_dr, c + front_dc\n\n      is_primitive_in_front = False\n      if (0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and\n          initial_grid[target_r, target_c, primitive_id] > 0):\n          is_primitive_in_front = True\n\n      if is_primitive_in_front:\n          target_path = path_actions\n          break # Path to a suitable position and direction found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # This is the same as front_dr, front_dc for movement\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # A cell is walkable if it doesn't contain any non-grabbable entity (e.g., boundary, water, workshops).\n          # These are true obstacles.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # As in collect_v1, we do NOT check if the primitive itself blocks movement here.\n          # The agent can walk onto a cell containing a collectible primitive (e.g., grass, wood).\n          # This assumes that walkable primitives do not act as obstacles.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to a collectable position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:42:55.721656", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get primitive index\n  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # Primitive not found in cookbook, cannot collect\n      return []\n\n  current_state = env._current_state\n  \n  # If the primitive is non-grabbable (e.g., water, boundary, workshop), it cannot be collected into inventory.\n  # 'collect' implies putting an item into inventory. Workshops are interacted with for crafting, not collected.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  # BFS for pathfinding\n  q = collections.deque()\n  # Queue stores (row, col, path_to_here)\n  q.append((current_state.pos[0], current_state.pos[1], []))\n  \n  # Visited set to avoid cycles: (row, col)\n  visited = set([(current_state.pos[0], current_state.pos[1])])\n\n  # Mapping of relative movements to actions\n  # (dr, dc, action_const)\n  move_actions = [\n      (1, 0, craft.DOWN),\n      (-1, 0, craft.UP),\n      (0, -1, craft.LEFT),\n      (0, 1, craft.RIGHT)\n  ]\n\n  grid_height, grid_width, _ = current_state.grid.shape\n\n  best_path_to_adjacent = None\n\n  while q:\n      r, c, path_so_far = q.popleft()\n\n      # Check if current (r,c) is adjacent to the primitive\n      # We iterate through the 3x3 neighborhood around (r,c) on the actual grid\n      is_adjacent_to_primitive = False\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              # Don't check the current cell itself, only neighbors\n              if dr_adj == 0 and dc_adj == 0: continue \n\n              nr_adj, nc_adj = r + dr_adj, c + dc_adj\n              if 0 <= nr_adj < grid_height and 0 <= nc_adj < grid_width:\n                  if current_state.grid[nr_adj, nc_adj, primitive_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break\n          if is_adjacent_to_primitive:\n              break\n      \n      if is_adjacent_to_primitive:\n          # We found a path to a location from where the primitive can be collected\n          best_path_to_adjacent = path_so_far\n          break # Found shortest path, exit BFS\n\n      # Explore neighbors\n      for dr, dc, action in move_actions:\n          nr, nc = r + dr, c + dc\n\n          # Check boundaries\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n          \n          # Check if already visited\n          if (nr, nc) in visited:\n              continue\n          \n          # Check if the next cell is unwalkable (contains BOUNDARY or WATER)\n          boundary_idx = env.world.cookbook.index.get(\"BOUNDARY\")\n          water_idx = env.world.cookbook.index.get(\"WATER\")\n\n          is_unwalkable = False\n          if boundary_idx is not None and current_state.grid[nr, nc, boundary_idx] == 1:\n              is_unwalkable = True\n          if water_idx is not None and current_state.grid[nr, nc, water_idx] == 1:\n              is_unwalkable = True\n\n          if is_unwalkable:\n              continue\n\n          visited.add((nr, nc))\n          q.append((nr, nc, path_so_far + [action]))\n\n  if best_path_to_adjacent is not None:\n      actions.extend(best_path_to_adjacent)\n      actions.append(craft.USE) # Once adjacent, use to collect\n      \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:42:56.924946", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the integer ID for the primitive\n  primitive_idx = world.cookbook.index[primitive]\n\n  # BFS for pathfinding\n  # Queue stores (position, list_of_actions_to_reach_this_pos)\n  q = collections.deque([(start_pos, [])])\n  \n  # Set to store visited positions to avoid cycles and redundant exploration\n  visited = set([start_pos])\n\n  # Define possible moves and their corresponding (dx, dy) and action\n  move_options = {\n      (0, -1): craft.ACTION_UP,    # Moving Y-1 is UP\n      (0, 1): craft.ACTION_DOWN,   # Moving Y+1 is DOWN\n      (-1, 0): craft.ACTION_LEFT,  # Moving X-1 is LEFT\n      (1, 0): craft.ACTION_RIGHT   # Moving X+1 is RIGHT\n  }\n\n  # Iterate through the queue\n  while q:\n    curr_pos, path_so_far = q.popleft()\n    cx, cy = curr_pos\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position\n    # This implies that from curr_pos, we can use ACTION_USE to collect it.\n    found_primitive_adjacent = False\n    for dx_nb in range(-1, 2):\n      for dy_nb in range(-1, 2):\n        nx_nb, ny_nb = cx + dx_nb, cy + dy_nb\n        # Ensure neighbor is within grid bounds\n        if 0 <= nx_nb < grid_width and 0 <= ny_nb < grid_height:\n          # Check if this neighbor cell contains the primitive\n          if grid[nx_nb, ny_nb, primitive_idx] == 1:\n            found_primitive_adjacent = True\n            break # Found primitive in neighborhood, no need to check other neighbors\n      if found_primitive_adjacent:\n        break\n    \n    if found_primitive_adjacent:\n      # We are at a position from which we can collect the primitive.\n      # Append ACTION_USE to the path and return.\n      return path_so_far + [craft.ACTION_USE]\n\n    # Explore possible next moves (UP, DOWN, LEFT, RIGHT)\n    for delta, action in move_options.items():\n      dx, dy = delta\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if next_pos is within grid bounds and not visited\n      if (0 <= next_x < grid_width and 0 <= next_y < grid_height and\n          next_pos not in visited):\n        \n        # Check for obstacles (non-grabbable items that block movement)\n        is_obstacle = False\n        # Iterate through all non-grabbable indices to see if next_pos contains any of them\n        for kind_idx in world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_idx] == 1:\n            is_obstacle = True\n            break\n        \n        if not is_obstacle:\n          visited.add(next_pos)\n          q.append((next_pos, path_so_far + [action]))\n  \n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:44:18.926738", "function_name": "collect", "function_body": "  state = env._current_state\n  \n  # Get primitive index from the cookbook\n  primitive_idx = state.world.cookbook.index.getitem(primitive)\n  \n  # Handle cases where primitive is unknown, boundary, or already in inventory\n  if primitive_idx is None:\n    return [] # Unknown primitive\n  if primitive == \"BOUNDARY\":\n    return [] # Boundary cannot be collected\n  if state.inventory[primitive_idx] > 0:\n    return [] # Already collected, no actions needed\n\n  # Get grid dimensions (assuming grid.shape is (rows, cols, kinds))\n  height, width, _ = state.grid.shape\n\n  # Get action integer mappings\n  action_specs = env.action_specs()\n  USE_ACTION = action_specs['USE']\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n\n  # Define movement actions and their effect on position and new direction\n  # (dr, dc, new_dir) tuple for each action\n  # Directions: 0=North, 1=East, 2=South, 3=West\n  action_deltas = {\n      UP_ACTION: (-1, 0, 0),    # Move North (row - 1), new_dir = 0\n      DOWN_ACTION: (1, 0, 2),    # Move South (row + 1), new_dir = 2\n      LEFT_ACTION: (0, -1, 3),   # Move West (col - 1), new_dir = 3\n      RIGHT_ACTION: (0, 1, 1)    # Move East (col + 1), new_dir = 1\n  }\n\n  # Determine if the primitive is grabbable\n  is_grabbable = primitive_idx in state.world.grabbable_indices\n\n  # BFS setup\n  queue = collections.deque()\n  visited = set() # Stores (r, c, dir) tuples to avoid cycles and redundant paths\n\n  start_r, start_c = state.pos\n  start_d = state.dir\n\n  # Queue stores ((current_row, current_col, current_direction), path_list_so_far)\n  queue.append(((start_r, start_c, start_d), []))\n  visited.add((start_r, start_c, start_d))\n  \n  best_path = None # To store the first found (shortest) path to the goal\n\n  while queue and best_path is None:\n    curr_state_tuple, path_so_far = queue.popleft()\n    curr_r, curr_c, curr_d = curr_state_tuple\n\n    # --- Check if the current state can achieve the goal ---\n    # For non-grabbable items (e.g., WORKSHOP, WATER), agent must be adjacent and facing the item.\n    if not is_grabbable:\n      target_r_in_front, target_c_in_front = -1, -1 # Initialize to an invalid coordinate\n\n      # Calculate the coordinate directly in front of the agent\n      if curr_d == 0: # Facing North\n        target_r_in_front, target_c_in_front = curr_r - 1, curr_c\n      elif curr_d == 1: # Facing East\n        target_r_in_front, target_c_in_front = curr_r, curr_c + 1\n      elif curr_d == 2: # Facing South\n        target_r_in_front, target_c_in_front = curr_r + 1, curr_c\n      elif curr_d == 3: # Facing West\n        target_r_in_front, target_c_in_front = curr_r, curr_c - 1\n      \n      # Check if the cell in front is within bounds and contains the desired primitive\n      if (0 <= target_r_in_front < height and \n          0 <= target_c_in_front < width and \n          state.grid[target_r_in_front, target_c_in_front, primitive_idx] == 1.0):\n        best_path = path_so_far + [USE_ACTION]\n        break # Goal found, exit BFS\n\n    # For grabbable items (e.g., WOOD, STONE), agent must be on the same cell as the item.\n    elif is_grabbable:\n      if state.grid[curr_r, curr_c, primitive_idx] == 1.0:\n        best_path = path_so_far + [USE_ACTION]\n        break # Goal found, exit BFS\n\n    # --- Explore next possible states (movement actions) ---\n    for action, (dr, dc, new_d) in action_deltas.items():\n      next_r, next_c = curr_r + dr, curr_c + dc\n      next_state_tuple = (next_r, next_c, new_d)\n\n      # Check if the next position is within grid boundaries and if this state\n      # (position and direction) has not been visited yet\n      if (0 <= next_r < height and \n          0 <= next_c < width and \n          next_state_tuple not in visited):\n        visited.add(next_state_tuple)\n        queue.append((next_state_tuple, path_so_far + [action]))\n\n  # Return the found path or an empty list if no path was found\n  return best_path if best_path is not None else []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:44:20.064693", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    # Primitive not found on the grid, return an empty action list.\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells.\n  start_pos = current_state.pos\n  \n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  while q:\n    (cx, cy), path = q.popleft()\n\n    # If the current position is a goal cell, we have found a path\n    if (cx, cy) in goal_cells:\n      # Return the path to this cell, followed by the USE action\n      return path + [USE]\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and no path to a goal cell is found (should not happen\n  # for reachable primitives in a well-formed task), return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:45:04.169913", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    # Primitive not found on the grid, return an empty action list.\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells,\n  # considering impassable terrain.\n  start_pos = current_state.pos\n  \n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  # Identify impassable kinds for movement.\n  # We assume items that are non-grabbable AND are NOT workshops are impassable.\n  # This typically includes water, stone, and boundaries.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Check if this non-grabbable item is *not* a workshop\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft()\n\n    # If the current position is a goal cell, we have found a path\n    if (cx, cy) in goal_cells:\n      # Return the path to this cell, followed by the USE action\n      return path + [USE]\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability: A cell is impassable if it contains\n      # any kind from the 'impassable_kinds' set.\n      is_impassable = False\n      # Iterate through all kinds that *might* be at (nx, ny) that are in impassable_kinds\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and no path to a goal cell is found,\n  # it means the primitive is unreachable, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:45:05.411772", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` that accounts for obstacles (boundary and water).\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get indices for known obstacles\n  boundary_idx = env.world.cookbook.index.index('BOUNDARY')\n  water_idx = env.world.water_index\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    # Primitive not found on the grid, return an empty action list.\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells,\n  # avoiding obstacles.\n  start_pos = current_state.pos\n  \n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  while q:\n    (cx, cy), path = q.popleft()\n\n    # If the current position is a goal cell, we have found a path\n    if (cx, cy) in goal_cells:\n      # Return the path to this cell, followed by the USE action\n      return path + [USE]\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is an obstacle\n      is_obstacle = grid[nx, ny, boundary_idx] > 0 or grid[nx, ny, water_idx] > 0\n      if is_obstacle:\n          continue # Cannot walk through obstacles\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and no path to a goal cell is found, return an empty list.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:46:11.194969", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  primitive_idx = world.cookbook.index[primitive]\n\n  # V2 Improvement: Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n  \n  # Map movement actions to row/column delta for grid navigation.\n  _MOVE_DELTAS = {\n      env.action_specs()['DOWN']: (1, 0),\n      env.action_specs()['UP']: (-1, 0),\n      env.action_specs()['LEFT']: (0, -1),\n      env.action_specs()['RIGHT']: (0, 1),\n  }\n  \n  # Identify indices of objects that the agent cannot move through.\n  impassable_object_indices = world.non_grabbable_indices\n\n  # Initialize BFS queue with the current position and an empty path.\n  # Queue stores tuples of ((row, column), list_of_actions_to_reach_here).\n  q = collections.deque([(current_state.pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {current_state.pos}\n\n  # Helper function to check if a given grid cell (r_agent, c_agent)\n  # is adjacent (within a 3x3 neighborhood, including itself) to the target primitive.\n  # This simulates the logic of CraftState.next_to for an arbitrary position.\n  def _is_adjacent_to_primitive(grid, r_agent, c_agent, p_idx, width, height):\n      for dr_nb in [-1, 0, 1]:  # Iterate through 3x3 neighborhood rows\n          for dc_nb in [-1, 0, 1]:  # Iterate through 3x3 neighborhood columns\n              nr, nc = r_agent + dr_nb, c_agent + dc_nb\n              # Check if the neighbor cell is within grid bounds\n              if 0 <= nr < width and 0 <= nc < height:\n                  # Check if the primitive exists at the neighbor cell\n                  if grid[nr, nc, p_idx] == 1:\n                      return True\n      return False\n\n  # BFS loop to find the shortest path to a cell adjacent to the primitive.\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current position is adjacent to the primitive, we have found a path.\n      if _is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n          final_actions = list(path) # Duplicate the path to modify\n\n          # Determine if a 'USE' action is required after reaching the adjacent position.\n          # Primitives that are \"grabbable\" (like WOOD, IRON) or specific resources (WATER, STONE)\n          # generally require a 'USE' action to be collected.\n          # Other types, like workshops or boundaries, are considered \"collected\" just by being adjacent.\n          is_grabbable = primitive_idx in world.grabbable_indices\n          is_water_or_stone = (primitive_idx == world.water_index or primitive_idx == world.stone_index)\n          \n          if is_grabbable or is_water_or_stone:\n              final_actions.append(env.action_specs()['USE'])\n          \n          return final_actions # Return the sequence of actions\n\n      # Explore valid neighboring cells to move to\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate new row and column\n\n          # Check if the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the new position has already been visited in this BFS.\n          if (nr, nc) in visited:\n              continue\n\n          # Determine if the new position is traversable.\n          # A cell is traversable if it does not contain any impassable objects.\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[nr, nc, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell\n\n          # If the new position is valid and traversable, add it to the queue and mark as visited.\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action_id]))\n\n  # If the BFS completes without finding a path, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:46:12.192050", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  primitive_idx = world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, N_KINDS = current_state.grid.shape\n  \n  # Action to delta_r, delta_c map for movement\n  _MOVE_DELTAS = {\n      env.action_specs()['DOWN']: (1, 0),\n      env.action_specs()['UP']: (-1, 0),\n      env.action_specs()['LEFT']: (0, -1),\n      env.action_specs()['RIGHT']: (0, 1),\n  }\n  \n  # Identify impassable terrain for pathfinding.\n  # Pre-compute a 2D boolean mask for impassable cells for efficiency.\n  # If any of the non_grabbable_indices are present at a cell, that cell is impassable.\n  impassable_indices_list = list(world.non_grabbable_indices)\n  \n  # Create a mask indicating impassable cells on the grid.\n  if not impassable_indices_list:\n      # If there are no defined impassable objects, all cells are considered traversable.\n      impassable_mask = np.full((WIDTH, HEIGHT), False, dtype=bool)\n  else:\n      # Select the layers corresponding to impassable objects and check if any are present at each cell.\n      # This handles the case where `impassable_indices_list` contains valid indices.\n      # np.any(axis=-1) correctly handles the case where the slice results in an empty last dimension\n      # (e.g., if a primitive_idx is in impassable_indices_list but not in current_state.grid's depth).\n      # Assuming all indices in world.non_grabbable_indices are valid for the grid depth.\n      impassable_mask = current_state.grid[:, :, impassable_indices_list].any(axis=-1)\n\n  q = collections.deque([(current_state.pos, [])]) # Queue stores ( (r, c), path_so_far )\n  visited = {current_state.pos} # Set of visited positions to avoid cycles and redundant processing\n\n  # Helper function to check if a cell (r_agent, c_agent) is adjacent to the target primitive.\n  # \"Adjacent\" means within the 3x3 neighborhood, including the agent's current cell.\n  def is_adjacent_to_primitive(grid, r_agent, c_agent, p_idx, width, height):\n      for dr_nb in [-1, 0, 1]:\n          for dc_nb in [-1, 0, 1]:\n              nr, nc = r_agent + dr_nb, c_agent + dc_nb\n              # Check bounds for the neighbor cell\n              if 0 <= nr < width and 0 <= nc < height:\n                  # Check if the neighbor cell contains the primitive\n                  if grid[nr, nc, p_idx] == 1:\n                      return True\n      return False\n\n  # BFS loop to find the shortest path\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current position is adjacent to the target primitive\n      if is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n          # We found a path to a position from which we can interact with the primitive.\n          final_actions = list(path) # Make a copy of the path\n\n          # Determine if a 'USE' action is needed after reaching the adjacent position.\n          # The DSL's 'collect' implies acquiring the primitive.\n          # For grabbable items (like WOOD, IRON, etc.), WATER, or STONE, a 'USE' action is required\n          # to extract or pick up the resource.\n          # For workshops or boundaries, just being next to them is sufficient for 'collect'\n          # and no 'USE' action is typically performed as part of \"collection\" in the DSL.\n          is_grabbable_or_extractable = (primitive_idx in world.grabbable_indices or\n                                         primitive_idx == world.water_index or\n                                         primitive_idx == world.stone_index)\n          \n          if is_grabbable_or_extractable:\n              final_actions.append(env.action_specs()['USE'])\n          \n          return final_actions\n      \n      # Explore neighbors for movement\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          # Check if the new position is within grid bounds\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the new position has already been visited\n          if (nr, nc) in visited:\n              continue\n\n          # Check traversability of the new position using the pre-computed mask\n          if impassable_mask[nr, nc]:\n              continue # Cannot move into an impassable cell\n\n          # If traversable and not visited, add it to the queue\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action_id]))\n\n  # If the queue becomes empty and no path is found, return an empty list\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:47:30.450093", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current position (x, y)\n  start_dir = current_state.dir # Agent's initial facing direction (int, e.g., 0=UP, 1=DOWN, etc.)\n\n  # Helper function to calculate the coordinates of the cell the agent is facing\n  def _get_facing_coords(pos, direction):\n      x, y = pos\n      if direction == craft.UP:\n          return x, y - 1\n      elif direction == craft.DOWN:\n          return x, y + 1\n      elif direction == craft.LEFT:\n          return x - 1, y\n      elif direction == craft.RIGHT:\n          return x + 1, y\n      return x, y # Should not be reached with valid directions\n\n  # Get relevant indices from the cookbook\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # Get the index for boundary, assumed to be an obstacle for movement.\n  # This is consistent with how CraftWorld environments are typically set up.\n  boundary_idx = cookbook.index.index(\"boundary\") \n\n  # Define movement actions and their corresponding (delta_x, delta_y)\n  # In CraftWorld, performing a movement action (UP/DOWN/LEFT/RIGHT) also sets the agent's\n  # facing direction to that of the performed move.\n  moves = {\n      craft.UP: (0, -1),   # Move up: y decreases\n      craft.DOWN: (0, 1),    # Move down: y increases\n      craft.LEFT: (-1, 0),   # Move left: x decreases\n      craft.RIGHT: (1, 0)    # Move right: x increases\n  }\n\n  # Get grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y), current_direction, path_taken_so_far)\n  # The 'current_direction' is the direction the agent is FACING at (current_x, current_y)\n  # after having reached that position.\n  queue = collections.deque([((start_pos), start_dir, [])])\n  \n  # Visited set stores ((x, y), direction) tuples to prevent cycles and redundant exploration.\n  # This ensures we find the shortest path in terms of actions and reach the desired facing.\n  visited = {(start_pos, start_dir)}\n\n  while queue:\n    (x, y), current_dir, path = queue.popleft()\n\n    # --- Goal Check: Can we USE the primitive from the current position and direction? ---\n    # Calculate the coordinates of the cell the agent is currently facing\n    fx, fy = _get_facing_coords((x, y), current_dir)\n\n    # Check if the facing cell is within grid bounds\n    if 0 <= fx < grid_width and 0 <= fy < grid_height:\n      # Check if the primitive is present at the cell the agent is FACING\n      if grid[fx, fy, primitive_idx] > 0:\n        # If the primitive is directly in front, the next action should be USE\n        return path + [craft.USE]\n\n    # --- Explore possible movements from the current state ---\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n      \n      # After performing 'action', the agent's direction will be 'action' itself\n      # (e.g., moving UP makes the agent face UP).\n      next_dir = action \n      next_state_tuple = (next_pos, next_dir)\n\n      # Check validity of the next_pos:\n      # 1. Bounds check: Ensure new position is within the grid\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Traversability check: Ensure the cell is not an obstacle (e.g., boundary)\n      if grid[next_x, next_y, boundary_idx] > 0:\n        continue # Cannot move into a boundary cell\n      \n      # 3. Visited check: Avoid revisiting already explored (position, direction) states\n      if next_state_tuple in visited:\n        continue\n\n      # If all checks pass, add the new state to the queue and mark as visited\n      visited.add(next_state_tuple)\n      queue.append((next_pos, next_dir, path + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:47:31.429046", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index.index(primitive)\n\n  # Improvement for v2: Ensure the requested primitive is actually grabbable.\n  # If it's a non-grabbable entity (like \"water\", \"boundary\", or a \"workshop\"),\n  # it cannot be \"collected\" into inventory. In such cases, return an empty list.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # The remaining logic is a BFS-based pathfinding, similar to collect_v0,\n  # which efficiently finds the shortest path to an adjacent grabbable primitive\n  # and includes the 'USE' action.\n\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's current position (x, y)\n\n  # Get the index for \"boundary\" to identify impassable terrain\n  boundary_idx = cookbook.index.index(\"boundary\")\n\n  # Define movement actions and their corresponding (delta_x, delta_y) for grid traversal\n  moves = {\n      craft.UP: (0, -1),   # Move up: y decreases\n      craft.DOWN: (0, 1),    # Move down: y increases\n      craft.LEFT: (-1, 0),   # Move left: x decreases\n      craft.RIGHT: (1, 0)    # Move right: x increases\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y), path_taken_so_far)\n  queue = collections.deque([(start_pos, [])])\n  # Set of visited positions to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  while queue:\n    (x, y), path = queue.popleft()\n\n    # Check if the target primitive is in the 3x3 neighborhood of the current position (x, y)\n    found_adjacent_primitive = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n        # Check if the adjacent cell is within grid bounds\n        if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n          # Check if the primitive is present at this adjacent cell (count > 0)\n          if grid[nx_adj, ny_adj, primitive_idx] > 0:\n            found_adjacent_primitive = True\n            break # Found primitive in neighborhood, no need to check further adjacent cells\n      if found_adjacent_primitive:\n        break # Found primitive, break out of outer loop too\n\n    if found_adjacent_primitive:\n      # If the primitive is adjacent (and confirmed grabbable earlier),\n      # the next action should be USE to collect it.\n      return path + [craft.USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT) for movement\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n\n      # 1. Bounds check: Ensure new position is within the grid\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting already explored positions to find shortest path\n      if next_pos in visited:\n        continue\n\n      # 3. Traversability check: Ensure the cell is not an obstacle (e.g., boundary)\n      if grid[next_x, next_y, boundary_idx] > 0:\n        continue # Cannot move into a boundary cell\n\n      # If all checks pass, add the new position to the queue and mark as visited\n      visited.add(next_pos)\n      queue.append((next_pos, path + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:48:29.408791", "function_name": "collect", "function_body": "  # 1. Get current CraftState\n  current_state = env._current_state\n\n  # 2. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 3. Define action integers using the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of possible movement actions\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_tuple, direction_integer) to avoid cycles\n  # We use (pos, dir) as the key because moving only changes these, not the grid/inventory\n  # for the purpose of finding the item's location.\n  visited = set()\n\n  # Initial state: current_state with an empty path\n  q.append((current_state, []))\n  visited.add((current_state.pos, current_state.dir))\n\n  # Define a maximum search depth to prevent infinite loops for unreachable items.\n  # A reasonable upper bound is the total number of unique (position, direction) states.\n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = current_state.grid.shape\n  max_search_depth = grid_width * grid_height * 4 # Max cells * 4 directions\n\n  while q:\n    state, path = q.popleft()\n\n    # Check if we are currently next to the desired primitive\n    if state.next_to(i_kind):\n      # If so, we've found the path to get next to it.\n      # To collect it, we need to append the USE action.\n      return path + [USE_ACT]\n\n    # Pruning: If the current path is too long, it's likely a cycle or very inefficient.\n    # This also acts as a safeguard against exploring too deep if the item is unreachable.\n    if len(path) >= max_search_depth:\n      continue # Skip exploring further from this path\n\n    # Explore possible movement actions from the current state\n    for action in move_actions:\n      # Simulate the action to get the next state\n      # state.step(action) returns (reward, new_state)\n      _, next_state = state.step(action)\n\n      # Create a key for the next state to check if it has been visited\n      next_state_key = (next_state.pos, next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and the primitive was not found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:48:30.468183", "function_name": "collect", "function_body": "  # Helper function to check if a given position is next to the target primitive\n  def _is_next_to_at_pos(check_pos, i_kind, grid_data):\n      cx, cy = check_pos\n      WIDTH, HEIGHT, _ = grid_data.shape\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = cx + dx, cy + dy\n              # Check bounds\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  # If the primitive exists at this neighbor cell (including current cell)\n                  if grid_data[nx, ny, i_kind] > 0:\n                      return True\n      return False\n\n  # 1. Get primitive index\n  # Convert the DSL string (e.g., \"WOOD\") to its internal integer ID.\n  # The cookbook likely stores names in lowercase, so convert `primitive` to lowercase.\n  try:\n      i_primitive = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n      # If the primitive name is not recognized by the cookbook, it cannot be collected.\n      return []\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define action mappings for BFS movement\n  ACTION_TO_DELTAS = {\n      craft.DOWN: (0, 1),\n      craft.UP: (0, -1),\n      craft.LEFT: (-1, 0),\n      craft.RIGHT: (1, 0),\n  }\n  MOVE_ACTIONS = [craft.DOWN, craft.UP, craft.LEFT, craft.RIGHT]\n\n  # BFS Initialization\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])])\n  # Set to keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS Loop\n  while q:\n      curr_pos, path_to_curr_pos = q.popleft()\n\n      # Check if the agent, if at `curr_pos`, would be next to the primitive\n      if _is_next_to_at_pos(curr_pos, i_primitive, grid):\n          # If true, we've found a path to a position from which we can \"collect\" (USE) the primitive.\n          return path_to_curr_pos + [craft.USE]\n\n      # Explore all possible move actions from the current position\n      for action in MOVE_ACTIONS:\n          dx, dy = ACTION_TO_DELTAS[action]\n          next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries\n          if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n              # Check if this position has already been visited\n              if next_pos not in visited:\n                  visited.add(next_pos)\n                  # Add the next position and its accumulated path to the queue\n                  q.append((next_pos, path_to_curr_pos + [action]))\n  \n  # If the BFS completes without finding a path to the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:49:23.670864", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  current_state = env._current_state\n  current_grid = current_state.grid\n  current_pos_x, current_pos_y = current_state.pos\n\n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # If the primitive name is not recognized by the environment's cookbook, it cannot be collected.\n    return []\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n\n  # Determine if the primitive itself is grabbable or non-grabbable (e.g., an environmental feature)\n  is_primitive_grabbable = primitive_idx in grabbable_indices\n  is_primitive_non_grabbable = primitive_idx in non_grabbable_indices\n\n  # If the primitive is neither grabbable nor non-grabbable (i.e., not a known 'kind'),\n  # then it cannot be collected. This check is mostly for robustness.\n  if not (is_primitive_grabbable or is_primitive_non_grabbable):\n      return []\n\n  # --- 1. Determine all target cells for BFS based on primitive type ---\n  # These are the cells the agent needs to pathfind to before performing ACTION_USE.\n  goal_positions_for_bfs = set()\n\n  # Define possible movement deltas for checking neighbors (used for non-grabbable primitives)\n  neighbor_deltas = [\n      (0, -1), # North (x, y-1)\n      (0, 1),  # South (x, y+1)\n      (-1, 0), # West (x-1, y)\n      (1, 0)   # East (x+1, y)\n  ]\n\n  for px in range(WIDTH):\n    for py in range(HEIGHT):\n      # If this cell contains an instance of the target primitive\n      if current_grid[px, py, primitive_idx] == 1:\n        if is_primitive_grabbable:\n          # If the primitive is grabbable, the agent must move directly onto its cell to collect.\n          goal_positions_for_bfs.add((px, py))\n        elif is_primitive_non_grabbable:\n          # If the primitive is non-grabbable (e.g., a tree, rock, workshop),\n          # the agent must move to a traversable cell *adjacent* to it.\n          for dx, dy in neighbor_deltas:\n            nx, ny = px + dx, py + dy\n            # Check if neighbor is within grid boundaries\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n              # Check if the neighbor cell is traversable (i.e., doesn't contain any impassable objects)\n              is_neighbor_traversable = True\n              for k_idx in non_grabbable_indices:\n                # If the neighbor cell (nx, ny) contains any non-grabbable item, it's impassable.\n                # Note: This means the agent cannot move *through* or *onto* other non-grabbable items.\n                if current_grid[nx, ny, k_idx] == 1:\n                  is_neighbor_traversable = False\n                  break\n              if is_neighbor_traversable:\n                goal_positions_for_bfs.add((nx, ny))\n  \n  # If no primitive instances were found on the grid, or all potential goal positions are blocked,\n  # the set will be empty.\n  if not goal_positions_for_bfs:\n    return []\n\n  # --- 2. Breadth-First Search (BFS) to find the shortest path to any goal cell ---\n  q = collections.deque() # Queue for BFS: stores ((x, y), [actions_to_reach_here])\n  visited = set()         # Set to keep track of visited grid cells (x, y)\n\n  # Start BFS from the agent's current position with an empty action path\n  start_position = (current_pos_x, current_pos_y)\n  q.append((start_position, []))\n  visited.add(start_position)\n\n  # Define possible movements (change in x, change in y, corresponding action)\n  move_actions = [\n      (0, -1, ACTION_UP),\n      (0, 1, ACTION_DOWN),\n      (-1, 0, ACTION_LEFT),\n      (1, 0, ACTION_RIGHT)\n  ]\n\n  while q:\n    (x, y), actions_so_far = q.popleft()\n\n    # Check if the current cell (x, y) is one of our determined goal positions\n    if (x, y) in goal_positions_for_bfs:\n      # We've found the shortest path to a valid position to collect the primitive.\n      # Append the USE action as the final step.\n      return actions_so_far + [ACTION_USE]\n\n    # Explore valid neighboring cells\n    for dx, dy, action_move in move_actions:\n      nx, ny = x + dx, y + dy # Calculate neighbor's coordinates\n      next_position = (nx, ny)\n\n      # 1. Check if the neighbor is within grid boundaries\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # 2. Check if the neighbor has already been visited\n      if next_position in visited:\n        continue\n\n      # 3. Check if the neighbor cell is traversable for movement\n      # A cell is considered impassable for movement if it contains any non-grabbable item.\n      is_impassable_for_movement = False\n      for k_idx in non_grabbable_indices:\n        if current_grid[nx, ny, k_idx] == 1:\n          is_impassable_for_movement = True\n          break\n      \n      if is_impassable_for_movement:\n        continue\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue and mark it as visited.\n      visited.add(next_position)\n      q.append((next_position, actions_so_far + [action_move]))\n\n  # If the BFS completes and no path to a goal position was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:49:24.851982", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  try:\n    primitive_id = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # If the primitive name is not found in the cookbook index, it's not a valid item.\n    return []\n\n  # Check if the primitive is something that can actually be picked up.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  # Impassable kinds are those that cannot be moved through (e.g., water, stone walls).\n  impassable_kind_ids = env.world.non_grabbable_indices\n\n  # BFS setup: queue stores (current_position, list_of_actions_to_reach_here)\n  q = collections.deque()\n  # visited set stores (x, y) coordinates to avoid cycles and redundant processing\n  visited = set()\n\n  # Start BFS from the agent's current position\n  q.append((current_pos, []))\n  visited.add(current_pos)\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy, action) where dx is change in x, dy is change in y\n  movements = [\n      (0, -1, ACTION_UP),    # Move North (decrease y)\n      (0, 1, ACTION_DOWN),   # Move South (increase y)\n      (-1, 0, ACTION_LEFT),  # Move West (decrease x)\n      (1, 0, ACTION_RIGHT)   # Move East (increase x)\n  ]\n\n  while q:\n    (curr_x, curr_y), actions_path = q.popleft()\n\n    # Check if the current cell contains the target primitive\n    if grid[curr_x, curr_y, primitive_id] == 1:\n      # If found, append the USE action and return the complete path\n      return actions_path + [ACTION_USE]\n\n    # Explore neighbors\n    for dx, dy, move_action in movements:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # 1. Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # 3. Check if the next position contains any impassable obstacles\n      is_obstacle = False\n      for obstacle_kind_id in impassable_kind_ids:\n        if grid[next_x, next_y, obstacle_kind_id] == 1:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue\n\n      # If the neighbor is valid (within bounds, not visited, and traversable),\n      # add it to the queue and mark as visited.\n      visited.add(next_pos)\n      q.append((next_pos, actions_path + [move_action]))\n\n  # If the queue becomes empty and the primitive was not found in any accessible location,\n  # it means it's unreachable.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:50:32.093298", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  # Raises KeyError if the primitive name is not found in the index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions\n  # Mapping: Action -> (row_change, col_change)\n  DELTAS = {\n      UP: (-1, 0),    # Moving UP decreases row index\n      DOWN: (1, 0),   # Moving DOWN increases row index\n      LEFT: (0, -1),  # Moving LEFT decreases col index\n      RIGHT: (0, 1)   # Moving RIGHT increases col index\n  }\n\n  # 1. Check if the agent is already next to the primitive\n  # If so, a single 'USE' action is sufficient.\n  if current_state.next_to(primitive_id):\n      actions.append(USE)\n      return actions\n\n  # 2. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id occupies this cell\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, return an empty list\n  if not primitive_locations:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell adjacent to any primitive location.\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles\n\n  target_adj_pos_path = None # Stores the path to the adjacent cell once found\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is adjacent to any of the primitive locations\n      # We need to be able to 'USE' the primitive from here, which means being directly next to it.\n      for pr, pc in primitive_locations:\n          # Manhattan distance of 1 means the cells are directly adjacent (horizontally or vertically)\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path # This path leads to a cell from which we can USE the primitive\n              break # Found the shortest path to an adjacent cell, so break from this inner loop\n      \n      if target_adj_pos_path is not None:\n          break # Exit BFS, as the shortest path to an adjacent cell has been found\n\n      # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc # New potential position\n\n          # Check bounds: Ensure the new position is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is considered non-traversable if it contains any item\n          # whose kind index is in the world's non_grabbable_indices set.\n          # These are typically obstacles like BOUNDARY, WATER, or static WORKSHOP structures.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: # If this cell contains a non-grabbable item\n                  is_traversable = False\n                  break # This neighbor is an obstacle\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle\n          \n          # If the neighbor has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = path + [action_dir]\n              q.append(((nr, nc), new_path))\n    \n  # 4. If a path to an adjacent cell was found, extend the actions list with this path\n  #    and then append a 'USE' action to actually collect the primitive.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      actions.append(USE) # Perform 'USE' action once adjacent to the primitive\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:50:33.083507", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the current state directly for grid and position information\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos\n  \n  # Get the integer ID of the primitive from the cookbook index\n  primitive_id = env.world.cookbook.index[primitive]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Retrieve action mapping from the environment for robustness\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Define movement deltas for convenience for the 4 cardinal directions\n  DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # 1. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for r in range(WIDTH):\n      for c in range(HEIGHT):\n          # Check if the primitive_id occupies this cell\n          if grid[r, c, primitive_id] == 1:\n              primitive_locations.append((r, c))\n\n  # If the primitive is not found anywhere on the grid, return an empty list\n  if not primitive_locations:\n      return []\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    to a cell cardinally adjacent to any primitive location.\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_here])\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} \n\n  target_adj_pos_path = None \n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Check if the current position (r, c) is cardinally adjacent to any of the primitive locations.\n      # This implicitly handles the case where the agent starts already adjacent (path will be empty).\n      for pr, pc in primitive_locations:\n          if abs(r - pr) + abs(c - pc) == 1: \n              target_adj_pos_path = path \n              break \n      \n      if target_adj_pos_path is not None:\n          break \n\n      # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n      for action_dir, (dr, dc) in DELTAS.items():\n          nr, nc = r + dr, c + dc \n          next_pos = (nr, nc)\n\n          # Check bounds: Ensure the new position is within the grid boundaries\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n          \n          # Check traversability:\n          # A cell is considered non-traversable if it contains any item\n          # whose kind index is in the world's non_grabbable_indices set.\n          is_traversable = True\n          for i_kind in env.world.non_grabbable_indices:\n              if grid[nr, nc, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue \n          \n          # If the neighbor has not been visited, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = path + [action_dir]\n              q.append(((nr, nc), new_path))\n    \n  # 3. If a path to an adjacent cell was found, extend the actions list with this path\n  #    and then append a 'USE' action to actually collect the primitive, if it's grabbable.\n  if target_adj_pos_path is not None:\n      actions.extend(target_adj_pos_path)\n      # Append USE only if the primitive is a grabbable item\n      if primitive_id in current_state.world.grabbable_indices:\n          actions.append(USE) \n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:51:28.507898", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's current (x, y) position as (int, int)\n  current_grid = current_state.grid  # The full grid, shape (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = current_grid.shape\n\n  try:\n    # Get the integer ID for the target primitive from the cookbook index\n    primitive_id = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n    # If the primitive name is not found, we cannot collect it.\n    return []\n\n  # Define what constitutes an \"impassable\" obstacle for agent movement.\n  # These are entities that the agent cannot move onto.\n  impassable_ids = env.world.non_grabbable_indices\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_agent_position, path_taken_so_far_as_action_list)\n  queue = collections.deque([(start_pos, [])])\n  # Visited set stores agent positions (x, y) to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # Define possible agent moves and their corresponding (dx, dy) changes\n  move_actions_map = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  while queue:\n    current_agent_pos, path_to_current_pos = queue.popleft()\n    cx, cy = current_agent_pos\n\n    # Check if the target primitive is in the 3x3 neighborhood of the current agent position.\n    # This is equivalent to `CraftState.next_to(primitive_id)` if the agent were at `current_agent_pos`.\n    primitive_in_neighborhood = False\n    for dx_nb in [-1, 0, 1]:\n      for dy_nb in [-1, 0, 1]:\n        nx_nb, ny_nb = cx + dx_nb, cy + dy_nb\n\n        # Check bounds for the cell being inspected for the primitive\n        if 0 <= nx_nb < grid_width and 0 <= ny_nb < grid_height:\n          # If the primitive exists in this neighboring cell (quantity > 0)\n          if current_grid[nx_nb, ny_nb, primitive_id] > 0:\n            primitive_in_neighborhood = True\n            break # Found the primitive in the neighborhood, no need to check further offsets\n      if primitive_in_neighborhood:\n        break # Found the primitive in the neighborhood, no need to check further dy_nb\n\n    if primitive_in_neighborhood:\n      # If the primitive is found in the 3x3 neighborhood, we have reached a \"collectable\" position.\n      # Append the USE_ACTION to pick up/interact with the primitive and return the full path.\n      return path_to_current_pos + [ACTION_USE]\n\n    # If not at a collection point, explore neighboring cells for movement\n    for action, (dx, dy) in move_actions_map.items():\n      next_agent_pos_x, next_agent_pos_y = cx + dx, cy + dy\n      next_agent_pos = (next_agent_pos_x, next_agent_pos_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_agent_pos_x < grid_width and 0 <= next_agent_pos_y < grid_height):\n        continue\n\n      # Check if the next position has already been visited in the BFS\n      if next_agent_pos in visited:\n        continue\n\n      # Check if the next position contains any impassable terrain (obstacle).\n      # The agent cannot move onto a cell if it contains an item from `impassable_ids`.\n      is_obstacle_at_next_pos = False\n      for kind_id in impassable_ids:\n        # If the cell contains any impassable item, it's an obstacle for movement\n        if current_grid[next_agent_pos_x, next_agent_pos_y, kind_id] > 0:\n          is_obstacle_at_next_pos = True\n          break\n\n      if is_obstacle_at_next_pos:\n        continue  # Skip this move if it leads to an impassable cell\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue\n      visited.add(next_agent_pos)\n      queue.append((next_agent_pos, path_to_current_pos + [action]))\n\n  # If the queue becomes empty and no path to a \"useable\" primitive location was found,\n  # return an empty list of actions, indicating the primitive is unreachable.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:51:29.490323", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map[\"UP\"]\n  ACTION_DOWN = action_map[\"DOWN\"]\n  ACTION_LEFT = action_map[\"LEFT\"]\n  ACTION_RIGHT = action_map[\"RIGHT\"]\n  ACTION_USE = action_map[\"USE\"]\n\n  # Get current state information and grid dimensions\n  current_state = env._current_state\n  current_pos_x, current_pos_y = current_state.pos\n  current_grid = current_state.grid # Use the grid from the current state for consistency\n  grid_width, grid_height, _ = current_grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    # Assuming the primitive names in the DSL (e.g., 'WOOD', 'WORKSHOP0')\n    # match the case used in the cookbook's index.\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Determine if the target primitive is a grabbable item (requires USE action).\n  # Items like WOOD, IRON are grabbable. Workshops, water are not.\n  is_grabbable_primitive = (primitive_idx in env.world.grabbable_indices)\n  \n  # Define indices for entities that the agent generally cannot move onto.\n  # These act as obstacles for pathfinding.\n  # However, if the target primitive itself is in this list (e.g., a WORKSHOP),\n  # the agent *should* be able to move onto its location to \"collect\" it.\n  impassable_for_movement_indices = env.world.non_grabbable_indices\n\n  # Define possible movements and their corresponding actions (dx, dy, action)\n  move_actions = [\n      (0, -1, ACTION_UP),    # Move North (decreases y)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x)\n      (1, 0, ACTION_RIGHT)   # Move East (increases x)\n  ]\n\n  # Offsets for checking the 3x3 neighborhood around the agent (including the agent's cell itself).\n  # This is used for checking grabbable items which typically need to be adjacent.\n  neighborhood_offsets = [(dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]]\n\n  # BFS initialization for pathfinding\n  # Queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(current_pos_x, current_pos_y), []])\n  # Visited set stores positions (x, y) to avoid cycles and redundant exploration\n  visited = {(current_pos_x, current_pos_y)}\n\n  while queue:\n    (x, y), actions_so_far = queue.popleft()\n\n    # --- Goal Check ---\n    # Determine if the current position (x, y) allows \"collection\" of the primitive.\n\n    if is_grabbable_primitive:\n      # For grabbable items, check if the primitive is in the 3x3 neighborhood\n      # of the current agent position.\n      found_primitive_in_neighborhood = False\n      for ndx, ndy in neighborhood_offsets:\n        nx_item, ny_item = x + ndx, y + ndy\n        # Check bounds for the potential item location\n        if 0 <= nx_item < grid_width and 0 <= ny_item < grid_height:\n          if current_grid[nx_item, ny_item, primitive_idx] == 1:\n            found_primitive_in_neighborhood = True\n            break # Primitive found in neighborhood\n      \n      if found_primitive_in_neighborhood:\n        # If found, append the USE action after reaching this position and return the path.\n        return actions_so_far + [ACTION_USE]\n\n    else:\n      # For non-grabbable items (e.g., workshops, water, stone),\n      # \"collecting\" means simply reaching the cell where the primitive is located.\n      if current_grid[x, y, primitive_idx] == 1:\n        # Return the path to this location. No USE action is typically needed.\n        return actions_so_far\n\n    # --- Explore Neighbors ---\n    # If the current position is not a goal, explore valid adjacent cells to move to.\n    for dx_move, dy_move, action_move in move_actions:\n      nx, ny = x + dx_move, y + dy_move\n      next_pos = (nx, ny)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Check for obstacles at the next position.\n      # A cell is considered an obstacle for movement if it contains any non-grabbable item\n      # that is NOT the primitive we are trying to collect. This allows the agent to move\n      # onto the target primitive's tile if it's a non-grabbable entity like a workshop.\n      is_obstacle_at_next_pos = False\n      for kind_id in impassable_for_movement_indices:\n        if kind_id != primitive_idx and current_grid[nx, ny, kind_id] == 1:\n          is_obstacle_at_next_pos = True\n          break\n      \n      if is_obstacle_at_next_pos:\n        continue # Skip this move if it leads to an impassable obstacle\n\n      # If the move is valid (within bounds, not visited, not an impassable obstacle),\n      # add it to the queue and mark as visited.\n      visited.add(next_pos)\n      queue.append((next_pos, actions_so_far + [action_move]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:52:58.847285", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:52:59.878855", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 1. Map the primitive string name to its integer index.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    return [] # Primitive name not found.\n\n  # 2. Get action integer constants for pathfinding.\n  # Using env.action_specs() ensures compatibility with different action mappings.\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  ACTION_MAP = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS movement\n\n  # 3. Categorize primitive type to determine interaction logic.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  is_defined_primitive_resource = primitive_idx in cookbook.primitives\n\n  # Early exit for uncollectible/impassable environmental features\n  # If it's non-grabbable, not a workshop, AND not a defined primitive resource,\n  # it's likely an impassable, uncollectible environmental obstacle (like BOUNDARY).\n  if (primitive_idx in env.world.non_grabbable_indices and not is_workshop_location) and not is_defined_primitive_resource:\n      return []\n\n  # Determine if a 'USE' action is required after reaching the spot.\n  # This applies to items picked up (grabbable) or resources mined (e.g., stone, wood).\n  # Workshops typically do NOT require 'USE' to \"collect\" them; being at their location is sufficient.\n  requires_use_action = is_grabbable_item or (is_defined_primitive_resource and not is_workshop_location)\n\n  # 4. Helper function to determine if a specific grid cell (r, c) is traversable.\n  def is_traversable(r: int, c: int) -> bool:\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False # Out of bounds.\n      \n      # Water is always an impassable obstacle.\n      if grid[r, c, env.world.water_index] == 1:\n          return False\n\n      # Check for other non-grabbable entities that block movement.\n      # Workshops are non-grabbable but are designed to be traversable for the agent.\n      # Other non-grabbables (like BOUNDARY, or certain STONE types that are just blocks) are obstacles.\n      kinds_at_cell = np.where(grid[r, c] == 1)[0]\n      for kind_at_cell_idx in kinds_at_cell:\n          if kind_at_cell_idx in env.world.non_grabbable_indices and\\\n             kind_at_cell_idx not in env.world.workshop_indices:\n              return False # This cell contains an unpassable obstacle.\n      return True\n\n  # 5. Find all grid cells where the primitive itself is located.\n  primitive_actual_locations = []\n  for r in range(grid_width):\n    for c in range(grid_height):\n      if grid[r, c, primitive_idx] == 1:\n        primitive_actual_locations.append((r, c))\n\n  if not primitive_actual_locations:\n    return [] # Primitive not found anywhere on the map.\n\n  # 6. Determine the set of \"target_collectible_spots\" -- locations where the agent\n  #    needs to stand to \"collect\" the primitive.\n  target_collectible_spots = set()\n  # Offsets for a 3x3 neighborhood (including the center cell (0,0)).\n  NEIGHBORHOOD_OFFSETS = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1] \n  ]\n\n  for pr, pc in primitive_actual_locations:\n      if requires_use_action:\n          # For items requiring USE (grabbable items or mineable resources),\n          # any traversable spot in the 3x3 neighborhood of the primitive works.\n          for dr_nb, dc_nb in NEIGHBORHOOD_OFFSETS:\n              nr, nc = pr + dr_nb, pc + dc_nb\n              if is_traversable(nr, nc):\n                  target_collectible_spots.add((nr, nc))\n      elif is_workshop_location:\n          # For workshops, the agent needs to stand directly on the workshop cell.\n          # Only add the workshop's own cell if it's traversable.\n          if is_traversable(pr, pc):\n              target_collectible_spots.add((pr, pc))\n      # If the primitive type doesn't fit 'requires_use_action' or 'is_workshop_location' (e.g., pure environmental obstacle),\n      # it won't add any target spots, leading to an empty set and a later early exit.\n\n  if not target_collectible_spots:\n      # This can happen if all instances of the primitive are in untraversable locations,\n      # or if the primitive is a type that doesn't define specific collection spots (handled by early exit).\n      return []\n\n  # 7. Check if already at a collectible spot (immediate action).\n  # If the agent's current position is one of the target spots.\n  if current_pos in target_collectible_spots:\n    if requires_use_action:\n        return [ACTION_USE] # Already there, just use the item/resource.\n    else: # Already on a workshop, no further actions needed to \"collect\" (i.e., be present).\n        return []\n\n  # 8. Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  #    current position to any of the identified target_collectible_spots.\n  q = collections.deque([(current_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {current_pos} # Set to keep track of visited grid cells to prevent cycles.\n  path_found = None # Will store the shortest sequence of actions found.\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current position is one of our target collectible spots, we've found the shortest path.\n    if (r, c) in target_collectible_spots:\n      path_found = current_path\n      break\n\n    # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT).\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited: # Only explore if this cell hasn't been visited yet.\n        if is_traversable(next_r, next_c): # Only explore if the cell is traversable.\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 9. Construct the final sequence of actions if a path was found.\n  final_actions = []\n  if path_found:\n    final_actions.extend(path_found)\n    if requires_use_action:\n      final_actions.append(ACTION_USE) # Append USE action if it's a grabbable/mineable item.\n  \n  return final_actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:53:55.231008", "function_name": "collect", "function_body": "  actions = []\n\n  # 0. Initial Check: If the primitive is already in the inventory, no actions are needed.\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_inventory = env._current_state.inventory\n  if current_inventory[primitive_idx] > 0:\n      return [] # Already collected, return empty action list.\n\n  # 1. Get essential mappings and state information from the environment.\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full static grid of the environment\n  W, H, _ = global_grid.shape # Grid dimensions\n\n  # Determine if the primitive is grabbable (can be walked onto and picked up)\n  # or non-grabbable (requires being adjacent and using the 'USE' action, e.g., mining stone/water, using a workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Map DMLab action values to (dr, dc) movement deltas and the resulting CraftState.dir.\n  # The agent's direction updates to match the last movement action.\n  action_to_move_and_dir = {\n      UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the 'USE' action will apply for non-grabbable items.\n  dir_to_fwd_delta = {\n      0: (1, 0),  # Facing South, cell in front is (row+1, col)\n      1: (-1, 0), # Facing North, cell in front is (row-1, col)\n      2: (0, -1), # Facing West, cell in front is (row, col-1)\n      3: (0, 1)   # Facing East, cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item that blocks movement.\n      # Agent can walk onto grabbable items (e.g., WOOD, IRON), but not non-grabbable ones.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # 2. Implement Breadth-First Search (BFS) to find the shortest path.\n  # Queue stores tuples of ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set stores (position (r,c), direction (int)) tuples to avoid redundant exploration\n  # and cycles, ensuring the shortest path is found for a given state.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None # This will store the sequence of actions once the target state is reached.\n  \n  while queue:\n      ((r, c), current_dir_val), path_so_far = queue.popleft()\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items, the agent needs to be on the same cell as the primitive.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to a cell containing the grabbable item.\n      else:\n          # For non-grabbable items, the agent must be adjacent to the primitive\n          # AND facing it to successfully use the 'USE' action.\n          fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive and is within bounds.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path ending in the correct position and direction to use the primitive.\n\n      # Explore neighbors by applying movement actions (UP, DOWN, LEFT, RIGHT).\n      for action_val, (move_delta, new_dir_val) in action_to_move_and_dir.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only proceed if the next position is valid (within grid bounds and not an obstacle)\n          # and this specific (position, direction) state has not been visited before.\n          if is_valid_move(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  # 3. Construct the final action list.\n  if path_to_target:\n      # If a path was found, append the 'USE' action at the end to perform the collection.\n      # This assumes 'USE' is always the final action, consistent with the DSL's single COLLECT verb.\n      actions = path_to_target + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:53:56.551848", "function_name": "collect", "function_body": "  actions = []\n\n  # 0. Check if the primitive is already in the inventory.\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_inventory = env._current_state.inventory\n  if current_inventory[primitive_idx] > 0:\n      return [] # Already collected, return empty action list.\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine if the primitive is grabbable or non-grabbable.\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Map DMLab action values to (dr, dc) movement deltas AND CraftState.dir values.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  action_to_move_and_dir = {\n      UP: ((-1, 0), 1),\n      DOWN: ((1, 0), 0),\n      LEFT: ((0, -1), 2),\n      RIGHT: ((0, 1), 3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  dir_to_fwd_delta = {\n      0: (1, 0),  # Facing South\n      1: (-1, 0), # Facing North\n      2: (0, -1), # Facing West\n      3: (0, 1)   # Facing East\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n\n  def _bfs_pathfinding(start_p, start_d, target_idx, is_grabbable):\n      \"\"\"\n      Performs a Breadth-First Search to find the shortest path to a target primitive.\n      \n      Args:\n          start_p (tuple): Initial (row, col) position.\n          start_d (int): Initial direction (0-3).\n          target_idx (int): Index of the primitive to find.\n          is_grabbable (bool): True if the primitive can be walked upon and picked up.\n          \n      Returns:\n          list[int]: The shortest sequence of movement actions, or None if no path found.\n      \"\"\"\n      queue = collections.deque([((start_p, start_d), [])])\n      visited = {(start_p, start_d)}\n\n      while queue:\n          (current_pos, current_dir_val), path_so_far = queue.popleft()\n          r, c = current_pos\n\n          # Check if the current state satisfies the collection goal.\n          target_met = False\n          if is_grabbable:\n              # For grabbable items, the agent must be on the same cell.\n              if global_grid[r, c, target_idx] == 1:\n                  target_met = True\n          else:\n              # For non-grabbable items, the agent must be adjacent and facing it.\n              fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n              target_r, target_c = r + fwd_dr, c + fwd_dc\n              if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, target_idx] == 1:\n                  target_met = True\n\n          if target_met:\n              return path_so_far # Path found!\n\n          # Explore neighbors by applying movement actions.\n          for action_val, (move_delta, new_dir_val) in action_to_move_and_dir.items():\n              dr, dc = move_delta\n              next_r, next_c = r + dr, c + dc\n              next_pos = (next_r, next_c)\n              next_state_tuple = (next_pos, new_dir_val)\n\n              if is_valid_move(next_r, next_c) and next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  queue.append((next_state_tuple, path_so_far + [action_val]))\n      \n      return None # No path found\n\n  # Perform the pathfinding\n  path_to_target = _bfs_pathfinding(start_pos, start_dir, primitive_idx, primitive_is_grabbable)\n\n  if path_to_target:\n      # If a path was found, append the USE action at the end to perform the collection.\n      actions = path_to_target + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:54:49.488317", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are entities the agent cannot walk *onto*.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable\n          is_walkable = True\n          # Agent cannot walk onto non-grabbable entities (like boundaries, water, or workshops)\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n          # This specifically handles cases where the primitive itself might be a non-walkable terrain type (e.g., WATER, STONE).\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:54:50.645018", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment and define constants for readability\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # These are entities the agent cannot walk *onto*.\n  # Convert to numpy array once for efficient indexing in the walkable check.\n  non_walkable_kinds_indices_np = np.array(list(current_state.world.non_grabbable_indices))\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-grabbable/non-walkable entity\n          # Using np.any for a potentially faster check on the numpy array slice\n          if len(non_walkable_kinds_indices_np) > 0 and np.any(initial_grid[next_r, next_c, non_walkable_kinds_indices_np] > 0):\n              is_walkable = False\n          \n          # Additionally, cannot walk onto the primitive itself for collection (must be adjacent).\n          # This is separate from non-grabbable because some primitives (like WOOD) are grabbable but you still don't walk on them.\n          if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:55:51.879728", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a cell at (r, c) is valid for the agent to move into\n  def _is_valid_and_walkable(r: int, c: int) -> bool:\n      # Check if the coordinates are within the grid boundaries\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any non-walkable entity (e.g., boundary, water, workshop)\n      # The agent cannot move onto these types of entities.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # The agent cannot walk onto the primitive itself to collect it;\n      # it must be adjacent and then use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      return True\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state\n      # If so, we've found a path to be adjacent and facing the primitive, so we can collect it with USE.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is valid and walkable, and if this state hasn't been visited\n      if _is_valid_and_walkable(next_r, next_c) and \\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:55:53.077534", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1]\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving forward in the current direction\n  TURN_LEFT_ACTION = action_map['LEFT']     # Corresponds to turning 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Corresponds to turning 90 degrees right\n  USE_ACTION = action_map['USE']            # Action to interact with the cell in front\n\n  # Direction vectors (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell (i.e., agent is adjacent and facing it)\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next cell is walkable.\n          # Agent cannot walk onto:\n          # - The primitive itself (collection requires being adjacent, not on top)\n          # - Any non-grabbable entities (like boundaries, water, workshops)\n          is_walkable = not (\n              initial_grid[next_r, next_c, primitive_id] > 0 or\n              any(initial_grid[next_r, next_c, kind_idx] > 0 for kind_idx in non_walkable_kinds_indices)\n          )\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T02:56:53.008422", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized in the cookbook, cannot collect.\n    return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_pos = initial_state.pos\n  start_dir = initial_state.dir # Initial direction of the agent\n  global_grid = initial_state.grid\n  W, H, _ = global_grid.shape\n\n  # Determine if the primitive is grabbable (can be walked on and picked up)\n  # or non-grabbable (requires being adjacent and USE action, e.g., mining stone/water, using workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Define movement actions and their corresponding new positions and directions.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # The agent's direction updates to match the last movement action.\n  move_actions_info = [\n      (UP,    (-1, 0), 1),  # Action, (dr, dc), new_dir_val (UP moves North, dir 1)\n      (DOWN,  (1, 0),  0),  # DOWN moves South, dir 0\n      (LEFT,  (0, -1), 2),  # LEFT moves West, dir 2\n      (RIGHT, (0, 1),  3)   # RIGHT moves East, dir 3\n  ]\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply.\n  dir_to_forward_delta = {\n      0: (1, 0),  # Facing South (dir 0), cell in front is (row+1, col)\n      1: (-1, 0), # Facing North (dir 1), cell in front is (row-1, col)\n      2: (0, -1), # Facing West (dir 2), cell in front is (row, col-1)\n      3: (0, 1)   # Facing East (dir 3), cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  # Use `env.world.non_grabbable_indices` for a comprehensive list.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_walkable(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_to_current_state (list of actions) )\n  # The state includes direction because 'USE' depends on facing the target.\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  visited = {(start_pos, start_dir)}\n\n  found_path_pre_use = None # This will store the sequence of actions to reach the state *before* the 'USE' action.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current (position, direction) state is a \"pre-USE\" state for collection.\n      # This means the agent is in a position/direction from which it can collect the primitive.\n      is_target_collectible_from_current_state = False\n      \n      if primitive_is_grabbable:\n          # For grabbable items, the agent needs to be on the same cell as the primitive.\n          # We check if the current cell (r, c) contains the primitive.\n          if global_grid[r, c, primitive_idx] == 1:\n              is_target_collectible_from_current_state = True\n      else:\n          # For non-grabbable items, the agent must be adjacent to the primitive AND facing it.\n          # Calculate the cell directly in front of the agent.\n          fwd_dr, fwd_dc = dir_to_forward_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              is_target_collectible_from_current_state = True\n\n      if is_target_collectible_from_current_state:\n          found_path_pre_use = path_so_far\n          break # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (dr, dc), new_dir_val in move_actions_info:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val) # BFS state includes position and direction\n\n          # Only proceed if the next position is walkable (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if found_path_pre_use is not None:\n      # If a path to the \"pre-USE\" state was found, append the USE action at the end.\n      actions = found_path_pre_use + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:56:54.124081", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # Primitive name not recognized, cannot collect.\n      return []\n\n  # Get current state information from the environment's internal state\n  initial_state = env._current_state\n  start_pos = initial_state.pos\n  start_dir = initial_state.dir # Initial direction of the agent\n  # Use the current grid, which reflects the current state of the world (e.g., items already picked up)\n  current_grid = initial_state.grid \n  WIDTH, HEIGHT, _ = current_grid.shape\n\n  # Determine if the primitive is grabbable (can be walked on and picked up)\n  # or non-grabbable (requires being adjacent and USE action, e.g., mining stone/water, using workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  non_grabbable_indices = env.world.non_grabbable_indices # Indices of items that block agent movement\n\n  # Define movement actions and their corresponding new positions and directions.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # Each tuple: (action_value, (row_delta, col_delta), new_direction_value_after_move)\n  move_actions_info = [\n      (UP,    (-1, 0), 1),  # Move UP (North), agent faces North (dir 1)\n      (DOWN,  (1, 0),  0),  # Move DOWN (South), agent faces South (dir 0)\n      (LEFT,  (0, -1), 2),  # Move LEFT (West), agent faces West (dir 2)\n      (RIGHT, (0, 1),  3)   # Move RIGHT (East), agent faces East (dir 3)\n  ]\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply for non-grabbable items.\n  dir_to_forward_delta = {\n      0: (1, 0),  # Facing South (dir 0), cell in front is (row+1, col)\n      1: (-1, 0), # Facing North (dir 1), cell in front is (row-1, col)\n      2: (0, -1), # Facing West (dir 2), cell in front is (row, col-1)\n      3: (0, 1)   # Facing East (dir 3), cell in front is (row, col+1)\n  }\n\n  def is_walkable(r, c, grid, W, H, non_grabbable_idxs):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable items.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is not walkable if it contains any non-grabbable item (e.g., Water, Stone, Workshops).\n      for idx in non_grabbable_idxs:\n          if grid[r, c, idx] > 0: # Check if the item is present (count > 0)\n              return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_to_current_state (list of actions) )\n  # The state includes direction because 'USE' depends on facing the target for non-grabbables,\n  # and movement actions also change direction.\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  visited = {(start_pos, start_dir)}\n\n  found_path_pre_use = None # This will store the sequence of actions to reach the state *before* the 'USE' action.\n  \n  while queue:\n      (current_pos, current_dir_val), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current (position, direction) state is a \"pre-USE\" state for collection.\n      is_target_reachable_from_current_state = False\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be on the same cell as the primitive.\n          # Direction does not matter for picking up grabbable items if the agent is on them.\n          if current_grid[r, c, primitive_idx] > 0: # Check if the primitive is present at agent's current location\n              is_target_reachable_from_current_state = True\n      else:\n          # For non-grabbable items (e.g., STONE, WORKSHOP), the agent must be adjacent to the primitive AND facing it.\n          fwd_dr, fwd_dc = dir_to_forward_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < WIDTH and 0 <= target_c < HEIGHT and current_grid[target_r, target_c, primitive_idx] > 0:\n              is_target_reachable_from_current_state = True\n\n      if is_target_reachable_from_current_state:\n          found_path_pre_use = path_so_far\n          break # Found the shortest path to a state from which 'USE' can collect the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (dr, dc), new_dir_val in move_actions_info:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val) # BFS state includes position and direction\n\n          # Only proceed if the next position is walkable (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_walkable(next_r, next_c, current_grid, WIDTH, HEIGHT, non_grabbable_indices) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if found_path_pre_use is not None:\n      # If a path to the \"pre-USE\" state was found, append the USE action at the end.\n      actions = found_path_pre_use + [USE]\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:57:46.016265", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Define action integers using the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # 3. Pre-calculate target coordinates (where the primitive exists on the grid)\n  # np.argwhere returns (row, col) coordinates where the condition is true.\n  # grid has shape (WIDTH, HEIGHT, n_kinds) -> (rows, cols, kinds)\n  target_coords = np.argwhere(current_state.grid[:, :, i_kind] > 0).tolist()\n\n  if not target_coords:\n    # Primitive is not present anywhere on the map\n    return []\n\n  # 4. Heuristic function (Manhattan distance to nearest target, adjusted for adjacency)\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def h_score(pos):\n      \"\"\"Estimates the minimum number of movement steps to get adjacent to the primitive.\"\"\"\n      min_dist_to_target_cell = float('inf')\n      for tx, ty in target_coords:\n          dist = manhattan_distance(pos, (tx, ty))\n          min_dist_to_target_cell = min(min_dist_to_target_cell, dist)\n      \n      # If the agent is already on the target cell (dist=0) or adjacent (dist=1),\n      # no more movement steps are needed before using the item.\n      return max(0, min_dist_to_target_cell - 1)\n\n  # 5. A* search setup\n  # The priority queue stores tuples: (f_score, g_score, state_object, path_list)\n  # f_score = g_score + h_score\n  # g_score is included for tie-breaking: prefer shorter paths if f_scores are equal.\n  open_list = []\n  \n  # g_scores: dict mapping (pos, dir) -> cheapest g_score found to reach that state.\n  # This also implicitly serves as the \"closed list\" for states whose optimal path\n  # has been discovered or is currently the best known.\n  g_scores = {}\n\n  # Initial state\n  initial_pos_dir = (current_state.pos, current_state.dir)\n  g_scores[initial_pos_dir] = 0\n  initial_h_score = h_score(current_state.pos)\n  initial_f_score = initial_h_score + g_scores[initial_pos_dir]\n  \n  heapq.heappush(open_list, (initial_f_score, 0, current_state, []))\n\n  # 6. A* Search Loop\n  while open_list:\n    f, g, state, path = heapq.heappop(open_list)\n    current_pos_dir = (state.pos, state.dir)\n\n    # If we have already found a path to this state with a cost less than or equal to `g`,\n    # or if this state has already been processed with its optimal path, skip it.\n    if g > g_scores.get(current_pos_dir, float('inf')):\n        continue\n\n    # Goal check: Is the primitive next to the agent?\n    # This means the agent can use the item directly from this state.\n    if state.next_to(i_kind):\n      return path + [USE_ACT]\n\n    # Explore neighbors (move actions)\n    for action in move_actions:\n      # Simulate the action to get the next state. CraftState objects are immutable\n      # for step operations, so this creates a new state without affecting `state`.\n      _, next_state = state.step(action)\n      next_pos_dir = (next_state.pos, next_state.dir)\n      \n      # The cost to move to an adjacent cell is 1.\n      tentative_g_score = g + 1\n\n      # If this path to next_state is shorter than any previously found path\n      # to next_state_key, or if next_state_key hasn't been reached yet:\n      if tentative_g_score < g_scores.get(next_pos_dir, float('inf')):\n        g_scores[next_pos_dir] = tentative_g_score\n        next_f_score = tentative_g_score + h_score(next_state.pos)\n        heapq.heappush(open_list, (next_f_score, tentative_g_score, next_state, path + [action]))\n\n  # If the open list is exhausted and the goal was not reached,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T02:57:47.129950", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable.\n  # The 'collect' action implies picking up an item. If the item is non-grabbable\n  # (e.g., a workshop, water, boundary), it cannot be collected.\n  if i_kind in env.world.non_grabbable_indices:\n    return []\n\n  # 3. Define action integers using the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of possible movement actions\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_tuple, direction_integer) to avoid cycles\n  visited = set()\n\n  # Initial state: current_state with an empty path\n  q.append((current_state, []))\n  visited.add((current_state.pos, current_state.dir))\n\n  # Define a maximum search depth to prevent infinite loops for unreachable items.\n  # This is the total number of unique (position, direction) states.\n  grid_width, grid_height, _ = current_state.grid.shape\n  max_search_depth = grid_width * grid_height * 4 \n\n  while q:\n    state, path = q.popleft()\n\n    # Check if we are currently next to the desired primitive\n    if state.next_to(i_kind):\n      # If so, we've found the path to get next to it.\n      # To collect it, we need to append the USE action.\n      return path + [USE_ACT]\n\n    # Pruning: If the current path is too long, it's likely a cycle or very inefficient.\n    # This also acts as a safeguard against exploring too deep if the item is unreachable.\n    if len(path) >= max_search_depth:\n      continue # Skip exploring further from this path\n\n    # Explore possible movement actions from the current state\n    for action in move_actions:\n      # Simulate the action to get the next state\n      # state.step(action) returns (reward, new_state)\n      _, next_state = state.step(action)\n\n      # Create a key for the next state to check if it has been visited\n      next_state_key = (next_state.pos, next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and the primitive was not found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:58:32.795618", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get the current state of the environment\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape  # grid is (WIDTH, HEIGHT, n_kinds)\n\n  # Get action mappings from the environment\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define movement deltas (dx, dy) for (x, y) coordinates based on action IDs\n  action_deltas = {\n      ACTION_DOWN: (0, 1),   # Increasing Y (moving down on screen)\n      ACTION_UP: (0, -1),  # Decreasing Y (moving up on screen)\n      ACTION_LEFT: (-1, 0),  # Decreasing X (moving left on screen)\n      ACTION_RIGHT: (1, 0)   # Increasing X (moving right on screen)\n  }\n\n  # Helper function to determine if a cell is traversable by the agent\n  # A cell is traversable if it's within bounds and does not contain any non-grabbable (impassable) entities.\n  def is_traversable(x, y, current_state):\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any impassable objects (e.g., walls, water, boundaries)\n      for k_idx in env.world.non_grabbable_indices:\n          if current_state.grid[x, y, k_idx] > 0:\n              return False  # Contains an impassable object\n      return True  # Cell is traversable\n\n  # Helper function to check if the target primitive is in the 3x3 neighborhood of a given position (x, y).\n  # This mimics the behavior of CraftState.next_to, which checks the 8 surrounding cells.\n  def is_adjacent_to_primitive_3x3(px, py, current_state, target_primitive_idx):\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              if dx_adj == 0 and dy_adj == 0:\n                  continue  # Skip the agent's current cell itself\n\n              nx_adj, ny_adj = px + dx_adj, py + dy_adj\n\n              # Check if the neighboring cell is within grid bounds\n              if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                  # Check if the primitive is present at this neighboring cell\n                  if current_state.grid[nx_adj, ny_adj, target_primitive_idx] > 0:\n                      return True  # Found primitive in the 3x3 neighborhood\n      return False\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # The goal is to reach a traversable cell from which the primitive is in the 3x3 neighborhood.\n  queue = collections.deque([(current_pos, [])])  # Queue stores (current_position, path_actions_so_far)\n  visited = {current_pos}  # Keep track of visited positions to avoid cycles\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # If the current position is adjacent to the primitive (in 3x3 neighborhood),\n      # we have found our target location. Append the USE action and return the path.\n      if is_adjacent_to_primitive_3x3(x, y, state, primitive_idx):\n          return path + [ACTION_USE]\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dx, dy) in action_deltas.items():\n          new_x, new_y = x + dx, y + dy\n          new_pos = (new_x, new_y)\n\n          # If the new position has already been visited, skip it\n          if new_pos in visited:\n              continue\n\n          # If the new position is traversable, add it to the queue and mark as visited\n          if is_traversable(new_x, new_y, state):\n              visited.add(new_pos)\n              queue.append((new_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T02:58:33.958293", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  \n  grid_width, grid_height, _ = grid.shape\n\n  # Define movement actions and their corresponding (delta_x, delta_y)\n  # (x corresponds to column, y corresponds to row)\n  moves = {\n      craft.UP: (0, -1),   # Move up: y decreases\n      craft.DOWN: (0, 1),    # Move down: y increases\n      craft.LEFT: (-1, 0),   # Move left: x decreases\n      craft.RIGHT: (1, 0)    # Move right: x increases\n  }\n\n  # BFS setup\n  # Queue stores tuples of ((current_x, current_y), path_taken_so_far)\n  queue = collections.deque([(start_pos, [])])\n  # Set of visited positions to prevent cycles and redundant exploration\n  visited = {start_pos}\n\n  while queue:\n    (x, y), path = queue.popleft()\n\n    # Check if the target primitive is in the 3x3 neighborhood of the current position\n    # This directly implements the logic of CraftState.next_to(primitive_idx)\n    found_adjacent_primitive = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        nx_adj, ny_adj = x + dx_adj, y + dy_adj\n\n        # Check if the adjacent cell is within grid bounds\n        if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n          # Check if the primitive is present at this adjacent cell\n          if grid[nx_adj, ny_adj, primitive_idx] > 0:\n            found_adjacent_primitive = True\n            break # Found primitive in neighborhood, no need to check further adjacent cells\n      if found_adjacent_primitive:\n        break # Found primitive, break out of outer loop too\n\n    if found_adjacent_primitive:\n      # If the primitive is adjacent, the next action should be USE\n      return path + [craft.USE]\n\n    # Explore neighbors (UP, DOWN, LEFT, RIGHT) for movement\n    for action, (dx_move, dy_move) in moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_pos = (next_x, next_y)\n\n      # Check validity of the next_pos:\n      # 1. Bounds check: Ensure new position is within the grid\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Visited check: Avoid revisiting already explored positions to find shortest path\n      if next_pos in visited:\n        continue\n\n      # 3. Traversability check: Ensure the cell is not an obstacle.\n      # Obstacles are defined by non_grabbable_indices from CraftWorld.\n      is_obstacle = False\n      for k_idx in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, k_idx] > 0:\n              is_obstacle = True\n              break\n      if is_obstacle:\n          continue # Cannot move into an obstacle cell\n\n      # If all checks pass, add the new position to the queue and mark as visited\n      visited.add(next_pos)\n      queue.append((next_pos, path + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:00:00.536420", "function_name": "collect", "function_body": "  # 1. Initialize Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction (0=South, 1=North, 2=West, 3=East)\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid (WIDTH, HEIGHT, num_kinds)\n\n  # 2. Categorize the primitive based on its collection mechanism\n  # These sets help identify what kind of interaction is needed.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Type A: Primitive is \"collected\" by walking onto its cell.\n  # This applies to grabbable items (picked up automatically by movement)\n  # and workshops (interacted with by standing on their location).\n  target_requires_on_cell = is_grabbable or is_workshop\n  \n  # Type B: Primitive requires agent to be ADJACENT, FACING it, and then using ACTION_USE.\n  # This applies to non-grabbable environment features like STONE or WATER that\n  # cannot be walked onto but must be mined/chopped/etc. from an adjacent cell.\n  # Workshops are non-grabbable, but they are 'on-cell' type, so they are excluded here.\n  target_requires_adjacent_use = (\n      primitive_idx in env.world.non_grabbable_indices and \n      not is_workshop\n  )\n\n  # 3. Define movement and direction change rules\n  # These mappings describe how each action affects the agent's (row, col) position\n  # and its new facing direction.\n  # CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  MOVE_ACTIONS_DATA = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # This maps an agent's direction to the (dr, dc) delta for the cell directly in front.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (row+1, col) is in front\n      1: (-1, 0), # Facing North: cell (row-1, col) is in front\n      2: (0, -1), # Facing West: cell (row, col-1) is in front\n      3: (0, 1)   # Facing East: cell (row, col+1) is in front\n  }\n\n  # 4. Helper functions for grid interactions\n  def is_within_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the environment boundaries.\"\"\"\n      return 0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent.\n      A cell is walkable if it's within bounds and does not contain any entity\n      that acts as an impassable obstacle.\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Iterate through all possible item kinds to check what's on the cell (r,c).\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] > 0: # If an item of kind k_idx is present at (r,c)\n              if k_idx in env.world.non_grabbable_indices:\n                  # This is a non-grabbable entity (e.g., STONE, WATER, BOUNDARY, or a WORKSHOP).\n                  # Agent can generally NOT walk onto these, with one exception:\n                  # It *can* walk onto it IF it's the specific primitive we are targeting\n                  # AND that primitive is an \"on-cell\" type (i.e., a workshop).\n                  if not (target_requires_on_cell and k_idx == primitive_idx):\n                      return False # This cell contains an obstacle (e.g., STONE) that cannot be stepped on,\n                                  # or a workshop that is not our current target.\n      return True # If no blocking items are found on the cell, it is walkable.\n\n  # 5. Breadth-First Search (BFS) for pathfinding\n  # The state in our BFS includes both the agent's (position (r,c)) and its (direction),\n  # as direction is crucial for the 'USE' action.\n  # Queue stores tuples: ((current_position_rc, current_direction), path_so_far_actions_list)\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores ((r,c), dir) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if target_requires_on_cell:\n          # Goal for 'on-cell' primitives (grabbable items, workshops):\n          # Agent must be directly on the cell containing the primitive.\n          # The grid value `> 0` accounts for potential stacks of items, though typically 1.\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path = path_so_far\n              break # Path found to be on the target cell.\n      elif target_requires_adjacent_use:\n          # Goal for 'adjacent-and-use' primitives (e.g., STONE, WATER):\n          # Agent must be adjacent to and facing the primitive.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc # Calculate the cell directly in front\n          \n          if (is_within_bounds(target_r, target_c) and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path = path_so_far\n              break # Path found to be in position and orientation to 'USE' the primitive.\n\n      # Explore valid neighboring states by applying movement actions.\n      for action_val, (move_dr, move_dc), new_dir_val in [\n          (ACTION_UP, (-1, 0), 1),\n          (ACTION_DOWN, (1, 0), 0),\n          (ACTION_LEFT, (0, -1), 2),\n          (ACTION_RIGHT, (0, 1), 3)\n      ]:\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Add the next state to the queue only if:\n          # 1. The next position is walkable (no impassable obstacles).\n          # 2. This specific (position, direction) state has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  # 6. Construct the final list of actions based on the shortest path found.\n  final_actions = []\n  if shortest_path is not None:\n      final_actions = shortest_path\n      # If the primitive requires \"adjacent-and-use\" collection, append the USE action\n      # after reaching the correct position and orientation.\n      if target_requires_adjacent_use:\n          final_actions.append(ACTION_USE)\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:00:02.013422", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's starting (row, col) position\n  start_dir = current_state.dir  # Agent's starting direction\n  global_grid = current_state.grid # The full grid representation of the world\n  GRID_WIDTH, GRID_HEIGHT, _ = global_grid.shape # Dimensions of the grid\n\n  # Categorize the primitive based on how it's \"collected\"\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Type 1: Requires agent to be ON the cell containing the primitive.\n  # This applies to grabbable items (picked up by walking over) and workshops (interacted by standing on).\n  target_requires_on_cell = is_grabbable or is_workshop\n  \n  # Type 2: Requires agent to be ADJACENT to and FACING the primitive, then use ACTION_USE.\n  # This applies to non-grabbable environment features like stone or water, if they are meant\n  # to be 'collected' by the DSL 'collect' function.\n  target_requires_adjacent_use = (\n      primitive_idx in env.world.non_grabbable_indices and # Is a non-grabbable item\n      not is_workshop # But not a workshop (workshops are 'on-cell' type)\n  )\n\n  # Define how movement actions change the agent's position and direction.\n  # CraftState.dir: 0=South, 1=North, 2=West, 3=East.\n  MOVE_ACTIONS_DATA = {\n      ACTION_UP: ((-1, 0), 1),    # Move UP (row-1), new direction is North (1)\n      ACTION_DOWN: ((1, 0), 0),   # Move DOWN (row+1), new direction is South (0)\n      ACTION_LEFT: ((0, -1), 2),  # Move LEFT (col-1), new direction is West (2)\n      ACTION_RIGHT: ((0, 1), 3)   # Move RIGHT (col+1), new direction is East (3)\n  }\n\n  # Define how agent's direction maps to the coordinates of the cell directly in front.\n  DIRECTION_TO_FORWARD_DELTA = {\n      0: (1, 0),  # Facing South: cell (row+1, col) is in front\n      1: (-1, 0), # Facing North: cell (row-1, col) is in front\n      2: (0, -1), # Facing West: cell (row, col-1) is in front\n      3: (0, 1)   # Facing East: cell (row, col+1) is in front\n  }\n\n  def is_within_bounds(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is within the environment boundaries.\"\"\"\n      return 0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT\n\n  def is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell (r, c) is a valid and traversable location for the agent.\n      \"\"\"\n      if not is_within_bounds(r, c):\n          return False\n      \n      # Iterate through all possible kind indices at the cell (r,c)\n      for k_idx in range(global_grid.shape[2]):\n          if global_grid[r, c, k_idx] > 0: # If something of kind k_idx is present at (r,c)\n              # If the cell contains any non-grabbable item that is NOT a workshop,\n              # it is an obstacle and cannot be walked upon.\n              if k_idx in env.world.non_grabbable_indices and k_idx not in env.world.workshop_indices:\n                  return False # This cell contains a fixed obstacle (e.g., BOUNDARY, STONE, WATER)\n              \n              # If the current cell contains the *target primitive* itself,\n              # AND that primitive requires *adjacent-and-use* collection (e.g., STONE, WATER),\n              # then the agent must NOT walk onto this cell.\n              if k_idx == primitive_idx and target_requires_adjacent_use:\n                  return False\n      return True\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # Queue stores tuples: ( (current_position (r,c), current_direction), path_so_far (list of actions) )\n  # BFS explores states defined by both position AND direction, which is crucial for the 'USE' action.\n  queue = collections.deque([((start_pos, start_dir), [])])\n  \n  # Visited set: Stores ((r,c), dir) tuples to avoid revisiting states and infinite loops.\n  visited = {(start_pos, start_dir)}\n\n  shortest_path = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the current state satisfies the collection goal.\n      if target_requires_on_cell:\n          # Goal: Agent is on the cell containing the primitive (grabbable item or workshop).\n          if global_grid[r, c, primitive_idx] > 0:\n              shortest_path = path_so_far\n              break # Found the shortest path to be on the target cell.\n      elif target_requires_adjacent_use:\n          # Goal: Agent is adjacent to and facing the primitive.\n          fwd_dr, fwd_dc = DIRECTION_TO_FORWARD_DELTA[current_dir]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n          \n          if (is_within_bounds(target_r, target_c) and\n              global_grid[target_r, target_c, primitive_idx] > 0):\n              shortest_path = path_so_far\n              break # Found the shortest path to be in position and orientation to 'USE' the primitive.\n\n      # 2. Explore valid neighboring states (movement actions).\n      for action_val, (move_dr, move_dc), new_dir_val in [\n          (ACTION_UP, (-1, 0), 1),\n          (ACTION_DOWN, (1, 0), 0),\n          (ACTION_LEFT, (0, -1), 2),\n          (ACTION_RIGHT, (0, 1), 3)\n      ]:\n          next_r, next_c = r + move_dr, c + move_dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only add to queue if the next position is walkable and this specific (pos, dir) state\n          # has not been visited yet.\n          if is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  final_actions = []\n  if shortest_path is not None:\n      final_actions = shortest_path\n      # If the primitive requires \"adjacent-and-use\" collection, append the USE action.\n      if target_requires_adjacent_use:\n          final_actions.append(ACTION_USE)\n  \n  return final_actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:00:46.417601", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # The `collect` DSL command is specifically designed for grabbable resources (e.g., WOOD, STONE)\n  # that can be picked up and added to the agent's inventory. Workshops are for crafting,\n  # and boundaries/water are impassable or uncollectible.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve current state details for pathfinding.\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings for movement.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS exploration.\n  \n  # Offsets for checking the 3x3 neighborhood around a primitive,\n  # used to define 'collectible spots' where the agent can stand.\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Pre-compute a set of indices that represent truly blocking entities.\n  # This avoids repeated checks for water and workshops inside the `is_traversable` loop.\n  blocking_kind_indices = set()\n  for k_idx in env.world.non_grabbable_indices:\n      # Water is always an impassable obstacle.\n      # Workshops are generally traversable. Other non-grabbable items block movement.\n      if k_idx != env.world.water_index and k_idx not in env.world.workshop_indices:\n          blocking_kind_indices.add(k_idx)\n\n  # Helper function to determine if a grid cell is traversable.\n  def is_traversable(r, c):\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain blocking entities.\"\"\"\n      # Check bounds first.\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False\n\n      # Check for water, which is always blocking.\n      if grid[r, c, env.world.water_index] == 1:\n          return False\n\n      # Check if any other explicitly blocking kind is present at this cell.\n      for blocked_idx in blocking_kind_indices:\n          if grid[r, c, blocked_idx] == 1:\n              return False\n      return True\n\n  # 2. Immediate Collection Check: If the agent is already adjacent to the primitive,\n  #    a single `USE` action is sufficient. This is an important optimization.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Locate all instances of the target primitive on the grid.\n  # `np.where` provides efficient indexing for this.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  target_primitive_locations = list(zip(primitive_rows, primitive_cols))\n\n  if not target_primitive_locations:\n    # The primitive is not present anywhere on the current map.\n    return []\n\n  # 4. Identify all \"collectible spots\": these are traversable grid cells from which\n  #    the agent can interact with the primitive (i.e., be in its 3x3 neighborhood).\n  collectible_spots = set()\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n      nr, nc = pr + dr, pc + dc # Candidate cell for the agent to stand on\n\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable or valid spots found where the agent can stand to collect the primitive.\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the `collectible_spots`.\n  q = collections.deque([current_pos]) # Queue stores only positions.\n  # `visited` stores (cell_position -> (parent_position, action_to_reach_cell))\n  # This allows reconstructing the path efficiently without copying lists in the queue.\n  visited = {current_pos: (None, None)} # `(None, None)` signifies the starting node with no parent.\n  path_found_end_node = None\n\n  while q:\n    (r, c) = q.popleft()\n\n    # If the current cell is one of the target collectible spots, we've found the shortest path.\n    if (r, c) in collectible_spots:\n      path_found_end_node = (r, c)\n      break # Exit BFS as the optimal path is found.\n\n    # Explore valid cardinal (Up, Down, Left, Right) neighbors.\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      next_action = ACTION_MAP[(dr, dc)] # Action taken to reach (next_r, next_c)\n\n      if (next_r, next_c) not in visited: # Only explore if not visited\n        if is_traversable(next_r, next_c): # Only explore if the cell is traversable\n          visited[(next_r, next_c)] = ((r, c), next_action) # Store parent and action\n          q.append((next_r, next_c))\n\n  # 6. Construct the final sequence of actions if a path was found.\n  if path_found_end_node:\n    # Reconstruct the path by backtracking from the `path_found_end_node` to the `current_pos`.\n    path_segment = []\n    current = path_found_end_node\n    while visited[current][0] is not None: # While not at the starting node\n      parent, action = visited[current]\n      path_segment.append(action)\n      current = parent\n    \n    path_segment.reverse() # Path was built in reverse, so reverse it.\n    actions.extend(path_segment)\n    \n    # After reaching the collectible spot, a 'USE' action is required to acquire the grabbable primitive.\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:00:47.526442", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Primitive Index from the cookbook.\n  cookbook = env.world.cookbook\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # The `collect` DSL command is specifically designed for grabbable resources (e.g., WOOD, STONE)\n  # that can be picked up and added to the agent's inventory. Workshops are for crafting,\n  # and boundaries/water are impassable or uncollectible.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  # Retrieve current state details for pathfinding.\n  current_state = env._current_state\n  current_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings for movement.\n  ACTION_MAP = {\n      (-1, 0): craft.UP,\n      (1, 0): craft.DOWN,\n      (0, -1): craft.LEFT,\n      (0, 1): craft.RIGHT\n  }\n  CARDINAL_DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS exploration.\n  \n  # Offsets for checking the 3x3 neighborhood around a primitive,\n  # used to define 'collectible spots' where the agent can stand.\n  NEIGHBORHOOD_OFFSETS_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  # Pre-compute a set of indices that represent truly blocking entities for agent movement.\n  # This set includes all non-grabbable items except workshops, which are traversable.\n  blocking_kind_indices = set()\n  for k_idx in env.world.non_grabbable_indices:\n      if k_idx not in env.world.workshop_indices:\n          blocking_kind_indices.add(k_idx)\n  # Water is always a blocking entity, and it will be included by the above loop\n  # as it's non-grabbable and not a workshop.\n\n  # Helper function to determine if a grid cell is traversable.\n  def is_traversable(r, c):\n      \"\"\"Checks if the cell at (r, c) is within grid bounds and does not contain blocking entities.\"\"\"\n      # Check bounds first.\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False\n\n      # Check if any blocking kind is present at this cell.\n      for blocked_idx in blocking_kind_indices:\n          if grid[r, c, blocked_idx] == 1:\n              return False # This cell contains an unpassable obstacle.\n      return True # The cell is traversable.\n\n  # 2. Immediate Collection Check: If the agent is already adjacent to the primitive,\n  #    a single `USE` action is sufficient. This is an important optimization.\n  if current_state.next_to(primitive_idx):\n    actions.append(craft.USE)\n    return actions\n\n  # 3. Locate all instances of the target primitive on the grid.\n  # `np.where` provides efficient indexing for this.\n  primitive_rows, primitive_cols = np.where(grid[:, :, primitive_idx] == 1)\n  target_primitive_locations = list(zip(primitive_rows, primitive_cols))\n\n  if not target_primitive_locations:\n    # The primitive is not present anywhere on the current map.\n    return []\n\n  # 4. Identify all \"collectible spots\": these are traversable grid cells from which\n  #    the agent can interact with the primitive (i.e., be in its 3x3 neighborhood).\n  collectible_spots = set()\n  for pr, pc in target_primitive_locations:\n    for dr, dc in NEIGHBORHOOD_OFFSETS_3x3:\n      nr, nc = pr + dr, pc + dc # Candidate cell for the agent to stand on\n\n      if is_traversable(nr, nc):\n        collectible_spots.add((nr, nc))\n\n  if not collectible_spots:\n    # No reachable or valid spots found where the agent can stand to collect the primitive.\n    return []\n\n  # 5. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the `collectible_spots`.\n  q = collections.deque([(current_pos, [])]) # Queue stores (position, path_taken_actions_so_far)\n  visited = {current_pos} # Keep track of visited cells to prevent cycles and redundant paths.\n  path_to_collect_spot = None\n\n  while q:\n    (r, c), current_path = q.popleft()\n\n    # If the current cell is one of the target collectible spots, we've found the shortest path.\n    if (r, c) in collectible_spots:\n      path_to_collect_spot = current_path\n      break # Exit BFS as the optimal path is found.\n\n    # Explore valid cardinal (Up, Down, Left, Right) neighbors.\n    for dr, dc in CARDINAL_DIRECTIONS:\n      next_r, next_c = r + dr, c + dc\n      \n      if (next_r, next_c) not in visited:\n        if is_traversable(next_r, next_c):\n          visited.add((next_r, next_c))\n          q.append(((next_r, next_c), current_path + [ACTION_MAP[(dr, dc)]]))\n\n  # 6. Construct the final sequence of actions.\n  if path_to_collect_spot:\n    actions.extend(path_to_collect_spot)\n    # After reaching the collectible spot, a 'USE' action is required to acquire the grabbable primitive.\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:01:49.653700", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    # Primitive not found on the grid, return an empty action list.\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells,\n  # considering impassable terrain.\n  start_pos = current_state.pos\n  \n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_actions)\n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  # Identify impassable kinds for movement.\n  # We assume items that are non-grabbable AND are NOT workshops are impassable.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Check if this non-grabbable item is *not* a workshop\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft()\n\n    # If the current position is a goal cell, we have found a path\n    if (cx, cy) in goal_cells:\n      # Return the path to this cell, followed by the USE action\n      return path + [USE]\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability: A cell is impassable if it contains\n      # any kind from the 'impassable_kinds' set.\n      is_impassable = False\n      # Iterate through all kinds that *might* be at (nx, ny) that are in impassable_kinds\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS completes and no path to a goal cell is found,\n  # it means the primitive is unreachable, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:01:50.819865", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    \n    This implementation uses Breadth-First Search (BFS) to find the shortest\n    path to a cell from which the primitive can be collected. It accounts for\n    impassable terrain.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute. An empty list is returned\n                   if the primitive is already collected, not found, or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive from the world's cookbook.\n  # This will raise a KeyError if the primitive name is not valid, which is desired behavior.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings from the environment's action_specs for clarity\n  # and to ensure correct action indices are used.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # If the agent is already within the 3x3 neighborhood (including diagonals and its own cell)\n  # of the primitive, it can directly use/collect it.\n  if current_state.next_to(primitive_idx):\n    # This means the agent is in a valid position to interact with the primitive.\n    return [USE]\n\n  # 2. Identify all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  # Iterate through the entire grid to find all cells containing the specified primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell (count > 0).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's not collectible.\n  if not primitive_locations:\n    return []\n\n  # 3. Define \"goal cells\" for the Breadth-First Search (BFS).\n  # A goal cell is any cell from which the agent can successfully collect the primitive.\n  # Given that `CraftState.next_to` checks the 3x3 neighborhood (including the agent's\n  # current cell), any cell in this 3x3 vicinity of a primitive location is a valid goal.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through all 3x3 neighbors (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds make a cell impassable for agent movement.\n  # Impassable kinds are defined as non-grabbable items that are NOT workshops.\n  # Workshops are typically non-grabbable but often walkable/interactable locations.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # The queue for BFS stores tuples of (current_position, path_taken_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our goal cells, we have found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action, as the agent is now in a position to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions).\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_kinds`.\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_impassable_cell = True\n              break # No need to check other kinds, it's already impassable.\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # If the new position is valid and not visited, add it to the queue for exploration.\n      new_pos = (nx, ny)\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any goal cell,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:02:32.004279", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n  inventory = current_state.inventory # Check agent's current inventory\n\n  # Optimization: If the primitive is already in the inventory, no actions are needed.\n  if inventory[primitive_idx] > 0:\n      return []\n\n  # Determine if the primitive is grabbable (can be walked on and picked up)\n  # or non-grabbable (requires being adjacent and USE action, e.g., mining stone/water, using workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Map DMLab action values to (dr, dc) movement deltas AND CraftState.dir values.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # The agent's direction updates to match the last movement action.\n  action_to_move_and_dir = {\n      UP: ((-1, 0), 1),    # Move UP, new direction is North (1)\n      DOWN: ((1, 0), 0),   # Move DOWN, new direction is South (0)\n      LEFT: ((0, -1), 2),  # Move LEFT, new direction is West (2)\n      RIGHT: ((0, 1), 3)   # Move RIGHT, new direction is East (3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply.\n  dir_to_fwd_delta = {\n      0: (1, 0),  # Facing South, cell in front is (row+1, col)\n      1: (-1, 0), # Facing North, cell in front is (row-1, col)\n      2: (0, -1), # Facing West, cell in front is (row, col-1)\n      3: (0, 1)   # Facing East, cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item.\n      # Agent can walk onto grabbable items (e.g., WOOD, IRON), but not non-grabbable ones.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  # The direction is included because it affects the outcome of a 'USE' action.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      ((r, c), current_dir_val), path_so_far = queue.popleft()\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be on the same cell\n          # as the primitive to collect it. The item is collected automatically when stepping on it.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to a cell containing the grabbable item.\n      else:\n          # For non-grabbable items (e.g., STONE, WATER, WORKSHOP), the agent must be\n          # adjacent to the primitive AND facing it to use the 'USE' action.\n          fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path ending in the correct position and direction to use the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in action_to_move_and_dir.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only proceed if the next position is valid (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_valid_move(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if path_to_target is not None:\n      if not primitive_is_grabbable:\n          # If the primitive is non-grabbable, the 'USE' action is required after reaching the target position/direction.\n          actions = path_to_target + [USE]\n      else:\n          # If the primitive is grabbable, simply reaching the target cell is sufficient for collection.\n          actions = path_to_target\n  # If path_to_target remains None, 'actions' stays an empty list, indicating the primitive is unreachable.\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:02:33.187871", "function_name": "collect", "function_body": "  actions = []\n\n  # 1. Get Action Mappings and Primitive Index\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Initial direction of the agent\n  global_grid = current_state.grid\n  W, H, _ = global_grid.shape\n  inventory = current_state.inventory # Check agent's current inventory\n\n  # Optimization: If the primitive is already in the inventory, no actions are needed.\n  if inventory[primitive_idx] > 0:\n      return []\n\n  # Determine if the primitive is grabbable (can be walked on and picked up)\n  # or non-grabbable (requires being adjacent and USE action, e.g., mining stone/water, using workshop).\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Map DMLab action values to (dr, dc) movement deltas AND CraftState.dir values.\n  # CraftState.dir: 0=South (DOWN), 1=North (UP), 2=West (LEFT), 3=East (RIGHT).\n  # The agent's direction updates to match the last movement action.\n  action_to_move_and_dir = {\n      UP: ((-1, 0), 1),    # Move UP, new direction is North (1)\n      DOWN: ((1, 0), 0),   # Move DOWN, new direction is South (0)\n      LEFT: ((0, -1), 2),  # Move LEFT, new direction is West (2)\n      RIGHT: ((0, 1), 3)   # Move RIGHT, new direction is East (3)\n  }\n\n  # Map CraftState.dir values to (dr, dc) deltas for the cell \"in front\" of the agent.\n  # This is crucial for determining where the USE action will apply.\n  dir_to_fwd_delta = {\n      0: (1, 0),  # Facing South, cell in front is (row+1, col)\n      1: (-1, 0), # Facing North, cell in front is (row-1, col)\n      2: (0, -1), # Facing West, cell in front is (row, col-1)\n      3: (0, 1)   # Facing East, cell in front is (row, col+1)\n  }\n\n  # Obstacle indices: cells that cannot be stepped onto (e.g., Water, Stone, Workshops).\n  # The `CraftState.step` method prevents movement into any cell containing a non-grabbable item.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_valid_move(r, c):\n      \"\"\"Checks if (r, c) is within grid bounds and doesn't contain any non-grabbable obstacles.\"\"\"\n      if not (0 <= r < W and 0 <= c < H):\n          return False\n      # A cell is an obstacle if it contains *any* non-grabbable item.\n      # Agent can walk onto grabbable items (e.g., WOOD, IRON), but not non-grabbable ones.\n      if any(global_grid[r, c, obs_idx] == 1 for obs_idx in obstacle_indices):\n          return False\n      return True\n  \n  # BFS Queue: Stores tuples of ( (current_position (r,c), current_direction (int)), path_so_far (list of actions) )\n  queue = collections.deque([(((start_pos), start_dir), [])])\n  \n  # Visited set: Stores (position (r,c), direction (int)) tuples to avoid redundant exploration.\n  # The direction is included because it affects the outcome of a 'USE' action.\n  visited = {(start_pos, start_dir)}\n\n  path_to_target = None # This will store the sequence of actions to reach the target state.\n  \n  while queue:\n      ((r, c), current_dir_val), path_so_far = queue.popleft()\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if primitive_is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to be on the same cell\n          # as the primitive to collect it. The item is collected automatically when stepping on it.\n          if global_grid[r, c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path to a cell containing the grabbable item.\n      else:\n          # For non-grabbable items (e.g., STONE, WATER, WORKSHOP), the agent must be\n          # adjacent to the primitive AND facing it to use the 'USE' action.\n          fwd_dr, fwd_dc = dir_to_fwd_delta[current_dir_val]\n          target_r, target_c = r + fwd_dr, c + fwd_dc\n\n          # Check if the cell directly in front contains the primitive.\n          if 0 <= target_r < W and 0 <= target_c < H and global_grid[target_r, target_c, primitive_idx] == 1:\n              path_to_target = path_so_far\n              break # Found the shortest path ending in the correct position and direction to use the primitive.\n\n      # Explore neighbors by applying movement actions.\n      for action_val, (move_delta, new_dir_val) in action_to_move_and_dir.items():\n          dr, dc = move_delta\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          next_state_tuple = (next_pos, new_dir_val)\n\n          # Only proceed if the next position is valid (within bounds and not an obstacle)\n          # and this (position, direction) state has not been visited before.\n          if is_valid_move(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              queue.append((next_state_tuple, path_so_far + [action_val]))\n  \n  if path_to_target is not None:\n      if not primitive_is_grabbable:\n          # If the primitive is non-grabbable, the 'USE' action is required after reaching the target position/direction.\n          actions = path_to_target + [USE]\n      else:\n          # If the primitive is grabbable, simply reaching the target cell is sufficient for collection.\n          actions = path_to_target\n  # If path_to_target remains None, 'actions' stays an empty list, indicating the primitive is unreachable.\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:03:28.631977", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  if not all_primitive_locations:\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells,\n  # while considering impassable terrain.\n  # This version uses parent pointers for more efficient path reconstruction for potentially long paths.\n  start_pos = current_state.pos\n  \n  # Queue stores only positions to visit\n  q = collections.deque([start_pos])\n  # visited stores {position: (parent_position, action_to_reach_position)}\n  # This allows reconstructing the path by backtracking from the found goal.\n  visited = {start_pos: (None, None)} \n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  # Identify impassable kinds for movement.\n  # We assume items that are non-grabbable AND are NOT workshops are impassable.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Check if this non-grabbable item is *not* a workshop\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  found_goal_pos = None\n\n  while q:\n    cx, cy = q.popleft()\n    current_pos = (cx, cy)\n\n    # If the current position is a goal cell, we have found the shortest path\n    if current_pos in goal_cells:\n      found_goal_pos = current_pos\n      break # Exit BFS, as shortest path is found\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability: A cell is impassable if it contains\n      # any kind from the 'impassable_kinds' set.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited[new_pos] = (current_pos, action) # Store parent and action to reconstruct path\n        q.append(new_pos)\n\n  # If BFS completed and no path to a goal cell was found, the primitive is unreachable.\n  if found_goal_pos is None:\n    return []\n\n  # 5. Reconstruct the path from start_pos to found_goal_pos using parent pointers.\n  path_actions = []\n  current_path_pos = found_goal_pos\n  # Backtrack from the goal position until the start position is reached\n  while current_path_pos != start_pos:\n    parent_pos, action_from_parent = visited[current_path_pos]\n    path_actions.append(action_from_parent)\n    current_path_pos = parent_pos\n  \n  path_actions.reverse() # Path was built in reverse order, so reverse to get correct sequence\n\n  # Append the USE action at the end to collect the primitive\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:03:29.833507", "function_name": "collect", "function_body": "  current_state = env._current_state\n  # Get the integer index for the primitive from the cookbook\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment's action_specs for clarity\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. If the agent is already next to the primitive, simply use it.\n  # This leverages the CraftState's built-in `next_to` check, which is efficient.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Find all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of primitive occurrences\n  primitive_locations_on_grid = [] \n  # Iterate through the grid to find where the primitive is located\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive_idx layer at (x, y) has a value > 0, it means the primitive is there\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive isn't anywhere on the map, we can't collect it.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 3. Determine all \"goal cells\" for the BFS. \n  # A goal cell is any cell adjacent to (or on top of) the primitive, \n  # from which the agent can use the 'USE' action.\n  # For CraftWorld, 'USE' acts on the 3x3 neighborhood. So, any cell (gx,gy)\n  # such that a primitive location (px,py) is in its 3x3 neighborhood.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive location\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores (current_position, path_taken_actions_to_reach_current_position)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant exploration and cycles\n  visited = {start_pos} \n\n  # Define possible movement deltas and their corresponding action indices\n  # (dx, dy) -> action\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (Up on screen Y-)\n      ((0, 1), DOWN),   # Move South (Down on screen Y+)\n      ((-1, 0), LEFT),  # Move West (Left on screen X-)\n      ((1, 0), RIGHT),  # Move East (Right on screen X+)\n  ]\n\n  # Identify impassable kinds. These are non-grabbable items that are not workshops.\n  # The agent cannot move into cells containing these.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops are typically traversable, even if non-grabbable\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  while q:\n    (cx, cy), path = q.popleft() # Dequeue the current position and its path\n\n    # If the current position is one of our target goal cells, we've found the shortest path\n    if (cx, cy) in goal_cells:\n      # The path found leads to the cell from which 'USE' can be applied.\n      return path + [USE]\n\n    # Explore valid neighbors\n    for (dx, dy), action in MOVE_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate new potential position\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check if the new position is impassable.\n      # A cell is impassable if any of the 'impassable_kinds' are present there.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # Check if this specific impassable kind exists at (nx,ny) with a count > 0\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited yet, add it to the queue\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path + [action]))\n\n  # If the BFS queue becomes empty and no path to a goal cell was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:04:47.397366", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Helper to map (dx, dy) from agent_pos to target_pos to the required agent direction.\n  # CraftState dir: 0=N, 1=E, 2=S, 3=W\n  DXDY_TO_DIR_INDEX = {\n      (0, -1): 0, # North (Up on grid)\n      (1, 0): 1,  # East (Right on grid)\n      (0, 1): 2,  # South (Down on grid)\n      (-1, 0): 3, # West (Left on grid)\n  }\n\n  # Helper to map an action to the resulting agent direction index.\n  ACTION_TO_RESULTING_DIR_INDEX = {\n      UP: 0,    # Moving Up (action 1) results in facing North (dir 0)\n      RIGHT: 1, # Moving Right (action 3) results in facing East (dir 1)\n      DOWN: 2,  # Moving Down (action 0) results in facing South (dir 2)\n      LEFT: 3,  # Moving Left (action 2) results in facing West (dir 3)\n  }\n\n  # Direction vectors corresponding to agent's dir (0:N, 1:E, 2:S, 3:W)\n  DIR_INDEX_TO_DXDY = {\n      0: (0, -1), # North\n      1: (1, 0),  # East\n      2: (0, 1),  # South\n      3: (-1, 0), # West\n  }\n\n  # 1. Initial check: If agent is already at a position where it can USE the primitive\n  # (i.e., primitive is in front of the agent), return [USE].\n  cx, cy = current_state.pos\n  current_dir_idx = current_state.dir\n  \n  if current_dir_idx in DIR_INDEX_TO_DXDY:\n      dx, dy = DIR_INDEX_TO_DXDY[current_dir_idx]\n      target_x, target_y = cx + dx, cy + dy\n      grid = current_state.grid\n      grid_width, grid_height, _ = grid.shape\n      \n      if (0 <= target_x < grid_width and 0 <= target_y < grid_height and \n          grid[target_x, target_y, primitive_idx] > 0):\n          return [USE]\n\n  # 2. Find all primitive locations on the grid. We only care about cardinal neighbors\n  # for the USE action, so we'll look for primitive cells that are cardinally reachable.\n  cardinal_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        cardinal_primitive_locations.append((x, y))\n\n  # 3. Define goal states for BFS: (gx, gy, target_dir_for_agent).\n  # A goal state is a (position, direction) pair from which the USE action will hit the primitive.\n  goal_states = set()\n  for px, py in cardinal_primitive_locations:\n    # Iterate through cardinal neighbors of the primitive (where agent could stand)\n    for dx_rel, dy_rel in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # N, S, W, E relative to primitive\n      gx, gy = px + dx_rel, py + dy_rel # Agent's potential position\n\n      # Ensure agent's potential position is within grid bounds\n      if not (0 <= gx < grid_width and 0 <= gy < grid_height):\n        continue\n      \n      # The agent at (gx, gy) needs to face (px, py).\n      # Calculate relative vector from agent_pos to primitive_pos.\n      required_dx, required_dy = px - gx, py - gy\n      \n      if (required_dx, required_dy) in DXDY_TO_DIR_INDEX:\n        required_agent_dir = DXDY_TO_DIR_INDEX[(required_dx, required_dy)]\n        goal_states.add((gx, gy, required_agent_dir))\n\n  if not goal_states: # If no primitive or no valid adjacent positions, cannot collect.\n      return []\n\n  # 4. Perform BFS on (x, y, dir) states to find the shortest path to any goal state.\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Queue stores (x, y, dir_agent_is_facing_at_this_pos)\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir)])\n  # visited stores {(x, y, dir): (parent_x, parent_y, parent_dir, action_to_reach_here)}\n  visited = {(start_pos[0], start_pos[1], start_dir): (None, None, None, None)}\n\n  # Define possible moves (dx, dy), corresponding action, and the resulting agent direction\n  # after that action (0:N, 1:E, 2:S, 3:W).\n  # Assuming moving changes direction.\n  MOVE_ACTIONS_AND_NEW_DIRS = [\n      ((0, -1), UP, ACTION_TO_RESULTING_DIR_INDEX[UP]),    # Move Y- (Up), action UP, new dir North\n      ((0, 1), DOWN, ACTION_TO_RESULTING_DIR_INDEX[DOWN]), # Move Y+ (Down), action DOWN, new dir South\n      ((-1, 0), LEFT, ACTION_TO_RESULTING_DIR_INDEX[LEFT]),# Move X- (Left), action LEFT, new dir West\n      ((1, 0), RIGHT, ACTION_TO_RESULTING_DIR_INDEX[RIGHT]),# Move X+ (Right), action RIGHT, new dir East\n  ]\n\n  # Identify impassable kinds (non-grabbable and not workshops)\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  found_goal_state = None\n\n  while q:\n    cx, cy, c_dir = q.popleft()\n    current_bfs_state = (cx, cy, c_dir)\n\n    # Check if the current state is one of our target goal states\n    if current_bfs_state in goal_states:\n      found_goal_state = current_bfs_state\n      break # Found the shortest path to a valid collection state\n\n    # Explore valid neighboring states (position, direction)\n    for (dx, dy), action, n_dir in MOVE_ACTIONS_AND_NEW_DIRS:\n      nx, ny = cx + dx, cy + dy\n      new_bfs_state = (nx, ny, n_dir)\n\n      # Check grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability at the new position\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0:\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue\n\n      # If the new state (position, direction) has not been visited, add it to the queue\n      if new_bfs_state not in visited:\n        visited[new_bfs_state] = (cx, cy, c_dir, action) # Store parent state and action to reach here\n        q.append(new_bfs_state)\n\n  if found_goal_state is None:\n    return [] # No path found to any goal state (primitive is unreachable)\n\n  # 5. Reconstruct the path of actions from the start state to the found goal state.\n  path_actions = []\n  current_path_state = found_goal_state\n  \n  # Backtrack from the found goal state until the initial state is reached\n  while current_path_state != (start_pos[0], start_pos[1], start_dir):\n    px, py, p_dir, action_taken = visited[current_path_state]\n    path_actions.append(action_taken)\n    current_path_state = (px, py, p_dir)\n  \n  path_actions.reverse() # Path was built in reverse order, so reverse to get correct sequence\n\n  # Append the USE action at the end to collect the primitive\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:04:48.550017", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get primitive index. Use __getitem__ to avoid modifying the index\n  # if the primitive name is not recognized. If it's not found, return an empty list.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    return []\n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's unreachable.\n  if not all_primitive_locations:\n    return []\n\n  # Determine all \"goal cells\" for the BFS. A goal cell is any cell\n  # from which the primitive can be collected (i.e., within its 3x3 neighborhood).\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    # Iterate over the 3x3 neighborhood including the center (dx=0, dy=0)\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within grid bounds\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the goal cells,\n  # while considering impassable terrain.\n  start_pos = current_state.pos\n  \n  # Queue for BFS, storing only positions to visit\n  q = collections.deque([start_pos])\n  # visited stores {position: (parent_position, action_to_reach_position)}\n  # This allows reconstructing the path by backtracking from the found goal.\n  visited = {start_pos: (None, None)} \n\n  # Define possible moves (dx, dy) and their corresponding action indices\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move Y- (Up)\n      ((0, 1), DOWN),   # Move Y+ (Down)\n      ((-1, 0), LEFT),  # Move X- (Left)\n      ((1, 0), RIGHT),  # Move X+ (Right)\n  ]\n\n  # Identify impassable kinds for movement.\n  # These are non-grabbable entities that are not workshops.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  found_goal_pos = None\n\n  while q:\n    cx, cy = q.popleft()\n    current_pos = (cx, cy)\n\n    # If the current position is a goal cell, we have found the shortest path\n    if current_pos in goal_cells:\n      found_goal_pos = current_pos\n      break # Exit BFS, as shortest path is found\n\n    # Explore valid neighboring cells\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue\n\n      # Check for impassability: A cell is impassable if it contains\n      # any kind from the 'impassable_kinds' set.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip it\n\n      # If the new position has not been visited, add it to the queue\n      if new_pos not in visited:\n        visited[new_pos] = (current_pos, action) # Store parent and action for path reconstruction\n        q.append(new_pos)\n\n  # If BFS completed and no path to a goal cell was found, the primitive is unreachable.\n  if found_goal_pos is None:\n    return []\n\n  # Reconstruct the path from start_pos to found_goal_pos using parent pointers.\n  path_actions = []\n  current_path_pos = found_goal_pos\n  # Backtrack from the goal position until the start position is reached\n  while current_path_pos != start_pos:\n    parent_pos, action_from_parent = visited[current_path_pos]\n    path_actions.append(action_from_parent)\n    current_path_pos = parent_pos\n  \n  # Path was built in reverse order, so reverse to get correct sequence\n  path_actions.reverse() \n\n  # Append the USE action at the end to collect the primitive\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:06:08.733553", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid layout at the start of the collection task\n  initial_pos = current_state.pos   # Agent's starting position (row, col)\n  initial_dir = current_state.dir   # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive (e.g., 'WOOD' -> 5)\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid dimensions (e.g., 25, 25, n_kinds)\n\n  # Get the integer mappings for specific actions from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes when moving forward based on its current direction.\n  # Direction mapping: (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN) -> (dr, dc)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: column increases\n      1: (-1, 0),  # Facing UP: row decreases\n      2: (0, -1),  # Facing LEFT: column decreases\n      3: (1, 0)    # Facing DOWN: row increases\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify indices of entities that the agent cannot walk onto.\n  # These are defined as `non_grabbable_indices` in CraftWorld (e.g., BOUNDARY, WATER, WORKSHOP0-2).\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: Check if the primitive is already directly in front of the agent.\n  # If so, just return the USE action.\n  r, c = initial_pos\n  dr, dc = DIR_TO_DRDC[initial_dir]\n  front_r, front_c = r + dr, c + dc\n  if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n      initial_grid[front_r, front_c, primitive_id] > 0):\n      return [USE_ACTION]\n\n  # --- Breadth-First Search (BFS) for shortest path ---\n  # Queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to prevent redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a state where USE can be applied.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent\n\n      # 1. Check if the primitive is directly in front of the agent at the current (pos, dir).\n      # If it is, then we've found a path to a collectable position where 'USE' can be performed.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions # Path to reach this state.\n              break # Shortest path found, terminate BFS.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # A. Try Move Forward action\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Direction does not change when moving forward.\n\n      # Check if the next position is within bounds and this (position, direction) state has not been visited.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          # Determine if the next position is walkable.\n          is_walkable = True\n          # Agent cannot walk onto entities specified in `non_grabbable_indices` (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP_X').\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # IMPORTANT: Unlike collect_v0, we DO NOT check initial_grid[next_r, next_c, primitive_id] > 0 here\n          # to determine walkability. This allows the agent to walk *onto* or *through* a primitive resource\n          # (like WOOD or STONE) if it's not a general non-walkable obstacle.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move)) # Mark new state as visited.\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue.\n\n      # B. Try Turn Left action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # C. Try Turn Right action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path to a collectable position was found, append the 'USE' action to perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # The final action is to 'USE' the primitive.\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:06:09.929437", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Corresponds to moving in the agent's current direction\n  TURN_LEFT_ACTION = action_map['LEFT']    # Turn 90 degrees left\n  TURN_RIGHT_ACTION = action_map['RIGHT']  # Turn 90 degrees right\n  USE_ACTION = action_map['USE']          # Interact with the cell in front or nearby\n\n  # Define changes in (row, column) for each facing direction when moving forward\n  # Directions: 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: +1 column\n      1: (-1, 0),  # Up:    -1 row\n      2: (0, -1),  # Left:  -1 column\n      3: (1, 0)    # Down:  +1 row\n  }\n\n  # Define how direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycle: R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Cycle: R -> D -> L -> U -> R\n\n  # Get indices of entities that are considered non-walkable obstacles (e.g., walls, water, workshops).\n  # These are defined in the CraftWorld and cannot be moved onto.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: If the primitive is already within the agent's 3x3 collection range,\n  # directly apply the USE action. This avoids unnecessary pathfinding.\n  # The `CraftState.next_to()` method conveniently checks this condition.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # --- Breadth-First Search (BFS) for Shortest Path to a Collectable Position ---\n  # The queue stores states: ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_this_state )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set prevents revisiting states and finding suboptimal paths (due to BFS property).\n  # A state is uniquely defined by (position_tuple, direction_int).\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a state from which 'USE' is possible.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Extract current row and column\n\n      # Check if the current agent position (r, c) is a valid location to collect the primitive.\n      # A primitive is collectable if it's found in any cell within the 3x3 neighborhood around the agent.\n      found_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid boundaries\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  found_collectable_position = True\n                  break # Found the primitive in the neighborhood, no need to check further cells for this position.\n          if found_collectable_position:\n              break\n\n      # If a collectable position is found, this path is the shortest to it (due to BFS).\n      if found_collectable_position:\n          target_path = path_actions\n          break # Terminate BFS as the goal is achieved (path to collection point found).\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # 1. Try Move Forward action\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Agent's direction remains unchanged after moving forward.\n\n      # Check if the potential next position is within grid boundaries and this (position, direction) state\n      # has not been visited before to avoid redundant computations and infinite loops.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          is_walkable = True\n          # Determine if the target cell for movement contains any non-walkable entity (obstacle).\n          # The agent cannot move onto cells containing `BOUNDARY`, `WATER`, or `WORKSHOP` types.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          # This version (collect_v2) explicitly allows the agent to walk onto cells containing the\n          # primitive itself (e.g., walking over a block of wood or stone). This is a crucial\n          # improvement over collect_v0, as it treats collectable resources as traversable\n          # unless they are explicitly designated as non-walkable obstacles in `non_walkable_kinds_indices`.\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move)) # Mark the new state as visited.\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION])) # Add to queue for exploration.\n\n      # 2. Try Turn Left action\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right action\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was found during the BFS, append the 'USE' action\n  # to the path to actually collect the primitive.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T03:07:26.585908", "function_name": "collect", "function_body": "  # Get current state and world information\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Convert primitive string (e.g., \"WOOD\") to its internal integer ID.\n  # The Cookbook's index maps names (usually lowercased) to integer IDs.\n  try:\n      primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized by the cookbook, it cannot be collected.\n      # This handles cases where an invalid primitive name might be passed.\n      return []\n\n  # Cache action IDs for efficient lookup within the function.\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define action mappings for BFS movement\n  _MOVE_DELTAS = {\n      ACTION_DOWN: (1, 0),\n      ACTION_UP: (-1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n  MOVE_ACTIONS = list(_MOVE_DELTAS.keys())\n\n  # Identify which primitives require a 'USE' action to be collected.\n  # This includes grabbable items (like WOOD, IRON) and special resources (WATER, STONE).\n  # Workshops and boundaries are \"collected\" by merely being adjacent.\n  is_collectible_via_use = (primitive_idx in world.grabbable_indices or\n                            primitive_idx == world.water_index or\n                            primitive_idx == world.stone_index)\n\n  # 2. Early exit: Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 3. Early exit: Check if the agent is already adjacent to the primitive.\n  # If so, return immediate actions (or none if adjacency is sufficient).\n  if current_state.next_to(primitive_idx):\n      if is_collectible_via_use:\n          # If next to a collectible item, a single 'USE' action is sufficient.\n          return [ACTION_USE]\n      else:\n          # If next to a non-collectible item (e.g., workshop, boundary),\n          # being adjacent means it is effectively \"collected\" or accessible.\n          return []\n\n  # Get grid dimensions\n  WIDTH, HEIGHT = current_state.grid.shape[:2]\n\n  # Helper function to check if a given grid cell (r_agent, c_agent)\n  # is adjacent (within a 3x3 neighborhood, including itself) to the target primitive.\n  # This simulates the logic of CraftState.next_to for an arbitrary agent position.\n  def _is_adjacent_to_primitive(grid_data, r_agent, c_agent, target_p_idx, width, height):\n      for dr_nb in [-1, 0, 1]:  # Iterate through 3x3 neighborhood rows\n          for dc_nb in [-1, 0, 1]:  # Iterate through 3x3 neighborhood columns\n              nr, nc = r_agent + dr_nb, c_agent + dc_nb\n              # Check if the neighbor cell is within grid bounds\n              if 0 <= nr < width and 0 <= nc < height:\n                  # Check if the primitive exists at the neighbor cell (assuming 1 for presence)\n                  if grid_data[nr, nc, target_p_idx] == 1:\n                      return True\n      return False\n\n  # Identify indices of objects that the agent cannot move through.\n  impassable_object_indices = world.non_grabbable_indices\n\n  # Initialize BFS queue with the current position and an empty path.\n  # Queue stores tuples of ((row, column), list_of_actions_to_reach_here).\n  q = collections.deque([(current_state.pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {current_state.pos}\n\n  # BFS loop to find the shortest path to a cell adjacent to the primitive.\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current position (r, c) allows the agent to be adjacent to the primitive,\n      # we have found a candidate path.\n      if _is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n          final_actions = list(path) # Create a copy of the path\n\n          # Append a 'USE' action if the primitive requires it for collection.\n          if is_collectible_via_use:\n              final_actions.append(ACTION_USE)\n          \n          return final_actions # Return the sequence of actions\n\n      # Explore valid neighboring cells to move to\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate new row and column\n\n          # Check if the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if this position has already been visited in this BFS traversal.\n          if (nr, nc) in visited:\n              continue\n\n          # Determine if the new position is traversable.\n          # A cell is traversable if it does not contain any impassable objects.\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[nr, nc, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell\n\n          # If the new position is valid and traversable, add it to the queue and mark as visited.\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action_id]))\n\n  # If the BFS completes without finding any path to the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:07:27.806566", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  # Try to get primitive index robustly.\n  # The DSL uses capitalized names (e.g., \"WOOD\"), but `cookbook.index`'s internal mapping\n  # might vary based on how recipes are loaded (e.g., \"wood\").\n  # Use .get() for safe lookup, trying both original and lowercased names.\n  primitive_idx = world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n      primitive_idx = world.cookbook.index.get(primitive.lower())\n      if primitive_idx is None:\n          # If the primitive name is not recognized by the cookbook, it cannot be collected.\n          return []\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n  \n  # Define action mappings for BFS movement (row/column deltas).\n  # Use `env.action_specs()` to get the integer IDs for actions (e.g., 'DOWN' -> 0).\n  ACTION_IDS = env.action_specs()\n  _MOVE_DELTAS = {\n      ACTION_IDS['DOWN']: (1, 0),    # Down increases row index\n      ACTION_IDS['UP']: (-1, 0),     # Up decreases row index\n      ACTION_IDS['LEFT']: (0, -1),   # Left decreases column index\n      ACTION_IDS['RIGHT']: (0, 1),   # Right increases column index\n  }\n  \n  # Identify indices of objects that the agent cannot move through.\n  # These are generally defined as non-grabbable entities in the world configuration.\n  impassable_object_indices = world.non_grabbable_indices\n\n  # BFS Initialization:\n  # Queue stores tuples of ((row, column), list_of_actions_to_reach_here).\n  q = collections.deque([(current_state.pos, [])])\n  # Set to keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {current_state.pos}\n\n  # Helper function to check if a given grid cell (r_agent, c_agent)\n  # is adjacent (within a 3x3 neighborhood, including itself) to the target primitive.\n  # This simulates the logic of CraftState.next_to for an arbitrary agent position.\n  def _is_adjacent_to_primitive(grid_data, r_agent, c_agent, target_idx, width, height):\n      for dr_nb in [-1, 0, 1]:  # Iterate through 3x3 neighborhood rows\n          for dc_nb in [-1, 0, 1]:  # Iterate through 3x3 neighborhood columns\n              nr, nc = r_agent + dr_nb, c_agent + dc_nb\n              # Check if the neighbor cell is within grid boundaries\n              if not (0 <= nr < width and 0 <= nc < height):\n                  continue\n              # Check if the target primitive exists at the neighbor cell (value 1 for presence)\n              if grid_data[nr, nc, target_idx] == 1:\n                  return True\n      return False\n\n  # BFS loop to find the shortest path to a cell adjacent to the primitive.\n  while q:\n      (r, c), path = q.popleft()\n\n      # If the current position (r, c) is adjacent to the primitive, we've found a path.\n      if _is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n          final_actions = list(path) # Create a mutable copy of the path\n\n          # Determine if a 'USE' action is required after reaching the adjacent position.\n          # Primitives like WOOD, IRON, GRASS, ROCK, GOLD, GEM are typically 'grabbable'\n          # and require a 'USE' action. WATER and STONE are special cases that also require 'USE'.\n          # Environment items like BOUNDARY, WORKSHOPs do not require 'USE' to be considered 'collected';\n          # simply being adjacent is sufficient.\n          \n          # Check if the primitive is in the list of items that can be picked up.\n          is_grabbable = primitive_idx in world.grabbable_indices\n          # Check for special cases like water or stone, which also require a 'USE' action.\n          is_water_or_stone = (primitive_idx == world.water_index or primitive_idx == world.stone_index)\n          \n          # If it's a grabbable item or a specific resource like water/stone, append 'USE'.\n          if is_grabbable or is_water_or_stone:\n              final_actions.append(ACTION_IDS['USE'])\n          \n          return final_actions # Return the sequence of actions to execute\n\n      # Explore valid neighboring cells to move to\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate new row and column for the next position\n\n          # Check if the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if this new position has already been visited in this BFS traversal.\n          if (nr, nc) in visited:\n              continue\n\n          # Determine if the new position is traversable.\n          # A cell is traversable if it does not contain any impassable objects.\n          # We check if any object type present at (nr, nc) is in the `impassable_object_indices` set.\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[nr, nc, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break # Found an impassable object, so this cell is not traversable\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell; skip this path\n\n          # If the new position is valid and traversable, add it to the queue and mark as visited.\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action_id]))\n\n  # If the BFS completes without finding a path to the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T03:09:04.863431", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  primitive_idx = world.cookbook.index[primitive]\n\n  # V2 Improvement: Inventory check remains crucial. If already have it, no need to collect.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n  \n  _MOVE_DELTAS = {\n      env.action_specs()['DOWN']: (1, 0),\n      env.action_specs()['UP']: (-1, 0),\n      env.action_specs()['LEFT']: (0, -1),\n      env.action_specs()['RIGHT']: (0, 1),\n  }\n  \n  # Identify objects that block movement.\n  # Based on common grid-world assumptions and the `CraftWorld` structure,\n  # `non_grabbable_indices` are typically solid obstacles.\n  impassable_object_indices = world.non_grabbable_indices\n\n  q = collections.deque([(current_state.pos, [])])\n  visited = {current_state.pos}\n\n  # Helper function to check adjacency, same as v1.\n  def _is_adjacent_to_primitive(grid, r_agent, c_agent, p_idx, width, height):\n      for dr_nb in [-1, 0, 1]:\n          for dc_nb in [-1, 0, 1]:\n              nr, nc = r_agent + dr_nb, c_agent + dc_nb\n              if 0 <= nr < width and 0 <= nc < height:\n                  if grid[nr, nc, p_idx] == 1:\n                      return True\n      return False\n\n  while q:\n      (r, c), path = q.popleft()\n\n      final_actions = list(path) # Prepare path to extend\n\n      # V2 Improvement: Refined goal condition and action appending based on primitive type.\n      # Different types of primitives are \"collected\" in different ways:\n      # 1. Grabbable items (e.g., WOOD): Collected by walking onto their cell.\n      # 2. Resources requiring USE (e.g., WATER, STONE): Collected by being adjacent and using 'USE'.\n      # 3. Static features (e.g., WORKSHOP, BOUNDARY): \"Collected\" by being adjacent; no 'USE' action.\n\n      is_grabbable_item = primitive_idx in world.grabbable_indices\n      is_resource_requiring_use = (primitive_idx == world.water_index or primitive_idx == world.stone_index)\n      \n      path_found = False\n      \n      if is_grabbable_item:\n          # If the primitive is a grabbable item, the goal is to step onto its cell.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              path_found = True\n              # No 'USE' action is appended, as stepping on it implicitly collects it.\n      elif is_resource_requiring_use:\n          # If the primitive requires a 'USE' action (like Water or Stone), the goal\n          # is to be adjacent to it, then use the 'USE' action.\n          if _is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n              path_found = True\n              final_actions.append(env.action_specs()['USE'])\n      else: \n          # This covers other primitive types from the DSL, typically static environment features\n          # like WORKSHOPs or BOUNDARY. These are \"collected\" by simply being adjacent.\n          # We assume these are part of `world.non_grabbable_indices` and block movement.\n          if _is_adjacent_to_primitive(current_state.grid, r, c, primitive_idx, WIDTH, HEIGHT):\n              path_found = True\n              # No 'USE' action needed; merely being adjacent is sufficient.\n\n      # If a path to the goal (with appropriate final action) is found, return the actions.\n      if path_found:\n          return final_actions\n\n      # Explore valid neighboring cells to move to (same logic as v1).\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc\n\n          # Check if the new position is within grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if the new position has already been visited in this BFS.\n          if (nr, nc) in visited:\n              continue\n\n          # Check traversability: A cell is traversable if it does not contain any impassable objects.\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[nr, nc, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell\n\n          # If the new position is valid and traversable, add it to the queue and mark as visited.\n          visited.add((nr, nc))\n          q.append(((nr, nc), path + [action_id]))\n\n  # If the BFS completes without finding a path, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:09:06.135108", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  primitive_idx = world.cookbook.index[primitive]\n\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n  \n  # Map movement action IDs to their corresponding row/column delta.\n  # These deltas define how the agent's position changes for each move action.\n  _MOVE_DELTAS = {\n      env.action_specs()['DOWN']: (1, 0),\n      env.action_specs()['UP']: (-1, 0),\n      env.action_specs()['LEFT']: (0, -1),\n      env.action_specs()['RIGHT']: (0, 1),\n  }\n\n  # Map movement action IDs to the new direction the agent will be facing after the move.\n  # CraftState.dir: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  _ACTION_TO_NEW_DIR = {\n      env.action_specs()['DOWN']: 0,\n      env.action_specs()['UP']: 1,\n      env.action_specs()['LEFT']: 2,\n      env.action_specs()['RIGHT']: 3\n  }\n  \n  # Map direction indices (0-3) to the (dr, dc) delta for the cell *in front* of the agent.\n  # This is crucial for the 'USE' action which targets the cell in the current facing direction.\n  _DIR_TO_DELTA = {\n      0: (1, 0),  # DOWN\n      1: (-1, 0), # UP\n      2: (0, -1), # LEFT\n      3: (0, 1)   # RIGHT\n  }\n\n  # Identify indices of objects that the agent cannot move through.\n  impassable_object_indices = world.non_grabbable_indices\n\n  # BFS queue: stores tuples of ((row, column), direction, list_of_actions_to_reach_here).\n  q = collections.deque([((current_state.pos[0], current_state.pos[1]), current_state.dir, [])])\n  \n  # Visited set: stores tuples of ((row, column), direction) to avoid redundant exploration and cycles.\n  visited = {(current_state.pos[0], current_state.pos[1], current_state.dir)}\n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Primitives like WOOD, IRON, WATER, STONE usually require 'USE'.\n  # Locations like WORKSHOPs do not; merely being adjacent is sufficient.\n  requires_use_action = (\n      primitive_idx in world.grabbable_indices or \n      primitive_idx == world.water_index or \n      primitive_idx == world.stone_index\n  )\n\n  # BFS loop to find the shortest path to collect the primitive.\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # --- Goal Check ---\n      # This checks if the current state (position and direction) satisfies the collection goal.\n      \n      if requires_use_action:\n          # If 'USE' is required, check the cell directly in front of the agent.\n          dr_front, dc_front = _DIR_TO_DELTA[current_dir]\n          nr_front, nc_front = r + dr_front, c + dc_front\n\n          # Check if the cell in front is within bounds and contains the primitive.\n          if (0 <= nr_front < WIDTH and 0 <= nc_front < HEIGHT and\n                  current_state.grid[nr_front, nc_front, primitive_idx] == 1):\n              # If found, append 'USE' action and return the complete path.\n              return path + [env.action_specs()['USE']]\n      else:\n          # If 'USE' is NOT required (e.g., for workshops or boundaries),\n          # being adjacent to the primitive is sufficient for \"collection\".\n          # Check the 3x3 neighborhood around the agent's current position.\n          for dr_nb in [-1, 0, 1]:\n              for dc_nb in [-1, 0, 1]:\n                  nr_nb, nc_nb = r + dr_nb, c + dc_nb\n                  # Check if the neighbor cell is within grid bounds\n                  if 0 <= nr_nb < WIDTH and 0 <= nc_nb < HEIGHT:\n                      # Check if the primitive exists at the neighbor cell\n                      if current_state.grid[nr_nb, nc_nb, primitive_idx] == 1:\n                          # Found an adjacent primitive, no 'USE' action needed.\n                          return path # Return the path to reach this adjacent position\n\n      # --- Explore Neighbors (Movement Actions) ---\n      # For each possible movement action (UP, DOWN, LEFT, RIGHT).\n      for action_id, (dr, dc) in _MOVE_DELTAS.items():\n          nr, nc = r + dr, c + dc # Calculate the new position after this move.\n          new_dir = _ACTION_TO_NEW_DIR[action_id] # Determine the new facing direction.\n\n          # Check if the new position is within the grid boundaries.\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if this specific (position, direction) state has already been visited.\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # Determine if the new position is traversable.\n          # A cell is traversable if it does not contain any impassable objects.\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[nr, nc, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell.\n\n          # If the new state is valid and traversable, add it to the queue and mark as visited.\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_id]))\n\n  # If the BFS completes without finding a path to collect the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:10:05.789329", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    # The DSL provides primitive names in uppercase (e.g., \"WOOD\", \"STONE\").\n    # The cookbook's index should map these directly to integer IDs.\n    i_kind = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable.\n  # The 'collect' action implies picking up an item using the 'USE' action.\n  # If the item is marked as non-grabbable (e.g., a workshop, water, boundary),\n  # it cannot be collected in this manner.\n  if i_kind in env.world.non_grabbable_indices:\n    return []\n\n  # 3. Define action integers and their effects based on `craft.py` and `CraftState.step` behavior.\n  # These constants are imported from the `craft` module.\n  UP_ACT = craft.UP\n  DOWN_ACT = craft.DOWN\n  LEFT_ACT = craft.LEFT\n  RIGHT_ACT = craft.RIGHT\n  USE_ACT = craft.USE\n\n  # Mapping from movement action constants to the new direction the agent will face.\n  # Based on `CraftState.step` implementation: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  ACTION_TO_NEW_DIR = {\n      DOWN_ACT: 0,\n      UP_ACT: 1,\n      LEFT_ACT: 2,\n      RIGHT_ACT: 3\n  }\n\n  # Mapping from movement action constants to the (dx, dy) delta for agent position.\n  ACTION_TO_MOVE_DELTA = {\n      DOWN_ACT: (0, 1),\n      UP_ACT: (0, -1),\n      LEFT_ACT: (-1, 0),\n      RIGHT_ACT: (1, 0)\n  }\n  \n  # Mapping from direction integer (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT) to (dx, dy) delta\n  # for the cell *in front* of the agent. The 'USE' action targets this cell.\n  DIR_TO_FACING_DELTA = {\n      0: (0, 1),  # Facing DOWN: cell in front is (x, y+1)\n      1: (0, -1), # Facing UP: cell in front is (x, y-1)\n      2: (-1, 0), # Facing LEFT: cell in front is (x-1, y)\n      3: (1, 0)   # Facing RIGHT: cell in front is (x+1, y)\n  }\n\n  # List of all possible movement actions.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # BFS setup:\n  # The queue will store tuples of (current_position: (x,y), current_direction: int, path_of_actions: list[int]).\n  q = collections.deque()\n  # The `visited` set will store (position_tuple, direction_integer) to prevent cycles\n  # and ensure that the shortest path (in terms of actions) to each unique state is found.\n  visited = set()\n\n  # Initialize BFS with the agent's current state.\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q.append((start_pos, start_dir, []))\n  visited.add((start_pos, start_dir))\n\n  # BFS loop:\n  while q:\n    curr_pos, curr_dir, path = q.popleft()\n\n    # Check the cell directly in front of the agent for the desired primitive.\n    # This is the condition under which the 'USE' action would successfully collect the item.\n    face_dx, face_dy = DIR_TO_FACING_DELTA[curr_dir]\n    target_x, target_y = curr_pos[0] + face_dx, curr_pos[1] + face_dy\n\n    # Ensure the target cell is within grid boundaries.\n    if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n        # Check if the primitive (i_kind) is present at the target cell.\n        # `grid[x, y, kind_id] > 0` indicates the item's presence.\n        if grid[target_x, target_y, i_kind] > 0:\n            # If found, we have successfully identified a path to a state from which\n            # the primitive can be collected. Append the 'USE' action and return the path.\n            return path + [USE_ACT]\n\n    # Explore all possible movement actions from the current (position, direction) state.\n    for action in move_actions:\n      # Calculate the next position based on the movement action.\n      move_dx, move_dy = ACTION_TO_MOVE_DELTA[action]\n      next_pos_x, next_pos_y = curr_pos[0] + move_dx, curr_pos[1] + move_dy\n      next_pos = (next_pos_x, next_pos_y)\n      \n      # Determine the new direction the agent will face after performing this action.\n      next_dir = ACTION_TO_NEW_DIR[action]\n\n      # Check if the calculated next position is within the grid boundaries.\n      if 0 <= next_pos_x < WIDTH and 0 <= next_pos_y < HEIGHT:\n        next_state_key = (next_pos, next_dir)\n        # If this (position, direction) state has not been visited yet,\n        # add it to the `visited` set and append it to the queue for further exploration.\n        if next_state_key not in visited:\n          visited.add(next_state_key)\n          q.append((next_pos, next_dir, path + [action]))\n\n  # If the BFS completes (the queue becomes empty) without finding a reachable state\n  # from which the primitive can be collected, it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:10:06.923987", "function_name": "collect", "function_body": "  current_state = env._current_state\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    # Convert primitive name to lowercase as Cookbook index often stores names this way.\n    i_kind = env.world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # Primitive name not found in the cookbook, so it cannot be collected.\n    return []\n\n  # 2. Semantic check: Ensure the item is actually grabbable.\n  # The 'collect' action implies picking up an item. If the item is non-grabbable\n  # (e.g., a workshop, water, boundary), it cannot be collected.\n  if i_kind in env.world.non_grabbable_indices:\n    return []\n\n  # 3. Define action integers using the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of possible movement actions\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # BFS setup\n  # Queue stores tuples of (CraftState object, list of actions to reach this state)\n  q = collections.deque()\n  # Visited set stores (position_x, position_y, direction) to avoid cycles and redundant work.\n  # A tuple of (pos_x, pos_y, direction) uniquely identifies a state for pathfinding.\n  visited = set()\n\n  # Initial state for BFS: current_state with an empty path\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir))\n\n  # Define a maximum search depth / number of states to explore.\n  # This prevents infinite loops for unreachable items and limits computational cost.\n  # A reasonable heuristic for maximum unique states is grid_width * grid_height * number_of_directions (4).\n  grid_width, grid_height, _ = current_state.grid.shape\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 \n  \n  # Counter for explored states to enforce MAX_EXPLORED_STATES limit\n  explored_states_count = 0\n\n  while q:\n    state, path = q.popleft()\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop exploring this path.\n    # This prevents the BFS from running indefinitely for unreachable items or\n    # exploring excessively long, inefficient paths.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Check if we are currently next to the desired primitive\n    if state.next_to(i_kind):\n      # If so, we've found the path to get next to it.\n      # To collect it, we need to append the USE action.\n      return path + [USE_ACT]\n\n    # Explore possible movement actions from the current state\n    for action in move_actions:\n      # Simulate the action to get the next state\n      # state.step(action) returns (reward, new_state)\n      # We ignore reward and other effects for pathfinding purposes here,\n      # focusing only on the new state's position and direction.\n      _, next_state = state.step(action)\n\n      # Create a key for the next state to check if it has been visited\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # If the queue is exhausted and the primitive was not found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:10:56.456574", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # This will raise a KeyError if the primitive name is not valid.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # --- Improvement for v2: Check if the primitive is already collected ---\n  # If the agent's inventory already contains the primitive, no actions are needed\n  # to collect it. This avoids redundant collection attempts.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already have it, return an empty action list.\n\n  # Retrieve action mappings for clarity and to ensure correct action indices are used.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # If the agent is already within the 3x3 neighborhood (including diagonals and its own cell)\n  # of the primitive, it can directly use/collect it.\n  if current_state.next_to(primitive_idx):\n    # This means the agent is in a valid position to interact with the primitive.\n    return [USE]\n\n  # 2. Identify all grid locations where the primitive exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations = []\n  # Iterate through the entire grid to find all cells containing the specified primitive.\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell (count > 0).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's not collectible.\n  if not primitive_locations:\n    return []\n\n  # 3. Define \"goal cells\" for the Breadth-First Search (BFS).\n  # A goal cell is any cell from which the agent can successfully collect the primitive.\n  # Given that `CraftState.next_to` checks the 3x3 neighborhood, any cell in this\n  # 3x3 vicinity of a primitive location is a valid goal.\n  goal_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through all 3x3 neighbors (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds make a cell impassable for agent movement.\n  # Impassable kinds are defined as non-grabbable items that are NOT workshops.\n  # Workshops are typically non-grabbable but often walkable/interactable locations.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # The queue for BFS stores tuples of (current_position, path_taken_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_so_far = q.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our goal cells, we have found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action, as the agent is now in a position to collect the primitive.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions).\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n\n      # Check if the new position is within the overall grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is traversable (not impassable).\n      # A cell is considered impassable if it contains any of the `impassable_kinds`.\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: # If this impassable kind is present at (nx, ny)\n              is_impassable_cell = True\n              break # No need to check other kinds, it's already impassable.\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # If the new position is valid and not visited, add it to the queue for exploration.\n      new_pos = (nx, ny)\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_so_far + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any goal cell,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:10:57.540803", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # 1. Map the string primitive name to its integer index.\n  # This uses the Cookbook's index, which is available via the CraftWorld instance.\n  # An error will be raised if the primitive name is not recognized, which is desirable.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # 2. Extract action mappings for clarity and direct use.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 3. Check for immediate collection: If the agent is already in a position\n  # to collect the primitive (i.e., within its 3x3 neighborhood, including its own cell),\n  # then simply return the USE action. This avoids unnecessary pathfinding.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 4. Identify all physical locations of the primitive on the current grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's kind index has a count greater than zero at (x, y),\n      # it means an instance of the primitive exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # 5. Determine \"goal cells\" for the pathfinding algorithm.\n  # A goal cell is any grid cell from which the agent can use the 'USE' action\n  # to collect the primitive. Based on `CraftState.next_to`, this means any\n  # cell within a 3x3 square centered around a primitive's location.\n  target_collection_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood relative to the primitive's location.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy # Calculate potential goal cell coordinates.\n        # Ensure the potential goal cell is within the overall grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          target_collection_cells.add((gx, gy))\n\n  # 6. Define which environmental kinds are considered \"impassable\" for agent movement.\n  # In CraftWorld, non-grabbable items that are *not* workshops are generally impassable.\n  # Workshops (like BENCH) are non-grabbable but typically traversable.\n  impassable_environment_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 7. Execute a Breadth-First Search (BFS) to find the shortest path.\n  # The BFS aims to find a path from the agent's `start_pos` to any `target_collection_cells`.\n  start_pos = current_state.pos\n  \n  # The queue stores tuples: (current_position (x,y), list_of_actions_to_reach_this_position).\n  bfs_queue = collections.deque([(start_pos, [])]) \n  # The `visited` set prevents revisiting the same cell and avoids infinite loops.\n  visited_cells = {start_pos} \n\n  # Define the possible cardinal movements and their corresponding action indices.\n  # The order (UP, DOWN, LEFT, RIGHT) can affect which path is chosen if multiple\n  # paths have the same minimum length, but not the minimum length itself.\n  CARDINAL_MOVES_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while bfs_queue:\n    # Dequeue the current position and the path leading to it.\n    (current_x, current_y), path_actions = bfs_queue.popleft() \n\n    # If the current cell is one of our target collection cells, we've found the shortest path.\n    if (current_x, current_y) in target_collection_cells:\n      # Append the USE action as the final step, now that the agent is in position.\n      return path_actions + [USE]\n\n    # Explore all four cardinal neighbors from the current cell.\n    for (dx, dy), action_to_take in CARDINAL_MOVES_AND_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy # Calculate the coordinates of the next cell.\n      next_pos = (next_x, next_y)\n\n      # Check 7.1: Ensure the next cell is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 7.2: Determine if the next cell is traversable.\n      # A cell is traversable if it does NOT contain any impassable environment kind.\n      is_next_cell_impassable = False\n      for kind_idx in impassable_environment_kinds:\n          # If the grid cell at (next_x, next_y) contains a count (>0) of an impassable kind,\n          # then this cell cannot be moved into.\n          if grid[next_x, next_y, kind_idx] > 0: \n              is_next_cell_impassable = True\n              break # Found an impassable kind, no need to check further.\n      \n      if is_next_cell_impassable:\n          continue # Skip this cell if it's impassable.\n\n      # Check 7.3: Ensure the next cell has not been visited before in this BFS path.\n      if next_pos not in visited_cells:\n        visited_cells.add(next_pos) # Mark as visited.\n        # Enqueue the next position with the updated path.\n        bfs_queue.append((next_pos, path_actions + [action_to_take]))\n\n  # If the BFS queue becomes empty and no path to a target collection cell was found,\n  # it means the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:11:49.252019", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape # WIDTH is columns, HEIGHT is rows. Grid accessed as grid[x, y, kind].\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    i_kind = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Ensure the item is actually grabbable and collectable via 'USE'.\n  # Primitives like WORKSHOPs or BOUNDARY are defined in the DSL but are not \"collected\" this way.\n  # The 'USE' action only works on grabbable items or specific environmental features.\n  # Based on CraftWorld loading, `cookbook.environment` contains non-grabbable entities.\n  # If the target primitive is in the non-grabbable set, it cannot be collected using 'USE'.\n  if i_kind in env.world.non_grabbable_indices:\n    return [] # Cannot \"collect\" an impassable or non-grabbable entity.\n\n  # 4. Define action integers and their effects based on `craft.py` and `CraftState.step` behavior.\n  UP_ACT = craft.UP\n  DOWN_ACT = craft.DOWN\n  LEFT_ACT = craft.LEFT\n  RIGHT_ACT = craft.RIGHT\n  USE_ACT = craft.USE\n\n  # Mapping from movement action constants to the new direction the agent will face.\n  # Based on `CraftState.step` implementation: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  ACTION_TO_NEW_DIR = {\n      DOWN_ACT: 0,\n      UP_ACT: 1,\n      LEFT_ACT: 2,\n      RIGHT_ACT: 3\n  }\n\n  # Mapping from movement action constants to the (dx, dy) delta for agent position.\n  # (dx, dy) where dx is change in column (x), dy is change in row (y).\n  ACTION_TO_MOVE_DELTA = {\n      DOWN_ACT: (0, 1),   # (x, y) -> (x, y+1)\n      UP_ACT: (0, -1),   # (x, y) -> (x, y-1)\n      LEFT_ACT: (-1, 0), # (x, y) -> (x-1, y)\n      RIGHT_ACT: (1, 0)  # (x, y) -> (x+1, y)\n  }\n  \n  # Mapping from direction integer (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT) to (dx, dy) delta\n  # for the cell *in front* of the agent. The 'USE' action targets this cell.\n  DIR_TO_FACING_DELTA = {\n      0: (0, 1),  # Facing DOWN: cell in front is (x, y+1)\n      1: (0, -1), # Facing UP: cell in front is (x, y-1)\n      2: (-1, 0), # Facing LEFT: cell in front is (x-1, y)\n      3: (1, 0)   # Facing RIGHT: cell in front is (x+1, y)\n  }\n\n  # List of all possible movement actions.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Get the set of indices for objects that block movement.\n  # These are the items that the agent cannot move *into*.\n  impassable_object_indices = env.world.non_grabbable_indices\n\n  # BFS setup:\n  # The queue will store tuples of (current_position: (x,y), current_direction: int, path_of_actions: list[int]).\n  q = collections.deque()\n  # The `visited` set will store (position_tuple, direction_integer) to prevent cycles\n  # and ensure that the shortest path (in terms of actions) to each unique state is found.\n  visited = set()\n\n  # Initialize BFS with the agent's current state.\n  start_pos = current_state.pos # (x, y)\n  start_dir = current_state.dir\n  q.append((start_pos, start_dir, []))\n  visited.add((start_pos, start_dir))\n\n  # BFS loop:\n  while q:\n    curr_pos, curr_dir, path = q.popleft()\n    curr_x, curr_y = curr_pos\n\n    # 5. Goal Check: Can we collect the primitive from the current state?\n    # This involves checking the cell directly in front of the agent.\n    face_dx, face_dy = DIR_TO_FACING_DELTA[curr_dir]\n    target_x, target_y = curr_x + face_dx, curr_y + face_dy\n\n    # Ensure the target cell is within grid boundaries.\n    if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n        # Check if the primitive (i_kind) is present at the target cell.\n        # `grid[x, y, kind_id] > 0` indicates the item's presence.\n        if grid[target_x, target_y, i_kind] > 0:\n            # If found, we have successfully identified a path to a state from which\n            # the primitive can be collected. Append the 'USE' action and return the path.\n            return path + [USE_ACT]\n\n    # 6. Explore all possible movement actions from the current (position, direction) state.\n    for action in move_actions:\n      # Calculate the next position based on the movement action.\n      move_dx, move_dy = ACTION_TO_MOVE_DELTA[action]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_pos = (next_x, next_y)\n      \n      # Determine the new direction the agent will face after performing this action.\n      next_dir = ACTION_TO_NEW_DIR[action]\n\n      # Check if the calculated next position is within the grid boundaries.\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n          continue # Out of bounds, cannot move here.\n\n      # Check if the new position is traversable.\n      # A cell is traversable if it does not contain any impassable objects.\n      is_traversable = True\n      for impassable_k_idx in impassable_object_indices:\n          if grid[next_x, next_y, impassable_k_idx] == 1:\n              is_traversable = False\n              break # Found an impassable object, this cell is blocked.\n      \n      if not is_traversable:\n          continue # Cannot move into an impassable cell.\n\n      # If the new (position, direction) state has not been visited yet,\n      # add it to the `visited` set and append it to the queue for further exploration.\n      next_state_key = (next_pos, next_dir)\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_pos, next_dir, path + [action]))\n\n  # 7. If the BFS completes (the queue becomes empty) without finding a reachable state\n  # from which the primitive can be collected, it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:11:50.620278", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  # The DSL ensures 'primitive' will be a valid string like \"WOOD\", \"STONE\".\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name isn't recognized, it cannot be collected.\n    return []\n\n  # If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Check if the primitive is inherently non-grabbable.\n  # If it's a \"kind\" that cannot be picked up (like a workshop or boundary),\n  # then 'collect' (which implies using 'USE') is not applicable.\n  # Water and Stone are 'grabbable' in the sense they can be gathered, but\n  # might not be in the 'grabbable_indices' set if they require tools.\n  # However, the general expectation for 'collect primitive' is that a 'USE' action works.\n  # The `CraftState.step` method handles what happens when 'USE' is applied to\n  # various types (e.g., water, stone, wood, iron).\n  # We should only return an empty list if it's explicitly an *impassable* object.\n  # The BFS will implicitly avoid impassable objects anyway.\n\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n  \n  # Action integer constants from the craft module\n  UP_ACT = craft.UP\n  DOWN_ACT = craft.DOWN\n  LEFT_ACT = craft.LEFT\n  RIGHT_ACT = craft.RIGHT\n  USE_ACT = craft.USE\n\n  # Mapping of movement actions to their (dx, dy) grid deltas.\n  # These correspond to the agent's position change.\n  _MOVE_DELTAS = {\n      DOWN_ACT: (0, 1),\n      UP_ACT: (0, -1),\n      LEFT_ACT: (-1, 0),\n      RIGHT_ACT: (1, 0),\n  }\n  \n  # Mapping of movement actions to the new direction the agent will face.\n  # The direction is simply the action ID for movement actions (0=DOWN, 1=UP, etc.).\n  _ACTION_TO_NEW_DIR = {\n      DOWN_ACT: 0,\n      UP_ACT: 1,\n      LEFT_ACT: 2,\n      RIGHT_ACT: 3,\n  }\n\n  # Mapping of agent's direction to the (dx, dy) delta for the cell *in front* of the agent.\n  # This is crucial for determining what the 'USE' action targets.\n  _DIR_TO_FACING_DELTA = {\n      0: (0, 1),   # Facing DOWN: targets cell (x, y+1)\n      1: (0, -1),  # Facing UP: targets cell (x, y-1)\n      2: (-1, 0),  # Facing LEFT: targets cell (x-1, y)\n      3: (1, 0),   # Facing RIGHT: targets cell (x+1, y)\n  }\n\n  # Indices of objects that the agent cannot move through (e.g., walls, water unless specified).\n  # These are defined as `world.non_grabbable_indices`.\n  impassable_object_indices = world.non_grabbable_indices\n\n  # BFS queue: Stores tuples of ((x, y), direction, path_of_actions)\n  q = collections.deque()\n  # Visited set: Stores tuples of ((x, y), direction) to avoid redundant exploration\n  visited = set()\n\n  # Initialize BFS with the agent's current state\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q.append((start_pos, start_dir, []))\n  visited.add((start_pos, start_dir))\n\n  # BFS loop\n  while q:\n      (curr_x, curr_y), curr_dir, path = q.popleft()\n\n      # Check if the primitive is directly in front of the agent (where USE would apply).\n      face_dx, face_dy = _DIR_TO_FACING_DELTA[curr_dir]\n      target_x, target_y = curr_x + face_dx, curr_y + face_dy\n\n      # Check if the target cell is within grid boundaries.\n      if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT:\n          # Check if the primitive is present in the target cell.\n          # `grid[x, y, kind_id] > 0` indicates presence.\n          if current_state.grid[target_x, target_y, primitive_idx] > 0:\n              # We found a state from which the primitive can be collected.\n              # Append the 'USE' action and return the full action path.\n              return path + [USE_ACT]\n\n      # Explore possible movement actions from the current state.\n      for action_id in [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]:\n          move_dx, move_dy = _MOVE_DELTAS[action_id]\n          next_x, next_y = curr_x + move_dx, curr_y + move_dy\n          next_pos = (next_x, next_y)\n          next_dir = _ACTION_TO_NEW_DIR[action_id]\n\n          # Check if the next position is within grid boundaries.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the new position is traversable (does not contain impassable objects).\n          is_traversable = True\n          for impassable_k_idx in impassable_object_indices:\n              if current_state.grid[next_x, next_y, impassable_k_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if not is_traversable:\n              continue # Cannot move into an impassable cell\n\n          # If this (position, direction) state hasn't been visited, add it to the queue.\n          next_state_key = (next_pos, next_dir)\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              q.append((next_pos, next_dir, path + [action_id]))\n\n  # If the BFS completes and the queue is empty, it means no path to the primitive was found.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T03:12:44.862376", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, cannot be collected.\n    return []\n\n  # 2. Pre-check: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Define action integers and grid dimensions\n  action_map = env.action_specs()\n  USE_ACT = action_map[\"USE\"]\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # Map movement action IDs to their corresponding row/column delta.\n  _MOVE_DELTAS = {\n      action_map['DOWN']: (1, 0),\n      action_map['UP']: (-1, 0),\n      action_map['LEFT']: (0, -1),\n      action_map['RIGHT']: (0, 1),\n  }\n\n  # Map movement action IDs to the new direction the agent will be facing after the move.\n  # CraftState.dir: 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT.\n  _ACTION_TO_NEW_DIR = {\n      action_map['DOWN']: 0,\n      action_map['UP']: 1,\n      action_map['LEFT']: 2,\n      action_map['RIGHT']: 3\n  }\n\n  # Map direction indices (0-3) to the (dr, dc) delta for the cell *in front* of the agent.\n  _DIR_TO_DELTA = {\n      0: (1, 0),  # DOWN\n      1: (-1, 0), # UP\n      2: (0, -1), # LEFT\n      3: (0, 1)   # RIGHT\n  }\n\n  # Identify indices of objects that the agent cannot move through.\n  # These are typically non-grabbable entities like walls, water (unless traversable by other means), workshops (as obstacles to movement).\n  # We should exclude the primitive itself if it's a workshop we need to walk on/through to reach another goal.\n  impassable_object_indices = set(world.non_grabbable_indices)\n\n  # BFS setup\n  # Queue stores tuples of ((row, column), direction, list_of_actions_to_reach_here).\n  q = collections.deque([((current_state.pos[0], current_state.pos[1]), current_state.dir, [])])\n\n  # Visited set: stores tuples of ((row, column), direction) to avoid redundant exploration and cycles.\n  visited = {(current_state.pos[0], current_state.pos[1], current_state.dir)}\n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Grabbable items (like WOOD, IRON, WATER, STONE) require 'USE'.\n  # Non-grabbable items (like WORKSHOPs, BOUNDARY) only require adjacency (no 'USE').\n  requires_use_action = (primitive_idx in world.grabbable_indices)\n\n  # BFS loop to find the shortest path to collect the primitive.\n  # A maximum search depth helps prevent infinite loops in complex or unreachable scenarios.\n  max_search_length = WIDTH * HEIGHT * len(_MOVE_DELTAS) * 2 # Roughly 2 full traversals of all states\n\n  while q:\n    (r, c), current_dir, path = q.popleft()\n\n    # Pruning: If path becomes too long, it's likely inefficient or unreachable.\n    if len(path) > max_search_length:\n      continue\n\n    # --- Goal Check ---\n    # This checks if the current state (position and direction) satisfies the collection goal.\n    \n    if requires_use_action:\n      # If 'USE' is required, check the cell directly in front of the agent.\n      dr_front, dc_front = _DIR_TO_DELTA[current_dir]\n      nr_front, nc_front = r + dr_front, c + dc_front\n\n      # Check if the cell in front is within bounds and contains the primitive.\n      if (0 <= nr_front < WIDTH and 0 <= nc_front < HEIGHT and\n              current_state.grid[nr_front, nc_front, primitive_idx] == 1):\n        # If found, append 'USE' action and return the complete path.\n        return path + [USE_ACT]\n    else:\n      # If 'USE' is NOT required (e.g., for workshops or boundaries),\n      # being adjacent to the primitive is sufficient for \"collection\".\n      # Check the 3x3 neighborhood around the agent's current position.\n      for dr_nb in [-1, 0, 1]:\n        for dc_nb in [-1, 0, 1]:\n          nr_nb, nc_nb = r + dr_nb, c + dc_nb\n          # Check if the neighbor cell is within grid bounds\n          if 0 <= nr_nb < WIDTH and 0 <= nc_nb < HEIGHT:\n            # Check if the primitive exists at the neighbor cell\n            if current_state.grid[nr_nb, nc_nb, primitive_idx] == 1:\n              # Found an adjacent primitive, no 'USE' action needed.\n              return path # Return the path to reach this adjacent position\n\n    # --- Explore Neighbors (Movement Actions) ---\n    for action_id, (dr, dc) in _MOVE_DELTAS.items():\n      nr, nc = r + dr, c + dc # Calculate the new position after this move.\n      new_dir = _ACTION_TO_NEW_DIR[action_id] # Determine the new facing direction.\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n        continue\n\n      # Check if this specific (position, direction) state has already been visited.\n      if (nr, nc, new_dir) in visited:\n        continue\n\n      # Determine if the new position is traversable.\n      # A cell is traversable if it does not contain any impassable objects.\n      is_traversable = True\n      for impassable_k_idx in impassable_object_indices:\n        if impassable_k_idx == primitive_idx and not requires_use_action:\n            # If the primitive itself is an impassable object (e.g., a workshop)\n            # and we just need to be adjacent to it (not move through it),\n            # then treat it as traversable *if it's the target primitive*.\n            # This allows moving onto a workshop tile if that's where we need to be.\n            # However, for a generic BFS for 'collect', we usually don't want to path *through*\n            # the item we're looking for, but to *get next to* it or *on* it.\n            # For workshops, often you can stand on them.\n            # The current logic correctly checks for *any* impassable object.\n            # If the target is a workshop and it's marked as non-grabbable/impassable,\n            # then the agent won't path onto it. This is usually desired behavior.\n            continue # If it's the target primitive and we just need adjacency, we can move here.\n        if current_state.grid[nr, nc, impassable_k_idx] == 1:\n          is_traversable = False\n          break\n      \n      if not is_traversable:\n        continue # Cannot move into an impassable cell.\n\n      # If the new state is valid and traversable, add it to the queue and mark as visited.\n      visited.add((nr, nc, new_dir))\n      q.append(((nr, nc), new_dir, path + [action_id]))\n\n  # If the BFS completes without finding a path to collect the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
