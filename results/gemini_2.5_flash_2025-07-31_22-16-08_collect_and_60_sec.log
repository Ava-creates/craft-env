nt_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state (ready for USE action)\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited):\n          \n          is_walkable = True\n          # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n          # by summing counts for all non-grabbable kinds at that cell.\n          # Only perform sum if there are non-walkable kinds defined to avoid error on empty list.\n          if non_walkable_kinds_indices and np.sum(initial_grid[next_r, next_c, non_walkable_kinds_indices]) > 0:\n              is_walkable = False\n          # Agent also cannot walk onto the primitive itself, as it needs to be \"used\" from an adjacent square\n          elif initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:07:59.083984", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Crucial validation: Ensure the primitive is actually a grabbable item.\n  # If it's not in the list of grabbable_indices (e.g., it's a boundary, water,\n  # or a workshop), it cannot be collected using the 'USE' action.\n  # In such cases, this function should return an empty list, as it's not\n  # a collectible primitive.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  GRID_WIDTH, GRID_HEIGHT, _ = initial_grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from env.action_specs()\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Common convention for 'move forward'\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: Defines (dr, dc) vector for agent's facing direction.\n  # This determines how position changes when moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +column\n      1: (-1, 0),  # Facing UP: -row\n      2: (0, -1),  # Facing LEFT: -column\n      3: (1, 0)    # Facing DOWN: +row\n  }\n\n  # Map for updating agent's direction after turning left/right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Define cells that are NOT walkable by the agent.\n  # This includes all non-grabbable entities (like BOUNDARY, WATER, WORKSHOP_X)\n  # and crucially, also the primitive itself. The agent must be *adjacent* to\n  # the primitive to collect it, not standing on its cell.\n  # Converting to a list for efficient NumPy advanced indexing later.\n  non_walkable_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS initialization for pathfinding.\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the sequence of actions to reach the \"adjacent and facing\" state.\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the goal state is reached: The primitive is directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell directly in front is within grid bounds.\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive we want to collect (count > 0).\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Found the shortest path to be adjacent and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check bounds and if this (position, direction) state has been visited.\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next_pos cell is walkable.\n          # A cell is walkable if none of the `non_walkable_indices` are present in it.\n          # `np.any` returns True if any element in the specified slice is > 0.\n          if not np.any(initial_grid[next_r, next_c, non_walkable_indices] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent and facing position, append the USE action\n  # to complete the collection.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:08:00.263336", "function_name": "collect", "function_body": "  primitive_id = current_state.world.cookbook.index.get(primitive)\n\n  # V2 Improvement 1: Validate primitive ID; if not found, it's an invalid primitive.\n  if primitive_id is None:\n      return [] # Cannot collect an unknown primitive\n\n  # V2 Improvement 2: Check if primitive is already in inventory.\n  # If we already have the item, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # V2 Improvement 3: Validate primitive is grabbable.\n  # If it's not in the list of grabbable items (e.g., WATER, STONE, WORKSHOP),\n  # it cannot be 'collected' by picking it up using the USE action.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  actions_list = []\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' means move forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # (dr, dc) represents (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): row stays same, col increases\n      1: (-1, 0),  # Facing UP (North): row decreases, col stays same\n      2: (0, -1),  # Facing LEFT (West): row stays same, col decreases\n      3: (1, 0)    # Facing DOWN (South): row increases, col stays same\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Define cells that are not walkable by the agent.\n  # This includes all non-grabbable entities (like boundaries, water, workshops)\n  # and also the primitive itself (the agent wants to be adjacent to it, not on it).\n  # Convert to list for efficient NumPy advanced indexing.\n  non_walkable_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state (adjacent and facing primitive)\n\n  # V2 Improvement 4: Add a maximum number of steps for BFS to prevent excessively long searches\n  # or infinite loops in cases where no path exists or map is very large.\n  # Total possible states: WIDTH * HEIGHT * 4 directions.\n  MAX_BFS_STATES = WIDTH * HEIGHT * 4\n  states_explored = 0\n\n  while queue and states_explored < MAX_BFS_STATES:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n      states_explored += 1\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # If so, this path is a candidate for reaching the target.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive (its count > 0)\n          # We check the initial_grid because the BFS explores hypothetical movements\n          # without modifying the actual environment state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Found the shortest path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward (corresponds to 'UP' action in action_specs)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if the next_pos cell is walkable.\n          # It's walkable if none of the non_walkable_indices (obstacles or the primitive itself)\n          # are present in that cell. `np.any` returns True if any element is True.\n          # So, `not np.any(...)` means \"none of the obstacles are present\".\n          if not np.any(initial_grid[next_r, next_c, non_walkable_indices] > 0):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left (corresponds to 'LEFT' action in action_specs)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right (corresponds to 'RIGHT' action in action_specs)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:09:00.292001", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Alias for current state for cleaner code\n  state = env._current_state \n\n  grid = state.grid\n  initial_pos = state.pos # tuple (r, c)\n  initial_dir = state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks\n  grid_rows, grid_cols, _ = grid.shape \n\n  # Map DSL actions to their integer indices from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving forward based on agent's current direction\n  # DIR_TO_DRDC[direction]: (delta_row, delta_col)\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: (row, col+1)\n      1: (-1, 0),  # Up:    (row-1, col)\n      2: (0, -1),  # Left:  (row, col-1)\n      3: (1, 0)    # Down:  (row+1, col)\n  }\n\n  # Define how turning actions update the agent's direction\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all kinds that block agent movement.\n  # This includes non-grabbable items (like boundaries, water, workshops)\n  # and the primitive itself (as the agent must be adjacent to 'use' it, not on it).\n  blocking_kinds_set = set(state.world.non_grabbable_indices)\n  blocking_kinds_set.add(primitive_id) \n  # Convert to a numpy array for efficient checking using np.any\n  blocking_kinds_array = np.array(list(blocking_kinds_set), dtype=int)\n\n\n  # BFS initialization:\n  # Queue stores tuples of ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacency = None # This will store the action sequence leading to the state\n                                   # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at the current state.\n      # This is our goal condition for stopping the BFS.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # If the front cell contains the primitive, we've found the path to be adjacent and facing it.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacency = path_actions\n              break # Path to target found, exit BFS\n\n      # Explore possible next actions (Move Forward, Turn Left, Turn Right)\n\n      # Action: Move Forward\n      next_r_forward, next_c_forward = r + front_dr, c + front_dc # Reuse front_dr, front_dc for movement\n      next_pos_forward = (next_r_forward, next_c_forward)\n      next_dir_forward = current_dir # Direction does not change when moving forward\n\n      # Check if the forward move is valid:\n      # - Within grid boundaries\n      # - This (position, direction) state has not been visited yet\n      # - The target cell is walkable (does not contain any blocking kinds)\n      if (0 <= next_r_forward < grid_rows and 0 <= next_c_forward < grid_cols and\n          (next_pos_forward, next_dir_forward) not in visited):\n          \n          # Check if the cell at next_pos_forward is walkable using the pre-computed blocking_kinds_array.\n          # np.any will be True if any of the blocking kinds are present in the cell.\n          is_walkable = not np.any(grid[next_r_forward, next_c_forward, blocking_kinds_array] > 0)\n          \n          if is_walkable:\n              visited.add((next_pos_forward, next_dir_forward))\n              queue.append(((next_pos_forward, next_dir_forward), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action: Turn Left (position remains the same)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action: Turn Right (position remains the same)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach the state where the agent is adjacent to the primitive and facing it,\n  # append the USE action to complete the collection process.\n  if target_path_to_adjacency is not None:\n      actions_list.extend(target_path_to_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:09:01.454820", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos # tuple (row, col)\n  agent_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions for boundary checks\n  grid_rows, grid_cols, _ = grid.shape \n\n  # Map DSL action names to their integer indices using the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP'] # 'UP' in action_specs means move forward relative to agent's dir\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ITEM = action_map['USE']\n\n  # Define changes in (row, col) for each direction when moving forward\n  # DIR_TO_DRDC[direction]: (delta_row, delta_col)\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DR_DC_MAP = {\n      0: (0, 1),   \n      1: (-1, 0),  \n      2: (0, -1),  \n      3: (1, 0)    \n  }\n\n  # Define how turning actions update the agent's direction (clockwise/counter-clockwise cycle)\n  # Left turn: Right(0)->Up(1)->Left(2)->Down(3)->Right(0)\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0} \n  # Right turn: Right(0)->Down(3)->Left(2)->Up(1)->Right(0)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} \n\n  # Identify all kinds that block agent movement.\n  # This includes non-grabbable items (like boundaries, water, workshops)\n  # and the primitive itself, as the agent cannot walk ONTO the primitive,\n  # but must be adjacent to it to 'USE' it.\n  blocking_kind_ids = set(current_state.world.non_grabbable_indices)\n  blocking_kind_ids.add(primitive_id) \n  # Convert to a numpy array for efficient checking using np.any\n  blocking_kind_ids_array = np.array(list(blocking_kind_ids), dtype=int)\n\n\n  # Helper function to check if a position (r, c) is within grid boundaries\n  def is_in_bounds(r, c):\n      return 0 <= r < grid_rows and 0 <= c < grid_cols\n\n  # Helper function to check if a grid cell at (r, c) is walkable\n  # A cell is walkable if it's in bounds and does not contain any blocking kinds.\n  def is_walkable(r, c):\n      if not is_in_bounds(r, c):\n          return False\n      # Check if any of the blocking kinds are present at the given cell (r, c)\n      return not np.any(grid[r, c, blocking_kind_ids_array] > 0)\n\n  # BFS initialization:\n  # Queue stores tuples of ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((agent_pos, agent_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent redundant exploration and cycles\n  visited = {(agent_pos, agent_dir)}\n\n  path_to_adjacent_primitive = None # This will store the action sequence leading to the state\n                                   # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Step 1: Check if the primitive is directly in front of the agent at the current state.\n      # This is our goal condition for stopping the BFS.\n      dr_front, dc_front = DR_DC_MAP[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # If the cell in front is within grid boundaries and contains the primitive,\n      # we've found the shortest path to be adjacent and facing it.\n      if is_in_bounds(front_r, front_c) and grid[front_r, front_c, primitive_id] > 0:\n          path_to_adjacent_primitive = path_actions\n          break # Path to target found, exit BFS\n\n      # Step 2: Explore possible next actions (Move Forward, Turn Left, Turn Right)\n\n      # Action: Move Forward\n      next_r_move, next_c_move = r + dr_front, c + dc_front # Calculate position after moving forward\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction does not change when moving forward\n\n      # Check if the forward move is valid:\n      # - The target cell is walkable (does not contain blocking items)\n      # - This (position, direction) state has not been visited yet\n      if is_walkable(next_r_move, next_c_move) and \\\n         ((next_pos_move, next_dir_move) not in visited):\n          \n          visited.add((next_pos_move, next_dir_move))\n          queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD]))\n\n      # Action: Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Position remains the same when turning\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT]))\n\n      # Action: Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Position remains the same when turning\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT]))\n\n  # If a path was found to reach the state where the agent is adjacent to the primitive and facing it,\n  # append the USE action to complete the collection process.\n  if path_to_adjacent_primitive is not None:\n      actions_list.extend(path_to_adjacent_primitive)\n      actions_list.append(USE_ITEM)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:10:04.313020", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Preliminary check: If the primitive is not something the agent can grab (e.g., water, boundary, workshops),\n  # then it cannot be \"collected\" via the USE action. Return an empty list of actions.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Extract key information from the current environment state for pathfinding.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map DSL action names to their corresponding integer indices provided by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # Agent moves one step in its current facing direction.\n  TURN_LEFT_ACTION = action_map['LEFT']    # Agent turns 90 degrees left (counter-clockwise).\n  TURN_RIGHT_ACTION = action_map['RIGHT']  # Agent turns 90 degrees right (clockwise).\n  USE_ACTION = action_map['USE']           # Agent attempts to interact with the cell directly in front.\n\n  # Define changes in (row, col) for movement based on the agent's current direction.\n  # This mapping is crucial for calculating the next position when moving forward,\n  # and for identifying the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (delta_row, delta_col) = (0, +1)\n      1: (-1, 0),  # Facing UP (North):    (delta_row, delta_col) = (-1, 0)\n      2: (0, -1),  # Facing LEFT (West):   (delta_row, delta_col) = (0, -1)\n      3: (1, 0)    # Facing DOWN (South):  (delta_row, delta_col) = (+1, 0)\n  }\n\n  # Define how the agent's integer direction changes when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 (Right -> Up -> Left -> Down -> Right)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Compile a comprehensive list of all entity indices that block agent movement.\n  # The agent cannot move onto these cells. This includes:\n  # 1. Non-grabbable environment features (e.g., boundaries, water, workshops).\n  # 2. The target 'primitive' itself. The agent must stand *adjacent* to the primitive\n  #    to 'USE' it, not occupy the same grid cell as the primitive.\n  all_blocking_indices = list(current_state.world.non_grabbable_indices.union({primitive_id}))\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest sequence of actions.\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position_tuple, direction_int) states.\n  # This prevents revisiting the same state, avoiding redundant computation and infinite loops,\n  # and guarantees that the first path found is the shortest in terms of actions.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the action sequence once the goal state is found.\n\n  # Begin the BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Unpack current row and column coordinates.\n\n      # Step 1: Check if the agent is currently in the desired \"collectable\" state.\n      # This state is defined as having the target primitive directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir] # Get movement deltas for the agent's current facing direction.\n      front_r, front_c = r + front_dr, c + front_dc # Calculate the coordinates of the cell directly in front.\n      \n      # Ensure the calculated 'front_cell' is within the overall grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the target primitive is present in the cell directly in front.\n          # A value > 0 in the grid at a specific kind index indicates the presence of that item.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # The shortest path to reach this adjacent-and-facing state is found.\n              break # Exit the BFS loop immediately, as BFS guarantees the shortest path.\n\n      # Step 2: Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Try Move Forward ---\n      # Calculate the agent's potential next position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is within grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this specific (position, direction) state has not been visited before.\n          if (next_pos, next_dir) not in visited:\n              # Crucially, check if the proposed 'next_pos' is \"walkable\".\n              # This means the cell does not contain any of the 'all_blocking_indices' items.\n              # `np.any` returns True if any of the specified blocking kinds are present with count > 0.\n              if not np.any(initial_grid[next_r, next_c, all_blocking_indices] > 0):\n                  visited.add((next_pos, next_dir)) # Mark this new state as visited.\n                  # Add the new state to the BFS queue, appending the MOVE_FORWARD_ACTION to the path.\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      # Calculate the agent's new direction after turning left.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes the agent's direction but not its position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark this new state as visited.\n          # Add the new state to the queue, appending the TURN_LEFT_ACTION to the path.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      # Calculate the agent's new direction after turning right.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes the agent's direction but not its position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark this new state as visited.\n          # Add the new state to the queue, appending the TURN_RIGHT_ACTION to the path.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path was successfully found (i.e., 'target_path_actions' is not None),\n  # extend the 'actions_list' with the found path and then append the 'USE' action.\n  # The 'USE' action performs the final collection of the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:10:05.492759", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # CRITICAL PRE-CHECK: Determine if the primitive is an item that can actually\n  # be 'picked up' or 'used' (grabbed) by the agent. Non-grabbable items like\n  # 'BOUNDARY', 'WATER', 'STONE', or 'WORKSHOP' are static environment features\n  # and cannot be collected via the 'USE' action. If it's not grabbable,\n  # no sequence of actions will truly \"collect\" it in the inventory,\n  # so return an empty list.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Extract key information from the current environment state for pathfinding.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Map DSL action names to their corresponding integer indices provided by the environment.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']   # Agent moves one step in its current facing direction.\n  TURN_LEFT_ACTION = action_map['LEFT']    # Agent turns 90 degrees left (counter-clockwise).\n  TURN_RIGHT_ACTION = action_map['RIGHT']  # Agent turns 90 degrees right (clockwise).\n  USE_ACTION = action_map['USE']           # Agent attempts to interact with the cell directly in front.\n\n  # Define changes in (row, col) for movement based on the agent's current direction.\n  # This mapping is used for calculating the next position when moving forward\n  # or identifying the cell directly in front of the agent.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (East): (delta_row, delta_col) = (0, +1)\n      1: (-1, 0),  # Facing UP (North):    (delta_row, delta_col) = (-1, 0)\n      2: (0, -1),  # Facing LEFT (West):   (delta_row, delta_col) = (0, -1)\n      3: (1, 0)    # Facing DOWN (South):  (delta_row, delta_col) = (+1, 0)\n  }\n\n  # Define how the agent's integer direction changes when turning left or right.\n  # Directions cycle: 0 -> 1 -> 2 -> 3 -> 0 (Right -> Up -> Left -> Down -> Right)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Compile a comprehensive list of all entity indices that block agent movement.\n  # This set includes:\n  # 1. Non-grabbable environment features (e.g., boundaries, water, workshops) that the agent cannot pass through.\n  # 2. The target 'primitive' itself. The agent must stand *adjacent* to the primitive\n  #    to 'USE' it, not occupy the same grid cell as the primitive.\n  #    Convert to a numpy array for efficient indexing into the grid.\n  blocking_kind_indices = np.array(list(current_state.world.non_grabbable_indices.union({primitive_id})))\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest sequence of actions.\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position_tuple, direction_int) states.\n  # This prevents revisiting the same state, avoiding redundant computation and infinite loops,\n  # and guarantees that the first path found is the shortest.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This variable will store the action sequence once the goal state is found.\n\n  # Begin the BFS traversal.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Unpack current row and column coordinates.\n\n      # Step 1: Check if the agent is currently in the desired \"collectable\" state.\n      # This state is defined as having the target primitive directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir] # Get the movement deltas corresponding to the agent's current facing direction.\n      front_r, front_c = r + front_dr, c + front_dc # Calculate the coordinates of the cell directly in front.\n      \n      # Ensure the calculated 'front_cell' is within the overall grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the target primitive is present in the cell directly in front.\n          # A value > 0 in the grid at a specific kind index indicates the presence of that item.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # The shortest path to reach this adjacent-and-facing state is found.\n              break # Exit the BFS loop immediately, as the shortest path is guaranteed by BFS.\n\n      # Step 2: Explore all possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # --- Try Move Forward ---\n      # Calculate the agent's potential next position if it moves one step forward.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the potential next position is within grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this specific (position, direction) state has not been visited before.\n          if (next_pos, next_dir) not in visited:\n              # Crucially, check if the proposed 'next_pos' is \"walkable\".\n              # This means the cell does not contain any of the 'blocking_kind_indices' items.\n              # `np.any` returns True if any of the specified blocking kinds are present.\n              if not np.any(initial_grid[next_r, next_c, blocking_kind_indices] > 0):\n                  visited.add((next_pos, next_dir)) # Mark this new state as visited.\n                  # Add the new state to the BFS queue, appending the MOVE_FORWARD_ACTION to the path.\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      # Calculate the agent's new direction after turning left.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes the agent's direction but not its position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark this new state as visited.\n          # Add the new state to the queue, appending the TURN_LEFT_ACTION to the path.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      # Calculate the agent's new direction after turning right.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes the agent's direction but not its position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark this new state as visited.\n          # Add the new state to the queue, appending the TURN_RIGHT_ACTION to the path.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path was successfully found (i.e., 'target_path_actions' is not None),\n  # extend the 'actions_list' with the found path and then append the 'USE' action.\n  # The 'USE' action performs the final collection of the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:11:42.561777", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive string name to its integer ID. This is crucial\n  # for interacting with the grid and inventory arrays which use these IDs.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive is not defined in the cookbook, it's uncollectible.\n    return []\n\n  # 2. Early Exit: If the primitive is already in the agent's inventory,\n  # no collection actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the primitive is an item that can be collected via the 'USE' action.\n  # This filters out non-grabbable environment features (like WORKSHOPs, BOUNDARYs)\n  # that are not intended to be added to inventory. Water and Stone are special\n  # cases often collectible but not strictly in `grabbable_indices`.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  if not is_collectible_via_use:\n    # If the item is not a type that can be 'USE'd to collect, this function can't help.\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Maps agent's direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT) to a delta (dr, dc)\n  # for the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP (North): row - 1\n      1: (0, 1),  # RIGHT (East): col + 1\n      2: (1, 0),  # DOWN (South): row + 1\n      3: (0, -1)  # LEFT (West): col - 1\n  }\n\n  # Helper function to compute the minimal sequence of turning actions\n  # to change from `current_dir` to `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] \n      \n      # Calculate the shortest rotational distance (clockwise or counter-clockwise).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # One right turn\n          return [RIGHT_ACT]\n      elif diff == 3: # One left turn\n          return [LEFT_ACT]\n      else: # diff == 2, 180-degree turn\n          return [RIGHT_ACT, RIGHT_ACT] # Two right turns (or two left turns)\n\n  # 5. Initialize Breadth-First Search (BFS) structures.\n  q = collections.deque()\n  # `visited` set stores a unique key for each state: (row, col, direction, inventory_tuple).\n  # Including inventory is crucial for pathfinding in crafting environments where\n  # acquiring tools (changing inventory) opens up new possibilities.\n  visited = set()\n\n  # Initial state: current environment state with an empty path.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states. This prevents infinite loops in complex\n  # or unachievable scenarios. It's a pragmatic cap on search depth/breadth.\n  # The multiplier `* 20` is an arbitrary factor accounting for variations in\n  # direction and a limited number of relevant inventory states.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If the search space becomes too large, stop exploring new states.\n    # This prevents excessive computation for very long or unfeasible paths.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # 7. Goal Check: Attempt to collect the primitive from the current state.\n    # Check if the target primitive (`i_kind`) is in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # Iterate through all four possible agent orientations (UP, RIGHT, DOWN, LEFT)\n        # to find if facing any of them would allow the 'USE' action to succeed.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Validate that the cell in front is within grid bounds and contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the necessary turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory before 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. CraftState.step handles whether this\n                # action successfully collects the item (e.g., if a tool is required).\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical success check: Did the primitive's count in inventory increase?\n                # This confirms actual collection, accounting for all game mechanics.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # 8. Explore possible successor states by applying actions:\n    \n    # a. Movement Actions (UP, DOWN, LEFT, RIGHT):\n    for action in move_actions:\n      _, next_state = state.step(action) # Apply movement action\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Only add to queue if this specific state (pos, dir, inventory) hasn't been visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # b. 'USE' Action from the current position:\n    # This is important for scenarios where an intermediate item (like a tool)\n    # might be collectible at the current position, changing the inventory\n    # and enabling future collection of the target primitive.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    # Add to queue only if this state is new. If 'USE' had no effect,\n    # `state_after_current_use` would be identical to `state`, and its key\n    # would already be in `visited`, preventing redundant additions.\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 9. If the BFS queue becomes empty without finding a path to collect the\n  # primitive, it means the primitive is unreachable from the initial state\n  # given the environment and search constraints.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:11:44.025663", "function_name": "collect", "function_body": "  \"\"\"Enhanced version of `collect_v1`, optimizing for clarity and robustness in complex collection scenarios.\n    \n    This function implements a Breadth-First Search (BFS) to discover the optimal\n    sequence of actions to acquire a specified primitive item within the CraftLab\n    environment. It is designed to navigate the grid, manage agent orientation,\n    and account for dynamic inventory changes (e.g., acquiring tools) that may\n    be prerequisites for collecting the target primitive.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current\n                            environment state.\n        primitive (str): The name of the primitive item to collect (e.g., \"wood\", \"iron\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect\n                   the primitive. Returns an empty list if the primitive is\n                   already in inventory, is not a type that can be collected,\n                   or if no path is found within the predefined search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name to its canonical integer ID. This ID is used for\n  # accessing grid and inventory data, ensuring consistency with the environment's\n  # internal representation.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the world's cookbook,\n    # it cannot be collected.\n    return []\n\n  # 2. Pre-check: If the primitive is already present in the agent's inventory,\n  # no further actions are required.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic Validation: Determine if the specified primitive is conceptually\n  # collectible via the 'USE' action. This excludes non-grabbable entities\n  # (like workshops or boundaries) which are part of the environment but not\n  # meant to be picked up into inventory. Water and Stone are special cases\n  # often collectible despite not being in `grabbable_indices`.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not a collectible type via 'USE', a BFS search is\n  # irrelevant for this 'collect' function's objective.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define Action Mappings and Directional Deltas for grid navigation and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the corresponding (row_change, col_change) for the cell directly in front.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: Decreases row index (North)\n      1: (0, 1),  # RIGHT: Increases column index (East)\n      2: (1, 0),  # DOWN: Increases row index (South)\n      3: (0, -1)  # LEFT: Decreases column index (West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions needed\n  # to orient the agent from its current direction to a specified target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # No turns needed if already facing the target\n      \n      # Calculate the shortest rotational difference, considering wrap-around (0-3).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn\n          return [RIGHT_ACT, RIGHT_ACT] # Two consecutive 90-degree turns\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  q = collections.deque()\n  # The `visited` set tracks unique states to prevent cycles and redundant exploration.\n  # A state is defined by (agent_row, agent_col, agent_direction, immutable_inventory_tuple).\n  # Including the inventory is critical for paths where intermediate item collection\n  # (e.g., acquiring a tool) changes the agent's capabilities and thus its future state.\n  visited = set()\n\n  # Enqueue the initial state with an empty action path.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for total explored distinct states. This prevents the search\n  # from consuming excessive resources in very large or unreachable scenarios.\n  # The '10' factor is a rough heuristic for the average number of relevant\n  # inventory configurations that might open new pathways during typical tasks.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. Main BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its path\n    explored_states_count += 1\n\n    # Apply the exploration limit. If we exceed the maximum number of states\n    # to consider, we stop adding new states from this point. However, items\n    # already in the queue will still be processed, ensuring the shortest path\n    # is found among currently enqueued candidates.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can the target primitive (`i_kind`) be collected from this `state`?\n    # This involves checking if the primitive is in the agent's immediate 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # Iterate through all four possible orientations. The agent might need to turn\n        # to face the primitive before using the 'USE' action.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if agent faced `target_dir`)\n            # is within grid boundaries and actually contains the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the sequence of turns required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # `state.step` returns a new state object, avoiding mutation of `state`.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Capture the inventory before attempting 'USE' to verify successful collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action. This action might succeed only if\n                # the agent has the necessary tools in its inventory (e.g., an axe for wood),\n                # which is implicitly handled by `CraftState.step`.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical success condition: Check if the primitive's count in inventory\n                # *increased* after the 'USE' action. This is the definitive indicator\n                # that the item was successfully collected.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, return the complete action sequence: path to location + turns + USE.\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible successor states by taking actions:\n    # 1. Evaluate all possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action) # `step` returns a new state, not modifying `state`.\n      next_inventory_tuple = tuple(next_state.inventory) # Convert to tuple for hashing.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Enqueue only if this specific (position, direction, inventory) state has not been visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Evaluate the 'USE' action from the current position.\n    # This is vital for scenarios where collecting an intermediate item (like a tool)\n    # is required to unlock the collection of the target primitive. If 'USE' yields\n    # no change (e.g., nothing to interact with), `next_state_key` will be identical\n    # to the current state's key, and it won't be re-added if already visited.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and the primitive was not collected, it implies\n  # that the primitive is unreachable or uncollectible from the initial state\n  # within the search constraints.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:13:16.817675", "function_name": "collect", "function_body": "  \"\"\"Finds a sequence of actions to locate and collect a specified primitive item\n  in the CraftLab environment using a Breadth-First Search (BFS) algorithm.\n\n  This function aims to find the shortest path of actions (movements and 'USE' actions)\n  that results in the agent acquiring at least one unit of the target primitive\n  in its inventory. It accounts for changes in inventory that might enable\n  further actions (e.g., picking up a tool).\n\n  Args:\n      env (env.CraftLab): The CraftLab environment instance.\n      primitive (str): The case-insensitive name of the primitive to collect\n                       (e.g., \"wood\", \"stone\", \"iron\").\n\n  Returns:\n      List[int]: A list of integer action codes representing the sequence of\n                 actions to take. Returns an empty list if the primitive is\n                 already collected, not collectible via 'USE', or if no path\n                 is found within the defined search limits.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Map the primitive name (string) to its internal integer ID.\n  # This ID is essential for interacting with the simulation's grid and inventory.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it's an invalid target.\n    return []\n\n  # 2. Early exit: If the agent already possesses the target primitive in its inventory,\n  # no collection actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if the primitive is inherently collectible via the 'USE' action.\n  # The CraftWorld simulation defines certain items as 'grabbable', or specific resources\n  # like 'water' and 'stone' as directly obtainable via 'USE'. Non-collectible entities\n  # (e.g., workshops, boundaries) cannot be put into inventory this way.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the target item cannot be collected using the 'USE' action, we cannot fulfill the request.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integer IDs and spatial heuristics.\n  # These are retrieved from the environment's action specifications for robustness.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # List of basic movement actions for convenient iteration during BFS.\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Mapping agent's direction (0-3) to the (row_change, col_change) for the cell directly in front.\n  # This is used to determine if the agent is facing the target primitive.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turning actions required\n  # for the agent to change from `current_dir` to `target_dir`.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n\n      # Calculate the shortest rotational difference, considering circularity (0-3).\n      # `+ 4) % 4` ensures a positive difference and correctly handles wraps (e.g., 3 to 0 is +1).\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2 (180-degree turn, e.g., UP(0) -> DOWN(2))\n          # Two consecutive turns in the same direction achieve a 180-degree rotation.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily use RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS) data structures.\n  # The queue stores tuples of (CraftState, list_of_actions_taken_to_reach_this_state).\n  q = collections.deque() \n  \n  # The 'visited' set tracks explored states to prevent cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # Including the inventory is crucial because acquiring items (like tools) can\n  # change future interaction possibilities, making two states with identical\n  # position/direction fundamentally different if their inventories differ.\n  visited = set()\n\n  # Add the initial environment state to the queue and mark it as visited.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  # Get grid dimensions from the current state for boundary checks.\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Heuristic limits for BFS exploration. These values are tuned to balance search\n  # completeness with computational feasibility, preventing excessively long runtimes.\n  # MAX_INVENTORY_STATES_MULTIPLIER: Accounts for the complexity introduced by different\n  # inventory combinations. A higher value allows for more exploration of states where\n  # tools or resources might be acquired before the final target collection.\n  MAX_INVENTORY_STATES_MULTIPLIER = 25 # Increased for more robust exploration of inventory states.\n  \n  # MAX_EXPLORED_STATES: Maximum number of unique (position, direction, inventory) states\n  # to visit. If this limit is exceeded, it implies a very long or non-existent path.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * MAX_INVENTORY_STATES_MULTIPLIER\n  explored_states_count = 0\n\n  # MAX_PATH_LENGTH: Maximum number of actions allowed in a valid plan to collect\n  # a single primitive. Paths longer than this are considered too inefficient.\n  MAX_PATH_LENGTH = 200 # A reasonable upper bound for primitive collection plans.\n\n  # 6. BFS Loop: Continues as long as there are states to explore.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path leading to it\n    explored_states_count += 1\n\n    # Pruning: If the number of distinct states processed exceeds the heuristic limit,\n    # terminate the search. This prevents the search from running indefinitely.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- Goal Check and Collection Attempt ---\n    # Check if the target primitive (`i_kind`) is present in the agent's 3x3 neighborhood.\n    # `state.next_to(i_kind)` provides a quick check.\n    if state.next_to(i_kind):\n        # If nearby, iterate through all four possible agent orientations (UP, RIGHT, DOWN, LEFT)\n        # to find one that puts the primitive directly in front of the agent.\n        for target_dir in range(4): \n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Verify that the cell directly in front (if facing `target_dir`) is:\n            # a) within grid boundaries, and b) actually contains an instance of the primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Calculate the sequence of turning actions needed to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                \n                # Simulate these turning actions to update the agent's state.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Reward (always 0.0 in this implementation) is ignored during pathfinding.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store the inventory state *before* attempting the 'USE' action.\n                # This is vital for verifying if 'USE' successfully added the primitive.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action from the correctly oriented state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical verification: Check if the count of the target primitive in\n                # the inventory *increased* after the 'USE' action. This confirms\n                # successful collection, accounting for any game rules (e.g., requiring\n                # a specific tool to collect) implemented within `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # If collected, a valid path has been found. Construct the full sequence:\n                    # path to reach location + turns to face + final USE action.\n                    final_path = path + turns_to_face + [USE_ACT]\n                    \n                    # Apply path length constraint: If the shortest path found (guaranteed by BFS)\n                    # is too long, consider it unachievable for practical purposes.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found exceeds the allowed length.\n                        # No viable path within limits.\n                        return [] \n\n    # --- Explore New States through Actions ---\n    # 1. Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      # Simulate the action to get the next state.\n      _, next_state = state.step(action)\n      \n      # Convert the new state's inventory to a tuple for hashability in the `visited` set.\n      next_inventory_tuple = tuple(next_state.inventory) \n      # Create a unique key for the visited set, representing the agent's full state.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this new state has not been visited before, add it to the queue and mark as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # 2. Explore the 'USE' action generally from the current position.\n    # This is important because using an item at the current location might change\n    # the inventory (e.g., picking up a tool like an axe or shears), enabling\n    # future collection of other primitives, even if it doesn't directly collect\n    # the *target* primitive.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_general_use = state.step(USE_ACT)\n    \n    # Only add the state resulting from this general 'USE' if it actually led to a\n    # meaningful change in the agent's state (inventory, position, or direction).\n    # This prevents adding redundant states if 'USE' had no effect (e.g., using nothing).\n    if not (np.array_equal(state_after_general_use.inventory, inventory_before_general_use) and\n            state_after_general_use.pos == state.pos and\n            state_after_general_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_general_use.inventory)\n        next_state_key = (state_after_general_use.pos[0], state_after_general_use.pos[1], state_after_general_use.dir, next_inventory_tuple)\n\n        # Add this 'USE'-resultant state to the queue if it's new and unvisited.\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_general_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and the queue becomes empty without finding a path\n  # to collect the target primitive, it means the primitive is unreachable from the\n  # initial state under the current game conditions within the defined exploration limits.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
