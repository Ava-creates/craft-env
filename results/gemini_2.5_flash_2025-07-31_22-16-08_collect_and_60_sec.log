  if current_dir == target_dir:\n          return [] # Already facing correctly.\n      \n      # Calculate turns needed (clockwise difference, modulo 4 for wrapping).\n      diff = (target_dir - current_dir + 4) % 4\n      if diff == 1: # 90 degrees clockwise\n          return [ACTION_RIGHT]\n      elif diff == 3: # 270 degrees clockwise (90 degrees counter-clockwise)\n          return [ACTION_LEFT]\n      else: # diff == 2 (180 degrees)\n          return [ACTION_RIGHT, ACTION_RIGHT] # Two right turns (or two left turns)\n\n  # 4. Initialize BFS structures.\n  # Queue stores (current_state_object, list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque()\n  \n  # Visited set to prevent cycles and redundant state exploration.\n  # A state is defined by (grid_hash, agent_row, agent_col, agent_direction, inventory_tuple).\n  visited_states = set() \n\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes()) \n\n  bfs_queue.append((current_state, []))\n  visited_states.add((initial_grid_hash, current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_rows, grid_cols, _ = current_state.grid.shape\n  \n  # Heuristic limits to manage computational complexity for large state spaces.\n  # These are crucial to prevent unbounded searches in complex environments.\n  MAX_EXPLORED_UNIQUE_STATES = grid_rows * grid_cols * 4 * 150 \n  MAX_PATH_LENGTH = 250 \n\n  states_explored_counter = 0\n\n  # 5. BFS Loop: Explore states layer by layer.\n  while bfs_queue:\n    current_bfs_state, current_path = bfs_queue.popleft()\n    states_explored_counter += 1\n\n    # Pruning: Stop exploring this path if limits are exceeded.\n    if states_explored_counter > MAX_EXPLORED_UNIQUE_STATES or len(current_path) >= MAX_PATH_LENGTH:\n      continue \n\n    agent_r, agent_c = current_bfs_state.pos\n    agent_dir = current_bfs_state.dir\n\n    # Helper function to process a generated next state:\n    # Checks for goal achievement and adds to queue if new and not a goal.\n    # Returns the path if the goal is found, otherwise None.\n    def try_add_state_to_queue(next_state: craft.CraftState, actions_to_reach_next_state: list[int], inventory_before_action: np.ndarray) -> list[int] | None:\n        # Check if the target primitive was acquired specifically in the LAST step of this path.\n        if next_state.inventory[primitive_id] > inventory_before_action[primitive_id]:\n            return actions_to_reach_next_state # Goal achieved! Return the shortest path found.\n\n        # If not the goal, add the new state to the BFS queue if it hasn't been visited.\n        # Compute state key for the 'next_state'.\n        next_inventory_tuple = tuple(next_state.inventory)\n        next_grid_hash = hash(next_state.grid.tobytes())\n        next_state_key = (next_grid_hash, next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited_states:\n            visited_states.add(next_state_key)\n            bfs_queue.append((next_state, actions_to_reach_next_state))\n        return None # No path found (yet) through this branch\n\n    # --- Generate and Process Next States from Current BFS State ---\n\n    # A. Movement Actions: UP, DOWN, LEFT, RIGHT\n    for action in MOVEMENT_ACTIONS:\n        # current_bfs_state.inventory is implicitly the inventory *before* this move.\n        _, next_s_after_move = current_bfs_state.step(action)\n        \n        found_path = try_add_state_to_queue(next_s_after_move, current_path + [action], current_bfs_state.inventory)\n        if found_path:\n            return found_path # Path found, return immediately\n\n    # B. ACTION_USE at the Agent's Current Position\n    inventory_before_use_at_pos = current_bfs_state.inventory\n    grid_before_use_at_pos = current_bfs_state.grid # Capture grid state before USE\n    _, next_s_after_use_at_pos = current_bfs_state.step(ACTION_USE)\n    \n    # Check if the USE action at position had any effect (inventory change, grid change, etc.)\n    state_changed_by_pos_use = not (\n        np.array_equal(next_s_after_use_at_pos.inventory, inventory_before_use_at_pos) and\n        np.array_equal(next_s_after_use_at_pos.grid, grid_before_use_at_pos) and\n        next_s_after_use_at_pos.pos == current_bfs_state.pos and\n        next_s_after_use_at_pos.dir == current_bfs_state.dir\n    )\n    if state_changed_by_pos_use:\n        found_path = try_add_state_to_queue(next_s_after_use_at_pos, current_path + [ACTION_USE], inventory_before_use_at_pos)\n        if found_path:\n            return found_path # Path found, return immediately\n    \n    # C. ACTION_USE on Adjacent Cells (after turning to face them)\n    # This covers interactions with entities in the 8-neighborhood that require facing \n    # (e.g., chopping a tree, mining a rock).\n    for target_facing_direction in range(4): # Iterate through UP, RIGHT, DOWN, LEFT as target directions\n        dr, dc = DIRECTION_TO_FRONT_DELTA[target_facing_direction]\n        facing_r, facing_c = agent_r + dr, agent_c + dc\n\n        # Check if the cell directly in front is within bounds and contains *any* entity.\n        # This is a general check, as a 'USE' action might apply to various entity types.\n        if (0 <= facing_r < grid_rows and 0 <= facing_c < grid_cols) and np.any(current_bfs_state.grid[facing_r, facing_c, :] == 1):\n            \n            # 1. Get actions to turn the agent towards the target cell.\n            turning_actions = _get_turns_to_face(agent_dir, target_facing_direction)\n            \n            # 2. Simulate these turning actions to get an intermediate state where agent is oriented.\n            temp_state_after_turns = current_bfs_state\n            for turn_action in turning_actions:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n            \n            # 3. Capture inventory and grid states BEFORE performing the final USE action.\n            inventory_before_adj_use = temp_state_after_turns.inventory\n            grid_before_adj_use = temp_state_after_turns.grid\n            \n            # 4. Perform the ACTION_USE from the correctly oriented state.\n            _, next_s_after_adj_use = temp_state_after_turns.step(ACTION_USE)\n            \n            # Check if the USE action on the adjacent cell had any effect.\n            state_changed_by_adj_use = not (\n                np.array_equal(next_s_after_adj_use.inventory, inventory_before_adj_use) and\n                np.array_equal(next_s_after_adj_use.grid, grid_before_adj_use) and\n                next_s_after_adj_use.pos == temp_state_after_turns.pos and\n                next_s_after_adj_use.dir == temp_state_after_turns.dir\n            )\n            if state_changed_by_adj_use:\n                full_action_sequence = current_path + turning_actions + [ACTION_USE]\n                found_path = try_add_state_to_queue(next_s_after_adj_use, full_action_sequence, inventory_before_adj_use)\n                if found_path:\n                    return found_path # Path found, return immediately\n\n  # 6. If the BFS queue is exhausted and no path was found, the primitive is unreachable\n  # under current conditions or within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:43:28.084774", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory at the very start.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This prunes the search space for uncollectible primitives early.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # All possible actions including movement and the USE action.\n  all_possible_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT, USE_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks (row, col, direction, inventory_tuple, grid_hash).\n  # Including grid_hash is crucial for states where USE actions change the environment\n  # (e.g., picking up items, removing obstacles, using a workbench to craft on grid).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes())\n  \n  # A state in the queue is (CraftState object, list of actions taken to reach this state).\n  q.append((current_state, []))\n  \n  # A visited key represents the immutable, unique aspects of a state.\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple, initial_grid_hash)\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limits computation time for complex maps.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 200 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop adding new ones.\n    # This acts as a safeguard against overly long searches, but still processes\n    # states already in the queue.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Iterate through all possible actions from the current state.\n    for action in all_possible_actions:\n      # Store inventory before step to check if the action resulted in collection.\n      inventory_before_step = np.copy(state.inventory)\n      \n      # Simulate the action to get the next state.\n      _, next_state = state.step(action)\n\n      # --- GOAL CHECK: Has the primitive been collected in this next_state? ---\n      # This check is performed immediately after an action is applied.\n      # If the inventory count for the target primitive has increased, we found a path.\n      # Because it's BFS, this path is guaranteed to be the shortest.\n      if next_state.inventory[i_kind] > inventory_before_step[i_kind]:\n          return path + [action] # Shortest path found!\n\n      # Generate the unique key for the next state for visited tracking.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple, next_grid_hash)\n      \n      # Add to queue only if the next state has not been visited before.\n      # The check 'next_state_key != current_state_key' used in v1 is logically redundant here\n      # because if they were equal, 'next_state_key' would already be in 'visited'\n      # (as 'current_state_key' was added to 'visited' when the current 'state' was enqueued).\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the exploration limits.\n  return []", "island_id": 4, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:43:30.788818", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory at the very start.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or\n      i_kind == world.water_index or\n      i_kind == world.stone_index\n  )\n\n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  # This prunes the search space for uncollectible primitives early.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  # All possible actions including movement and the USE action.\n  all_possible_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT, USE_ACT]\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks (row, col, direction, inventory_tuple, grid_hash).\n  # Including grid_hash is crucial for states where USE actions change the environment\n  # (e.g., picking up items, removing obstacles, using a workbench to craft on grid).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_grid_hash = hash(current_state.grid.tobytes())\n  \n  # A state in the queue is (CraftState object, list of actions taken to reach this state).\n  q.append((current_state, []))\n  \n  # A visited key represents the immutable, unique aspects of a state.\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple, initial_grid_hash)\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Maximum number of unique states to explore. This limits computation time for complex maps.\n  # Increased the limit multiplier to allow for slightly deeper exploration.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 300 \n\n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop adding new ones.\n    # This acts as a safeguard against overly long searches, but still processes\n    # states already in the queue.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    # Iterate through all possible actions from the current state.\n    for action in all_possible_actions:\n      # Store inventory before step to check if the action resulted in collection.\n      inventory_before_step = np.copy(state.inventory)\n      \n      # Simulate the action to get the next state.\n      _, next_state = state.step(action)\n\n      # --- GOAL CHECK: Has the primitive been collected in this next_state? ---\n      # This check is performed immediately after an action is applied.\n      # If the inventory count for the target primitive has increased, we found a path.\n      # Because it's BFS, this path is guaranteed to be the shortest.\n      if next_state.inventory[i_kind] > inventory_before_step[i_kind]:\n          return path + [action] # Shortest path found!\n\n      # Generate the unique key for the next state for visited tracking.\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_grid_hash = hash(next_state.grid.tobytes())\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple, next_grid_hash)\n      \n      # Add to queue only if the next state has not been visited before.\n      # The check `next_state_key != current_state_key` (present in v1) is redundant here.\n      # If `next_state_key` is identical to the `current_state_key` (i.e., the state\n      # from which we just took an action), then `current_state_key` would have already\n      # been added to `visited` when it was enqueued. Therefore, checking `next_state_key not in visited`\n      # implicitly handles this case and is sufficient for correctness.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state within the exploration limits.\n  return []", "island_id": 4, "scores": {"3": 2.5}}
{"timestamp": "2025-08-01T15:45:29.576709", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T15:45:31.886433", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function uses Breadth-First Search (BFS) to find the shortest sequence of actions\n  (moves and 'USE' actions) required for the agent to acquire a specified primitive.\n  It considers the agent's position, direction, and inventory as part of its state\n  to correctly handle scenarios requiring tools or multiple steps.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state and world configuration.\n        primitive (str): The name of the primitive (e.g., \"wood\", \"stone\", \"axe\" if grabbable) to collect.\n\n    Returns:\n        List[int]: A sequence of action indices (e.g., CraftWorld.DOWN, CraftWorld.USE)\n                   to execute. Returns an empty list if the primitive is already collected\n                   or cannot be collected within the explored state space.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world # Access to CraftWorld instance for indices, recipes, etc.\n\n  # 1. Map the primitive name to its integer ID.\n  # If the primitive name is not recognized in the world's cookbook, it cannot be collected.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    return []\n\n  # 2. Early Exit: Check if the primitive is already in the agent's inventory.\n  # If so, it's already \"collected,\" and no actions are needed.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Determine if the target primitive is a type that can be collected via the 'USE' action.\n  # This set includes:\n  # - All primitive resources defined in the cookbook (e.g., WOOD, GRASS, GOLD).\n  # - All items explicitly marked as 'grabbable' (e.g., AXE, KNIFE, if found in environment).\n  # - Specific hardcoded indices for WATER and STONE.\n  # If the target primitive is not in this set (e.g., a workshop or boundary which cannot be picked up),\n  # then this `collect` function cannot satisfy the request, so return an empty path.\n  all_useable_and_collectible_kinds = set(world.cookbook.primitives).union(world.grabbable_indices).union({world.water_index, world.stone_index})\n  \n  if i_kind not in all_useable_and_collectible_kinds:\n    return []\n\n  # 4. Define action constants and directional deltas for grid navigation.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # Delta values for checking the cell directly in front of the agent based on its current direction.\n  # Used to simulate facing and interacting with objects.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (North)\n      1: (0, 1),  # RIGHT: row, col + 1 (East)\n      2: (1, 0),  # DOWN: row + 1, col (South)\n      3: (0, -1)  # LEFT: row, col - 1 (West)\n  }\n\n  # Helper function to compute the minimal sequence of turns to face a target direction.\n  # Assumes 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT for directions.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Agent is already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3 for cyclic directions.\n      # Adding 4 and taking modulo 4 ensures positive results.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise (e.g., current UP (0), target RIGHT (1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., current UP (0), target LEFT (3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., current UP (0), target DOWN (2))\n          # Two successive turns in either direction will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choosing two right turns.\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. The inventory (numpy array) is converted to a tuple to make it hashable.\n  # Tracking inventory is crucial as acquiring tools (which change inventory) opens up new possibilities.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState object, list of actions to reach this state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for the number of distinct states to explore. This prevents the BFS\n  # from running indefinitely in extremely complex or truly unreachable scenarios.\n  # The multiplier (50) is chosen to allow for reasonable exploration, especially when\n  # multiple tool acquisitions or complex movements might be involved.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 50 \n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal (primitive collected) is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop searching.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue # Skip further processing of this path, implicitly abandoning deeper search from here.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves two main scenarios:\n    #   a) The primitive is directly under the agent and can be picked up.\n    #   b) The primitive is in an adjacent cell, requiring the agent to face it and 'USE'.\n\n    # Scenario a): Target primitive is directly under the agent and is grabbable.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_at_pos = np.copy(state.inventory)\n        _, state_after_use_at_pos = state.step(USE_ACT) # Attempt to pick up from current spot.\n        # Verify that the 'USE' action actually increased the target primitive's count in inventory.\n        if state_after_use_at_pos.inventory[i_kind] > inventory_before_use_at_pos[i_kind]:\n            return path + [USE_ACT] # Path found!\n\n    # Scenario b): Target primitive is in an adjacent cell.\n    # `state.next_to(i_kind)` broadly checks the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions (UP, RIGHT, DOWN, LEFT)\n        # to find if the primitive is directly in front from any orientation.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front (after simulated turn) is within grid bounds\n            # and actually contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate the sequence of actions to turn the agent to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state # Start from current state to simulate turns\n                for turn_action in turns_to_face:\n                    # Apply each turning action sequentially to get the correct facing state.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state (now facing the primitive).\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased after the 'USE' action. This confirms successful collection,\n                # accounting for any internal game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Path found! Return the sequence of actions.\n\n    # Explore possible future states by performing movement actions (UP, DOWN, LEFT, RIGHT).\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory) # Hashable inventory for visited set.\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (defined by position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state (either at current cell or facing one).\n    # This is essential for scenarios where 'USE' picks up other grabbable items (like tools)\n    # that are not the target primitive but might be necessary preconditions, or interacts\n    # with environment objects that change state in a relevant way.\n\n    # Determine the cell directly in front of the agent for the general 'USE' check.\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Only consider performing a 'USE' action if there's something potentially interactable\n    # either at the agent's current position or in the cell directly in front.\n    # This pre-filters unnecessary `USE` attempts that would definitely be no-ops.\n    is_something_useable = False\n    # Check current position first (for picking up items agent is standing on)\n    for k_idx in world.grabbable_indices:\n        if state.grid[current_r, current_c, k_idx] == 1:\n            is_something_useable = True\n            break\n    \n    # If nothing at current position, check cell in front.\n    if not is_something_useable and (0 <= facing_r < grid_width and 0 <= facing_c < grid_height):\n        for k_idx in world.grabbable_indices:\n            if state.grid[facing_r, facing_c, k_idx] == 1:\n                is_something_useable = True\n                break\n        # Also check specifically for water or stone, as these are 'useable' from adjacent cells.\n        if not is_something_useable:\n            if (state.grid[facing_r, facing_c, world.water_index] == 1 or\n                state.grid[facing_r, facing_c, world.stone_index] == 1):\n                is_something_useable = True\n        \n        # Check for workshops in front (if interacting with them changes state, e.g. allowing crafting)\n        # while workshop interactions don't change inventory for collection, they are an action.\n        # This is primarily covered by the general state change check.\n        for k_idx in world.workshop_indices:\n             if state.grid[facing_r, facing_c, k_idx] == 1:\n                 is_something_useable = True\n                 break\n\n\n    # If there's something potentially interactable, simulate the 'USE' action.\n    if is_something_useable:\n        inventory_before_any_use = np.copy(state.inventory)\n        _, state_after_current_use = state.step(USE_ACT)\n        \n        # Only add the new state to the queue if the 'USE' action resulted in a meaningful change\n        # (i.e., inventory changed, or agent moved/turned). This prevents exploring\n        # redundant states where 'USE' had no effect.\n        if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                state_after_current_use.pos == state.pos and\n                state_after_current_use.dir == state.dir):\n\n            next_inventory_tuple = tuple(state_after_current_use.inventory)\n            next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable from the initial state given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
