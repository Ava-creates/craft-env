{"timestamp": "2025-08-01T06:44:12.666555", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, column) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  num_rows, num_cols, _ = initial_grid.shape # Extract grid dimensions\n\n  # Map symbolic actions from action_specs to their integer indices\n  action_map = env.action_specs()\n  # Assumed: 'UP' action moves the agent forward in its current direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction (0:Right, 1:Up, 2:Left, 3:Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (col)\n      1: (-1, 0),  # Facing UP: -1 to row (row)\n      2: (0, -1),  # Facing LEFT: -1 to column (col)\n      3: (1, 0)    # Facing DOWN: +1 to row (row)\n  }\n\n  # Define how direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Get indices of entities that block agent movement (non-grabbable/non-walkable terrain/objects)\n  non_grabbable_indices = current_state.world.non_grabbable_indices\n  # Create a set of non-walkable indices for efficient lookups.\n  # The primitive itself is typically not walkable, as the agent needs to be adjacent to collect it.\n  non_walkable_for_movement = set(non_grabbable_indices)\n  non_walkable_for_movement.add(primitive_id)\n\n\n  # BFS state representation: ((current_row, current_col), current_direction_int)\n  # Queue stores (state, list_of_actions_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (state) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the action sequence leading to the state\n                      # where the agent is adjacent to the primitive and facing it.\n\n  # Helper function to check if a cell is walkable\n  def _is_cell_walkable(r, c, grid, rows, cols, non_walkable_indices_set):\n      \"\"\"Checks if the cell at (r, c) is within bounds and doesn't contain non-walkable items.\"\"\"\n      if not (0 <= r < rows and 0 <= c < cols):\n          return False # Out of bounds\n      \n      # Check if any non-walkable item exists in this cell\n      # Assumes grid[r, c, kind_idx] > 0 means the item is present.\n      for kind_idx in non_walkable_indices_set:\n          if grid[r, c, kind_idx] > 0:\n              return False # Contains a non-walkable item\n      return True\n\n  while queue:\n      (current_pos, current_dir), path_to_current_state = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds AND contains the primitive\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          \n          target_path = path_to_current_state\n          break # Found the path to be adjacent and facing the primitive\n\n      # 2. Explore possible next actions from the current state (Move Forward, Turn Left, Turn Right)\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is valid and has not been visited with this direction\n      if (next_pos, next_dir) not in visited:\n          # Use the helper to check walkability, passing grid dimensions and non-walkable kinds\n          if _is_cell_walkable(next_r, next_c, initial_grid, num_rows, num_cols, non_walkable_for_movement):\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_to_current_state + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_to_current_state + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_to_current_state + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach an adjacent and facing position, append the USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:46:10.836238", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by generalizing the collection logic\n    to handle primitives that are obtained by interacting (USEing) with other\n    environmental entities (e.g., getting wood from a tree), rather than\n    only picking up the primitive item directly from the grid.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # --- IMPROVEMENT for v2: Refined initial semantic check ---\n  # If the target primitive is an entity that is never meant to be collected into inventory\n  # (e.g., a workshop, boundary, or other non-grabbable environment feature),\n  # filter it out early. This uses the `environment` set from the cookbook.\n  # Note that collectible items like 'water' and 'stone' are typically not in this set.\n  if i_kind in world.cookbook.environment:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent excessively long searches in large state spaces.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # --- IMPROVEMENT for v2: Generalized Goal Check ---\n    # Attempt to collect by using at the current cell, regardless of what's there.\n    # The success of collection is determined purely by whether the target item\n    # appears in the inventory after the USE action. This covers scenarios\n    # where an item is picked up directly, or a tool is acquired from a workshop.\n    inventory_before_use_at_current_pos = np.copy(state.inventory)\n    _, state_after_use_at_current_pos = state.step(USE_ACT)\n    if state_after_use_at_current_pos.inventory[i_kind] > inventory_before_use_at_current_pos[i_kind]:\n        return path + [USE_ACT] # Collected by using at current position\n\n    # Attempt to collect by using an entity in an adjacent cardinal direction.\n    # We iterate through all cardinal directions and attempt USE.\n    # We no longer check `state.grid[facing_r, facing_c, i_kind] == 1` to find the primitive itself.\n    # This allows collecting items like 'WOOD' by using a 'TREE' entity (which has a different `i_kind` on the grid),\n    # as long as `state.step(USE_ACT)` correctly models this interaction.\n    for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n        dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n        facing_r, facing_c = current_r + dr, current_c + dc\n\n        # Ensure facing cell is within grid bounds.\n        # We don't need to check what specifically is at `state.grid[facing_r, facing_c]`,\n        # as the `USE` action's effect depends on the game logic within `CraftState.step`.\n        if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n            # Simulate the turning actions to face the target direction.\n            turns_to_face = _get_turning_actions(current_dir, target_dir)\n            temp_state_after_turns = state \n            for turn_action in turns_to_face:\n                _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n            # Store inventory before attempting USE to verify collection.\n            inventory_before_use_adjacent = np.copy(temp_state_after_turns.inventory)\n\n            # Simulate the 'USE' action on the cell in front.\n            _, state_after_use_adjacent = temp_state_after_turns.step(USE_ACT)\n\n            # Critical check: Did the count of the primitive in inventory actually increase?\n            # This verifies successful collection, accounting for any internal game rules\n            # (e.g., tools needed, specific entity interaction) implemented in `CraftState.step`.\n            if state_after_use_adjacent.inventory[i_kind] > inventory_before_use_adjacent[i_kind]:\n                return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally, even if it doesn't immediately\n    # satisfy the primary goal. This is crucial for discovering paths where an intermediate USE\n    # action (e.g., crafting a tool at a workbench) is required to eventually collect the primitive.\n    inventory_before_general_use = np.copy(state.inventory)\n    _, state_after_current_use_general = state.step(USE_ACT)\n    \n    # Only add to queue if the general USE action had a meaningful effect (changed inventory, position, or direction).\n    # This avoids exploring redundant states where USE did nothing.\n    if not (np.array_equal(state_after_current_use_general.inventory, inventory_before_general_use) and\n            state_after_current_use_general.pos == state.pos and\n            state_after_current_use_general.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use_general.inventory)\n        next_state_key = (state_after_current_use_general.pos[0], state_after_current_use_general.pos[1], state_after_current_use_general.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use_general, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:46:12.240309", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by prioritizing the exploration of\n    the 'USE' action when it leads to a change in the agent's inventory\n    or position/direction, before exploring movement actions. This aims\n    to find paths that involve picking up tools or interacting with\n    elements at the current position earlier in the BFS, potentially\n    leading to quicker discovery of valid action sequences.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set now includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  # This is a heuristic and may need tuning for specific environment complexities.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n\n    # Check if the primitive can be collected from the current cell (i.e., agent is standing on it).\n    if state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use = np.copy(state.inventory)\n        _, state_after_use = state.step(USE_ACT)\n        # Verify if the USE action successfully collected the item from the current spot.\n        if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n            return path + [USE_ACT] # Item collected from current position.\n    \n    # Check adjacent cells (via turning and then using).\n    # `state.next_to(i_kind)` checks the 3x3 neighborhood. If the item is in current cell, it's True.\n    # However, the loop below iterates only over cells in cardinal directions, making it distinct from the above check.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure the facing coordinates are within grid bounds and contain the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # --- Improvement for collect_v2 ---\n    # Prioritize exploring the 'USE' action from the current position.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use_general = state.step(USE_ACT)\n    \n    # Check if the general USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use_general.inventory, inventory_before_any_use) and\n            state_after_current_use_general.pos == state.pos and\n            state_after_current_use_general.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use_general.inventory)\n        next_state_key = (state_after_current_use_general.pos[0], state_after_current_use_general.pos[1], state_after_current_use_general.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            # Enqueue USE action first, before movement actions.\n            q.append((state_after_current_use_general, path + [USE_ACT]))\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:47:07.324129", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (row, col)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:D\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape # Grid dimensions (rows, columns)\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' usually means moving forward relative to agent's facing direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col + 1)\n      1: (-1, 0),  # Facing UP: (row - 1, col)\n      2: (0, -1),  # Facing LEFT: (row, col - 1)\n      3: (1, 0)    # Facing DOWN: (row + 1, col)\n  }\n\n  # Map for updating the agent's direction when turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  blocking_kind_indices = current_state.world.non_grabbable_indices\n\n  # Check if already in position to use the primitive (i.e., primitive is directly in front)\n  # Calculate the cell directly in front of the agent based on its current position and direction.\n  r_curr, c_curr = initial_pos\n  dr_front, dc_front = DIR_TO_DRDC[initial_dir]\n  r_front, c_front = r_curr + dr_front, c_curr + dc_front\n\n  # If the cell in front is within bounds and contains the primitive, the agent can use it immediately.\n  if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS and\n      initial_grid[r_front, c_front, primitive_id] > 0):\n      return [USE_ACTION]\n\n  # BFS state representation: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)} # Track (position, direction) pairs to avoid cycles and redundant paths.\n\n  target_path_actions = None # Stores the shortest sequence of actions to reach the \"ready to use\" state.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Check if the primitive is directly in front of the agent at the *current* state in BFS.\n      # This is the goal condition for the BFS: find a path to a cell *adjacent* to the primitive,\n      # with the agent facing the primitive.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      r_front, c_front = r + dr_front, c + dc_front\n      \n      if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS):\n          if initial_grid[r_front, c_front, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      dr_move, dc_move = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + dr_move, c + dc_move\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid bounds.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n          # Check if this (position, direction) state has already been visited.\n          if (next_pos, next_dir) not in visited:\n              # Determine if the 'next_pos' cell is walkable.\n              # A cell is not walkable if it contains any 'blocking_kind' (e.g., boundaries, water).\n              # Also, the agent cannot walk *onto* the primitive itself; it must stand *adjacent* to it.\n              is_walkable = True\n              for kind_idx in blocking_kind_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              \n              if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n                  is_walkable = False # Cannot walk onto the target primitive\n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to the \"ready to use\" state, append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:47:08.530303", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  GRID_ROWS, GRID_COLS = initial_grid.shape[:2] # Extract grid dimensions (rows, columns)\n\n  # Map action names to their integer IDs for clarity and portability\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define changes in (row, col) for each direction\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: row_change=0, col_change=+1\n      1: (-1, 0),  # UP: row_change=-1, col_change=0\n      2: (0, -1),  # LEFT: row_change=0, col_change=-1\n      3: (1, 0)    # DOWN: row_change=+1, col_change=0\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., from RIGHT (0), turn LEFT to UP (1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., from RIGHT (0), turn RIGHT to DOWN (3)\n\n  # Get indices of entities that are impassable or cannot be walked on (e.g., BOUNDARY, WATER, WORKSHOPs).\n  # These are distinct from grabbable primitives like wood, iron, etc.\n  blocking_kind_indices = current_state.world.non_grabbable_indices\n\n  # Optimization: Check if the primitive is already directly in front of the agent.\n  # If so, a single 'USE' action is sufficient.\n  r_curr, c_curr = initial_pos\n  dr_front, dc_front = DIR_TO_DRDC[initial_dir]\n  r_front, c_front = r_curr + dr_front, c_curr + dc_front\n\n  if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS and\n      initial_grid[r_front, c_front, primitive_id] > 0):\n      return [USE_ACTION]\n\n  # Breadth-First Search (BFS) for shortest path to a \"ready-to-use\" state.\n  # BFS state: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set: Tracks (position, direction) pairs to prevent cycles and redundant exploration.\n  visited = {(initial_pos, initial_dir)} \n\n  target_path_actions = None # Stores the shortest sequence of actions found to reach the goal.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # Goal check for BFS: Is the primitive directly in front of the agent at the *current* BFS state?\n      # If yes, we've found a path to be adjacent and facing the primitive.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      r_front, c_front = r + dr_front, c + dc_front\n      \n      if (0 <= r_front < GRID_ROWS and 0 <= c_front < GRID_COLS):\n          if initial_grid[r_front, c_front, primitive_id] > 0:\n              target_path_actions = path_so_far\n              break # Shortest path found, terminate BFS.\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # 1. Try moving Forward\n      dr_move, dc_move = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + dr_move, c + dc_move\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if the next position is within grid bounds.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n          # Only explore if this (position, direction) state hasn't been visited before.\n          if (next_pos, next_dir) not in visited:\n              # Determine if the 'next_pos' cell is walkable.\n              # A cell is not walkable if it contains any 'blocking_kind_indices' (e.g., boundaries, water, workshops).\n              # Also, the agent cannot walk *onto* the primitive itself; it must stand *adjacent* to it to 'USE' it.\n              is_walkable = True\n              # Check for general blocking entities\n              for kind_idx in blocking_kind_indices:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              \n              # Additionally, prevent walking directly onto the primitive itself (e.g., a wood log)\n              # as 'USE' implies interacting with it from an adjacent square.\n              if is_walkable and initial_grid[next_r, next_c, primitive_id] > 0:\n                  is_walkable = False \n\n              if is_walkable:\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to the \"ready to use\" state (adjacent and facing),\n  # extend the actions with the found path and append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:48:18.755206", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Improvement: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # Assuming UP/DOWN are Forward/Backward and LEFT/RIGHT are Turn Left/Right\n  # This interpretation is common for DMLab-style environments where agent has a facing direction.\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # R->U->L->D->R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R->D->L->U->R\n\n  # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Check if next_pos is walkable\n          # A cell is walkable if it doesn't contain any non-walkable entity (e.g., boundary, water)\n          is_walkable = True\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent cannot walk onto the primitive itself, only up to it to use it.\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:48:19.954887", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction (positive X)\n      1: (-1, 0),  # Facing UP, move in negative row direction (negative Y)\n      2: (0, -1),  # Facing LEFT, move in negative column direction (negative X)\n      3: (1, 0)    # Facing DOWN, move in positive row direction (positive Y)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Pre-convert the set of non-grabbable indices to a list for efficient NumPy indexing\n  non_grabbable_kinds_list = list(current_state.world.non_grabbable_indices)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at current state\n      # Calculate the coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if front_cell is within grid bounds\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive)\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds\n      if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          continue # Skip this move, it's out of bounds\n\n      # Check if this (position, direction) state hasn't been visited\n      if (next_pos, next_dir) in visited:\n          continue # Skip, already visited this state via a shorter or equal path\n      \n      # Determine all kinds that block movement into next_pos.\n      # These include inherently non-grabbable items (like BOUNDARY, WATER, WORKSHOP_X)\n      # and the target primitive itself (as agent should be adjacent to USE, not on top of it).\n      blocking_kinds = list(non_grabbable_kinds_list) # Start with items that are always non-walkable\n      if primitive_id not in blocking_kinds:\n          # Only add the primitive_id if it's not already in non_grabbable_kinds_list\n          # (e.g., WORKSHOPs are both primitives and non-grabbable).\n          blocking_kinds.append(primitive_id)\n\n      # Check if the next_pos contains any blocking kind.\n      # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n      if np.any(initial_grid[next_r, next_c, blocking_kinds] > 0):\n          continue # This cell is not walkable, skip this move.\n\n      # If all checks pass, it's a valid move. Add to queue.\n      visited.add((next_pos, next_dir))\n      queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T06:49:11.223787", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get the integer index for the desired primitive.\n  # This will raise a KeyError if the primitive name is not known.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve action mappings for clarity and correct usage of action indices.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate collection check:\n  # If the agent is already within the 3x3 neighborhood (including its own cell)\n  # of the primitive, it can directly use/collect it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Identify all grid locations where the primitive currently exists.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive kind is present at this grid cell (count > 0).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If no instances of the primitive are found on the grid, it's not collectible from the world.\n  if not primitive_grid_locations:\n    return []\n\n  # 3. Define \"target collection cells\" for the BFS.\n  # A target cell is any cell from which the agent can successfully collect the primitive.\n  # This means any cell within the 3x3 neighborhood of a primitive location.\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    # Iterate through all 3x3 neighbors (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential target cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which entity kinds make a cell impassable for agent movement.\n  # In CraftWorld, non-grabbable entities are typically impassable, with the\n  # exception of workshops, which are non-grabbable but usually traversable.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- Improvement for v2: Encapsulate traversability check into a helper function ---\n  def is_cell_traversable(x_coord: int, y_coord: int) -> bool:\n      \"\"\"\n      Checks if a given grid cell is within bounds and traversable by the agent.\n      A cell is traversable if it's within grid boundaries and does not contain\n      any of the impassable entity kinds.\n      \"\"\"\n      # Check 1: Boundary Check - Is the position within the grid?\n      if not (0 <= x_coord < grid_width and 0 <= y_coord < grid_height):\n          return False\n\n      # Check 2: Impassability Check - Does the cell contain an impassable kind?\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at the cell, it's blocked.\n          if grid[x_coord, y_coord, k_idx] > 0: \n              return False\n      return True\n  # --- End of improvement ---\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified target collection cells.\n  start_pos = current_state.pos\n  \n  # BFS queue: stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define possible cardinal moves (delta_x, delta_y) and their corresponding action indices.\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  while q:\n    (cx, cy), path_to_current = q.popleft() # Get the current position and the path to it\n\n    # If the current position is one of our target collection cells, we have found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the USE action, as the agent is now in a valid position to collect the primitive.\n      return path_to_current + [USE]\n\n    # Explore valid neighboring cells for movement (cardinal directions only).\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      new_pos = (nx, ny)\n\n      # Use the new helper function for a cleaner check of traversability and bounds.\n      if is_cell_traversable(nx, ny) and new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to any target cell,\n  # it means the primitive is unreachable from the current agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:49:12.443621", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Map the string name of the primitive to its corresponding integer index\n  # used internally by the simulation. This will raise an error if the\n  # primitive name is not recognized, which is desired.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Retrieve integer codes for fundamental movement and interaction actions.\n  # This makes the code more readable and robust to changes in action mapping.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 1. Immediate Collection Check:\n  # If the agent is already in a position where it can interact with (collect)\n  # the primitive (i.e., within its 3x3 neighborhood), the only action needed is USE.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # 2. Identify all physical locations of the primitive on the game grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_grid_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      # A primitive is present if its count at this (x,y) cell is greater than 0.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_grid_locations.append((x, y))\n\n  # If no instances of the primitive are found anywhere on the grid,\n  # it cannot be collected, so return an empty list of actions.\n  if not primitive_grid_locations:\n    return []\n\n  # 3. Define \"Goal Cells\" for the BFS:\n  # A goal cell is any traversable cell from which the agent can successfully\n  # \"collect\" the primitive using the 'USE' action. Based on `CraftState.next_to`,\n  # this includes any cell within the 3x3 neighborhood of a primitive's location.\n  goal_cells = set()\n  for px, py in primitive_grid_locations:\n    # Iterate through all 3x3 neighbor offsets (including (0,0) for the primitive's own cell).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy\n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # 4. Determine which cell types are impassable for agent movement.\n  # Impassable kinds are typically non-grabbable items that are not designated\n  # as 'workshop' locations (which are usually traversable).\n  # Examples: water, stone, boundaries.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the identified goal cells.\n  start_pos = current_state.pos\n  \n  # BFS Queue: stores tuples of (current_position, list_of_actions_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent infinite loops and redundant paths.\n  visited = {start_pos} \n\n  # Define possible cardinal movement directions and their corresponding action indices.\n  # CraftWorld typically uses 4-directional movement (UP, DOWN, LEFT, RIGHT).\n  DELTAS_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreasing Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increasing Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreasing X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  while q:\n    # Dequeue the current position and the path leading to it.\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if (cx, cy) in goal_cells:\n      # Append the 'USE' action as the final step to collect the primitive.\n      return path_to_current + [USE]\n\n    # Explore all valid, unvisited, and traversable neighboring cells.\n    for (dx, dy), action in DELTAS_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position.\n      new_pos = (nx, ny)\n\n      # Check 1: Boundary Check - Is the new position within the grid?\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check 2: Impassability Check - Does the new position contain an impassable kind?\n      is_impassable_cell = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at the new cell, it's blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable_cell = True\n              break # No need to check further kinds for this cell.\n      \n      if is_impassable_cell:\n          continue # Skip if the cell is impassable.\n\n      # Check 3: Visited Check - Has this position already been explored?\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Enqueue the new position along with the updated path.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS queue becomes empty and no goal cell was reached,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T06:49:40.367417", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:49:42.026204", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing.\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Increased MAX_EXPLORED_STATES due to the larger state space when tracking inventory.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # IMPROVEMENT for collect_v2: Goal Check - First, check if the primitive is directly under the agent's feet.\n    # This applies to grabbable items that can be picked up by standing on them and using USE.\n    if i_kind in world.grabbable_indices and state.grid[current_r, current_c, i_kind] == 1:\n        inventory_before_use_on_self = np.copy(state.inventory)\n        _, state_after_use_on_self = state.step(USE_ACT)\n        # Verify successful collection\n        if state_after_use_on_self.inventory[i_kind] > inventory_before_use_on_self[i_kind]:\n            return path + [USE_ACT] # Collected by using at current position\n\n    # Goal Check: Check for primitive in adjacent cells (cardinal directions).\n    # This check relies on `state.next_to(i_kind)` which covers the 3x3 neighborhood.\n    # We then iterate through cardinal directions to find the specific cell and face it.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Ensure facing cell is within grid bounds and contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the cell in front.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool,\n    # or interacting with a workshop) changes the inventory state, which might be necessary\n    # for later steps to collect the *target* primitive. This complements the specific\n    # goal checks above.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T06:50:36.938757", "function_name": "collect", "function_body": "    actions_list = []\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos # tuple (r, c)\n    start_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n    target_primitive_id = current_state.world.cookbook.index[primitive]\n    WIDTH, HEIGHT, _ = grid.shape\n\n    action_map = env.action_specs()\n    # Map DSL movement/turn actions to their integer indices from action_specs\n    MOVE_FORWARD = action_map['UP']\n    TURN_LEFT = action_map['LEFT']\n    TURN_RIGHT = action_map['RIGHT']\n    USE_ACTION = action_map['USE']\n\n    # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n    DIR_TO_DRDC = {\n        0: (0, 1),   # Facing RIGHT (positive column change)\n        1: (-1, 0),  # Facing UP (negative row change)\n        2: (0, -1),  # Facing LEFT (negative column change)\n        3: (1, 0)    # Facing DOWN (positive row change)\n    }\n\n    # Map for turning left/right, updating the agent's direction (0-3)\n    TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n    TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n    # Get indices of non-grabbable items that block movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n    non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n    def _is_cell_walkable(r, c):\n        \"\"\"Checks if a given grid cell (r, c) is traversable by the agent.\n        A cell is not walkable if it's out of bounds, contains a non-grabbable item,\n        or contains the target primitive itself (agent must remain adjacent).\n        \"\"\"\n        if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n            return False # Out of bounds\n        \n        # Check if the cell contains any non-walkable entity defined in the world\n        for kind_idx in non_walkable_kind_ids:\n            if grid[r, c, kind_idx] > 0:\n                return False\n        \n        # The agent cannot walk *onto* the primitive it wants to collect,\n        # as it needs to be adjacent to it to use the 'USE' action.\n        if grid[r, c, target_primitive_id] > 0:\n            return False\n            \n        return True\n\n    # BFS state: ((row, col), direction), path_actions\n    # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n    queue = collections.deque([((start_pos, start_dir), [])])\n    # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n    visited = {(start_pos, start_dir)}\n\n    target_path = None # Stores the action list to reach the target state\n\n    while queue:\n        (current_pos, current_dir), path_actions = queue.popleft()\n        r, c = current_pos\n\n        # Check if the primitive is directly in front of the agent at the current state.\n        # This is the goal state for collection: agent is adjacent to and facing the primitive.\n        front_dr, front_dc = DIR_TO_DRDC[current_dir]\n        front_r, front_c = r + front_dr, c + front_dc\n        \n        # Check if the cell in front is within grid bounds and contains the target primitive\n        if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n            grid[front_r, front_c, target_primitive_id] > 0):\n            target_path = path_actions\n            break # Path to target found!\n\n        # Explore possible next actions: Move Forward, Turn Left, Turn Right\n        \n        # Option 1: Try Move Forward\n        move_dr, move_dc = DIR_TO_DRDC[current_dir]\n        next_r, next_c = r + move_dr, c + move_dc\n        next_pos = (next_r, next_c)\n        next_dir_after_move = current_dir # Moving forward does not change facing direction\n\n        if _is_cell_walkable(next_r, next_c) and (next_pos, next_dir_after_move) not in visited:\n            visited.add((next_pos, next_dir_after_move))\n            queue.append(((next_pos, next_dir_after_move), path_actions + [MOVE_FORWARD]))\n\n        # Option 2: Try Turn Left\n        next_dir_left = TURN_LEFT_MAP[current_dir]\n        # Turning does not change position, only direction.\n        if ((current_pos, next_dir_left) not in visited):\n            visited.add((current_pos, next_dir_left))\n            queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT]))\n\n        # Option 3: Try Turn Right\n        next_dir_right = TURN_RIGHT_MAP[current_dir]\n        # Turning does not change position, only direction.\n        if ((current_pos, next_dir_right) not in visited):\n            visited.add((current_pos, next_dir_right))\n            queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT]))\n\n    # If a path was found, append the USE action to the sequence of actions.\n    if target_path is not None:\n        actions_list.extend(target_path)\n        actions_list.append(USE_ACTION)\n\n    return actions_list", "island_id": 7, "scores": {"3": -1}}
