# Helper function to compute the minimal sequence of turns to face a target direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the correct direction.\n\n      # Calculate the difference in directions, wrapping around 0-3.\n      diff = (target_dir - current_dir + 4) % 4\n\n      if diff == 1: # Target is one step clockwise.\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise.\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn.\n          return [RIGHT_ACT, RIGHT_ACT] # Two successive right turns (or left turns).\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The `visited` set stores a tuple `(row, col, direction, inventory_tuple)` to represent\n  # a unique state. Converting inventory (numpy array) to a tuple makes it hashable for the set.\n  visited = set()\n\n  # Add the initial state to the queue and visited set.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # (current_state, path_to_reach_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit to prevent the BFS from running indefinitely in complex or unreachable scenarios.\n  # The multiplier (20) allows for broader exploration, especially for tool acquisition.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20\n  explored_states_count = 0\n\n  # 6. BFS Loop: Continues until the queue is empty or the goal is found.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and its associated path.\n    explored_states_count += 1\n\n    # Pruning: If too many distinct states have been explored, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n\n    # Goal Check: Can the target primitive be collected from the current `state`?\n    # This involves checking if the primitive is in the 3x3 neighborhood around the agent.\n    if state.next_to(i_kind):\n        # Iterate through all four cardinal directions to check if the primitive is directly in front.\n        for target_dir in range(4):\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and\n                state.grid[facing_r, facing_c, i_kind] == 1):\n\n                # Calculate and apply the turning actions required to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state\n                for turn_action in turns_to_face:\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Record inventory *before* attempting the 'USE' action to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action on the temporary state.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Crucial verification: Check if the count of the target primitive in inventory\n                # actually increased. This confirms successful collection, accounting for any\n                # game rules (e.g., requiring tools) handled by `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT] # Found a path!\n\n    # Explore possible future states by performing movement actions.\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # If this next state (position, direction, and inventory) has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n\n    # Explore the general 'USE' action from the current state.\n    # This is vital for scenarios where using an item at the current location (e.g., picking up a tool)\n    # might enable subsequent collection steps.\n    \n    # Determine the cell directly in front of the agent\n    front_dr, front_dc = _DIR_TO_DELTA_FRONT[current_dir]\n    facing_r, facing_c = current_r + front_dr, current_c + front_dc\n\n    # Check bounds for the cell in front\n    if 0 <= facing_r < grid_width and 0 <= facing_c < grid_height:\n        # Check if *any* of the `all_useable_and_collectible_kinds` are present in the cell directly in front.\n        # This covers grabbable items, water, stone, and other primitive resources that might be needed.\n        is_something_useable_in_front = False\n        for k_idx_to_check in all_useable_and_collectible_kinds:\n            if state.grid[facing_r, facing_c, k_idx_to_check] == 1:\n                is_something_useable_in_front = True\n                break\n\n        # Only attempt USE_ACT if there's something potentially interactable in front.\n        if is_something_useable_in_front:\n            inventory_before_any_use = np.copy(state.inventory)\n            _, state_after_current_use = state.step(USE_ACT)\n            \n            # Add to queue only if the USE action resulted in a meaningful state change.\n            # A meaningful change means inventory or position/direction was updated.\n            # Inventory change is the primary signal for resource collection.\n            if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n                    state_after_current_use.pos == state.pos and\n                    state_after_current_use.dir == state.dir):\n\n                next_inventory_tuple = tuple(state_after_current_use.inventory)\n                next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS loop completes and no path to collect the primitive was found,\n  # it means the primitive is currently unreachable given the environment and agent's capabilities.\n  return []", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:30:31.331589", "function_name": "collect", "function_body": "  actions_to_take = []\n  current_state = env._current_state # Get the current state of the environment\n\n  # Extract initial agent properties and grid information\n  initial_grid = current_state.grid # The 3D numpy array representing the world grid\n  initial_agent_pos = current_state.pos # (row, col) tuple of agent's starting position\n  initial_agent_dir = current_state.dir # Integer (0-3) representing agent's starting direction\n\n  # Get the integer ID for the target primitive from the game's cookbook index\n  try:\n      target_primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not valid or not found in the game's registry,\n      # it's impossible to collect, so return an empty action list.\n      return []\n\n  # Check if the primitive is actually grabbable.\n  # Only items in `grabbable_indices` can be \"collected\" into inventory by `USE`.\n  # For instance, \"WATER\", \"STONE\" (as terrain), or \"WORKSHOP\" are typically not grabbable,\n  # meaning they cannot be put into inventory. The `collect` function implies adding to inventory.\n  if target_primitive_id not in current_state.world.grabbable_indices:\n      return [] # Cannot collect this type of primitive into inventory.\n\n  # Get grid dimensions (rows, columns) for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map symbolic action names to their corresponding integer IDs using the environment's spec\n  action_ids = env.action_specs()\n  MOVE_FORWARD_ACTION = action_ids['UP']    # Corresponds to moving one cell forward\n  TURN_LEFT_ACTION = action_ids['LEFT']     # Corresponds to turning 90 degrees counter-clockwise\n  TURN_RIGHT_ACTION = action_ids['RIGHT']   # Corresponds to turning 90 degrees clockwise\n  USE_ACTION = action_ids['USE']            # Corresponds to interacting with the cell in front\n\n  # Define how agent's position changes based on its current direction\n  # Directions: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  # Maps (direction_id) -> (delta_row, delta_col)\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Right: (row_unchanged, col_increases)\n      1: (-1, 0),  # Up:    (row_decreases, col_unchanged)\n      2: (0, -1),  # Left:  (row_unchanged, col_decreases)\n      3: (1, 0)    # Down:  (row_increases, col_unchanged)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Identify entity kinds that the agent cannot walk onto (e.g., boundaries, water, workshops).\n  # These are based on the world's non_grabbable_indices.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # --- BFS Setup for Pathfinding ---\n  # The BFS queue stores tuples:\n  # ( (current_row, current_col), current_direction_id ), list_of_actions_taken_to_reach_this_state\n  search_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n\n  # The visited set stores (position_tuple, direction_id) tuples to prevent\n  # infinite loops and redundant path exploration.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the action sequence once the target condition is met.\n  path_to_adjacent_primitive = None\n\n  # Start the BFS traversal\n  while search_queue:\n      # Dequeue the current state and its path\n      (current_pos_rc, current_dir), path_actions = search_queue.popleft()\n      r, c = current_pos_rc # Unpack current row and column\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      dr_front, dc_front = DIRECTION_TO_DELTA_RC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front # Coordinates of the cell directly in front\n\n      # Check if the 'front' cell is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the target primitive is present in this 'front' cell.\n          # We check if `grid[... , primitive_id] > 0`, implying existence.\n          if initial_grid[front_r, front_c, target_primitive_id] > 0:\n              path_to_adjacent_primitive = path_actions # We found the sequence of actions!\n              break # Exit the BFS loop, as a shortest path is found\n\n      # --- Explore Possible Next Actions (Move, Turn Left, Turn Right) ---\n\n      # 1. Try to Move Forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_RC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains unchanged after moving forward\n\n      # Check if the potential new position is within bounds and the state (pos, dir) is unvisited\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          # Determine if the 'next_pos_move' cell is walkable for the agent\n          is_walkable = True\n          # Agent cannot walk onto specified non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP).\n          for kind_idx in non_walkable_kind_ids:\n              if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          # Agent also cannot walk *onto* the specific target primitive itself if it's a resource\n          # (e.g., WOOD, STONE, GRASS). It must remain adjacent to USE it.\n          if is_walkable and initial_grid[next_r_move, next_c_move, target_primitive_id] > 0:\n              is_walkable = False\n\n          if is_walkable:\n              # Add the new state to visited and enqueue it\n              visited_states.add((next_pos_move, next_dir_move))\n              search_queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try to Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos_rc, next_dir_left) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_left))\n          search_queue.append(((current_pos_rc, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try to Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos_rc, next_dir_right) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_right))\n          search_queue.append(((current_pos_rc, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # --- Finalize Actions ---\n  # If a path to being adjacent to and facing the primitive was found:\n  if path_to_adjacent_primitive is not None:\n      actions_to_take.extend(path_to_adjacent_primitive)\n      actions_to_take.append(USE_ACTION) # Append the USE action to collect the primitive\n      \n  return actions_to_take", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:30:32.553029", "function_name": "collect", "function_body": "  actions_to_collect = []\n  current_state = env._current_state # Get the current state of the environment\n\n  # Extract initial agent properties and grid information\n  initial_grid = current_state.grid # The 3D numpy array representing the world grid\n  initial_agent_pos = current_state.pos # (row, col) tuple of agent's starting position\n  initial_agent_dir = current_state.dir # Integer (0-3) representing agent's starting direction\n\n  # Get the integer ID for the target primitive from the game's cookbook index\n  try:\n      target_primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not valid or not found in the game's registry,\n      # it's impossible to collect, so return an empty action list.\n      return []\n\n  # Check if the primitive is actually grabbable.\n  # Only items in `grabbable_indices` can be \"collected\" into inventory by `USE`.\n  # For instance, \"WATER\", \"STONE\" (as terrain), or \"WORKSHOP\" are typically not grabbable,\n  # meaning they cannot be put into inventory. The `collect` function implies adding to inventory.\n  if target_primitive_id not in current_state.world.grabbable_indices:\n      return [] # Cannot collect this type of primitive into inventory.\n\n  # Get grid dimensions (rows, columns) for boundary checks\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map symbolic action names to their corresponding integer IDs using the environment's spec\n  action_ids = env.action_specs()\n  MOVE_FORWARD_ACTION = action_ids['UP']    # Corresponds to moving one cell forward\n  TURN_LEFT_ACTION = action_ids['LEFT']     # Corresponds to turning 90 degrees counter-clockwise\n  TURN_RIGHT_ACTION = action_ids['RIGHT']   # Corresponds to turning 90 degrees clockwise\n  USE_ACTION = action_ids['USE']            # Corresponds to interacting with the cell in front\n\n  # Define how agent's position changes based on its current direction\n  # Directions: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n  # Maps (direction_id) -> (delta_row, delta_col)\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Right: (row_unchanged, col_increases)\n      1: (-1, 0),  # Up:    (row_decreases, col_unchanged)\n      2: (0, -1),  # Left:  (row_unchanged, col_decreases)\n      3: (1, 0)    # Down:  (row_increases, col_unchanged)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # e.g., Right (0) -> Up (1)\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right (0) -> Down (3)\n\n  # Identify entity kinds that the agent cannot walk onto (e.g., boundaries, water, workshops).\n  # These are based on the world's non_grabbable_indices.\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to check if a given cell (r, c) is within bounds and free of obstacles.\n  # This function determines if the agent can *move to* a specific (r, c) cell.\n  def is_cell_walkable(r_coord, c_coord, grid_data, rows, cols, non_walkable_ids, target_id):\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r_coord < rows and 0 <= c_coord < cols):\n          return False\n\n      # Check if the cell contains any entity that blocks movement.\n      for kind_idx in non_walkable_ids:\n          if grid_data[r_coord, c_coord, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk *onto* the primitive itself if it's a resource (e.g., WOOD, STONE, GRASS).\n      # It must remain adjacent to USE it.\n      if grid_data[r_coord, c_coord, target_id] > 0:\n          return False\n      \n      return True\n\n  # --- BFS Setup for Pathfinding ---\n  # The BFS queue stores tuples:\n  # ( (current_row, current_col), current_direction_id ), list_of_actions_taken_to_reach_this_state\n  search_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n\n  # The visited set stores (position_tuple, direction_id) tuples to prevent\n  # infinite loops and redundant path exploration.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  # This variable will store the action sequence once the target condition is met.\n  path_to_adjacent_primitive = None\n\n  # Start the BFS traversal\n  while search_queue:\n      # Dequeue the current state and its path\n      (current_pos_rc, current_dir), path_actions = search_queue.popleft()\n      r, c = current_pos_rc # Unpack current row and column\n\n      # --- Goal Check: Is the primitive directly in front of the agent? ---\n      dr_front, dc_front = DIRECTION_TO_DELTA_RC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front # Coordinates of the cell directly in front\n\n      # Check if the 'front' cell is within grid boundaries\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # Check if the target primitive is present in this 'front' cell.\n          # We check if `grid[... , primitive_id] > 0`, implying existence.\n          if initial_grid[front_r, front_c, target_primitive_id] > 0:\n              path_to_adjacent_primitive = path_actions # We found the sequence of actions!\n              break # Exit the BFS loop, as a shortest path is found\n\n      # --- Explore Possible Next Actions (Move, Turn Left, Turn Right) ---\n\n      # 1. Try to Move Forward\n      move_dr, move_dc = DIRECTION_TO_DELTA_RC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction remains unchanged after moving forward\n\n      # Check if the potential new position is valid, walkable, and the state (pos, dir) is unvisited\n      if is_cell_walkable(next_r_move, next_c_move, initial_grid, GRID_ROWS, GRID_COLS, non_walkable_kind_ids, target_primitive_id):\n          if (next_pos_move, next_dir_move) not in visited_states:\n              # Add the new state to visited and enqueue it\n              visited_states.add((next_pos_move, next_dir_move))\n              search_queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try to Turn Left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos_rc, next_dir_left) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_left))\n          search_queue.append(((current_pos_rc, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try to Turn Right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos_rc, next_dir_right) not in visited_states):\n          visited_states.add((current_pos_rc, next_dir_right))\n          search_queue.append(((current_pos_rc, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # --- Finalize Actions ---\n  # If a path to being adjacent to and facing the primitive was found:\n  if path_to_adjacent_primitive is not None:\n      actions_to_collect.extend(path_to_adjacent_primitive)\n      actions_to_collect.append(USE_ACTION) # Append the USE action to collect the primitive\n      \n  return actions_to_collect", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:31:49.647034", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:31:51.074851", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n    This version reintroduces pragmatic limits on search depth (`MAX_EXPLORED_STATES`)\n    and path length (`MAX_PATH_LENGTH`) from `v0` for more efficient and practical\n    pathfinding, while maintaining the robust inventory-aware BFS from `v1`.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # Heuristic limit for explored states to prevent excessive computation in very large or complex scenarios.\n  # The factor of 10 accounts for the additional state dimensions (direction, inventory).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  # MAX_PATH_LENGTH is a heuristic limit to prevent finding excessively long, impractical paths.\n  MAX_PATH_LENGTH = 200 # This can be tuned based on expected scenario complexity.\n  \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, return empty list immediately.\n    # This prevents exhausting the queue or exceeding computational limits.\n    if explored_states_count > MAX_EXPLORED_STATES:\n        # If the search budget is exhausted, no path found within limits.\n        # This acts as a hard stop for the search.\n        return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    final_path = path + turns_to_face + [USE_ACT]\n                    # If the found path (which is the shortest due to BFS)\n                    # exceeds MAX_PATH_LENGTH, consider it unachievable or too long.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found is too long, so no valid path exists within the limit.\n                        # Since BFS explores in layers, this is the shortest path possible,\n                        # so if it's too long, no shorter path exists either.\n                        return []\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Check if this state has been visited with this specific inventory.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Pruning: Only enqueue if the path won't exceed MAX_PATH_LENGTH by a reasonable buffer.\n        # This is a soft check; the hard check is done upon finding the goal.\n        # Adding 1 for the current action.\n        if len(path) + 1 <= MAX_PATH_LENGTH + 5: # Small buffer to allow path completion, if close\n            q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is crucial for collecting intermediate items (like tools)\n    # that are not the target primitive but enable its collection.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Same pruning as above for USE action.\n        if len(path) + 1 <= MAX_PATH_LENGTH + 5:\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:32:24.607713", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Extract current state information\n  # The grid is typically indexed as grid[row, col, kind_id]\n  grid = current_state.grid \n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    # Return an empty list indicating the task cannot be performed.\n    return []\n  \n  # Determine grid dimensions (number of rows, number of columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  # 'UP' action typically means moving forward in the agent's current direction.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item (e.g., chop, mine)\n\n  # Define how agent's (row, col) position changes when moving forward based on direction.\n  # This maps current_dir to a (delta_row, delta_col) tuple.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP:   (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right (cyclical).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right(0) -> Up(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right(0) -> Down(3)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Crucially, the primitive itself is also added here, as the agent needs to stop\n  # *adjacent* to it and face it to use the 'USE' action, not walk directly onto its cell.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup:\n  # The queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the target state is found.\n\n  # Start BFS to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current_pos into row and column\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent.\n      # This is the goal condition for pathfinding: being adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the calculated 'front' cell is within grid boundaries.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the path to the collection point.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path leading to this \"adjacent and facing\" state.\n              break # Exit BFS, as the shortest path to the goal state has been found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries AND if this (position, direction) state has not been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the cell at `next_pos` is walkable.\n          # A cell is unwalkable if it contains any entity kind specified in `unwalkable_kind_ids`.\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              # If the cell is walkable and the state is unvisited, add it to the visited set and the queue.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS search completes:\n  # If a `target_path_actions` was found (meaning the primitive was located and a path to it exists),\n  # append the `USE_ACTION` to the sequence to actually collect the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  \n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:32:25.706560", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n\n  # Extract current state information\n  # The grid is typically indexed as grid[row, col, kind_id]\n  grid = current_state.grid \n  initial_pos = current_state.pos # Agent's current (row, col) tuple\n  initial_dir = current_state.dir # Agent's current facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  try:\n    primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    # Return an empty list indicating the task cannot be performed.\n    return []\n  \n  # Determine grid dimensions (number of rows, number of columns)\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  # 'UP' action typically means moving forward in the agent's current direction.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item (e.g., chop, mine)\n\n  # Define how agent's (row, col) position changes when moving forward based on direction.\n  # This maps current_dir to a (delta_row, delta_col) tuple.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP:   (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right (cyclical).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # e.g., Right(0) -> Up(1)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # e.g., Right(0) -> Down(3)\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Crucially, the primitive itself is also added here, as the agent needs to stop\n  # *adjacent* to it and face it to use the 'USE' action, not walk directly onto its cell.\n  unwalkable_kind_ids = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids.add(primitive_id) \n\n  # BFS setup:\n  # The queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions once the target state is found.\n\n  # Start BFS to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Deconstruct current_pos into row and column\n\n      # 1. Check if the target primitive is in the cell directly in front of the agent.\n      # This is the goal condition for pathfinding: being adjacent to and facing the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the calculated 'front' cell is within grid boundaries.\n      if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n          # If the cell in front contains the primitive, we have found the path to the collection point.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Store the path leading to this \"adjacent and facing\" state.\n              break # Exit BFS, as the shortest path to the goal state has been found.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try moving Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir] # Delta for moving forward\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries AND if this (position, direction) state has not been visited.\n      if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the cell at `next_pos` is walkable.\n          # A cell is unwalkable if it contains any entity kind specified in `unwalkable_kind_ids`.\n          is_walkable = True\n          for kind_idx in unwalkable_kind_ids:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n          \n          if is_walkable:\n              # If the cell is walkable and the state is unvisited, add it to the visited set and the queue.\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try turning Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_left) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try turning Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not the agent's position.\n      if ((current_pos, next_dir_right) not in visited):\n          # If this (position, new_direction) state is unvisited, add it.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After the BFS search completes:\n  # If a `target_path_actions` was found (meaning the primitive was located and a path to it exists),\n  # append the `USE_ACTION` to the sequence to actually collect the primitive.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n  \n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:34:20.324796", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  \n  # Adjusted heuristic limits for robustness and scalability:\n  # MAX_EXPLORED_STATES: Maximum number of distinct states to explore.\n  # Multiplied by 4 (directions) and 20 (heuristic for inventory variations).\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 20 \n  explored_states_count = 0\n\n  # MAX_PATH_LENGTH: Maximum allowed length for the returned action sequence.\n  # Set to a value that allows traversing the grid multiple times to account for detours or\n  # collecting intermediate items, but prevents excessively long, inefficient plans.\n  MAX_PATH_LENGTH = grid_width * grid_height * 3 # Allow for about 3 full grid traversals\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, return empty list immediately.\n    # This prevents exhausting the queue with states beyond the heuristic limit if a path is not found.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell in front is within bounds and contains the target primitive.\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # _ is reward, which is always 0.0 for CraftState.step here.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    final_path = path + turns_to_face + [USE_ACT]\n                    # Check if the found path (which is the shortest due to BFS)\n                    # exceeds MAX_PATH_LENGTH, consider it unachievable or too long.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found is too long, so no valid path exists within the limit.\n                        return []\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Pruning: Only add to queue if not visited and current path length is within limits\n      if next_state_key not in visited and len(path) + 1 <= MAX_PATH_LENGTH:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is crucial for collecting intermediate items (like tools)\n    # that are not the target primitive but enable its collection.\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    # Pruning: Only add to queue if not visited and current path length is within limits\n    if next_state_key not in visited and len(path) + 1 <= MAX_PATH_LENGTH:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T13:34:21.579787", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set includes the agent's inventory as part of the state key.\n  # Inventory (numpy.ndarray) is converted to a tuple for hashing, allowing BFS to distinguish\n  # between states that are identical in position/direction but differ in inventory (e.g., having a tool vs. not).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, [])) # Queue stores (CraftState, path_to_this_state)\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in large state spaces.\n  # The multiplier '10' accounts for possible different inventory states at the same (pos, dir).\n  # This value may need tuning based on environment complexity and available resources.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 10 \n  explored_states_count = 0\n\n  # Introduce a maximum path length to prevent excessively long plans.\n  # If the shortest path found exceeds this, it is considered too inefficient for practical use.\n  MAX_PATH_LENGTH = 200 # This can be tuned based on expected scenario complexity.\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, return empty list immediately.\n    # This prevents exhausting the queue with states beyond the heuristic limit if a path is not found.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`).\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # _ is reward, which is always 0.0 for CraftState.step in this implementation.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed or resource depletion) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    final_path = path + turns_to_face + [USE_ACT]\n                    # Check if the found path (which is the shortest due to BFS property)\n                    # exceeds MAX_PATH_LENGTH. If so, consider it unachievable or too long.\n                    if len(final_path) <= MAX_PATH_LENGTH:\n                        return final_path\n                    else:\n                        # The shortest path found is too long, so no valid path exists within the limit.\n                        return []\n\n    # Explore possible movement actions (UP, DOWN, LEFT, RIGHT):\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      # Only add to queue if this state has not been visited before (with this specific inventory).\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position.\n    # This is crucial for collecting intermediate items (like tools)\n    # that are not the target primitive but may enable its collection,\n    # or for interacting with items in the current cell (e.g., using a workbench).\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    next_inventory_tuple = tuple(state_after_current_use.inventory)\n    next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n    # Only add to queue if this state (with new inventory/pos/dir) has not been visited.\n    if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions\n  # and the defined search limits.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T13:34:56.507702", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # Access the internal CraftState object which holds the current grid, position, and inventory.\n  current_state = env._current_state \n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # This indicates an invalid primitive name, so no actions are possible.\n      return []\n\n  # V2 Improvement: Early exit if the primitive is already in inventory.\n  # If the agent already possesses at least one unit of the primitive, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return [] \n\n  # Extract essential information for pathfinding from the current state.\n  initial_grid = current_state.grid  # The static grid layout of the environment (for pathfinding).\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  # These are defined in CraftWorld as `non_grabbable_indices` (e.g., boundaries, water, workshops).\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function to find a sequence of movement/turn actions (BFS)\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \"\"\"\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          # Pop the current state and path from the queue\n          (current_pos, current_dir), path_actions = queue.popleft()\n          current_r, current_c = current_pos\n\n          # 1. Check if the current state satisfies the target condition:\n          # The primitive must be in the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = current_r + front_dr, current_c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # Try Move Forward (corresponds to 'UP' action)\n          next_r_move, next_c_move = current_r + DIR_TO_DRDC[current_dir][0], current_c + DIR_TO_DRDC[current_dir][1]\n          next_pos_move = (next_r_move, next_c_move)\n          next_dir_move = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds and this (position, direction) state hasn't been visited\n          if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n              (next_pos_move, next_dir_move) not in visited):\n              \n              is_walkable = True\n              # An agent cannot walk onto cells containing non-grabbable entities\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r_move, next_c_move, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # An agent also cannot walk onto the target primitive itself (it needs to be adjacent, not on top)\n              if initial_grid[next_r_move, next_c_move, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  visited.add((next_pos_move, next_dir_move))\n                  queue.append(((next_pos_move, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # Try Turn Left ('LEFT' action)\n          # Using modular arithmetic for concise turn calculations: (current_dir + 1) % 4\n          # R(0)->U(1), U(1)->L(2), L(2)->D(3), D(3)->R(0)\n          next_dir_left = (current_dir + 1) % 4\n          # Turning does not change position.\n          if ((current_pos, next_dir_left) not in visited):\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # Try Turn Right ('RIGHT' action)\n          # Using modular arithmetic for concise turn calculations: (current_dir - 1 + 4) % 4\n          # R(0)->D(3), U(1)->R(0), L(2)->U(1), D(3)->L(2)\n          next_dir_right = (current_dir - 1 + 4) % 4\n          # Turning does not change position.\n          if ((current_pos, next_dir_right) not in visited):\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the movement/turn sequence\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action is assumed to \"collect\" the primitive once the agent is in the correct position.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  # Return the sequence of actions. This list will be empty if the primitive\n  # was not found, was unreachable, or was already in inventory (due to early exit).\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:34:57.835658", "function_name": "collect", "function_body": "  actions_list = []\n  \n  current_state = env._current_state \n  initial_grid = current_state.grid\n  initial_pos = current_state.pos    # Agent's current (row, col) position on the grid.\n  initial_dir = current_state.dir    # Agent's current facing direction (0:Right, 1:Up, 2:Left, 3:Down).\n\n  # Get the integer ID for the target primitive from the cookbook index.\n  try:\n      primitive_id = current_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      # This indicates an invalid primitive name, so no actions are possible.\n      return []\n\n  # Early exit: If the agent already possesses at least one unit of the primitive, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return [] \n\n  # Get grid dimensions for boundary checks during pathfinding.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape \n\n  # Map action names (from DSL) to their integer indices (used by env.step).\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Pre-defined changes in (row, col) coordinates for each direction.\n  # Directions: 0 (Right), 1 (Up), 2 (Left), 3 (Down)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column.\n      1: (-1, 0),  # Facing UP: -1 to row.\n      2: (0, -1),  # Facing LEFT: -1 to column.\n      3: (1, 0)    # Facing DOWN: +1 to row.\n  }\n\n  # Set of entity kind IDs that represent non-walkable terrain.\n  # These are defined in CraftWorld as `non_grabbable_indices` (e.g., boundaries, water, workshops).\n  non_walkable_kind_ids = current_state.world.non_grabbable_indices\n\n  def _find_path_to_adjacent_facing_primitive(\n      start_pos: tuple[int, int],\n      start_dir: int,\n      target_primitive_id: int,\n  ) -> list[int] | None:\n      \"\"\"\n      Internal helper function using BFS to find a sequence of movement/turn actions\n      to reach a state where the agent is adjacent to and facing the target primitive.\n      \"\"\"\n      # BFS Queue: stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n      queue = collections.deque([((start_pos, start_dir), [])])\n      # Visited set: stores (position_tuple, direction_int) to avoid redundant paths and cycles\n      visited = {(start_pos, start_dir)}\n\n      while queue:\n          # Pop the current state and path from the queue\n          (current_pos, current_dir), path_actions = queue.popleft()\n          current_r, current_c = current_pos\n\n          # Goal Check: Is the primitive directly in front of the agent at the current state?\n          # This is the desired state from which the 'USE' action can be executed.\n          front_dr, front_dc = DIR_TO_DRDC[current_dir]\n          front_r, front_c = current_r + front_dr, current_c + front_dc\n\n          # Ensure the cell in front is within grid bounds\n          if (0 <= front_r < GRID_ROWS and 0 <= front_c < GRID_COLS):\n              # Check if the cell in front contains the target primitive\n              if initial_grid[front_r, front_c, target_primitive_id] > 0:\n                  return path_actions # Path found, return the sequence of actions\n\n          # Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # 1. Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r, next_c = current_r + move_dr, current_c + move_dc\n          next_pos = (next_r, next_c)\n          next_dir = current_dir # Moving forward does not change facing direction\n\n          # Check if the next position is within bounds\n          if (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n              \n              # Determine if the next position is walkable:\n              is_walkable = True\n              # An agent cannot walk onto cells containing non-grabbable entities\n              for kind_idx in non_walkable_kind_ids:\n                  if initial_grid[next_r, next_c, kind_idx] > 0:\n                      is_walkable = False\n                      break\n              # An agent also cannot walk onto the target primitive itself (it needs to be adjacent to 'USE' it)\n              if initial_grid[next_r, next_c, target_primitive_id] > 0:\n                  is_walkable = False\n\n              if is_walkable:\n                  if (next_pos, next_dir) not in visited:\n                      visited.add((next_pos, next_dir))\n                      queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n          # 2. Try Turn Left\n          # (current_dir + 1) % 4 cycles through 0->1, 1->2, 2->3, 3->0\n          next_dir_left = (current_dir + 1) % 4\n          # Turning does not change position.\n          if (current_pos, next_dir_left) not in visited:\n              visited.add((current_pos, next_dir_left))\n              queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n          # 3. Try Turn Right\n          # (current_dir - 1 + 4) % 4 cycles through 0->3, 1->0, 2->1, 3->2\n          next_dir_right = (current_dir - 1 + 4) % 4\n          # Turning does not change position.\n          if (current_pos, next_dir_right) not in visited:\n              visited.add((current_pos, next_dir_right))\n              queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n      return None # No path found after exploring all reachable states\n\n  # Call the nested BFS helper function to find the movement/turn sequence\n  path_to_primitive = _find_path_to_adjacent_facing_primitive(\n      start_pos=initial_pos,\n      start_dir=initial_dir,\n      target_primitive_id=primitive_id,\n  )\n\n  # If a valid path to the primitive was found, append the 'USE' action to the sequence.\n  # The 'USE' action collects the primitive once the agent is in the correct position.\n  if path_to_primitive is not None:\n      actions_list.extend(path_to_primitive)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:35:32.925312", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']  # 'UP' usually means move forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column)\n      1: (-1, 0),  # Facing UP (negative row)\n      2: (0, -1),  # Facing LEFT (negative column)\n      3: (1, 0)    # Facing DOWN (positive row)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Identify all kinds of entities that the agent cannot walk onto.\n  # This includes general non-grabbable items (like boundaries, water, workshops)\n  # AND the primitive itself (as the agent needs to stop *adjacent* to it, not on it).\n  unwalkable_kind_ids = list(current_state.world.non_grabbable_indices)\n  if primitive_id not in unwalkable_kind_ids: # Ensure primitive_id is added if not already in non_grabbable\n      unwalkable_kind_ids.append(primitive_id)\n  unwalkable_kind_ids = np.array(unwalkable_kind_ids) # Convert to numpy array for efficient indexing\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent at the current state.\n      # This is the goal condition: being adjacent to the primitive and facing it.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid bounds\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front_cell contains the primitive\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path to target found!\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Check if next_pos is within bounds and this (position, direction) state hasn't been visited\n      if (0 <= next_r < GRID_WIDTH and 0 <= next_c < GRID_HEIGHT and\n          (next_pos, next_dir) not in visited):\n          \n          # Determine if the next position is walkable.\n          # Use numpy.any to efficiently test if any unwalkable kind is present.\n          is_walkable = not np.any(grid[next_r, next_c, unwalkable_kind_ids] > 0)\n\n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to an adjacent-and-facing state, append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:35:34.072057", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state # Access the current state of the environment\n  \n  # Extract relevant information from the current state\n  grid = current_state.grid # The environment grid (WIDTH, HEIGHT, n_kinds)\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's starting direction (0:R, 1:U, 2:L, 3:D)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names from the DSL/environment to their integer indices\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # Assuming 'UP' corresponds to moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE'] # Action to collect the item\n\n  # Define how agent's position changes when moving forward based on direction\n  # (dr, dc) tuple for (delta_row, delta_col)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): (R, C+1)\n      1: (-1, 0),  # Facing UP (1):   (R-1, C)\n      2: (0, -1),  # Facing LEFT (2): (R, C-1)\n      3: (1, 0)    # Facing DOWN (3): (R+1, C)\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify entity kinds that the agent cannot walk onto.\n  # This includes general non-grabbable items (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # AND the primitive itself, as the agent needs to stop *adjacent* to it to USE.\n  unwalkable_kind_ids_set = set(current_state.world.non_grabbable_indices)\n  unwalkable_kind_ids_set.add(primitive_id) \n  unwalkable_kind_ids_list = list(unwalkable_kind_ids_set) # Convert to list for numpy indexing\n\n  # BFS setup\n  # Queue stores elements: ((current_pos_tuple, current_dir_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) pairs to avoid redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # To store the sequence of actions once the target state is found\n\n  # Start BFS\n  while queue:\n      (current_pos, current_dir), path_segment = queue.popleft()\n      r, c = current_pos\n\n      # Check if the target primitive is in the cell directly in front of the agent\n      # Calculate coordinates of the cell directly in front\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within grid boundaries\n      if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT):\n          # Check if the front cell contains the primitive\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_segment # Path to reach adjacent-and-facing state found\n              break # Exit BFS, target found\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n      \n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r_move, next_c_move = r + move_dr, c + move_dc\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within bounds and this (pos, dir) state hasn't been visited\n      if (0 <= next_r_move < GRID_WIDTH and 0 <= next_c_move < GRID_HEIGHT and\n          (next_pos_move, next_dir_move) not in visited):\n          \n          # Check if the next position is walkable (i.e., does not contain any unwalkable kind)\n          # Using np.any for efficient check against multiple unwalkable kinds\n          is_walkable = not np.any(grid[next_r_move, next_c_move, unwalkable_kind_ids_list] > 0)\n          \n          if is_walkable:\n              visited.add((next_pos_move, next_dir_move))\n              queue.append(((next_pos_move, next_dir_move), path_segment + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_segment + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_segment + [TURN_RIGHT_ACTION]))\n\n  # If a path to the adjacent-and-facing state was found, append the USE action\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:36:04.325196", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Get the integer ID for the target primitive from the cookbook index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # --- Improvement for collect_v2: Early exit if the primitive is already in inventory. ---\n  # If the agent already possesses the desired primitive, no further actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Retrieve initial state information for BFS\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, column)\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Get action mappings from the environment's action specifications.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' typically means moving forward relative to agent's direction.\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for changing row and column based on agent's facing direction.\n  # Used to calculate the cell directly in front or the next position when moving forward.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column change)\n      1: (-1, 0),  # Facing UP (negative row change)\n      2: (0, -1),  # Facing LEFT (negative column change)\n      3: (1, 0)    # Facing DOWN (positive row change)\n  }\n\n  # Maps for updating agent's direction after turning left or right.\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Define the complete set of entity kinds that block agent movement into a cell.\n  # This includes `non_grabbable_indices` and the `primitive_id` itself if it's a collectible\n  # resource (e.g., WOOD, STONE), as the agent should stand *adjacent* to collect, not *on*.\n  # If the primitive is already a non-grabbable (like a workshop), adding it again has no effect.\n  # This ensures the agent finds a path to stand *next to* the primitive, not on it.\n  blocking_kinds_set = set(current_state.world.non_grabbable_indices)\n  blocking_kinds_set.add(primitive_id) \n  blocking_kinds_array = np.array(list(blocking_kinds_set), dtype=int) # For efficient NumPy array indexing during grid cell checks.\n\n  # Initialize Breadth-First Search (BFS) structures:\n  # queue: stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  # visited: stores (position_tuple, direction_int) pairs to prevent redundant exploration and cycles.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # This will store the sequence of actions if a path to the primitive is found.\n\n  # BFS loop to find the shortest path.\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Goal Check: Determine if the target primitive is directly in front of the agent.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front cell is within the grid boundaries.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front cell contains the primitive we are looking for.\n          # We use `initial_grid` here because the BFS explores possible paths\n          # based on the static initial layout.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions # Path found! Store the actions.\n              break # Exit BFS, as we found the shortest path to an adjacent position.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward action:\n      # Calculate the next position if the agent moves forward.\n      next_r, next_c = r + front_dr, c + front_dc # Reuse front_dr, front_dc for movement\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change the agent's facing direction.\n\n      # Check if the next position is within grid boundaries.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this specific (position, direction) state has not been visited yet.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next position is walkable.\n              # A cell is not walkable if it contains any of the blocking kinds.\n              is_walkable = not np.any(initial_grid[next_r, next_c, blocking_kinds_array] > 0)\n              \n              if is_walkable:\n                  visited.add((next_pos, next_dir)) # Mark this state as visited.\n                  # Add the new state to the queue with the updated path of actions.\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left action:\n      # Calculate the new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left)) # Mark as visited.\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right action:\n      # Calculate the new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this (current_position, new_direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right)) # Mark as visited.\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # After BFS completes:\n  # If a path was found (i.e., target_path_actions is not None), append the final USE action.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:36:05.491185", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # *** IMPROVEMENT for collect_v2: Early exit if the primitive is already in inventory. ***\n  # If the agent already possesses the desired primitive, no further actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Get grid dimensions\n  grid_rows, grid_cols, _ = grid.shape \n\n  # Map DSL actions to their integer indices from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for moving forward based on agent's current direction\n  # DIR_TO_DRDC[direction]: (delta_row, delta_col)\n  # 0:RIGHT (+col), 1:UP (-row), 2:LEFT (-col), 3:DOWN (+row)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: (row, col+1)\n      1: (-1, 0),  # Up:    (row-1, col)\n      2: (0, -1),  # Left:  (row, col-1)\n      3: (1, 0)    # Down:  (row+1, col)\n  }\n\n  # Define how turning actions update the agent's direction\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify all kinds that block agent movement.\n  # This includes non-grabbable items (like boundaries, water, workshops)\n  # and the primitive itself, as the agent cannot walk ONTO the primitive,\n  # but must be adjacent to it to 'USE' it.\n  blocking_kinds_set = set(current_state.world.non_grabbable_indices)\n  blocking_kinds_set.add(primitive_id) \n  # Convert to a numpy array for efficient checking using np.any\n  blocking_kinds_array = np.array(list(blocking_kinds_set), dtype=int)\n\n\n  # BFS initialization:\n  # Queue stores tuples of ( (current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position, direction) tuples to prevent redundant exploration and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_to_adjacency = None # This will store the action sequence leading to the state\n                                   # where the agent is adjacent to the primitive and facing it.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Step 1: Check if the primitive is directly in front of the agent at the current state.\n      # This is our goal condition for stopping the BFS.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the cell in front is within grid boundaries\n      if (0 <= front_r < grid_rows and 0 <= front_c < grid_cols):\n          # If the front cell contains the primitive, we've found the path to be adjacent and facing it.\n          if grid[front_r, front_c, primitive_id] > 0:\n              target_path_to_adjacency = path_actions\n              break # Path to target found, exit BFS\n\n      # Step 2: Explore possible next actions (Move Forward, Turn Left, Turn Right)\n\n      # Action: Move Forward\n      next_r_forward, next_c_forward = r + front_dr, c + front_dc # Reuse front_dr, front_dc for movement\n      next_pos_forward = (next_r_forward, next_c_forward)\n      next_dir_forward = current_dir # Direction does not change when moving forward\n\n      # Check if the forward move is valid:\n      # - Within grid boundaries\n      # - This (position, direction) state has not been visited yet\n      # - The target cell is walkable (does not contain any blocking kinds)\n      if (0 <= next_r_forward < grid_rows and 0 <= next_c_forward < grid_cols and\n          (next_pos_forward, next_dir_forward) not in visited):\n          \n          # Check if the cell at next_pos_forward is walkable using the pre-computed blocking_kinds_array.\n          # np.any will be True if any of the blocking kinds are present in the cell.\n          is_walkable = not np.any(grid[next_r_forward, next_c_forward, blocking_kinds_array] > 0)\n          \n          if is_walkable:\n              visited.add((next_pos_forward, next_dir_forward))\n              queue.append(((next_pos_forward, next_dir_forward), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Action: Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position remains the same when turning\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Action: Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position remains the same when turning\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found to reach the state where the agent is adjacent to the primitive and facing it,\n  # append the USE action to complete the collection process.\n  if target_path_to_adjacency is not None:\n      actions_list.extend(target_path_to_adjacency)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T13:36:41.385585", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  \n  # Store initial grid state, agent's position, and direction.\n  # These are immutable for the purpose of pathfinding in the static environment.\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting (row, col) tuple\n  initial_dir = current_state.dir # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the specific primitive to be collected (e.g., 'WOOD', 'STONE').\n  # This ID is crucial for identifying the primitive on the grid.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Extract grid dimensions for boundary checks during pathfinding.\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  # These map string action names (like 'UP', 'USE') to integer IDs recognized by `env.step()`.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # Action to move forward in the current direction.\n  TURN_LEFT_ACTION = action_map['LEFT']     # Action to turn 90 degrees left.\n  TURN_RIGHT_ACTION = action_map['RIGHT']   # Action to turn 90 degrees right.\n  USE_ACTION = action_map['USE']            # Action to interact with the object in front.\n\n  # Define how agent's (row, col) changes based on its direction when moving forward.\n  # This dictionary maps a direction ID to a (delta_row, delta_col) tuple.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right.\n  # These maps ensure cyclic transitions (e.g., turning left from RIGHT leads to UP).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get the set of integer indices for entities that the agent cannot walk onto.\n  # This typically includes boundaries, water, and specific workshop types.\n  impassable_entity_ids = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if a given cell (r, c) is a valid and walkable location for the agent.\n  def is_cell_walkable(r: int, c: int) -> bool:\n      # First, check if the cell is within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Second, check if the cell contains any impassable entities.\n      # The agent cannot move into cells occupied by these types of objects.\n      for entity_id in impassable_entity_ids:\n          if initial_grid[r, c, entity_id] > 0:\n              return False\n      \n      # Third, the agent cannot walk onto the primitive it intends to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n      \n      # If all checks pass, the cell is safe and walkable.\n      return True\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores ( (agent_position, agent_direction), list_of_actions_taken_to_reach_this_state ).\n  # Each element defines a unique state of the agent (where it is and where it's facing) and the path to get there.\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  \n  # The 'visited' set keeps track of (position, direction) states already explored.\n  # This prevents redundant computations and infinite loops in cyclic paths, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  # This variable will store the sequence of actions that leads the agent to be adjacent to and facing the primitive.\n  path_to_primitive_front = None \n\n  # Start the BFS traversal\n  while queue:\n      (current_pos, current_dir), actions_so_far = queue.popleft()\n      r, c = current_pos # Current row and column of the agent.\n\n      # 1. Check if the target primitive is directly in front of the agent from the current state.\n      # This is the goal condition for our pathfinding: being in a position to 'USE' the primitive.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell directly in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell immediately in front, we've found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              path_to_primitive_front = actions_so_far\n              break # Shortest path found; exit BFS.\n\n      # 2. Explore all possible next actions (Move Forward, Turn Left, Turn Right) from the current state.\n\n      # --- Try Move Forward Action ---\n      # Calculate the agent's new position if it moves one step forward. Direction remains unchanged.\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change orientation.\n\n      # Check if the calculated next position is walkable and if this new (position, direction) state\n      # has not been visited yet.\n      if is_cell_walkable(next_r, next_c) and (next_pos, next_dir) not in visited:\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), actions_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left Action ---\n      # Calculate the agent's new direction after turning left. Position remains unchanged.\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Check if this new (position, direction) state has not been visited.\n      if ((current_pos, next_dir_left) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), actions_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right Action ---\n      # Calculate the agent's new direction after turning right. Position remains unchanged.\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Check if this new (position, direction) state has not been visited.\n      if ((current_pos, next_dir_right) not in visited):\n          # If valid, add this new state to the queue and mark it as visited.\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), actions_so_far + [TURN_RIGHT_ACTION]))\n\n  # After the BFS completes:\n  # If a path to the target state (adjacent and facing the primitive) was found,\n  # append the final 'USE' action to that path to simulate collecting the primitive.\n  # If no path was found (path_to_primitive_front remains None), an empty list is returned,\n  # indicating the primitive is currently unreachable from the agent's initial state.\n  if path_to_primitive_front is not None:\n      actions_list.extend(path_to_primitive_front)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
