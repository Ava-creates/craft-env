reach it\n    explored_states_count += 1\n\n    # Improvement for v2: If we've explored too many distinct states, return empty list immediately.\n    # This prevents exhausting the queue with states beyond the heuristic limit if a path is not found.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`.\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:48:01.090168", "function_name": "collect", "function_body": "  \"\"\"Finds the shortest sequence of actions to collect a specified primitive using BFS.\n\n    The agent needs to navigate to a cell adjacent to the primitive and face it,\n    then use the 'USE' action to collect it. Obstacles include boundaries, water,\n    and workshops (non-grabbable entities).\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The string name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A list of action indices (integers) to achieve the goal.\n                   Returns an empty list if the primitive is unreachable.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n\n  # Extract initial state information\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (row, col)\n  initial_dir = current_state.dir  # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive\n  primitive_id = current_state.world.cookbook.index.get(primitive)\n  if primitive_id is None: # Safety check, though valid primitives are expected by DSL\n      return []\n\n  # Get grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Map action names to their integer indices from the environment's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define direction vectors for movement (row_change, col_change)\n  # Indexed by agent's current direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # RIGHT: (row, col+1)\n      1: (-1, 0),  # UP:    (row-1, col)\n      2: (0, -1),  # LEFT:  (row, col-1)\n      3: (1, 0)    # DOWN:  (row+1, col)\n  }\n\n  # Define how agent's direction changes when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # RIGHT -> UP -> LEFT -> DOWN -> RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT -> DOWN -> LEFT -> UP -> RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list for efficient NumPy array indexing in the walkability check.\n  non_walkable_indices = list(current_state.world.non_grabbable_indices)\n\n  # BFS initialization:\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state\n                      # where the primitive is directly in front of the agent.\n\n  while queue:\n      (current_pos, current_dir), path_so_far = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state.\n      # If so, we've found our target state, as the agent is adjacent and facing the primitive.\n      dr_front, dc_front = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + dr_front, c + dc_front\n      \n      # Ensure the cell in front is within grid boundaries\n      if 0 <= front_r < num_rows and 0 <= front_c < num_cols:\n          # Check if the primitive is present in this cell\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_so_far\n              break # Path found!\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # --- Try Move Forward ---\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction doesn't change when moving forward\n\n      # Check if the proposed next position is within grid boundaries\n      if (0 <= next_r < num_rows and 0 <= next_c < num_cols and\n          (next_pos, next_dir) not in visited): # Check if this (pos, dir) state has not been visited\n          \n          is_walkable = True\n          # Agent cannot walk onto the primitive itself (must interact from adjacent square)\n          if initial_grid[next_r, next_c, primitive_id] > 0:\n              is_walkable = False\n          # Agent cannot walk onto non-grabbable entities (e.g., boundaries, water, workshops)\n          elif non_walkable_indices and np.any(initial_grid[next_r, next_c, non_walkable_indices] > 0):\n              is_walkable = False\n          \n          if is_walkable:\n              visited.add((next_pos, next_dir))\n              queue.append(((next_pos, next_dir), path_so_far + [MOVE_FORWARD_ACTION]))\n\n      # --- Try Turn Left ---\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_so_far + [TURN_LEFT_ACTION]))\n\n      # --- Try Turn Right ---\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_so_far + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent-and-facing state was found,\n  # extend the actions list with that path and append the final USE action.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:48:02.336728", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's initial position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Determine grid dimensions\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve action mapping from the environment\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction vectors (dr, dc) for agent's facing direction\n  # (dr, dc) indicates how row and column change when moving \"forward\"\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: (row, col+1)\n      1: (-1, 0),  # Facing UP: (row-1, col)\n      2: (0, -1),  # Facing LEFT: (row, col-1)\n      3: (1, 0)    # Facing DOWN: (row+1, col)\n  }\n\n  # Mapping for updating agent's direction when turning left or right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # Convert the set to a list once for efficient NumPy array indexing.\n  non_walkable_kinds_indices = list(current_state.world.non_grabbable_indices)\n  \n  # BFS initialization:\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach the state where the primitive is in front\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Check if the primitive is directly in front of the agent from the current state\n      # If so, we've found a path to be adjacent and facing the primitive, so we can collect it with USE.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # Check if the primitive is in this cell. If yes, we've found our target adjacent state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Path found! The agent is positioned adjacent to and facing the primitive.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction does not change when moving forward\n\n      # Check if the next position is within bounds\n      if not (0 <= next_r < num_rows and 0 <= next_c < num_cols):\n          continue # Skip this path, it's out of bounds\n\n      # Check if this (position, direction) state has already been visited\n      if (next_pos, next_dir) in visited:\n          continue # Skip, already found a shorter/equal path\n\n      # Agent cannot walk onto the primitive itself, as interaction (USE) is from an adjacent square.\n      if initial_grid[next_r, next_c, primitive_id] > 0:\n          continue # Cannot walk onto the primitive\n\n      # Check if the next cell contains any non-walkable entity (e.g., BOUNDARY, WATER, WORKSHOP_X)\n      # np.any is efficient for checking if any of the specified kinds are present.\n      # If non_walkable_kinds_indices is empty, initial_grid slice will be empty, and np.any will return False, which is correct.\n      if np.any(initial_grid[next_r, next_c, non_walkable_kinds_indices] > 0):\n          continue # Cannot walk onto non-walkable entities\n\n      # If all checks pass, it's a valid and unvisited walkable cell for moving forward\n      visited.add((next_pos, next_dir))\n      queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning only changes direction, not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target adjacent state was found, append the USE action to complete the collection\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:49:46.915893", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory_tuple is crucial as agent capabilities can change with acquired items\n  # (e.g., picking up a tool makes new interactions possible).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in very large or complex state spaces,\n  # especially when many inventory variations might be possible for a given position/direction.\n  # This value is increased slightly from previous versions to allow for potentially deeper searches\n  # in more complex scenarios involving chained tool acquisition or longer paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:49:48.869684", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory_tuple is crucial as agent capabilities can change with acquired items\n  # (e.g., picking up a tool makes new interactions possible).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in very large or complex state spaces,\n  # especially when many inventory variations might be possible for a given position/direction.\n  # Increasing the multiplier from 20 to 30 allows for a deeper search for longer paths,\n  # potentially finding solutions in more complex scenarios involving intermediate tool collection.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # IMPROVEMENT for collect_v2: Be more specific about when to explore the general USE action.\n    # Only explore if USE resulted in:\n    # 1. An increase in count of any grabbable item in inventory (e.g., picking up a tool).\n    # 2. A change in position or direction (e.g., using a portal or a door).\n    \n    inventory_increased_any_grabbable = False\n    for grab_idx in world.grabbable_indices:\n        if state_after_current_use.inventory[grab_idx] > inventory_before_any_use[grab_idx]:\n            inventory_increased_any_grabbable = True\n            break\n            \n    position_or_direction_changed = (\n        state_after_current_use.pos != state.pos or \n        state_after_current_use.dir != state.dir\n    )\n\n    if inventory_increased_any_grabbable or position_or_direction_changed:\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:50:50.285860", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  Returns a sequence of actions to navigate to and collect a specified primitive.\n  This function employs a Breadth-First Search (BFS) to discover the shortest\n  sequence of actions (moving forward, turning left, turning right) that will\n  lead the agent to a position from which the target primitive can be collected\n  via a 'USE' action.\n\n  The pathfinding logic meticulously considers environmental constraints,\n  including grid boundaries and various types of impassable terrain (such as\n  non-grabbable entities like boundaries or workshops, and even the primitive\n  itself if it's a grabbable resource that cannot be walked upon directly).\n\n  Args:\n      env (env.CraftLab): The current CraftLab environment instance. This object\n                          provides critical information about the simulation state,\n                          including the grid layout, the agent's current position\n                          and orientation, and the world's configuration (e.g.,\n                          item indices, definitions of obstacles).\n      primitive (str): The string identifier for the primitive item that needs\n                       to be collected (e.g., \"WOOD\", \"STONE\", \"GOLD\"). This\n                       string must correspond to a valid primitive type recognized\n                       by the environment's cookbook.\n\n  Returns:\n      List[int]: A list containing integer action codes (as retrieved from\n                 `env.action_specs()`). When executed sequentially, these actions\n                 will guide the agent to successfully collect the specified\n                 primitive. An empty list is returned if the primitive is either\n                 not present on the map or is currently unreachable due to obstacles.\n  \"\"\"\n  # 1. Retrieve current environment state and static world data\n  current_craft_state = env._current_state\n  initial_grid = current_craft_state.grid  # Use the grid as it was at the start for pathfinding\n  initial_agent_pos = current_craft_state.pos  # Agent's starting (row, col) tuple\n  initial_agent_dir = current_craft_state.dir  # Agent's starting direction (0:Right, 1:Up, 2:Left, 3:Down)\n\n  # Get the unique integer ID for the primitive from the world's cookbook index\n  primitive_kind_id = current_craft_state.world.cookbook.index[primitive]\n\n  # Extract grid dimensions for boundary checks. grid.shape is (num_rows, num_cols, num_kinds)\n  grid_num_rows, grid_num_cols, _ = initial_grid.shape\n\n  # 2. Map symbolic actions from the DSL to their corresponding integer codes\n  action_code_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_code_map['UP']      # In CraftWorld, 'UP' means move forward in current direction\n  ACTION_TURN_LEFT = action_code_map['LEFT']\n  ACTION_TURN_RIGHT = action_code_map['RIGHT']\n  ACTION_USE = action_code_map['USE']              # Action to interact with/collect items\n\n  # 3. Define the agent's movement and turning mechanics based on direction\n  # This dictionary maps an agent's current direction to a (delta_row, delta_col) tuple\n  # representing the change in position when moving one step forward.\n  # Directions: 0=Right, 1=Up, 2=Left, 3=Down\n  DIRECTION_TO_DELTA_RC = {\n      0: (0, 1),   # Facing Right: (row, col+1)\n      1: (-1, 0),  # Facing Up:    (row-1, col)\n      2: (0, -1),  # Facing Left:  (row, col-1)\n      3: (1, 0)    # Facing Down:  (row+1, col)\n  }\n\n  # These maps define the agent's new direction after turning left or right.\n  TURN_LEFT_DIRECTION_MAP = {0: 1, 1: 2, 2: 3, 3: 0}   # Cycle: R -> U -> L -> D -> R\n  TURN_RIGHT_DIRECTION_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # Cycle: R -> D -> L -> U -> R\n\n  # 4. Determine which entity kinds are impassable for the agent during pathfinding\n  # Start with all entities marked as non-grabbable (e.g., water, walls, workshops).\n  impassable_entity_ids = set(current_craft_state.world.non_grabbable_indices)\n  \n  # Crucially, if the target primitive itself is a grabbable resource (e.g., WOOD, STONE),\n  # the agent cannot move *onto* its cell to collect it. It must be adjacent to it.\n  # Therefore, we add the primitive's ID to the set of impassable entities for pathfinding\n  # to ensure the BFS plans a path to an adjacent cell, not the cell occupied by the resource.\n  if primitive_kind_id in current_craft_state.world.grabbable_indices:\n      impassable_entity_ids.add(primitive_kind_id)\n  \n  # 5. Optimization: Immediate collection check\n  # If the primitive is already within the agent's 3x3 neighborhood, a single 'USE' action suffices.\n  # `CraftState.next_to()` efficiently performs this check.\n  if current_craft_state.next_to(primitive_kind_id):\n      return [ACTION_USE]\n\n  # 6. Breadth-First Search (BFS) Initialization\n  # The BFS queue stores tuples:\n  # ((agent_current_position_tuple, agent_current_direction_int), list_of_actions_to_reach_this_state)\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # The `visited_states` set keeps track of (position, direction) pairs that have\n  # already been explored. This prevents infinite loops in cyclic paths and\n  # ensures that the shortest path is found by avoiding redundant computations.\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  shortest_path_to_goal = None # This will store the action sequence once a valid path is found.\n\n  # 7. Main BFS Loop\n  while bfs_queue:\n      # Dequeue the current state and the path of actions leading to it\n      (current_pos, current_dir), actions_path_so_far = bfs_queue.popleft()\n      current_r, current_c = current_pos\n\n      # Check if the current agent position is suitable for collecting the primitive.\n      # This means the primitive must be present in any cell within the 3x3 square\n      # centered on the agent's current (row, col) position on the *initial grid*.\n      is_collectable_from_current_location = False\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              check_r, check_c = current_r + dr_offset, current_c + dc_offset\n              \n              # Ensure the cell being checked is within the grid boundaries\n              if (0 <= check_r < grid_num_rows and 0 <= check_c < grid_num_cols):\n                  # Check if the primitive exists at this specific cell on the initial grid\n                  if initial_grid[check_r, check_c, primitive_kind_id] > 0:\n                      is_collectable_from_current_location = True\n                      break # Found the primitive in the neighborhood, no need to check further offsets.\n          if is_collectable_from_current_location:\n              break # Break outer loop if primitive found.\n\n      if is_collectable_from_current_location:\n          shortest_path_to_goal = actions_path_so_far\n          break # Goal reached: Found the shortest path to a collectable position. Terminate BFS.\n\n      # Explore possible next actions: Move Forward, Turn Left, Turn Right\n\n      # Option A: Try moving one step Forward\n      delta_r_move, delta_c_move = DIRECTION_TO_DELTA_RC[current_dir]\n      next_r_after_move, next_c_after_move = current_r + delta_r_move, current_c + delta_c_move\n      next_pos_after_move = (next_r_after_move, next_c_after_move)\n      next_dir_after_move = current_dir # Direction remains unchanged after moving forward\n\n      # Check conditions for a valid forward move:\n      # 1. New position must be within grid boundaries.\n      # 2. The (new_position, new_direction) state must not have been visited.\n      # 3. The cell at `next_pos_after_move` must be walkable (not contain any impassable entities).\n      if (0 <= next_r_after_move < grid_num_rows and 0 <= next_c_after_move < grid_num_cols and\n          (next_pos_after_move, next_dir_after_move) not in visited_states):\n          \n          is_cell_walkable = True\n          for obstacle_id in impassable_entity_ids:\n              if initial_grid[next_r_after_move, next_c_after_move, obstacle_id] > 0:\n                  is_cell_walkable = False\n                  break # This cell contains an obstacle, so it's not walkable.\n          \n          if is_cell_walkable:\n              visited_states.add((next_pos_after_move, next_dir_after_move)) # Mark this new state as visited\n              # Add the new state and its corresponding action path to the queue\n              bfs_queue.append((\n                  (next_pos_after_move, next_dir_after_move),\n                  actions_path_so_far + [ACTION_MOVE_FORWARD]\n              ))\n\n      # Option B: Try turning Left\n      next_dir_after_left_turn = TURN_LEFT_DIRECTION_MAP[current_dir]\n      # Turning only changes direction; position remains the same.\n      if ((current_pos, next_dir_after_left_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_left_turn)) # Mark visited\n          bfs_queue.append((\n              (current_pos, next_dir_after_left_turn),\n              actions_path_so_far + [ACTION_TURN_LEFT]\n          ))\n\n      # Option C: Try turning Right\n      next_dir_after_right_turn = TURN_RIGHT_DIRECTION_MAP[current_dir]\n      # Turning only changes direction; position remains the same.\n      if ((current_pos, next_dir_after_right_turn) not in visited_states):\n          visited_states.add((current_pos, next_dir_after_right_turn)) # Mark visited\n          bfs_queue.append((\n              (current_pos, next_dir_after_right_turn),\n              actions_path_so_far + [ACTION_TURN_RIGHT]\n          ))\n\n  # 8. Assemble the final sequence of actions\n  final_action_sequence = []\n  if shortest_path_to_goal is not None:\n      # If a path was found, append all movement/turn actions\n      final_action_sequence.extend(shortest_path_to_goal)\n      # Then append the final 'USE' action to collect the primitive\n      final_action_sequence.append(ACTION_USE)\n\n  return final_action_sequence", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:50:51.410422", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function finds the shortest sequence of actions (movements, turns, and a final USE)\n  to collect a specified primitive in the CraftLab environment. It uses a Breadth-First Search (BFS)\n  to navigate the agent from its current position and orientation to a state where the primitive\n  is within its 3x3 interaction range.\n\n  Args:\n      env (env.CraftLab): The current CraftLab environment instance, providing access\n                          to the grid, agent's state, and world configuration.\n      primitive (str): The string name of the primitive item to be collected (e.g., \"WOOD\").\n\n  Returns:\n      List[int]: A list of integer action codes (from `env.action_specs()`) to execute.\n                 Returns an empty list if the primitive is not found or is unreachable.\n  \"\"\"\n  actions_sequence = []\n\n  # Get the initial state of the environment for pathfinding.\n  current_craft_state = env._current_state\n  initial_grid = current_craft_state.grid\n  initial_agent_pos = current_craft_state.pos  # (row, col)\n  initial_agent_dir = current_craft_state.dir  # 0:Right, 1:Up, 2:Left, 3:Down\n\n  # Map the primitive name to its integer ID.\n  primitive_id = current_craft_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions.\n  GRID_ROWS, GRID_COLS, _ = initial_grid.shape\n\n  # Map action names to their integer IDs.\n  action_map = env.action_specs()\n  ACTION_MOVE_FORWARD = action_map['UP']\n  ACTION_TURN_LEFT = action_map['LEFT']\n  ACTION_TURN_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each direction.\n  # (Direction ID) -> (delta_row, delta_col)\n  DIR_TO_DELTA_RC = {\n      0: (0, 1),   # Right\n      1: (-1, 0),  # Up\n      2: (0, -1),  # Left\n      3: (1, 0)    # Down\n  }\n\n  # Define new direction after turns.\n  TURN_LEFT_DIR_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_DIR_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Determine blocking entities for pathfinding.\n  # These are entities the agent cannot move onto.\n  blocking_entities_ids = set(current_craft_state.world.non_grabbable_indices)\n  if primitive_id in current_craft_state.world.grabbable_indices:\n      # If the target primitive is grabbable (like wood, stone), the agent must\n      # interact from an adjacent cell, not move onto its cell.\n      blocking_entities_ids.add(primitive_id)\n  \n  # --- Optimization: Check if primitive is already collectible from current position ---\n  # `next_to` checks the 3x3 neighborhood of the agent's current position.\n  if current_craft_state.next_to(primitive_id):\n      return [ACTION_USE]\n\n  # --- BFS Initialization ---\n  # Queue stores ( (agent_pos_tuple, agent_dir_int), list_of_actions_to_reach_this_state )\n  bfs_queue = collections.deque([((initial_agent_pos, initial_agent_dir), [])])\n  \n  # Visited set to prevent cycles and ensure shortest path. Stores (position_tuple, direction_int).\n  visited_states = {(initial_agent_pos, initial_agent_dir)}\n\n  shortest_path_to_goal = None # Will store the action sequence if a path is found.\n\n  # --- BFS Loop ---\n  while bfs_queue:\n      (current_pos, current_dir), path_so_far = bfs_queue.popleft()\n      r, c = current_pos\n\n      # --- Goal Check: Can the primitive be collected from the current (r, c) position? ---\n      # Check the 3x3 neighborhood of the current agent position on the *initial grid*.\n      is_collectible_here = False\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              check_r, check_c = r + dr_offset, c + dc_offset\n              if (0 <= check_r < GRID_ROWS and 0 <= check_c < GRID_COLS and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectible_here = True\n                  break # Primitive found in neighborhood\n          if is_collectible_here:\n              break\n\n      if is_collectible_here:\n          shortest_path_to_goal = path_so_far\n          break # Shortest path found, terminate BFS.\n\n      # --- Explore Neighbors (possible actions) ---\n\n      # 1. Try moving forward\n      dr_move, dc_move = DIR_TO_DELTA_RC[current_dir]\n      next_r_move, next_c_move = r + dr_move, c + dc_move\n      next_pos_move = (next_r_move, next_c_move)\n      next_dir_move = current_dir # Direction doesn't change\n\n      if (0 <= next_r_move < GRID_ROWS and 0 <= next_c_move < GRID_COLS and\n          (next_pos_move, next_dir_move) not in visited_states):\n          \n          is_cell_walkable = True\n          for obstacle_id in blocking_entities_ids:\n              if initial_grid[next_r_move, next_c_move, obstacle_id] > 0:\n                  is_cell_walkable = False\n                  break\n          \n          if is_cell_walkable:\n              visited_states.add((next_pos_move, next_dir_move))\n              bfs_queue.append((\n                  (next_pos_move, next_dir_move),\n                  path_so_far + [ACTION_MOVE_FORWARD]\n              ))\n\n      # 2. Try turning left\n      next_dir_left = TURN_LEFT_DIR_MAP[current_dir]\n      if (current_pos, next_dir_left) not in visited_states:\n          visited_states.add((current_pos, next_dir_left))\n          bfs_queue.append((\n              (current_pos, next_dir_left),\n              path_so_far + [ACTION_TURN_LEFT]\n          ))\n\n      # 3. Try turning right\n      next_dir_right = TURN_RIGHT_DIR_MAP[current_dir]\n      if (current_pos, next_dir_right) not in visited_states:\n          visited_states.add((current_pos, next_dir_right))\n          bfs_queue.append((\n              (current_pos, next_dir_right),\n              path_so_far + [ACTION_TURN_RIGHT]\n          ))\n\n  # --- Finalize Action Sequence ---\n  if shortest_path_to_goal is not None:\n      actions_sequence.extend(shortest_path_to_goal)\n      actions_sequence.append(ACTION_USE) # Append the 'USE' action to collect the primitive.\n\n  return actions_sequence", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:51:47.453390", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:51:48.662279", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOW\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # **Improvement for v2: Check if the primitive is grabbable.**\n  # The 'collect' function implies picking up an item into inventory.\n  # If the primitive is an entity that cannot be picked up (e.g., WORKSHOP, WATER, BOUNDARY),\n  # it cannot be \"collected\". In such cases, return an empty list immediately.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # Retrieve action mapping from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs implies moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This helps calculate the next position when moving forward or checking the cell in front\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: +1 to column (c)\n      1: (-1, 0),  # Facing UP: -1 to row (r)\n      2: (0, -1),  # Facing LEFT: -1 to column (c)\n      3: (1, 0)    # Facing DOWN: +1 to row (r)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Determine obstacles for agent movement\n  # This includes non-grabbable entities (e.g., BOUNDARY, WATER, WORKSHOP_X)\n  # and the primitive itself if it's a grabbable item (as agent interacts from adjacent cell)\n  obstacles_to_movement_indices = set(current_state.world.non_grabbable_indices)\n  if primitive_id in current_state.world.grabbable_indices:\n      obstacles_to_movement_indices.add(primitive_id) # Agent cannot walk ONTO the item it wants to collect.\n\n  # --- Nested Helper Functions for Readability ---\n  def _is_cell_walkable(r, c):\n      \"\"\"Checks if a given grid cell (r, c) is walkable for the agent.\"\"\"\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False  # Out of bounds\n\n      # Check if the cell contains any obstacle\n      for kind_idx in obstacles_to_movement_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False  # Contains an obstacle\n      return True\n\n  def _is_primitive_in_front_of_agent(agent_r, agent_c, agent_dir):\n      \"\"\"Checks if the target primitive is in the cell directly in front of the agent given its position and direction.\"\"\"\n      dr, dc = DIR_TO_DRDC[agent_dir]\n      front_r, front_c = agent_r + dr, agent_c + dc\n      \n      # Check if the cell in front is within bounds and contains the primitive\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n          initial_grid[front_r, front_c, primitive_id] > 0):\n          return True\n      return False\n  # --- End of Nested Helper Functions ---\n\n  # Optimization: If the primitive is already in front of the agent's initial position and direction,\n  # no pathfinding is needed; just use the item.\n  if _is_primitive_in_front_of_agent(initial_pos[0], initial_pos[1], initial_dir):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS)\n  # Queue stores ( (current_position_tuple, current_direction_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable state\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # Check if the current state (position and direction) is a \"goal\" state for collection.\n      # A goal state means the primitive is directly in front of the agent's current (r, c) and direction.\n      if _is_primitive_in_front_of_agent(r, c, current_dir):\n          target_path = path_actions # Path to reach this collectable state\n          break # Shortest path found, terminate BFS\n\n      # Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right\n\n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction\n\n      # Only add to queue if the next cell is walkable and this state hasn't been visited\n      if _is_cell_walkable(next_r, next_c) and\\\n         (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position and orientation was found, append the USE action.\n  # If no path is found (target_path remains None), an empty list is returned.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:53:02.862184", "function_name": "collect", "function_body": "  current_state = env._current_state\n  primitive_id = current_state.world.cookbook.index[primitive] # Get integer ID for the primitive\n\n  # Get grid dimensions from the current state.\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_pos = current_state.pos\n\n  # Get action mappings from the environment for robustness.\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define possible moves as (row_change, col_change) -> action, used in BFS.\n  move_deltas_actions = [\n      ((1, 0), DOWN),\n      ((-1, 0), UP),\n      ((0, 1), RIGHT),\n      ((0, -1), LEFT)\n  ]\n\n  # --- Pre-Checks ---\n\n  # 1. Verify if the specified primitive is actually a grabbable item (can be picked up).\n  # If it's an environmental feature like BOUNDARY, WATER, or a WORKSHOP, it cannot be 'collected'\n  # into the inventory via a USE action, so no actions are returned.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return [] # Not a collectible primitive, so return an empty list of actions.\n\n  # Helper function to manually check if a given position (r, c) is adjacent to or on the target primitive.\n  # This function effectively mimics `CraftState.next_to()` but operates directly on the grid\n  # and avoids the overhead of creating temporary `CraftState` objects.\n  # It checks the 3x3 neighborhood, including the center cell (the agent's current position).\n  def is_adjacent_or_on_primitive(r, c):\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              nr_adj, nc_adj = r + dr_adj, c + dc_adj\n              # Ensure the coordinate being checked is within grid boundaries.\n              if 0 <= nr_adj < WIDTH and 0 <= nc_adj < HEIGHT:\n                  # If the primitive exists at this neighboring (or current) cell, it's considered adjacent.\n                  if grid[nr_adj, nc_adj, primitive_id] == 1:\n                      return True\n      return False\n  \n  # 2. Check if the agent is already at a position from which the primitive can be collected.\n  # If the agent is already adjacent to or on the primitive, a single 'USE' action is sufficient.\n  # This is only done if the primitive is grabbable (checked in step 1).\n  if is_adjacent_or_on_primitive(start_pos[0], start_pos[1]):\n      return [USE]\n\n  # --- Pathfinding (Breadth-First Search - BFS) ---\n\n  # The queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_this_pos]).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of (row, col) positions already explored\n  # to prevent cycles and redundant pathfinding.\n  visited = {start_pos} \n\n  best_path_actions = [] # This will store the shortest sequence of movement actions.\n  found_primitive_adjacent = False # Flag to indicate if a suitable position was found.\n\n  while q:\n      (curr_r, curr_c), actions_so_far = q.popleft() # Dequeue the current position and path to it.\n\n      # Check if the current cell (curr_r, curr_c) is a suitable target (adjacent to/on the primitive).\n      # If it is, we've found the shortest path to a collection point.\n      if is_adjacent_or_on_primitive(curr_r, curr_c):\n          best_path_actions = actions_so_far # Store the movement actions found.\n          found_primitive_adjacent = True\n          break # Exit the BFS loop, as the optimal path has been determined.\n\n      # Explore all valid, traversable, and unvisited neighboring cells.\n      for (dr, dc), action_val in move_deltas_actions:\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos = (next_r, next_c)\n\n          # Boundary check: Ensure the next position is within the grid limits.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n          \n          # Traversability check: Ensure the next position is not an obstacle.\n          # Obstacles are entities that cannot be moved into (e.g., BOUNDARY, WATER, some WORKSHOP types).\n          is_traversable = True\n          for i_kind in current_state.world.non_grabbable_indices:\n              if grid[next_r, next_c, i_kind] == 1: # If the cell contains a non-traversable item.\n                  is_traversable = False\n                  break # This neighbor is an obstacle, so it cannot be moved into.\n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # If the neighbor position has not been visited yet, add it to the queue\n          # with the updated path, and mark it as visited.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = actions_so_far + [action_val]\n              q.append((next_pos, new_path))\n    \n  # --- Action Compilation ---\n\n  final_actions = best_path_actions\n\n  # If a path to an adjacent cell was found during BFS, append the 'USE' action.\n  # We do not need to re-check `is_grabbable` here, as it was confirmed in an earlier pre-check.\n  if found_primitive_adjacent:\n      final_actions.append(USE)\n  \n  return final_actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:53:03.964355", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  \n  # Get the integer ID for the target primitive.\n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action constants from the environment for robustness.\n  ACTION_MAP = env.action_specs()\n  UP = ACTION_MAP['UP']\n  DOWN = ACTION_MAP['DOWN']\n  LEFT = ACTION_MAP['LEFT']\n  RIGHT = ACTION_MAP['RIGHT']\n  USE = ACTION_MAP['USE']\n\n  # Define movement deltas and corresponding actions.\n  move_deltas_actions = [\n      ((1, 0), DOWN),\n      ((-1, 0), UP),\n      ((0, 1), RIGHT),\n      ((0, -1), LEFT)\n  ]\n\n  # --- Pre-Checks ---\n\n  # 1. If the primitive is not a \"grabbable\" item, it cannot be collected into inventory.\n  # The 'collect' function implies picking up an item. If it's a non-grabbable\n  # entity like a workshop or water, no actions can \"collect\" it.\n  if primitive_id not in current_state.world.grabbable_indices:\n      return []\n\n  # 2. Check if the agent is already adjacent to the primitive.\n  # If so, a single 'USE' action is sufficient to attempt collection.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # --- Pathfinding (BFS) ---\n\n  # Queue stores tuples: ((current_row, current_col), [list_of_actions_to_reach_this_pos]).\n  q = collections.deque([(start_pos, [])]) \n  # 'visited' set keeps track of (row, col) positions already explored to prevent cycles.\n  visited = {start_pos} \n\n  best_path_actions = [] # This will store the shortest path found to an adjacent cell.\n  found_primitive_adjacent = False\n\n  while q:\n      (curr_r, curr_c), actions_so_far = q.popleft() \n\n      # Create a temporary CraftState instance to leverage its `next_to` method.\n      # This allows efficiently checking if the current hypothetical position (curr_r, curr_c)\n      # is adjacent to the target primitive.\n      temp_state_for_check = craft.CraftState(\n          scenario=current_state.scenario,\n          grid=grid,\n          pos=(curr_r, curr_c),\n          dir=current_state.dir, # Direction/inventory don't affect `next_to` logic.\n          inventory=current_state.inventory\n      )\n\n      # If the current BFS position is adjacent to the primitive, we have found a path.\n      if temp_state_for_check.next_to(primitive_id):\n          best_path_actions = actions_so_far\n          found_primitive_adjacent = True\n          break # Exit BFS, as we've found the shortest path to an adjacent cell.\n\n      # Explore valid neighboring cells (up, down, left, right).\n      for (dr, dc), action_val in move_deltas_actions:\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos = (next_r, next_c)\n\n          # 1. Boundary check: Ensure the new position is within the grid limits.\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n          \n          # 2. Traversability check: Ensure the new position is not an obstacle.\n          # Obstacles are non-grabbable items that block movement.\n          is_traversable = True\n          for i_kind in current_state.world.non_grabbable_indices:\n              # If the new cell contains any non-grabbable item, it's an obstacle.\n              if grid[next_r, next_c, i_kind] == 1: \n                  is_traversable = False\n                  break \n          \n          if not is_traversable:\n              continue # Skip this neighbor if it's an obstacle.\n          \n          # 3. Visited check: If the neighbor position has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = actions_so_far + [action_val]\n              q.append((next_pos, new_path))\n    \n  # --- Action Compilation ---\n\n  # If a path to an adjacent cell was found during BFS:\n  final_actions = best_path_actions\n\n  # Since we already confirmed the primitive is grabbable in the pre-check,\n  # if we found a path to an adjacent cell, the final step is always to USE.\n  if found_primitive_adjacent:\n      final_actions.append(USE)\n  \n  return final_actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:54:14.838543", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the string name of the primitive to its integer ID using the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1].\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # This maps an agent's direction (0=R, 1=U, 2=L, 3=D) to the (delta_row, delta_column)\n  # for moving \"forward\".\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      1: (-1, 0),  # Facing UP: moves to (row-1, col)\n      2: (0, -1),  # Facing LEFT: moves to (row, col-1)\n      3: (1, 0)    # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction (clockwise order for turns).\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # RIGHT->UP->LEFT->DOWN->RIGHT\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # RIGHT->DOWN->LEFT->UP->RIGHT\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are entities the agent cannot occupy a cell with.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Helper function to determine if the agent can move into a specific cell (r, c).\n  # A cell is walkable if it's within bounds and does not contain any non-walkable\n  # entities, including the primitive itself (as the agent needs to be adjacent to collect).\n  def _is_walkable_for_agent(r: int, c: int) -> bool:\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      # These are typically static obstacles like boundaries, water, or workshops.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Crucially, the agent cannot move *into* the cell occupied by the primitive it wants to collect.\n      # Collection (via 'USE' action) happens from an adjacent cell.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # Initialize Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples to prevent\n  # re-exploring states already visited, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Determine if the primitive is directly in front of the agent from the current state.\n      # This is the target condition: being adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 2. Explore possible next actions from the current state: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # If the next cell is walkable and this specific (position, direction) state has not been visited,\n      # add it to the queue for future exploration.\n      if _is_walkable_for_agent(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_left) not in visited:\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Position does not change when turning.\n      if (current_pos, next_dir_right) not in visited:\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:54:16.046278", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest sequence of actions to\n  navigate to a specified primitive and collect it using the 'USE' action.\n  \n  This function implements a Breadth-First Search (BFS) to find the optimal\n  sequence of movements and turns that places the agent directly in front of\n  the target primitive, followed by a 'USE' action to collect it.\n  \n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The string name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\", \"GRASS\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., UP, LEFT, USE) that, when executed,\n                 will lead to the collection of the primitive. Returns an empty list\n                 if the primitive is unreachable from the current state.\n  \"\"\"\n  # --- 1. Initial State and Environment Setup ---\n  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # Agent's starting position (row, col)\n  initial_dir = current_state.dir # Agent's initial facing direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the string name of the primitive to its integer ID using the cookbook's index.\n  primitive_id = current_state.world.cookbook.index[primitive]\n  \n  # Get grid dimensions: num_rows corresponds to grid.shape[0], num_cols to grid.shape[1].\n  num_rows, num_cols, _ = initial_grid.shape\n\n  # Retrieve numerical action codes from the environment's action_specs.\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP'] # 'UP' in action_specs maps to agent moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define constants for agent directions (standardized for clarity)\n  DIR_RIGHT = 0\n  DIR_UP = 1\n  DIR_LEFT = 2\n  DIR_DOWN = 3\n\n  # Define how movement changes row/column based on the agent's current direction.\n  # Maps agent's direction (0=R, 1=U, 2=L, 3=D) to (delta_row, delta_column) for moving \"forward\".\n  DIR_TO_DELTA = {\n      DIR_RIGHT: (0, 1),   # Facing RIGHT: moves to (row, col+1)\n      DIR_UP: (-1, 0),     # Facing UP: moves to (row-1, col)\n      DIR_LEFT: (0, -1),   # Facing LEFT: moves to (row, col-1)\n      DIR_DOWN: (1, 0)     # Facing DOWN: moves to (row+1, col)\n  }\n\n  # Define how turns update the agent's direction (clockwise order for turns).\n  TURN_LEFT_MAP = {\n      DIR_RIGHT: DIR_UP,\n      DIR_UP: DIR_LEFT,\n      DIR_LEFT: DIR_DOWN,\n      DIR_DOWN: DIR_RIGHT\n  }\n  TURN_RIGHT_MAP = {\n      DIR_RIGHT: DIR_DOWN,\n      DIR_UP: DIR_RIGHT,\n      DIR_LEFT: DIR_UP,\n      DIR_DOWN: DIR_LEFT\n  }\n\n  # Get indices of entities that block agent movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are entities the agent cannot occupy a cell with.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- 2. Helper Function for Walkability Check ---\n  def _is_walkable_for_agent(r: int, c: int) -> bool:\n      \"\"\"Checks if a given grid cell (r, c) is walkable for the agent.\n      A cell is walkable if it's within bounds and does not contain any non-walkable\n      entities, nor the specific primitive the agent is currently trying to collect.\n      The agent must be adjacent to the primitive, not occupying its cell.\n      \"\"\"\n      # Check if coordinates are within the grid boundaries.\n      if not (0 <= r < num_rows and 0 <= c < num_cols):\n          return False\n      \n      # Check if the cell contains any entity that explicitly blocks agent movement.\n      # This includes environment features like boundaries, water, or workshops.\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Crucially, the agent cannot move into the cell *occupied by* the primitive\n      # it wants to collect. It must be adjacent to it and use the 'USE' action.\n      # This prevents paths that walk directly over the collectible item.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n\n  # --- 3. Breadth-First Search (BFS) Implementation ---\n  # The queue stores tuples: ((agent_position_tuple, agent_direction_int), list_of_actions_taken_so_far).\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (agent_position_tuple, agent_direction_int) tuples to prevent\n  # re-exploring states already visited, ensuring the shortest path is found.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the optimal action sequence to reach the pre-collection state.\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 3.1. Goal Check: Determine if the primitive is directly in front of the agent.\n      # This is the target condition: being adjacent to and facing the primitive, ready to 'USE'.\n      front_dr, front_dc = DIR_TO_DELTA[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the cell in front is within grid boundaries before checking its contents.\n      if (0 <= front_r < num_rows and 0 <= front_c < num_cols):\n          # If the primitive is present in the cell directly in front, we have found our target state.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path = path_actions\n              break # Shortest path found, exit the BFS loop.\n\n      # 3.2. Explore possible next actions: Move Forward, Turn Left, Turn Right.\n\n      # Try Moving Forward (Action: MOVE_FORWARD_ACTION)\n      move_dr, move_dc = DIR_TO_DELTA[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Direction remains unchanged when moving forward.\n\n      # If the next cell is walkable and this specific (position, direction) state has not been visited,\n      # add it to the queue for future exploration.\n      if _is_walkable_for_agent(next_r, next_c) and (next_pos, next_dir) not in visited:\n          visited.add((next_pos, next_dir))\n          queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turning Left (Action: TURN_LEFT_ACTION)\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      next_pos_left = current_pos # Position does not change when turning.\n\n      # If this (position, new_direction) state has not been visited, add it to the queue.\n      if (next_pos_left, next_dir_left) not in visited:\n          visited.add((next_pos_left, next_dir_left))\n          queue.append(((next_pos_left, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turning Right (Action: TURN_RIGHT_ACTION)\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      next_pos_right = current_pos # Position does not change when turning.\n\n      # If this (position, new_direction) state has not been visited, add it to the queue.\n      if (next_pos_right, next_dir_right) not in visited:\n          visited.add((next_pos_right, next_dir_right))\n          queue.append(((next_pos_right, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # --- 4. Final Action Sequence Construction ---\n  # If a path to the target pre-collection state was found (i.e., target_path is not None),\n  # append the final 'USE' action to complete the collection process.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION) # Add the crucial 'USE' action to collect the primitive.\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:55:34.731721", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # `visited` set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  visited = set()\n  # `came_from` dictionary for efficient path reconstruction (avoids costly list copies).\n  came_from = {} # Maps state_key -> (previous_state_key, action_taken_to_reach_current_state)\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  initial_state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple)\n  \n  # The queue stores the CraftState object and its unique key.\n  q.append((current_state, initial_state_key))\n  visited.add(initial_state_key)\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    # Dequeue the current state and its unique key.\n    state, current_state_key = q.popleft() \n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      return [] # No path found within limits.\n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_before_use = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    _, temp_state_before_use = temp_state_before_use.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_before_use.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_before_use.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    # Path reconstruction:\n                    final_path = []\n                    temp_key = current_state_key\n                    # Reconstruct path by tracing back from the current state key to the initial state key.\n                    while temp_key != initial_state_key:\n                        prev_key, action = came_from[temp_key]\n                        final_path.insert(0, action) # Insert at the beginning to build path in correct order\n                        temp_key = prev_key\n                    return final_path + turns_to_face + [USE_ACT]\n\n    # Explore possible actions: movements and general USE.\n    # The general USE action is important if using an item (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    actions_to_consider = move_actions + [USE_ACT]\n    \n    for action in actions_to_consider:\n        _, next_state = state.step(action) # CraftState.step returns a new state object\n        \n        next_inventory_tuple = tuple(next_state.inventory)\n        next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            came_from[next_state_key] = (current_state_key, action)\n            q.append((next_state, next_state_key))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:55:36.729391", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n\n  # 1. Get the primitive's integer ID from the cookbook.\n  try:\n    i_kind = world.cookbook.index[primitive.lower()]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it.\n  if current_state.inventory[i_kind] > 0:\n      return []\n\n  # 3. Semantic check: Determine if this primitive is generally collectible via the 'USE' action.\n  # This includes items that can be picked up (grabbable) and specific resources like water or stone.\n  # Items like workshops, boundaries, or bridges are typically not \"collected\" into inventory.\n  is_collectible_via_use = (\n      i_kind in world.grabbable_indices or \n      i_kind == world.water_index or \n      i_kind == world.stone_index\n  )\n  \n  # If the item is not generally collectible using 'USE', we don't proceed with BFS.\n  if not is_collectible_via_use:\n    return []\n\n  # 4. Define action integers and direction deltas for movement and interaction.\n  action_map = env.action_specs()\n  UP_ACT = action_map[\"UP\"]\n  DOWN_ACT = action_map[\"DOWN\"]\n  LEFT_ACT = action_map[\"LEFT\"]\n  RIGHT_ACT = action_map[\"RIGHT\"]\n  USE_ACT = action_map[\"USE\"]\n\n  move_actions = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # _DIR_TO_DELTA_FRONT maps the agent's integer direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  # to the (row_change, col_change) needed to find the cell directly in front of the agent.\n  _DIR_TO_DELTA_FRONT = {\n      0: (-1, 0), # UP: row - 1, col (moves North)\n      1: (0, 1),  # RIGHT: row, col + 1 (moves East)\n      2: (1, 0),  # DOWN: row + 1, col (moves South)\n      3: (0, -1)  # LEFT: row, col - 1 (moves West)\n  }\n\n  # Helper function to calculate the shortest sequence of turning actions\n  # to face a target direction from the current direction.\n  def _get_turning_actions(current_dir: int, target_dir: int) -> list[int]:\n      if current_dir == target_dir:\n          return [] # Already facing the target direction\n      \n      # Calculate the difference in directions, handling circularity (0-3).\n      # Adding 4 and taking modulo 4 ensures a positive difference.\n      diff = (target_dir - current_dir + 4) % 4\n      \n      if diff == 1: # Target is one step clockwise (e.g., UP(0) -> RIGHT(1))\n          return [RIGHT_ACT]\n      elif diff == 3: # Target is one step counter-clockwise (e.g., UP(0) -> LEFT(3))\n          return [LEFT_ACT]\n      else: # diff == 2, implies a 180-degree turn (e.g., UP(0) -> DOWN(2))\n          # Two consecutive right or left turns will achieve this.\n          return [RIGHT_ACT, RIGHT_ACT] # Arbitrarily choose RIGHT_ACT twice\n\n  # 5. Initialize Breadth-First Search (BFS).\n  q = collections.deque()\n  # The 'visited' set tracks previously explored states to avoid cycles and redundant computation.\n  # A state is defined by (agent_row, agent_col, agent_direction, inventory_tuple).\n  # The inventory_tuple is crucial as agent capabilities can change with acquired items\n  # (e.g., picking up a tool makes new interactions possible).\n  visited = set()\n\n  # Start BFS from the current environment state.\n  initial_inventory_tuple = tuple(current_state.inventory)\n  q.append((current_state, []))\n  visited.add((current_state.pos[0], current_state.pos[1], current_state.dir, initial_inventory_tuple))\n\n  grid_width, grid_height, _ = current_state.grid.shape\n  # MAX_EXPLORED_STATES is a heuristic limit to prevent excessive search in very large or complex state spaces,\n  # especially when many inventory variations might be possible for a given position/direction.\n  # This value is increased slightly from previous versions to allow for potentially deeper searches\n  # in more complex scenarios involving chained tool acquisition or longer paths.\n  MAX_EXPLORED_STATES = grid_width * grid_height * 4 * 30 \n  explored_states_count = 0\n\n  # 6. BFS Loop.\n  while q:\n    state, path = q.popleft() # Dequeue the current state and the path to reach it\n    explored_states_count += 1\n\n    # Pruning: If we've explored too many distinct states, stop to prevent performance issues.\n    if explored_states_count > MAX_EXPLORED_STATES:\n      continue \n\n    current_r, current_c = state.pos\n    current_dir = state.dir\n    \n    # Goal Check: Can we collect the primitive from this `state`?\n    # This check specifically looks for the target primitive (`i_kind`) in the 3x3 neighborhood.\n    if state.next_to(i_kind):\n        for target_dir in range(4): # Iterate through possible agent orientations (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n            dr, dc = _DIR_TO_DELTA_FRONT[target_dir]\n            facing_r, facing_c = current_r + dr, current_c + dc\n\n            # Check if the cell directly in front contains the target primitive\n            if (0 <= facing_r < grid_width and 0 <= facing_c < grid_height and \n                state.grid[facing_r, facing_c, i_kind] == 1):\n                \n                # Simulate the turning actions to face the primitive.\n                turns_to_face = _get_turning_actions(current_dir, target_dir)\n                temp_state_after_turns = state \n                for turn_action in turns_to_face:\n                    # Apply each turn action to get the state after all turns.\n                    # Reward is ignored as we are pathfinding, not optimizing reward.\n                    _, temp_state_after_turns = temp_state_after_turns.step(turn_action)\n\n                # Store inventory before attempting USE to verify collection.\n                inventory_before_use = np.copy(temp_state_after_turns.inventory)\n\n                # Simulate the 'USE' action.\n                _, state_after_use = temp_state_after_turns.step(USE_ACT)\n\n                # Critical check: Did the count of the primitive in inventory actually increase?\n                # This verifies successful collection, accounting for any internal game rules\n                # (e.g., tools needed) implemented in `CraftState.step`).\n                if state_after_use.inventory[i_kind] > inventory_before_use[i_kind]:\n                    return path + turns_to_face + [USE_ACT]\n\n    # Explore possible movement actions:\n    for action in move_actions:\n      _, next_state = state.step(action)\n      next_inventory_tuple = tuple(next_state.inventory)\n      next_state_key = (next_state.pos[0], next_state.pos[1], next_state.dir, next_inventory_tuple)\n\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, path + [action]))\n    \n    # Explore the USE action from the current position generally.\n    # This is important if using an item at the current position (e.g., picking up a tool)\n    # can change the inventory state, which might be necessary for later steps to collect the primitive.\n    inventory_before_any_use = np.copy(state.inventory)\n    _, state_after_current_use = state.step(USE_ACT)\n    \n    # Check if the USE action resulted in a meaningful state change (inventory, position, or direction).\n    # This prevents adding redundant states to the queue if USE had no effect.\n    if not (np.array_equal(state_after_current_use.inventory, inventory_before_any_use) and\n            state_after_current_use.pos == state.pos and\n            state_after_current_use.dir == state.dir):\n\n        next_inventory_tuple = tuple(state_after_current_use.inventory)\n        next_state_key = (state_after_current_use.pos[0], state_after_current_use.pos[1], state_after_current_use.dir, next_inventory_tuple)\n\n        if next_state_key not in visited:\n            visited.add(next_state_key)\n            q.append((state_after_current_use, path + [USE_ACT]))\n\n  # 7. If the BFS queue is exhausted and no path to collect the primitive was found,\n  # it means the primitive is unreachable from the initial state given the current conditions.\n  return []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-01T07:56:26.500500", "function_name": "collect", "function_body": "  # Retrieve current state information\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir # Agent's direction: 0=RIGHT, 1=UP, 2=LEFT, 3=DOWN\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  if primitive_id is None: # Defensive check: primitive not found in index (shouldn't happen with valid DSL input)\n      return []\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  # Action mapping from env's action_specs\n  action_map = env.action_specs()\n  MOVE_FORWARD = action_map['UP'] # 'UP' action moves agent forward relative to its direction\n  TURN_LEFT = action_map['LEFT']\n  TURN_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define how agent's position changes for each direction it faces\n  # (dr, dc) = (row_change, col_change)\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (0): move in positive column direction\n      1: (-1, 0),  # Facing UP (1): move in negative row direction\n      2: (0, -1),  # Facing LEFT (2): move in negative column direction\n      3: (1, 0)    # Facing DOWN (3): move in positive row direction\n  }\n\n  # Define how agent's direction changes when turning\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # Right -> Up, Up -> Left, Left -> Down, Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down, Down -> Left, Left -> Up, Up -> Right\n\n  # Indices of entities that the agent cannot walk onto\n  non_walkable_indices = current_state.world.non_grabbable_indices\n\n  def _is_valid_coord(r, c):\n      \"\"\"Checks if a given coordinate (r, c) is within the grid bounds.\"\"\"\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  def _is_walkable_cell(r, c):\n      \"\"\"Checks if a cell (r, c) is traversable by the agent.\n      Agent cannot walk onto non-grabbable items or the target primitive itself.\n      \"\"\"\n      if not _is_valid_coord(r, c):\n          return False\n      \n      # Agent cannot walk onto non-grabbable items\n      for kind_idx in non_walkable_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent also cannot walk directly onto the primitive itself,\n      # as the goal is to be *adjacent* to it and use the 'USE' action.\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  def _is_target_adjacent_and_facing(pos_r, pos_c, current_dir):\n      \"\"\"Checks if the agent at (pos_r, pos_c) facing current_dir is in\n      a position to USE the primitive (i.e., the primitive is directly in front).\n      \"\"\"\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      target_r, target_c = pos_r + front_dr, pos_c + front_dc\n\n      if not _is_valid_coord(target_r, target_c):\n          return False # The cell directly in front is out of bounds\n      \n      # Check if the primitive exists in the cell directly in front of the agent\n      return initial_grid[target_r, target_c, primitive_id] > 0\n\n  # BFS State representation: ((row, col), direction)\n  # Queue stores: [ ( (current_r, current_c), current_dir ), [list_of_actions_taken_to_reach_here] ]\n  queue = collections.deque([(((initial_pos[0], initial_pos[1]), initial_dir), [])])\n  \n  # Visited set: { ((row, col), direction) } to prevent cycles and redundant exploration\n  visited = {((initial_pos[0], initial_pos[1]), initial_dir)}\n\n  path_to_primitive = None # This will store the shortest sequence of actions found\n\n  # Immediate check: Is the agent already positioned to collect the primitive?\n  if _is_target_adjacent_and_facing(initial_pos[0], initial_pos[1], initial_dir):\n      path_to_primitive = [] # No movement actions needed, just the USE action will follow\n\n  # Perform BFS if not already at the target\n  if path_to_primitive is None:\n      while queue:\n          (current_pos_tuple, current_dir), current_path_actions = queue.popleft()\n          current_r, current_c = current_pos_tuple\n\n          # Explore possible next actions: Move Forward, Turn Left, Turn Right\n          \n          # 1. Try Move Forward\n          move_dr, move_dc = DIR_TO_DRDC[current_dir]\n          next_r_fwd, next_c_fwd = current_r + move_dr, current_c + move_dc\n          next_dir_fwd = current_dir # Direction doesn't change on movement\n          \n          if _is_walkable_cell(next_r_fwd, next_c_fwd):\n              next_state_fwd = ((next_r_fwd, next_c_fwd), next_dir_fwd)\n              if next_state_fwd not in visited:\n                  visited.add(next_state_fwd)\n                  new_path_fwd = current_path_actions + [MOVE_FORWARD]\n                  \n                  if _is_target_adjacent_and_facing(next_r_fwd, next_c_fwd, next_dir_fwd):\n                      path_to_primitive = new_path_fwd\n                      break # Path to target found, break BFS\n                  \n                  queue.append((next_state_fwd, new_path_fwd))\n\n          # 2. Try Turn Left\n          next_dir_left = TURN_LEFT_MAP[current_dir]\n          next_state_left = ((current_r, current_c), next_dir_left) # Position doesn't change on turn\n          \n          if next_state_left not in visited:\n              visited.add(next_state_left)\n              new_path_left = current_path_actions + [TURN_LEFT]\n              \n              if _is_target_adjacent_and_facing(current_r, current_c, next_dir_left):\n                  path_to_primitive = new_path_left\n                  break # Path to target found, break BFS\n              \n              queue.append((next_state_left, new_path_left))\n\n          # 3. Try Turn Right\n          next_dir_right = TURN_RIGHT_MAP[current_dir]\n          next_state_right = ((current_r, current_c), next_dir_right) # Position doesn't change on turn\n          \n          if next_state_right not in visited:\n              visited.add(next_state_right)\n              new_path_right = current_path_actions + [TURN_RIGHT]\n              \n              if _is_target_adjacent_and_facing(current_r, current_c, next_dir_right):\n                  path_to_primitive = new_path_right\n                  break # Path to target found, break BFS\n              \n              queue.append((next_state_right, new_path_right))\n          \n          if path_to_primitive is not None: # If path was found in any of the above explorations\n              break # Exit outer BFS loop\n\n  # If a path was successfully found, append the 'USE' action to the sequence\n  if path_to_primitive is not None:\n      actions_list = path_to_primitive # Start with the actions to reach the target position and orientation\n      actions_list.append(USE_ACTION) # Add the final action to collect the primitive\n  else:\n      actions_list = [] # No path found to reach the primitive\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:56:27.688225", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir\n\n  primitive_id = current_state.world.cookbook.index[primitive]\n  # If the primitive is not found in the cookbook index, it cannot be collected.\n  if primitive_id is None: \n      return []\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT, move in positive column direction\n      1: (-1, 0),  # Facing UP, move in negative row direction\n      2: (0, -1),  # Facing LEFT, move in negative column direction\n      3: (1, 0)    # Facing DOWN, move in positive row direction\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}\n\n  # Indices of items that cannot be walked upon (e.g., water, workshops, stone)\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  def _is_target_state(pos, current_dir):\n      \"\"\"Checks if the given position and direction combination places the\n      primitive directly in front of the agent, ready to be \"used\" (collected).\n      \"\"\"\n      r, c = pos\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # Check bounds for the cell in front of the agent\n      if not (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          return False \n      \n      # Check if the cell in front contains the target primitive\n      return initial_grid[front_r, front_c, primitive_id] > 0\n\n  def _is_walkable_cell(pos):\n      \"\"\"Checks if the given cell (row, col) is traversable by the agent.\"\"\"\n      r, c = pos\n      # Check bounds for the cell itself\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # A cell is not walkable if it contains any non-grabbable entity,\n      # or if it contains the primitive itself (agent must stop adjacent to it).\n      for kind_idx in non_walkable_kinds_indices:\n          if initial_grid[r, c, kind_idx] > 0:\n              return False\n      \n      # Agent cannot walk onto the primitive it's trying to collect\n      if initial_grid[r, c, primitive_id] > 0:\n          return False\n          \n      return True\n  \n  def _get_possible_transitions(current_pos, current_dir):\n      \"\"\"Generates possible next states and actions from the current state.\"\"\"\n      transitions = []\n\n      # 1. Attempt to Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_pos[0] + move_dr, current_pos[1] + move_dc\n      next_pos_move = (next_r, next_c)\n      \n      if _is_walkable_cell(next_pos_move):\n          # State remains (pos, dir) after move: new_pos, same_dir\n          transitions.append(((next_pos_move, current_dir), MOVE_FORWARD_ACTION))\n\n      # 2. Attempt to Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # State remains (pos, dir) after turn: same_pos, new_dir\n      transitions.append(((current_pos, next_dir_left), TURN_LEFT_ACTION))\n\n      # 3. Attempt to Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # State remains (pos, dir) after turn: same_pos, new_dir\n      transitions.append(((current_pos, next_dir_right), TURN_RIGHT_ACTION))\n\n      return transitions\n\n  # BFS Initialization\n  # Queue stores ( (agent_position_tuple, agent_direction_int), list_of_actions_to_reach_here )\n  start_state_node = (initial_pos, initial_dir)\n  queue = collections.deque([(start_state_node, [])]) \n  # Visited set stores (agent_position_tuple, agent_direction_int) to prevent cycles and redundant paths\n  visited = {start_state_node}\n\n  target_path = None # This will store the shortest sequence of actions to reach the target state\n\n  # First, check if the agent is already in the target state (adjacent and facing the primitive)\n  if _is_target_state(initial_pos, initial_dir):\n      target_path = [] # No movement actions needed, just the USE action will follow\n\n  # If not immediately at the target, perform Breadth-First Search\n  if target_path is None:\n      while queue:\n          (current_pos, current_dir), path_actions = queue.popleft()\n\n          # Explore all possible transitions (moves/turns) from the current state\n          for (next_pos, next_dir), action_taken in _get_possible_transitions(current_pos, current_dir):\n              next_state_node = (next_pos, next_dir)\n              \n              # If this state has not been visited yet (to find the shortest path)\n              if next_state_node not in visited:\n                  visited.add(next_state_node)\n                  new_path_actions = path_actions + [action_taken]\n                  \n                  # Check if this new state is our target state\n                  if _is_target_state(next_pos, next_dir):\n                      target_path = new_path_actions\n                      break # Found the shortest path, exit the inner loop\n                  \n                  # Enqueue the new state to explore further\n                  queue.append((next_state_node, new_path_actions))\n          \n          if target_path is not None:\n              break # Found the shortest path, exit the outer BFS loop\n\n  # If a path to the target state was found, append the final USE action\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:57:16.389905", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    Refinements include:\n    - More robust handling of non-walkable cells, ensuring the agent never walks\n      onto a blocking entity, including the primitive it intends to collect\n      (unless the primitive itself is a workshop, etc., which are inherently\n      non-walkable).\n    - Consistency with efficient NumPy operations for checking cell occupancy.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state\n  \n  primitive_id = current_state.world.cookbook.index[primitive]\n\n  # Optimization: If the primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  initial_grid = current_state.grid\n  initial_pos = current_state.pos # tuple (r, c)\n  initial_dir = current_state.dir # int (0-3), 0:RIGHT, 1:UP, 2:LEFT, 3:DOWN\n\n  WIDTH, HEIGHT, _ = initial_grid.shape\n\n  action_map = env.action_specs()\n  # Map DSL movement/turn actions to their integer indices from action_specs\n  # 'UP' is typically interpreted as moving forward relative to agent's direction.\n  MOVE_FORWARD_ACTION = action_map['UP'] \n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction (0:R, 1:U, 2:L, 3:D)\n  # This defines how position changes when moving \"forward\" in a given direction.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Facing RIGHT (positive column, X-axis)\n      1: (-1, 0),  # Facing UP (negative row, Y-axis)\n      2: (0, -1),  # Facing LEFT (negative column, X-axis)\n      3: (1, 0)    # Facing DOWN (positive row, Y-axis)\n  }\n\n  # Map for turning left/right, updating the agent's direction (0-3)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Prepare the set of kinds that inherently block movement (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are \"non-grabbable\" items according to CraftWorld's definition and cannot be walked through.\n  non_grabbable_kinds_set = current_state.world.non_grabbable_indices\n\n  # Define all blocking kinds for movement into a cell.\n  # This includes inherently non-grabbable items AND the primitive itself (agent cannot walk ONTO the primitive\n  # if it's a collectible resource like WOOD or STONE; it must stand adjacent to it).\n  blocking_kinds_for_movement = set(non_grabbable_kinds_set)\n  # If the target primitive is a grabbable resource (e.g., WOOD, STONE), it should also block movement onto its cell.\n  # If it's already non-grabbable (e.g., WORKSHOP0), it's already in the set.\n  if primitive_id not in blocking_kinds_for_movement:\n      blocking_kinds_for_movement.add(primitive_id)\n  \n  # Convert the set to a list for efficient NumPy array indexing.\n  blocking_kinds_for_movement_list = list(blocking_kinds_for_movement)\n\n  # BFS state: ((row, col), direction), path_actions\n  # Queue stores ( (current_pos_tuple, current_dir_int), list_of_actions_to_reach_here )\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (current_pos_tuple, current_dir_int) to avoid cycles and redundant paths\n  visited = {(initial_pos, initial_dir)}\n\n  target_path_actions = None # Stores the action list to reach the target state\n\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # 1. Goal Check: Is the primitive directly in front of the agent at the current state?\n      # Calculate the coordinates of the cell directly in front.\n      front_dr, front_dc = DIR_TO_DRDC[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Check if the front_cell is within grid bounds.\n      if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT):\n          # Check if the front_cell contains the primitive.\n          if initial_grid[front_r, front_c, primitive_id] > 0:\n              target_path_actions = path_actions\n              break # Path to target found (agent is adjacent and facing the primitive).\n\n      # 2. Explore possible next actions: Move Forward, Turn Left, Turn Right.\n      \n      # Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir = current_dir # Moving forward does not change facing direction.\n\n      # Check if next_pos is within bounds.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n          # Check if this (position, direction) state hasn't been visited to avoid redundant paths.\n          if (next_pos, next_dir) not in visited:\n              # Check if the next_pos contains any blocking kind using NumPy's any function.\n              # If np.any returns True, it means at least one blocking kind is present, so the cell is not walkable.\n              if not np.any(initial_grid[next_r, next_c, blocking_kinds_for_movement_list] > 0):\n                  visited.add((next_pos, next_dir))\n                  queue.append(((next_pos, next_dir), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning does not change position, only direction.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path was found, append the USE action to the sequence.\n  if target_path_actions is not None:\n      actions_list.extend(target_path_actions)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:57:17.590573", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-01T07:58:09.274241", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # --- 1. Initialize Action Map and Primitive ID ---\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None: # Primitive name not recognized in the cookbook\n    return []\n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- 2. Early Exit: If primitive is already in inventory ---\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # --- 3. Immediate Collection Check (Agent already adjacent) ---\n  # If the agent is already in a position to collect the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- 4. Identify all physical locations of the primitive on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0: \n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- 5. Determine \"Goal Cells\" for BFS ---\n  # A \"goal cell\" for the agent's movement is any grid cell from which the 'USE'\n  # action can successfully collect the primitive. This means any cell within the\n  # 3x3 neighborhood of a primitive's location (including the primitive's cell itself).\n  collectible_agent_positions = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        ax, ay = px + dx, py + dy \n        # Ensure the candidate agent position is within grid boundaries\n        if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          collectible_agent_positions.add((ax, ay))\n\n  # --- 6. Pre-calculate Impassable Terrain Kinds ---\n  # These are entities that block agent movement. Non-grabbable items that are not workshops.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # --- 7. Perform Breadth-First Search (BFS) for the shortest path ---\n  start_position = current_state.pos\n  \n  # BFS queue: stores positions to visit\n  bfs_queue = collections.deque([start_position]) \n  \n  # visited_info: maps position -> (parent_position, action_to_reach_here) for path reconstruction\n  visited_info = {start_position: (None, None)} \n\n  # Define possible movement deltas (dx, dy) and their corresponding action indices.\n  MOVE_ACTIONS = [\n      ((0, -1), UP),    # North (decreases Y)\n      ((0, 1), DOWN),   # South (increases Y)\n      ((-1, 0), LEFT),  # West (decreases X)\n      ((1, 0), RIGHT),  # East (increases X)\n  ]\n\n  found_target_pos = None # To store the found goal position for path reconstruction\n\n  while bfs_queue:\n    current_x, current_y = bfs_queue.popleft() # Dequeue current position\n    current_pos = (current_x, current_y)\n\n    # If the current agent position is one of the desired \"goal cells\", we've found the shortest path.\n    if current_pos in collectible_agent_positions:\n      found_target_pos = current_pos\n      break # Exit BFS loop, shortest path found\n\n    # Explore all valid neighboring cells for movement.\n    for (dx, dy), action_to_take in MOVE_ACTIONS:\n      next_x, next_y = current_x + dx, current_y + dy \n      next_position = (next_x, next_y)\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue \n\n      # Check if the new position is traversable (not blocked by impassable terrain).\n      # A cell is impassable if it contains any kind from the 'impassable_kinds' set.\n      is_impassable_location = False\n      for k_idx in impassable_kinds:\n          if grid[next_x, next_y, k_idx] > 0: \n              is_impassable_location = True\n              break\n      \n      if is_impassable_location:\n          continue \n\n      # If the new position is valid and has not been visited yet, add it to the queue.\n      if next_position not in visited_info:\n        visited_info[next_position] = (current_pos, action_to_take) # Store parent and action\n        bfs_queue.append(next_position)\n\n  # --- 8. Path Reconstruction or No Path Found ---\n  if found_target_pos is None:\n    return [] # No path to a collectible location was found\n\n  # Reconstruct the path by backtracking from the found_target_pos to start_position.\n  path_actions = []\n  current_backtrack_pos = found_target_pos\n  while current_backtrack_pos != start_position:\n    parent_pos, action_from_parent = visited_info[current_backtrack_pos]\n    path_actions.append(action_from_parent)\n    current_backtrack_pos = parent_pos\n  \n  path_actions.reverse() # Path was built in reverse order, so reverse it.\n\n  # Finally, append the 'USE' action to collect the primitive.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:58:10.513501", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get primitive index. Use __getitem__ to avoid modifying the index\n  # if the primitive name is not recognized. If it's not found, return an empty list.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    return []\n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Early Exit: If primitive is already in inventory, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Immediate Collection Check: If the agent is already in a position to collect the primitive\n  # (i.e., it's within the 3x3 neighborhood based on `current_state.next_to`), simply use it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Find all physical locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  all_primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, primitive_idx] > 0:\n        all_primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it's currently unreachable.\n  if not all_primitive_locations:\n    return []\n\n  # Determine \"Goal Cells\" for BFS. A goal cell is any grid cell from which the 'USE'\n  # action can successfully collect the primitive. This means any cell adjacent to\n  # (or on top of) a primitive's location is a valid goal cell for the agent's position.\n  goal_cells = set()\n  for px, py in all_primitive_locations:\n    # Iterate over the 3x3 neighborhood around the primitive's location (px, py)\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        ax, ay = px + dx, py + dy # Candidate agent position\n        # Ensure the candidate agent position is within grid boundaries\n        if 0 <= ax < grid_width and 0 <= ay < grid_height:\n          goal_cells.add((ax, ay))\n\n  # Identify impassable kinds for movement. These are non-grabbable entities\n  # that are not designated workshops (which are traversable).\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      if idx not in env.world.workshop_indices:\n          impassable_kinds.add(idx)\n\n  # Perform Breadth-First Search (BFS) for the shortest path\n  start_pos = current_state.pos\n  \n  # BFS queue: stores positions to visit\n  q = collections.deque([start_pos])\n  # visited: stores {position: (parent_position, action_to_reach_position)}\n  # This allows reconstructing the path by backtracking from the found goal.\n  visited = {start_pos: (None, None)} \n\n  # Define possible movement deltas (dx, dy) and their corresponding action indices.\n  MOVE_ACTIONS = [\n      ((0, -1), UP),    # North (decreases Y)\n      ((0, 1), DOWN),   # South (increases Y)\n      ((-1, 0), LEFT),  # West (decreases X)\n      ((1, 0), RIGHT),  # East (increases X)\n  ]\n\n  found_goal_pos = None\n\n  while q:\n    cx, cy = q.popleft()\n    current_pos = (cx, cy)\n\n    # If the current position is one of the desired \"goal cells\", we've found\n    # the shortest path to a location from which 'USE' can collect.\n    if current_pos in goal_cells:\n      found_goal_pos = current_pos\n      break # Exit BFS, as shortest path is found\n\n    # Explore all valid neighboring cells for movement.\n    for (dx, dy), action_to_take in MOVE_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the new potential position\n      new_pos = (nx, ny)\n\n      # Check if the new position is within grid boundaries.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Out of bounds, skip\n\n      # Check if the new position is traversable (not blocked by impassable terrain).\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this cell, skip\n\n      # If the new position is valid and has not been visited yet, add it to the queue.\n      if new_pos not in visited:\n        visited[new_pos] = (current_pos, action_to_take) # Store parent and action\n        q.append(new_pos)\n\n  # If BFS completed and no path to a collectible location was found, it's unreachable.\n  if found_goal_pos is None:\n    return []\n\n  # Reconstruct the path from start_pos to found_goal_pos using parent pointers.\n  path_actions = []\n  current_path_pos = found_goal_pos\n  # Backtrack from the goal position until the start position is reached\n  while current_path_pos != start_pos:\n    parent_pos, action_from_parent = visited[current_path_pos]\n    path_actions.append(action_from_parent)\n    current_path_pos = parent_pos\n  \n  # Path was built in reverse order, so reverse to get correct sequence.\n  path_actions.reverse() \n\n  # Append the USE action at the end to collect the primitive.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:59:09.606101", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This version continues to use a Breadth-First Search (BFS) algorithm to find the shortest\n  sequence of actions (movements and turns) to reach a position from which the specified\n  primitive can be collected.\n\n  Key improvements inherited from `collect_v1` (and differentiating it from `collect_v0`):\n  - **Correct Walkability Logic**: The agent is allowed to walk onto a cell that contains\n    the primitive itself (e.g., walking onto a 'WOOD' or 'STONE' resource), as long as\n    that cell is not classified as a general non-walkable obstacle (like 'WATER' or 'BOUNDARY').\n    This is crucial for efficient pathfinding to many common resources.\n\n  Args:\n      env (env.CraftLab): The CraftLab object containing the current state of the environment.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n  Returns:\n      List[int]: A sequence of integer action indices to execute (e.g., [UP, UP, LEFT, USE]).\n                 Returns an empty list if the primitive is unreachable or not found.\n  \"\"\"\n  actions_list = []\n  current_state = env._current_state # Get the current CraftState from the environment wrapper\n\n  # Extract initial state details for BFS, as the grid is static for pathfinding within this task\n  initial_grid = current_state.grid  # The full grid layout at the start of the collection task\n  initial_pos = current_state.pos    # Agent's starting position (row, col) tuple\n  initial_dir = current_state.dir    # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Resolve the primitive name to its integer ID using the world's cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Get dimensions of the grid (e.g., 25, 25)\n\n  # Map DSL action names to their integer IDs provided by the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' in action_specs implies moving forward in current direction\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Helper mappings for agent movement and direction changes\n  # (dr, dc) delta for moving one step forward based on current agent direction\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: +1 to column (x-axis)\n      1: (-1, 0),  # Up: -1 to row (y-axis)\n      2: (0, -1),  # Left: -1 to column (x-axis)\n      3: (1, 0)    # Down: +1 to row (y-axis)\n  }\n\n  # Mapping to update agent's direction after a left turn (clockwise rotation of direction index)\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # R -> U -> L -> D -> R\n  # Mapping to update agent's direction after a right turn (counter-clockwise rotation of direction index)\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # R -> D -> L -> U -> R\n\n  # Identify entities that inherently block agent movement (e.g., 'BOUNDARY', 'WATER', 'WORKSHOP_X').\n  # These are retrieved from the world's `non_grabbable_indices` set, which typically includes terrain features\n  # and fixed structures.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # Immediate Check: If the primitive is already within the agent's 3x3 neighborhood (i.e., it can be collected\n  # from the current position without moving), no pathfinding is needed; just perform the 'USE' action.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION]\n\n  # Initialize Breadth-First Search (BFS) for shortest pathfinding\n  # The queue stores tuples: ((current_position_tuple, current_direction_int), list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # The visited set stores (position_tuple, direction_int) to prevent revisiting states\n  # (position + orientation) and thus avoids cycles and redundant paths.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This variable will store the final sequence of actions to reach a collectable position\n\n  # BFS Loop: continues until a path to a collectable position is found or all reachable states are explored\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      current_pos_r, current_pos_c = current_pos\n\n      # Check if the current (position, direction) state allows for the collection of the primitive.\n      # This is determined by checking if the primitive is present in any cell within the 3x3\n      # neighborhood (including the agent's current cell) around `current_pos` on the *initial grid*.\n      is_collectable_from_current_pos = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = current_pos_r + dr_check, current_pos_c + dc_check\n              # Ensure the cell being checked is within the overall grid boundaries\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectable_from_current_pos = True\n                  break # Primitive found in the 3x3 neighborhood\n          if is_collectable_from_current_pos:\n              break\n\n      if is_collectable_from_current_pos:\n          target_path = path_actions # Found the shortest path (in terms of actions) to a collectable position\n          break # Terminate BFS as the shortest path has been found\n\n      # Explore possible next actions (Move Forward, Turn Left, Turn Right) from the current state:\n\n      # 1. Try moving forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = current_pos_r + move_dr, current_pos_c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Agent's direction remains unchanged when moving forward\n\n      # Check if the next position is within grid boundaries and if the resulting (position, direction)\n      # state has not been visited previously.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          is_walkable_to_next_cell = True\n          # A cell is considered walkable if it does not contain any entity from the `non_walkable_kinds_indices`.\n          # This specifically means the agent *can* walk onto cells that contain the primitive itself\n          # (e.g., a 'WOOD' tile) as long as it's not also marked as an unpassable obstacle like 'WATER'.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable_to_next_cell = False\n                  break\n\n          if is_walkable_to_next_cell:\n              visited.add((next_pos, next_dir_move))\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try turning left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes the agent's direction but not its position\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try turning right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes the agent's direction but not its position\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # If a path to a collectable position was successfully found during BFS\n  if target_path is not None:\n      actions_list.extend(target_path)  # Add the sequence of movement and turning actions\n      actions_list.append(USE_ACTION)   # Append the final 'USE' action to collect the primitive\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:59:10.824872", "function_name": "collect", "function_body": "  actions_list = []\n  current_state = env._current_state\n  initial_grid = current_state.grid # The grid layout at the start of the collection task\n  initial_pos = current_state.pos   # Agent's starting position (row, col)\n  initial_dir = current_state.dir   # Agent's starting direction (0:RIGHT, 1:UP, 2:LEFT, 3:DOWN)\n\n  # Get the integer ID for the target primitive from the cookbook index\n  primitive_id = current_state.world.cookbook.index[primitive]\n  WIDTH, HEIGHT, _ = initial_grid.shape # Grid dimensions\n\n  # Get the integer action IDs from the environment's action specifications\n  action_map = env.action_specs()\n  MOVE_FORWARD_ACTION = action_map['UP']    # 'UP' in action_specs means moving forward\n  TURN_LEFT_ACTION = action_map['LEFT']\n  TURN_RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Direction mapping: (dr, dc) for agent's facing direction.\n  # This helps calculate the new position after a 'MOVE_FORWARD' action.\n  DIR_TO_DRDC = {\n      0: (0, 1),   # Right: (row, col+1)\n      1: (-1, 0),  # Up:    (row-1, col)\n      2: (0, -1),  # Left:  (row, col-1)\n      3: (1, 0)    # Down:  (row+1, col)\n  }\n\n  # Maps for updating the agent's direction when turning left/right\n  TURN_LEFT_MAP = {0: 1, 1: 2, 2: 3, 3: 0}  # Right -> Up -> Left -> Down -> Right\n  TURN_RIGHT_MAP = {0: 3, 1: 0, 2: 1, 3: 2} # Right -> Down -> Left -> Up -> Right\n\n  # Identify entities that cannot be walked on (e.g., BOUNDARY, WATER, WORKSHOP_X).\n  # These are defined as `non_grabbable_indices` in the CraftWorld.\n  non_walkable_kinds_indices = current_state.world.non_grabbable_indices\n\n  # --- Short-circuit: If the primitive is already within reach (3x3 neighborhood) ---\n  # The `next_to` method of CraftState checks if `i_kind` is in the 3x3 neighborhood of the agent.\n  if current_state.next_to(primitive_id):\n      return [USE_ACTION] # If so, just perform the USE action immediately.\n\n  # --- Breadth-First Search (BFS) to find the shortest path ---\n  # Queue stores tuples of:\n  #   ((current_position_tuple, current_direction_int), list_of_actions_to_reach_here)\n  queue = collections.deque([((initial_pos, initial_dir), [])])\n  # Visited set stores (position_tuple, direction_int) to avoid redundant computations and cycles.\n  # A state is defined by both position and direction because different directions\n  # at the same position lead to different reachable next cells.\n  visited = {(initial_pos, initial_dir)}\n\n  target_path = None # This will store the sequence of actions to reach a collectable position\n\n  # BFS Loop\n  while queue:\n      (current_pos, current_dir), path_actions = queue.popleft()\n      r, c = current_pos\n\n      # --- Check if the current position is a \"goal\" state for collection ---\n      # A goal state means the primitive exists within the 3x3 neighborhood\n      # of the agent's current (r, c) on the *initial grid*.\n      is_collectable_position = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid bounds\n              if (0 <= check_r < WIDTH and 0 <= check_c < HEIGHT and\n                  initial_grid[check_r, check_c, primitive_id] > 0):\n                  is_collectable_position = True\n                  break # Found the primitive in the neighborhood\n          if is_collectable_position:\n              break\n\n      if is_collectable_position:\n          target_path = path_actions # Path found to reach this collectable position\n          break # Shortest path found, terminate BFS\n\n      # --- Explore possible next actions from the current state ---\n\n      # 1. Try Move Forward\n      move_dr, move_dc = DIR_TO_DRDC[current_dir]\n      next_r, next_c = r + move_dr, c + move_dc\n      next_pos = (next_r, next_c)\n      next_dir_move = current_dir # Moving forward does not change facing direction\n\n      # Check if the next position is within grid bounds and this (position, direction)\n      # state has not been visited yet.\n      if (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and\n          (next_pos, next_dir_move) not in visited):\n          \n          is_walkable = True\n          # A cell is considered walkable if it does not contain any non-grabbable entity.\n          # Unlike v0, v1 and v2 allow walking *onto* the primitive itself if it's a grabbable\n          # resource (e.g., WOOD, STONE), as long as it's not a non-grabbable obstacle\n          # like a BOUNDARY or WATER.\n          for kind_idx in non_walkable_kinds_indices:\n              if initial_grid[next_r, next_c, kind_idx] > 0:\n                  is_walkable = False\n                  break\n\n          if is_walkable:\n              visited.add((next_pos, next_dir_move))\n              queue.append(((next_pos, next_dir_move), path_actions + [MOVE_FORWARD_ACTION]))\n\n      # 2. Try Turn Left\n      next_dir_left = TURN_LEFT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_left) not in visited):\n          visited.add((current_pos, next_dir_left))\n          queue.append(((current_pos, next_dir_left), path_actions + [TURN_LEFT_ACTION]))\n\n      # 3. Try Turn Right\n      next_dir_right = TURN_RIGHT_MAP[current_dir]\n      # Turning changes direction but not position.\n      if ((current_pos, next_dir_right) not in visited):\n          visited.add((current_pos, next_dir_right))\n          queue.append(((current_pos, next_dir_right), path_actions + [TURN_RIGHT_ACTION]))\n\n  # --- After BFS: Construct the final action list ---\n  # If a path to a collectable position was found, append the USE action to perform the collection.\n  if target_path is not None:\n      actions_list.extend(target_path)\n      actions_list.append(USE_ACTION)\n\n  return actions_list", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T07:59:55.032102", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Get primitive index. Use __getitem__ (via []) to avoid modifying the index\n  # if the primitive name is not recognized and to return None if not found.\n  primitive_idx = env.world.cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive is not recognized in the cookbook, it's impossible to collect.\n    return []\n\n  # Check if the primitive is already in inventory.\n  # If the agent's inventory already contains the primitive, there's no need to\n  # move or use actions to collect it. This avoids redundant operations.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # If the agent is already adjacent to the primitive (within its 3x3 neighborhood),\n  # the most efficient action is simply to 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # Locate all occurrences of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  # List to store (x, y) coordinates of all cells containing the primitive.\n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # If the primitive's layer at (x, y) has a value greater than 0, it exists there.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # Determine \"Goal Cells\" for BFS.\n  # A \"goal cell\" is any grid location from which the agent can apply the 'USE' action\n  # to collect the target primitive. 'USE' affects a 3x3 area around the agent.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell (gx, gy) is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # Perform Breadth-First Search (BFS) for the shortest path.\n  # This version is optimized for memory by reconstructing the path using parent pointers.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores only grid positions to visit.\n  q = collections.deque([start_pos])\n  # Visited dictionary: Stores {current_pos: (parent_pos, action_to_reach_current_from_parent)}\n  # This allows reconstructing the path efficiently by backtracking from the found goal.\n  visited = {start_pos: (None, None)} # (parent_position, action_to_get_here_from_parent)\n\n  # Define all possible movement directions (delta X, delta Y) and their corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain. These are entities that the agent cannot move onto.\n  # Non-grabbable items that are NOT workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  found_goal_pos = None # To store the specific goal cell reached\n\n  while q:\n    cx, cy = q.popleft()\n    current_pos = (cx, cy)\n\n    # If the current position is one of our target goal cells, we've found the shortest path.\n    if current_pos in goal_cells:\n      found_goal_pos = current_pos\n      break # Exit BFS, as the shortest path to *any* goal cell is found.\n\n    # Explore all valid neighboring cells from the current position.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate the coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within the grid dimensions.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue # Skip if the new position is out of bounds.\n\n      # 2. Impassability Check: Determine if the new position contains any impassable entity.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break # No need to check other impassable kinds for this cell.\n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited[new_pos] = (current_pos, action) # Store parent and the action to reach new_pos\n        q.append(new_pos)\n\n  # If BFS completed (queue became empty) and no path to a goal cell was found,\n  # it means the primitive is currently unreachable from the agent's starting position.\n  if found_goal_pos is None:\n    return []\n\n  # Reconstruct the path.\n  path_actions = []\n  current_path_reconstruction_pos = found_goal_pos\n  # Backtrack from the found goal position to the start position using the 'visited' dictionary.\n  while current_path_reconstruction_pos != start_pos:\n    parent_pos, action_to_reach_current = visited[current_path_reconstruction_pos]\n    path_actions.append(action_to_reach_current)\n    current_path_reconstruction_pos = parent_pos\n  \n  # The path was built in reverse order (from goal to start), so reverse it.\n  path_actions.reverse() \n\n  # Append the 'USE' action at the end to actually collect the primitive.\n  return path_actions + [USE]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T07:59:56.275107", "function_name": "collect", "function_body": "  current_state = env._current_state\n  \n  # Retrieve the integer index corresponding to the primitive name.\n  # Using `env.world.cookbook.index[primitive]` (which calls `__getitem__`)\n  # is preferred over `env.world.cookbook.index.index(primitive)`.\n  # `__getitem__` will return the index if the primitive is known, or None if not.\n  # `index.index()` (the method) would create a new index if the primitive isn't\n  # already registered, which is an undesirable side effect for a lookup function.\n  primitive_idx = env.world.cookbook.index[primitive] \n  \n  # If the primitive is not recognized (i.e., `primitive_idx` is None),\n  # it cannot be collected. Return an empty list of actions.\n  if primitive_idx is None:\n    return []\n\n  # If the agent's inventory already contains the primitive, no collection\n  # actions are needed. This avoids redundant movement and 'USE' actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Map action names to their integer representations.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # --- Immediate Collection Check ---\n  # If the agent is already adjacent to the primitive, the most direct\n  # action is to simply 'USE' it.\n  if current_state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Locate all primitive occurrences on the grid ---\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  \n  primitive_locations_on_grid = [] \n  for x in range(grid_width):\n    for y in range(grid_height):\n      # Check if the primitive exists at the current grid cell (x, y).\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not present anywhere on the grid, it's currently unreachable.\n  if not primitive_locations_on_grid:\n    return []\n\n  # --- Determine \"Goal Cells\" for Pathfinding ---\n  # A \"goal cell\" is any grid position from which the agent can successfully\n  # perform the 'USE' action to collect the primitive. The 'USE' action affects\n  # a 3x3 area around the agent. Thus, for each primitive instance (px, py),\n  # any cell (gx, gy) in its 3x3 neighborhood is a valid goal cell.\n  goal_cells = set()\n  for px, py in primitive_locations_on_grid:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        gx, gy = px + dx, py + dy \n        # Ensure the potential goal cell is within the grid boundaries.\n        if 0 <= gx < grid_width and 0 <= gy < grid_height:\n          goal_cells.add((gx, gy))\n\n  # --- Breadth-First Search (BFS) for the Shortest Path ---\n  # Find the shortest sequence of movement actions from the agent's current\n  # position to any of the determined 'goal_cells'.\n\n  start_pos = current_state.pos\n  \n  # BFS queue: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to track visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Define all possible movement directions (delta X, delta Y) and their\n  # corresponding action indices.\n  MOVEMENT_DELTAS_AND_ACTIONS = [\n      ((0, -1), UP),    # Move North (decreases Y-coordinate)\n      ((0, 1), DOWN),   # Move South (increases Y-coordinate)\n      ((-1, 0), LEFT),  # Move West (decreases X-coordinate)\n      ((1, 0), RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Identify impassable terrain types. These are entities that block agent movement.\n  # In CraftWorld, non-grabbable items that are not workshops typically block movement.\n  impassable_kinds = set()\n  for idx in env.world.non_grabbable_indices:\n      # Workshops (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually traversable,\n      # even though they cannot be picked up.\n      if idx not in env.world.workshop_indices: \n          impassable_kinds.add(idx)\n\n  # Start BFS.\n  while q:\n    (cx, cy), path_to_current = q.popleft() \n\n    # If the current position is a goal cell, we've found the shortest path.\n    # Append the 'USE' action to complete the collection sequence.\n    if (cx, cy) in goal_cells:\n      return path_to_current + [USE]\n\n    # Explore all valid neighboring cells.\n    for (dx, dy), action in MOVEMENT_DELTAS_AND_ACTIONS:\n      nx, ny = cx + dx, cy + dy # Calculate coordinates of the next potential position.\n      new_pos = (nx, ny)\n\n      # 1. Boundary Check: Ensure the new position is within grid limits.\n      if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n        continue \n\n      # 2. Impassability Check: Determine if the new position contains impassable entities.\n      is_impassable = False\n      for k_idx in impassable_kinds:\n          # If an impassable kind is present at (nx, ny) with a count > 0, the cell is blocked.\n          if grid[nx, ny, k_idx] > 0: \n              is_impassable = True\n              break \n      \n      if is_impassable:\n          continue # Skip this move if the cell is impassable.\n\n      # 3. Visited Check: If the new position has not been visited yet during this BFS.\n      if new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Enqueue the new position along with the extended path.\n        q.append((new_pos, path_to_current + [action]))\n\n  # If the BFS completes and no path to any goal cell was found, the primitive\n  # is currently unreachable from the agent's starting position.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
