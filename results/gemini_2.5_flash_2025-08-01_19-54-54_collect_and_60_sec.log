{"timestamp": "2025-08-02T03:41:35.290631", "function_name": "collect", "function_body": "  try:\n    # Attempt to get the integer index for the primitive string from the cookbook's index.\n    # This operation can raise a KeyError if the primitive name is not recognized by the environment.\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is unknown to the cookbook, it cannot be collected.\n    # Return an empty list of actions as no plan can be formed.\n    return []\n\n  # Get the current state of the environment, which includes the agent's inventory,\n  # position, and the grid layout.\n  current_state = env._current_state\n  \n  # Optimization: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the primitive, there's no need\n  # to collect more, so return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Constraint Check: Determine if the primitive is a 'grabbable' item.\n  # The 'collect' function is intended for acquiring items into inventory.\n  # If the primitive is defined as 'non-grabbable' (e.g., static environment features\n  # like workshops, water, or boundaries that cannot be picked up), it cannot be collected\n  # using this method. In such cases, no collection actions are possible.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Extract relevant information from the current state: the grid dimensions and\n  # the agent's starting position.\n  grid_width, grid_height, _ = current_state.grid.shape\n  start_pos = current_state.pos\n\n  # Retrieve the integer mappings for various actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action typically used to interact with or pick up items.\n\n  # Define the change in coordinates for each movement action.\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to avoid redundant explorations and cycles.\n  visited = {start_pos}\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    curr_pos, path = q.popleft() # Get the next position and its path from the queue.\n\n    # Leverage the existing CraftState.next_to method. To do this, we create a\n    # temporary CraftState instance that has its position set to the `curr_pos` from our BFS.\n    # Other state attributes (grid, scenario, direction, inventory) can be copied\n    # from the actual current_state, as they don't change during pathfinding and\n    # are needed for the CraftState constructor, but don't affect the `next_to` check itself.\n    temp_state = craft.CraftState(\n        scenario=current_state.scenario,\n        grid=current_state.grid,\n        pos=curr_pos,\n        dir=current_state.dir, # Direction is not relevant for next_to, but required by constructor\n        inventory=current_state.inventory # Inventory is not relevant for next_to, but required by constructor\n    )\n    \n    # Use the CraftState's built-in method to check if the current BFS position\n    # is next to the target primitive. This abstracts away the 3x3 neighborhood check.\n    if temp_state.next_to(primitive_idx):\n      # Append the `ACTION_USE` to the current path and return the complete sequence of actions.\n      # This path represents the shortest sequence of moves to get next to the primitive,\n      # followed by the action to collect it.\n      return path + [ACTION_USE]\n\n    # If the primitive is not yet collectible from `curr_pos`, explore all possible moves\n    # from the current position.\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Validate the next position: ensure it is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip moves that go out of bounds.\n\n      # If the `next_pos` has not been visited yet, add it to the queue for exploration.\n      # This ensures the BFS finds the shortest path by processing layers level by level.\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        q.append((next_pos, path + [action])) # Add the new position and its extended path to the queue.\n\n  # If the BFS completes and the queue is empty, it means no path was found to reach\n  # and collect the primitive from the initial state.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:41:36.394250", "function_name": "collect", "function_body": "  try:\n    # Attempt to get the integer index for the primitive string from the cookbook's index.\n    # This operation can raise a KeyError if the primitive name is not recognized by the environment.\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is unknown to the cookbook, it cannot be collected.\n    # Return an empty list of actions as no plan can be formed.\n    return []\n\n  # Get the current state of the environment, which includes the agent's inventory,\n  # position, and the grid layout.\n  current_state = env._current_state\n  \n  # Optimization: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the primitive, there's no need\n  # to collect more, so return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Constraint Check: Determine if the primitive is a 'grabbable' item.\n  # The 'collect' function is intended for acquiring items into inventory.\n  # If the primitive is defined as 'non-grabbable' (e.g., static environment features\n  # like workshops, water, or boundaries that cannot be picked up), it cannot be collected\n  # using this method. In such cases, no collection actions are possible.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Extract relevant information from the current state: the grid dimensions and\n  # the agent's starting position.\n  grid_width, grid_height, _ = current_state.grid.shape\n  start_pos = current_state.pos\n\n  # Retrieve the integer mappings for various actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action typically used to interact with or pick up items.\n\n  # Define the change in coordinates for each movement action.\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to avoid redundant explorations and cycles.\n  visited = {start_pos}\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    curr_pos, path = q.popleft() # Get the next position and its path from the queue.\n\n    # Improvement: Leverage the CraftState.next_to method.\n    # To use `next_to`, we need a CraftState instance whose position is `curr_pos`.\n    # Other state attributes (grid, scenario, direction, inventory) can be copied\n    # from the actual current_state, as they don't change during pathfinding and\n    # are needed for the CraftState constructor, but don't affect the `next_to` check itself.\n    temp_state = craft.CraftState(\n        scenario=current_state.scenario,\n        grid=current_state.grid,\n        pos=curr_pos,\n        dir=current_state.dir, # Direction is not relevant for next_to, but required by constructor\n        inventory=current_state.inventory # Inventory is not relevant for next_to, but required by constructor\n    )\n    \n    # Use the CraftState's built-in method to check if the current BFS position\n    # is next to the target primitive. This abstracts away the 3x3 neighborhood check,\n    # making the code cleaner and more robust than a manual implementation.\n    if temp_state.next_to(primitive_idx):\n      # Append the `ACTION_USE` to the current path and return the complete sequence of actions.\n      # This path represents the shortest sequence of moves to get next to the primitive,\n      # followed by the action to collect it.\n      return path + [ACTION_USE]\n\n    # If the primitive is not yet collectible from `curr_pos`, explore all possible moves\n    # from the current position.\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Validate the next position: ensure it is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip moves that go out of bounds.\n\n      # If the `next_pos` has not been visited yet, add it to the queue for exploration.\n      # This ensures the BFS finds the shortest path by processing layers level by level.\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        q.append((next_pos, path + [action])) # Add the new position and its extended path to the queue.\n\n  # If the BFS completes and the queue is empty, it means no path was found to reach\n  # and collect the primitive from the initial state.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:42:14.487358", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version adds obstacle avoidance for water and stone.\n  \"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define indices of impassable terrain (obstacles)\n  # These are directly available as attributes of env.world\n  unwalkable_indices = {env.world.water_index, env.world.stone_index}\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # This check happens *before* exploring neighbors because current_pos could be the target adjacent cell.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # NEW in v2: Check for obstacles (unwalkable terrain)\n      is_unwalkable = False\n      for idx in unwalkable_indices:\n        if grid[next_x, next_y, idx] > 0: # If the cell contains an unwalkable item\n          is_unwalkable = True\n          break\n      \n      if is_unwalkable:\n        continue # Skip this path, it leads into an obstacle\n\n      # If the cell is walkable and not visited, add it to the queue\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T03:42:15.552898", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  # Note: `env.action_specs()` provides the mapping from action names to integers\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Get indices of non-grabbable entities which act as obstacles\n  obstacle_indices = env.world.non_grabbable_indices\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # This check is done for the current position, meaning we are looking for a path\n    # that ends one step away from the primitive.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # NEW: Check for obstacles at the next position\n      is_obstacle = False\n      for obstacle_idx in obstacle_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      \n      if is_obstacle:\n        continue # Cannot move to an obstacle cell\n\n      # If the cell is valid, not visited, and not an obstacle, add it to the queue\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T03:42:57.060360", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized by the cookbook, it cannot be collected.\n      return []\n\n  state = env._current_state\n\n  # If the agent already has at least one of the primitive, no collection actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # If the primitive is not in the set of grabbable items, the 'USE' action will not yield it.\n  # Therefore, it cannot be \"collected\" via this function.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape # Dimensions of the grid.\n\n  # Get the integer action mappings for movement (UP, DOWN, LEFT, RIGHT) and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas (dx, dy) and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one step down (increase y).\n      ((0, -1), UP_ACTION),   # Move one step up (decrease y).\n      ((-1, 0), LEFT_ACTION), # Move one step left (decrease x).\n      ((1, 0), RIGHT_ACTION), # Move one step right (increase x).\n  ]\n\n  # Define specific non-grabbable entities that the agent can traverse (e.g., workshops, water).\n  # These are exceptions to the general rule that non-grabbables block movement.\n  traversable_non_grabbables = set(env.world.workshop_indices)\n  if env.world.water_index is not None: # Ensure water_index exists before adding.\n      traversable_non_grabbables.add(env.world.water_index)\n\n  # Helper function to check if a given grid cell (x, y) is traversable by the agent.\n  # A cell is considered traversable if it's within grid boundaries and does not\n  # contain any non-grabbable entities that are not workshops or water.\n  def _is_traversable(x: int, y: int) -> bool:\n      # First, check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False # Out of bounds.\n\n      # Get the indices of all kinds present at the current cell (x, y).\n      # This is more efficient than iterating through all `num_kinds`.\n      kinds_at_cell = np.where(grid[x, y] > 0)[0]\n      for k_idx in kinds_at_cell:\n          # A cell is considered impassable if it contains any non-grabbable\n          # entity that is NOT in our set of explicitly traversable non-grabbables.\n          if k_idx in env.world.non_grabbable_indices and k_idx not in traversable_non_grabbables:\n              return False # This cell contains an impassable obstacle.\n      return True # If no obstacles are found, the cell is traversable.\n\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # The `visited` set keeps track of positions already explored to prevent cycles\n  # and redundant computations, ensuring the shortest path.\n  visited = {agent_pos} \n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos # Current agent's x, y coordinates.\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. The 'USE' action typically\n      # applies to entities in the agent's 3x3 neighborhood (including current cell).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # Check if the current position (cx, cy) is within 1 unit (Manhattan distance)\n          # of a primitive location (px, py). This covers the 3x3 neighborhood.\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break # Found an adjacent primitive, no need to check other locations.\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action to the path\n          # and return the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # If the cell is traversable using the helper function and has not been visited yet,\n          # add it to the queue to continue the BFS.\n          if _is_traversable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:42:58.252381", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the primitive is already in the agent's inventory.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      # If the agent already has at least one of the primitive, no collection actions are needed.\n      return []\n\n  # The 'collect' function implies obtaining the item into inventory.\n  # If the primitive is not in the set of items that can be picked up (grabbable),\n  # it cannot be \"collected\" in the sense of adding to inventory directly.\n  # For example, 'BOUNDARY', 'WATER', 'WORKSHOP0' are environmental features not meant to be picked up.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve current state information from the environment.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs for BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Pre-compute the set of non-grabbable entities that are still traversable.\n  # These typically include workshops and water, which the agent can move through.\n  traversable_non_grabbables = set(env.world.workshop_indices)\n  if env.world.water_index is not None:\n      traversable_non_grabbables.add(env.world.water_index)\n\n  # Pre-compute the set of truly impassable non-grabbable kinds for faster lookup.\n  # These are non-grabbable items that are NOT in our list of traversable exceptions.\n  impassable_kinds = set(env.world.non_grabbable_indices) - traversable_non_grabbables\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell from which the 'USE' action can successfully\n  # interact with the primitive. This means any cell within the 3x3 neighborhood\n  # (including the center) of a primitive's actual location, as per CraftState.next_to.\n  queue = collections.deque([(agent_pos, [])]) # Stores (current_position, path_taken_to_reach_here).\n  visited = {agent_pos} # Set of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. A 3x3 neighborhood is considered\n      # \"adjacent\" for the purpose of the 'USE' action in CraftWorld.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # Get only the kinds present at the next cell.\n          kinds_at_next_cell = np.where(grid[next_x, next_y] > 0)[0]\n          \n          is_impassable = False\n          # Iterate only over the kinds actually present at the cell.\n          for k_idx in kinds_at_next_cell:\n              # If any kind at this cell is in our pre-computed set of impassable kinds,\n              # then the cell is blocked.\n              if k_idx in impassable_kinds:\n                  is_impassable = True\n                  break # No need to check other kinds in this cell; it's blocked.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position given the current grid.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:43:51.111091", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  inventory = state.inventory # Get current agent inventory\n\n  # 1. Map the primitive's string name to its unique integer ID.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's an unknown item.\n    return []\n\n  # V2 IMPROVEMENT: Check if the primitive is already in the agent's inventory.\n  # If so, no collection actions are needed, as it is already 'collected' or available.\n  if inventory[primitive_idx] > 0:\n    return []\n\n  # 2. Retrieve the integer codes for movement and 'USE' actions.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # 3. Identify entities that block agent movement (e.g., water, boundaries).\n  blocking_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a grid coordinate is within bounds and not blocked.\n  def is_traversable(x: int, y: int) -> bool:\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of grid bounds\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False  # Cell contains a blocking entity\n    return True\n\n  # 4. Find all grid locations where the desired primitive is present.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # 5. Pre-compute all traversable \"target USE locations\". These are cells\n  # from which the agent can apply the 'USE' action to collect the primitive.\n  # A target USE location must be:\n  #   a) within Chebyshev distance 1 (3x3 neighborhood) of a primitive location.\n  #   b) traversable by the agent.\n  target_use_locations = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        if is_traversable(nx, ny):\n          target_use_locations.add((nx, ny))\n  \n  # If no valid, traversable \"use\" locations exist, the primitive is unreachable.\n  if not target_use_locations:\n      return []\n\n  # 6. Initial check: Is the agent already at a 'target_use_location'?\n  # If so, only the 'USE' action is needed.\n  if agent_pos in target_use_locations:\n    return [USE]\n\n  # 7. Breadth-First Search (BFS) for the shortest path to any target_use_location.\n  queue = collections.deque([(agent_pos, [])]) # Stores ((current_x, current_y), [actions_to_reach_here])\n  visited = {agent_pos} # Stores (x, y) tuples to prevent revisiting nodes\n\n  # Define relative position changes (dx, dy) for each movement action.\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue current position and its path.\n\n    # Explore all four possible neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate coordinates of the new potential position.\n\n      # Check if the new position is valid (within grid bounds), traversable (not blocked),\n      # and has not been visited yet in this BFS.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_position = (nx, ny)\n        new_path_actions = path_actions + [action_type] # Extend the path.\n        \n        # Check if this new position is one of our pre-computed target_use_locations.\n        if new_position in target_use_locations:\n          # Path found to a cell from which 'USE' can be applied.\n          # BFS guarantees this is the shortest path.\n          return new_path_actions + [USE]\n        else:\n          # Not yet a target, add this new position to the queue for further exploration\n          # and mark it as visited.\n          visited.add(new_position)\n          queue.append((new_position, new_path_actions))\n        \n  # 8. If the BFS completes without finding a path to any target_use_location,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:43:52.239039", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, move to, and collect the primitive in the passed env.\n    This version refines the pathfinding and target identification process from v1,\n    focusing on clarity and robust handling of grid traversability.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute (e.g., [UP, UP, USE]).\n  \"\"\"\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos  # Agent's current (x, y) position\n  cookbook = env.world.cookbook\n  \n  # --- 1. Preprocessing: Retrieve necessary IDs and action mappings ---\n  # Convert the string name of the primitive to its integer ID used in the game state.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook's index, it's an unknown item.\n    # In such a case, it cannot be collected.\n    return []\n\n  # Get numerical action codes from the environment's action specification.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape \n\n  # Identify entity types that act as impassable barriers for agent movement.\n  # Common impassable elements in CraftWorld include water and map boundaries.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Define relative position changes (dx, dy) for each movement action.\n  # This makes iterating over neighbors clean and maps directly to action types.\n  movement_deltas = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # --- 2. Helper Function: Check Cell Traversability ---\n  def is_traversable(x: int, y: int) -> bool:\n    \"\"\"Checks if a given grid coordinate is within bounds and free of impassable entities.\"\"\"\n    # First, check if the coordinates are within the grid boundaries.\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    \n    # Next, check if the cell is occupied by any entity marked as impassable.\n    for impassable_idx in impassable_kind_indices:\n      if grid[x, y, impassable_idx] == 1: # If this specific impassable kind is present at (x,y)\n        return False # This cell is an obstacle and cannot be moved into.\n    return True\n\n  # --- 3. Identify Primitive Locations and Valid \"Use\" Target Cells ---\n  # Find all grid cells where instances of the target primitive are located.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # If the primitive is not present anywhere on the current grid, it cannot be collected.\n    return []\n\n  # Determine all valid \"target cells\" from which the agent can successfully\n  # apply the 'USE' action to collect the primitive. A cell is a valid \"use\" target if:\n  #   a) It is located within the 3x3 Chebyshev neighborhood (distance <= 1) of any\n  #      primitive instance on the grid (i.e., it's adjacent or on the same cell).\n  #   b) It is traversable by the agent (i.e., within bounds and not an impassable object).\n  valid_use_targets = set()\n  for px, py in primitive_locations:\n    # Explore the 3x3 neighborhood around each primitive instance (px, py).\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy # Calculate the neighboring cell coordinates.\n        # Only add a cell to our set of potential targets if it's traversable.\n        if is_traversable(nx, ny):\n          valid_use_targets.add((nx, ny))\n  \n  # If, after checking all primitive locations, no traversable \"use\" targets are found,\n  # it means the primitive is fundamentally unreachable (e.g., surrounded by water).\n  if not valid_use_targets:\n      return []\n\n  # --- 4. Immediate Check: Is Agent Already at a Valid \"Use\" Target? ---\n  if agent_pos in valid_use_targets:\n    # If the agent is already positioned correctly, only the 'USE' action is required.\n    return [ACTION_USE]\n\n  # --- 5. Pathfinding (BFS): Find the Shortest Path to Any Valid \"Use\" Target ---\n  # BFS queue: Stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  # The path_actions list tracks the sequence of movements.\n  queue = collections.deque([(agent_pos, [])])\n  \n  # Visited set: Tracks grid cells that have already been explored during BFS\n  # to prevent infinite loops and redundant path explorations.\n  visited_cells = {agent_pos}\n\n  while queue:\n    (cx, cy), current_path = queue.popleft() # Dequeue the current position and its path.\n\n    # Explore all four cardinal neighbors (Up, Down, Left, Right) from the current cell.\n    for action_type, (dx, dy) in movement_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the coordinates of the new potential position.\n      new_position = (nx, ny)\n\n      # Check if the new position is valid for movement and has not been visited yet.\n      if is_traversable(nx, ny) and new_position not in visited_cells:\n        new_path = current_path + [action_type] # Extend the path with the action taken to reach new_position.\n        \n        # If this new position is one of our designated 'valid_use_targets',\n        # we have found the shortest path from the agent's start to a cell\n        # from which the primitive can be collected.\n        if new_position in valid_use_targets:\n          return new_path + [ACTION_USE] # Append 'USE' and return the complete action sequence.\n        else:\n          # If the new position is not yet a target, add it to the queue for further\n          # exploration and mark it as visited to avoid cycles.\n          visited_cells.add(new_position)\n          queue.append((new_position, new_path))\n        \n  # --- 6. Unreachable Primitive ---\n  # If the BFS queue becomes empty without finding any path to a 'valid_use_target',\n  # it implies that the primitive is currently unreachable from the agent's starting position\n  # given the current grid configuration and impassable elements.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:44:29.357361", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name does not correspond to a known item, it cannot be collected.\n      return []\n\n  # Extract necessary state information from the current environment state.\n  state = env._current_state\n  initial_pos = state.pos  # Agent's starting (x, y) coordinates\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # Get the integer action IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas (dx, dy) and their corresponding action IDs for BFS exploration.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one cell down (increase y)\n      ((0, -1), UP_ACTION),   # Move one cell up (decrease y)\n      ((-1, 0), LEFT_ACTION), # Move one cell left (decrease x)\n      ((1, 0), RIGHT_ACTION), # Move one cell right (increase x)\n  ]\n\n  # Find all locations on the grid where the target primitive currently exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if the primitive kind's layer at (x, y) has a non-zero count.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If no instances of the primitive are found on the map, no collection is possible.\n      return []\n\n  # Define \"impassable terrain\": these are non-grabbable entities that block agent movement.\n  # Start with all non-grabbable indices from the world configuration.\n  impassable_terrain_indices = set(env.world.non_grabbable_indices)\n  \n  # Crucially, remove entities that are non-grabbable but are still traversable or interactive points.\n  # For example, workshops and water allow agents to move onto them.\n  impassable_terrain_indices -= set(env.world.workshop_indices)\n  impassable_terrain_indices -= {env.world.water_index}\n\n  # If the target primitive itself is typically an impassable terrain feature (e.g., \"STONE\" or \"WOOD\"\n  # might block movement if they were large, unmineable deposits), we must ensure it's removed\n  # from the impassable set for the purpose of pathfinding. The agent needs to be able to move\n  # onto (or adjacent to) the primitive's location to interact with it.\n  if primitive_idx in impassable_terrain_indices:\n      impassable_terrain_indices.remove(primitive_idx)\n\n  # Helper function to check if a given cell (x, y) is traversable.\n  # This function encapsulates the grid boundary and obstacle checking logic.\n  def _is_traversable(x, y):\n      # First, check if the position is within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Second, check if any impassable terrain kind is present at this cell.\n      # If any kind in `impassable_terrain_indices` has a non-zero count at (x,y),\n      # then the cell is blocked and not traversable.\n      for k_idx in impassable_terrain_indices:\n          if grid[x, y, k_idx] > 0:\n              return False \n      return True # The cell is within bounds and does not contain any impassable obstacles.\n\n  # Perform Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # The visited set stores positions (x,y) to prevent revisiting cells and finding suboptimal paths.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is within the 'USE' range of any primitive location.\n      # The 'USE' action is effective if the agent is within a 3x3 neighborhood\n      # (Chebyshev distance <= 1) of the target primitive.\n      is_within_use_range = False\n      for px, py in primitive_locations:\n          # `max(abs(dx), abs(dy))` computes the Chebyshev distance.\n          if max(abs(cx - px), abs(cy - py)) <= 1:\n              is_within_use_range = True\n              break\n      \n      if is_within_use_range:\n          # If a suitable position is found, append the 'USE' action and return the complete path.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT) from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next cell is traversable and has not been visited yet.\n          if _is_traversable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited to avoid cycles and redundant processing.\n              # Create a new path list by extending the current path. This is crucial\n              # because `path` refers to a list, and we don't want to modify it in place\n              # for other branches of the BFS tree.\n              new_path = list(path)\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable from the current position with the given traversability rules.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T03:44:30.605282", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-02T03:45:24.660997", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This function implements a robust pathfinding strategy using Breadth-First Search (BFS)\n    to guide the agent to a collectable primitive. It prioritizes finding the shortest\n    sequence of movement actions to reach a position from which the primitive can be\n    collected via the 'USE' action.\n\n    The pathfinding algorithm considers the environment's grid layout, identifying\n    impassable obstacles (e.g., boundaries, certain non-grabbable entities) while\n    allowing traversal through other non-grabbable elements that act as interaction\n    points (e.g., workshops, water).\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance, providing access to\n                            the current game state, map layout, and item indices.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of integer action IDs (from `env.action_specs()`)\n                   representing the shortest path to collect the primitive, followed by a 'USE' action.\n                   Returns an empty list if the primitive is not found on the map or is unreachable.\n  \"\"\"\n\n  # Helper function to determine if a cell is traversable.\n  # This makes the main BFS loop cleaner and the logic reusable.\n  def _is_cell_traversable(cell_x: int, cell_y: int, grid_data: np.ndarray, \n                           world_config: craft.CraftWorld, target_primitive_idx: int) -> bool:\n      \"\"\"Determines if a given grid cell can be entered by the agent.\n\n      A cell is traversable if it is within grid bounds and does not contain\n      any non-grabbable obstacles that block movement (excluding special\n      traversable non-grabbables like workshops or water, and the target\n      primitive itself, which can be walked upon).\n\n      Args:\n          cell_x (int): The x-coordinate of the cell to check.\n          cell_y (int): The y-coordinate of the cell to check.\n          grid_data (np.ndarray): The current grid state.\n          world_config (craft.CraftWorld): The world configuration with entity indices.\n          target_primitive_idx (int): The integer index of the primitive being collected.\n\n      Returns:\n          bool: True if the cell is traversable, False otherwise.\n      \"\"\"\n      grid_width, grid_height, num_kinds = grid_data.shape\n      \n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= cell_x < grid_width and 0 <= cell_y < grid_height):\n          return False # Out of bounds cells are not traversable.\n\n      # 2. Check the contents of the cell for any impassable obstacles.\n      # Iterate through all possible item kinds that could be at this cell.\n      for k_idx in range(num_kinds):\n          # If something of kind `k_idx` is present at this cell (count > 0).\n          if grid_data[cell_x, cell_y, k_idx] > 0:\n              # If the cell contains the target primitive itself, the agent can traverse it.\n              if k_idx == target_primitive_idx:\n                  continue # Not an obstacle for movement.\n              \n              # If it's a non-grabbable item, check if it's a special traversable one.\n              if k_idx in world_config.non_grabbable_indices:\n                  # Workshops and water are non-grabbable but are traversable for interaction.\n                  if k_idx in world_config.workshop_indices or k_idx == world_config.water_index:\n                      continue # Allow movement onto these special non-grabbable entities.\n                  else:\n                      # Any other non-grabbable entity (e.g., 'BOUNDARY') is an impassable obstacle.\n                      return False # Impassable obstacle found.\n      \n      # If no blocking obstacles were found after checking all kinds in the cell, it is traversable.\n      return True\n\n  # --- Main logic of collect_v2 starts here ---\n\n  # 1. Map the primitive name to its integer index using the environment's cookbook.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is unknown, it cannot be collected.\n      return []\n\n  # 2. Extract necessary state information from the current environment state.\n  state = env._current_state\n  initial_pos = state.pos  # Agent's current (x, y) coordinates.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  world = env.world        # Reference to the CraftWorld configuration for entity properties.\n  grid_width, grid_height, _ = grid.shape # Dimensions of the grid.\n\n  # 3. Get the integer action IDs from the environment's action specifications.\n  action_map = env.action_specs()\n  # Using the map ensures robustness against potential changes, though unlikely for these fixed actions.\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas (dx, dy) and their corresponding action IDs for BFS exploration.\n  # This structured approach helps in iterating through neighbors.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down, corresponding action ID.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # 4. Find all locations on the grid where the target primitive currently exists.\n  # These are the potential targets for the collection action.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # A primitive is present if its count at (x, y) is greater than 0.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If no instances of the primitive are found on the map, collection is impossible.\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path to a collectable position.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # The `visited` set tracks positions already explored to prevent cycles and redundant work.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position allows using the 'USE' action to collect any primitive.\n      # The 'USE' action is effective within a 3x3 neighborhood of the primitive's location.\n      is_within_use_range = False\n      for px, py in primitive_locations:\n          # `max(abs(cx - px), abs(cy - py))` calculates the Chebyshev distance (L-infinity norm).\n          # If this distance is <= 1, it means (cx, cy) is within the 3x3 square centered at (px, py).\n          if max(abs(cx - px), abs(cy - py)) <= 1:\n              is_within_use_range = True\n              break # Found a primitive within 'USE' range, no need to check other primitive locations.\n      \n      if is_within_use_range:\n          # If a suitable position is found, append the 'USE' action and return the complete path.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Use the nested helper function to check if the next cell is traversable.\n          if _is_cell_traversable(next_x, next_y, grid, world, primitive_idx):\n              # If the cell is traversable and has not been visited yet, add it to the queue.\n              if next_pos not in visited:\n                  visited.add(next_pos)\n                  # Create a new path list by extending the current path.\n                  # This is crucial for BFS to maintain independent paths.\n                  new_path = list(path)\n                  new_path.append(action_id)\n                  queue.append((next_pos, new_path))\n  \n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
