{"timestamp": "2025-08-02T07:00:00.482563", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Determine if the primitive is grabbable.\n  # Non-grabbable primitives like WORKSHOPs should not be 'USE'd for collection.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    cx, cy = current_pos\n\n    # Optimize the 'next_to' check by directly inspecting the grid's 3x3 neighborhood\n    # around current_pos, instead of creating a temporary CraftState object.\n    found_primitive_nearby = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = cx + dx_adj, cy + dy_adj\n        \n        # Check if the adjacent cell is within grid boundaries\n        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n          # Check if the primitive is present at this adjacent cell (primitive_idx layer)\n          if grid[adj_x, adj_y, primitive_idx]:\n            found_primitive_nearby = True\n            break # Found the primitive in the 3x3 neighborhood\n      if found_primitive_nearby:\n        break\n\n    if found_primitive_nearby:\n      # If a position is found from which the primitive can be 'collected'\n      if is_grabbable:\n        return current_path + [USE]\n      else:\n        # If not grabbable (e.g., a workshop, water, boundary), just return the path\n        # to get next to it. The 'collect' action for non-grabbables implies reaching proximity.\n        return current_path\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in moves:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and has not been visited yet\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n        visited.add(next_pos)\n        queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found (e.g., primitive not reachable),\n  # return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
