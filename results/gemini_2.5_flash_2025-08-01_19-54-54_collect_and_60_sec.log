{"timestamp": "2025-08-02T05:50:32.513702", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This function finds the shortest sequence of actions to collect a specified primitive.\n  It uses a Breadth-First Search (BFS) to navigate the grid, considering the specific\n  collection mechanics for different primitive types (grabbable, workshop, stationary).\n  The primary improvement over v1 is a more robust pruning logic when adding states to the BFS queue,\n  which ensures that exploration branches that are already guaranteed to be longer than the\n  best path found so far are not expanded.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Direct access to the grid for efficiency\n  \n  # 1. Map the primitive name to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions relative to current position\n  # Each tuple: (delta_x, delta_y, action_id)\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Get grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for BFS\n  start_pos = current_state.pos\n\n  # BFS initialization\n  # Queue stores (current_position, list_of_actions_taken_to_reach_here)\n  bfs_queue = collections.deque([(start_pos, [])]) \n  # visited_positions stores (x, y) coordinates of positions for which we have already found\n  # the shortest path *to that position*. This prevents revisiting the same cell via a longer path.\n  visited_positions = {start_pos} \n\n  # Variables to store the shortest path found to a collection point\n  min_total_actions_len = float('inf') \n  shortest_path_actions = []     \n\n  # Determine the collection mechanism based on primitive type\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS traversal loop\n  while bfs_queue:\n    current_pos, actions_to_current_pos = bfs_queue.popleft()\n    cx, cy = current_pos # Deconstruct current_pos for direct grid access\n\n    # Pruning 1 (after popping): If the current path to this position (plus a potential USE action)\n    # is already as long as or longer than the best complete path found so far,\n    # then any path extending from here cannot be shorter. Prune this branch.\n    current_path_len_plus_use_if_applicable = len(actions_to_current_pos) + (1 if is_grabbable else 0)\n    if current_path_len_plus_use_if_applicable >= min_total_actions_len:\n        continue \n\n    # Check if the current position allows collection of the primitive\n    goal_achieved_from_current_pos = False\n    actions_to_complete_collection = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them\n      # and then perform a 'USE' action. Check the 3x3 neighborhood.\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adj_x, adj_y = cx + dx_adj, cy + dy_adj\n          # Check bounds for the adjacent cell\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n            # Check if the primitive is present in the adjacent cell\n            if grid[adj_x, adj_y, primitive_idx] > 0:\n              goal_achieved_from_current_pos = True\n              actions_to_complete_collection = [ACTION_USE] # Add the 'USE' action\n              break # Found in neighborhood, no need to check further adjacent cells\n        if goal_achieved_from_current_pos: # Break outer loop too\n            break\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, boundary, collection means being at the location itself.\n      # Check if the primitive is present at the current cell.\n      if grid[cx, cy, primitive_idx] > 0:\n        goal_achieved_from_current_pos = True\n        actions_to_complete_collection = [] # No 'USE' action needed for these\n    \n    # If the goal is achieved from the current position, update the shortest path found so far\n    if goal_achieved_from_current_pos:\n      current_full_path_len = len(actions_to_current_pos) + len(actions_to_complete_collection)\n      if current_full_path_len < min_total_actions_len:\n        min_total_actions_len = current_full_path_len\n        shortest_path_actions = actions_to_current_pos + actions_to_complete_collection\n      # Important: Do not `break` here. BFS must continue to ensure we find the *absolute*\n      # shortest path, as other paths might lead to a different instance of the primitive\n      # (or a different cell allowing collection) that is overall shorter.\n\n    # Explore valid neighbors (movements)\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if this position has not been visited via a shorter or equal path\n        if new_pos not in visited_positions:\n          # Pruning 2 (before adding to queue):\n          # Estimate the total path length if we were to reach `new_pos` and immediately collect.\n          # `len(actions_to_current_pos) + 1` is the movement cost to `new_pos`.\n          # `(1 if is_grabbable else 0)` is the additional cost for the 'USE' action.\n          estimated_total_actions_for_new_pos = len(actions_to_current_pos) + 1 + (1 if is_grabbable else 0)\n          \n          # Only add this new position to the queue if its *estimated total path length*\n          # is strictly shorter than the best complete path found so far.\n          if estimated_total_actions_for_new_pos < min_total_actions_len: \n              visited_positions.add(new_pos) # Mark as visited to prevent redundant processing for this path length\n              bfs_queue.append((new_pos, actions_to_current_pos + [move_action]))\n  \n  # After BFS completes, return the shortest path found\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T05:50:33.687135", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using a more direct BFS approach for shortest path to any goal.\n\n    This function finds the shortest sequence of actions (movements and 'USE' action)\n    to reach and collect a specified primitive from the environment. It correctly\n    handles grabbable items (requiring a 'USE' action when adjacent) and\n    stationary/workshop items (requiring the agent to be on the same cell).\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"WATER\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is not found or cannot be collected.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Access the current grid for primitive locations\n  \n  # 1. Map the primitive name to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not recognized by the cookbook; cannot collect.\n    return []\n\n  # Get action mappings from the environment's action_specs for clarity\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions and their corresponding (dx, dy) offsets\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for the BFS\n  start_pos = current_state.pos\n\n  # Determine the collection mechanism based on primitive type\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  # Stationary primitives like water, stone, boundary are not \"grabbable\" and don't need 'USE'\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS initialization: queue stores (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited grid positions to avoid cycles and redundant paths\n  visited = {start_pos} \n\n  # BFS traversal loop\n  while q:\n    current_pos, path_actions = q.popleft()\n    cx, cy = current_pos # Deconstruct current_pos for direct grid access\n\n    # Check if the current position allows collection of the primitive\n    can_collect_from_here = False\n    actions_to_complete_collection = [] # Additional actions needed at current_pos (e.g., USE)\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be in a 3x3 neighborhood of the item.\n      # Replicate `CraftState.next_to(primitive_idx)` logic.\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adj_x, adj_y = cx + dx_adj, cy + dy_adj\n          # Check bounds for the adjacent cell\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n            # Check if the primitive is present in the adjacent cell\n            if grid[adj_x, adj_y, primitive_idx] > 0:\n              can_collect_from_here = True\n              actions_to_complete_collection = [ACTION_USE] # Add the 'USE' action\n              break # Found item in neighborhood, no need to check further\n        if can_collect_from_here: # Break outer loop too\n            break\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, boundary, collection means being directly on the cell.\n      if grid[cx, cy, primitive_idx] > 0:\n        can_collect_from_here = True\n        # No 'USE' action is typically needed for these\n        actions_to_complete_collection = [] \n    \n    # If the goal is achieved from the current position\n    if can_collect_from_here:\n      # Since this is a Breadth-First Search on an unweighted graph (each move costs 1),\n      # the first path found to any valid collection point is guaranteed to be the shortest.\n      return path_actions + actions_to_complete_collection\n\n    # Explore valid neighbors (movement actions)\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries and has not been visited yet\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT and new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, path_actions + [move_action]))\n  \n  # If the BFS completes and no path was found to any instance of the primitive, return an empty list.\n  return []", "island_id": 3, "scores": {"3": 0.5}}
