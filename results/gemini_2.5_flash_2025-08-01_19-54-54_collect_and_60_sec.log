e = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:03:49.914222", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If it is, no further actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 2. Check if the primitive is a non-grabbable entity (e.g., a workshop, water, boundary).\n  # If it's non-grabbable, it cannot be 'collected' in the sense of picking it up into inventory.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state details for BFS\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, grid_depth = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Identify truly impassable objects. Workshops are non-grabbable but traversable.\n  impassable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # Helper function to check if a given position is traversable (not blocked by an obstacle).\n  def is_traversable(pos_x, pos_y, current_grid):\n    # Check if the position is within grid boundaries.\n    if not (0 <= pos_x < grid_width and 0 <= pos_y < grid_height):\n      return False\n    \n    # Check if the cell contains any impassable entities.\n    # Iterate through all possible kind indices at this position.\n    for kind_idx in range(grid_depth):\n      if current_grid[pos_x, pos_y, kind_idx] > 0 and kind_idx in impassable_indices:\n        return False # This cell contains an impassable obstacle\n    return True # The cell is traversable\n\n  # Helper function to check if a given position is next to (or on) the target primitive.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True.\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0.\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  # Each element is (current_position, list_of_actions_to_reach_current_position)\n  q = collections.deque([(start_pos, [])])\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path.\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions.\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries AND traversable\n      if not is_traversable(next_x, next_y, grid):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T02:03:51.087531", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If it is, no further actions are needed to \"collect\" it.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 2. Check if the primitive is a non-grabbable entity (e.g., a workshop, water, boundary).\n  # If it's non-grabbable, it cannot be 'collected' in the sense of picking it up into inventory.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state details for BFS\n  grid = current_state.grid\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Get initial direction\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas and resulting direction for each action\n  # Assuming CraftState.dir mapping: 0=North (UP), 1=East (RIGHT), 2=South (DOWN), 3=West (LEFT)\n  MOVE_ACTIONS_WITH_DIR = {\n      ACTION_UP: (0, -1, 0),    # Move North, Face North\n      ACTION_DOWN: (0, 1, 2),     # Move South, Face South\n      ACTION_LEFT: (-1, 0, 3),  # Move West, Face West\n      ACTION_RIGHT: (1, 0, 1)   # Move East, Face East\n  }\n\n  # Helper to get the cell immediately in front of the agent based on its current position and direction.\n  def get_forward_cell(pos, direction):\n    px, py = pos\n    if direction == 0:  # North (UP)\n        return (px, py - 1)\n    elif direction == 1:  # East (RIGHT)\n        return (px + 1, py)\n    elif direction == 2:  # South (DOWN)\n        return (px, py + 1)\n    elif direction == 3:  # West (LEFT)\n        return (px - 1, py)\n    return None # Should not happen\n\n  # Initialize BFS queue with the starting state (position, direction, path)\n  # Each element is (current_position, current_direction, list_of_actions_to_reach_current_state)\n  q = collections.deque([(start_pos, start_dir, [])])\n  # Keep track of visited (position, direction) pairs to avoid cycles and redundant exploration\n  visited = {(start_pos, start_dir)}\n\n  # BFS loop\n  while q:\n    curr_pos, curr_dir, path = q.popleft()\n\n    # Check if the cell *in front* of the agent contains the primitive.\n    # If it does, we've found a path to a position from which we can USE the primitive.\n    target_cell = get_forward_cell(curr_pos, curr_dir)\n    if target_cell:\n      tx, ty = target_cell\n      # Ensure target cell is within grid boundaries\n      if 0 <= tx < grid_width and 0 <= ty < grid_height:\n        # Check if the primitive is present at the target cell\n        if grid[tx, ty, primitive_idx] > 0:\n          # Append the USE action and return the complete sequence of actions.\n          return path + [ACTION_USE]\n\n    # Explore all possible movement actions from the current state\n    for action, (dx, dy, new_dir) in MOVE_ACTIONS_WITH_DIR.items():\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # The agent cannot move through non-grabbable obstacles (like boundaries or workshops).\n      # This check ensures we don't try to path through impassable terrain.\n      # We check the grid layer for any non-grabbable item at the next position.\n      is_impassable = False\n      for idx in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, idx] > 0:\n              is_impassable = True\n              break\n      if is_impassable:\n          continue\n\n      # If the next state (position, direction) has not been visited, add it to the queue\n      next_state_tuple = (next_pos, new_dir)\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        q.append((next_pos, new_dir, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T02:04:47.691277", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version refactors the pathfinding logic into a reusable helper function\n  for better modularity and readability, and clarifies constant definitions.\n  \"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos\n  cookbook = env.world.cookbook\n\n  # 1. Retrieve the integer ID for the target primitive from the cookbook.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Define action integer mappings and constant directional movements.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (dx, dy) movement vectors to corresponding action integers.\n  # This is used for reconstructing the path from the BFS results.\n  DIR_TO_ACTION = {\n      (0, -1): UP,    # Move Y-axis negatively (Up on a typical grid)\n      (0, 1): DOWN,   # Move Y-axis positively (Down)\n      (-1, 0): LEFT,  # Move X-axis negatively (Left)\n      (1, 0): RIGHT,  # Move X-axis positively (Right)\n  }\n  \n  # List of possible 4-directional movements (used in BFS neighbor exploration).\n  CARDINAL_DIRECTIONS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Identify indices of impassable terrain.\n  # Common impassable elements like 'BOUNDARY' and 'WATER' are used here.\n  IMPASSABLE_NAMES = ['BOUNDARY', 'WATER']\n  impassable_indices = {\n      cookbook.index[name] for name in IMPASSABLE_NAMES\n      if name in cookbook.index.contents\n  }\n\n  # Helper function to check if a given cell (x, y) is traversable by the agent.\n  # A cell is traversable if it is within grid bounds and does not contain any impassable entity.\n  def _is_cell_traversable(x: int, y: int) -> bool:\n      \"\"\"Checks if the cell (x, y) is within bounds and traversable.\"\"\"\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Contains an impassable object\n      return True\n\n  # Initial check: if the agent's current position is impassable, no movement is possible.\n  if not _is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # 4. Locate all instances of the primitive on the grid.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # If the primitive is not present on the grid, it cannot be collected.\n    return []\n\n  # 5. Determine the set of valid target cells for BFS.\n  # These are traversable cells from which the agent can 'USE' (collect) the primitive.\n  # According to CraftState.next_to, this implies any cell within a 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = px + dx_n, py + dy_n\n        \n        # Add the neighboring cell to target cells if it's traversable.\n        if _is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no traversable target cells are found around any primitive, collection is impossible.\n  if not bfs_target_cells:\n      return []\n\n  # 6. Perform Breadth-First Search (BFS) to find the shortest path to any target cell.\n  # The queue stores tuples of (current_position, list_of_actions_to_reach_current_position).\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set to keep track of visited positions to prevent cycles and redundant work.\n\n  while q:\n    current_pos, path_so_far = q.popleft()\n    \n    # If the current position is one of our BFS target cells, we've found the shortest path.\n    if current_pos in bfs_target_cells:\n      # Append the 'USE' action to the path and return the complete sequence of actions.\n      return path_so_far + [USE]\n\n    # Explore valid 4-directional neighbors from the current position.\n    for dx, dy in CARDINAL_DIRECTIONS:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid bounds, is traversable, and has not been visited yet.\n      if _is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos) # Mark as visited.\n        # Create a new path by appending the action taken to move to the next position.\n        new_path = path_so_far + [DIR_TO_ACTION[(dx, dy)]]\n        q.append((next_pos, new_path)) # Add to queue for further exploration.\n  \n  # If the queue becomes empty and no path was found to any target cell, the primitive is unreachable.\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:04:48.811850", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive from the cookbook's index mapping.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve integer mappings for actions from the environment's action specifications.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Map (dx, dy) directional changes to their corresponding action integers.\n  # This is used to reconstruct the path from parent pointers in BFS.\n  dir_to_action = {\n      (0, -1): UP,    # Move North\n      (0, 1): DOWN,   # Move South\n      (-1, 0): LEFT,  # Move West\n      (1, 0): RIGHT,  # Move East\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Define indices for terrain types that are impassable to the agent.\n  # Based on the environment's typical setup, 'BOUNDARY' and 'WATER' are usually non-traversable.\n  IMPASSABLE_NAMES = ['BOUNDARY', 'WATER']\n  impassable_indices = {\n      cookbook.index[name] for name in IMPASSABLE_NAMES \n      if name in cookbook.index.contents\n  }\n\n  # Helper function to determine if a given grid cell (x, y) is traversable by the agent.\n  # A cell is traversable if it's within the grid boundaries and does not contain any impassable entity.\n  def is_cell_traversable(x, y):\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Cell is out of grid bounds.\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Cell contains an impassable object.\n      return True\n\n  # Pre-check: If the agent's current position is impassable, no movement is possible.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # Find all grid locations where the target primitive exists.\n  # np.argwhere returns (row, col) pairs where the condition is true.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # If the primitive is not present anywhere on the current grid, return no actions.\n    return []\n\n  # Identify all potential 'target cells' for the BFS.\n  # A target cell is a traversable cell from which the agent can 'USE' the primitive.\n  # According to CraftState.next_to, this means any traversable cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        \n        # Add the neighboring cell to the set of targets if it's traversable.\n        if is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no traversable target cells exist (e.g., all primitives are surrounded by impassable terrain),\n  # then the primitive cannot be reached.\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any of the `bfs_target_cells`.\n  # The queue stores tuples of `((current_x, current_y), list_of_actions_taken_to_reach_here)`.\n  q = collections.deque([(agent_pos, [])])\n  # Keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # If the current position is one of the valid target cells, we have found the shortest path.\n    if current_pos in bfs_target_cells:\n      # Append the 'USE' action to the movement path and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid 4-directional neighbors (UP, DOWN, LEFT, RIGHT).\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is traversable and has not been visited yet.\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action required to move to `next_pos`.\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell,\n  # it means the primitive is unreachable from the current agent position.\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:05:31.807846", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      # This indicates an invalid primitive argument for collection.\n      return []\n\n  state = env._current_state\n  # Early exit: If the agent already possesses at least one unit of the desired primitive,\n  # no collection actions are necessary.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # The `collect` function is specifically for gathering items into the agent's inventory.\n  # Therefore, the target primitive must be a 'grabbable' item. If it's not,\n  # it cannot be collected using this mechanism.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  agent_pos = state.pos  # The agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds) representing cell contents.\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Retrieve integer mappings for movement and 'USE' actions from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs for Breadth-First Search (BFS).\n  # This facilitates iterating through neighboring cells and associating them with a specific action.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one step down (increase y)\n      ((0, -1), UP_ACTION),   # Move one step up (decrease y)\n      ((-1, 0), LEFT_ACTION), # Move one step left (decrease x)\n      ((1, 0), RIGHT_ACTION), # Move one step right (increase x)\n  ]\n\n  # Identify all grid locations where the target primitive resource is present.\n  # This helps in defining the targets for the BFS.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if there's any quantity of the primitive kind at this specific cell.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it's impossible to collect it.\n  if not primitive_locations:\n      return []\n\n  # Define entities that are typically non-grabbable but the agent can still move through.\n  # This set includes workshops and water, which function as traversable terrain despite being non-grabbable.\n  traversable_non_grabbables = set(env.world.workshop_indices)\n  if env.world.water_index is not None:\n      traversable_non_grabbables.add(env.world.water_index)\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest sequence of actions.\n  # The queue stores tuples of (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # A set to keep track of visited positions to prevent infinite loops and redundant path exploration.\n  visited = {agent_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is \"adjacent\" to any of the primitive's locations.\n      # The 'USE' action in CraftWorld typically operates within a 3x3 neighborhood (Manhattan distance <= 1).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # If the agent is on the same cell as the primitive or one step away (cardinal or diagonal).\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, the agent can now 'USE' to collect the primitive.\n          # Append the 'USE' action to the path and return the complete sequence.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the prospective next position is within the defined grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or if it contains an impassable obstacle.\n          # A cell is considered blocked if it contains any non-grabbable entity that is NOT\n          # explicitly defined as traversable (e.g., workshops, water).\n          cell_is_blocked = False\n          # Get the indices of all item kinds present at the next potential position.\n          kinds_at_next_pos = np.where(grid[next_x, next_y] > 0)[0] \n          \n          for k_idx in kinds_at_next_pos:\n              # If the item is non-grabbable AND not in our list of traversable non-grabbables.\n              if k_idx in env.world.non_grabbable_indices and k_idx not in traversable_non_grabbables:\n                  cell_is_blocked = True\n                  break # This cell contains an unpassable obstacle, no need to check further.\n          \n          if cell_is_blocked:\n              continue # Skip this path as the cell is blocked by an obstacle.\n\n          # If the cell is traversable and has not been visited in this BFS,\n          # add it to the queue for further exploration.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying the original path list\n              # which belongs to a different branch in the BFS tree.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive location\n  # was found, it implies that the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:05:32.931598", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Uses precomputation of target cells to optimize the BFS search for primitive locations.\n  \"\"\"\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  state = env._current_state\n  # If the agent already has at least one of the primitive, no collection actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # The 'collect' function is designed for items that go into the agent's inventory.\n  # If the primitive is not in the set of grabbable items, it cannot be \"collected\" this way.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs for BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),\n      ((0, -1), UP_ACTION),\n      ((-1, 0), LEFT_ACTION),\n      ((1, 0), RIGHT_ACTION),\n  ]\n\n  # Define specific non-grabbable entities that the agent can traverse (e.g., workshops, water).\n  # These are exceptions to the general rule that non-grabbables block movement.\n  traversable_non_grabbables = set(env.world.workshop_indices)\n  if env.world.water_index is not None:\n      traversable_non_grabbables.add(env.world.water_index)\n\n  # Precompute 'target cells': any cell (x, y) from which the USE action can acquire the primitive.\n  # This includes cells directly containing the primitive and cells in their 3x3 neighborhood.\n  target_cells_grid = np.full((grid_width, grid_height), False, dtype=bool)\n  \n  # First, identify all cells where the primitive *actually exists*.\n  primitive_locations_on_grid = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      # If no instances of the primitive are found on the grid, it's unreachable.\n      return []\n\n  # Now, for each primitive location, mark its 3x3 neighborhood as a target cell.\n  # An agent standing on any of these target cells can 'USE' to collect the primitive.\n  for px, py in primitive_locations_on_grid:\n      for nx_offset in range(-1, 2): # -1, 0, 1\n          for ny_offset in range(-1, 2): # -1, 0, 1\n              nx, ny = px + nx_offset, py + ny_offset\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  target_cells_grid[nx, ny] = True\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell marked as a target cell.\n  # Queue elements are (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is a precomputed target cell.\n      if target_cells_grid[cx, cy]:\n          # If a target cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement actions + 'USE').\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is blocked if it contains any non-grabbable entity that is\n          # NOT explicitly marked as traversable (like workshops or water).\n          cell_is_blocked = False\n          # Get indices of all kinds present at the next position.\n          # np.where returns a tuple of arrays, we need the first element for the indices.\n          kinds_at_next_pos = np.where(grid[next_x, next_y] > 0)[0] \n          \n          for k_idx in kinds_at_next_pos:\n              if k_idx in env.world.non_grabbable_indices and k_idx not in traversable_non_grabbables:\n                  cell_is_blocked = True\n                  break # Found a blocking obstacle, no need to check further kinds in this cell.\n          \n          if cell_is_blocked:\n              continue # Skip this path if the cell is blocked by an obstacle.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path) # Create a new path list for this branch to avoid modifying shared lists.\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
