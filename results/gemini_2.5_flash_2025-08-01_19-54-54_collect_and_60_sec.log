{"timestamp": "2025-08-01T23:35:05.537085", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # Improvement for collect_v2:\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # 2. Get current state details\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # This function checks the static grid for the primitive's location relative to check_pos\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:35:06.777729", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # Improvement for collect_v2 (re-introducing the check from collect_v0):\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # 2. Get current state details\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:35:35.861837", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not have an ID, we cannot collect it.\n    return []\n\n  # 2. Retrieve action mappings (integer IDs) from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define possible movements (change in x, change in y) and their corresponding action IDs.\n  # This list helps iterate over adjacent cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # 4. Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Agent's current starting position in the grid.\n  start_pos = state.pos\n\n  # --- BFS (Breadth-First Search) Setup ---\n  # The queue will store tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # 6. Determine the type of the target primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, or boundary.\n  # \"Collecting\" these typically means simply reaching their location without a `USE` action.\n  # We use .get() for 'BOUNDARY' to safely handle cases where it might not be in the index.\n  boundary_idx = cookbook.index.get('BOUNDARY')\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (boundary_idx is not None and primitive_idx == boundary_idx))\n  \n  # --- BFS Algorithm Execution ---\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object representing the agent *at* `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) or directly inspect `grid` content\n    # as if the agent were physically at this specific cell during pathfinding.\n    # Agent's direction and inventory are kept constant as they do not affect the geometry of pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 7. Check if the `current_pos` satisfies the goal for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time\n    # a goal state is reached (i.e., its path is popped from the queue), that path is the shortest.\n    if is_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move\n      # to a cell *adjacent* to it and then perform a `USE` action to pick it up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No `USE` action is typically needed.\n      # We check if the primitive_idx layer at the current position has a count greater than 0.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, no additional action needed beyond movement.\n    \n    # 8. If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries (0 <= x < WIDTH, 0 <= y < HEIGHT).\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this position hasn't been visited yet, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and the queue becomes empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T23:35:37.156059", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not have an ID, we cannot collect it.\n    return []\n\n  # 2. Retrieve action mappings (integer IDs) from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define possible movements (change in x, change in y) and their corresponding action IDs.\n  # This list helps iterate over adjacent cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move Down (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move Right (increases X coordinate)\n  ]\n\n  # 4. Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Agent's current starting position in the grid.\n  start_pos = state.pos\n\n  # --- BFS (Breadth-First Search) Setup ---\n  # The queue will store tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # 6. Determine the type of the target primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, or boundary.\n  # \"Collecting\" these typically means simply reaching their location without a `USE` action.\n  # We assume 'BOUNDARY' is an indexed kind in the cookbook for consistency.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (primitive == 'BOUNDARY' and cookbook.index.get('BOUNDARY') == primitive_idx))\n  \n  # --- BFS Algorithm Execution ---\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object representing the agent *at* `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) or directly inspect `grid` content\n    # as if the agent were physically at this specific cell during pathfinding.\n    # Agent's direction and inventory are kept constant as they do not affect the geometry of pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 7. Check if the `current_pos` satisfies the goal for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time\n    # a goal state is reached (i.e., its path is popped from the queue), that path is the shortest.\n    if is_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move\n      # to a cell *adjacent* to it and then perform a `USE` action to pick it up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No `USE` action is typically needed.\n      # We check if the primitive_idx layer at the current position has a count greater than 0.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, no additional action needed beyond movement.\n    \n    # 8. If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries (0 <= x < WIDTH, 0 <= y < HEIGHT).\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this position hasn't been visited yet, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and the queue becomes empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:35:57.214078", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Get indices of non-grabbable items (obstacles)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position is an obstacle\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      # If the cell is walkable and not visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:35:58.412446", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by considering non-traversable obstacles.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Identify non-traversable indices (excluding workshops, which are locations one might move to)\n  non_traversable_indices = env.world.non_grabbable_indices.copy()\n  # Workshops are considered traversable locations\n  for ws_idx in env.world.workshop_indices:\n      if ws_idx in non_traversable_indices:\n          non_traversable_indices.remove(ws_idx)\n\n  def is_traversable(pos_x, pos_y):\n    \"\"\"Checks if a cell at (pos_x, pos_y) is traversable.\"\"\"\n    # Check boundaries first\n    if not (0 <= pos_x < WIDTH and 0 <= pos_y < HEIGHT):\n      return False\n    \n    # Check if the cell contains any non-traversable items\n    for k_idx in range(N_KINDS):\n      if grid[pos_x, pos_y, k_idx] > 0 and k_idx in non_traversable_indices:\n        return False # This cell contains a non-traversable obstacle\n    return True\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries, not visited, and traversable\n      if is_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:36:58.393722", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, approach, and collect the specified primitive\n    in the passed CraftLab environment. This function uses a Breadth-First Search (BFS)\n    to find the shortest sequence of actions.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (e.g., craft.UP, craft.USE) to execute.\n                   Returns an empty list if the primitive is already collected or unreachable.\n  \"\"\"\n  # Access the current state and world configuration from the environment.\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Convert the string name of the primitive to its integer index using the cookbook's index.\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # Get the dimensions of the game grid.\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # --- Early Exit Condition ---\n  # If the primitive is a grabbable item (like \"WOOD\" or \"IRON\") AND\n  # the agent already has at least one in its inventory, no actions are needed.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # --- Action Definitions ---\n  # Define the agent's movement actions and their effects:\n  # (row_delta, col_delta, new_facing_direction_after_move)\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Action IDs from `craft` module: craft.DOWN=0, craft.UP=1, craft.LEFT=2, craft.RIGHT=3, craft.USE=4\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Move North (row - 1), face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (col + 1), face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (row + 1), face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (col - 1), face West (dir 3)\n  }\n  \n  # Map agent's facing direction to the (row_delta, col_delta) of the cell *directly in front* of the agent.\n  # This is used for 'USE' action logic on non-grabbable items.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # Facing North (UP)\n      1: (0, 1),   # Facing East (RIGHT)\n      2: (1, 0),   # Facing South (DOWN)\n      3: (0, -1)   # Facing West (LEFT)\n  }\n\n  # --- Pre-fetch Common Indices for Efficiency ---\n  non_grabbable_indices = world.non_grabbable_indices\n  grabbable_indices = world.grabbable_indices\n  workshop_indices = world.workshop_indices\n  \n  # --- Helper Function: Check if a Grid Cell is Walkable ---\n  def _is_walkable(r: int, c: int) -> bool:\n      \"\"\"\n      Determines if the agent can move onto the specified grid cell (r, c).\n      \n      Args:\n          r (int): Row index of the cell.\n          c (int): Column index of the cell.\n          \n      Returns:\n          bool: True if the cell is within bounds and does not contain an impassable object,\n                False otherwise.\n      \"\"\"\n      # 1. Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # 2. Check for impassable non-grabbable obstacles.\n      # Iterate through all non-grabbable item types.\n      for idx in non_grabbable_indices:\n          # If the cell contains this non-grabbable item:\n          if current_state.grid[r, c, idx] == 1:\n              # Workshops are a special type of non-grabbable that *are* walkable.\n              # All other non-grabbable items are considered impassable obstacles.\n              if idx not in workshop_indices:\n                  return False # This cell contains an impassable non-grabbable.\n      \n      # If no non-grabbable obstacle was found, the cell is walkable.\n      return True\n\n  # --- Breadth-First Search (BFS) Initialization ---\n  # The BFS queue stores tuples of: (row, col, current_direction, list_of_actions_taken)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # The 'visited' set keeps track of unique states (position + direction) to avoid cycles\n  # and redundant exploration, ensuring the shortest path is found.\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # --- BFS Loop: Explore Possible Paths ---\n  while q:\n      r, c, current_dir, path = q.popleft() # Get the current state and path from the queue.\n\n      # --- Goal Check 1: Collecting Grabbable Primitives ---\n      # If the target primitive is grabbable (e.g., \"WOOD\", \"GRASS\") and\n      # the agent is currently standing on a cell containing this primitive, it's collected.\n      if primitive_idx in grabbable_indices and current_state.grid[r, c, primitive_idx] == 1:\n          return path # The current path is the shortest to collect the grabbable item.\n\n      # --- Goal Check 2: Collecting Non-Grabbable Primitives ---\n      # For non-grabbable items (e.g., \"WATER\", \"STONE\", \"WORKSHOP\"), the agent needs to be\n      # adjacent to the item and facing it, then execute the 'USE' action.\n      \n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = DIR_TO_DELTA[current_dir]\n      front_r, front_c = r + front_dr, c + front_dc\n      \n      # Ensure the 'front' cell is within grid boundaries before checking its contents.\n      if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n          # If the cell in front contains the target primitive and it's non-grabbable,\n          # then the agent is in a position to collect it with a 'USE' action.\n          if primitive_idx in non_grabbable_indices and current_state.grid[front_r, front_c, primitive_idx] == 1:\n              return path + [craft.USE] # Append 'USE' to the path and return.\n\n      # --- Explore Next Movements ---\n      # For each possible directional movement (UP, DOWN, LEFT, RIGHT):\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          # Calculate the coordinates of the next potential cell.\n          next_r, next_c = r + dr, c + dc\n\n          # If the next cell is walkable (not out of bounds and not an obstacle):\n          if _is_walkable(next_r, next_c):\n              # Define the new state (position and direction).\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              \n              # If this new state has not been visited before:\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple) # Mark as visited.\n                  # Add the new state to the queue with the updated path.\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable or not present on the map.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:36:59.595023", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-01T23:38:44.803774", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. This function finds the shortest path to an adjacent cell of the specified primitive and then uses it to collect the primitive into inventory.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object containing the current simulation state.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices (movements and 'USE') to execute to collect the primitive.\n                   Returns an empty list if the primitive is already collected, not grabbable,\n                   not found on the map, or unreachable.\n  \"\"\"\n  # Map the primitive name string to its integer index using the environment's cookbook.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized by the environment, it cannot be collected.\n      return []\n\n  # Access the current state of the agent and environment.\n  state = env._current_state\n\n  # Optimization: Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the primitive, no further actions are needed for collection.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # Pre-condition check: Determine if the primitive is a \"grabbable\" item.\n  # The 'collect' function implies placing an item into inventory. If the primitive\n  # cannot be picked up (e.g., a 'BOUNDARY', 'WATER', or a 'WORKSHOP'), it cannot\n  # be directly collected into the inventory via this mechanism.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Extract relevant state information for pathfinding on the grid.\n  agent_pos = state.pos  # Agent's current (x, y) coordinates.\n  grid = state.grid        # The current 3D grid representing the world layout.\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Retrieve numerical action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible cardinal movements and their corresponding action IDs.\n  # These are used to explore neighboring cells during BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving one step down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving one step up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving one step left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving one step right.\n  ]\n\n  # Identify all locations on the grid where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # A location contains the primitive if its count in the grid is greater than zero.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not present anywhere on the map, it cannot be collected.\n      return []\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # 'visited' set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {agent_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is \"adjacent\" to any location containing the primitive.\n      # The 'USE' action typically acts on items in the agent's 3x3 neighborhood (including current cell).\n      # This check aligns with the CraftState.next_to method's logic.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent position is found, append the 'USE' action and return the complete path.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four cardinal neighbors from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the valid boundaries of the grid.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is NOT a workshop (WORKSHOP0, WORKSHOP1, WORKSHOP2) and NOT water.\n          # Workshops and water are special non-grabbable entities that agents can typically move through.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of this kind in the cell\n                  if k_idx in env.world.non_grabbable_indices and \\\n                     k_idx not in env.world.workshop_indices and \\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # This cell is blocked by an impassable object.\n          \n          if is_impassable:\n              continue # Skip adding this blocked cell to the queue.\n\n          # If the cell is traversable and has not been visited yet, add it to the BFS queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to maintain independent paths for different BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:38:46.102731", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the primitive is already in the agent's inventory.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      # If the agent already has at least one of the primitive, no collection actions are needed.\n      return []\n\n  # The 'collect' function implies obtaining the item in inventory.\n  # If the primitive is not in the set of items that can be picked up (grabbable),\n  # it cannot be \"collected\" in the sense of adding to inventory directly.\n  if primitive_idx not in env.world.grabbable_indices:\n      # If it's not grabbable, no actions can directly lead to \"collecting\" it into inventory.\n      return []\n\n  # Retrieve current state information from the environment.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  agent_dir = state.dir  # Agent's current facing direction.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Map movement action IDs (which also represent directions) to their (dx, dy) deltas.\n  # When an agent moves, its direction changes to the direction of that movement.\n  action_to_delta = {\n      DOWN_ACTION: (0, 1),\n      UP_ACTION: (0, -1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  # Identify all grid locations where the target primitive exists.\n  # While not directly used for pathfinding targets in a direction-aware BFS,\n  # it helps to confirm if the primitive is present on the map at all.\n  primitive_is_on_map = False\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_is_on_map = True\n              break\n      if primitive_is_on_map:\n          break\n\n  if not primitive_is_on_map:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position and direction to a state where the 'USE' action can collect the primitive.\n  # The BFS state includes (current_position: (x, y), current_direction: int, path: list[int]).\n  queue = collections.deque([(agent_pos, agent_dir, [])])\n  # The visited set must store (position, direction) tuples to correctly track unique states.\n  visited = {(agent_pos, agent_dir)}\n\n  while queue:\n      current_pos, current_dir, path = queue.popleft()\n      cx, cy = current_pos\n\n      # --- Goal Check 1: Agent is on the primitive ---\n      # If the agent is currently on a cell containing the primitive, and it's grabbable,\n      # it might be collectable by using the USE action directly on the current cell.\n      if grid[cx, cy, primitive_idx] > 0:\n          # This assumes USE can act on the current cell if it contains a grabbable item.\n          # This is a common convention in some grid environments.\n          new_path = list(path) # Ensure new path is created for appending\n          new_path.append(USE_ACTION)\n          return new_path\n\n      # --- Goal Check 2: Primitive is directly in front of the agent ---\n      # Determine the coordinates of the cell directly in front of the agent.\n      dir_dx, dir_dy = action_to_delta[current_dir]\n      front_x, front_y = cx + dir_dx, cy + dir_dy\n\n      # Check if the 'front' cell is within grid boundaries.\n      if 0 <= front_x < grid_width and 0 <= front_y < grid_height:\n          # If the cell directly in front contains the primitive, we have found a solution.\n          if grid[front_x, front_y, primitive_idx] > 0:\n              # The agent is positioned correctly and facing the primitive.\n              # Append the USE action and return the complete sequence of actions.\n              new_path = list(path) # Ensure new path is created for appending\n              new_path.append(USE_ACTION)\n              return new_path\n\n      # --- Explore Neighbors (Movement Actions) ---\n      # For each possible movement action (UP, DOWN, LEFT, RIGHT):\n      for move_action_id, (move_dx, move_dy) in action_to_delta.items():\n          next_x, next_y = cx + move_dx, cy + move_dy\n          next_pos = (next_x, next_y)\n          # The agent's direction changes to the direction of the last movement.\n          next_dir = move_action_id \n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is NOT a workshop and NOT water. Workshops and water are traversable.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this cell...\n                  if k_idx in env.world.non_grabbable_indices and\\\n                     k_idx not in env.world.workshop_indices and\\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # No need to check other kinds in this cell; it's blocked.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the next state (position, direction) has not been visited yet, add it to the queue.\n          if (next_pos, next_dir) not in visited:\n              visited.add((next_pos, next_dir))\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(move_action_id)\n              queue.append((next_pos, next_dir, new_path))\n\n  # If the queue becomes empty and no path to collect the primitive is found,\n  # it means the primitive is unreachable from the current position and direction.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:39:31.125806", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  # Map movement actions to their corresponding (x_delta, y_delta) for grid traversal.\n  # (x_delta, y_delta) indicates change in (column, row) coordinates, assuming pos = (x, y).\n  MOVE_ACTIONS_AND_DELTAS = {\n      action_map['UP']: (0, -1),    # Move up: decreases y-index (row)\n      action_map['DOWN']: (0, 1),   # Move down: increases y-index (row)\n      action_map['LEFT']: (-1, 0),  # Move left: decreases x-index (column)\n      action_map['RIGHT']: (1, 0),  # Move right: increases x-index (column)\n  }\n\n  try:\n    i_primitive = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized in the cookbook's index, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n  \n  # 1. Early Exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # 2. Handle Non-Collectible Environment Items:\n  # Workshops (e.g., WORKSHOP0, WORKSHOP1) are non-grabbable and are meant to be\n  # stood upon to perform crafting actions, not \"collected\" into inventory via `collect`.\n  # BOUNDARY elements are also non-collectible.\n  # If the target primitive is a workshop or an impassable boundary, it is not \"collectible\"\n  # in the sense of adding to inventory, so return an empty action list.\n  if i_primitive in env.world.workshop_indices or \\\n     i_primitive == env.world.cookbook.index['BOUNDARY']: # Assuming 'BOUNDARY' exists and is distinct from other impassables\n      return []\n\n  # 3. Determine Collection Mechanism: Grabbable vs. Non-Grabbable (USE-able).\n  is_grabbable_item = i_primitive in env.world.grabbable_indices\n\n  # Get current grid and agent's starting position for the search.\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's starting (x, y) position (col, row)\n  \n  # Get grid dimensions: (width, height, n_kinds) based on `grid.shape` and `pos = (x, y)` indexing.\n  grid_width, grid_height, _ = grid.shape\n\n  # Define cells containing these kinds as truly impassable obstacles for agent movement.\n  # The agent cannot step onto these cells. This typically includes BOUNDARY, WATER, STONE, etc.,\n  # but explicitly EXCLUDES workshops, as agents can stand on them.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # 4. Breadth-First Search (BFS) for Shortest Path.\n  # The queue stores tuples of (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to prevent cycles and redundant exploration.\n  visited_positions = {start_pos}\n\n  while queue:\n    curr_pos, path_to_curr_pos = queue.popleft()\n    curr_x, curr_y = curr_pos\n\n    # Check if the current position (for grabbable items) or its immediate neighbors\n    # (for non-grabbable 'USE'-able items like WATER/STONE) satisfy the collection condition.\n    \n    if is_grabbable_item:\n      # For grabbable primitives (e.g., WOOD, IRON), the goal is to be *on* the cell\n      # containing the item. The agent picks up the item by moving onto its cell.\n      if grid[curr_x, curr_y, i_primitive] > 0:\n        return path_to_curr_pos # Path ends *on* the item's cell.\n    else:\n      # For non-grabbable primitives (e.g., 'STONE', 'WATER' source) that are \"used\"\n      # (as opposed to collected by walking over), collecting them implies interacting\n      # with them using the 'USE' action when adjacent.\n      # Check the 4 cardinal neighbors (up, down, left, right) from the current position.\n      for dx_neighbor, dy_neighbor in MOVE_ACTIONS_AND_DELTAS.values():\n        neighbor_x, neighbor_y = curr_x + dx_neighbor, curr_y + dy_neighbor\n        \n        # Ensure the neighbor cell is within grid boundaries.\n        if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n          # If the primitive source is found in an adjacent cell, we can append the 'USE' action.\n          if grid[neighbor_x, neighbor_y, i_primitive] > 0:\n            return path_to_curr_pos + [USE_ACTION]\n            \n    # 5. Explore Neighbors: If the target is not found yet, expand the search to adjacent cells.\n    for action_val, (dx, dy) in MOVE_ACTIONS_AND_DELTAS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check 1: Ensure the next position is within grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check 2: Only add to the queue if the position has not been visited to avoid cycles.\n      if next_pos in visited_positions:\n          continue\n\n      # Check 3: Determine if the next position is an impassable obstacle.\n      # The agent cannot move onto cells containing any of the defined impassable kinds.\n      is_obstacle = False\n      # Find all kinds present at the `next_pos` cell.\n      kinds_at_next_pos = np.where(grid[next_x, next_y] > 0)[0] \n      for k_idx in kinds_at_next_pos:\n          if k_idx in impassable_kinds:\n              is_obstacle = True\n              break\n      \n      if is_obstacle:\n          continue # Cannot move to this cell, it's an obstacle.\n\n      # If the cell is traversable and not visited, add it to the queue.\n      visited_positions.add(next_pos)\n      queue.append((next_pos, path_to_curr_pos + [action_val]))\n            \n  # If the BFS completes and no path to the primitive (or its interaction point) was found,\n  # it means the primitive is unreachable in the current scenario.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:39:32.323657", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  USE_ACTION = action_map['USE']\n\n  # Map movement actions to their corresponding (x_delta, y_delta) for grid traversal.\n  # (x_delta, y_delta) indicates change in (column, row) coordinates, assuming pos = (x, y).\n  MOVE_ACTIONS_AND_DELTAS = {\n      action_map['UP']: (0, -1),    # Move up: decreases y-index\n      action_map['DOWN']: (0, 1),   # Move down: increases y-index\n      action_map['LEFT']: (-1, 0),  # Move left: decreases x-index\n      action_map['RIGHT']: (1, 0),  # Move right: increases x-index\n  }\n\n  try:\n    i_primitive = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Explicitly handle workshop primitives: workshops are locations, not items to be \"collected\" into inventory.\n  # If the goal is to interact with a workshop, it's usually part of a 'craft' action, not a 'collect' action.\n  if i_primitive in env.world.workshop_indices:\n      return []\n\n  # Get Current State Information\n  current_state = env._current_state\n  \n  # Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Determine if the primitive is grabbable (collected by walking over its cell)\n  # or non-grabbable (requires 'USE' action when adjacent to its source).\n  is_grabbable_item = i_primitive in env.world.grabbable_indices\n\n  # Get current grid and agent's starting position for the search.\n  grid = current_state.grid\n  start_pos = current_state.pos # Agent's starting (x, y) position\n  \n  # Get grid dimensions: (width, height, n_kinds) based on `grid.shape` and `pos = (x, y)` indexing.\n  grid_width, grid_height, _ = grid.shape\n\n  # Define cells containing these kinds as truly impassable obstacles for agent movement.\n  # These are non-grabbable entities that the agent cannot step onto,\n  # EXCLUDING workshops, which are non-grabbable but are meant to be stood on.\n  impassable_kinds = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # Breadth-First Search (BFS) for Shortest Path\n  # The queue stores tuples of (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to prevent cycles and redundant exploration.\n  visited_positions = {start_pos}\n\n  while queue:\n    curr_pos, path_to_curr_pos = queue.popleft()\n    curr_x, curr_y = curr_pos\n\n    # Check if the current position or its immediate neighbors satisfy the collection condition.\n    \n    if is_grabbable_item:\n      # For grabbable primitives, the goal is to be *on* the cell containing the item.\n      # The agent picks up the item by moving onto its cell.\n      if grid[curr_x, curr_y, i_primitive] > 0:\n        return path_to_curr_pos # Path ends *on* the item's cell.\n    else:\n      # For non-grabbable primitives (e.g., 'STONE', 'WATER' source),\n      # collecting them implies interacting with them using the 'USE' action when adjacent.\n      # Check the 4 cardinal neighbors (up, down, left, right) from the current position.\n      for dx_neighbor, dy_neighbor in MOVE_ACTIONS_AND_DELTAS.values(): # Iterate over cardinal direction deltas\n        neighbor_x, neighbor_y = curr_x + dx_neighbor, curr_y + dy_neighbor\n        \n        # Ensure the neighbor cell is within grid boundaries.\n        if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n          # If the primitive source is found in an adjacent cell, we can use the 'USE' action.\n          if grid[neighbor_x, neighbor_y, i_primitive] > 0:\n            return path_to_curr_pos + [USE_ACTION]\n            \n    # Explore Neighbors: If the target is not found yet, expand the search to adjacent cells.\n    for action_val, (dx, dy) in MOVE_ACTIONS_AND_DELTAS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check 1: Ensure the next position is within grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check 2: Only add to the queue if the position has not been visited.\n      if next_pos in visited_positions:\n          continue\n\n      # Check 3: Determine if the next position is an impassable obstacle.\n      # The agent cannot move onto cells containing any of the defined impassable kinds.\n      is_obstacle = False\n      # np.where returns a tuple of arrays, so [0] gets the array of indices where value > 0.\n      kinds_at_next_pos = np.where(grid[next_x, next_y] > 0)[0] \n      for k_idx in kinds_at_next_pos:\n          if k_idx in impassable_kinds:\n              is_obstacle = True\n              break\n      \n      if is_obstacle:\n          continue # Cannot move to this cell, it's an obstacle.\n\n      # If the cell is traversable and not visited, add it to the queue.\n      visited_positions.add(next_pos)\n      queue.append((next_pos, path_to_curr_pos + [action_val]))\n            \n  # If the BFS completes and no path to the primitive (or its interaction point) was found,\n  # it means the primitive is unreachable in the current scenario.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:40:16.989214", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index[primitive]\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Directions relative to current position, mapped to actions\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # For BFS neighbors (4-connected)\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Define explicit movement blockers (e.g., water and stone)\n  # These are entities that generally block agent movement.\n  movement_blockers = {env.world.water_index, env.world.stone_index}\n\n  # Helper function to check if a cell is traversable for pathfinding.\n  # A cell is traversable if it's within bounds and doesn't contain\n  # any \"hard\" movement blockers, UNLESS that blocker IS the primitive\n  # we are currently trying to collect (in which case, we want to reach it).\n  def is_cell_traversable(r, c):\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False # Out of bounds\n\n      for blocker_idx in movement_blockers:\n          # If the cell contains a movement blocker AND this blocker is NOT the\n          # specific primitive we are trying to collect, then it's truly impassable\n          # for general movement *through* it.\n          if blocker_idx != primitive_id and grid[r, c, blocker_idx] > 0:\n              return False\n              \n      return True\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive_id] > 0:\n      return []\n\n  # 2. Immediate action check (optimization for common cases from v1)\n  if primitive_id in env.world.grabbable_indices:\n      # If collecting a grabbable item, check if we are already next to it.\n      if state.next_to(primitive_id):\n          return [USE_ACTION]\n  elif primitive_id in env.world.non_grabbable_indices:\n      # If collecting a non-grabbable item, check if we are already on its cell.\n      # This implicitly assumes 'collecting' a non-grabbable means reaching its location.\n      if grid[current_row, current_col, primitive_id] > 0:\n          return [] # Already \"collected\" by being on the cell.\n  else:\n      # The primitive is not a recognized collectible entity via the `collect` mechanism\n      # (neither grabbable nor non-grabbable).\n      return []\n\n  # 3. Determine target cells for BFS and whether a USE action is needed (from v1)\n  target_cells_for_bfs = set()\n  add_use_action = False\n\n  # Grabbable items: These are picked up from an adjacent cell using USE.\n  if primitive_id in env.world.grabbable_indices:\n      add_use_action = True\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0: # If this cell contains the grabbable primitive\n                  # The agent can pick it up from any cell in its 3x3 neighborhood.\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r + dr_adj, c + dc_adj\n                          # Only add to targets if the adjacent cell is traversable\n                          if is_cell_traversable(nr, nc):\n                              target_cells_for_bfs.add((nr, nc))\n\n  # Non-grabbable items: \"Collecting\" typically means reaching the cell itself.\n  elif primitive_id in env.world.non_grabbable_indices:\n      add_use_action = False # No explicit USE action for non-grabbables.\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0: # If this cell contains the non-grabbable primitive\n                  # Only add to targets if the primitive's cell itself is traversable.\n                  if is_cell_traversable(r, c):\n                      target_cells_for_bfs.add((r, c))\n\n  if not target_cells_for_bfs:\n      return [] # No valid target cells found (e.g., primitive not on grid or all instances are unreachable)\n\n  # 4. Find shortest path to any target cell using Breadth-First Search (BFS) (from v1)\n  # Ensure the starting cell is traversable. This should always be true for a valid game state.\n  if not is_cell_traversable(current_row, current_col):\n      return [] # Agent starts in an impassable cell (highly unlikely scenario, but robust)\n\n  queue = collections.deque([(current_row, current_col, [])])\n  visited = {(current_row, current_col)}\n  \n  shortest_path = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # If the current cell is one of the desired target cells, we found the shortest path\n      if (r, c) in target_cells_for_bfs:\n          shortest_path = path\n          break\n\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc\n\n          # Check if the next cell is within bounds, traversable (by our logic), and not yet visited\n          if is_cell_traversable(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy to avoid modifying shared list\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  if shortest_path is None:\n      return [] # No traversable path found to any target cell\n\n  final_actions = list(shortest_path)\n  if add_use_action:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:40:18.129556", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index[primitive]\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Directions relative to current position, mapped to actions\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # For BFS neighbors (4-connected)\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Define typical movement blockers in CraftWorld\n  movement_blockers = {env.world.water_index, env.world.stone_index}\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive_id] > 0:\n      return []\n\n  # 2. Determine target cells for BFS and whether a USE action is needed.\n  #    Also, check if the primitive itself exists on the grid.\n  target_cells_for_bfs = set()\n  add_use_action = False\n  \n  primitive_found_on_grid = False\n\n  # Grabbable items (e.g., WOOD, IRON): These are picked up from an adjacent cell using USE.\n  if primitive_id in env.world.grabbable_indices:\n      add_use_action = True\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0: # If this cell contains the grabbable primitive\n                  primitive_found_on_grid = True\n                  # The agent can pick it up from any cell in its 3x3 neighborhood.\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r + dr_adj, c + dc_adj\n                          # Add to targets if the adjacent cell is within bounds.\n                          # Traversability will be checked by the BFS itself.\n                          if 0 <= nr < HEIGHT and 0 <= nc < WIDTH:\n                              target_cells_for_bfs.add((nr, nc))\n\n  # Non-grabbable items (e.g., WORKSHOP, WATER, STONE): \"Collecting\" typically means reaching the cell itself.\n  elif primitive_id in env.world.non_grabbable_indices:\n      add_use_action = False # No explicit USE action for non-grabbables for 'collect'.\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0: # If this cell contains the non-grabbable primitive\n                  primitive_found_on_grid = True\n                  # The target is the cell itself.\n                  target_cells_for_bfs.add((r, c))\n  else:\n      # The primitive is not a recognized collectible entity via the `collect` mechanism.\n      return []\n      \n  # 3. Early exit if the primitive is not on the grid at all or no valid target cells were identified.\n  if not primitive_found_on_grid or not target_cells_for_bfs:\n      return []\n\n  # Helper function to check if a cell is traversable for pathfinding.\n  # A cell is traversable if it's within bounds and doesn't contain\n  # any \"hard\" movement blockers, UNLESS that blocker IS the primitive\n  # we are currently trying to collect (in which case, we want to reach it).\n  def is_cell_traversable(r, c):\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False # Out of bounds\n\n      for blocker_idx in movement_blockers:\n          # If the cell contains a movement blocker AND this blocker is NOT the\n          # specific primitive we are trying to collect, then it's truly impassable\n          # for general movement *through* it.\n          if blocker_idx != primitive_id and grid[r, c, blocker_idx] > 0:\n              return False\n              \n      return True # Otherwise, it's traversable.\n\n  # 4. Check if agent is already in the target position/next to the primitive.\n  #    This avoids unnecessary BFS if already at the goal.\n  if add_use_action: # Grabbable primitive\n      if state.next_to(primitive_id): # Uses the internal check for 3x3 neighborhood.\n          return [USE_ACTION]\n  else: # Non-grabbable primitive\n      # For non-grabbables, \"collecting\" means being on the cell itself.\n      if grid[current_row, current_col, primitive_id] > 0:\n          return [] # Already on the primitive, effectively \"collected\".\n\n  # Ensure the starting cell is traversable to begin BFS.\n  if not is_cell_traversable(current_row, current_col):\n      return [] # Agent starts in an impassable cell (highly unlikely but good for robustness)\n\n  # 5. Find shortest path to any target cell using Breadth-First Search (BFS)\n  queue = collections.deque([(current_row, current_col, [])]) # (r, c, path_actions)\n  visited = {(current_row, current_col)} # Set of visited (r,c) tuples\n  \n  shortest_path = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # If the current cell is one of the desired target cells, we found the shortest path\n      if (r, c) in target_cells_for_bfs:\n          # Double check traversability of the target cell itself before accepting as path end.\n          # (This is implicitly handled if target_cells_for_bfs only includes traversable cells,\n          # but explicit check here is safer if target_cells_for_bfs includes all candidate locations).\n          if is_cell_traversable(r, c):\n              shortest_path = path\n              break\n\n      for dr, dc in DELTAS: # Explore 4-connected neighbors\n          nr, nc = r + dr, c + dc\n\n          # Check if the next cell is within bounds, traversable (by our new logic), and not yet visited\n          if is_cell_traversable(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy to avoid modifying shared list\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  # 6. Construct and return the final action list\n  if shortest_path is None:\n      return [] # No traversable path found to any target cell\n\n  final_actions = list(shortest_path)\n  if add_use_action:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:41:06.470884", "function_name": "collect", "function_body": "  try:\n    # Attempt to get the integer index for the primitive string from the cookbook's index.\n    # This operation can raise a KeyError if the primitive name is not recognized by the environment.\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is unknown to the cookbook, it cannot be collected.\n    # Return an empty list of actions as no plan can be formed.\n    return []\n\n  # Get the current state of the environment, which includes the agent's inventory,\n  # position, and the grid layout.\n  current_state = env._current_state\n  \n  # Optimization: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the primitive, there's no need\n  # to collect more, so return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Constraint Check: Determine if the primitive is a 'grabbable' item.\n  # The 'collect' function is intended for acquiring items into inventory.\n  # If the primitive is defined as 'non-grabbable' (e.g., static environment features\n  # like workshops, water, or boundaries that cannot be picked up), it cannot be collected\n  # using this method. In such cases, no collection actions are possible.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Extract relevant information from the current state: the grid dimensions and\n  # the agent's starting position.\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve the integer mappings for various actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action typically used to interact with or pick up items.\n\n  # Define the change in coordinates for each movement action.\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to determine if a given `check_pos` (agent's potential position)\n  # is adjacent to (or directly on) the target `primitive_idx` within the `current_grid`.\n  # This condition typically allows the `ACTION_USE` to be effective for collection.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Iterate through a 3x3 neighborhood (including the center cell) around `check_pos`.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighboring coordinates are within the grid boundaries.\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # Check if the target primitive has a non-zero count at this neighboring cell.\n          if current_grid[nx, ny, target_idx] > 0:\n            return True # Target primitive found, meaning agent is in a position to use it.\n    return False # Target primitive not found in the neighborhood.\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to avoid redundant explorations and cycles.\n  visited = {start_pos}\n\n  # IMPROVEMENT for collect_v2:\n  # Identify non-traversable entities to use in pathfinding.\n  # Based on CraftState.step._move, non-grabbable objects that are NOT workshops\n  # act as obstacles. Workshops are non-grabbable but traversable.\n  non_traversable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    curr_pos, path = q.popleft() # Get the next position and its path from the queue.\n\n    # Check if the agent, at the `curr_pos`, is in a state to collect the primitive.\n    # If `is_next_to_target` is true, we have found a valid position to perform `ACTION_USE`.\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the `ACTION_USE` to the current path and return the complete sequence of actions.\n      # This path represents the shortest sequence of moves to get next to the primitive,\n      # followed by the action to collect it.\n      return path + [ACTION_USE]\n\n    # If the primitive is not yet collectible from `curr_pos`, explore all possible moves\n    # from the current position.\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Validate the next position: ensure it is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip moves that go out of bounds.\n\n      # IMPROVEMENT for collect_v2:\n      # Check if the next position is blocked by a non-traversable object.\n      is_blocked = False\n      for k in non_traversable_indices:\n        if grid[next_x, next_y, k] > 0:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue # Cannot move to this cell, skip this path.\n\n      # If the `next_pos` has not been visited yet, add it to the queue for exploration.\n      # This ensures the BFS finds the shortest path by processing layers level by level.\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        q.append((next_pos, path + [action])) # Add the new position and its extended path to the queue.\n\n  # If the BFS completes and the queue is empty, it means no path was found to reach\n  # and collect the primitive from the initial state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:41:07.548448", "function_name": "collect", "function_body": "  try:\n    # Attempt to get the integer index for the primitive string from the cookbook's index.\n    # This operation can raise a KeyError if the primitive name is not recognized by the environment.\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is unknown to the cookbook, it cannot be collected.\n    # Return an empty list of actions as no plan can be formed.\n    return []\n\n  # Get the current state of the environment, which includes the agent's inventory,\n  # position, and the grid layout.\n  current_state = env._current_state\n  \n  # Optimization: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the primitive, there's no need\n  # to collect more, so return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Constraint Check: Determine if the primitive is a 'grabbable' item.\n  # The 'collect' function is intended for acquiring items into inventory.\n  # If the primitive is defined as 'non-grabbable' (e.g., static environment features\n  # like workshops, water, or boundaries that cannot be picked up), it cannot be collected\n  # using this method. In such cases, no collection actions are possible.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Extract relevant information from the current state: the grid dimensions and\n  # the agent's starting position.\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve the integer mappings for various actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action typically used to interact with or pick up items.\n\n  # Define the change in coordinates for each movement action.\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Identify known non-traversable obstacles for pathfinding.\n  # Water is a common obstacle that agents cannot move into without special tools (e.g., bridge).\n  water_idx = env.world.water_index\n\n  # Helper function to determine if a given `check_pos` (agent's potential position)\n  # is adjacent to (or directly on) the target `primitive_idx` within the `current_grid`.\n  # This condition typically allows the `ACTION_USE` to be effective for collection.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Iterate through a 3x3 neighborhood (including the center cell) around `check_pos`.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighboring coordinates are within the grid boundaries.\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # Check if the target primitive has a non-zero count at this neighboring cell.\n          if current_grid[nx, ny, target_idx] > 0:\n            return True # Target primitive found, meaning agent is in a position to use it.\n    return False # Target primitive not found in the neighborhood.\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to avoid redundant explorations and cycles.\n  visited = {start_pos}\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    curr_pos, path = q.popleft() # Get the next position and its path from the queue.\n\n    # Check if the agent, at the `curr_pos`, is in a state to collect the primitive.\n    # If `is_next_to_target` is true, we have found a valid position to perform `ACTION_USE`.\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the `ACTION_USE` to the current path and return the complete sequence of actions.\n      # This path represents the shortest sequence of moves to get next to the primitive,\n      # followed by the action to collect it.\n      return path + [ACTION_USE]\n\n    # If the primitive is not yet collectible from `curr_pos`, explore all possible moves\n    # from the current position.\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Validate the next position: ensure it is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip moves that go out of bounds.\n\n      # Improvement for collect_v2: Obstacle Avoidance\n      # If the target cell contains water, we cannot move into it.\n      if grid[next_x, next_y, water_idx] > 0:\n        continue # Skip moves into water\n\n      # If the `next_pos` has not been visited yet, add it to the queue for exploration.\n      # This ensures the BFS finds the shortest path by processing layers level by level.\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        q.append((next_pos, path + [action])) # Add the new position and its extended path to the queue.\n\n  # If the BFS completes and the queue is empty, it means no path was found to reach\n  # and collect the primitive from the initial state.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:41:37.761302", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by checking if the item is already in inventory\n  and preventing movement into impassable grid cells (BOUNDARY, WATER).\n  \"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  #    If it is, no actions are needed to \"collect\" it.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 2. Check if the primitive is a non-grabbable entity (e.g., water, workshop, boundary).\n  #    Non-grabbable items cannot be collected into inventory.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state details for BFS.\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Identify impassable entities for pathfinding (e.g., boundaries, water).\n  # Agent should not attempt to move into cells occupied by these entities.\n  impassable_indices = set()\n  # Add boundary index if it exists in the cookbook (it's often implicit)\n  try:\n    boundary_idx = env.world.cookbook.index.index(\"BOUNDARY\")\n    impassable_indices.add(boundary_idx)\n  except KeyError:\n    pass # BOUNDARY might not exist in all cookbooks explicitly, but acts as a boundary.\n\n  # Add water index (available directly from CraftWorld for robustness)\n  water_idx = env.world.water_index\n  impassable_indices.add(water_idx)\n\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell (count > 0), return True\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position contains any impassable entity.\n      # If so, this cell cannot be moved into, so skip it.\n      is_impassable_cell = False\n      for idx in impassable_indices:\n        if grid[next_x, next_y, idx] > 0: # Check if the impassable entity is present at this cell\n          is_impassable_cell = True\n          break\n      if is_impassable_cell:\n        continue # Skip this path, as it leads to an impassable cell\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": -1}}
