{"timestamp": "2025-08-01T23:27:18.825093", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the agent already has at least one of the primitive in inventory.\n  # This check remains important. If the agent already possesses the primitive\n  # (which implies it must be grabbable, or a derived product that is named the same),\n  # then no collection actions are needed.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # In v2, we no longer require the primitive to be directly grabbable into inventory.\n  # The 'collect' function's purpose is now to find the primitive's source on the map,\n  # move the agent adjacent to it, and attempt a 'USE' action. This handles cases\n  # where a 'primitive' (like 'WOOD' or 'STONE') acts as a resource that needs to\n  # be processed (e.g., chopped, mined) to yield a grabbable item.\n  # The actual effect (what goes into inventory) is determined by the environment's\n  # 'step' function when 'USE' is executed.\n\n  # Retrieve current state information from the environment.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be interacted with.\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is adjacent to the target primitive.\n  # The queue stores (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. A 3x3 neighborhood is considered\n      # \"adjacent\" for the purpose of the 'USE' action. This aligns with `CraftState.next_to`.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is NOT a workshop and NOT water. Workshops and water are traversable.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this cell...\n                  if k_idx in env.world.non_grabbable_indices and\\\n                     k_idx not in env.world.workshop_indices and\\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # No need to check other kinds in this cell; it's blocked.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:27:19.931229", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the primitive is already in the agent's inventory.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      # If the agent already has at least one of the primitive, no collection actions are needed.\n      return []\n\n  # The 'collect' function implies obtaining the item in inventory.\n  # If the primitive is not in the set of items that can be picked up,\n  # it cannot be \"collected\" in the sense of adding to inventory directly.\n  # This aligns with the CraftState.satisfies method checking `inventory[goal_arg] > 0`.\n  # For example, 'WOOD' (a tree) might be non-grabbable, but 'PLANK' (its product) is.\n  # If 'collect(\"WOOD\")' is called, and WOOD isn't grabbable, it cannot be put in inventory.\n  # This implies that `collect` strictly deals with items that can be directly picked up.\n  if primitive_idx not in env.world.grabbable_indices:\n      # If it's not grabbable, no actions can directly lead to \"collecting\" it into inventory.\n      return []\n\n  # Retrieve current state information from the environment.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Pre-calculate the set of kind indices that represent impassable terrain.\n  # A cell is considered impassable if it contains any non-grabbable entity\n  # that is NOT a workshop and NOT water.\n  impassable_kinds = set(env.world.non_grabbable_indices)\n  impassable_kinds.difference_update(env.world.workshop_indices)\n  impassable_kinds.discard(env.world.water_index) # Remove water from impassable_kinds\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is adjacent to the target primitive.\n  queue = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. A 3x3 neighborhood is considered\n      # \"adjacent\" for the purpose of the 'USE' action (as per CraftState.next_to).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # Check if the cell contains any entity that is defined as impassable.\n          is_impassable = False\n          for k_idx in impassable_kinds:\n              if grid[next_x, next_y, k_idx] > 0:\n                  is_impassable = True\n                  break # Found an impassable entity in this cell, no need to check further.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:28:26.242893", "function_name": "collect", "function_body": "  try:\n    # Get the integer index for the primitive from the cookbook.\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it cannot be collected.\n    return []\n\n  # Extract current state information from the environment.\n  current_state = env._current_state\n  # Agent's current position (col, row). Assuming pos is (x, y) where x is col, y is row.\n  current_c, current_r = current_state.pos\n  initial_dir = current_state.dir   # Agent's current direction (0:N, 1:E, 2:S, 3:W)\n  grid = current_state.grid         # Grid state: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n\n  # Get grid dimensions. grid.shape[0] is WIDTH (columns), grid.shape[1] is HEIGHT (rows).\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Map action names to their integer IDs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for movement and direction logic based on (col, row) coordinates.\n  # _action_to_delta: maps a move action index to its (d_col, d_row) change in position.\n  _action_to_delta = {\n      ACTION_UP: (0, -1),    # Moves agent up (row decreases)\n      ACTION_DOWN: (0, 1),   # Moves agent down (row increases)\n      ACTION_LEFT: (-1, 0),  # Moves agent left (column decreases)\n      ACTION_RIGHT: (1, 0),  # Moves agent right (column increases)\n  }\n  # _action_to_dir: maps a move action index to the agent's resulting direction (0-3).\n  # CraftState.dir: 0:North, 1:East, 2:South, 3:West.\n  _action_to_dir = {\n      ACTION_UP: 0,    # UP action sets direction to North (0)\n      ACTION_DOWN: 2,  # DOWN action sets direction to South (2)\n      ACTION_LEFT: 3,  # LEFT action sets direction to West (3)\n      ACTION_RIGHT: 1, # RIGHT action sets direction to East (1)\n  }\n  # _dir_to_delta: maps a direction index (0-3) to the (d_col, d_row) offset of the cell in front.\n  _dir_to_delta = {\n      0: (0, -1), # North: cell above (row decreases)\n      1: (1, 0),  # East: cell to the right (col increases)\n      2: (0, 1),  # South: cell below (row increases)\n      3: (-1, 0), # West: cell to the left (col decreases)\n  }\n\n  # Get indices of non-grabbable items which act as obstacles for movement.\n  # Agent cannot move into cells containing these.\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # BFS Queue: stores tuples of ((current_col, current_row, current_direction), list_of_actions_taken)\n  q = collections.deque([((current_c, current_r, initial_dir), [])])\n  \n  # Visited set: stores (col, row, direction) tuples to prevent redundant exploration and cycles.\n  visited = {(current_c, current_r, initial_dir)}\n\n  while q:\n    (c, r, current_dir), path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current (c, r, current_dir) state.\n    # This means the cell directly in front of the agent must contain the primitive.\n    dc_face, dr_face = _dir_to_delta[current_dir]\n    target_cell_c, target_cell_r = c + dc_face, r + dr_face\n\n    # Check if the target cell is within grid boundaries\n    if 0 <= target_cell_c < GRID_WIDTH and 0 <= target_cell_r < GRID_HEIGHT:\n      # Check if the target cell actually contains the primitive\n      # Grid is indexed as grid[col_idx, row_idx, kind_idx]\n      if grid[target_cell_c, target_cell_r, primitive_idx] > 0:\n        # Found a state from which the primitive can be collected.\n        # Append the USE action and return the full path.\n        return path + [ACTION_USE]\n\n    # 2. Explore next states by taking valid move actions (UP, DOWN, LEFT, RIGHT)\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dc_move, dr_move = _action_to_delta[action_idx]\n      next_c, next_r = c + dc_move, r + dr_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move action\n\n      # Check if the new agent position is within grid boundaries\n      if not (0 <= next_c < GRID_WIDTH and 0 <= next_r < GRID_HEIGHT):\n        continue # Out of bounds\n\n      # Check if the new agent position contains any obstacle (non-grabbable item).\n      # The agent cannot move into a cell that contains an obstacle.\n      is_obstacle = False\n      for obstacle_kind_idx in non_grabbable_obstacle_indices:\n        # If the cell at (next_c, next_r) has any quantity of an obstacle kind, it's an obstacle.\n        if grid[next_c, next_r, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break # Found an obstacle, cannot move here\n      \n      if is_obstacle:\n        continue # Skip this cell, it's an obstacle\n\n      next_state_key = (next_c, next_r, next_dir)\n      # If this new state (position + direction) hasn't been visited yet, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:28:27.445456", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  \n  # Agent's current (row, col) position and direction\n  pos_r, pos_c = current_state.pos\n  initial_dir = current_state.dir # 0:North, 1:East, 2:South, 3:West\n  \n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape # Grid dimensions (rows, cols, kinds)\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for movement and direction logic based on CraftState internals.\n  # _action_to_delta: maps a move action index to its (dr, dc) change in position.\n  # CraftState uses (row, col) for position.\n  _action_to_delta = {\n      ACTION_UP: (-1, 0),    # Moves agent up (row decreases)\n      ACTION_DOWN: (1, 0),   # Moves agent down (row increases)\n      ACTION_LEFT: (0, -1),  # Moves agent left (column decreases)\n      ACTION_RIGHT: (0, 1),  # Moves agent right (column increases)\n  }\n  # _action_to_dir: maps a move action index to the agent's resulting direction.\n  # CraftState.dir: 0:North, 1:East, 2:South, 3:West\n  _action_to_dir = {\n      ACTION_UP: 0,    # UP action sets direction to North (0)\n      ACTION_DOWN: 2,  # DOWN action sets direction to South (2)\n      ACTION_LEFT: 3,  # LEFT action sets direction to West (3)\n      ACTION_RIGHT: 1, # RIGHT action sets direction to East (1)\n  }\n  # _dir_to_delta: maps a direction index to the (dr, dc) offset of the cell directly in front of the agent.\n  _dir_to_delta = {\n      0: (-1, 0), # North: cell above (row decreases)\n      1: (0, 1),  # East: cell to the right (col increases)\n      2: (1, 0),  # South: cell below (row increases)\n      3: (0, -1), # West: cell to the left (col decreases)\n  }\n\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it cannot be collected.\n    return []\n\n  # Determine if the primitive is a grabbable resource (e.g., WOOD, STONE, GRASS)\n  # which requires a 'USE' action and gets added to inventory.\n  # Otherwise, it's an environment object (e.g., WORKSHOP, WATER, BOUNDARY)\n  # which usually only requires being adjacent.\n  is_primitive_grabbable = (primitive_idx in world.cookbook.primitives)\n\n  # Get indices of non-grabbable items that block agent movement.\n  non_grabbable_obstacle_indices = world.non_grabbable_indices\n\n  # BFS Queue: stores tuples of ((row, col, direction), list_of_actions_taken)\n  q = collections.deque([((pos_r, pos_c, initial_dir), [])])\n  \n  # Visited set: stores (row, col, direction) tuples to prevent redundant exploration and cycles.\n  visited = {(pos_r, pos_c, initial_dir)}\n\n  while q:\n    (r, c, current_dir), path = q.popleft()\n\n    # 1. Check if the current state satisfies the goal condition for collection/interaction.\n    if is_primitive_grabbable:\n      # For grabbable primitives, the agent must be directly facing the item to 'USE' it.\n      dr_face, dc_face = _dir_to_delta[current_dir]\n      target_cell_r, target_cell_c = r + dr_face, c + dc_face\n\n      # Check if the cell in front is within grid boundaries and contains the primitive.\n      if (0 <= target_cell_r < HEIGHT and 0 <= target_cell_c < WIDTH and\n          grid[target_cell_r, target_cell_c, primitive_idx] > 0):\n        # Found a path to a position where the primitive can be collected.\n        return path + [ACTION_USE] # Append the USE action and return the full path.\n\n    else: # Primitive is an environment object (e.g., WORKSHOP, WATER, BOUNDARY)\n      # For environment objects, \"collecting\" means simply being adjacent (in the 3x3 neighborhood).\n      found_in_neighborhood = False\n      for dr_nb in [-1, 0, 1]:\n        for dc_nb in [-1, 0, 1]:\n          # Skip the agent's own position as we are looking for items in adjacent cells.\n          if dr_nb == 0 and dc_nb == 0:\n            continue\n            \n          nb_r, nb_c = r + dr_nb, c + dc_nb\n          # Check if the neighborhood cell is within grid boundaries and contains the primitive.\n          if (0 <= nb_r < HEIGHT and 0 <= nb_c < WIDTH and \n              grid[nb_r, nb_c, primitive_idx] > 0):\n            found_in_neighborhood = True\n            break # Found in neighborhood, no need to check further cells.\n        if found_in_neighborhood:\n          break # Found in neighborhood, exit outer loop.\n\n      if found_in_neighborhood:\n        # Found a path to a position adjacent to the environment object. No USE action is appended.\n        return path \n\n    # 2. Explore next states by taking valid move actions (UP, DOWN, LEFT, RIGHT).\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dr_move, dc_move = _action_to_delta[action_idx]\n      next_r, next_c = r + dr_move, c + dc_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move action.\n\n      # Check if the new agent position is within grid boundaries.\n      if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n        continue # Out of bounds, skip this move.\n\n      # Check if the new agent position contains any obstacle.\n      # Agent cannot move into a cell that contains an obstacle.\n      is_obstacle = False\n      for obstacle_kind_idx in non_grabbable_obstacle_indices:\n        if grid[next_r, next_c, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break # Found an obstacle, cannot move here.\n      \n      if is_obstacle:\n        continue # Skip this cell, it's an obstacle.\n\n      next_state_key = (next_r, next_c, next_dir)\n      # If this new state (position + direction) hasn't been visited yet, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect or interact with the primitive,\n  # return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:29:08.747779", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive]\n\n  # As per the DSL, 'collect' implies picking up an item.\n  # If the primitive is not in the list of grabbable items, it cannot be collected this way.\n  if i_primitive not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  HEIGHT, WIDTH, _ = grid.shape # Note: grid is (WIDTH, HEIGHT, n_kinds) in CraftScenario, but (HEIGHT, WIDTH, n_kinds) in numpy.ndarray shape often means (rows, cols). Let's assume (rows, cols) mapping to (HEIGHT, WIDTH) for clarity.\n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (dr, dc) to action for moving\n  move_deltas_to_action = {\n      (-1, 0): UP,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS exploration\n\n  # If the agent is already in a position to collect the primitive, just use it.\n  # `next_to` checks the 3x3 neighborhood, which is appropriate for grabbable items.\n  if current_state.next_to(i_primitive):\n    return [USE]\n\n  # Get indices for general movement blockers (e.g., water, stone)\n  # These are entities the agent typically cannot move through.\n  i_water = env.world.water_index\n  i_stone = env.world.stone_index\n  movement_blocker_indices = {i_water, i_stone}\n\n  # Helper function to check if a cell is traversable for the agent.\n  # A cell is traversable if it's within grid bounds and does not contain\n  # any defined movement blockers.\n  def is_cell_traversable(r, c):\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False # Out of bounds\n\n      # Check if the cell contains any explicit movement blocker\n      for blocker_idx in movement_blocker_indices:\n          if grid[r, c, blocker_idx] > 0:\n              return False # Contains a blocker, not traversable\n      return True\n\n  # Breadth-First Search (BFS) for the shortest path\n  # The goal is to find a traversable cell from which the target primitive\n  # can be collected (i.e., a cell in the 3x3 neighborhood of the primitive).\n  queue = collections.deque([(current_pos, [])]) # (position, list_of_actions)\n  visited = {current_pos}\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # Check if the current cell (r, c) is a valid \"goal\" for the BFS:\n    # A goal cell is one from which the agent can use `USE` to collect `i_primitive`.\n    # This means `i_primitive` must be present in the 3x3 neighborhood of (r, c).\n    # We simulate `state.next_to(i_primitive)` check for a hypothetical state at (r, c).\n    is_adjacent_or_on_primitive = False\n    for dr_check in [-1, 0, 1]:\n        for dc_check in [-1, 0, 1]:\n            check_r, check_c = r + dr_check, c + dc_check\n            # Check if neighbor is within bounds and contains the primitive\n            if (0 <= check_r < HEIGHT and 0 <= check_c < WIDTH and \n                grid[check_r, check_c, i_primitive] > 0):\n                is_adjacent_or_on_primitive = True\n                break\n        if is_adjacent_or_on_primitive:\n            break\n\n    if is_adjacent_or_on_primitive:\n        # Found the shortest path to a cell where we can collect the primitive.\n        return path + [USE]\n\n    # Explore valid neighbors (Up, Down, Left, Right)\n    for dr, dc in DELTAS:\n      nr, nc = r + dr, c + dc # Next row, next column\n\n      if (nr, nc) not in visited and is_cell_traversable(nr, nc):\n        visited.add((nr, nc))\n        action_to_take = move_deltas_to_action[(dr, dc)]\n        queue.append(((nr, nc), path + [action_to_take]))\n\n  # If the queue is exhausted and no path to a collectible position was found\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:29:09.915450", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T23:30:10.983718", "function_name": "collect", "function_body": "  try:\n      # 1. Map the primitive name (string) to its integer index using the cookbook's index.\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized or available in the world, it cannot be collected.\n      return []\n\n  # Improvement: Ensure the target is actually a \"primitive\" resource that can be collected\n  # into inventory, as opposed to an environment feature like WORKSHOP or WATER, which\n  # might be interacted with by 'USE' but not \"collected\" in the typical sense.\n  # Cookbook.primitives specifically lists gatherable resources.\n  if primitive_idx not in env.world.cookbook.primitives:\n      return []\n\n  current_state = env._current_state\n\n  # 2. Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to collect it, so return an empty list.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 3. Extract current state information from the environment.\n  grid = current_state.grid\n  current_pos = current_state.pos # Agent's current (x, y) position\n  \n  # Get grid dimensions for boundary checks.\n  grid_width, grid_height, _ = grid.shape\n\n  # 4. Obtain action mappings from the environment for numerical action IDs.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas (change in x, change in y) for each direction action.\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Identify indices of entities that block agent movement (non-grabbable items).\n  # These are considered obstacles for pathfinding.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if the target primitive is within the 3x3 neighborhood\n  # of a given agent position (x, y). This mirrors the logic of CraftState.next_to.\n  # This function defines the \"goal condition\" for our BFS.\n  def _is_primitive_use_valid(check_grid, agent_x, agent_y, target_idx):\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = agent_x + dx, agent_y + dy\n\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  if check_grid[nx, ny, target_idx] == 1:\n                      return True\n      return False\n\n  # Improvement: Pre-BFS check if the agent is already in a position to USE the primitive.\n  # This avoids unnecessary BFS initialization if the goal is immediately achievable.\n  if _is_primitive_use_valid(grid, current_pos[0], current_pos[1], primitive_idx):\n      return [USE_ACTION]\n\n  # 5. Initialize BFS:\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # The visited set stores (x, y) coordinates to prevent redundant exploration and cycles.\n  visited = {current_pos}\n  \n  # 6. Perform BFS to find the shortest path to a \"usable\" location.\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # Explore all traversable neighboring cells.\n      for move_action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = x + dx, y + dy\n\n          # Check if the neighboring cell is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if this neighbor has already been visited during BFS to avoid loops and redundant work.\n          if (next_x, next_y) in visited:\n              continue\n\n          # Check if the neighboring cell is an obstacle. Agent cannot move into obstacle cells.\n          is_obstacle = False\n          # Get all kind indices present at (next_x, next_y)\n          kinds_at_next_pos = np.where(grid[next_x, next_y, :] == 1)[0]\n          for kind_idx in kinds_at_next_pos:\n              # An agent cannot move onto a cell if it contains a non-grabbable item.\n              # This includes environmental features and potentially large un-grabbable primitive sources.\n              if kind_idx in obstacle_indices:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue # Skip this cell as it's an obstacle.\n\n          # Mark the cell as visited and build the path to it.\n          visited.add((next_x, next_y))\n          new_path = path + [move_action_id]\n\n          # After moving to (next_x, next_y), check if this position is now adjacent to the primitive.\n          # This is the target condition: finding a spot from which the primitive can be 'USE'd.\n          if _is_primitive_use_valid(grid, next_x, next_y, primitive_idx):\n              # If it is, we found a path. Append USE_ACTION and return.\n              return new_path + [USE_ACTION]\n          \n          # If not adjacent to the primitive, add this position to the queue for further exploration.\n          queue.append(((next_x, next_y), new_path))\n\n  # 7. If the queue becomes empty and no path to a usable primitive location was found,\n  # it means the primitive is either not on the map or is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:30:12.203052", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    This version includes an explicit check to ensure the target primitive is actually something that can be \"collected\" (i.e., picked up into inventory).\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  try:\n      # 1. Map the primitive name (string) to its integer index using the cookbook's index.\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized or available in the world, it cannot be collected.\n      return []\n\n  # V2 Improvement: Ensure the primitive is actually something that can be picked up into inventory.\n  # The `collect` DSL command implies adding the item to inventory. If the item's index\n  # is not in `env.world.grabbable_indices`, it means it cannot be picked up.\n  # This filters out environmental features like WORKSHOPs, WATER, or BOUNDARY\n  # which cannot be put into inventory, even if they can be 'used'.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  current_state = env._current_state\n\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to collect it, so return an empty list.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 2. Extract current state information from the environment.\n  grid = current_state.grid\n  current_pos = current_state.pos # Agent's current (x, y) position\n  \n  # Get grid dimensions for boundary checks.\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Obtain action mappings from the environment for numerical action IDs.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas (change in x, change in y) for each direction action.\n  # These are used to calculate neighbor coordinates during BFS.\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Identify indices of entities that block agent movement (non-grabbable items).\n  # These are considered obstacles for pathfinding.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if the target primitive is within the 3x3 neighborhood\n  # of a given agent position (x, y). This mirrors the logic of CraftState.next_to.\n  # This function defines the \"goal condition\" for our BFS.\n  def _is_primitive_use_valid(check_grid, agent_x, agent_y, target_idx):\n      for dx in [-1, 0, 1]:  # Iterate through relative x-offsets for 3x3 neighborhood\n          for dy in [-1, 0, 1]:  # Iterate through relative y-offsets for 3x3 neighborhood\n              nx, ny = agent_x + dx, agent_y + dy  # Calculate neighboring cell coordinates\n\n              # Check if the neighboring cell is within the grid boundaries.\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # If the neighboring cell contains the target primitive,\n                  # then it means the primitive is in the 3x3 neighborhood of (agent_x, ny).\n                  if check_grid[nx, ny, target_idx] == 1:\n                      return True\n      return False\n\n  # 4. Initialize BFS:\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # The visited set stores (x, y) coordinates to prevent redundant exploration and cycles,\n  # ensuring the shortest path is found.\n  visited = {current_pos}\n  \n  # 5. Perform BFS to find the shortest path to a \"usable\" location.\n  while queue:\n      (x, y), path = queue.popleft() # Get the current position and path to reach it\n\n      # Check if the current BFS position (x, y) is a goal state:\n      # Can the agent 'USE' the primitive from this specific position?\n      if _is_primitive_use_valid(grid, x, y, primitive_idx):\n          # If yes, we have found the shortest path to a valid collection point.\n          # Append the USE_ACTION to the movement path and return the complete sequence.\n          return path + [USE_ACTION]\n\n      # If the current position is not a goal state, explore all traversable neighboring cells.\n      for move_action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = x + dx, y + dy # Calculate the coordinates of the neighboring cell\n\n          # Check if the neighboring cell is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if this neighbor has already been visited during BFS to avoid loops and redundant work.\n          if (next_x, next_y) in visited:\n              continue\n\n          # Check if the neighboring cell is an obstacle. Agent cannot move into obstacle cells.\n          is_obstacle = False\n          # Iterate over all kinds present at the next position (next_x, next_y)\n          kinds_at_next_pos = np.where(grid[next_x, next_y, :] == 1)[0]\n          for kind_idx in kinds_at_next_pos:\n              # An agent cannot move onto a cell if it contains a non-grabbable item.\n              # These are considered static environmental features or fixed large objects.\n              if kind_idx in obstacle_indices:\n                  is_obstacle = True\n                  break # This cell contains an obstacle, so it's not traversable.\n          \n          if is_obstacle:\n              continue # Skip this cell as it's an obstacle.\n\n          # If the neighbor is traversable and has not been visited, add it to the queue\n          # with the extended path from the current position.\n          visited.add((next_x, next_y))\n          queue.append(((next_x, next_y), path + [move_action_id]))\n\n  # 6. If the queue becomes empty and no path to a usable primitive location was found,\n  # it means the primitive is either not on the map or is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:31:20.275662", "function_name": "collect", "function_body": "  try:\n    # Attempt to get the integer index for the primitive string from the cookbook's index.\n    # This operation can raise a KeyError if the primitive name is not recognized by the environment.\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is unknown to the cookbook, it cannot be collected.\n    # Return an empty list of actions as no plan can be formed.\n    return []\n\n  # Get the current state of the environment, which includes the agent's inventory,\n  # position, and the grid layout.\n  current_state = env._current_state\n  \n  # Optimization: Check if the primitive is already present in the agent's inventory.\n  # If the agent already possesses at least one unit of the primitive, there's no need\n  # to collect more, so return an empty list of actions.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Constraint Check: Determine if the primitive is a 'grabbable' item.\n  # The 'collect' function is intended for acquiring items into inventory.\n  # If the primitive is defined as 'non-grabbable' (e.g., static environment features\n  # like workshops, water, or boundaries that cannot be picked up), it cannot be collected\n  # using this method. In such cases, no collection actions are possible.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Extract relevant information from the current state: the grid dimensions and\n  # the agent's starting position.\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Retrieve the integer mappings for various actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The action typically used to interact with or pick up items.\n\n  # Define the change in coordinates for each movement action.\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to determine if a given `check_pos` (agent's potential position)\n  # is adjacent to (or directly on) the target `primitive_idx` within the `current_grid`.\n  # This condition typically allows the `ACTION_USE` to be effective for collection.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Iterate through a 3x3 neighborhood (including the center cell) around `check_pos`.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighboring coordinates are within the grid boundaries.\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # Check if the target primitive has a non-zero count at this neighboring cell.\n          if current_grid[nx, ny, target_idx] > 0:\n            return True # Target primitive found, meaning agent is in a position to use it.\n    return False # Target primitive not found in the neighborhood.\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])])\n  # A set to keep track of visited grid positions to avoid redundant explorations and cycles.\n  visited = {start_pos}\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    curr_pos, path = q.popleft() # Get the next position and its path from the queue.\n\n    # Check if the agent, at the `curr_pos`, is in a state to collect the primitive.\n    # If `is_next_to_target` is true, we have found a valid position to perform `ACTION_USE`.\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the `ACTION_USE` to the current path and return the complete sequence of actions.\n      # This path represents the shortest sequence of moves to get next to the primitive,\n      # followed by the action to collect it.\n      return path + [ACTION_USE]\n\n    # If the primitive is not yet collectible from `curr_pos`, explore all possible moves\n    # from the current position.\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Validate the next position: ensure it is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip moves that go out of bounds.\n\n      # If the `next_pos` has not been visited yet, add it to the queue for exploration.\n      # This ensures the BFS finds the shortest path by processing layers level by level.\n      if next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        q.append((next_pos, path + [action])) # Add the new position and its extended path to the queue.\n\n  # If the BFS completes and the queue is empty, it means no path was found to reach\n  # and collect the primitive from the initial state.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:31:21.552566", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # Get current state details\n  current_state = env._current_state\n  \n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Grid and position details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Get the index for water, which is assumed to be an unwalkable obstacle.\n  water_idx = env.world.water_index\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # This function checks the static grid for the primitive's location relative to check_pos\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # IMPROVEMENT FOR COLLECT_V2:\n      # Check if the next position contains unwalkable terrain (e.g., water).\n      # If the cell at next_pos contains water, it cannot be traversed.\n      if grid[next_x, next_y, water_idx] > 0:\n          continue # Skip this path, as it leads to an unwalkable cell\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:32:12.275484", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Refactored BFS neighbor exploration for clarity.\"\"\"\n  i_primitive = env.world.cookbook.index[primitive]\n\n  # Pre-check: If the target primitive's index is not in the set of grabbable items,\n  # it means it cannot be picked up (collected). Return an empty list of actions.\n  if i_primitive not in env.world.grabbable_indices:\n      return []\n\n  # Get the current state information from the environment.\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  width, height, n_kinds = grid.shape # Dimensions of the grid and number of item kinds.\n\n  # Map action names to their integer indices.\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # First, check if the agent is already positioned such that the primitive\n  # can be collected immediately using the 'USE' action. This means the primitive\n  # is in the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(i_primitive):\n    return [USE] # If so, only the USE action is needed.\n\n  # Get the set of indices for items that are not grabbable.\n  # These items are typically static environment features or obstacles that block movement.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Define a helper function to determine if a given grid cell (r, c) is traversable by the agent.\n  # A cell is traversable if it's within bounds and doesn't contain any non-grabbable item.\n  def is_cell_traversable(r, c):\n      # 1. Check if the cell coordinates are within the grid boundaries.\n      if not (0 <= r < width and 0 <= c < height):\n          return False # Out of bounds, not traversable.\n\n      # 2. Check if the cell contains any item that is designated as non-grabbable.\n      # If any non-grabbable item is present in this cell, it's considered an obstacle.\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0: # If the count of this non-grabbable item is greater than 0\n              return False # The cell is blocked by an impassable object.\n      return True # If no blocking items are found, the cell is traversable.\n\n  # Initialize a Breadth-First Search (BFS) to find the shortest path\n  # to a location from which the target primitive can be collected.\n  # The queue stores tuples of (current_position, list_of_actions_to_reach_current_position).\n  queue = collections.deque([(current_pos, [])]) \n  # A set to keep track of visited positions to prevent cycles and redundant exploration.\n  visited = {current_pos} \n\n  # Define possible movements as (dr, dc, action_id) tuples.\n  # This makes the BFS exploration loop more concise by directly providing the action.\n  # Maintaining the order from v1: RIGHT, LEFT, DOWN, UP\n  movements = [\n      (0, 1, RIGHT),  # Move Right (column +1)\n      (0, -1, LEFT),  # Move Left (column -1)\n      (1, 0, DOWN),   # Move Down (row +1)\n      (-1, 0, UP),    # Move Up (row -1)\n  ]\n\n  # Start the BFS traversal.\n  while queue:\n    (r, c), path = queue.popleft() # Dequeue the current position and its path.\n\n    # Check if the current position (r, c) is a goal state for the BFS.\n    # A goal state is any position from which the agent can successfully\n    # use the 'USE' action to collect the primitive. This means the primitive\n    # must be in the 3x3 neighborhood (including the agent's current cell).\n    is_adjacent_or_on_primitive = False\n    for dr_check in [-1, 0, 1]: # Iterate over rows in 3x3 neighborhood\n        for dc_check in [-1, 0, 1]: # Iterate over columns in 3x3 neighborhood\n            check_r, check_c = r + dr_check, c + dc_check\n            # Ensure the neighbor cell is within bounds and contains the primitive.\n            if (0 <= check_r < width and 0 <= check_c < height and \n                grid[check_r, check_c, i_primitive] > 0):\n                is_adjacent_or_on_primitive = True\n                break # Found the primitive in the neighborhood, no need to check further.\n        if is_adjacent_or_on_primitive:\n            break\n\n    if is_adjacent_or_on_primitive:\n        # If a goal position is found, return the path to it plus the 'USE' action.\n        return path + [USE]\n\n    # If not a goal state, explore valid neighboring cells.\n    for dr, dc, action_to_take in movements:\n      nr, nc = r + dr, c + dc # Calculate the coordinates of the neighboring cell.\n\n      # If the neighbor cell has not been visited and is traversable, add it to the queue.\n      if (nr, nc) not in visited and is_cell_traversable(nr, nc):\n        visited.add((nr, nc)) # Mark the neighbor as visited.\n        queue.append(((nr, nc), path + [action_to_take])) # Add the neighbor and its path to the queue.\n\n  # If the BFS completes and no path to a collectable primitive is found after\n  # exhausting all reachable positions, return an empty list.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:32:13.445704", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive]\n\n  # If the primitive is not grabbable (e.g., water, stone, workshops), it cannot be collected.\n  if i_primitive not in env.world.grabbable_indices:\n      return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  width, height, n_kinds = grid.shape\n\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (delta_row, delta_col) to the corresponding action index.\n  move_deltas = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # First, check if the primitive is immediately collectible from the agent's current position.\n  # The `next_to` method checks the 3x3 neighborhood around the agent.\n  if current_state.next_to(i_primitive):\n    return [USE]\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # Helper function to determine if a cell is traversable.\n  # A cell is traversable if it's within grid bounds and contains no non-grabbable items.\n  def is_cell_traversable(r: int, c: int) -> bool:\n      if not (0 <= r < width and 0 <= c < height):\n          return False  # Out of bounds\n      # Check if any non-grabbable item occupies this cell.\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0:\n              return False  # Cell is blocked by an obstacle.\n      return True\n\n  # Helper function to check if a given (r, c) position allows collection of the target item.\n  # This means the target item must be present in the 3x3 neighborhood of (r, c).\n  def can_collect_from_position(r: int, c: int, target_item_idx: int) -> bool:\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              check_r, check_c = r + dr_check, c + dc_check\n              # Ensure the cell being checked is within grid boundaries.\n              if (0 <= check_r < width and 0 <= check_c < height and \n                  grid[check_r, check_c, target_item_idx] > 0):\n                  return True  # Target item found in neighborhood.\n      return False\n\n  # Initialize BFS. Queue stores (position, path_to_reach_position).\n  queue = collections.deque([(current_pos, [])]) \n  visited = {current_pos} \n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # If the current position is a goal position (i.e., we can collect from here).\n    if can_collect_from_position(r, c, i_primitive):\n        return path + [USE]  # Return the path to this position plus the USE action.\n\n    # Explore valid neighbors (Up, Down, Left, Right).\n    # Order of exploration is (Right, Left, Down, Up) for consistency with v1.\n    for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      nr, nc = r + dr, c + dc\n\n      if (nr, nc) not in visited and is_cell_traversable(nr, nc):\n        visited.add((nr, nc))\n        action_to_take = move_deltas[(dr, dc)]\n        queue.append(((nr, nc), path + [action_to_take]))\n\n  # If BFS completes and no path is found, return an empty list.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:33:02.479994", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  \n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it cannot be collected.\n    return []\n\n  # Define action mappings and movement deltas\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Map move actions to (delta_x, delta_y) for position updates.\n  _action_to_delta = {\n      ACTION_UP: (0, -1),    # Moves up (y decreases)\n      ACTION_DOWN: (0, 1),   # Moves down (y increases)\n      ACTION_LEFT: (-1, 0),  # Moves left (x decreases)\n      ACTION_RIGHT: (1, 0),  # Moves right (x increases)\n  }\n  # Map move actions to the resulting cardinal direction (0:N, 1:E, 2:S, 3:W).\n  _action_to_dir = {\n      ACTION_UP: 0,    # North\n      ACTION_DOWN: 2,  # South\n      ACTION_LEFT: 3,  # West\n      ACTION_RIGHT: 1, # East\n  }\n  # Map agent's direction to (delta_x, delta_y) of the cell directly in front.\n  _dir_to_delta = {\n      0: (0, -1), # North: cell at (x, y-1)\n      1: (1, 0),  # East: cell at (x+1, y)\n      2: (0, 1),  # South: cell at (x, y+1)\n      3: (-1, 0), # West: cell at (x-1, y)\n  }\n\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Determine if the primitive is a 'grabbable' resource that requires a 'USE' action\n  # and will be added to inventory (e.g., WOOD, IRON).\n  # Non-grabbable entities (e.g., WORKSHOP, WATER) are \"collected\" by simply facing them.\n  requires_use_action = (primitive_idx in world.cookbook.primitives)\n\n  # Early exit: If it's a grabbable resource and already in inventory, no actions are needed.\n  if requires_use_action and current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get the set of indices for entities that block agent movement (obstacles).\n  # The agent cannot move into a cell occupied by these items.\n  non_grabbable_obstacle_indices = world.non_grabbable_indices\n\n  # Helper function to check if a grid position is within the defined boundaries.\n  def _is_within_bounds(x, y):\n    return 0 <= x < grid_width and 0 <= y < grid_height\n\n  # Helper function to check if a grid cell is blocked by any non-grabbable obstacle.\n  def _is_blocked(x, y):\n    for obstacle_kind_idx in non_grabbable_obstacle_indices:\n      # If the cell contains any quantity of an obstacle kind, it's blocked.\n      if grid[x, y, obstacle_kind_idx] > 0:\n        return True\n    return False\n\n  # Initialize Breadth-First Search (BFS) queue and visited set.\n  # BFS state: ((current_x, current_y, current_direction), list_of_actions_taken)\n  initial_pos_x, initial_pos_y = current_state.pos \n  initial_dir = current_state.dir   \n  \n  q = collections.deque([((initial_pos_x, initial_pos_y, initial_dir), [])])\n  \n  # Visited set: stores (x, y, direction) tuples to prevent redundant exploration and cycles.\n  visited = {(initial_pos_x, initial_pos_y, initial_dir)}\n\n  while q:\n    (current_x, current_y, current_dir), path = q.popleft()\n\n    # Step 1: Check if the primitive can be collected from the current state.\n    # This involves looking at the cell directly in front of the agent.\n    dx_face, dy_face = _dir_to_delta[current_dir]\n    target_cell_x, target_cell_y = current_x + dx_face, current_y + dy_face\n\n    if _is_within_bounds(target_cell_x, target_cell_y):\n      # Check if the primitive is present in the target cell.\n      if grid[target_cell_x, target_cell_y, primitive_idx] > 0:\n        # A state from which the primitive can be collected has been found.\n        if requires_use_action:\n          # If it's a grabbable resource, append the 'USE' action and return the path.\n          return path + [ACTION_USE]\n        else:\n          # If it's a non-grabbable entity (e.g., workshop), simply facing it is enough.\n          return path\n\n    # Step 2: Explore possible next states by taking valid movement actions.\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dx_move, dy_move = _action_to_delta[action_idx]\n      next_x, next_y = current_x + dx_move, current_y + dy_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move.\n\n      # Check if the new position is within grid boundaries.\n      if not _is_within_bounds(next_x, next_y):\n        continue # Skip if out of bounds.\n\n      # Check if the new position is blocked by an obstacle.\n      if _is_blocked(next_x, next_y):\n        continue # Skip if the cell is blocked.\n\n      # Form the key for the next state for the visited set.\n      next_state_key = (next_x, next_y, next_dir)\n      # If this new state has not been visited, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:33:03.749187", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  \n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it cannot be collected.\n    return []\n\n  # Early exit: If the primitive is a grabbable resource (e.g., WOOD, IRON)\n  # and already in the agent's inventory, no actions are needed.\n  # Environmental features (e.g., workshops, water) are not held in inventory,\n  # so this check only applies to actual resources that replenish inventory.\n  if primitive_idx in world.cookbook.primitives:\n    if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Get initial state properties. Agent's position is (x, y) where x is column, y is row.\n  initial_pos_x, initial_pos_y = current_state.pos \n  # Agent's direction: 0:North, 1:East, 2:South, 3:West.\n  initial_dir = current_state.dir   \n  \n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n\n  # Map action names to their integer IDs for clarity and robustness.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define how movement actions change (x, y) coordinates and agent's direction.\n  # _action_to_delta: maps a move action to its (dx, dy) change in position.\n  _action_to_delta = {\n      ACTION_UP: (0, -1),    # Moves up (y decreases)\n      ACTION_DOWN: (0, 1),   # Moves down (y increases)\n      ACTION_LEFT: (-1, 0),  # Moves left (x decreases)\n      ACTION_RIGHT: (1, 0),  # Moves right (x increases)\n  }\n  # _action_to_dir: maps a move action to the resulting agent's cardinal direction.\n  # This mapping is consistent with CraftState.dir conventions (0:N, 1:E, 2:S, 3:W).\n  _action_to_dir = {\n      ACTION_UP: 0,    # North\n      ACTION_DOWN: 2,  # South\n      ACTION_LEFT: 3,  # West\n      ACTION_RIGHT: 1, # East\n  }\n  # _dir_to_delta: maps an agent's direction to the (dx, dy) offset of the cell directly in front.\n  # This is used to determine which cell the 'USE' action would affect.\n  _dir_to_delta = {\n      0: (0, -1), # North: (x, y-1)\n      1: (1, 0),  # East: (x+1, y)\n      2: (0, 1),  # South: (x, y+1)\n      3: (-1, 0), # West: (x-1, y)\n  }\n\n  # Determine if the primitive needs a 'USE' action to be collected.\n  # Primitive resources (e.g., WOOD, IRON) are those that are added to inventory and require 'USE'.\n  # Environmental features (e.g., WORKSHOP, WATER, BOUNDARY) are typically just \"used\" by facing them,\n  # without consuming or adding to inventory, so they do not require an explicit 'USE' action in the returned path.\n  requires_use_action = (primitive_idx in world.cookbook.primitives)\n\n  # Get the set of indices for entities that block agent movement (obstacles).\n  # The agent cannot move into a cell occupied by these non-grabbable items.\n  non_grabbable_obstacle_indices = world.non_grabbable_indices\n\n  # Initialize Breadth-First Search (BFS) queue and visited set.\n  # BFS state is represented as ((current_x, current_y, current_dir), list_of_actions_taken_to_reach_this_state)\n  q = collections.deque([((initial_pos_x, initial_pos_y, initial_dir), [])])\n  # The visited set stores (x, y, direction) tuples to prevent redundant exploration and cycles.\n  visited = {(initial_pos_x, initial_pos_y, initial_dir)}\n\n  while q:\n    (current_x, current_y, current_dir), path = q.popleft()\n\n    # Step 1: Check if the primitive can be collected from the current state (position and direction).\n    # This involves inspecting the cell directly in front of the agent.\n    dx_face, dy_face = _dir_to_delta[current_dir]\n    target_cell_x, target_cell_y = current_x + dx_face, current_y + dy_face\n\n    # Ensure the target cell is within grid boundaries.\n    if 0 <= target_cell_x < grid_width and 0 <= target_cell_y < grid_height:\n      # Check if the primitive is present in the target cell (indicated by a count > 0).\n      if grid[target_cell_x, target_cell_y, primitive_idx] > 0:\n        # A state from which the primitive can be collected has been found.\n        if requires_use_action:\n          # If it's a grabbable resource (e.g., WOOD, STONE), append the 'USE' action to the path.\n          return path + [ACTION_USE]\n        else:\n          # If it's a non-grabbable entity (like a workshop or water), simply being able to face it\n          # is considered 'collected' for the purpose of the DSL's 'collect' action. No 'USE' is appended.\n          return path\n\n    # Step 2: Explore possible next states by taking valid movement actions (UP, DOWN, LEFT, RIGHT).\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dx_move, dy_move = _action_to_delta[action_idx]\n      next_x, next_y = current_x + dx_move, current_y + dy_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move.\n\n      # Check if the potential new agent position is within grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Skip if out of bounds.\n\n      # Check if the potential new agent position contains any obstacles.\n      # The agent cannot move into a cell that contains an item from `non_grabbable_obstacle_indices`.\n      is_obstacle = False\n      # Iterate through all known obstacle types defined in the world.\n      for obstacle_kind_idx in non_grabbable_obstacle_indices:\n        # If the cell at (next_x, next_y) has any quantity of an obstacle kind, it's blocked.\n        if grid[next_x, next_y, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break \n      \n      if is_obstacle:\n        continue # Skip if the path is blocked by an obstacle.\n\n      # Create the key for the next state (position and direction) for the visited set.\n      next_state_key = (next_x, next_y, next_dir)\n      # If this state has not been visited, add it to the queue for further exploration.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:33:39.863833", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the primitive is already in the agent's inventory. If so, no collection actions are needed.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # The 'collect' function implies obtaining the item in inventory.\n  # If the primitive is not in the set of items that can be picked up (grabbable),\n  # it cannot be \"collected\" in the sense of adding to inventory.\n  # Examples like BOUNDARY, WATER, WORKSHOP0 are in the DSL's 'primitive' list\n  # but are not designed to be picked up by the agent.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve current state information for pathfinding.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs for BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),\n      ((0, -1), UP_ACTION),\n      ((-1, 0), LEFT_ACTION),\n      ((1, 0), RIGHT_ACTION),\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is adjacent to the target primitive.\n  # The 'USE' action in CraftWorld typically works on items in the 3x3 neighborhood.\n  queue = collections.deque([(agent_pos, [])]) # Stores (current_position, path_taken_to_reach_here).\n  visited = {agent_pos} # Set of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. This allows for the 'USE' action.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # A cell is considered \"adjacent\" if it's within 1 unit of Manhattan distance\n          # in both x and y, forming a 3x3 square (including the center).\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement path + use action).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is not explicitly defined as traversable (e.g., workshops, water).\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this cell...\n                  if k_idx in env.world.non_grabbable_indices and\\\n                     k_idx not in env.world.workshop_indices and\\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # This cell is blocked by an impassable object.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position given the current grid.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:33:41.106511", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the primitive is already in the agent's inventory.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      # If the agent already has at least one of the primitive, no collection actions are needed.\n      return []\n\n  # The 'collect' function implies obtaining the item in inventory.\n  # If the primitive is not in the set of items that can be picked up (grabbable),\n  # it cannot be \"collected\" in the sense of adding to inventory directly.\n  # For example, 'BOUNDARY', 'WATER', 'WORKSHOP0' are not meant to be picked up.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve current state information from the environment.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Pre-compute the set of non-grabbable entities that are still traversable.\n  # These typically include workshops and water, which the agent can move through.\n  traversable_non_grabbables = set(env.world.workshop_indices)\n  traversable_non_grabbables.add(env.world.water_index)\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is adjacent to the target primitive.\n  # The queue stores (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. A 3x3 neighborhood is considered\n      # \"adjacent\" for the purpose of the 'USE' action in CraftWorld.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is NOT in the set of traversable non-grabbables.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this cell...\n                  if k_idx in env.world.non_grabbable_indices and\\\n                     k_idx not in traversable_non_grabbables:\n                      is_impassable = True\n                      break # No need to check other kinds in this cell; it's blocked.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:34:40.303746", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  world = env.world # Get the CraftWorld instance for more info\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, n_kinds = grid.shape\n\n  # Define impassable terrain indices\n  # Start with explicitly known impassables like BOUNDARY and WATER.\n  # Then, add other non-grabbable entities, unless they are explicitly workshops (which are usually traversable).\n  true_impassable_indices = set()\n  if 'BOUNDARY' in cookbook.index.contents:\n      true_impassable_indices.add(cookbook.index['BOUNDARY'])\n  if 'WATER' in cookbook.index.contents:\n      true_impassable_indices.add(cookbook.index['WATER'])\n  \n  # Identify non-grabbable items that are generally traversable, like workshops.\n  traversable_non_grabbables = set(world.workshop_indices)\n  \n  # Iterate through all non-grabbable indices from the world configuration.\n  # If a non-grabbable item is NOT in our set of explicitly traversable non-grabbables (like workshops),\n  # then consider it impassable for movement.\n  for idx in world.non_grabbable_indices:\n      if idx not in traversable_non_grabbables:\n          true_impassable_indices.add(idx)\n\n  # Helper function to check if a cell is traversable\n  def is_cell_traversable(x, y):\n      # Check if within grid boundaries\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Check if the cell contains any truly impassable object\n      for imp_idx in true_impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Contains an impassable object\n      return True\n\n  # Check if the agent's starting position is traversable. If not, no path is possible.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of BFS target cells.\n  # These are any traversable cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any traversable cell in the 3x3 neighborhood\n  # (including the primitive's cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        \n        # A potential target cell must be within grid bounds AND traversable by the agent\n        if is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no valid traversable target cells exist (e.g., all cells around primitive are impassable)\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of (x, y) tuples to avoid cycles and redundant paths\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell from which the primitive can be used.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and is traversable\n      if not is_cell_traversable(next_x, next_y):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.0}}
