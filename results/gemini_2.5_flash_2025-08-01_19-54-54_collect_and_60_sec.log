{"timestamp": "2025-08-02T10:56:13.329091", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # Determine if the primitive is grabbable (needs USE action when adjacent) or non-grabbable (just needs reaching the cell).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Initial \"already collected\" check (from collect_v1)\n  if is_grabbable:\n    # For grabbable items, \"collected\" means having at least one in inventory.\n    if state.inventory[primitive_idx] > 0:\n      return [] \n  else: # This covers all non-grabbable items like workshops, water, stone, boundary.\n    # For non-grabbable items, \"collected\" means being on the cell that contains them.\n    # Check if the target primitive is present at the agent's current cell.\n    if grid[start_pos[0], start_pos[1], primitive_idx] > 0:\n      return []\n  \n  # New improvement for collect_v2: If the primitive is grabbable and the agent is already adjacent to it,\n  # a single USE action is sufficient to collect it without needing pathfinding.\n  if is_grabbable and state.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # BFS setup for pathfinding.\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {start_pos} \n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    else: # This covers non-grabbable primitives like workshops, water, stone, or boundary.\n      # For non-grabbable primitives, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:57:10.231990", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-02T10:57:11.414136", "function_name": "collect", "function_body": "  current_craft_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_craft_state.grid \n  \n  # 1. Map the primitive name to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not recognized, cannot collect.\n    return []\n\n  # 2. Retrieve action mappings for clarity and robustness.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define constant data for grid and direction calculations.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Maps agent's internal direction (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT) to (dx, dy) offsets.\n  DIR_VECTORS = {\n      0: (0, -1), # UP: (x, y-1)\n      1: (0, 1),  # DOWN: (x, y+1)\n      2: (-1, 0), # LEFT: (x-1, y)\n      3: (1, 0)   # RIGHT: (x+1, y)\n  }\n\n  # 4. Determine the type of primitive for specific collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_stationary_env_feature = (primitive_idx == env.world.water_index or \n                               primitive_idx == env.world.stone_index or \n                               primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # 5. Early Exit Optimization: If the primitive is grabbable and already in inventory.\n  if is_grabbable and current_craft_state.inventory[primitive_idx] > 0:\n    return []\n\n  # --- Helper Function for Collection Check ---\n  def _can_collect_from_state(\n      state_pos: tuple[int, int], state_dir: int, \n      target_idx: int, is_target_grabbable: bool, is_target_workshop: bool, \n      is_target_stationary_env_feature: bool, \n      grid_data: np.ndarray, grid_width: int, grid_height: int,\n      use_action: int, dir_vectors: dict\n  ) -> tuple[bool, list[int]]:\n    \"\"\"\n    Checks if the specified primitive can be \"collected\" from the given agent state (position, direction).\n\n    Args:\n        state_pos (tuple): Agent's (x, y) coordinates.\n        state_dir (int): Agent's facing direction.\n        target_idx (int): Integer ID of the primitive.\n        is_target_grabbable (bool): True if the primitive is a grabbable item.\n        is_target_workshop (bool): True if the primitive is a workshop location.\n        is_target_stationary_env_feature (bool): True if the primitive is a stationary environment feature (water, stone, boundary).\n        grid_data (numpy.ndarray): The current grid layout.\n        grid_width (int): Width of the grid.\n        grid_height (int): Height of the grid.\n        use_action (int): The integer index for the 'USE' action.\n        dir_vectors (dict): Mapping from direction index to (dx, dy) offsets.\n\n    Returns:\n        tuple[bool, list[int]]: A tuple. The first element is True if collection is possible.\n                                The second is a list of final actions required (e.g., [USE] or []).\n    \"\"\"\n    if is_target_grabbable:\n      # For grabbable items, check the cell directly in front of the agent.\n      dx, dy = dir_vectors[state_dir]\n      fwd_x, fwd_y = state_pos[0] + dx, state_pos[1] + dy\n      \n      if 0 <= fwd_x < grid_width and 0 <= fwd_y < grid_height:\n        if grid_data[fwd_x, fwd_y, target_idx] > 0:\n          return True, [use_action] # Requires 'USE' action.\n    \n    elif is_target_workshop or is_target_stationary_env_feature:\n      # For stationary features or workshops, check if the agent is on the target cell.\n      if grid_data[state_pos[0], state_pos[1], target_idx] > 0:\n        return True, [] # No additional action needed, just being on the spot.\n            \n    return False, [] # Primitive cannot be collected from this state.\n  # --- End of Helper Function ---\n\n  # --- BFS Initialization ---\n  # Queue stores (current_position (x,y), current_direction, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(current_craft_state.pos, current_craft_state.dir, [])]) \n  \n  # Visited set tracks (position, direction) pairs to prevent redundant exploration and cycles.\n  visited = {(current_craft_state.pos, current_craft_state.dir)} \n\n  # Variables to store the shortest complete path found during the BFS.\n  min_total_path_len = float('inf')\n  best_path_actions = []\n\n  # --- BFS Loop ---\n  while q:\n    current_pos, current_dir, current_path_actions = q.popleft()\n\n    # Pruning Optimization: If the current path already equals or exceeds\n    # the shortest complete path found so far, prune this branch.\n    if len(current_path_actions) >= min_total_path_len:\n        continue\n\n    # --- Check for Goal Satisfaction at Current BFS Node using the helper ---\n    can_collect, final_collection_actions = _can_collect_from_state(\n        current_pos, current_dir, primitive_idx, \n        is_grabbable, is_workshop, is_stationary_env_feature, \n        grid, WIDTH, HEIGHT, ACTION_USE, DIR_VECTORS\n    )\n    \n    if can_collect:\n      total_actions_sequence = current_path_actions + final_collection_actions\n      # If this complete sequence of actions is shorter than the best found so far, update.\n      if len(total_actions_sequence) < min_total_path_len:\n        min_total_path_len = len(total_actions_sequence)\n        best_path_actions = total_actions_sequence\n      \n      # IMPORTANT: Do NOT break the BFS here. Continuing the search guarantees finding\n      # the globally shortest path because a seemingly longer movement path to a\n      # (pos, dir) state might, when combined with the final collection action,\n      # still result in a shorter *total* sequence.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # Consider all four possible movement actions: UP, DOWN, LEFT, RIGHT.\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # Simulate the effect of taking 'action_type' using a temporary CraftState instance.\n      # This correctly applies environment rules (e.g., collisions, direction changes).\n      # The grid and inventory remain static for pathfinding within this function.\n      temp_state_for_step = craft.CraftState(\n          current_craft_state.scenario, current_craft_state.grid, \n          current_pos, current_dir, current_craft_state.inventory\n      )\n      \n      # Perform the movement action. Reward is not relevant for pathfinding.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir) # Define the new state for visited tracking.\n\n      # If this new (position, direction) state has not been visited, add it to the queue.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_path_actions + [action_type]))\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  # If no path was found (q became empty and min_total_path_len is still infinity),\n  # this will correctly return an empty list.\n  return best_path_actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-02T10:58:18.070573", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Resolve the primitive name to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in the cookbook, cannot collect it.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory,\n  # no actions are needed to collect it.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings (integer IDs) from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 4. Define possible movement actions relative to the agent's position.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # 5. Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Initialize BFS (Breadth-First Search).\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 7. Categorize the target primitive based on how it's \"collected\".\n  # This determines the specific goal condition in the BFS.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  # Workshops, water, stone, and boundary (if we need to reach it) are \"collected\" by reaching their cell.\n  # We use the explicit indices from world for water/stone.\n  is_stationary_target = (\n      primitive_idx in env.world.workshop_indices or\n      (env.world.water_index is not None and primitive_idx == env.world.water_index) or\n      (env.world.stone_index is not None and primitive_idx == env.world.stone_index) or\n      ('BOUNDARY' in cookbook.index.contents and primitive_idx == cookbook.index['BOUNDARY'])\n  )\n\n  # 8. Define common impassable terrain kinds for movement.\n  # These are entities that typically block agent movement.\n  # However, if the `primitive_idx` itself is one of these (e.g., WATER),\n  # then we *can* move onto that specific kind's cell to \"collect\" it.\n  impassable_terrain_kinds = set()\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_terrain_kinds.add(cookbook.index['BOUNDARY'])\n  if env.world.water_index is not None:\n      impassable_terrain_kinds.add(env.world.water_index)\n  if env.world.stone_index is not None:\n      impassable_terrain_kinds.add(env.world.stone_index)\n\n  # 9. BFS search loop.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows using CraftState's methods (like `next_to`) from this specific grid cell.\n    hypothetical_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 10. Check if the current_pos satisfies the goal for collecting the primitive.\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then 'USE'.\n      if hypothetical_state.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_stationary_target:\n      # For workshops or other stationary targets, \"collecting\" means simply being on their cell.\n      if hypothetical_state.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No additional 'USE' action needed; reaching is enough.\n\n    # 11. Explore valid neighbors of the current position.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n        continue # Out of bounds\n\n      # 12. Check for impassable terrain at the new position.\n      # A cell is considered blocked if it contains any kind from `impassable_terrain_kinds`\n      # UNLESS that kind is the specific primitive we are currently trying to collect.\n      is_blocked = False\n      for kind_id in impassable_terrain_kinds:\n          # If an impassable kind is present at the new position\n          if grid[new_x, new_y, kind_id] > 0:\n              # And it's NOT the primitive we are trying to collect (because we want to reach it)\n              if kind_id != primitive_idx:\n                  is_blocked = True\n                  break # This cell is blocked by an obstacle\n      \n      if is_blocked:\n          continue # Skip this blocked path\n\n      # 13. If the new position has not been visited yet, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, current_actions + [action]))\n  \n  # 14. If the BFS completes and no path to the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T10:58:19.420937", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Map the primitive name to its integer ID using the cookbook's index.\n  # The __getitem__ method of the Index class returns an int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None or primitive_idx == 0: \n    # If the primitive name is not found, or maps to an invalid index (0),\n    # it cannot be collected.\n    return []\n\n  # 2. Determine the type of primitive for appropriate collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Stationary primitives are non-grabbable items that you typically reach\n  # (like water, stone, or a boundary if it's a goal).\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # 3. Early exit: Check if the primitive is already \"collected\" at the initial state.\n  # For grabbable items, this means checking the agent's inventory.\n  # For stationary/workshop items, this means checking if the agent is already on the target cell.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n  elif (is_workshop or is_stationary_primitive) and \\\n       grid[state.pos[0], state.pos[1], primitive_idx] > 0:\n    return []\n\n  # 4. Get action mappings (integer IDs) from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions (delta_x, delta_y, action_id).\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify the index for 'BOUNDARY' for impassability checks.\n  # If 'BOUNDARY' itself is the target primitive, the agent should be able to enter it.\n  boundary_kind_idx = cookbook.index['BOUNDARY']\n\n  # 5. Initialize BFS (Breadth-First Search) for pathfinding.\n  # q: Stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  # visited: Keeps track of grid positions already explored to prevent cycles and redundant paths.\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 6. BFS search loop.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's methods (like `next_to`) from this specific grid cell\n    # without actually modifying the environment's internal state.\n    hypothetical_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 7. Check if the current position (or its neighborhood) satisfies the goal.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if hypothetical_state.next_to(primitive_idx):\n        # BFS guarantees finding the shortest path to an adjacent cell.\n        # Append the 'USE' action to complete the collection.\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or natural features (e.g., WATER, STONE, BOUNDARY),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # Check if the target primitive is present at the current cell's location in the grid.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # This is the shortest path to a cell containing the primitive.\n        return current_actions # No additional 'USE' action needed; reaching is enough.\n\n    # 8. Explore valid and traversable neighbors of the current position.\n    for dx, dy, action_id in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n        continue # Out of bounds.\n\n      # Check if the new position is traversable.\n      # A cell is considered impassable if it contains a 'BOUNDARY' entity,\n      # UNLESS 'BOUNDARY' itself is the primitive we are trying to collect.\n      if boundary_kind_idx is not None and \\\n         primitive_idx != boundary_kind_idx and \\\n         grid[new_x, new_y, boundary_kind_idx] > 0:\n          continue # Cannot move into a boundary if it's not the target.\n\n      # If the new position has not been visited yet, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, current_actions + [action_id]))\n  \n  # 9. If the BFS completes and no path to the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:59:38.098122", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` to handle already collected primitives by checking inventory.\"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  inventory = state.inventory # Get current inventory\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # --- IMPROVEMENT for v2: Check if the primitive is already in inventory ---\n  # If the agent already possesses the primitive, no actions are needed to collect it.\n  if inventory[primitive_idx] > 0:\n    return []\n  # --------------------------------------------------------------------------\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action.\n  # CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Determine if the primitive is grabbable.\n  # Non-grabbable primitives like WORKSHOPs, WATER, BOUNDARY typically\n  # do not involve a 'USE' action for \"collection\" but rather just require getting next to them.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Define a helper function to efficiently check the 3x3 neighborhood of a given position.\n  # This avoids repeated CraftState object creation and directly accesses the grid.\n  def _is_primitive_next_to(current_pos_check, target_idx):\n    cx_check, cy_check = current_pos_check\n    min_x = max(0, cx_check - 1)\n    max_x = min(WIDTH, cx_check + 2)\n    min_y = max(0, cy_check - 1)\n    max_y = min(HEIGHT, cy_check + 2)\n    \n    # Check if any cell in the 3x3 slice (including the center) contains the target primitive.\n    # np.any is used for efficiency on the grid slice.\n    return np.any(grid[min_x:max_x, min_y:max_y, target_idx])\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    \n    # Use the efficient helper function to check if the primitive is in the 3x3 neighborhood\n    # of the current_pos.\n    if _is_primitive_next_to(current_pos, primitive_idx):\n      # If the primitive is found in the vicinity, decide on the final action.\n      if is_grabbable:\n        # For grabbable items, the 'USE' action is required to pick them up.\n        return current_path + [USE]\n      else:\n        # For non-grabbable items (e.g., workshops, water), the goal is simply\n        # to be adjacent to them. No 'USE' action is appended.\n        return current_path\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in moves:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position has already been visited to avoid cycles and redundant paths.\n        if next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found (e.g., primitive is unreachable),\n  # return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:59:39.260816", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action.\n  # CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Determine if the primitive is grabbable.\n  # Non-grabbable primitives like WORKSHOPs, WATER, BOUNDARY typically\n  # do not involve a 'USE' action for \"collection\" but rather just require getting next to them.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Identify indices of terrain types that block movement.\n  # Common blocking elements are BOUNDARY and WATER in grid-based environments.\n  impassable_cell_content_indices = set()\n  try:\n      impassable_cell_content_indices.add(cookbook.index['BOUNDARY'])\n  except KeyError:\n      pass # 'BOUNDARY' might not be defined in all cookbook setups, though highly unlikely.\n  try:\n      impassable_cell_content_indices.add(cookbook.index['WATER'])\n  except KeyError:\n      pass # 'WATER' might not be defined.\n\n  # Define a helper function to efficiently check the 3x3 neighborhood of a given position.\n  # This avoids repeated CraftState object creation and directly accesses the grid.\n  def _is_primitive_next_to(current_pos_check, target_idx):\n    cx_check, cy_check = current_pos_check\n    min_x = max(0, cx_check - 1)\n    max_x = min(WIDTH, cx_check + 2)\n    min_y = max(0, cy_check - 1)\n    max_y = min(HEIGHT, cy_check + 2)\n    \n    # Check if any cell in the 3x3 slice (including the center) contains the target primitive.\n    # np.any is used for efficiency on the grid slice.\n    return np.any(grid[min_x:max_x, min_y:max_y, target_idx])\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    \n    # Use the efficient helper function to check if the primitive is in the 3x3 neighborhood\n    # of the current_pos.\n    if _is_primitive_next_to(current_pos, primitive_idx):\n      # If the primitive is found in the vicinity, decide on the final action.\n      if is_grabbable:\n        # For grabbable items, the 'USE' action is required to pick them up.\n        return current_path + [USE]\n      else:\n        # For non-grabbable items (e.g., workshops, water), the goal is simply\n        # to be adjacent to them. No 'USE' action is appended.\n        return current_path\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in moves:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position contains any impassable terrain content.\n        # A cell is considered blocked if it contains any item from the\n        # impassable_cell_content_indices set.\n        is_blocked = False\n        for block_idx in impassable_cell_content_indices:\n            if grid[next_x, next_y, block_idx] > 0:\n                is_blocked = True\n                break # This cell is blocked, no need to check other impassable types\n\n        if not is_blocked:\n          # Check if the next position has already been visited to avoid cycles and redundant paths.\n          if next_pos not in visited:\n            visited.add(next_pos)\n            queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found (e.g., primitive is unreachable),\n  # return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-02T11:00:47.197771", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by refining target conditions for different primitive types.\n    \n    Specifically, this version ensures that for workshop-type primitives, the agent targets being adjacent,\n    while for grabbable items, it targets being adjacent followed by a USE action, and for other\n    non-grabbables (like water/stone terrain), it targets being on the cell.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive from the cookbook index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Early Exit: If a grabbable primitive is already in inventory, no actions are needed.\n  # This check only applies to grabbable items because non-grabbables (like workshops)\n  # are locations and do not enter inventory.\n  if primitive_idx in env.world.grabbable_indices and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Retrieve action mappings from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement directions (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up: Decreases Y coordinate\n      (0, 1, ACTION_DOWN),   # Move Down: Increases Y coordinate\n      (-1, 0, ACTION_LEFT),  # Move Left: Decreases X coordinate\n      (1, 0, ACTION_RIGHT),  # Move Right: Increases X coordinate\n  ]\n\n  # Get the dimensions of the grid from the state.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # The agent's current starting position.\n  start_pos = state.pos\n\n  # Initialize Breadth-First Search (BFS) data structures:\n  # 'q' is a deque storing tuples: (current_position (x, y), list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # 'visited' is a set to keep track of already visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Pre-fetch the index for 'BOUNDARY' to identify impassable cells efficiently.\n  # We check for its existence in case the cookbook schema changes (unlikely for boundary).\n  boundary_idx = cookbook.index['BOUNDARY'] if 'BOUNDARY' in cookbook.index.contents else -1 \n\n  # Helper function to check if a target kind is in the 3x3 neighborhood of a position.\n  # This avoids creating `CraftState` objects in the BFS loop for performance.\n  # Consistent with CraftState.next_to, this includes the current cell (px, py).\n  def _is_adjacent_to_kind(check_grid, current_px, current_py, target_kind_idx):\n    for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n            nx_adj, ny_adj = current_px + dx_adj, current_py + dy_adj\n            # Check if the neighbor is within grid boundaries\n            if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                # Check if the neighbor cell contains the target kind (count > 0)\n                if check_grid[nx_adj, ny_adj, target_kind_idx] > 0:\n                    return True\n    return False\n\n  # BFS loop: Continues as long as there are positions to explore in the queue.\n  while q:\n    current_pos, current_actions = q.popleft()\n    px, py = current_pos # Unpack current position for direct grid access\n\n    goal_met = False\n    final_actions_to_add = []\n\n    # Determine the goal condition and necessary final action based on the primitive type.\n    if primitive_idx in env.world.grabbable_indices:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent\n      # to them, then perform ACTION_USE.\n      if _is_adjacent_to_kind(grid, px, py, primitive_idx):\n        goal_met = True\n        final_actions_to_add = [ACTION_USE]\n    elif primitive_idx in env.world.workshop_indices:\n      # For workshop locations, the agent needs to be adjacent to perform crafting.\n      # The 'collect' primitive for workshops means reaching adjacency, not performing USE.\n      if _is_adjacent_to_kind(grid, px, py, primitive_idx):\n        goal_met = True\n        # No ACTION_USE here, as USE for crafting is handled by the 'craft' DSL command.\n    else: \n      # For other non-grabbable items/locations (e.g., WATER, STONE, BOUNDARY if traversable),\n      # \"collecting\" means simply reaching the cell where they are located.\n      if grid[px, py, primitive_idx] > 0:\n        goal_met = True\n        # No USE action is typically needed for these\n    \n    # If the goal is met at the current position, return the path with any final actions.\n    if goal_met:\n      return current_actions + final_actions_to_add\n    \n    # If goal not met at current_pos, explore neighboring cells.\n    for dx, dy, action in MOVES:\n      new_x, new_y = px + dx, py + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position is a 'BOUNDARY' (impassable for movement).\n        is_impassable_boundary = False\n        # Only check if boundary_idx is valid (not -1, meaning 'BOUNDARY' was found).\n        if boundary_idx != -1 and grid[new_x, new_y, boundary_idx] > 0:\n            is_impassable_boundary = True\n\n        # If the new position has not been visited and is not an impassable boundary, add it to the queue.\n        if new_pos not in visited and not is_impassable_boundary:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found (or it's unreachable)\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:00:48.429720", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive from the cookbook index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Determine if the target primitive is a grabbable item (can be picked up into inventory).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Early Exit: If the grabbable primitive is already in inventory, no actions are needed.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Retrieve action mappings from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement directions (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up: Decreases Y coordinate\n      (0, 1, ACTION_DOWN),   # Move Down: Increases Y coordinate\n      (-1, 0, ACTION_LEFT),  # Move Left: Decreases X coordinate\n      (1, 0, ACTION_RIGHT),  # Move Right: Increases X coordinate\n  ]\n\n  # Get the dimensions of the grid from the state.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # The agent's current starting position.\n  start_pos = state.pos\n\n  # Initialize Breadth-First Search (BFS) data structures:\n  # 'q' is a deque storing tuples: (current_position (x, y), list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # 'visited' is a set to keep track of already visited positions to prevent cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Pre-fetch the index for 'BOUNDARY' to identify impassable cells efficiently.\n  # We check for its existence in case the cookbook schema changes (unlikely for boundary).\n  boundary_idx = cookbook.index['BOUNDARY'] if 'BOUNDARY' in cookbook.index.contents else -1 \n\n  # Helper function to check if a target kind is in the 3x3 neighborhood of a position.\n  # This avoids creating `CraftState` objects in the BFS loop for performance.\n  # Consistent with CraftState.next_to, this includes the current cell (px, py).\n  def _is_adjacent_to_kind(check_grid, current_px, current_py, target_kind_idx):\n    for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n            nx_adj, ny_adj = current_px + dx_adj, current_py + dy_adj\n            # Check if the neighbor is within grid boundaries\n            if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                # Check if the neighbor cell contains the target kind (count > 0)\n                if check_grid[nx_adj, ny_adj, target_kind_idx] > 0:\n                    return True\n    return False\n\n  # BFS loop: Continues as long as there are positions to explore in the queue.\n  while q:\n    current_pos, current_actions = q.popleft()\n    px, py = current_pos # Unpack current position for direct grid access\n\n    # Check if `current_pos` is a goal state for collecting the primitive.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent\n      # to them, then perform ACTION_USE.\n      if _is_adjacent_to_kind(grid, px, py, primitive_idx):\n        # BFS guarantees `current_actions` is the shortest path to `current_pos`.\n        # Adding ACTION_USE makes it the shortest complete action sequence.\n        return current_actions + [ACTION_USE]\n    else: \n      # For non-grabbable items/locations (e.g., WORKSHOP0, WATER, STONE),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # This primitive is \"collected\" once the agent reaches its location.\n      if grid[px, py, primitive_idx] > 0:\n        # BFS guarantees `current_actions` is the shortest path to `current_pos`.\n        # This is the shortest path to the primitive's location, so return immediately.\n        return current_actions # No USE action is typically needed for these\n    \n    # If goal not met at current_pos, explore neighboring cells.\n    for dx, dy, action in MOVES:\n      new_x, new_y = px + dx, py + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position is a 'BOUNDARY' (impassable for movement).\n        is_impassable_boundary = False\n        # Only check if boundary_idx is valid (not -1, meaning 'BOUNDARY' was found).\n        if boundary_idx != -1 and grid[new_x, new_y, boundary_idx] > 0:\n            is_impassable_boundary = True\n\n        # If the new position has not been visited and is not an impassable boundary, add it to the queue.\n        if new_pos not in visited and not is_impassable_boundary:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found (or it's unreachable)\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:01:54.325007", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-02T11:01:55.452376", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_move_actions_to_reach_here)\n  # 'move_actions_so_far' strictly contains only movement actions.\n  q = collections.deque([(start_pos, [])]) \n  \n  # visited_min_moves maps position -> minimum_number_of_move_actions_to_reach_this_position.\n  # This ensures that we always process a position via its shortest path of movements first,\n  # and prevents revisiting positions with longer move paths.\n  visited_min_moves = {start_pos: 0} \n\n  # Variables to track the best overall sequence of actions (moves + potential USE).\n  best_total_actions = []\n  min_total_action_len = float('inf')\n\n  # Determine properties of the target primitive for goal checking and action cost calculation.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special stationary primitives (e.g., water, stone, boundary) are \"collected\" by just reaching them.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, move_actions_so_far = q.popleft()\n    current_move_len = len(move_actions_so_far)\n\n    # Pruning 1: If we've already found a shorter or equal path (in terms of moves)\n    # to 'current_pos', then this path is not optimal for reaching 'current_pos', so skip.\n    if current_move_len > visited_min_moves.get(current_pos, float('inf')):\n      continue\n\n    # Pruning 2: If the current path of *move actions* combined with a potential\n    # 'USE' action is already longer than or equal to the best total path found so far,\n    # then this path cannot lead to a better solution, so prune.\n    potential_total_len_if_goal = current_move_len + (1 if is_grabbable else 0)\n    if potential_total_len_if_goal >= min_total_action_len:\n        continue\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect geometric pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if 'current_pos' represents a state from which the primitive can be \"collected\".\n    is_goal_achieved_at_current_pos = False\n    additional_actions_for_goal = [] # Actions required *after* reaching current_pos to complete collection\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_achieved_at_current_pos = True\n        additional_actions_for_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means simply being on the cell.\n      # No additional USE action is typically needed in this context.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_achieved_at_current_pos = True\n        additional_actions_for_goal = []\n    \n    # If a goal state is reached at the current position, evaluate this path.\n    if is_goal_achieved_at_current_pos:\n      total_actions = move_actions_so_far + additional_actions_for_goal\n      if len(total_actions) < min_total_action_len:\n        min_total_action_len = len(total_actions)\n        best_total_actions = total_actions\n      # We don't break here because there might be other paths to different instances of the primitive,\n      # or different cells that satisfy 'next_to', which could lead to a shorter overall action sequence.\n      # The 'min_total_action_len' and pruning handle global optimality.\n\n    # Explore neighbors of the current position (only movement actions)\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        new_move_actions = move_actions_so_far + [action]\n        new_move_len = len(new_move_actions)\n\n        # Only add 'new_pos' to the queue if this path to 'new_pos' is shorter\n        # than any path previously found to 'new_pos'.\n        if new_move_len < visited_min_moves.get(new_pos, float('inf')):\n          # Final pruning before enqueuing: If this potential new path (moves + potential USE)\n          # is already too long compared to the best total path found so far, don't even add it.\n          if new_move_len + (1 if is_grabbable else 0) < min_total_action_len:\n            visited_min_moves[new_pos] = new_move_len\n            q.append((new_pos, new_move_actions))\n  \n  return best_total_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:03:07.299277", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive from the cookbook's index mapping.\n  # This mapping is essential to identify the primitive on the grid.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Find all grid coordinates where the primitive exists.\n  # np.argwhere returns a list of (x, y) tuples where the specified primitive's layer in the grid has a value of 1.\n  target_coords = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(target_coords) == 0:\n    # If no instances of the primitive are found on the grid, return an empty list of actions.\n    return []\n\n  # 3. Determine the agent's current position for distance calculations.\n  current_x, current_y = agent_pos\n\n  # 4. Find the closest primitive instance using Manhattan distance.\n  # Manhattan distance (L1 norm) is suitable for grid-based movement.\n  min_dist = float('inf')\n  closest_target_pos = None \n\n  for tx, ty in target_coords:\n    dist = abs(tx - current_x) + abs(ty - current_y)\n    if dist < min_dist:\n      min_dist = dist\n      closest_target_pos = (tx, ty)\n\n  # This check is a safeguard; closest_target_pos should not be None if target_coords was not empty.\n  if closest_target_pos is None:\n    return [] \n\n  target_x, target_y = closest_target_pos\n\n  actions = []\n\n  # 5. Retrieve integer mappings for movement and 'USE' actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # 6. Pathfinding: Move the agent to a cell adjacent to the target primitive.\n  # The 'USE' action in CraftState often checks a 3x3 neighborhood (as implied by CraftState.next_to).\n  # Therefore, the goal is to get the agent within this 3x3 region, not necessarily on the exact target cell.\n  # The loop continues as long as the agent is NOT in this 3x3 neighborhood.\n  # A position (cx, cy) is in the 3x3 neighborhood of (tx, ty) if abs(cx - tx) <= 1 AND abs(cy - ty) <= 1.\n  while not (abs(current_x - target_x) <= 1 and abs(current_y - target_y) <= 1):\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    # Prioritize movement along the X-axis if the agent is still more than one unit away horizontally.\n    # This creates an L-shaped path, moving first horizontally, then vertically.\n    if abs(dx) > 1:\n      if dx > 0: # Target is to the right\n        actions.append(RIGHT)\n        current_x += 1\n      else: # Target is to the left (dx < 0)\n        actions.append(LEFT)\n        current_x -= 1\n    # If the agent is within 1 unit of the target's X-coordinate (abs(dx) <= 1),\n    # then move along the Y-axis if necessary (i.e., if abs(dy) > 1).\n    elif abs(dy) > 1: \n      if dy > 0: # Target is below\n        actions.append(DOWN)\n        current_y += 1\n      else: # Target is above (dy < 0)\n        actions.append(UP)\n        current_y -= 1\n    # If both abs(dx) <= 1 and abs(dy) <= 1, the agent is already in the 3x3 neighborhood.\n    # The `while` loop condition will then evaluate to false, and the loop will terminate.\n    \n    # Safety break for very long paths or unexpected scenarios to prevent infinite loops.\n    if len(actions) > 2000: \n        break\n\n  # 7. Once the agent is adjacent to (or on the same cell as) the primitive,\n  # execute the 'USE' action to collect it.\n  actions.append(USE)\n\n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:03:08.444799", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive from the cookbook's index mapping.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Find all grid coordinates where the primitive exists.\n  # np.argwhere returns a list of (x, y) tuples representing coordinates.\n  # The grid is assumed to be shape (WIDTH, HEIGHT, n_kinds).\n  target_coords = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(target_coords) == 0:\n    # If the primitive is not present anywhere on the current grid, return no actions.\n    return []\n\n  # Determine the agent's current position for distance calculations.\n  current_x, current_y = agent_pos\n\n  # Find the closest primitive instance using Manhattan distance.\n  min_dist = float('inf')\n  closest_target_pos = None \n\n  for tx, ty in target_coords:\n    # Manhattan distance: |x1 - x2| + |y1 - y2|\n    dist = abs(tx - current_x) + abs(ty - current_y)\n    if dist < min_dist:\n      min_dist = dist\n      closest_target_pos = (tx, ty)\n\n  # This check is a safeguard; closest_target_pos should not be None if target_coords was not empty.\n  if closest_target_pos is None:\n    return [] \n\n  target_x, target_y = closest_target_pos\n\n  actions = []\n\n  # Retrieve integer mappings for movement and use actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Pathfinding: Move the agent to a cell adjacent to (or on) the target primitive.\n  # The 'USE' action is effective when the agent is within the 3x3 neighborhood of the target.\n  # This condition checks if the agent's current position (current_x, current_y) is such that\n  # both its X and Y coordinates are within 1 unit (inclusive) of the target's coordinates.\n  while not (abs(current_x - target_x) <= 1 and abs(current_y - target_y) <= 1):\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    # Prioritize movement along the axis that has the larger absolute distance to cover.\n    # If absolute distances are equal, horizontal movement (X-axis) is prioritized by convention.\n    if abs(dx) >= abs(dy):\n      if dx > 0: # Target is to the right of the agent\n        actions.append(RIGHT)\n        current_x += 1 # Simulate agent's new X position\n      elif dx < 0: # Target is to the left of the agent\n        actions.append(LEFT)\n        current_x -= 1 # Simulate agent's new X position\n      # If dx is 0, it implies current_x is aligned with target_x, AND since abs(dx) >= abs(dy)\n      # and the loop is still running, it must mean dy is also 0, which would terminate the loop.\n      # Or it implies that dx is 0 but dy is non-zero and abs(dx) == abs(dy) (i.e. both are 0).\n      # This block will only be executed if dx is non-zero.\n      # If dx is zero, the loop condition would usually be false unless dy is large enough for abs(dy) > 1,\n      # but then the `abs(dx) >= abs(dy)` condition would be false.\n      # Therefore, if we reach this else and dx is 0, it means dy must also be 0.\n      # This part of the code is technically unreachable given the while loop's condition.\n\n    else: # This branch executes if abs(dy) > abs(dx)\n      if dy > 0: # Target is below the agent\n        actions.append(DOWN)\n        current_y += 1 # Simulate agent's new Y position\n      elif dy < 0: # Target is above the agent\n        actions.append(UP)\n        current_y -= 1 # Simulate agent's new Y position\n      # Similar to the dx==0 case above, if dy is 0 here, it implies dx is also 0\n      # (as current_x and target_x would already be aligned if dx was non-zero and abs(dx) > abs(dy)),\n      # and the loop would have terminated. This part of the code is also unreachable.\n\n    # Safety break to prevent very long or infinite loops in complex or unforeseen scenarios.\n    # In an unobstructed grid, pathfinding should be finite and relatively short.\n    if len(actions) > 2000: \n        break\n\n  # Once the agent is positioned adjacently to (or on) the primitive,\n  # execute the 'USE' action to attempt collection.\n  actions.append(USE)\n\n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:04:18.744921", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Uses CraftState.next_to for cleaner checks.\"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Access the current grid state to locate primitives.\n  \n  # 1. Convert the primitive name (string) to its integer ID using the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early Exit: Check if the primitive is already present in the agent's inventory.\n  # If so, no further collection actions are needed from the environment.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The 'USE' action is crucial for grabbable items.\n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  # These define the change in coordinates and the corresponding action index for each direction.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  # Get grid dimensions for performing boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # The agent's current position serves as the starting point for the BFS.\n  start_pos = current_state.pos\n\n  # 4. Determine the collection mechanism based on the primitive's type.\n  # Grabbable items (e.g., WOOD, IRON, GRASS) are picked up by being adjacent and using ACTION_USE.\n  # Stationary items (e.g., WORKSHOPs, WATER, STONE, BOUNDARY) are collected by being on their cell.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_stationary_collectable = (\n      primitive_idx in env.world.workshop_indices or\n      primitive_idx == env.world.water_index or\n      primitive_idx == env.world.stone_index or\n      primitive_idx == cookbook.index['BOUNDARY'] # Boundary is considered a primitive that can be 'collected' by reaching it.\n  )\n  \n  # Get the index for the 'BOUNDARY' kind. This is used to check for impassable terrain.\n  boundary_kind_idx = cookbook.index['BOUNDARY']\n\n  # 5. BFS Initialization:\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of grid positions already explored to prevent cycles\n  # and ensure we always find the shortest path to a given cell.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found to any valid collection point.\n  # `min_total_actions_len` stores the length of the shortest *complete* path\n  # (movement actions + potential 'USE' action). Initialized to infinity.\n  min_total_actions_len = float('inf') \n  # `shortest_path_actions` stores the actual sequence of actions for this best path found so far.\n  shortest_path_actions = []     \n\n  # 6. BFS Traversal Loop: Continues until all reachable paths are explored or pruned.\n  while q:\n    current_pos, actions_to_current_pos = q.popleft()\n    cx, cy = current_pos # Unpack current position coordinates (X, Y).\n\n    # Pruning Condition 1 (after popping from queue):\n    # If the length of the path to the `current_pos`, plus the *minimal* additional cost\n    # (1 for 'USE' if grabbable, 0 otherwise) to collect the primitive from this position,\n    # is already equal to or longer than the best complete collection path found so far,\n    # then this path branch cannot lead to a shorter overall solution.\n    estimated_min_cost_from_current_pos = 1 if is_grabbable else 0 # Minimum 1 action if 'USE' is required, 0 otherwise.\n    if len(actions_to_current_pos) + estimated_min_cost_from_current_pos >= min_total_actions_len:\n        continue # Prune this path and its descendants.\n\n    # --- 7. Check if the primitive can be collected from `current_pos` ---\n    can_collect_from_here = False\n    actions_to_complete_collection = [] # Placeholder for additional actions like 'USE'.\n\n    # Create a temporary CraftState at the current BFS position to utilize helper methods like next_to.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry\n    # or the presence of the primitive on the grid.\n    temp_state_at_pos = craft.CraftState(current_state.scenario, grid, current_pos, current_state.dir, current_state.inventory)\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be in the 3x3 neighborhood of the item.\n      # The CraftState.next_to method efficiently checks this.\n      if temp_state_at_pos.next_to(primitive_idx):\n        can_collect_from_here = True\n        actions_to_complete_collection = [ACTION_USE] # 'USE' action is required for grabbables.\n    elif is_stationary_collectable:\n      # For stationary items (workshops, water, stone, boundary), the agent needs to be directly on the cell.\n      # Access grid via temp_state_at_pos for consistency or directly from `grid`\n      if temp_state_at_pos.grid[cx, cy, primitive_idx] > 0: \n        can_collect_from_here = True\n        actions_to_complete_collection = [] # No 'USE' action needed for these.\n    \n    # If a valid collection point is found from `current_pos`:\n    if can_collect_from_here:\n      # Calculate the total length of this complete path (movement + collection actions).\n      current_full_path_len = len(actions_to_current_pos) + len(actions_to_complete_collection)\n      \n      # If this path is strictly shorter than the best one found so far, update the best path.\n      if current_full_path_len < min_total_actions_len:\n        min_total_actions_len = current_full_path_len\n        shortest_path_actions = actions_to_current_pos + actions_to_complete_collection\n      # Important: Do NOT `break` the BFS here. This allows the search to continue\n      # and potentially find other instances of the primitive that might be reachable\n      # via an even shorter path, or via an equally short path from a different direction,\n      # ensuring the global shortest path to *any* collectable instance is found.\n\n    # --- 8. Explore valid neighbors (movement actions) from `current_pos` ---\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the `new_pos` is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for impassable terrain (e.g., BOUNDARY).\n        # The agent cannot move into a cell occupied by a BOUNDARY,\n        # UNLESS the primitive target itself IS 'BOUNDARY' (in which case, moving onto it *is* the goal).\n        if (boundary_kind_idx is not None and \n            grid[new_x, new_y, boundary_kind_idx] > 0 and \n            primitive_idx != boundary_kind_idx):\n            continue # This cell is blocked by a boundary, so skip this move.\n\n        # Check if this `new_pos` has not been visited yet through a shorter or equal path.\n        if new_pos not in visited:\n          # Pruning Condition 2 (before adding to queue):\n          # Estimate the total path length if we were to reach `new_pos` and\n          # then immediately collect (assuming `new_pos` is itself a collection point, or adjacent for grabbables).\n          estimated_total_path_via_new_pos = len(actions_to_current_pos) + 1 + (1 if is_grabbable else 0)\n          \n          # Only add `new_pos` to the queue if its *estimated* total path length\n          # is strictly shorter than the best complete path found so far (`min_total_actions_len`).\n          if estimated_total_path_via_new_pos < min_total_actions_len: \n              visited.add(new_pos) # Mark `new_pos` as visited to prevent revisiting.\n              q.append((new_pos, actions_to_current_pos + [move_action])) # Enqueue `new_pos` with its accumulated path.\n  \n  # 9. After BFS completes, `shortest_path_actions` will contain the shortest sequence of actions\n  # to collect the primitive, or remain an empty list if the primitive was unreachable.\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:04:19.897134", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`. Finds the shortest sequence of actions\n    (movements and USE) to collect a specified primitive from the environment.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation.\n        primitive (str): The name of the primitive item to be collected (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A list of integer action codes (e.g., UP, DOWN, USE)\n                   representing the shortest path to collect the primitive.\n                   Returns an empty list if the primitive is already in inventory\n                   or if it's unreachable.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Access the current grid state to locate primitive instances.\n  \n  # 1. Map the primitive name (string) to its unique integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early Exit: If the primitive is already present in the agent's inventory,\n  # no further collection actions are needed from the environment.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve action mappings from the environment's action_specs for clarity and use.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # The 'USE' action is crucial for grabbable items.\n\n  # Define possible movement actions. Each tuple contains (delta_x, delta_y, corresponding_action_id).\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  # Get grid dimensions for performing boundary checks during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # The agent's current position serves as the starting point for the BFS.\n  start_position = current_state.pos\n\n  # 4. Determine the collection mechanism based on the primitive's type.\n  # Grabbable items (e.g., WOOD, IRON, GRASS) are picked up by being adjacent and using ACTION_USE.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Stationary items (e.g., WORKSHOPs, WATER, STONE, BOUNDARY) are collected by being on their cell.\n  is_stationary_collectable = (\n      primitive_idx in env.world.workshop_indices or\n      primitive_idx == env.world.water_index or\n      primitive_idx == env.world.stone_index or\n      primitive_idx == cookbook.index['BOUNDARY'] # Boundary is also a primitive that can be 'collected' by reaching it.\n  )\n  \n  # Get the index for the 'BOUNDARY' kind, which represents impassable terrain for most movements.\n  boundary_kind_idx = cookbook.index['BOUNDARY']\n\n  # 5. BFS Initialization:\n  # The `search_queue` will store tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  search_queue = collections.deque([(start_position, [])]) \n  # The `visited_positions` set keeps track of grid positions already explored via a shortest path.\n  # This prevents infinite loops and redundant computation, ensuring the found path is shortest.\n  visited_positions = {start_position} \n\n  # Variables to store the overall shortest path found to any valid collection point.\n  # `min_total_actions_found` stores the length of the shortest *complete* path,\n  # including both movement and the potential 'USE' action. Initialized to infinity.\n  min_total_actions_found = float('inf') \n  # `shortest_path_actions` will store the actual sequence of actions for this best path found so far.\n  shortest_path_actions = []     \n\n  # 6. BFS Traversal Loop: Continues until the queue is empty or an optimal path is found.\n  while search_queue:\n    current_path_position, actions_to_current_path_pos = search_queue.popleft()\n    current_x, current_y = current_path_position # Unpack current position coordinates (X, Y).\n\n    # Pruning Condition 1 (Optimality Check - applied after dequeue):\n    # If the length of the path to `current_path_position`, plus the *minimal* additional cost\n    # to collect the primitive from this position (1 for 'USE' if grabbable, 0 otherwise),\n    # is already equal to or longer than the best complete collection path found so far,\n    # then this path branch cannot lead to a shorter overall solution. We can prune it.\n    estimated_cost_to_collect_from_here = 1 if is_grabbable else 0 \n    if len(actions_to_current_path_pos) + estimated_cost_to_collect_from_here >= min_total_actions_found:\n        continue # Skip this path and its descendants, as it cannot be optimal.\n\n    # --- 7. Check if the primitive can be collected from `current_path_position` ---\n    can_collect_at_this_spot = False\n    additional_actions_for_collection = [] # Placeholder for actions like [ACTION_USE] if needed.\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be in the 3x3 neighborhood (including current cell)\n      # of the primitive's location. We iterate through the 3x3 area around `current_path_position`.\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adjacent_x, adjacent_y = current_x + dx_adj, current_y + dy_adj\n          # Ensure the adjacent cell is within grid boundaries.\n          if 0 <= adjacent_x < GRID_WIDTH and 0 <= adjacent_y < GRID_HEIGHT:\n            # Check if the primitive is present in this adjacent cell.\n            if grid[adjacent_x, adjacent_y, primitive_idx] > 0:\n              can_collect_at_this_spot = True\n              additional_actions_for_collection = [ACTION_USE] # 'USE' action is required for grabbables.\n              break # Primitive found in neighborhood, no need to check other adjacent cells.\n        if can_collect_at_this_spot:\n            break # Break the outer loop as well once found.\n    elif is_stationary_collectable:\n      # For stationary items, the agent needs to be directly on the cell where the item is located.\n      if grid[current_x, current_y, primitive_idx] > 0:\n        can_collect_at_this_spot = True\n        additional_actions_for_collection = [] # No 'USE' action is needed for these types of primitives.\n    \n    # If a valid collection point is identified from `current_path_position`:\n    if can_collect_at_this_spot:\n      # Calculate the total length of this complete path (movement actions + collection actions).\n      current_full_path_length = len(actions_to_current_path_pos) + len(additional_actions_for_collection)\n      \n      # If this path is strictly shorter than the best one found so far, update the best path.\n      if current_full_path_length < min_total_actions_found:\n        min_total_actions_found = current_full_path_length\n        shortest_path_actions = actions_to_current_path_pos + additional_actions_for_collection\n      # IMPORTANT: Do NOT `break` the BFS here. Continuing the search allows\n      # finding other instances of the primitive that might be reachable via\n      # an even shorter path, or an equally short path from a different direction.\n      # BFS guarantees finding the shortest path to *any* goal state if allowed to complete.\n\n    # --- 8. Explore valid neighboring cells (movement actions) from `current_path_position` ---\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = current_x + dx, current_y + dy\n      new_position = (new_x, new_y)\n\n      # Check if the `new_position` is within the grid boundaries.\n      if 0 <= new_x < GRID_WIDTH and 0 <= new_y < GRID_HEIGHT:\n        # Check for impassable terrain (e.g., 'BOUNDARY').\n        # The agent cannot move into a cell occupied by a BOUNDARY,\n        # UNLESS the primitive target itself IS 'BOUNDARY' (in which case, moving onto it *is* the goal).\n        if (boundary_kind_idx is not None and \n            grid[new_x, new_y, boundary_kind_idx] > 0 and \n            primitive_idx != boundary_kind_idx):\n            continue # This cell is blocked by a boundary, so skip this move.\n\n        # Check if this `new_position` has not been visited yet through a shorter or equal path.\n        if new_position not in visited_positions:\n          # Pruning Condition 2 (Estimated Total Path - applied before enqueue):\n          # Estimate the total path length if we were to reach `new_position` and\n          # then immediately collect (assuming `new_position` is itself a collection point, or adjacent).\n          # This acts as an admissible heuristic for an A*-like pruning (effective for uniform cost search).\n          # Cost to reach `new_position` is `len(actions_to_current_path_pos) + 1` (for the move_action).\n          # Estimated minimal cost *from* `new_position` to collect is `1` (for USE if grabbable) or `0` (otherwise).\n          estimated_total_path_via_new_pos = len(actions_to_current_path_pos) + 1 + (1 if is_grabbable else 0)\n          \n          # Only add `new_position` to the queue if its *estimated* total path length\n          # is strictly shorter than the best complete path found so far (`min_total_actions_found`).\n          if estimated_total_path_via_new_pos < min_total_actions_found: \n              visited_positions.add(new_position) # Mark `new_position` as visited.\n              search_queue.append((new_position, actions_to_current_path_pos + [move_action])) # Enqueue `new_position` with its accumulated path.\n  \n  # 9. After BFS completes, `shortest_path_actions` will contain the shortest sequence of actions\n  # to collect the primitive, or remain an empty list if the primitive was unreachable.\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T11:05:40.464069", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement tuples: (dx, dy, action_id, new_direction_value)\n  # Assuming that taking a movement action sets the agent's direction to the value of that action ID.\n  # For example, if ACTION_UP is 1, moving UP will set agent.dir to 1.\n  MOVES = [\n      (0, -1, ACTION_UP, ACTION_UP),    # Move Up (Y-1), new dir is ACTION_UP\n      (0, 1, ACTION_DOWN, ACTION_DOWN),   # Move Down (Y+1), new dir is ACTION_DOWN\n      (-1, 0, ACTION_LEFT, ACTION_LEFT),  # Move Left (X-1), new dir is ACTION_LEFT\n      (1, 0, ACTION_RIGHT, ACTION_RIGHT), # Move Right (X+1), new dir is ACTION_RIGHT\n  ]\n\n  # Mapping from direction value (which are assumed to be ACTION_UP/DOWN/LEFT/RIGHT values)\n  # to (dx, dy) for calculating the cell \"in front\" of the agent.\n  DIR_VEC = {\n      ACTION_UP: (0, -1),   # When facing UP (dir = ACTION_UP), the cell in front is (0, -1) relative\n      ACTION_DOWN: (0, 1),  # When facing DOWN (dir = ACTION_DOWN), the cell in front is (0, 1) relative\n      ACTION_LEFT: (-1, 0), # When facing LEFT (dir = ACTION_LEFT), the cell in front is (-1, 0) relative\n      ACTION_RIGHT: (1, 0), # When facing RIGHT (dir = ACTION_RIGHT), the cell in front is (1, 0) relative\n  }\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position and direction\n  start_pos = state.pos\n  start_dir = state.dir # Initial direction from the state\n\n  # BFS setup\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, start_dir, [])]) \n  # Visited set: {(position, direction)} to avoid redundant exploration and cycles.\n  # Tracking direction in visited set is crucial because paths to the same position\n  # but with different final directions can lead to different outcomes for 'USE'.\n  visited = {(start_pos, start_dir)} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # These are entities the agent simply needs to reach their cell to \"collect\".\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be facing the item and then USE.\n      # Calculate the coordinates of the cell directly in front of the agent\n      dir_dx, dir_dy = DIR_VEC.get(current_dir, (0,0)) # Use .get for robustness if current_dir is not a standard action value\n      target_x, target_y = current_pos[0] + dir_dx, current_pos[1] + dir_dy\n\n      # Check if the target cell is valid and contains the primitive\n      if 0 <= target_x < WIDTH and 0 <= target_y < HEIGHT and \\\n         grid[target_x, target_y, primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n        \n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means being on the cell.\n      # Direction does not matter for being *on* the cell itself.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is needed\n    \n    # If a goal state is reached, update the best path found so far\n    # We compare the total length of the path (moves + completion actions)\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Continue BFS. While BFS finds shortest path to a *node*, our \"goal\" is a condition\n      # that might be met by different (pos, dir) states or require additional actions.\n      # Exhausting BFS ensures we find the shortest *total* action sequence.\n\n    # Explore neighbors by performing movement actions\n    for dx, dy, move_action, new_dir in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Only add to queue if this (position, direction) state has not been visited\n        if (new_pos, new_dir) not in visited: \n          visited.add((new_pos, new_dir))\n          q.append((new_pos, new_dir, current_actions + [move_action]))\n  \n  return best_path_actions", "island_id": 3, "scores": {"3": 0.0}}
