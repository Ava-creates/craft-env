{"timestamp": "2025-08-02T04:17:52.071253", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Find all occurrences of the primitive on the grid\n  # These are the target locations *of the primitive itself*\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Map (dx, dy) to action index for BFS\n  delta_to_action = {\n      (-1, 0): UP,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # Grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify obstacle indices from the world configuration\n  # Assuming non_grabbable_indices are obstacles for movement.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  def is_walkable(x, y):\n    \"\"\"Checks if a cell (x, y) is within bounds and doesn't contain any obstacles.\"\"\"\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    # Check if the cell contains any obstacle at any layer\n    for obs_idx in obstacle_indices:\n      if grid[x, y, obs_idx] == 1:\n        return False\n    return True\n\n  # BFS implementation\n  queue = collections.deque([(agent_pos, [])]) # (current_pos, path_actions_to_reach_here)\n  visited = {agent_pos} # Set of (x, y) tuples\n\n  while queue:\n    current_pos, path = queue.popleft()\n    cx, cy = current_pos\n\n    # Check if current position is a valid \"use\" location for the primitive.\n    # A \"use\" location is a cell (cx, cy) such that if the agent is at (cx, cy),\n    # then `state.next_to(primitive_idx)` would be true.\n    # `state.next_to` checks the 3x3 neighborhood (Chebyshev distance <= 1).\n    found_target_adjacency = False\n    for target_px, target_py in primitive_locations:\n      # If the current agent position (cx, cy) is within 1 Chebyshev distance\n      # of any primitive location (target_px, target_py)\n      if max(abs(cx - target_px), abs(cy - target_py)) <= 1:\n        found_target_adjacency = True\n        break\n    \n    if found_target_adjacency:\n      return path + [USE] # Path to reach 'use' position, then USE\n\n    # Explore neighbors (cardinal directions only)\n    for dx, dy in delta_to_action.keys():\n      nx, ny = cx + dx, cy + dy\n      next_pos = (nx, ny)\n\n      if is_walkable(nx, ny) and next_pos not in visited:\n        visited.add(next_pos)\n        queue.append((next_pos, path + [delta_to_action[(dx, dy)]]))\n\n  # If no path found (e.g., primitive is unreachable due to obstacles)\n  return []", "island_id": 2, "scores": {"3": 0.0}}
