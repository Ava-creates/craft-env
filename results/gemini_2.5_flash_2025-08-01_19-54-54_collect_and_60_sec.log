{"timestamp": "2025-08-02T01:31:34.531684", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  inventory = state.inventory \n\n  # 1. Resolve the primitive name to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  # This applies primarily to grabbable primitives (e.g., WOOD, IRON).\n  if inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Used for interacting with grabbable items or workshops\n\n  # 4. Define possible movement actions relative to the agent's position\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # 5. Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Initialize BFS (Breadth-First Search)\n  # q: Stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n  # visited: Keeps track of grid positions already explored to prevent cycles and redundant paths\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 7. Categorize the target primitive based on how it's \"collected\".\n  # We use the general `grabbable_indices` and `non_grabbable_indices` sets from CraftWorld.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_non_grabbable = primitive_idx in env.world.non_grabbable_indices # This covers workshops, water, stone, boundary, etc.\n  \n  # 8. BFS search loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows using CraftState's methods (like `next_to`) from this specific grid cell\n    # without actually changing the environment's state.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current_pos represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # BFS guarantees finding the shortest path to an adjacent cell.\n        # Append the 'USE' action to complete the collection.\n        return current_actions + [ACTION_USE]\n    elif is_non_grabbable:\n      # For non-grabbable items (e.g., workshops, water, stone, boundary),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # Check if the target primitive is present at the current cell's location in the grid.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # This is the shortest path to a cell containing the primitive.\n        return current_actions # No additional 'USE' action needed.\n    # If the primitive is neither grabbable nor non-grabbable, it's an unhandled type.\n    # In a well-configured CraftWorld, all primitive indices should fall into one of these categories.\n    \n    # Explore valid neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Ensure we don't re-visit already explored positions to guarantee shortest path and prevent infinite loops\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and no path to the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:31:35.810407", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  inventory = state.inventory \n\n  # 1. Resolve the primitive name to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory, no actions are needed.\n  # This applies primarily to grabbable primitives like WOOD, IRON, etc.\n  # Workshops and stationary primitives are not held in inventory, so this check doesn't apply to them.\n  if primitive_idx in env.world.grabbable_indices and inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Used for interacting with grabbable items or workshops\n\n  # 4. Define possible movement actions relative to the agent's position\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # 5. Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Initialize BFS (Breadth-First Search) for pathfinding\n  # q: Stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n  # visited: Keeps track of grid positions already explored to prevent cycles and redundant paths\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 7. Categorize the target primitive based on how it's \"collected\"\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special stationary primitives (like water, stone, boundary) are \"collected\" by simply reaching their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # 8. BFS search loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's methods (like `next_to`) from this specific grid cell,\n    # without actually changing the environment's state. Agent's direction and inventory are\n    # passed as-is, as they don't affect the spatial pathfinding for the primitive itself.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current_pos represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # BFS guarantees finding the shortest path to an adjacent cell.\n        # Append the 'USE' action to complete the collection.\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops (e.g., BENCH, FURNACE) or natural features (e.g., WATER, STONE, BOUNDARY),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # Check if the target primitive is present at the current cell's location in the grid.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # This is the shortest path to a cell containing the primitive.\n        return current_actions # No additional 'USE' action needed; reaching is enough.\n\n    # Explore valid neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Ensure we don't re-visit already explored positions to guarantee shortest path and prevent infinite loops\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and no path to the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:32:24.463298", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with clearer goal-checking logic.\"\"\"\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  inventory = state.inventory \n\n  # 1. Resolve the primitive name to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Determine the \"collection mechanism\" for the primitive.\n  # This dictates how the agent interacts with it to \"collect\" it.\n  COLLECTION_MECHANISM_ADJACENT_USE = \"adjacent_use\" # For grabbable items (e.g., WOOD), agent needs to be next to it and USE.\n  COLLECTION_MECHANISM_ON_CELL = \"on_cell\"         # For stationary items (e.g., WORKSHOP, WATER), agent needs to be on the same cell.\n\n  collection_mechanism = None\n\n  if primitive_idx in env.world.grabbable_indices:\n    collection_mechanism = COLLECTION_MECHANISM_ADJACENT_USE\n    # Early exit: If a grabbable primitive is already in inventory, no actions are needed.\n    if inventory[primitive_idx] > 0:\n      return []\n  elif primitive_idx in env.world.workshop_indices:\n    collection_mechanism = COLLECTION_MECHANISM_ON_CELL\n  elif primitive_idx == env.world.water_index or \\\n       primitive_idx == env.world.stone_index or \\\n       primitive_idx == cookbook.index['BOUNDARY']: # Boundary is considered a stationary primitive\n    collection_mechanism = COLLECTION_MECHANISM_ON_CELL\n  \n  # If the primitive is not recognized as a directly collectable type by these mechanisms, return empty.\n  # (e.g., a crafted item like 'PLANK' cannot be \"collected\" this way)\n  if collection_mechanism is None:\n    return []\n\n  # 3. Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] \n\n  # 4. Define possible movement actions relative to the agent's position\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # 5. Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Initialize BFS (Breadth-First Search) for pathfinding\n  # q: Stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n  # visited: Keeps track of grid positions already explored to prevent cycles and redundant paths\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 7. BFS search loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's methods (like `next_to`) from this specific grid cell,\n    # without actually changing the environment's state. Agent's direction and inventory are\n    # passed as-is, as they don't affect the spatial pathfinding for the primitive itself.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current_pos satisfies the collection goal based on its mechanism\n    found_target = False\n    additional_actions = []\n\n    if collection_mechanism == COLLECTION_MECHANISM_ADJACENT_USE:\n      # For grabbable items, the agent needs to be adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        found_target = True\n        additional_actions = [ACTION_USE]\n    elif collection_mechanism == COLLECTION_MECHANISM_ON_CELL:\n      # For stationary items (workshops, water, stone, boundary),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # Check if the target primitive is present at the current cell's location in the grid.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        found_target = True\n        additional_actions = [] # No USE action needed; reaching is enough.\n\n    if found_target:\n      # BFS guarantees finding the shortest path. Return the actions to reach the target\n      # plus any additional actions required (like ACTION_USE).\n      return current_actions + additional_actions\n\n    # Explore valid neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Ensure we don't re-visit already explored positions to guarantee shortest path and prevent infinite loops\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 8. If the BFS completes and no path to the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:32:25.611000", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  inventory = state.inventory \n\n  # 1. Resolve the primitive name to its integer ID using the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is a grabbable item and already in the agent's inventory,\n  # no actions are needed. Workshops and stationary primitives are not held in inventory,\n  # so this check only applies to items that can be picked up.\n  if primitive_idx in env.world.grabbable_indices and inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings from the environment's action specifications for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Used for interacting with grabbable items or workshops/natural features.\n\n  # 4. Define possible movement actions and their corresponding action indices.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # 5. Get grid dimensions for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Initialize BFS (Breadth-First Search) for pathfinding.\n  # The queue `q` stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  # The `visited` set keeps track of grid positions already explored to prevent cycles and redundant paths,\n  # ensuring the shortest path is found.\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 7. Determine the collection method based on whether the primitive is grabbable or non-grabbable.\n  # All primitives in the DSL should fall into one of these two categories based on `CraftWorld` properties.\n  is_grabbable_target = primitive_idx in env.world.grabbable_indices\n  is_non_grabbable_target = primitive_idx in env.world.non_grabbable_indices\n  \n  # 8. BFS search loop to find the shortest sequence of actions.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical `CraftState` at the current BFS position.\n    # This allows us to use `CraftState`'s methods (like `next_to`) from this specific grid cell\n    # without actually modifying the real environment state. Agent's direction and inventory\n    # are passed as-is, as they are not relevant for the spatial pathfinding itself.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position represents a goal state for collecting the primitive.\n    if is_grabbable_target:\n      # For grabbable items (e.g., WOOD, IRON, GRASS), the agent needs to move adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # BFS guarantees finding the shortest path to an adjacent cell.\n        # Append the 'USE' action to complete the collection.\n        return current_actions + [ACTION_USE]\n    elif is_non_grabbable_target:\n      # For non-grabbable items (e.g., workshops like BENCH/WORKSHOP0, or natural features like WATER, STONE, BOUNDARY),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # Check if the target primitive is present at the current cell's location in the grid.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # This is the shortest path to a cell containing the primitive.\n        # No additional 'USE' action is needed for \"collection\" in this context; reaching is enough.\n        return current_actions \n    \n    # Explore valid neighboring cells from the current position.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, add it to the queue.\n        # This prevents revisiting nodes and ensures the shortest path.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and no path to the primitive was found (meaning it's unreachable or doesn't exist),\n  # return an empty list of actions.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:33:30.321268", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in the cookbook, cannot collect it.\n    return []\n\n  # Get action mappings (integer IDs) from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) setup for pathfinding.\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {start_pos} \n\n  # Determine the type of primitive to apply appropriate collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, or boundary are \"collected\" by simply reaching their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Identify impassable entity indices to avoid pathfinding through them.\n  # Assuming BOUNDARY and WATER are generally impassable for direct movement.\n  impassable_indices = set()\n  boundary_idx = cookbook.index['BOUNDARY']\n  if boundary_idx is not None:\n      impassable_indices.add(boundary_idx)\n  water_idx = env.world.water_index\n  if water_idx is not None:\n      impassable_indices.add(water_idx)\n  \n  # BFS loop continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at `current_pos`.\n    # This allows us to use `CraftState` methods like `next_to` or directly query the `grid`\n    # as if the agent were physically at this `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal for collecting the primitive.\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Actions required once at the target position/adjacency (e.g., USE)\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then use ACTION_USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundaries, \"collecting\" means simply being on their cell.\n      # Check if the primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No additional action like USE is typically needed.\n    \n    # If a goal state is reached, return the combined path immediately.\n    # BFS guarantees that the first path found to any goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position.\n    for dx, dy, action_id in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position contains an impassable entity.\n        is_impassable = False\n        for impassable_k_idx in impassable_indices:\n            # If the cell contains a significant amount of an impassable kind, it's blocked.\n            if grid[new_x, new_y, impassable_k_idx] > 0:\n                is_impassable = True\n                break\n        \n        # If the new position is traversable and has not been visited yet, add it to the queue.\n        if not is_impassable and new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action_id]))\n  \n  # If the queue becomes empty and no goal was reached, the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T01:33:31.441697", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in the cookbook, cannot collect it.\n    return []\n\n  # Get action mappings (integer IDs) from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) setup for pathfinding.\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {start_pos} \n\n  # Initialize variables to store the shortest path found.\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine the type of primitive to apply appropriate collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, or boundary are \"collected\" by simply reaching their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Get the index for 'BOUNDARY' once for efficiency, assuming it's impassable.\n  boundary_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS loop continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at `current_pos`.\n    # This allows us to use `CraftState` methods like `next_to` or directly query the `grid`\n    # as if the agent were physically at this `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal for collecting the primitive.\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Actions required once at the target position/adjacency (e.g., USE)\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then use ACTION_USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundaries, \"collecting\" means simply being on their cell.\n      # Check if the primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No additional action like USE is typically needed.\n    \n    # If a goal state is reached, update the `best_path_actions` if the current path is shorter.\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # It's important to continue BFS even after finding a goal state,\n      # as a shorter path that requires a final interaction (e.g., ACTION_USE)\n      # might be found later in the BFS, or multiple instances of the primitive\n      # exist that lead to different total path lengths.\n\n    # Explore neighbors of the current position.\n    for dx, dy, action_id in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n        continue # Out of bounds\n\n      # --- IMPROVEMENT FOR v2: Avoid impassable cells (e.g., BOUNDARY) ---\n      # Check if the new position contains a 'BOUNDARY' item, which is assumed to be impassable.\n      # If the cell is blocked by a boundary, we skip it.\n      if boundary_kind_idx is not None and grid[new_x, new_y, boundary_kind_idx] > 0:\n          continue # This cell is impassable, do not add to queue\n      # --- END IMPROVEMENT ---\n\n      # If the new position has not been visited yet, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, current_actions + [action_id]))\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  return best_path_actions", "island_id": 6, "scores": {"3": 0.5}}
