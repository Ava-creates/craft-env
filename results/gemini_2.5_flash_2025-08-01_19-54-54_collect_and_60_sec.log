{"timestamp": "2025-08-02T08:32:19.928542", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state (WIDTH, HEIGHT, n_kinds)\n  \n  # 1. Get the integer ID for the primitive. Use .get for robustness,\n  # returning None if the primitive name is not found.\n  primitive_idx = cookbook.index.get(primitive) \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the agent already has a grabbable primitive, no actions are needed.\n  is_grabbable_target = primitive_idx in env.world.grabbable_indices\n  if is_grabbable_target and state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 3. Get action mappings from the environment for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 4. Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decrease Y)\n      (0, 1, ACTION_DOWN),   # Move South (increase Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decrease X)\n      (1, 0, ACTION_RIGHT),  # Move East (increase X)\n  ]\n\n  # 5. Grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Agent's current starting position for BFS.\n  start_pos = state.pos\n\n  # 7. Identify the index for 'BOUNDARY' for obstacle detection.\n  # Use .get to handle cases where 'BOUNDARY' might not be defined in the cookbook.\n  boundary_idx = cookbook.index.get('BOUNDARY') \n\n  # 8. Helper function to check if a target item is present in the 3x3 neighborhood\n  # of a given position, including the current cell itself. This mirrors `CraftState.next_to`.\n  def _is_present_in_neighborhood(check_pos, target_kind_idx, current_grid, grid_width, grid_height):\n      cx, cy = check_pos\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n              # Check if neighbor is within grid boundaries\n              if 0 <= nx_adj < grid_width and 0 <= ny_adj < grid_height:\n                  # Check if the target kind is present in this neighboring cell (count > 0)\n                  if current_grid[nx_adj, ny_adj, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # 9. BFS setup:\n  #    q: stores (current_position (x,y), list_of_movement_actions_to_reach_here)\n  #    visited: stores positions already explored to avoid cycles and redundant paths.\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 10. Main BFS loop.\n  while q:\n    current_pos, current_moves_path = q.popleft()\n    \n    is_goal_condition_met = False\n    actions_to_complete_goal_from_here = []\n\n    # Check if the goal condition is met at the `current_pos`.\n    if is_grabbable_target:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them (or on them),\n      # and then perform an ACTION_USE.\n      if _is_present_in_neighborhood(current_pos, primitive_idx, grid, WIDTH, HEIGHT):\n        is_goal_condition_met = True\n        actions_to_complete_goal_from_here = [ACTION_USE]\n    else: \n      # For non-grabbable items (e.g., WORKSHOP0, WATER, STONE, or even BOUNDARY if that's the target),\n      # \"collecting\" means simply reaching the cell that contains the item.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_condition_met = True\n        actions_to_complete_goal_from_here = [] # No extra action needed for collection\n\n    # If the goal condition is met, return the path immediately.\n    # For unweighted graphs (like grid movement), BFS guarantees that the first path found to a\n    # goal state is one of the shortest paths.\n    if is_goal_condition_met:\n      return current_moves_path + actions_to_complete_goal_from_here\n\n    # 11. Explore Neighbors:\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n        continue\n\n      # Check for impassable obstacles. A cell containing 'BOUNDARY' is an obstacle\n      # unless the primitive we are collecting *is* the 'BOUNDARY' itself.\n      is_impassable_obstacle = False\n      if boundary_idx is not None:\n          # If the new position contains a 'BOUNDARY' AND the target is NOT 'BOUNDARY', it's an obstacle.\n          if grid[new_x, new_y, boundary_idx] > 0 and primitive_idx != boundary_idx:\n              is_impassable_obstacle = True\n      \n      if is_impassable_obstacle:\n        continue\n\n      # If the new position is valid and has not been visited, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, current_moves_path + [action]))\n  \n  # 12. If the BFS completes and no path to the primitive was found (e.g., it's unreachable).\n  return []", "island_id": 5, "scores": {"3": -1}}
