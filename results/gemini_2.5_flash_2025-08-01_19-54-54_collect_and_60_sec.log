{"timestamp": "2025-08-01T21:44:34.164398", "function_name": "collect", "function_body": "  state = env._current_state\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  # Based on Index.__getitem__ doc, it returns int or None.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  if primitive_id is None:\n      # The primitive name is not recognized by the environment.\n      return []\n\n  # Get current agent position and grid dimensions\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping from action names to integer IDs\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Mapping of (dr, dc) movement deltas to corresponding action IDs\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # Standard 4-directional movement deltas for BFS\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Get the index for water, which acts as an untraversable obstacle\n  i_water = env.world.water_index\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_non_grabbable = primitive_id in env.world.non_grabbable_indices\n\n  # If the primitive is neither grabbable nor non-grabbable, it's not something\n  # that can be 'collected' by this function (e.g., an output of a recipe, or an invalid ID)\n  if not is_grabbable and not is_non_grabbable:\n      return []\n\n  # 1. Early exit: If it's a grabbable item and already in inventory, no need to collect.\n  if is_grabbable and state.inventory[primitive_id] > 0:\n      return []\n\n  # 2. Identify all possible target cells on the grid that would allow collection.\n  # Also determine if a 'USE' action is required after reaching the target.\n  target_cells_for_bfs = set()\n  add_use_action_at_end = False\n\n  if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to move to\n      # any cell in the 3x3 neighborhood of the primitive, then use the 'USE' action.\n      add_use_action_at_end = True\n      for r_obj in range(HEIGHT):\n          for c_obj in range(WIDTH):\n              if grid[r_obj, c_obj, primitive_id] > 0: # Found an instance of the primitive\n                  # Add all traversable cells in its 3x3 neighborhood as potential BFS targets\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r_obj + dr_adj, c_obj + dc_adj\n                          # Check bounds and if cell is traversable (no water)\n                          if (0 <= nr < HEIGHT and 0 <= nc < WIDTH and \n                              grid[nr, nc, i_water] == 0): # Ensure no water in target cell\n                              target_cells_for_bfs.add((nr, nc))\n  elif is_non_grabbable:\n      # For non-grabbable items (e.g., WORKSHOP, STONE), the agent needs to move to\n      # stand directly on the cell containing the primitive. No 'USE' action needed.\n      add_use_action_at_end = False\n      for r_obj in range(HEIGHT):\n          for c_obj in range(WIDTH):\n              if grid[r_obj, c_obj, primitive_id] > 0: # Found an instance of the primitive\n                  # The agent must be able to stand on this cell (r_obj, c_obj)\n                  if grid[r_obj, c_obj, i_water] == 0: # Ensure no water in target cell\n                      target_cells_for_bfs.add((r_obj, c_obj))\n  \n  # If no valid target cells are found on the grid, return an empty list.\n  if not target_cells_for_bfs:\n      return []\n\n  # 3. Breadth-First Search (BFS) to find the shortest path to any target cell.\n  queue = collections.deque([(current_row, current_col, [])]) # (r, c, path_to_here)\n  visited = {(current_row, current_col)} # Set to keep track of visited (r, c) coordinates\n  \n  shortest_path_actions = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # If the current cell is one of our target cells, we've found the shortest path.\n      if (r, c) in target_cells_for_bfs:\n          shortest_path_actions = path\n          break \n\n      # Explore 4-connected neighbors\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc # Next row, next column\n\n          # Check if the next cell is within grid boundaries\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if the next cell is traversable (does not contain water)\n          if grid[nr, nc, i_water] > 0:\n              continue\n\n          # If the cell has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a new list for the path to avoid modifying shared references\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  # If no path was found to any target cell\n  if shortest_path_actions is None:\n      return []\n\n  # 4. Append the 'USE' action if required\n  final_actions = list(shortest_path_actions)\n  if add_use_action_at_end:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:44:35.354564", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index.get(primitive) # Use .get() to safely handle missing keys\n\n  if primitive_id is None: # Primitive name not recognized\n      return []\n\n  # *** Key improvement for collect_v2: Only 'collect' truly grabbable items. ***\n  # The DSL's 'collect' implies adding to inventory. Non-grabbable items cannot be inventoried.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] # This 'collect' function is not applicable to non-grabbable items.\n\n  # From this point onwards, we are only dealing with grabbable items.\n\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Directions relative to current position, mapped to actions\n  # (dr, dc) -> action\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # For BFS neighbors (4-connected movement)\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Get water index for traversability check. Water is generally an untraversable obstacle.\n  i_water = env.world.water_index\n\n  # 1. Check if the primitive is already in inventory\n  if state.inventory[primitive_id] > 0:\n      return [] # Already have the item, no collection needed.\n\n  # 2. Determine target cells for BFS: For grabbable items, we need to move to a cell\n  #    in its 3x3 neighborhood, then apply the USE action.\n  target_cells_for_bfs = set()\n  \n  for r_obj in range(HEIGHT):\n      for c_obj in range(WIDTH):\n          # Check if this cell (r_obj, c_obj) contains the primitive we want to collect.\n          if grid[r_obj, c_obj, primitive_id] > 0:\n              # The agent can pick it up from any cell in its 3x3 neighborhood.\n              # Only add traversable cells to the target_cells_for_bfs set.\n              for dr_adj in [-1, 0, 1]:\n                  for dc_adj in [-1, 0, 1]:\n                      nr, nc = r_obj + dr_adj, c_obj + dc_adj\n                      # Check if neighbor is within bounds and traversable (not water)\n                      if (0 <= nr < HEIGHT and 0 <= nc < WIDTH and \n                          grid[nr, nc, i_water] == 0): # Cell must not contain water\n                          target_cells_for_bfs.add((nr, nc))\n\n  if not target_cells_for_bfs:\n      # No valid target cells found (e.g., primitive not present on the grid,\n      # or all potential target cells are blocked by water).\n      return []\n\n  # 3. Find shortest path to any target cell using Breadth-First Search (BFS)\n  queue = collections.deque([(current_row, current_col, [])]) # (row, col, list_of_actions_to_reach_here)\n  visited = {(current_row, current_col)} # Keep track of visited (row, col) tuples\n  \n  shortest_path = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      if (r, c) in target_cells_for_bfs:\n          shortest_path = path\n          break # Found the shortest path to a valid target cell\n\n      # Explore valid neighbors (Up, Down, Left, Right)\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc # Next row, next column\n\n          # Check if the next cell is within grid bounds\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if the next cell is an obstacle (e.g., contains water)\n          if grid[nr, nc, i_water] > 0:\n              continue\n\n          # If the cell has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy to avoid modifying shared list\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  if shortest_path is None:\n      return [] # No path found to any target cell\n\n  final_actions = list(shortest_path)\n  # For grabbable items, a USE action is always appended after reaching the target.\n  final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T21:45:37.027773", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Adds a check to see if the primitive is already in the inventory before attempting collection.\n  This optimization prevents redundant collection attempts if the agent already possesses the item.\n  \"\"\"\n  actions = []\n  current_state = env._current_state \n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not recognized by the cookbook.\n    return []\n\n  # --- Improvement for collect_v2 ---\n  # If the agent already has at least one of the primitive, there's no need to collect more.\n  # This assumes the goal of 'collect' is simply to acquire at least one instance.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n  # --- End of improvement ---\n\n  # Determine if the target primitive is grabbable (can be stepped upon and picked up)\n  is_target_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Get action mappings from the environment for clearer code\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get grid dimensions (grid shape is typically (WIDTH, HEIGHT, n_kinds))\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # BFS setup\n  start_pos = current_state.pos # Agent's current position (x, y)\n  \n  # Queue for BFS: (current_position (x,y), list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles in the search\n  visited = {start_pos}\n\n  # Define possible moves and their corresponding actions\n  # (dx, dy) represents change in (x, y) coordinates for a move\n  # x: horizontal axis (columns), y: vertical axis (rows)\n  moves = {\n      (0, -1): ACTION_UP,    # Move UP: y decreases\n      (0, 1): ACTION_DOWN,   # Move DOWN: y increases\n      (-1, 0): ACTION_LEFT,  # Move LEFT: x decreases\n      (1, 0): ACTION_RIGHT,  # Move RIGHT: x increases\n  }\n\n  # Identify all cells on the grid that currently contain the primitive\n  # np.where returns (row_indices, col_indices), so (y, x)\n  ys_primitive, xs_primitive = np.where(current_state.grid[:, :, primitive_idx] > 0)\n  \n  # Convert these coordinates to (x, y) tuples, consistent with agent's pos\n  primitive_grid_locations = [(x, y) for x, y in zip(xs_primitive, ys_primitive)]\n\n  if not primitive_grid_locations:\n      # If the primitive is not found anywhere on the grid, it cannot be collected.\n      return [] \n\n  # Determine all potential agent positions from which the primitive can be 'USE'd.\n  # The 'USE' action typically works for entities in the 3x3 neighborhood around the agent.\n  target_agent_positions = set()\n  for px, py in primitive_grid_locations:\n      # Iterate over the 3x3 neighborhood (dx_offset, dy_offset are -1, 0, or 1)\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              agent_target_x, agent_target_y = px + dx_offset, py + dy_offset\n              # Ensure the potential agent position is within grid boundaries\n              if 0 <= agent_target_x < grid_width and 0 <= agent_target_y < grid_height:\n                  target_agent_positions.add((agent_target_x, agent_target_y))\n\n  # Perform BFS to find the shortest path to any of the `target_agent_positions`\n  path_to_primitive_area = []\n  found_path = False\n\n  while queue and not found_path:\n      (curr_x, curr_y), path_actions = queue.popleft()\n\n      # If the current position is one of the target agent positions, we've found a path.\n      if (curr_x, curr_y) in target_agent_positions:\n          path_to_primitive_area = path_actions\n          found_path = True\n          break\n\n      # Explore all possible neighboring cells\n      for (dx, dy), action in moves.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Skip if this cell has already been visited in the shortest path search\n          if (next_x, next_y) in visited:\n              continue\n          \n          # Traversability Check: Determine if the agent can move to (next_x, next_y).\n          # A cell is generally an obstacle if it contains any non-grabbable item.\n          # However, if the target primitive itself is non-grabbable (e.g., a WORKSHOP\n          # that you interact with but don't pick up), the agent cannot move onto its cell.\n          # If the target primitive IS grabbable (e.g., WOOD), the agent *can* move onto its cell.\n          is_traversable = True\n          for kind_id in env.world.non_grabbable_indices:\n              if current_state.grid[next_x, next_y, kind_id] > 0:\n                  # If the cell contains a non-grabbable item\n                  if kind_id == primitive_idx:\n                      # If this non-grabbable item is the primitive we are trying to collect,\n                      # and it's explicitly NOT grabbable, then the cell is an obstacle.\n                      if not is_target_primitive_grabbable:\n                          is_traversable = False\n                          break\n                  else:\n                      # It's a different non-grabbable item (e.g., WATER, BOUNDARY).\n                      # This always acts as an obstacle.\n                      is_traversable = False\n                      break\n          \n          if not is_traversable:\n              continue # Cannot move into an obstacle cell\n\n          # If the cell is traversable and not yet visited, add it to the queue\n          visited.add((next_x, next_y))\n          queue.append(((next_x, next_y), path_actions + [action]))\n\n  if not found_path:\n      # If no path could be found to any cell from which the primitive can be collected,\n      # return an empty list of actions.\n      return []\n\n  # If a path was found, extend the actions list with the movement actions.\n  actions.extend(path_to_primitive_area)\n\n  # After moving to a position adjacent to the primitive, perform the 'USE' action\n  # to collect or interact with it.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:45:38.226141", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state \n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive from the cookbook.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  # 2. Determine if the target primitive is grabbable. This is crucial for traversability\n  # and how the agent interacts with the item (e.g., can step onto it or must be adjacent).\n  is_target_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 3. Get action integer mappings from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible 4-directional moves and their corresponding action IDs.\n  # The keys are (dx, dy) representing change in (x, y) coordinates.\n  # (x is horizontal/column, y is vertical/row).\n  moves = {\n      (0, -1): ACTION_UP,    # Moving UP decreases the y-coordinate.\n      (0, 1): ACTION_DOWN,   # Moving DOWN increases the y-coordinate.\n      (-1, 0): ACTION_LEFT,  # Moving LEFT decreases the x-coordinate.\n      (1, 0): ACTION_RIGHT,  # Moving RIGHT increases the x-coordinate.\n  }\n\n  # 4. Get current grid dimensions (WIDTH, HEIGHT).\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # 5. Identify all grid locations where the primitive exists.\n  # np.where returns row_indices (y) and then column_indices (x).\n  ys_primitive, xs_primitive = np.where(current_state.grid[:, :, primitive_idx] > 0)\n  \n  # Convert these to (x, y) tuples for consistency with agent's position format.\n  primitive_grid_locations = [(x, y) for x, y in zip(xs_primitive, ys_primitive)]\n\n  if not primitive_grid_locations:\n      # If the primitive is not found anywhere on the current grid, there's nothing to collect.\n      return []\n\n  # 6. Determine all possible agent positions from which the primitive can be 'USE'd.\n  # According to CraftState.next_to, 'USE' works when the agent is in any cell\n  # within the 3x3 neighborhood centered around the target item.\n  target_agent_positions = set()\n  for px, py in primitive_grid_locations:\n      # Iterate over all 9 cells in the 3x3 neighborhood around the primitive's location (px, py).\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              agent_target_x, agent_target_y = px + dx_offset, py + dy_offset\n              \n              # Ensure the candidate agent position is within the grid boundaries.\n              if 0 <= agent_target_x < grid_width and 0 <= agent_target_y < grid_height:\n                  # Add this valid grid cell as a potential target for the agent to move to.\n                  # Whether the agent can *actually* move to this cell (traversability) will be\n                  # checked during the Breadth-First Search (BFS).\n                  target_agent_positions.add((agent_target_x, agent_target_y))\n\n  # 7. Perform a Breadth-First Search (BFS) to find the shortest path.\n  # The goal is to reach *any* of the `target_agent_positions`.\n  start_pos = current_state.pos # Agent's current (x, y) position.\n  \n  # The queue for BFS stores tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos}\n\n  path_to_primitive_area = []\n  found_path = False\n\n  # Continue BFS as long as there are positions to explore and a path hasn't been found.\n  while queue and not found_path:\n      (curr_x, curr_y), path_actions = queue.popleft()\n\n      # If the current position is one of our target agent positions, we've found the shortest path.\n      if (curr_x, curr_y) in target_agent_positions:\n          path_to_primitive_area = path_actions\n          found_path = True\n          break # Exit BFS, as we found the shortest path to *a* target.\n\n      # Explore 4-directional neighbors from the current position.\n      for (dx, dy), action in moves.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if this cell has already been visited.\n          if (next_x, next_y) in visited:\n              continue\n          \n          # Traversability Check: Determine if the agent can move into (next_x, next_y).\n          # A cell is generally an obstacle if it contains any non-grabbable entity.\n          # However, there's a special case if the non-grabbable entity *is* the target primitive.\n          is_traversable = True\n          # Iterate through all kinds known to be non-grabbable in the environment.\n          for kind_id in env.world.non_grabbable_indices:\n              # If the next cell contains this non-grabbable item...\n              if current_state.grid[next_x, next_y, kind_id] > 0:\n                  # Case 1: The non-grabbable item is our target primitive.\n                  if kind_id == primitive_idx:\n                      # If the target primitive itself is non-grabbable (e.g., WORKSHOP, WATER),\n                      # the agent cannot step onto its cell to collect it. It must be adjacent.\n                      if not is_target_primitive_grabbable:\n                          is_traversable = False\n                          break\n                      # (If it *were* grabbable, it wouldn't typically be in non_grabbable_indices,\n                      # but if it is, this logic allows stepping on it if it's grabbable).\n                  # Case 2: The non-grabbable item is *not* our target primitive (e.g., BOUNDARY, other WORKSHOP, WATER).\n                  else:\n                      # These are impassable obstacles.\n                      is_traversable = False\n                      break\n          \n          if not is_traversable:\n              continue # Cannot move into an obstacle cell.\n\n          # If the cell is traversable and not yet visited, add it to the queue for exploration.\n          visited.add((next_x, next_y))\n          queue.append(((next_x, next_y), path_actions + [action]))\n\n  if not found_path:\n      # If the queue is exhausted and no path was found to any target position,\n      # it means the primitive is unreachable.\n      return []\n\n  # 8. Append the found movement actions to the final action list.\n  actions.extend(path_to_primitive_area)\n\n  # 9. After moving the agent to a position from which the primitive can be 'USE'd,\n  # append the 'USE' action to attempt collection/interaction.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:46:10.736111", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive]\n\n  # Ensure that the primitive is actually \"grabbable\" (i.e., can be collected into the agent's inventory).\n  # If the primitive is a non-grabbable entity like a workshop or boundary,\n  # this function, designed for 'collection', should not attempt to 'collect' it.\n  if i_primitive not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  width, height, n_kinds = grid.shape\n\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (dr, dc) to action for moving\n  move_deltas = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # First, check if already in a position to collect the primitive\n  if current_state.next_to(i_primitive):\n    return [USE]\n\n  # Get the index for water, which typically acts as a movement obstacle\n  i_water = env.world.water_index\n  \n  # Helper function to check if a cell is traversable for the agent.\n  # A cell is traversable if it's within grid bounds and does not contain water.\n  def is_cell_traversable(r, c):\n      if not (0 <= r < width and 0 <= c < height):\n          return False # Out of bounds\n      if grid[r, c, i_water] > 0:\n          return False # Contains water, not traversable\n      return True\n\n  # BFS for shortest path to a position from which the primitive can be 'USE'd\n  queue = collections.deque([(current_pos, [])]) # (position, list_of_actions)\n  visited = {current_pos}\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # Check if the current position (r, c) is a goal state for BFS:\n    # A goal state is any position from which the agent can immediately 'USE'\n    # to collect the target primitive. This means the primitive must be in the\n    # 3x3 neighborhood of (r, c).\n    is_adjacent_or_on_primitive = False\n    for dr_check in [-1, 0, 1]:\n        for dc_check in [-1, 0, 1]:\n            check_r, check_c = r + dr_check, c + dc_check\n            # Check if neighbor is within bounds and contains the primitive\n            if (0 <= check_r < width and 0 <= check_c < height and \n                grid[check_r, check_c, i_primitive] > 0):\n                is_adjacent_or_on_primitive = True\n                break\n        if is_adjacent_or_on_primitive:\n            break\n\n    if is_adjacent_or_on_primitive:\n        return path + [USE] # Found path to a position where we can USE.\n\n    # Explore valid neighbors (Up, Down, Left, Right)\n    for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      nr, nc = r + dr, c + dc # Next row, next column\n\n      if (nr, nc) not in visited and is_cell_traversable(nr, nc):\n        visited.add((nr, nc))\n        action_to_take = move_deltas[(dr, dc)]\n        queue.append(((nr, nc), path + [action_to_take]))\n\n  # If no path found after exhausting the BFS queue\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:46:11.836247", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive]\n\n  # Improvement for collect_v2: Ensure that the primitive is actually \"grabbable\"\n  # (i.e., can be collected into the agent's inventory).\n  # If the primitive is a non-grabbable entity like a workshop or boundary,\n  # this function, designed for 'collection', should not attempt to 'collect' it.\n  if i_primitive not in env.world.grabbable_indices:\n    return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  width, height, n_kinds = grid.shape\n\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (dr, dc) to action for moving\n  move_deltas = {\n      (1, 0): DOWN,\n      (-1, 0): UP,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  # First, check if already in a position to collect the primitive\n  if current_state.next_to(i_primitive):\n    return [USE]\n\n  # Get the index for water, which typically acts as a movement obstacle\n  i_water = env.world.water_index\n  \n  # Helper function to check if a cell is traversable for the agent.\n  # A cell is traversable if it's within grid bounds and does not contain water.\n  # Other non-grabbable items like workshops are generally considered traversable\n  # as places to stand.\n  def is_cell_traversable(r, c):\n      if not (0 <= r < width and 0 <= c < height):\n          return False # Out of bounds\n      if grid[r, c, i_water] > 0:\n          return False # Contains water, not traversable\n      return True\n\n  # BFS for shortest path to a position from which the primitive can be 'USE'd\n  queue = collections.deque([(current_pos, [])]) # (position, list_of_actions)\n  visited = {current_pos}\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # Check if the current position (r, c) is a goal state for BFS:\n    # A goal state is any position from which the agent can immediately 'USE'\n    # to collect the target primitive. This means the primitive must be in the\n    # 3x3 neighborhood of (r, c).\n    is_adjacent_or_on_primitive = False\n    for dr_check in [-1, 0, 1]:\n        for dc_check in [-1, 0, 1]:\n            check_r, check_c = r + dr_check, c + dc_check\n            # Check if neighbor is within bounds and contains the primitive\n            if (0 <= check_r < width and 0 <= check_c < height and \n                grid[check_r, check_c, i_primitive] > 0):\n                is_adjacent_or_on_primitive = True\n                break\n        if is_adjacent_or_on_primitive:\n            break\n\n    if is_adjacent_or_on_primitive:\n        return path + [USE] # Found path to a position where we can USE.\n\n    # Explore valid neighbors (Up, Down, Left, Right)\n    for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      nr, nc = r + dr, c + dc # Next row, next column\n\n      if (nr, nc) not in visited and is_cell_traversable(nr, nc):\n        visited.add((nr, nc))\n        action_to_take = move_deltas[(dr, dc)]\n        queue.append(((nr, nc), path + [action_to_take]))\n\n  # If no path found after exhausting the BFS queue\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:47:41.047646", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define actions and their effects on position and direction\n  # Format: (dr, dc, new_facing_direction_after_move)\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Correct mapping based on CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTIONS = {\n      craft.DOWN:  ( 1,  0, 2), # Action 0: move South, face South\n      craft.UP:    (-1,  0, 0), # Action 1: move North, face North\n      craft.LEFT:  ( 0, -1, 3), # Action 2: move West, face West\n      craft.RIGHT: ( 0,  1, 1)  # Action 3: move East, face East\n  }\n  \n  # Delta (dr, dc) for the cell *in front* of the agent based on its facing direction\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Function to check if a cell is walkable for the agent\n  def _is_walkable(r, c):\n      # Check bounds\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for impassable terrains (water, stone)\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles (excluding workshops, which are walkable)\n      for idx in non_grabbable_indices:\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue # Already handled or are considered walkable locations\n          # If this non-grabbable item (that is not water/stone/workshop) is present, it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is walkable\n\n  # BFS State: (row, col, current_facing_direction, list_of_actions_taken)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Visited set to prevent redundant exploration and cycles: (row, col, current_facing_direction)\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the goal of collecting the primitive\n      # 1. Check if current position contains a grabbable primitive\n      if primitive_idx in grabbable_indices and current_state.grid[r, c, primitive_idx] == 1:\n          return path # Agent is on top of a grabbable item, collection happens on movement to this cell.\n\n      # 2. Check if the cell *in front* contains a non-grabbable primitive requiring USE\n      front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n      if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT: # Ensure the cell in front is within bounds\n          if primitive_idx in non_grabbable_indices and current_state.grid[front_r, front_c, primitive_idx] == 1:\n              return path + [craft.USE] # Agent is adjacent and facing the non-grabbable item, use 'USE' action.\n\n      # Explore possible movement actions from the current state\n      for action_id, (dr, dc, next_dir_after_move) in ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  return [] # No path found to collect the primitive", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:47:42.207113", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define actions and their effects on position and direction\n  # Format: (dr, dc, new_facing_direction_after_move)\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  ACTIONS_MAP = {\n      craft.UP:    ( -1,  0, 0), \n      craft.RIGHT: (  0,  1, 1),\n      craft.DOWN:  (  1,  0, 2),\n      craft.LEFT:  (  0, -1, 3)\n  }\n  \n  # Delta (dr, dc) for the cell *in front* of the agent based on its facing direction\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Function to check if a cell is walkable for the agent\n  def _is_walkable(r, c):\n      # Check bounds\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for impassable terrains (water, stone)\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles (excluding workshops, which are walkable)\n      for idx in non_grabbable_indices:\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue # Already handled or are considered walkable locations\n          # If this non-grabbable item (that is not water/stone/workshop) is present, it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is walkable\n\n  # BFS State: (row, col, current_facing_direction, list_of_actions_taken)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Visited set to prevent redundant exploration and cycles: (row, col, current_facing_direction)\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state (r, c, current_dir) satisfies the goal to collect the primitive\n      # If the primitive is GRABBABLE: agent needs to BE ON its cell.\n      if primitive_idx in grabbable_indices:\n          if (0 <= r < WIDTH and 0 <= c < HEIGHT and \n              current_state.grid[r, c, primitive_idx] == 1):\n              return path # Agent is on the grabbable item, it's considered collected\n\n      # If the primitive is NON-GRABBABLE: agent needs to be ADJACENT and FACING it, then USE.\n      elif primitive_idx in non_grabbable_indices:\n          # Calculate the cell in front of the agent\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n              current_state.grid[front_r, front_c, primitive_idx] == 1):\n              return path + [craft.USE] # Agent is facing the non-grabbable item, append USE action.\n\n      # Explore possible movement actions from the current state\n      for action_id, (dr, dc, next_dir_after_move) in ACTIONS_MAP.items():\n          next_r, next_c = r + dr, c + dc\n\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  return [] # No path found to collect the primitive", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:48:28.810373", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive) # Get integer ID for the primitive\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Check if the primitive is already in inventory (if it's a grabbable item).\n  # If so, no actions are needed to collect it.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # MOVE_ACTIONS[action_id] = (dr, dc, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Move North (up), face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (right), face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (down), face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (left), face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable item that is not a workshop.\n      # Workshops are walkable. Other non-grabbables like WATER, STONE are not.\n      for idx in non_grabbable_indices:\n          if current_state.grid[r, c, idx] == 1:\n              if idx not in workshop_indices:\n                  return False # Blocked by a non-grabbable, non-workshop item.\n      \n      return True # Cell is considered walkable.\n\n  # Find all occurrences of the target primitive on the grid.\n  # This set will be used for goal checking in BFS.\n  primitive_locations = set()\n  for r_grid in range(WIDTH):\n      for c_grid in range(HEIGHT):\n          if current_state.grid[r_grid, c_grid, primitive_idx] == 1:\n              primitive_locations.add((r_grid, c_grid))\n  \n  # If the primitive is not found on the grid at all, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state allows for collecting the primitive.\n      if primitive_idx in world.grabbable_indices:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n          if (r, c) in primitive_locations:\n              return path # Path found to the grabbable item's location.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items (e.g., WATER, STONE, WORKSHOP), the agent needs to be adjacent\n          # to the item, facing it, then perform a 'USE' action.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Check if the cell in front is within bounds and contains the target primitive.\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                  (front_r, front_c) in primitive_locations):\n              return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n          next_state_dir = next_dir_after_move # The direction after moving to next_r, next_c\n\n          # Check if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_dir)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_state_dir, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:48:30.001453", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive) # Get integer ID for the primitive\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Initial check: If the primitive is a grabbable item and is already present\n  # in the agent's inventory, no further actions are needed to \"collect\" it.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define movement actions and their effects on the agent's position and facing direction.\n  # MOVE_ACTIONS maps an action ID (e.g., craft.UP) to a tuple:\n  # (delta_row, delta_col, new_facing_direction_after_move)\n  # Agent directions are: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Moving UP (North), agent faces North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Moving RIGHT (East), agent faces East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Moving DOWN (South), agent faces South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Moving LEFT (West), agent faces West (dir 3)\n  }\n  \n  # DIR_TO_DELTA maps a facing direction to the (delta_row, delta_col) of the cell\n  # directly in front of the agent. This is essential for determining the target of a 'USE' action.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # If facing North, cell in front is (row-1, col)\n      1: (0, 1),   # If facing East, cell in front is (row, col+1)\n      2: (1, 0),   # If facing South, cell in front is (row+1, col)\n      3: (0, -1)   # If facing West, cell in front is (row, col-1)\n  }\n\n  # Cache relevant indices from the world configuration for efficient lookups within the BFS.\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices # Workshops are special non-grabbables that are walkable.\n\n  # Helper function to determine if a grid cell (r, c) is a valid and walkable location for the agent.\n  def _is_walkable(r, c):\n      # Check if the cell is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable item that is NOT a workshop.\n      # If such an item is present, the cell is impassable.\n      # Workshops (e.g., BENCH) are non-grabbable but agents can stand on them.\n      for idx in non_grabbable_indices:\n          if current_state.grid[r, c, idx] == 1:\n              if idx not in workshop_indices:\n                  return False # Found an impassable non-grabbable obstacle.\n      \n      return True # The cell is valid and considered walkable.\n\n  # Pre-compute all locations on the grid where the target primitive exists.\n  # This set will be used for efficient goal checking during the BFS, avoiding repeated grid scans.\n  primitive_locations = set()\n  for r_grid in range(WIDTH):\n      for c_grid in range(HEIGHT):\n          if current_state.grid[r_grid, c_grid, primitive_idx] == 1:\n              primitive_locations.add((r_grid, c_grid))\n  \n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path of actions.\n  # The queue stores tuples: (current_row, current_col, current_direction, list_of_actions_taken_so_far)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # The visited set stores (row, col, direction) tuples to prevent revisiting states,\n  # which avoids redundant computations and infinite loops.\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Start the BFS exploration.\n  while q:\n      r, c, current_dir, path_so_far = q.popleft()\n\n      # Check if the current state (position and direction) satisfies the collection goal.\n      if primitive_idx in world.grabbable_indices:\n          # For grabbable items (e.g., WOOD, IRON, GRASS), collection means the agent\n          # must move onto the cell containing the item.\n          if (r, c) in primitive_locations:\n              return path_so_far # Path found to a grabbable item's location.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items (e.g., WATER, STONE, WORKSHOPs), collection means\n          # the agent must be adjacent to the item, facing it, and then perform a 'USE' action.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check if the cell in front contains the target primitive.\n          if (front_r, front_c) in primitive_locations:\n              return path_so_far + [craft.USE] # Path found, append the necessary USE action.\n\n      # If the goal is not met at the current state, explore all possible next movement actions.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n          next_state_dir = next_dir_after_move # The agent's new facing direction after this move.\n\n          # Check if the potential next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_dir)\n              \n              # If this new state has not been visited before, add it to the queue for exploration.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_state_dir, path_so_far + [action_id]))\n\n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:49:20.689224", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACT_DOWN = action_map['DOWN']\n  ACT_UP = action_map['UP']\n  ACT_LEFT = action_map['LEFT']\n  ACT_RIGHT = action_map['RIGHT']\n  ACT_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n      # Primitive name not found in the game's index.\n      return []\n\n  current_state = env._current_state\n  \n  # Improvement 1: Check if the primitive is already in the agent's inventory.\n  # If so, there's no need to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  agent_x, agent_y = current_state.pos\n  grid = current_state.grid\n\n  WIDTH, HEIGHT, _ = grid.shape\n  \n  # Define what constitutes an obstacle for movement.\n  # Assuming entities in env.world.non_grabbable_indices (Cookbook's environment set)\n  # are impassable terrain or objects that block movement.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # Step 1: Find all locations on the grid where the target primitive exists.\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # The primitive is not found anywhere on the current grid.\n      return []\n\n  # Step 2: Identify all valid and traversable cells adjacent to any primitive location.\n  # These are the potential target cells the agent needs to reach before using the 'USE' action.\n  target_adjacent_cells = set()\n  \n  # Define relative coordinates for 4-directional neighbors\n  neighbors = [(0, 1), (0, -1), (1, 0), (-1, 0)] \n  \n  for px, py in primitive_locations:\n      for dx, dy in neighbors:\n          ax, ay = px + dx, py + dy # Candidate adjacent cell (ax, ay)\n          \n          # Check if the candidate adjacent cell is within grid boundaries\n          if not (0 <= ax < WIDTH and 0 <= ay < HEIGHT):\n              continue\n          \n          # Check if the candidate adjacent cell is an obstacle\n          is_obstacle = False\n          for obstacle_kind_idx in obstacle_indices:\n              if grid[ax, ay, obstacle_kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          # If the cell is within bounds and not an obstacle, it's a valid target for pathfinding.\n          if not is_obstacle:\n              target_adjacent_cells.add((ax, ay))\n\n  if not target_adjacent_cells:\n      # No traversable adjacent cells found around any primitive instance.\n      return []\n\n  # Step 3: Use Breadth-First Search (BFS) to find the shortest path\n  # from the agent's current position to any of the valid target_adjacent_cells.\n  q = collections.deque()\n  # Queue stores (current_x, current_y, list_of_actions_taken_to_reach_here)\n  q.append((agent_x, agent_y, [])) \n  \n  visited = set()\n  visited.add((agent_x, agent_y)) # Mark starting position as visited\n\n  # Mapping of (dx, dy) to corresponding action indices\n  action_mapping_dir = {\n      (0, 1): ACT_DOWN,\n      (0, -1): ACT_UP,\n      (1, 0): ACT_RIGHT,\n      (-1, 0): ACT_LEFT\n  }\n\n  while q:\n      cx, cy, current_path = q.popleft()\n\n      # If the current cell is one of our target adjacent cells, we found the shortest path.\n      if (cx, cy) in target_adjacent_cells:\n          # Append the USE action as the final step to interact with/collect the primitive.\n          return current_path + [ACT_USE]\n\n      # Explore neighboring cells\n      for dx, dy in neighbors:\n          nx, ny = cx + dx, cy + dy # Next cell to explore\n          \n          # Check if the next cell is within grid boundaries and hasn't been visited yet\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT and (nx, ny) not in visited):\n              continue\n          \n          # Check if the next cell is an obstacle\n          is_obstacle = False\n          for obstacle_kind_idx in obstacle_indices:\n              if grid[nx, ny, obstacle_kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          # If the next cell is traversable, add it to the queue\n          if not is_obstacle:\n              visited.add((nx, ny)) # Mark as visited\n              new_path = current_path + [action_mapping_dir[(dx, dy)]]\n              q.append((nx, ny, new_path))\n              \n  # If the BFS completes and no path is found to any target adjacent cell,\n  # it means the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": -1}}
