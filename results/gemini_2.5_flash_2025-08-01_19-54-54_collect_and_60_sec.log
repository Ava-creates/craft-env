{"timestamp": "2025-08-02T06:19:44.027853", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid layout: numpy.ndarray (WIDTH, HEIGHT, n_kinds)\n  \n  # 1. Map the primitive name string to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early exit for grabbable items already in inventory\n  # If the target primitive is something that can be picked up (e.g., WOOD, IRON)\n  # and the agent already possesses at least one unit of it, no collection actions are needed.\n  is_grabbable_target = primitive_idx in env.world.grabbable_indices\n  if is_grabbable_target and state.inventory[primitive_idx] > 0:\n    return [] \n\n  # 3. Get action mappings from the environment for control\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions relative to the agent's current position (dx, dy, action_id)\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for BFS\n  start_pos = state.pos\n\n  # 4. Initialize Breadth-First Search (BFS)\n  # The queue stores tuples: (current_position, list_of_actions_taken_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found.\n  min_path_len = float('inf') # Stores the length of the shortest action sequence found so far.\n  best_path_actions = []      # Stores the actual sequence of actions for the shortest path.\n\n  # Get the index for 'BOUNDARY' terrain. This is used to identify impassable cells.\n  # If 'BOUNDARY' is the target primitive itself, the agent *can* move onto it.\n  boundary_idx = cookbook.index['BOUNDARY']\n  \n  # 5. BFS Loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Optimization (Pruning): If the current path is already longer than or equal to the\n    # shortest complete path found so far, there's no need to explore this branch further,\n    # as it cannot lead to a shorter solution.\n    if len(current_actions) >= min_path_len:\n        continue\n\n    # Create a hypothetical CraftState at the `current_pos`. This allows us to use\n    # CraftState's utility methods (like `next_to`) as if the agent were actually there,\n    # without modifying the real environment state during pathfinding.\n    # The agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 6. Check if the current position (or an adjacent one) satisfies the goal\n    is_goal_achieved_at_current_location = False\n    actions_to_complete_goal_from_here = [] # Additional actions needed (e.g., USE)\n\n    if is_grabbable_target:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to the item\n      # and then perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_achieved_at_current_location = True\n        actions_to_complete_goal_from_here = [ACTION_USE]\n    else: \n      # For non-grabbable items (e.g., WORKSHOP0, WATER, STONE, BOUNDARY),\n      # \"collecting\" means simply reaching the cell where the item is located.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_achieved_at_current_location = True\n        actions_to_complete_goal_from_here = [] # No 'USE' action needed\n\n    # 7. If a goal state is reached, update the `best_path_actions`\n    if is_goal_achieved_at_current_location:\n      total_actions = current_actions + actions_to_complete_goal_from_here\n      # If this path is shorter than any previously found path, update `min_path_len` and `best_path_actions`.\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # IMPORTANT: Do NOT `return` immediately here.\n      # While BFS guarantees finding the shortest path to *a node*, the \"goal\" might involve an additional\n      # action (like USE), or there might be multiple instances of the primitive on the map.\n      # Continuing BFS ensures we find the shortest *total action sequence* to collect *any*\n      # instance of the primitive, including the final `USE` if applicable.\n\n    # 8. Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check traversability: A cell is considered impassable if it contains a 'BOUNDARY' entity,\n        # UNLESS 'BOUNDARY' itself is the target primitive we are trying to collect.\n        is_impassable = (\n            boundary_idx is not None and                  # Check if BOUNDARY index exists\n            grid[new_x, new_y, boundary_idx] > 0 and      # Check if the cell contains a BOUNDARY\n            primitive_idx != boundary_idx                 # Allow traversing if BOUNDARY is the target\n        )\n        \n        if is_impassable:\n          continue # Cannot move into this cell, skip to the next neighbor.\n\n        # If the new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. After the BFS completes, `best_path_actions` will contain the shortest sequence of actions\n  # to collect the primitive, or it will be an empty list if no path was found\n  # (e.g., primitive not on the map, or unreachable).\n  return best_path_actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T06:19:45.411760", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Early exit: If the primitive is already in inventory AND it's a grabbable item, \n  # no actions are needed to collect it from the environment.\n  # For non-grabbable items (like WORKSHOP, WATER, STONE), \"collecting\" means\n  # reaching the location, even if you are already \"on\" it, so we don't exit early.\n  if primitive_idx in env.world.grabbable_indices and state.inventory[primitive_idx] > 0:\n    return [] \n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Initialize variables to track the best path found so far\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine whether the target primitive is grabbable or non-grabbable.\n  # This dictates whether we need to be adjacent and USE, or just on the same cell.\n  is_grabbable_target = primitive_idx in env.world.grabbable_indices\n  \n  # Get boundary index for traversability check.\n  # 'BOUNDARY' is typically an impassable terrain type.\n  boundary_idx = cookbook.index['BOUNDARY'] # Will be None if 'BOUNDARY' is not indexed\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Optimization: If current path length already equals or exceeds the best total path found,\n    # prune this branch. This is valid because we are looking for the shortest *action sequence*.\n    # This optimization is crucial for performance.\n    if len(current_actions) >= min_path_len: \n        continue\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` can lead to collecting the primitive\n    is_goal_reached_at_current_or_adjacent = False\n    actions_to_complete_goal = []\n\n    if is_grabbable_target:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached_at_current_or_adjacent = True\n        actions_to_complete_goal = [ACTION_USE]\n    else: \n      # For non-grabbable items (e.g., WORKSHOP, WATER, STONE, BOUNDARY), \n      # \"collecting\" implies reaching the location itself.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached_at_current_or_adjacent = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached (either at current position or adjacent requiring USE),\n    # update the best path found so far.\n    if is_goal_reached_at_current_or_adjacent:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # IMPORTANT: Do NOT `return` here immediately. BFS guarantees the shortest path\n      # to a *node*, but the \"collection\" might involve an additional action (like USE),\n      # or there might be multiple instances of the primitive on the map.\n      # Continuing BFS ensures we find the shortest *total action sequence* to collect\n      # *any* instance of the primitive.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check traversability: A cell is considered impassable if it contains 'BOUNDARY'\n        # AND 'BOUNDARY' is NOT the primitive we are trying to collect.\n        # This allows the agent to move into/onto a boundary if the goal is to \"collect\" the boundary itself.\n        is_impassable = (\n            boundary_idx is not None and \n            grid[new_x, new_y, boundary_idx] > 0 and \n            primitive_idx != boundary_idx \n        )\n        \n        if is_impassable:\n          continue # Cannot move into this cell, it's blocked.\n\n        # If the new position has not been visited, add it to the queue\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # After BFS completes, best_path_actions will hold the shortest sequence of actions\n  # to collect the primitive, or it will be an empty list if no path was found\n  # (e.g., primitive not on the map or unreachable).\n  return best_path_actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T06:20:36.712412", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (agent_x, agent_y)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get action integer mappings for movement and the 'USE' action.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # 3. Identify truly impassable terrain kinds.\n  # In CraftWorld, 'WATER' and 'BOUNDARY' are typically impassable (cannot be walked on).\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function: Check if a grid position is valid and traversable.\n  def is_traversable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of grid bounds\n    \n    # Check if the cell contains any impassable obstacle.\n    # Note: `grid[x, y, idx]` is 1 if that kind is present, 0 otherwise.\n    for impassable_idx in impassable_kind_indices:\n      if grid[x, y, impassable_idx] == 1:\n        return False\n    return True\n\n  # 4. Find all grid locations where the desired primitive is present.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # 5. Pre-calculate all \"collectable use spots\".\n  # A 'use spot' is any grid cell from which the agent can successfully use a primitive.\n  # Per CraftState.next_to, the 'USE' action works if the item is in the 3x3 neighborhood\n  # of the agent's position.\n  collectable_use_spots = np.full((WIDTH, HEIGHT), False, dtype=bool)\n  for px, py in primitive_locations_on_grid:\n    # Iterate over the 3x3 neighborhood (including the center) around each primitive location.\n    for dx_offset in [-1, 0, 1]:\n      for dy_offset in [-1, 0, 1]:\n        ux, uy = px + dx_offset, py + dy_offset\n        # Ensure the potential use spot is within grid bounds.\n        if 0 <= ux < WIDTH and 0 <= uy < HEIGHT:\n          collectable_use_spots[ux, uy] = True\n\n  # 6. Initial check: Is the agent already on a collectable_use_spot?\n  # If so, only the 'USE' action is needed.\n  if collectable_use_spots[agent_pos[0], agent_pos[1]]:\n    return [USE]\n\n  # 7. Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting nodes and endless loops.\n  visited = {agent_pos}\n\n  # Define possible movement directions (dx, dy) corresponding to actions.\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft()\n\n    # Explore all four neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate new potential position\n\n      # Check if the new position is traversable and has not been visited yet.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_actions + [action_type]\n        \n        # Check if this new position (nx, ny) is one of the pre-calculated 'USE' spots.\n        if collectable_use_spots[nx, ny]:\n          # If a path is found to a 'USE' spot, append the 'USE' action and return the complete sequence.\n          # BFS guarantees this is the shortest path.\n          return new_path_actions + [USE]\n        else:\n          # If not yet at a 'USE' spot, add this new position to the queue for further exploration.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # 8. If BFS completes without finding a path, the primitive is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T06:20:37.925488", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive from the cookbook's index mapping.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized (e.g., misspelled, or not a known kind),\n    # it cannot be collected.\n    return []\n\n  # 2. Get action integer mappings for movement directions and the 'USE' action.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # 3. Define impassable (blocking) terrain kinds.\n  # In CraftWorld, \"WATER\" and \"BOUNDARY\" are typically the only entities that block agent movement.\n  # Workshop locations (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) are usually non-grabbable but traversable.\n  blocking_kind_indices = set()\n  # Add \"WATER\" to blocking indices if it exists in the cookbook's index.\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  # Add \"BOUNDARY\" to blocking indices if it exists.\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a given grid position (x, y) is within bounds\n  # and does not contain any blocking terrain.\n  def is_traversable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Position is out of grid bounds.\n    \n    # Check if the cell at (x, y) contains any blocking kind.\n    # grid[x, y, kind_idx] is 1 if the kind is present, 0 otherwise.\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False  # This cell contains an impassable obstacle.\n    return True\n\n  # 4. Find all grid locations where the desired primitive is physically present.\n  # np.argwhere returns (row, col) which corresponds to (x, y) for our grid.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # 5. Pre-calculate all valid 'USE' spots.\n  # A 'USE' spot is any grid cell from which the agent can successfully perform the 'USE' action\n  # to collect the primitive. This means the cell must be within Chebyshev distance 1 (3x3 neighborhood)\n  # of any primitive location.\n  collectable_use_spots = np.full((WIDTH, HEIGHT), False, dtype=bool)\n  for px, py in primitive_locations_on_grid:\n    # Iterate over the 3x3 neighborhood (including the center) around each primitive location.\n    # The agent can stand at (ux, uy) and 'USE' a primitive at (px, py).\n    for dx_use in [-1, 0, 1]:\n      for dy_use in [-1, 0, 1]:\n        ux, uy = px + dx_use, py + dy_use\n        # Ensure the potential 'USE' spot is within grid bounds.\n        if 0 <= ux < WIDTH and 0 <= uy < HEIGHT:\n          collectable_use_spots[ux, uy] = True\n\n  # 6. Initial check: Is the agent already on a 'USE' spot?\n  # If the agent's current position allows for immediate collection, return only the 'USE' action.\n  if collectable_use_spots[agent_pos[0], agent_pos[1]]:\n    return [USE]\n\n  # 7. Breadth-First Search (BFS) for pathfinding.\n  # The BFS aims to find the shortest sequence of movement actions to reach any 'USE' spot.\n  # The queue stores tuples: ((current_x, current_y), [list_of_actions_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting nodes and ensure shortest path.\n  visited = {agent_pos}\n\n  # Define possible movement directions (dx, dy) corresponding to each action type.\n  moves_directions = {\n      UP: (0, -1),   # (delta_x, delta_y) for moving UP\n      DOWN: (0, 1),   # (delta_x, delta_y) for moving DOWN\n      LEFT: (-1, 0),  # (delta_x, delta_y) for moving LEFT\n      RIGHT: (1, 0),  # (delta_x, delta_y) for moving RIGHT\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue the current position and its path\n\n    # Explore all four neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in moves_directions.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the new potential position\n\n      # Check if the new position is traversable and has not been visited yet.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_actions + [action_type] # Extend the path\n        \n        # If this new position (nx, ny) is one of the pre-calculated 'USE' spots,\n        # a shortest path has been found.\n        if collectable_use_spots[nx, ny]:\n          # Append the 'USE' action to the movement path and return the complete sequence.\n          # BFS guarantees this is the shortest sequence of actions to reach a 'USE' spot.\n          return new_path_actions + [USE]\n        else:\n          # If not yet at a 'USE' spot, add this new position to the visited set and queue\n          # for further exploration.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # If the BFS queue becomes empty and no path to a 'USE' spot was found,\n  # it means the primitive is unreachable from the current agent position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T06:21:43.254288", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve action mappings from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements as (dx, dy, action_id) tuples.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North\n      (0, 1, ACTION_DOWN),   # Move South\n      (-1, 0, ACTION_LEFT),  # Move West\n      (1, 0, ACTION_RIGHT),  # Move East\n  ]\n\n  # Get grid dimensions.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for BFS.\n  start_pos = state.pos\n\n  # Pre-classify the primitive based on how it's \"collected\".\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  # This covers workshops, water, stone, and boundary.\n  is_on_tile_primitive = (\n      primitive_idx in env.world.workshop_indices or \n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      (cookbook.index['BOUNDARY'] is not None and primitive_idx == cookbook.index['BOUNDARY'])\n  )\n  \n  # Cache boundary index for impassable checks.\n  boundary_idx = cookbook.index['BOUNDARY']\n\n  # --- Initial checks for immediate collection without any movement ---\n  # If the grabbable primitive is already in inventory, no action is needed.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return [] \n  # If the grabbable primitive is immediately adjacent, a single USE action is sufficient.\n  if is_grabbable and state.next_to(primitive_idx):\n    return [ACTION_USE]\n  # If the target is a stationary/on-tile primitive and the agent is on its tile, no actions.\n  if is_on_tile_primitive and grid[start_pos[0], start_pos[1], primitive_idx] > 0:\n    return []\n\n  # --- BFS Initialization ---\n  # The queue stores (current_position_tuple, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set stores positions to avoid re-processing and infinite loops.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found for grabbable items.\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # --- BFS Main Loop ---\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Pruning for grabbable items: If the current path length already equals or exceeds\n    # the shortest path found so far (including a potential 'USE' action), skip this path.\n    if is_grabbable and len(current_actions) >= min_path_len:\n        continue\n\n    # Create a temporary CraftState to leverage its helper methods (like `next_to` or `grid` access).\n    temp_state_at_pos = craft.CraftState(\n        state.scenario, \n        state.grid, \n        current_pos, \n        state.dir, \n        state.inventory\n    )\n\n    # Determine if the goal is met at `current_pos` and what final actions are needed.\n    target_condition_met = False\n    final_actions_for_goal = []\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent and perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        target_condition_met = True\n        final_actions_for_goal = [ACTION_USE]\n    elif is_on_tile_primitive:\n      # For stationary/on-tile primitives, \"collecting\" means reaching the tile where it's located.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        target_condition_met = True\n        final_actions_for_goal = [] # No additional action needed.\n    \n    # If a goal condition is met at `current_pos`:\n    if target_condition_met:\n      total_path = current_actions + final_actions_for_goal\n      \n      if is_on_tile_primitive:\n        # For stationary/on-tile targets, BFS guarantees the first path found is the shortest.\n        # So, we can return this path immediately.\n        return total_path\n      elif is_grabbable:\n        # For grabbable items, we update the shortest path found if this one is better.\n        # We must continue BFS to ensure we find the absolute shortest path, as there\n        # might be multiple instances or adjacent cells that lead to collection.\n        if len(total_path) < min_path_len:\n          min_path_len = len(total_path)\n          best_path_actions = total_path\n        # Do not return yet; continue exploring for potentially shorter paths to other instances.\n\n    # Explore valid neighbors for movement.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position is impassable due to a 'BOUNDARY',\n        # unless the 'BOUNDARY' itself is the primitive we are trying to collect.\n        is_impassable_boundary = (\n            boundary_idx is not None and \n            grid[new_x, new_y, boundary_idx] > 0 and \n            primitive_idx != boundary_idx\n        )\n        \n        if is_impassable_boundary:\n          continue # Cannot move into a cell blocked by a boundary.\n\n        # If the new position has not been visited, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # After BFS completes:\n  # If the primitive was stationary/on-tile, the function would have returned earlier.\n  # If it was grabbable, `best_path_actions` will contain the shortest path found\n  # (including the USE action), or an empty list if no path was found.\n  return best_path_actions", "island_id": 8, "scores": {"3": 0.5}}
