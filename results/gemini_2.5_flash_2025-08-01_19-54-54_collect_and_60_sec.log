 new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir) # Define the new state for visited tracking.\n\n      # If this new (position, direction) state has not been visited yet, add it to the queue\n      # for future exploration and mark it as visited.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_actions + [action_type]))\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  # If no path was found (q became empty and min_path_len is still inf), returns [].\n  return best_path_actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-02T09:07:56.912724", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Pre-determine properties of the target primitive for goal checking efficiency\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Optimization 1: If the current path is already longer than or equal to \n    # the best path found so far, there's no need to explore this branch further.\n    # This is valid because BFS explores layer by layer, so any path popped at this\n    # length or greater cannot be shorter than what's already recorded for `min_path_len`.\n    if len(current_actions) >= min_path_len:\n      continue \n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: This checks if the *current cell* contains the primitive, not if it's *next to* it.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # We don't break here because BFS guarantees the shortest path to any *node*,\n      # but our \"goal\" might be a complex condition (e.g., `next_to` which covers multiple cells,\n      # or combining movement with a `USE` action). We need to exhaust the BFS to find the globally \n      # shortest sequence of actions considering all possible goal locations/conditions.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Optimization 2: Only add to queue if this path (current_actions + [action])\n        # could potentially be shorter than the best path found so far.\n        # This prevents enqueuing paths that will be pruned by Optimization 1 later anyway.\n        if len(current_actions) + 1 < min_path_len:\n          if new_pos not in visited:\n            visited.add(new_pos)\n            q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T09:07:58.107981", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles.\n  # Using a set of (position, direction) might be more robust if direction matters for next_to or USE,\n  # but for simple movement pathfinding, position is usually sufficient.\n  # For CraftWorld, `next_to` is based on 3x3 neighborhood regardless of agent direction,\n  # and `USE` acts on the cell in front, but here we just need to get *to* the cell.\n  # The `temp_state_at_pos` will use the original state's direction, which is okay for pathfinding.\n  visited = {start_pos} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking efficiency\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Optimization/Pruning: If the current path is already longer than or equal to \n    # the best path found so far, there's no need to explore this branch further.\n    # This is valid because BFS explores layer by layer, so any path popped at this\n    # length or greater cannot be shorter than what's already recorded for `min_path_len`.\n    if len(current_actions) >= min_path_len:\n      continue \n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: This checks if the *current cell* contains the primitive, not if it's *next to* it.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # We do NOT break here. BFS guarantees the shortest path to any *node* when the cost per edge is uniform.\n      # However, our \"goal\" might be a complex condition (`next_to` which covers multiple cells) \n      # or involve an additional action (`USE`). We must continue the BFS until the queue is empty \n      # to guarantee finding the globally shortest sequence of actions, considering all possible \n      # locations that satisfy the condition. The `min_path_len` pruning helps here.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Pruning: Only add to queue if this path (current_actions + [action])\n        # could potentially be shorter than the best path found so far.\n        # This condition helps avoid exploring paths that are already too long.\n        if len(current_actions) + 1 < min_path_len:\n          if new_pos not in visited:\n            visited.add(new_pos)\n            q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T09:08:51.778448", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Access the grid directly\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles.\n  visited = {start_pos} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking efficiency\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Optimization/Pruning: If the current path is already longer than or equal to \n    # the best path found so far, there's no need to explore this branch further.\n    if len(current_actions) >= min_path_len:\n      continue \n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      # Directly check the 3x3 neighborhood (including current cell) of current_pos for the primitive.\n      found_adjacent_primitive = False\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          neighbor_x, neighbor_y = current_pos[0] + dx_adj, current_pos[1] + dy_adj\n          # Ensure neighbor is within grid bounds\n          if 0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT:\n            if grid[neighbor_x, neighbor_y, primitive_idx] > 0:\n              found_adjacent_primitive = True\n              break\n        if found_adjacent_primitive:\n          break\n      \n      if found_adjacent_primitive:\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Continue BFS to ensure global shortest path, as multiple positions might satisfy the goal.\n      # The `min_path_len` pruning handles early termination for longer paths.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Pruning: Only add to queue if this path (current_actions + [action])\n        # could potentially be shorter than the best path found so far.\n        if len(current_actions) + 1 < min_path_len:\n          if new_pos not in visited:\n            visited.add(new_pos)\n            q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
