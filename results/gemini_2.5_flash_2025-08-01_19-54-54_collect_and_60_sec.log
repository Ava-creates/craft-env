            primitive_idx == cookbook.index.get('BOUNDARY')) # Use .get() for safety\n\n  # Get the index for 'BOUNDARY' to check for impassable terrain during movement.\n  # Use .get() to safely retrieve the index, returning None if 'BOUNDARY' isn't defined\n  # in the cookbook (though it's expected to be for CraftWorld).\n  boundary_idx = cookbook.index.get('BOUNDARY') \n  \n  # Define a local helper function to check collectability directly on the grid.\n  # This avoids creating CraftState objects inside the BFS loop, optimizing performance.\n  def _check_collectable_from_pos(current_pos_tuple):\n    \"\"\"\n    Checks if the primitive can be 'collected' from the given position.\n    Returns (is_collectable_at_pos, post_collection_actions).\n    \"\"\"\n    px, py = current_pos_tuple\n\n    if is_grabbable_item:\n      # For grabbable items, agent needs to be adjacent (3x3 neighborhood) and then USE.\n      # Manually check the 3x3 neighborhood of (px, py) on the grid.\n      for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n          nx, ny = px + dx, py + dy\n          # Ensure neighbor is within grid bounds AND contains the primitive\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, primitive_idx] > 0:\n            return True, [ACTION_USE]\n      return False, []\n    elif is_workshop_location or is_immobile_environment:\n      # For workshops or immobile environment, \"collecting\" means being on the same cell.\n      # We check if the target primitive is present at the `current_pos`.\n      if grid[px, py, primitive_idx] > 0:\n        return True, [] # No additional action like USE is required.\n      return False, []\n    # This case should ideally not be reached if primitive_idx corresponds to a known collectable type.\n    return False, [] \n  \n  # Immediate Check: Optimize for collection possible from the current position.\n  is_collectable_now, post_actions_now = _check_collectable_from_pos(start_pos)\n  if is_collectable_now:\n    return post_actions_now\n\n  # Determine the minimum number of additional actions needed *after* reaching a collection point.\n  # This is used in the BFS pruning condition to estimate the total path length.\n  min_actions_to_complete_collection = 1 if is_grabbable_item else 0\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue stores tuples of (current_position, current_path_length_in_moves).\n  q = collections.deque([(start_pos, 0)]) \n  \n  # `visited` set to keep track of visited positions to avoid cycles and redundant processing.\n  visited = {start_pos} \n  \n  # `parent_info` dictionary stores for each visited `position`:\n  #   - `parent_position`: The position from which `position` was reached.\n  #   - `action_to_reach`: The action taken to move from `parent_position` to `position`.\n  # This allows reconstructing the path once the goal is found.\n  parent_info = {start_pos: (None, None)} \n\n  # Variables to store the shortest sequence of actions found so far.\n  min_total_actions_len = float('inf')\n  shortest_path_actions = []\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    current_pos, current_move_actions_len = q.popleft()\n\n    # Pruning: If the current path length (movement actions) plus the minimum actions to complete collection\n    # is already greater than or equal to the best total path length found so far,\n    # then this path cannot be the overall shortest. This helps avoid exploring longer paths.\n    if current_move_actions_len + min_actions_to_complete_collection >= min_total_actions_len:\n      continue \n    \n    # Check if primitive can be collected from current_pos using the optimized local helper.\n    goal_met_at_current_pos, post_movement_actions_for_collection =\\\n        _check_collectable_from_pos(current_pos)\n\n    # If the goal condition is met at the current position, evaluate this path.\n    if goal_met_at_current_pos:\n      # Reconstruct the path from the start_pos to current_pos using parent_info.\n      path_to_current_pos = []\n      temp_curr = current_pos\n      while parent_info[temp_curr][0] is not None: \n        parent_pos, action_to_reach_temp_curr = parent_info[temp_curr]\n        path_to_current_pos.append(action_to_reach_temp_curr)\n        temp_curr = parent_pos # Move to the parent position\n      path_to_current_pos.reverse() # Reverse to get start-to-goal order.\n      \n      # Form the complete sequence of actions (movement + post-movement collection actions).\n      total_path_candidate = path_to_current_pos + post_movement_actions_for_collection\n      \n      # If this path is shorter than any previously found, update the shortest path.\n      if len(total_path_candidate) < min_total_actions_len:\n        min_total_actions_len = len(total_path_candidate)\n        shortest_path_actions = total_path_candidate\n        \n        # In a BFS with uniform costs and a constant cost for the final 'collection' action,\n        # the first time we discover a path that satisfies the goal condition will be the shortest overall.\n        # Thus, we can break early once the first solution is found and recorded.\n        break \n\n    # Explore valid neighbors of the current position.\n    for dx, dy, action in MOVE_ACTIONS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n      new_move_actions_len = current_move_actions_len + 1 \n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position is traversable (not a BOUNDARY).\n        # A cell is traversable if it does not contain a BOUNDARY element,\n        # or if BOUNDARY is not a defined element in this environment.\n        is_traversable = True\n        if boundary_idx is not None and grid[new_x, new_y, boundary_idx] > 0:\n            is_traversable = False\n\n        if is_traversable and new_pos not in visited:\n          # Further pruning: Only add this path to the queue if it could potentially\n          # lead to a shorter overall solution than the best one found so far.\n          if new_move_actions_len + min_actions_to_complete_collection < min_total_actions_len:\n            visited.add(new_pos)\n            q.append((new_pos, new_move_actions_len))\n            # Store the current position as the parent and the action taken to reach new_pos.\n            parent_info[new_pos] = (current_pos, action)\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  return shortest_path_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-02T07:32:58.593711", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`, adding an immediate check for nearby grabbable items.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # 2. Determine the type of primitive and set flags for \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Identify boundary for obstacle checking.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n  \n  # A primitive is \"stationary\" if it's water, stone, or boundary itself (which doesn't move/go to inventory).\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n\n  # 3. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 4. Early exit if the primitive is already \"collected\" based on its type.\n  # For grabbable items, \"collected\" means having it in inventory.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return [] \n  # For workshops or stationary environment features, \"collected\" means being at their location.\n  # Check if the agent is currently standing on the target primitive's cell.\n  elif (is_workshop or is_stationary_primitive) and grid[state.pos[0], state.pos[1], primitive_idx] > 0:\n    return [] \n\n  # --- NEW IMPROVEMENT FOR V2 ---\n  # If the primitive is grabbable and the agent is already adjacent to it,\n  # a single USE action is sufficient to collect it.\n  if is_grabbable and state.next_to(primitive_idx):\n    return [ACTION_USE]\n  # --- END NEW IMPROVEMENT ---\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # 5. BFS setup for pathfinding.\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into an 'impassable_kind_idx' cell unless\n        # we are specifically trying to reach that 'impassable_kind_idx' itself.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains an impassable object and the target is NOT that object, it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T07:32:59.832720", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # 2. Determine the type of primitive and set flags for \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Identify boundary for obstacle checking.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n  \n  # A primitive is \"stationary\" if it's water, stone, or boundary itself (which doesn't move/go to inventory).\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n\n  # 3. Early exit if the primitive is already \"collected\" based on its type.\n  # For grabbable items, \"collected\" means having it in inventory.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return [] \n  # For workshops or stationary environment features, \"collected\" means being at their location.\n  # Check if the agent is currently standing on the target primitive's cell.\n  elif (is_workshop or is_stationary_primitive) and grid[state.pos[0], state.pos[1], primitive_idx] > 0:\n    return [] \n\n  # 4. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Helper function to check if a target kind is in the 3x3 neighborhood of a position\n  def _is_next_to(pos, target_kind_idx, current_grid, grid_width, grid_height):\n      px, py = pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = px + dx, py + dy\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  if current_grid[nx, ny, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # 5. BFS setup for pathfinding.\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if _is_next_to(current_pos, primitive_idx, grid, WIDTH, HEIGHT):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into an 'impassable_kind_idx' cell unless\n        # we are specifically trying to reach that 'impassable_kind_idx' itself.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains an impassable object and the target is NOT that object, it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
