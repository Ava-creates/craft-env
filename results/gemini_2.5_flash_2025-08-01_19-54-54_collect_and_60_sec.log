{"timestamp": "2025-08-02T04:14:04.948206", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  # (dx, dy) represent changes in (X, Y) coordinates.\n  # X is horizontal (columns), Y is vertical (rows).\n  # Up: Y decreases; Down: Y increases; Left: X decreases; Right: X increases.\n  MOVES = [\n      (0, -1, ACTION_UP),    \n      (0, 1, ACTION_DOWN),   \n      (-1, 0, ACTION_LEFT),  \n      (1, 0, ACTION_RIGHT),  \n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  # This makes the BFS avoid moving into these cells unless the goal itself is that primitive.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS setup\n  # Queue stores tuples: (current_position_tuple, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Visited set to keep track of positions already processed to avoid redundant exploration\n  visited = {start_pos} \n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone.\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index)\n  # If the target itself is 'BOUNDARY', it is also treated as a stationary primitive.\n  is_boundary_goal = (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx)\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive or is_boundary_goal:\n      # For workshops, water, stone, or if the goal IS boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            # This logic ensures we can pathfind *to* a boundary if the goal is boundary, but not *through* it otherwise.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and not is_boundary_goal:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T04:14:06.175188", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Initial check: If it's a grabbable item and we already have it in inventory,\n  # no further actions are needed to \"collect\" it.\n  if primitive_idx in env.world.grabbable_indices and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up (changes Y coordinate by -1)\n      (0, 1, ACTION_DOWN),   # Down (changes Y coordinate by +1)\n      (-1, 0, ACTION_LEFT),  # Left (changes X coordinate by -1)\n      (1, 0, ACTION_RIGHT),  # Right (changes X coordinate by +1)\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assuming 'BOUNDARY' is the primary obstacle.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS setup\n  # Queue stores tuples: (current_position_tuple, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Visited set to keep track of positions already processed to avoid redundant exploration\n  visited = {start_pos} \n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone.\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index)\n  # If the target itself is 'BOUNDARY', it is also treated as a stationary primitive.\n  is_boundary_goal = (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx)\n\n  # Helper function to check if a target kind is in the 3x3 neighborhood of a given position\n  # This replaces the need to create a temporary CraftState object for `next_to` calls.\n  def _check_next_to(check_pos, target_idx):\n      cx, cy = check_pos\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n              # Check if the neighbor position is within grid boundaries\n              if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                  # Check if the target primitive is present at this neighbor cell\n                  if grid[nx_adj, ny_adj, target_idx] > 0:\n                      return True\n      return False\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if _check_next_to(current_pos, primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive or is_boundary_goal:\n      # For workshops, water, stone, or if the goal IS boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            # This logic ensures we can pathfind *to* a boundary if the goal is boundary, but not *through* it otherwise.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and not is_boundary_goal:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T04:15:03.871182", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook\n    return []\n\n  # Check if primitive is already in inventory\n  if state.inventory[primitive_idx] > 0:\n      return [] # Already have it, no actions needed\n\n  # Get grid dimensions\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves for BFS\n  # (dx, dy) for movement along with the action associated with it.\n  MOVES = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n  \n  # Helper function to check if a cell is within grid boundaries and is walkable.\n  # A cell is considered walkable if it's within bounds and does not contain any\n  # non-grabbable (and typically impassable) items.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  def is_valid_and_walkable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    # Check if the cell contains any non-grabbable item which might be an obstacle.\n    for ng_idx in non_grabbable_indices:\n      if grid[x, y, ng_idx] == 1: # If a non-grabbable item is present, it's not walkable.\n        return False\n    return True\n\n  # --- BFS for pathfinding ---\n  \n  # Queue for BFS: (current_x, current_y, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos[0], agent_pos[1], [])])\n  \n  # Visited set to avoid cycles and store shortest path found to a cell: (x, y)\n  visited = set([(agent_pos[0], agent_pos[1])])\n  \n  target_path = None # To store the found path to the action point\n  \n  # First, find all primitive locations on the grid.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n  \n  if len(primitive_locations) == 0:\n    return [] # Primitive not present on the current grid\n\n  # Create a set of all valid \"action points\". These are the cells from which\n  # an agent can perform a `USE` action on the primitive. This includes the\n  # primitive's cell itself and its 8 neighbors (3x3 area).\n  action_points = set()\n  for px, py in primitive_locations:\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = px + dx_adj, py + dy_adj\n        # Only add valid and walkable cells to action_points\n        if is_valid_and_walkable(adj_x, adj_y):\n          action_points.add((adj_x, adj_y))\n\n  # If the agent is already at an action point, just perform USE.\n  if agent_pos in action_points:\n      return [USE]\n\n  # BFS loop to find the shortest path to any action point\n  while queue:\n    curr_x, curr_y, current_path = queue.popleft()\n\n    # If this position is one of our target action points, we found the shortest path.\n    if (curr_x, curr_y) in action_points:\n      target_path = current_path\n      break # Found shortest path, exit BFS\n\n    # Explore neighbors\n    for action, (dx, dy) in MOVES.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      if is_valid_and_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        queue.append((next_x, next_y, current_path + [action]))\n\n  if target_path is None:\n    # No path found to any action point\n    return []\n  \n  # Path found: first execute the movement actions, then the USE action.\n  actions = target_path + [USE]\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T04:15:05.058080", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action\n  # Remember: CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    cx, cy = current_pos\n\n    # Create a temporary CraftState object to check the 'next_to' condition\n    # This allows us to simulate the agent's position without changing the\n    # actual environment state during pathfinding.\n    # The grid, direction, and inventory remain constant for the pathfinding.\n    temp_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position\n    if temp_state.next_to(primitive_idx):\n      # If found, append the 'USE' action and return the complete path\n      return current_path + [USE]\n\n    # Explore valid neighbors\n    for action, (dx, dy) in moves:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position has already been visited\n        if next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T04:16:23.996954", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  action_to_int = {\n      'UP': action_map['UP'],\n      'DOWN': action_map['DOWN'],\n      'LEFT': action_map['LEFT'],\n      'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE']\n  }\n  \n  # Define movements as (dx, dy) and corresponding action\n  # (dx, dy) here represents (change in x-coord, change in y-coord)\n  # The grid is indexed as [y, x] or [row, col]\n  movements = {\n      (0, -1): action_to_int['UP'],    # dy = -1 (row up), dx = 0 (col same)\n      (0, 1): action_to_int['DOWN'],   # dy = 1 (row down), dx = 0 (col same)\n      (-1, 0): action_to_int['LEFT'],  # dy = 0 (row same), dx = -1 (col left)\n      (1, 0): action_to_int['RIGHT']   # dy = 0 (row same), dx = 1 (col right)\n  }\n\n  grid_height, grid_width, num_kinds = grid.shape\n  \n  # Identify un-walkable (obstacle) indices\n  # For CraftWorld, non_grabbable_indices typically include BOUNDARY, WATER, WORKSHOPS,\n  # which are impassable or special interaction points, not simple resources.\n  # Primitives like WOOD, STONE, GRASS are usually grabbable and do not block movement.\n  non_walkable_indices = env.world.non_grabbable_indices \n  \n  def is_walkable(x, y):\n    # Check bounds first\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any non-walkable (obstacle) item\n    # Note: grid is indexed [y, x]\n    cell_contents = grid[y, x, :]\n    for k_idx in non_walkable_indices:\n      if cell_contents[k_idx] == 1:\n        # If the cell contains an obstacle, it's not walkable\n        return False\n    return True # Cell is within bounds and doesn't contain an obstacle\n\n  # Find all occurrences of the primitive on the grid\n  # np.argwhere returns (row, col) which corresponds to (y, x)\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    return [] # Primitive not present on the current grid\n\n  # Determine potential \"goal cells\" for BFS:\n  # Any walkable cell in the 3x3 neighborhood around any primitive instance.\n  # The agent needs to be adjacent to (or on, if the primitive allows) the item to USE it.\n  goal_coords = set()\n  for py, px in primitive_locations_on_grid: # (y, x) coordinates of a primitive instance\n    # Check 3x3 neighborhood around the primitive\n    for dy_adj in [-1, 0, 1]:\n      for dx_adj in [-1, 0, 1]:\n        adj_x, adj_y = px + dx_adj, py + dy_adj\n        if is_walkable(adj_x, adj_y):\n          goal_coords.add((adj_x, adj_y))\n  \n  if not goal_coords:\n      # No reachable adjacent positions found (e.g., all primitives are surrounded by walls)\n      return []\n\n  # BFS to find the shortest path from agent_pos to any of the `goal_coords`\n  start_x, start_y = agent_pos\n  q = collections.deque([((start_x, start_y), [])]) # (current_pos (x,y), path_taken_so_far)\n  visited = {(start_x, start_y)} # Keep track of visited positions to avoid cycles and redundant paths\n\n  path_to_adjacent_cell = None\n\n  while q:\n    (curr_x, curr_y), current_path = q.popleft()\n\n    # Check if current position is one of our goal_coords\n    if (curr_x, curr_y) in goal_coords:\n      path_to_adjacent_cell = current_path\n      break\n\n    # Explore neighbors\n    for (dx, dy), action in movements.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      \n      # Check if the next cell is walkable and hasn't been visited yet\n      if is_walkable(next_x, next_y) and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        q.append(((next_x, next_y), current_path + [action]))\n\n  if path_to_adjacent_cell is None:\n    # No path found to any adjacent cell where the primitive can be collected\n    return []\n\n  # Once the agent reaches an adjacent cell, append the USE action\n  return path_to_adjacent_cell + [action_to_int['USE']]", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T04:16:25.226302", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py) where px is column, py is row\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # If the agent is already next to the primitive, no movement is needed, just use it.\n  if state.next_to(primitive_idx):\n    return [USE]\n\n  # Find all occurrences of the primitive on the grid.\n  # grid[:, :, primitive_idx] extracts a 2D slice.\n  # np.argwhere returns (x_coord, y_coord) for the specific kind in that slice,\n  # assuming grid is indexed as grid[x, y, kind].\n  primitive_target_coords = np.argwhere(grid[:, :, primitive_idx] == 1)\n  \n  # If the primitive is not present on the grid, we can't collect it.\n  if len(primitive_target_coords) == 0:\n    return []\n\n  # BFS setup\n  q = collections.deque()\n  visited = set() # To store (x, y) coordinates already visited by BFS\n\n  # Start BFS from the agent's current position\n  # Queue stores (current_x, current_y, list_of_actions_to_reach_here)\n  q.append((agent_pos[0], agent_pos[1], []))\n  visited.add(agent_pos)\n\n  # Define possible movements (dx, dy) and their corresponding actions\n  # dx affects x-coordinate (column), dy affects y-coordinate (row)\n  movements = [\n      (0, -1, UP),    # Move up (decrease y-coordinate)\n      (0, 1, DOWN),   # Move down (increase y-coordinate)\n      (-1, 0, LEFT),  # Move left (decrease x-coordinate)\n      (1, 0, RIGHT)   # Move right (increase x-coordinate)\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape \n\n  while q:\n    curr_x, curr_y, path_actions = q.popleft()\n\n    # Check if the current position is adjacent to any primitive location\n    # A position (curr_x, curr_y) is adjacent to (target_x, target_y) if\n    # |curr_x - target_x| <= 1 AND |curr_y - target_y| <= 1.\n    is_adjacent_to_primitive = False\n    for target_x, target_y in primitive_target_coords:\n      if abs(curr_x - target_x) <= 1 and abs(curr_y - target_y) <= 1:\n        is_adjacent_to_primitive = True\n        break\n    \n    if is_adjacent_to_primitive:\n      # Found the shortest path to an adjacent cell! Append USE action and return.\n      path_actions.append(USE)\n      return path_actions\n\n    # Explore valid neighbors\n    for dx, dy, action in movements:\n      new_x, new_y = curr_x + dx, curr_y + dy\n\n      # Check grid boundaries\n      if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n        # Check if this new position has not been visited yet\n        if (new_x, new_y) not in visited:\n          visited.add((new_x, new_y))\n          q.append((new_x, new_y, path_actions + [action]))\n\n  # If the queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable or not present.\n  return []", "island_id": 7, "scores": {"3": 0.5}}
