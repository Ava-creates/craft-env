{"timestamp": "2025-08-02T05:14:46.048170", "function_name": "collect", "function_body": "  state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  grid = state.grid\n  \n  # Map the string primitive name to its unique integer ID using the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not have a corresponding ID,\n    # it cannot be collected. Return an empty list of actions.\n    return []\n\n  # Retrieve the integer action codes from the environment's action specifications.\n  # These are constants used to represent actions like moving UP, DOWN, etc.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible agent movements as (delta_x, delta_y, action_id).\n  # These tuples are used in the Breadth-First Search (BFS) to explore adjacent cells.\n  MOVE_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North: Decreases Y-coordinate\n      (0, 1, ACTION_DOWN),   # Move South: Increases Y-coordinate\n      (-1, 0, ACTION_LEFT),  # Move West: Decreases X-coordinate\n      (1, 0, ACTION_RIGHT),  # Move East: Increases X-coordinate\n  ]\n\n  # Get the dimensions of the grid for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Initialize the Breadth-First Search (BFS) queue and visited set.\n  # The queue `q` stores tuples of (current_position (x,y), list_of_actions_taken_to_reach_here).\n  # The `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # Determine the collection mechanism for the target primitive based on its type.\n  # Grabbable items (like WOOD, IRON) require an agent to be *adjacent* and then use 'USE'.\n  is_grabbable = primitive_idx in world.grabbable_indices\n  # Workshops and certain natural features (like WATER, STONE, BOUNDARY) are \"collected\"\n  # by simply standing on their location.\n  is_workshop = primitive_idx in world.workshop_indices\n  is_stationary_primitive = (\n      primitive_idx == world.water_index or \n      primitive_idx == world.stone_index or \n      primitive_idx == cookbook.index['BOUNDARY']\n  )\n  \n  # BFS loop to find the shortest path to collect the primitive.\n  while q:\n    current_pos, path_actions = q.popleft()\n    cx, cy = current_pos # Unpack current position for easier access\n\n    # Create a temporary CraftState object representing the agent at `current_pos`.\n    # This allows us to leverage `CraftState` methods like `next_to` for goal checking\n    # without actually stepping the real environment.\n    # Note: `state.dir` and `state.inventory` are used as placeholders;\n    # they don't affect grid-based pathfinding for location-based goals.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # --- Goal Check ---\n    # Since BFS explores level by level, the first time a goal condition is met,\n    # the `path_actions` associated with it represent the shortest sequence of steps.\n    if is_grabbable:\n      # If the primitive is grabbable, the agent needs to move to a cell *adjacent* to it\n      # and then perform a 'USE' action. `next_to` checks the 3x3 neighborhood.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # Goal reached: Append the 'USE' action and return the complete action sequence.\n        return path_actions + [ACTION_USE]\n        \n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No 'USE' action is typically needed.\n      # Check if the primitive exists at the agent's current position (cx, cy) in the grid.\n      if temp_state_at_pos.grid[cx, cy, primitive_idx] > 0:\n        # Goal reached: Return the sequence of actions to arrive at this position.\n        return path_actions\n    \n    # --- Explore Neighbors ---\n    # If the current position is not the goal, add its unvisited valid neighbors to the queue.\n    for dx, dy, action in MOVE_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this new position has not been visited yet, add it to the queue for future exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, path_actions + [action]))\n  \n  # If the BFS loop completes and the queue is empty, it means no path to the primitive was found\n  # from the starting position within the reachable grid.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T05:15:45.968117", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current state of the world grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve integer mappings for actions from the environment's specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions in terms of (delta_x, delta_y, action_id).\n  MOVE_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move agent Up (decreases Y-coordinate)\n      (0, 1, ACTION_DOWN),   # Move agent Down (increases Y-coordinate)\n      (-1, 0, ACTION_LEFT),  # Move agent Left (decreases X-coordinate)\n      (1, 0, ACTION_RIGHT),  # Move agent Right (increases X-coordinate)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT, number_of_kinds).\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # Categorize the primitive to apply appropriate collection logic.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  is_immobile_environment = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Determine the minimum number of additional actions needed *after* reaching a collection point.\n  # For grabbable items, a 'USE' action is typically required. For others, just being on the spot suffices.\n  min_actions_to_complete_collection = 1 if is_grabbable_item else 0\n\n  # --- Immediate Check: Optimize for collection possible from the current position. ---\n  temp_state_at_current_pos = craft.CraftState(state.scenario, state.grid, start_pos, state.dir, state.inventory)\n  \n  if is_grabbable_item:\n    if temp_state_at_current_pos.next_to(primitive_idx):\n      # Agent is already adjacent to a grabbable item, just needs to USE it.\n      return [ACTION_USE]\n  elif is_workshop_location or is_immobile_environment:\n    if temp_state_at_current_pos.grid[start_pos[0], start_pos[1], primitive_idx] > 0:\n      # Agent is already on the same cell as the workshop or immobile env element.\n      # No further action needed; it's considered \"collected\" by being there.\n      return []\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue will store tuples of (current_position, list_of_actions_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited positions to avoid cycles and redundant processing.\n  visited = {start_pos} \n\n  # Variables to store the shortest sequence of actions found so far.\n  min_total_actions_len = float('inf')\n  shortest_path_actions = []\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n    current_path_len = len(current_actions)\n\n    # Optimization: Prune this path if it's already too long or cannot lead to a shorter solution.\n    # If the current path length plus the minimum actions to complete collection\n    # is already greater than or equal to the best path found so far,\n    # then this path cannot be the shortest.\n    if current_path_len + min_actions_to_complete_collection >= min_total_actions_len:\n      continue \n\n    # Create a hypothetical `CraftState` object at the `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) to check conditions\n    # as if the agent were actually at this position, without modifying the real environment state.\n    # The agent's direction and inventory are kept constant as they don't affect grid-based pathfinding for location.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Determine if the primitive can be 'collected' from the `current_pos`.\n    # This acts as the goal condition for our BFS.\n    goal_met_at_current_pos = False\n    # Actions that might be needed *after* reaching `current_pos` to complete collection (e.g., USE).\n    post_movement_actions_for_collection = []\n\n    if is_grabbable_item:\n      # For items that can be picked up (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        goal_met_at_current_pos = True\n        post_movement_actions_for_collection = [ACTION_USE]\n    elif is_workshop_location or is_immobile_environment:\n      # For workshops or environmental features, \"collecting\" means being on the same cell as the item.\n      # We check if the target primitive is present at the `current_pos`.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        goal_met_at_current_pos = True\n        post_movement_actions_for_collection = [] # No additional action like USE is required.\n\n    # If the goal condition is met at the current position, evaluate this path.\n    if goal_met_at_current_pos:\n      total_path_candidate = current_actions + post_movement_actions_for_collection\n      # If this path is shorter than any previously found path, update the shortest path.\n      if len(total_path_candidate) < min_total_actions_len:\n        min_total_actions_len = len(total_path_candidate)\n        shortest_path_actions = total_path_candidate\n      # We do NOT `break` here. BFS guarantees the shortest path to a *node*.\n      # However, our \"goal\" might involve an action (like `USE`) taken from a node,\n      # and multiple nodes (e.g., different adjacent cells) could satisfy the condition.\n      # We must continue the BFS to ensure we find the absolute shortest *sequence of actions*\n      # that leads to successful collection. The pruning condition above helps accelerate this.\n\n    # Explore valid neighbors of the current position.\n    for dx, dy, action in MOVE_ACTIONS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n      new_path_len = current_path_len + 1 # Length of path to new_pos\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, and it could potentially lead to a shorter path.\n        if new_pos not in visited and new_path_len + min_actions_to_complete_collection < min_total_actions_len:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  return shortest_path_actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T05:15:47.098296", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-02T05:16:39.177850", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # Helper to calculate the coordinates of the cell directly in front of the agent.\n  def _get_cell_in_front(pos: tuple[int, int], direction: int) -> tuple[int, int]:\n      x, y = pos\n      if direction == 0: # UP\n          return (x, y - 1)\n      elif direction == 1: # DOWN\n          return (x, y + 1)\n      elif direction == 2: # LEFT\n          return (x - 1, y)\n      elif direction == 3: # RIGHT\n          return (x + 1, y)\n      return pos # Should not happen with valid directions\n\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    return []\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Mapping from movement action ID to the new direction it sets the agent to face.\n  action_to_new_dir = {\n      ACTION_UP: 0,    # UP corresponds to direction 0\n      ACTION_DOWN: 1,  # DOWN corresponds to direction 1\n      ACTION_LEFT: 2,  # LEFT corresponds to direction 2\n      ACTION_RIGHT: 3, # RIGHT corresponds to direction 3\n  }\n\n  # Define possible directional movements (change in x, change in y) and their corresponding action IDs.\n  # Each move action implicitly sets the agent's facing direction.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Moves North (decreases Y), agent faces North (dir 0)\n      (0, 1, ACTION_DOWN),   # Moves South (increases Y), agent faces South (dir 1)\n      (-1, 0, ACTION_LEFT),  # Moves West (decreases X), agent faces West (dir 2)\n      (1, 0, ACTION_RIGHT),  # Moves East (increases X), agent faces East (dir 3)\n  ]\n\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # BFS Queue: stores (current_position (x, y), current_direction (int), list_of_actions_taken).\n  # The starting position and direction are taken from the current environment state.\n  q = collections.deque([(state.pos, state.dir, [])]) \n  \n  # Visited set: stores (position (x, y), direction (int)) to prevent redundant explorations\n  # for the same position-direction combination.\n  visited = {(state.pos, state.dir)} \n\n  # Classify the primitive type to determine the collection criteria.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Account for the \"BOUNDARY\" primitive which might not always be explicitly listed\n  # in `non_grabbable_indices` or `workshop_indices`.\n  boundary_idx = cookbook.index['BOUNDARY']\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (boundary_idx is not None and primitive_idx == boundary_idx))\n  \n  # Perform Breadth-First Search.\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    # Check if the current (position, direction) state satisfies the goal condition.\n    if is_grabbable:\n      # For grabbable items, the agent must be directly facing the item to use it.\n      # Calculate the coordinates of the cell the agent is currently looking at.\n      target_cell_for_use = _get_cell_in_front(current_pos, current_dir)\n      \n      # Ensure the cell being looked at is within grid boundaries.\n      if (0 <= target_cell_for_use[0] < WIDTH and \n          0 <= target_cell_for_use[1] < HEIGHT):\n        # Check if the primitive is present in the cell the agent is facing.\n        if grid[target_cell_for_use[0], target_cell_for_use[1], primitive_idx] > 0:\n          # If found, append the 'USE' action and return the complete sequence.\n          return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or other stationary primitives (like WATER, STONE, BOUNDARY),\n      # \"collecting\" means simply reaching the cell containing them. No 'USE' action needed.\n      # Check if the target primitive is present at the agent's current cell.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, return the movement actions.\n    \n    # If the goal is not met at the current state, explore valid, unvisited neighbors.\n    # Each movement action results in a new position AND a new facing direction.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n      new_dir = action_to_new_dir[action] # The agent's new direction after this move.\n\n      # Ensure the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this new (position, direction) combination has not been explored yet.\n        if (new_pos, new_dir) not in visited:\n          visited.add((new_pos, new_dir)) # Mark as visited.\n          # Enqueue the new state with the updated path.\n          q.append((new_pos, new_dir, current_actions + [action]))\n  \n  # If the BFS completes and the queue is empty, it means no path was found\n  # to collect the primitive from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T05:16:40.384262", "function_name": "collect", "function_body": "  # Get the current state from the environment, which contains all necessary information\n  # about the grid, agent's position, inventory, and references to world/scenario.\n  state = env._current_state\n  \n  # Access the cookbook from the world object to resolve primitive names to their integer IDs.\n  cookbook = env.world.cookbook\n  \n  # Get the current grid layout. The grid has dimensions (WIDTH, HEIGHT, n_kinds).\n  grid = state.grid\n  \n  # 1. Convert the string name of the primitive to its corresponding integer ID.\n  # If the primitive name is not found in the cookbook's index, it means it's an unknown\n  # item, and we cannot collect it. In this case, return an empty list of actions.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    return []\n\n  # 2. Map action names (e.g., \"UP\", \"USE\") to their integer IDs. This makes the code\n  # more readable and robust to changes in action ID assignments.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the possible movements (changes in x and y coordinates) and their\n  # corresponding action IDs. This list is used for exploring neighboring cells in BFS.\n  MOVE_DELTAS = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  # Get the dimensions of the grid for boundary checks during pathfinding.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # The agent's starting position for the Breadth-First Search (BFS).\n  start_pos = state.pos\n\n  # 3. Initialize BFS data structures:\n  # - q (queue): Stores tuples of (current_position (x, y), list_of_actions_taken_to_reach_here).\n  #   The BFS algorithm explores layer by layer, ensuring the first path found is the shortest.\n  q = collections.deque([(start_pos, [])]) \n  \n  # - visited: A set to keep track of (x, y) positions that have already been visited\n  #   and added to the queue. This prevents infinite loops in cycles and redundant exploration.\n  visited = {start_pos} \n\n  # 4. Classify the primitive type to determine the collection condition.\n  # The method of \"collecting\" (i.e., whether a 'USE' action is needed or just reaching the cell)\n  # depends on whether the item is grabbable, a workshop, or a fixed environmental feature.\n  \n  # Grabbable items (e.g., WOOD, IRON) require the agent to be adjacent to them and then 'USE' them.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Workshop stations (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2) and other fixed\n  # environmental features (e.g., WATER, STONE, BOUNDARY) are 'collected' by\n  # simply reaching the cell they occupy.\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for static environmental features. `cookbook.index['BOUNDARY']` might return None\n  # if 'BOUNDARY' is not explicitly defined in the current set of indexed kinds, so check for it.\n  boundary_idx = cookbook.index['BOUNDARY']\n  is_stationary_feature = (primitive_idx == env.world.water_index or \n                           primitive_idx == env.world.stone_index or \n                           (boundary_idx is not None and primitive_idx == boundary_idx))\n  \n  # 5. Execute the Breadth-First Search.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary `CraftState` object at the `current_pos`. This is a crucial step\n    # because `CraftState` methods like `next_to` or direct grid access depend on the\n    # agent's current simulated position (`current_pos` in this loop). We pass the\n    # original `scenario`, `grid`, `dir`, and `inventory` as they are considered constant\n    # for pathfinding purposes (only position changes).\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal to 'collect' the primitive.\n    # Since BFS finds the shortest path, the first path found is the optimal one.\n    if is_grabbable:\n      # For grabbable items, if the agent is next to the primitive, then a 'USE' action\n      # needs to be appended to the path.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_feature:\n      # For workshops and stationary features, the agent simply needs to be on the cell\n      # containing the primitive. No 'USE' action is typically required for these.\n      # We check if the primitive_idx is present at the current grid cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, return the movement actions.\n    \n    # If the goal is not met at the `current_pos`, explore its unvisited neighbors.\n    for dx, dy, action in MOVE_DELTAS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the `new_pos` is within the valid boundaries of the grid.\n      if 0 <= new_x < GRID_WIDTH and 0 <= new_y < GRID_HEIGHT:\n        # If this new position has not been visited before, add it to the queue\n        # for future exploration and mark it as visited.\n        if new_pos not in visited:\n          visited.add(new_pos) # Mark as visited to avoid cycles.\n          q.append((new_pos, current_actions + [action])) # Enqueue with the path leading to it.\n  \n  # If the BFS completes and the queue becomes empty, it means no path to the\n  # target primitive was found from the starting position within the reachable grid.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T05:18:07.823512", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state (static for pathfinding within this call)\n  \n  # 1. Get the integer ID for the primitive from the cookbook index\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings for easier use and readability\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine properties of the target primitive to apply correct collection logic\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  # Stationary primitives like water, stone, boundary are \"collected\" by being at their location.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Optimization: If the primitive is grabbable and already in inventory, \n  # no collection actions are needed. The item is already considered \"collected\".\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Precompute all locations of the primitive on the grid for heuristic calculation\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive does not exist on the map, no path can be found.\n  if not primitive_locations:\n      return []\n\n  # Heuristic function (Manhattan distance to the closest primitive location)\n  def h_score(pos: tuple[int, int]) -> int:\n    min_dist = float('inf')\n    for p_loc_x, p_loc_y in primitive_locations:\n      dist = abs(pos[0] - p_loc_x) + abs(pos[1] - p_loc_y)\n      min_dist = min(min_dist, dist)\n    return min_dist\n\n  # Define direction vectors for calculating the cell in front of the agent.\n  # Maps internal direction integer (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT) to (dx, dy) changes.\n  DIR_VECTORS = {\n      0: (0, -1), # UP: (x, y-1)\n      1: (0, 1),  # DOWN: (x, y+1)\n      2: (-1, 0), # LEFT: (x-1, y)\n      3: (1, 0)   # RIGHT: (x+1, y)\n  }\n\n  def _can_collect_from_state(\n      current_pos: tuple[int, int], current_dir: int\n  ) -> tuple[bool, list[int]]:\n    \"\"\"\n    Internal helper: Checks if the target primitive can be collected from the given\n    agent position and direction, and returns the necessary final actions.\n    \n    Args:\n        current_pos (tuple[int, int]): Agent's current (x, y) position.\n        current_dir (int): Agent's current direction (0=UP, 1=DOWN, etc.).\n        \n    Returns:\n        tuple[bool, list[int]]: (True, [actions]) if collectable, else (False, []).\n    \"\"\"\n    if is_grabbable:\n      # For grabbable items, agent must be adjacent and facing the item to USE.\n      dx, dy = DIR_VECTORS[current_dir]\n      fwd_x, fwd_y = current_pos[0] + dx, current_pos[1] + dy\n      \n      # Check if the cell directly in front is within grid boundaries and contains the primitive.\n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT:\n        if grid[fwd_x, fwd_y, primitive_idx] > 0:\n          return True, [ACTION_USE] # The 'USE' action is required here.\n\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means simply being at their location.\n      # Check if the target primitive is present at the agent's current cell.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return True, [] # No additional 'USE' action is typically needed.\n            \n    return False, []\n\n  # A* search setup:\n  # Priority Queue: Stores (f_score, g_score, (pos, dir), actions_list)\n  # f_score: g_score + h_score (estimated total cost)\n  # g_score: cost from start to current state (number of movement actions)\n  # The g_score is used as a tie-breaker in heapq to prefer shorter paths when f_scores are equal.\n  \n  # g_scores: dictionary mapping (pos, dir) state to the minimum cost (g_score) to reach it.\n  g_scores = {}\n  \n  start_pos = state.pos\n  start_dir = state.dir\n  start_state_key = (start_pos, start_dir)\n\n  g_scores[start_state_key] = 0\n  f_start = h_score(start_pos) # Heuristic for initial position\n  \n  # Priority queue: (f_score, g_score, state_key, actions_list)\n  open_set = [(f_start, 0, start_state_key, [])]\n\n  min_path_len = float('inf') # Stores the length of the shortest *complete* path found so far.\n  best_path_actions = []     # Stores the actions for the shortest *complete* path.\n\n  # A* loop\n  while open_set:\n    f_current, g_current, current_state_key, current_actions = heapq.heappop(open_set)\n    current_pos, current_dir = current_state_key\n\n    # If we already found a shorter path to this (pos, dir) state, skip processing it again.\n    # This acts as the 'closed set' for A* and ensures we process each state optimally.\n    if g_current > g_scores.get(current_state_key, float('inf')):\n        continue\n\n    # Pruning optimization: If the current path length already equals or exceeds\n    # the shortest *complete* path found so far, this path cannot be optimal.\n    # This helps terminate early if a good path has already been identified.\n    if len(current_actions) >= min_path_len:\n        continue\n\n    # --- Check for Goal Satisfaction at Current State ---\n    can_collect_from_here, actions_to_finalize_collection = _can_collect_from_state(\n        current_pos, current_dir\n    )\n    \n    if can_collect_from_here:\n      total_actions = current_actions + actions_to_finalize_collection\n      # If this complete path (current_actions + final collection action) is shorter, update.\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # It's crucial NOT to return here. A* finds the shortest path to a *state*.\n      # But our goal (collecting) might be achievable from multiple states via different\n      # final actions. We need to explore all paths until the shortest total path is confirmed.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # Simulate the effect of taking 'action_type' from the current A* node's state.\n      # Create a temporary CraftState to apply the environment's `step` logic.\n      # The grid and inventory remain constant for pathfinding on the current map.\n      temp_state_for_step = craft.CraftState(\n          state.scenario, state.grid, current_pos, current_dir, state.inventory\n      )\n      \n      # Perform the movement action on the temporary state.\n      # The reward is not relevant for pathfinding, only the resulting new_state.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n      new_state_key = (new_pos, new_dir)\n\n      # Cost to reach new_state_key from start is g_current + 1 (for the movement action).\n      tentative_g_score = g_current + 1 \n\n      # If this new path to new_state_key is shorter than any previously found path to it\n      if tentative_g_score < g_scores.get(new_state_key, float('inf')):\n        g_scores[new_state_key] = tentative_g_score\n        f_score = tentative_g_score + h_score(new_pos)\n        \n        # Add the new state to the open set (priority queue)\n        heapq.heappush(open_set, (f_score, tentative_g_score, new_state_key, current_actions + [action_type]))\n  \n  return best_path_actions", "island_id": 1, "scores": {"3": -1}}
