{"timestamp": "2025-08-02T01:21:16.789934", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  \n  # Map the primitive's string name to its unique integer ID.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's an unknown item.\n    return []\n\n  # Retrieve action codes for movement and 'USE' from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Identify entity indices that represent impassable terrain.\n  # In CraftWorld, 'WATER' and 'BOUNDARY' typically block movement.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a cell is within grid bounds and traversable.\n  def is_traversable(x: int, y: int) -> bool:\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of bounds\n    \n    # Check if any impassable kind is present at this cell.\n    for idx in impassable_kind_indices:\n      if grid[x, y, idx] == 1:\n        return False  # Cell contains an obstacle\n    return True\n\n  # Locate all occurrences of the target primitive on the grid.\n  # np.argwhere returns (x, y) coordinates for non-zero elements.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not found on the grid, it cannot be collected.\n    return []\n\n  # Helper function: Check if a given position is adjacent to any of the target locations.\n  # Adjacency is defined as Chebyshev distance <= 1 (3x3 neighborhood).\n  def is_adjacent_to_any_target(current_pos, target_locations):\n    curr_x, curr_y = current_pos\n    for target_x, target_y in target_locations:\n      if max(abs(curr_x - target_x), abs(curr_y - target_y)) <= 1:\n        return True\n    return False\n\n  # --- Initial Check: Is the agent already adjacent to the primitive? ---\n  # If so, a single 'USE' action is sufficient.\n  if is_adjacent_to_any_target(agent_pos, primitive_locations_on_grid):\n    return [USE]\n\n  # --- Breadth-First Search (BFS) for Shortest Pathfinding ---\n  # Queue stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set prevents infinite loops and redundant exploration.\n  visited = {agent_pos}\n\n  # Define the (dx, dy) for each movement action.\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue current position and its path.\n\n    # Explore all four cardinal neighbors.\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate coordinates of the neighbor.\n      new_position = (nx, ny)\n\n      # Check if the neighbor is valid (traversable) and not yet visited.\n      if is_traversable(nx, ny) and new_position not in visited:\n        new_path_actions = path_actions + [action_type] # Append the action to the path.\n        \n        # Check if this new position is adjacent to any primitive location.\n        if is_adjacent_to_any_target(new_position, primitive_locations_on_grid):\n          # If an adjacent position is found, append 'USE' and return the complete path.\n          # BFS guarantees this is the shortest sequence of movement actions.\n          return new_path_actions + [USE]\n        else:\n          # If not yet adjacent, add this new position to the queue for further exploration\n          # and mark it as visited.\n          visited.add(new_position)\n          queue.append((new_position, new_path_actions))\n        \n  # If the BFS completes and the queue is empty without finding a path,\n  # the primitive is unreachable from the current agent position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:21:17.973572", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (agent_x, agent_y)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get action integer mappings for movement and the 'USE' action.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # 3. Identify truly impassable terrain kinds.\n  # In CraftWorld, 'WATER' and 'BOUNDARY' are typically impassable (cannot be walked on).\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function: Check if a grid position is valid and traversable.\n  def is_traversable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of grid bounds\n    \n    # Check if the cell contains any impassable obstacle.\n    # Note: `grid[x, y, idx]` is 1 if that kind is present, 0 otherwise.\n    for impassable_idx in impassable_kind_indices:\n      if grid[x, y, impassable_idx] == 1:\n        return False\n    return True\n\n  # Helper function: Check if a given position is adjacent to any of a list of target locations.\n  # Adjacency here means Chebyshev distance (max of dx, dy) <= 1, which covers 8-directional neighborhood.\n  def is_adjacent_to_any_target(current_pos, target_locations):\n    curr_x, curr_y = current_pos\n    for target_x, target_y in target_locations:\n      if max(abs(curr_x - target_x), abs(curr_y - target_y)) <= 1:\n        return True\n    return False\n\n  # 4. Find all grid locations where the desired primitive is present.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # 5. Initial check: Is the agent already adjacent to the primitive?\n  # If so, only the 'USE' action is needed.\n  if is_adjacent_to_any_target(agent_pos, primitive_locations_on_grid):\n    return [USE]\n\n  # 6. Breadth-First Search (BFS) for pathfinding to an adjacent cell.\n  queue = collections.deque([(agent_pos, [])]) # Stores ((x, y), [actions_to_reach_here])\n  visited = {agent_pos} # Stores (x, y) tuples to prevent revisiting nodes\n\n  # Define possible movement directions (dx, dy) corresponding to actions.\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft()\n\n    # Explore all four neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate new potential position\n\n      # Check if the new position is traversable and has not been visited yet.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_position = (nx, ny)\n        new_path_actions = path_actions + [action_type]\n        \n        # Check if this new position is adjacent to any primitive location.\n        if is_adjacent_to_any_target(new_position, primitive_locations_on_grid):\n          # Path found to a cell from which 'USE' can be applied.\n          # BFS guarantees this is the shortest path.\n          return new_path_actions + [USE]\n        else:\n          # Not yet adjacent, add this new position to the queue for further exploration.\n          visited.add(new_position)\n          queue.append((new_position, new_path_actions))\n        \n  # 7. If BFS completes without finding a path, the primitive is unreachable.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:21:40.853665", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n\n  # Improvement 1: Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Improvement 2 (already present in v1, but good to re-state the logic):\n  # Check if the primitive is actually a grabbable item.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner (picked up into inventory), so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Grid and position details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # This function checks the static grid for the primitive's location relative to check_pos\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:21:42.130332", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # 1. Improvement for collect_v2 (re-introduced from collect_v0):\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 2. Check if the primitive is actually a grabbable item (from collect_v1).\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Grid and position details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:22:41.982653", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-02T01:22:43.148122", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    This function finds the shortest path for the agent to reach and collect\n    a specified primitive item in the CraftLab environment. It uses Breadth-First Search (BFS)\n    to navigate the grid, considering obstacles and valid interaction ranges.\n\n    The strategy involves:\n    1. Identifying the integer ID for the target primitive.\n    2. Locating all instances of the primitive on the grid.\n    3. Performing a BFS from the agent's current position to find the shortest\n       sequence of movement actions that lead to a cell from which the 'USE'\n       action can successfully collect the primitive.\n    4. Appending a 'USE' action to the found path.\n\n    Obstacles: The BFS considers certain non-grabbable entities (e.g., 'BOUNDARY')\n    as impassable, while others (e.g., 'WORKSHOP', 'WATER') are traversable\n    interaction points. The primitive itself is traversable for movement but is\n    the target for the 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The string name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A list of integer action IDs representing the shortest path\n                   to collect the primitive, ending with a 'USE' action.\n                   Returns an empty list if the primitive is not found or is unreachable.\n  \"\"\"\n\n  # Helper function to check if a grid position is impassable for movement.\n  def _is_position_impassable(x: int, y: int, grid: np.ndarray, world_config: craft.CraftWorld, target_primitive_idx: int) -> bool:\n      \"\"\"\n      Checks if a given grid position (x, y) is traversable by the agent.\n      \n      Args:\n          x (int): The x-coordinate of the position to check.\n          y (int): The y-coordinate of the position to check.\n          grid (np.ndarray): The current grid state.\n          world_config (craft.CraftWorld): The world configuration for obstacle definitions.\n          target_primitive_idx (int): The index of the primitive being collected.\n      \n      Returns:\n          bool: True if the position is impassable, False otherwise.\n      \"\"\"\n      grid_width, grid_height, num_kinds = grid.shape\n\n      # 1. Check if the position is out of grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return True # Out of bounds is always impassable.\n\n      # 2. Check entities present at the position for impassability.\n      # Iterate through all 'kinds' (layers) at the given cell.\n      # If any kind at this cell makes it impassable, the cell is impassable.\n      for k_idx in range(num_kinds):\n          # If something of kind `k_idx` is present at (x, y)\n          if grid[x, y, k_idx] > 0: \n              # The target primitive itself is always traversable for movement.\n              # We need to be able to pathfind *through* the primitive if necessary,\n              # or at least onto it, to use it.\n              if k_idx == target_primitive_idx:\n                  continue \n              \n              # Check if it's a non-grabbable entity.\n              if k_idx in world_config.non_grabbable_indices:\n                  # Special non-grabbable entities like workshops and water are traversable.\n                  if k_idx in world_config.workshop_indices or k_idx == world_config.water_index:\n                      continue\n                  else:\n                      # Any other non-grabbable entity (e.g., 'BOUNDARY') is an obstacle.\n                      return True\n      return False # No impassable entity found at this position.\n\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name does not correspond to a known item, it cannot be collected.\n      return [] \n\n  # 2. Extract crucial information from the current environment state.\n  state = env._current_state\n  initial_pos = state.pos\n  grid = state.grid\n  grid_width, grid_height, _ = grid.shape\n  world_config = env.world # Reference to CraftWorld instance for obstacle definitions\n\n  # 3. Obtain the integer mappings for movement and interaction actions.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down, action_id\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up, action_id\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left, action_id\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right, action_id\n  ]\n\n  # 4. Identify all grid locations where the target primitive exists.\n  # This list helps in determining potential targets for collection.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # A primitive is considered present if its count at (x, y) is greater than 0.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If no instances of the primitive are found on the map, no collection is possible.\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # The 'visited' set keeps track of positions already explored to prevent cycles.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is within the effective range for the 'USE' action.\n      # The 'USE' action can collect items in a 3x3 square centered on the agent's current position.\n      # This means the target primitive must be at Chebyshev distance <= 1 from the agent.\n      is_within_use_range = False\n      for px, py in primitive_locations:\n          # If the agent's current position (cx, cy) is adjacent to or on the same spot as\n          # a primitive location (px, py), then 'USE' can be performed.\n          if max(abs(cx - px), abs(cy - py)) <= 1:\n              is_within_use_range = True\n              break \n      \n      if is_within_use_range:\n          # If a position from which the primitive can be 'USED' is found,\n          # append the 'USE' action to the path and return the complete sequence.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Use the helper function to determine if the next position is impassable.\n          # This handles both out-of-bounds and obstacle checks.\n          if _is_position_impassable(next_x, next_y, grid, world_config, primitive_idx):\n              continue # Skip this next position if it's blocked by an obstacle or out of bounds.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path) # Create a new path list for this branch to avoid modifying shared references.\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS completes and the queue becomes empty without finding a path\n  # to a collectable position, it means the primitive is unreachable from the current state.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:23:12.217850", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # === New in v2: Early return if grabbable item is already in inventory ===\n  # If the primitive is grabbable and the agent already has it, no actions are needed.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n  # =========================================================================\n\n  # BFS setup\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_to_reach_here)\n  # Agent's direction is crucial because the 'USE' action is direction-sensitive.\n  q = collections.deque([(state.pos, state.dir, [])]) \n  # Visited set tracks (position, direction) pairs to prevent cycles and redundant exploration.\n  visited = {(state.pos, state.dir)} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # BFS loop\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    # Optimization: If the current path length is already greater than or equal to the\n    # shortest path found so far, there's no need to explore this path further.\n    if len(current_actions) >= min_path_len:\n        continue\n\n    # Check if this (current_pos, current_dir) state allows for goal completion\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to face the item and then USE.\n      # Calculate the cell coordinates in front of the agent based on current_dir.\n      fwd_x, fwd_y = current_pos\n      if current_dir == 0: # UP\n        fwd_y -= 1\n      elif current_dir == 1: # DOWN\n        fwd_y += 1\n      elif current_dir == 2: # LEFT\n        fwd_x -= 1\n      elif current_dir == 3: # RIGHT\n        fwd_x += 1\n      \n      # Check if the cell in front is within grid bounds and contains the primitive\n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT:\n        if grid[fwd_x, fwd_y, primitive_idx] > 0:\n          is_goal_reached = True\n          actions_to_complete_goal = [ACTION_USE] # Appending USE action to complete collection\n\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell where the agent is.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      # If this path (including final collection action) is shorter than the best found so far, update it.\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Continue BFS: Do not break prematurely. BFS finds the shortest path to any\n      # particular *node*. Our \"goal\" might be a condition (like facing and using an item)\n      # that can be satisfied from multiple nodes (different (pos, dir) states). A longer\n      # path to an earlier node might yield a shorter *total* path if the final action\n      # sequence (e.g., USE) is included.\n\n    # Explore neighbors by simulating movement actions (UP, DOWN, LEFT, RIGHT)\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # To correctly simulate the next state (position and direction), we must use\n      # CraftState.step, as it handles the environment's internal logic for movements\n      # (e.g., how direction changes after a turn or movement, collision handling).\n      \n      # Create a temporary CraftState reflecting the current BFS node's (pos, dir).\n      # The grid and inventory remain constant for pathfinding on the current map within one collect call.\n      temp_state_for_step = craft.CraftState(\n          state.scenario, state.grid, current_pos, current_dir, state.inventory\n      )\n      \n      # Perform the movement action on the temporary state.\n      # The reward value returned by step is not relevant for pathfinding here.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir)\n\n      # If this new (position, direction) state has not been visited yet, add it to the queue\n      # for further exploration and mark it as visited.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_actions + [action_type]))\n  \n  return best_path_actions", "island_id": 1, "scores": {"3": 1.0}}
