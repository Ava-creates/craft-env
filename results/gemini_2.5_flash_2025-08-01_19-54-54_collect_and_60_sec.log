{"timestamp": "2025-08-02T08:00:52.758642", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  inventory = state.inventory \n\n  # 1. Resolve the primitive name to its integer ID\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is already in the agent's inventory,\n  # and it is a grabbable item, then no actions are needed.\n  # Non-grabbable items like workshops or environmental features are not held in inventory.\n  if primitive_idx in env.world.grabbable_indices and inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings from the environment's action specifications\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Used for interacting with grabbable items or workshops\n\n  # 4. Define possible movement actions relative to the agent's position\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # 5. Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Initialize BFS (Breadth-First Search)\n  # q: Stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n  # visited: Keeps track of grid positions already explored to prevent cycles and redundant paths\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # 7. Categorize the target primitive based on how it's \"collected\".\n  # This determines the success condition and any final action required.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_non_grabbable = primitive_idx in env.world.non_grabbable_indices\n  \n  # 8. BFS search loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's methods (like `next_to`) from this specific grid cell,\n    # without actually changing the environment's state. Agent's direction and inventory are\n    # passed as-is, as they don't affect the spatial pathfinding for the primitive itself.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current_pos represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # BFS guarantees finding the shortest path to an adjacent cell.\n        # Append the 'USE' action to complete the collection.\n        return current_actions + [ACTION_USE]\n    elif is_non_grabbable:\n      # For non-grabbable items (e.g., workshops, water, stone, boundary),\n      # \"collecting\" means simply reaching the cell where they are located.\n      # Check if the target primitive is present at the current cell's location in the grid.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # This is the shortest path to a cell containing the primitive.\n        return current_actions # No additional 'USE' action needed; reaching is enough.\n    \n    # Explore valid neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      # And ensure we don't re-visit already explored positions to guarantee shortest path and prevent infinite loops\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT and new_pos not in visited:\n        visited.add(new_pos)\n        q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and no path to the primitive was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:01:46.268231", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # BFS guarantees the shortest path to `current_pos`.\n        # Therefore, `current_actions + [ACTION_USE]` is the shortest action sequence to collect the item.\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # BFS guarantees the shortest path to `current_pos`.\n        # This is the shortest path to the primitive's location, so return immediately.\n        return current_actions # No USE action is typically needed for these\n    \n    # If goal not met at current_pos, explore neighbors\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:01:47.461157", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Improvement 1: Check if the primitive is already in the inventory.\n  # If the agent possesses at least one unit of the primitive, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Improvement 2: More robust classification for stationary resources.\n  # A resource is considered \"stationary\" (meaning you need to reach its cell\n  # but not necessarily 'USE' it in the same way as grabbable items)\n  # if it's in the non-grabbable set and not classified as a workshop.\n  is_stationary_resource = False\n  if primitive_idx in env.world.non_grabbable_indices:\n      if not is_workshop: # Workshops are also non-grabbable but might have distinct purpose\n          is_stationary_resource = True\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop:\n      # For workshops, \"collecting\" typically means reaching the location itself.\n      # Check if the target primitive (workshop) is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for workshops\n    elif is_stationary_resource:\n        # For other stationary resources (e.g., WATER, STONE, BOUNDARY),\n        # \"collecting\" also means reaching the location itself.\n        if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n            is_goal_reached = True\n            actions_to_complete_goal = [] # No USE action needed\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Continue BFS. This ensures that even if a path to an adjacent cell (for grabbables)\n      # is found first, a path to a standing-on cell (for workshops/stationary)\n      # which might be shorter in total actions is also considered.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:02:39.350038", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-02T08:02:40.540033", "function_name": "collect", "function_body": "  initial_state = env._current_state # Get the agent's current state\n  world = env.world                  # Access the CraftWorld configuration\n  cookbook = world.cookbook          # Access recipe and item information\n  grid = initial_state.grid          # The grid layout is static for pathfinding within this call\n\n  # 1. Map primitive name to its integer ID and validate\n  primitive_idx = cookbook.index[primitive]\n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Define action codes for clarity, using the environment's action_specs\n  action_codes = env.action_specs()\n  ACTION_UP = action_codes['UP']\n  ACTION_DOWN = action_codes['DOWN']\n  ACTION_LEFT = action_codes['LEFT']\n  ACTION_RIGHT = action_codes['RIGHT']\n  ACTION_USE = action_codes['USE']\n\n  # 3. Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 4. Classify the target primitive type to determine collection rules\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_workshop = primitive_idx in world.workshop_indices\n  is_stationary = (primitive_idx == world.water_index or \n                   primitive_idx == world.stone_index or \n                   primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # 5. Optimization: Early exit if a grabbable item is already possessed\n  # If the agent already has a grabbable item, no collection actions are needed.\n  if is_grabbable and initial_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 6. Helper function: Determine if collection is possible from a given agent state (pos, dir)\n  def _can_collect_here(pos: tuple[int, int], direction: int) -> tuple[bool, list[int]]:\n    \"\"\"\n    Checks if the target primitive can be collected from the agent's current position and direction.\n    Returns (True, [required_actions]) if collectable, else (False, []).\n    \"\"\"\n    if is_grabbable:\n      # For grabbable items, the agent must be adjacent to and facing the item to 'USE' it.\n      fwd_x, fwd_y = pos\n      if direction == 0: fwd_y -= 1 # UP (0)\n      elif direction == 1: fwd_y += 1 # DOWN (1)\n      elif direction == 2: fwd_x -= 1 # LEFT (2)\n      elif direction == 3: fwd_x += 1 # RIGHT (3)\n      \n      # Check if the cell directly in front is within grid bounds and contains the primitive.\n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT and grid[fwd_x, fwd_y, primitive_idx] > 0:\n        return True, [ACTION_USE] # Requires a 'USE' action to pick it up.\n    \n    elif is_workshop or is_stationary:\n      # For workshops or stationary primitives (water, stone, boundary),\n      # \"collecting\" means simply being present on the same cell.\n      if grid[pos[0], pos[1], primitive_idx] > 0:\n        return True, [] # No additional action required (no 'USE').\n            \n    return False, []\n\n  # 7. BFS Initialization\n  # Queue: Stores (current_position_tuple, current_direction_int, path_taken_to_reach_here_list)\n  # The agent's direction is a critical part of the state due to direction-sensitive actions.\n  q = collections.deque([(initial_state.pos, initial_state.dir, [])]) \n  \n  # Visited set: Tracks (position_tuple, direction_int) pairs to prevent cycles and redundant exploration.\n  visited = {(initial_state.pos, initial_state.dir)} \n\n  # Variables to store the shortest path found. Initialize with infinite length.\n  min_path_length = float('inf')\n  best_path_actions = []\n\n  # 8. BFS Loop: Explore states layer by layer to find the shortest path\n  while q:\n    current_pos, current_dir, current_path = q.popleft()\n\n    # Pruning: If the current path's length is already equal to or greater than\n    # the shortest path found so far, then this branch cannot lead to a shorter overall path.\n    if len(current_path) >= min_path_length:\n      continue\n\n    # Check if the goal (collecting the primitive) can be satisfied from the current state (pos, dir)\n    is_goal_collectable, final_collection_actions = _can_collect_here(current_pos, current_dir)\n    \n    if is_goal_collectable:\n      total_actions = current_path + final_collection_actions\n      # If this combined path (movement sequence + final collection action) is shorter, update the best.\n      if len(total_actions) < min_path_length:\n        min_path_length = len(total_actions)\n        best_path_actions = total_actions\n      # IMPORTANT: Do NOT `return` here prematurely. BFS finds the shortest path to a *state*.\n      # However, our \"goal\" is a condition (e.g., collectable item) which might be met from\n      # multiple (pos, dir) states. A longer path to one (pos, dir) might still result in a\n      # shorter *total* action sequence if it requires fewer `final_collection_actions`.\n      # We must continue exploring all paths to guarantee the globally shortest path.\n\n    # Explore neighboring states by simulating movement actions (UP, DOWN, LEFT, RIGHT).\n    for action_code in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # To accurately simulate the next state (position and direction), we must use\n      # CraftState.step. We create a temporary CraftState reflecting the current BFS node's state.\n      # The grid and inventory remain constant for pathfinding on the current map within one collect call.\n      temp_state = craft.CraftState(\n          initial_state.scenario, initial_state.grid, current_pos, current_dir, initial_state.inventory\n      )\n      \n      # Simulate the movement step. CraftState.step returns a *new* state object.\n      # The reward is not relevant for pathfinding.\n      _, next_simulated_state = temp_state.step(action_code)\n      \n      next_pos = next_simulated_state.pos\n      next_dir = next_simulated_state.dir\n\n      next_state_tuple = (next_pos, next_dir) # Define the state for visited tracking.\n\n      # If this new (position, direction) state has not been visited, add it to the queue.\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        q.append((next_pos, next_dir, current_path + [action_code]))\n  \n  # 9. Return the shortest path found. If no path was reachable, best_path_actions remains an empty list.\n  return best_path_actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-02T08:03:11.757370", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos  # Agent's (x, y) tuple position\n  cookbook = env.world.cookbook\n  \n  # 1. Map the primitive name to its integer ID using the cookbook's index.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Get integer mappings for all relevant actions from the environment's action space.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement actions and their corresponding (dx, dy) deltas.\n  # These are used for BFS exploration on the grid.\n  movement_actions_map = {\n      ACTION_UP: (0, -1),   # Moving UP decreases Y-coordinate\n      ACTION_DOWN: (0, 1),    # Moving DOWN increases Y-coordinate\n      ACTION_LEFT: (-1, 0),   # Moving LEFT decreases X-coordinate\n      ACTION_RIGHT: (1, 0),   # Moving RIGHT increases X-coordinate\n  }\n\n  # 3. Get grid dimensions (width, height, number of kinds).\n  grid_width, grid_height, _ = grid.shape\n\n  # 4. Identify terrain types that block agent movement.\n  # In CraftWorld, \"WATER\" and \"BOUNDARY\" are typically impassable obstacles.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function: Determines if a given grid cell is within bounds and traversable.\n  def is_traversable(x: int, y: int) -> bool:\n    # Check if coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell contains any impassable kind.\n    # A cell is blocked if it contains *any* of the impassable_kind_indices.\n    for impassable_idx in impassable_kind_indices:\n      if grid[x, y, impassable_idx] == 1: # If this specific impassable kind is present at (x,y)\n        return False\n    return True\n\n  # 5. Locate all instances of the target primitive on the grid.\n  # np.argwhere returns a list of (x, y) coordinates where the condition is true.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not found anywhere on the grid, it's impossible to collect it.\n    return []\n\n  # 6. Pre-calculate all grid cells from which the agent can successfully `USE`\n  # to collect the target primitive. An agent can `USE` a primitive if it's in an\n  # adjacent cell (including diagonals, i.e., Chebyshev distance <= 1).\n  valid_use_spots = np.full((grid_width, grid_height), False, dtype=bool)\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive location.\n    for dx_use in [-1, 0, 1]:\n      for dy_use in [-1, 0, 1]:\n        ux, uy = px + dx_use, py + dy_use # Candidate position for the agent to stand on\n        \n        # Mark (ux, uy) as a valid `USE` spot if it's within grid bounds\n        # AND it is a traversable cell for the agent.\n        if is_traversable(ux, uy):\n          valid_use_spots[ux, uy] = True\n  \n  # If after checking all primitive locations, no traversable \"use\" spots are found,\n  # it means the primitive is effectively unreachable (e.g., surrounded by water).\n  if not np.any(valid_use_spots):\n    return []\n\n  # 7. Initial Check: Is the agent already positioned on a `valid_use_spot`?\n  # If so, the only action needed is 'USE'. This is the most efficient scenario.\n  if valid_use_spots[agent_pos[0], agent_pos[1]]:\n    return [ACTION_USE]\n\n  # 8. Pathfinding using Breadth-First Search (BFS).\n  # BFS finds the shortest path in an unweighted graph (our grid).\n  # The queue stores tuples: ((current_x, current_y), list_of_actions_taken_to_reach_here).\n  bfs_queue = collections.deque([(agent_pos, [])])\n  \n  # `visited_cells` set keeps track of grid cells already added to the queue to prevent cycles\n  # and redundant exploration, ensuring the shortest path is found first.\n  visited_cells = {agent_pos} \n  \n  while bfs_queue:\n    (current_x, current_y), actions_to_current = bfs_queue.popleft()\n\n    # Explore all four possible cardinal movement directions from the current cell.\n    for action_type, (dx, dy) in movement_actions_map.items():\n      next_x, next_y = current_x + dx, current_y + dy  # Calculate potential next position\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is traversable and has not been visited yet.\n      if is_traversable(next_x, next_y) and next_pos not in visited_cells:\n        \n        # If the next position is a `valid_use_spot`, a path has been found.\n        # Since this is BFS, this path is guaranteed to be the shortest.\n        if valid_use_spots[next_x, next_y]:\n          # Return the actions to reach `next_pos`, followed by the `ACTION_USE`.\n          return actions_to_current + [action_type, ACTION_USE] \n        else:\n          # If `next_pos` is not a `valid_use_spot` yet, add this new position to the queue\n          # for further exploration and mark it as visited.\n          visited_cells.add(next_pos)\n          bfs_queue.append((next_pos, actions_to_current + [action_type]))\n        \n  # 9. If the BFS completes and no path to a `valid_use_spot` was found,\n  # it means the primitive is unreachable from the agent's current position under current conditions.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:03:12.901977", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos  # (agent_x, agent_y)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive from the cookbook's index.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Get action integer mappings for movement and the 'USE' action.\n  action_map = env.action_specs()\n  \n  # Define movement actions and their corresponding (dx, dy) deltas for BFS.\n  movement_actions = {\n      action_map['UP']: (0, -1),   # (dx, dy) for moving Up (decreases Y)\n      action_map['DOWN']: (0, 1),    # (dx, dy) for moving Down (increases Y)\n      action_map['LEFT']: (-1, 0),   # (dx, dy) for moving Left (decreases X)\n      action_map['RIGHT']: (1, 0),   # (dx, dy) for moving Right (increases X)\n  }\n  ACTION_USE = action_map['USE']\n\n  # 3. Get grid dimensions.\n  grid_width, grid_height, _ = grid.shape\n\n  # 4. Identify impassable terrain kinds (e.g., water, boundary).\n  # These are grid cells that the agent cannot traverse.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # 5. Helper function: Check if a grid position is valid (within bounds) and traversable.\n  def is_traversable(x: int, y: int) -> bool:\n    # Check if the coordinates are within the grid boundaries.\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n    \n    # Check if the cell at (x, y) contains any impassable obstacle.\n    for impassable_idx in impassable_kind_indices:\n      if grid[x, y, impassable_idx] == 1: # If this impassable kind is present at (x,y)\n        return False\n    return True\n\n  # 6. Find all grid locations where the desired primitive is present.\n  # `np.argwhere` returns a list of (row, col) coordinates where the condition is true.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected from the grid.\n    return []\n\n  # 7. Pre-calculate all valid 'target' squares for the agent.\n  # These are the squares an agent can move to, and then successfully perform 'USE' to collect the primitive.\n  # A target square is any traversable cell within the 3x3 neighborhood (Chebyshev distance <= 1)\n  # of any primitive location on the grid.\n  valid_use_spots_map = np.full((grid_width, grid_height), False, dtype=bool)\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood (including the primitive's own cell)\n    for dx_offset in [-1, 0, 1]:\n      for dy_offset in [-1, 0, 1]:\n        ux, uy = px + dx_offset, py + dy_offset # Potential square for the agent to stand on\n        \n        # Mark as a valid `USE` spot if it's within bounds and traversable by the agent.\n        if is_traversable(ux, uy):\n          valid_use_spots_map[ux, uy] = True\n  \n  # 8. Initial Check: Is the agent already positioned on a `valid_use_spot`?\n  # If so, the only action needed is 'USE'.\n  if valid_use_spots_map[agent_pos[0], agent_pos[1]]:\n    return [ACTION_USE]\n\n  # 9. Breadth-First Search (BFS) for pathfinding.\n  # The goal is to find the shortest path from the agent's current position\n  # to any cell (nx, ny) that is marked as a `valid_use_spot`.\n  \n  # The queue stores tuples: ((current_x, current_y), [list_of_actions_to_reach_here]).\n  bfs_queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting nodes and ensure shortest path.\n  visited = {agent_pos}\n\n  while bfs_queue:\n    (cx, cy), path_actions = bfs_queue.popleft() # Get current position and path to it\n\n    # Explore all four cardinal neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in movement_actions.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the new potential position\n      next_pos = (nx, ny)\n\n      # Check if the new position is valid (traversable and not yet visited).\n      if is_traversable(nx, ny) and next_pos not in visited:\n        \n        # Form the new path to this potential position.\n        new_path_actions = path_actions + [action_type]\n        \n        # Check if this new position (nx, ny) is one of our pre-calculated valid use spots.\n        if valid_use_spots_map[nx, ny]:\n          # If it is, we've found the shortest path to a valid 'use' location.\n          # Append the 'USE' action and return the complete sequence.\n          return new_path_actions + [ACTION_USE]\n        else:\n          # If not yet a target spot, add this new position to the queue for further exploration.\n          visited.add(next_pos)\n          bfs_queue.append((next_pos, new_path_actions))\n        \n  # 10. If the BFS queue becomes empty and no path to a valid collectable location was found,\n  # it means the primitive is unreachable from the current agent position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:04:33.553236", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable_target = primitive_idx in env.world.grabbable_indices\n  is_workshop_target = primitive_idx in env.world.workshop_indices\n  # Water, stone, boundary are non-grabbable and often act like stationary resources/locations.\n  is_stationary_primitive_target = (primitive_idx == env.world.water_index or \n                                    primitive_idx == env.world.stone_index or \n                                    primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS setup\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_to_reach_here)\n  q = collections.deque([(state.pos, state.dir, [])]) \n  # Visited set now tracks (position, direction) pairs to avoid cycles in the state space.\n  # A state is defined by (position, direction)\n  visited = {(state.pos, state.dir)} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # BFS loop\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    # Pruning: If the current path (excluding potential final action) is already\n    # as long as or longer than the best *total* path found so far, then this\n    # branch cannot yield a shorter path.\n    if len(current_actions) >= min_path_len:\n        continue # Prune this branch.\n\n    # Check if this state satisfies the collection goal\n    goal_satisfied = False\n    final_actions_to_add = [] # Actions needed to complete the goal from current_pos, current_dir\n\n    if is_grabbable_target:\n      # For grabbable items, the agent needs to face the item and then USE.\n      fwd_x, fwd_y = current_pos\n      if current_dir == 0: # UP\n        fwd_y -= 1\n      elif current_dir == 1: # DOWN\n        fwd_y += 1\n      elif current_dir == 2: # LEFT\n        fwd_x -= 1\n      elif current_dir == 3: # RIGHT\n        fwd_x += 1\n      \n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT and grid[fwd_x, fwd_y, primitive_idx] > 0:\n        goal_satisfied = True\n        final_actions_to_add = [ACTION_USE]\n\n    elif is_workshop_target or is_stationary_primitive_target:\n      # For workshops or stationary primitives, collecting means being on the spot.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        goal_satisfied = True\n        final_actions_to_add = [] # No extra action typically needed, just reaching the spot.\n    \n    # If a goal is satisfied from this (pos, dir) state\n    if goal_satisfied:\n      total_path = current_actions + final_actions_to_add\n      if len(total_path) < min_path_len:\n        min_path_len = len(total_path)\n        best_path_actions = total_path\n        # Early exit: If the shortest path found is 0 or 1, it's very likely optimal.\n        #   0: Agent is already on a stationary primitive.\n        #   1: One ACTION_USE on an adjacent grabbable, or one move to an adjacent stationary.\n        # In these cases, it's impossible to find a shorter path, so we can stop.\n        if min_path_len <= 1: \n            return best_path_actions \n\n    # Explore neighbors by simulating movement actions (UP, DOWN, LEFT, RIGHT)\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # Create a temporary CraftState reflecting the current BFS node's (pos, dir).\n      # The grid and inventory remain constant for pathfinding on the current map.\n      temp_state_for_step = craft.CraftState(\n          state.scenario, state.grid, current_pos, current_dir, state.inventory\n      )\n      \n      # Perform the movement action on the temporary state.\n      # The reward is not relevant for pathfinding, only the resulting new_state.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir)\n\n      # Check if this new (pos, dir) state has been visited.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_actions + [action_type]))\n  \n  return best_path_actions", "island_id": 8, "scores": {"3": 1.0}}
{"timestamp": "2025-08-02T08:04:34.685637", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  inventory = state.inventory\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # IMPROVEMENT: Check if primitive is already in inventory.\n  # If the agent already possesses the primitive, no actions are needed to collect it.\n  if inventory[primitive_idx] > 0:\n    return [] # Already collected, return an empty list of actions.\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n  \n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # BFS setup\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_to_reach_here)\n  q = collections.deque([(state.pos, state.dir, [])]) \n  # Visited set now tracks (position, direction) pairs to avoid cycles in the state space.\n  visited = {(state.pos, state.dir)} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # BFS loop\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    # Optimization: If the current path length already exceeds or equals the best found path,\n    # there's no need to continue exploring this branch as BFS guarantees shortest paths.\n    if len(current_actions) >= min_path_len:\n        continue \n\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to face the item and then USE.\n      fwd_x, fwd_y = current_pos\n      if current_dir == 0: # UP (Y-axis decreases)\n        fwd_y -= 1\n      elif current_dir == 1: # DOWN (Y-axis increases)\n        fwd_y += 1\n      elif current_dir == 2: # LEFT (X-axis decreases)\n        fwd_x -= 1\n      elif current_dir == 3: # RIGHT (X-axis increases)\n        fwd_x += 1\n      \n      # Check if the cell in front is within grid bounds and contains the primitive\n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT:\n        if grid[fwd_x, fwd_y, primitive_idx] > 0:\n          is_goal_reached = True\n          actions_to_complete_goal = [ACTION_USE] # Appending USE action to complete collection\n\n    # Check for non-grabbable, stationary primitives (e.g., WORKSHOPs, WATER, STONE).\n    # For these, \"collecting\" means simply reaching the location they occupy.\n    elif primitive_idx in env.world.non_grabbable_indices:\n      # If the agent is currently on the cell containing the primitive.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Continue BFS: Do not break prematurely. While BFS finds the shortest path to any\n      # particular *node*, our \"goal\" might be a condition (like facing and using an item)\n      # that can be satisfied from multiple nodes. A longer path to an earlier node might\n      # still yield a shorter *total* path when considering the final 'USE' action.\n\n    # Explore neighbors by simulating movement actions (UP, DOWN, LEFT, RIGHT)\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # Create a temporary CraftState reflecting the current BFS node's (pos, dir)\n      # to accurately simulate the next state after taking an action.\n      temp_state_for_step = craft.CraftState(\n          state.scenario, state.grid, current_pos, current_dir, state.inventory\n      )\n      \n      # Perform the movement action on the temporary state.\n      # The reward is not relevant for pathfinding, only the resulting new_state.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir)\n\n      # Check if this new (pos, dir) state has already been visited to avoid cycles and redundant work.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_actions + [action_type]))\n  \n  return best_path_actions", "island_id": 8, "scores": {"3": 1.0}}
{"timestamp": "2025-08-02T08:06:04.497016", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive in the passed env.\n    This version uses a Breadth-First Search (BFS) that considers the agent's position and direction\n    to find the shortest sequence of actions, including implicit turns from movement.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement options: (dx, dy, new_direction_after_move, action_id)\n  # Agent directions: 0: UP, 1: DOWN, 2: LEFT, 3: RIGHT\n  # Moving sets the agent's new facing direction.\n  MOVE_OPTIONS = [\n      (0, -1, 0, ACTION_UP),    # Move Up (dy=-1), new direction is 0 (UP)\n      (0, 1, 1, ACTION_DOWN),   # Move Down (dy=1), new direction is 1 (DOWN)\n      (-1, 0, 2, ACTION_LEFT),  # Move Left (dx=-1), new direction is 2 (LEFT)\n      (1, 0, 3, ACTION_RIGHT),  # Move Right (dx=1), new direction is 3 (RIGHT)\n  ]\n\n  # For checking the cell directly in front of the agent when using ACTION_USE.\n  # These arrays map agent's direction (0-3) to (dx, dy) of the cell in front.\n  DX_FRONT = [0, 0, -1, 1]  # dx for directions: UP, DOWN, LEFT, RIGHT\n  DY_FRONT = [-1, 1, 0, 0]  # dy for directions: UP, DOWN, LEFT, RIGHT\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position and direction\n  start_pos = state.pos\n  start_dir = state.dir \n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, boundary.\n  # \"Collection\" for these means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # --- Initial state check: Is the primitive collectable from the starting position? ---\n  # This avoids starting BFS if the goal is immediately achievable.\n  is_goal_at_start = False\n  actions_at_start = []\n  \n  if is_grabbable:\n      # For grabbable items, agent needs to be facing the item and then USE.\n      target_x_front = start_pos[0] + DX_FRONT[start_dir]\n      target_y_front = start_pos[1] + DY_FRONT[start_dir]\n      if (0 <= target_x_front < WIDTH and 0 <= target_y_front < HEIGHT and \n          grid[target_x_front, target_y_front, primitive_idx] > 0):\n          is_goal_at_start = True\n          actions_at_start = [ACTION_USE]\n  elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, boundary, \"collecting\" means being on their tile.\n      if grid[start_pos[0], start_pos[1], primitive_idx] > 0:\n          is_goal_at_start = True\n          actions_at_start = [] # No USE action is typically needed\n  \n  if is_goal_at_start:\n      return actions_at_start # Return minimal actions if already at goal\n\n  # --- BFS Setup ---\n  # Queue stores tuples: (current_pos_x, current_pos_y, current_dir, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])]) \n  # Visited set to prevent cycles and redundant exploration: (pos_x, pos_y, dir)\n  visited = {(start_pos[0], start_pos[1], start_dir)} \n\n  # BFS loop\n  while q:\n    current_x, current_y, current_dir, current_actions = q.popleft()\n\n    # --- Goal Checking at current (pos, dir) ---\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n        # Check if the cell directly in front of the agent (based on current_dir) contains the primitive\n        target_x = current_x + DX_FRONT[current_dir]\n        target_y = current_y + DY_FRONT[current_dir]\n        if (0 <= target_x < WIDTH and 0 <= target_y < HEIGHT and \n            grid[target_x, target_y, primitive_idx] > 0):\n            is_goal_reached = True\n            actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n        # Check if the current cell contains the primitive\n        if grid[current_x, current_y, primitive_idx] > 0:\n            is_goal_reached = True\n            actions_to_complete_goal = [] \n    \n    if is_goal_reached:\n      # Since this is a BFS, the first time we reach a goal state (pos, dir),\n      # it's guaranteed to be the shortest path to that state.\n      # The actions_to_complete_goal (USE or no-op) have constant length (1 or 0),\n      # so this also represents the shortest overall action sequence.\n      return current_actions + actions_to_complete_goal\n\n    # --- Explore Neighbors (Movement) ---\n    for dx, dy, next_dir, action in MOVE_OPTIONS:\n      next_x, next_y = current_x + dx, current_y + dy\n      \n      # Check if the new position is within grid boundaries\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if this specific (position, direction) state has been visited before\n        if (next_x, next_y, next_dir) not in visited:\n          visited.add((next_x, next_y, next_dir))\n          q.append((next_x, next_y, next_dir, current_actions + [action]))\n  \n  # If the queue becomes empty and no goal was reached, the primitive is unreachable.\n  return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T08:06:05.793135", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define mappings for movement actions and their effects on position and direction\n  # MOVE_DELTAS: maps action_id to (dx, dy)\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n  \n  # ACTION_TO_NEW_DIR: maps action_id to the resulting agent direction\n  # Assuming agent's `dir` attribute updates to reflect the direction of movement.\n  # (e.g., moving UP sets dir to ACTION_UP's value).\n  ACTION_TO_NEW_DIR = {\n      ACTION_UP: ACTION_UP,\n      ACTION_DOWN: ACTION_DOWN,\n      ACTION_LEFT: ACTION_LEFT,\n      ACTION_RIGHT: ACTION_RIGHT,\n  }\n\n  # REQUIRED_FACING_DIR_FOR_USE: maps (dx, dy) vector from agent to item to the\n  # required direction the agent must be facing to USE the item.\n  REQUIRED_FACING_DIR_FOR_USE = {\n      (0, -1): ACTION_UP,    # Item is UP relative to agent, agent must face UP\n      (0, 1): ACTION_DOWN,   # Item is DOWN relative to agent, agent must face DOWN\n      (-1, 0): ACTION_LEFT,  # Item is LEFT relative to agent, agent must face LEFT\n      (1, 0): ACTION_RIGHT,  # Item is RIGHT relative to agent, agent must face RIGHT\n  }\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position and direction\n  start_pos = state.pos\n  start_dir = state.dir # Initial direction of the agent\n\n  # BFS setup\n  # Queue stores tuples: ((current_x, current_y, current_dir), list_of_actions_to_reach_here)\n  q = collections.deque([((start_pos[0], start_pos[1], start_dir), [])]) \n  # Visited set stores (x, y, dir) tuples to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special stationary primitives whose \"collection\" means simply reaching the cell where they are.\n  # Note: 'BOUNDARY' is not an item in `cookbook.index` usually, but 'water' and 'stone' are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index)\n  # Check if primitive is in non_grabbable_indices and not a workshop or water/stone\n  # If it's not grabbable, it usually means you just need to be on it or next to it.\n  # Assuming any non-grabbable primitive (not water/stone/workshop) also means\n  # just reaching its location (similar to workshops/stationary items).\n  # This makes the logic cleaner: grabbable items need USE; others need to be reached.\n  is_reach_only = not is_grabbable \n\n  # BFS loop\n  while q:\n    current_coords, current_actions = q.popleft()\n    curr_x, curr_y, curr_dir = current_coords\n\n    goal_reached_this_iter = False\n    actions_to_complete_goal_this_iter = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent and face them, then USE.\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check 4 cardinal neighbors\n        adj_x, adj_y = curr_x + dx, curr_y + dy\n        \n        # Check if adjacent cell is within bounds\n        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n          # Check if the primitive is in the adjacent cell\n          if grid[adj_x, adj_y, primitive_idx] > 0:\n            # Calculate the direction the agent needs to face to USE this item\n            required_dir_for_use = REQUIRED_FACING_DIR_FOR_USE.get((dx, dy))\n            \n            if required_dir_for_use is not None and curr_dir == required_dir_for_use:\n              goal_reached_this_iter = True\n              actions_to_complete_goal_this_iter = [ACTION_USE]\n              break # Found an adjacent item facing the right way, no need to check other neighbors\n    elif is_reach_only: # Covers workshops, water, stone, and other non-grabbable primitives\n      # For these, \"collecting\" means reaching the location itself.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        goal_reached_this_iter = True\n        actions_to_complete_goal_this_iter = [] # No USE action is typically needed for these\n\n    # If a goal state is reached, update the best path found so far\n    if goal_reached_this_iter:\n      total_actions = current_actions + actions_to_complete_goal_this_iter\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Continue BFS to find other paths, especially if the goal condition is complex\n      # or involves multiple possible 'USE' locations. Shortest path is guaranteed\n      # by BFS if all edge weights are 1.\n\n    # Explore neighbors of the current position (movement actions)\n    for action_id, (dx, dy) in MOVE_DELTAS.items():\n      new_x, new_y = curr_x + dx, curr_y + dy\n      new_dir = ACTION_TO_NEW_DIR[action_id] # Direction agent will face after this move\n      new_coords = (new_x, new_y, new_dir)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if new_coords not in visited:\n          visited.add(new_coords)\n          q.append((new_coords, current_actions + [action_id]))\n  \n  return best_path_actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T08:07:07.452420", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Access the current grid for primitive locations\n  \n  # 1. Map the primitive name (string) to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is already present in the agent's inventory,\n  # no collection actions are needed from the environment.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for the Breadth-First Search (BFS).\n  start_pos = current_state.pos\n\n  # Determine the collection mechanism based on primitive type.\n  # Grabbable items (e.g., WOOD, IRON, GRASS) require being next to them and using ACTION_USE.\n  # Stationary items (WORKSHOPs, WATER, STONE, BOUNDARY) require being on their cell.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_water = primitive_idx == env.world.water_index\n  is_stone = primitive_idx == env.world.stone_index\n  # Check if the *target primitive itself* is 'BOUNDARY'.\n  is_boundary_primitive_target = primitive_idx == cookbook.index['BOUNDARY'] \n\n  # Get the index for the 'BOUNDARY' kind. This is used to check for impassable terrain.\n  boundary_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS initialization:\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of grid positions already explored via a shortest path.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found to a collection point.\n  # `min_total_actions_len` stores the length of the shortest *complete* path (movement + collection action).\n  # `shortest_path_actions` stores the actual sequence of actions for this best path.\n  min_total_actions_len = float('inf') \n  shortest_path_actions = []     \n\n  # BFS traversal loop.\n  while q:\n    current_pos, actions_to_current_pos = q.popleft()\n    cx, cy = current_pos # Unpack current position coordinates for direct grid access.\n\n    # Pruning 1 (after popping from queue):\n    # If the current path to this position, plus the *minimal* additional cost to collect\n    # (1 for 'USE' if grabbable, 0 otherwise), is already as long as or longer than\n    # the best complete collection path found so far, then this branch cannot lead to a shorter solution.\n    estimated_min_cost_from_current_pos = 1 if is_grabbable else 0\n    if len(actions_to_current_pos) + estimated_min_cost_from_current_pos >= min_total_actions_len:\n        continue # Prune this path and its descendants.\n\n    # --- Check if the primitive can be collected from `current_pos` ---\n    can_collect_from_here = False\n    actions_to_complete_collection = [] # Additional actions needed *after* reaching `current_pos` (e.g., USE).\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be in the 3x3 neighborhood of the item.\n      # We check the grid around current_pos for the primitive's presence.\n      found_in_neighborhood = False\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adj_x, adj_y = cx + dx_adj, cy + dy_adj\n          # Ensure adjacent cell is within grid boundaries.\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n            # Check if the primitive is present in the adjacent cell.\n            if grid[adj_x, adj_y, primitive_idx] > 0:\n              found_in_neighborhood = True\n              break # Primitive found in neighborhood, no need to check other adjacent cells.\n        if found_in_neighborhood:\n            break # Break outer loop too.\n      \n      if found_in_neighborhood:\n        can_collect_from_here = True\n        actions_to_complete_collection = [ACTION_USE] # 'USE' action is required for grabbables.\n    elif is_workshop or is_water or is_stone or is_boundary_primitive_target:\n      # For stationary items (workshops, water, stone, boundary), the agent needs to be directly on the cell.\n      # Check if the primitive is present at the current exact cell.\n      if grid[cx, cy, primitive_idx] > 0:\n        can_collect_from_here = True\n        actions_to_complete_collection = [] # No 'USE' action needed for these.\n    \n    # If the primitive can be collected from `current_pos`, update the shortest path found.\n    if can_collect_from_here:\n      current_full_path_len = len(actions_to_current_pos) + len(actions_to_complete_collection)\n      \n      # If this path is strictly shorter than the best found so far, update the best.\n      if current_full_path_len < min_total_actions_len:\n        min_total_actions_len = current_full_path_len\n        shortest_path_actions = actions_to_current_pos + actions_to_complete_collection\n      # Note: We do not `break` here. This allows BFS to continue exploring paths\n      # that might lead to other instances of the primitive (or same instance via different path)\n      # which are equally short, ensuring the true shortest path is found if multiple exist.\n      # The pruning logic handles cutting off longer branches efficiently.\n\n    # --- Explore valid neighbors (movement actions) ---\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # --- IMPROVEMENT for v2: Check for impassable terrain (e.g., BOUNDARY) ---\n        # The agent cannot move into a cell occupied by a BOUNDARY,\n        # UNLESS the primitive target itself IS 'BOUNDARY'.\n        # We assume 'BOUNDARY' is universally impassable for movement.\n        if boundary_kind_idx is not None and grid[new_x, new_y, boundary_kind_idx] > 0 and not is_boundary_primitive_target:\n            # This cell is blocked by a boundary and the target is not boundary, so skip this move.\n            continue \n        # --- End of improvement ---\n\n        # Check if this position has not been visited yet through a shorter or equal path.\n        if new_pos not in visited:\n          # Pruning 2 (before adding to queue):\n          # Estimate the total path length if we were to reach `new_pos` and\n          # then immediately collect (assuming `new_pos` is itself a collection point, or adjacent for grabbables).\n          # This acts as an admissible heuristic for an A*-like pruning.\n          # Cost to reach `new_pos` is `len(actions_to_current_pos) + 1`.\n          # Estimated minimal cost from `new_pos` to collect is `1` for grabbable, `0` for others.\n          estimated_total_path_via_new_pos = len(actions_to_current_pos) + 1 + (1 if is_grabbable else 0)\n          \n          # Only add `new_pos` to the queue if its estimated total path length\n          # is strictly shorter than the best complete path found so far.\n          if estimated_total_path_via_new_pos < min_total_actions_len: \n              visited.add(new_pos) # Mark `new_pos` as visited.\n              q.append((new_pos, actions_to_current_pos + [move_action])) # Enqueue `new_pos` and its path.\n  \n  # After BFS completes, `shortest_path_actions` will contain the shortest sequence of actions\n  # to collect the primitive, or an empty list if unreachable.\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:07:08.543263", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Access the current grid for primitive locations\n  \n  # 1. Map the primitive name (string) to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the primitive is already present in the agent's inventory,\n  # no collection actions are needed from the environment.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  # These define the change in coordinates and the corresponding action index.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for the Breadth-First Search (BFS).\n  start_pos = current_state.pos\n\n  # Determine the collection mechanism based on primitive type.\n  # - Grabbable items (e.g., WOOD, IRON, GRASS) require being next to them and using ACTION_USE.\n  # - Stationary items (WORKSHOPs, WATER, STONE, BOUNDARY) require being on their cell.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_stationary_collectable = (\n      primitive_idx in env.world.workshop_indices or\n      primitive_idx == env.world.water_index or\n      primitive_idx == env.world.stone_index or\n      primitive_idx == cookbook.index['BOUNDARY']\n  )\n\n  # BFS initialization:\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of grid positions already explored via a shortest path.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found to a collection point.\n  # `min_total_actions_len` stores the length of the shortest *complete* path (movement + collection action).\n  # `shortest_path_actions` stores the actual sequence of actions for this best path.\n  min_total_actions_len = float('inf') \n  shortest_path_actions = []     \n\n  # BFS traversal loop to find the shortest path to a collectable primitive.\n  while q:\n    current_pos, actions_to_current_pos = q.popleft()\n    cx, cy = current_pos # Unpack current position coordinates.\n\n    # Pruning 1 (after popping from queue):\n    # If the current path length to this position, plus the *minimal* additional cost to collect\n    # (1 for 'USE' if grabbable, 0 otherwise), is already as long as or longer than\n    # the best complete collection path found so far, then this branch cannot lead to a shorter solution.\n    estimated_min_cost_from_current_pos = 1 if is_grabbable else 0\n    if len(actions_to_current_pos) + estimated_min_cost_from_current_pos >= min_total_actions_len:\n        continue # Prune this path and its descendants.\n\n    # --- Check if the primitive can be collected from `current_pos` ---\n    can_collect_from_here = False\n    actions_to_complete_collection = [] # Additional actions needed *after* reaching `current_pos` (e.g., USE).\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be in the 3x3 neighborhood of the item.\n      # Check the 3x3 area around current_pos for the primitive's presence.\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adj_x, adj_y = cx + dx_adj, cy + dy_adj\n          # Ensure adjacent cell is within grid boundaries.\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n            # Check if the primitive is present in the adjacent cell.\n            if grid[adj_x, adj_y, primitive_idx] > 0:\n              can_collect_from_here = True\n              actions_to_complete_collection = [ACTION_USE] # 'USE' action is required for grabbables.\n              break # Found it, no need to check other adjacent cells.\n        if can_collect_from_here:\n            break # Break outer loop too.\n    elif is_stationary_collectable:\n      # For stationary items, the agent needs to be directly on the cell.\n      if grid[cx, cy, primitive_idx] > 0:\n        can_collect_from_here = True\n        actions_to_complete_collection = [] # No 'USE' action needed for these.\n    \n    # If the primitive can be collected from `current_pos`, update the shortest path found.\n    if can_collect_from_here:\n      current_full_path_len = len(actions_to_current_pos) + len(actions_to_complete_collection)\n      \n      # If this path is strictly shorter than the best found so far, update the best.\n      if current_full_path_len < min_total_actions_len:\n        min_total_actions_len = current_full_path_len\n        shortest_path_actions = actions_to_current_pos + actions_to_complete_collection\n      # Note: We do not `break` here. BFS must continue exploring to guarantee the\n      # shortest path to *any* instance of the primitive is found.\n\n    # --- Explore valid neighbors (movement actions) ---\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if this position has not been visited yet through a shorter or equal path.\n        if new_pos not in visited:\n          # Pruning 2 (before adding to queue):\n          # Estimate the total path length if we were to reach `new_pos` and\n          # then immediately collect (assuming `new_pos` is itself a collection point, or adjacent for grabbables).\n          # This acts as an admissible heuristic for an A*-like pruning, where edge costs are 1.\n          # Cost to reach `new_pos` is `len(actions_to_current_pos) + 1`.\n          # Estimated minimal cost from `new_pos` to collect is `1` for grabbable, `0` for others.\n          estimated_total_path_via_new_pos = len(actions_to_current_pos) + 1 + (1 if is_grabbable else 0)\n          \n          # Only add `new_pos` to the queue if its estimated total path length\n          # is strictly shorter than the best complete path found so far.\n          if estimated_total_path_via_new_pos < min_total_actions_len: \n              visited.add(new_pos) # Mark `new_pos` as visited.\n              q.append((new_pos, actions_to_current_pos + [move_action])) # Enqueue `new_pos` and its path.\n  \n  # After BFS completes, `shortest_path_actions` will contain the shortest sequence of actions\n  # to collect the primitive, or an empty list if unreachable.\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:07:28.995683", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action.\n  # CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Determine if the primitive is grabbable.\n  # Non-grabbable primitives like WORKSHOPs, WATER, BOUNDARY typically\n  # do not involve a 'USE' action for \"collection\" but rather just require getting next to them.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Define a helper function to efficiently check the 3x3 neighborhood of a given position.\n  # This avoids repeated CraftState object creation and directly accesses the grid.\n  def _is_primitive_next_to(current_pos_check, target_idx):\n    cx_check, cy_check = current_pos_check\n    min_x = max(0, cx_check - 1)\n    max_x = min(WIDTH, cx_check + 2)\n    min_y = max(0, cy_check - 1)\n    max_y = min(HEIGHT, cy_check + 2)\n    \n    # Check if any cell in the 3x3 slice (including the center) contains the target primitive.\n    # np.any is used for efficiency on the grid slice.\n    return np.any(grid[min_x:max_x, min_y:max_y, target_idx])\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    \n    # Use the efficient helper function to check if the primitive is in the 3x3 neighborhood\n    # of the current_pos.\n    if _is_primitive_next_to(current_pos, primitive_idx):\n      # If the primitive is found in the vicinity, decide on the final action.\n      if is_grabbable:\n        # For grabbable items, the 'USE' action is required to pick them up.\n        return current_path + [USE]\n      else:\n        # For non-grabbable items (e.g., workshops, water), the goal is simply\n        # to be adjacent to them. No 'USE' action is appended.\n        return current_path\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in moves:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position has already been visited to avoid cycles and redundant paths.\n        if next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found (e.g., primitive is unreachable),\n  # return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:07:30.157531", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define a nested helper function to efficiently check the 3x3 neighborhood.\n  # This avoids repeated CraftState object creation and directly uses the grid.\n  def _is_primitive_next_to_efficient(current_pos_check, primitive_idx_check):\n    cx_check, cy_check = current_pos_check\n    min_x = max(0, cx_check - 1)\n    max_x = min(WIDTH, cx_check + 2) # +2 because slicing is exclusive of end\n    min_y = max(0, cy_check - 1)\n    max_y = min(HEIGHT, cy_check + 2)\n    \n    # Check if any cell in the 3x3 slice (including the center) contains the primitive.\n    # np.any is used for efficiency.\n    return np.any(grid[min_x:max_x, min_y:max_y, primitive_idx_check])\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action.\n  # CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Determine if the primitive is grabbable.\n  # Non-grabbable primitives like WORKSHOPs, WATER, BOUNDARY typically\n  # do not involve a 'USE' action for \"collection\" but rather just require getting next to them.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    \n    # Use the efficient nested helper function to check if the primitive is in the 3x3 neighborhood\n    # of the current_pos.\n    if _is_primitive_next_to_efficient(current_pos, primitive_idx):\n      # If the primitive is found in the vicinity, decide on the final action.\n      if is_grabbable:\n        # For grabbable items, the 'USE' action is required to pick them up.\n        return current_path + [USE]\n      else:\n        # For non-grabbable items (e.g., workshops, water), the goal is simply\n        # to be adjacent to them. No 'USE' action is appended.\n        return current_path\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for action, (dx, dy) in moves:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position has already been visited to avoid cycles and redundant paths.\n        if next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found (e.g., primitive is unreachable),\n  # return an empty list of actions.\n  return []", "island_id": 2, "scores": {"3": 0.5}}
