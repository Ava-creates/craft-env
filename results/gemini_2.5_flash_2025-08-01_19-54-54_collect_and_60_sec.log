{"timestamp": "2025-08-02T01:28:56.503814", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # 1. Initial Checks (from collect_v1)\n  current_state = env._current_state\n  \n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # 2. Get current state details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Data from world to determine traversability\n  world_non_grabbable_indices = env.world.non_grabbable_indices\n  world_workshop_indices = env.world.workshop_indices\n\n  # Helper function to determine if a cell is traversable for agent movement.\n  # A cell is traversable if it's within bounds and does not contain any\n  # non-grabbable item that is NOT a workshop. This allows the agent to move\n  # onto empty cells, cells with grabbable items, or workshop locations.\n  def is_traversable(pos_x, pos_y, current_grid, non_grabbable_indices_set, workshop_indices_set):\n      grid_width, grid_height, n_kinds = current_grid.shape\n      \n      # Check boundary first\n      if not (0 <= pos_x < grid_width and 0 <= pos_y < grid_height):\n          return False # Out of bounds\n\n      # Check if the cell contains any non-grabbable item that is NOT a workshop.\n      # If it does, it's not traversable.\n      for k in range(n_kinds):\n          if current_grid[pos_x, pos_y, k] > 0: # If there's something of kind 'k' at this cell\n              if k in non_grabbable_indices_set and k not in workshop_indices_set:\n                  return False # This cell is blocked by an immovable obstacle (e.g., water, stone).\n      return True # Cell is traversable (empty, has grabbable item, or has a workshop).\n\n  # Helper function to check if a given position is next to (or on) the target primitive.\n  # This function checks the static grid for the primitive's location relative to check_pos.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position (including the current cell itself)\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    # and can now use the 'USE' action to collect it.\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries AND traversable (not blocked by obstacles)\n      if is_traversable(next_x, next_y, grid, world_non_grabbable_indices, world_workshop_indices):\n        # If the next position has not been visited, add it to the queue\n        if next_pos not in visited:\n          visited.add(next_pos)\n          q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T01:28:57.826785", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by considering impassable terrain for pathfinding.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n  \n  # Check if the primitive is already in the agent's inventory.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Check if the primitive is actually a grabbable item.\n  # If the primitive is marked as non-grabbable, it cannot be 'collected' in this manner.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Identify impassable terrain indices.\n  # Water and Boundary are commonly impassable in grid worlds.\n  impassable_indices = set()\n  impassable_indices.add(env.world.water_index)\n  try:\n    boundary_idx = env.world.cookbook.index.index(\"BOUNDARY\")\n    impassable_indices.add(boundary_idx)\n  except KeyError:\n    # Handle cases where \"BOUNDARY\" might not be a defined item in the cookbook.\n    pass\n\n  # Helper function to check if a given position is next to (or on) the target primitive.\n  # This corresponds to where the agent can perform a 'USE' action.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n  \n  # Helper function to check if a given cell is traversable.\n  # A cell is traversable if it's within bounds and does not contain any impassable entities.\n  def is_traversable(pos, current_grid, impassable_set):\n      x, y = pos\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False # Out of bounds\n      \n      # Check if the cell contains any impassable entity\n      for idx in impassable_set:\n          if current_grid[x, y, idx] > 0:\n              return False # Contains an impassable entity\n      return True # Traversable\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # V2 Improvement: Check traversability for the next position\n      if not is_traversable(next_pos, grid, impassable_indices):\n          continue # Cannot move to this cell, skip this path\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-02T01:29:41.155812", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This version refines the pathfinding logic by using a dedicated helper function\n    to determine cell traversability, enhancing readability and maintainability.\n    It performs a Breadth-First Search (BFS) to find the shortest sequence of\n    movement actions to reach a position from which the target primitive can be\n    collected via a 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute to collect the primitive,\n                   ending with a 'USE' action. Returns an empty list if the\n                   primitive is not found or is unreachable.\n  \"\"\"\n\n  # Helper function to determine if a grid position is traversable by the agent.\n  def _is_traversable(x: int, y: int, grid: np.ndarray, world_config: craft.CraftWorld, target_primitive_idx: int) -> bool:\n      \"\"\"\n      Checks if a given grid position (x, y) is traversable by the agent for movement.\n      \n      Args:\n          x (int): The x-coordinate of the position to check.\n          y (int): The y-coordinate of the position to check.\n          grid (np.ndarray): The current grid state.\n          world_config (craft.CraftWorld): The world configuration for obstacle definitions.\n          target_primitive_idx (int): The index of the primitive being collected.\n      \n      Returns:\n          bool: True if the position is traversable, False otherwise.\n      \"\"\"\n      grid_width, grid_height, num_kinds = grid.shape\n\n      # 1. Check if the position is out of grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds positions are not traversable.\n\n      # 2. Check entities present at the position for impassability.\n      # Iterate through all 'kinds' (layers) at the given cell.\n      for k_idx in range(num_kinds):\n          if grid[x, y, k_idx] > 0:  # If something of kind `k_idx` is present at (x, y)\n              # The target primitive itself is always traversable for movement.\n              # The agent should be able to move onto the primitive's square to collect it.\n              if k_idx == target_primitive_idx:\n                  continue\n              \n              # Check if it's a non-grabbable entity.\n              if k_idx in world_config.non_grabbable_indices:\n                  # Special non-grabbable entities like workshops and water are traversable.\n                  if k_idx in world_config.workshop_indices or k_idx == world_config.water_index:\n                      continue\n                  else:\n                      # Any other non-grabbable entity (e.g., 'BOUNDARY') is an obstacle.\n                      return False  # Impassable\n      return True  # No impassable entity found at this position, and within bounds.\n\n\n  # 1. Retrieve the integer ID for the target primitive from the cookbook's index.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # 2. Get the current state information needed for pathfinding.\n  state = env._current_state\n  initial_pos = state.pos  # Agent's current (x, y) position.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  # grid_width, grid_height, _ = grid.shape # Already used by _is_traversable\n  world_config = env.world # Reference to CraftWorld instance for obstacle definitions.\n\n  # 3. Get the integer action mappings for movement and 'USE' from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas (dx, dy) and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move down (increase y)\n      ((0, -1), UP_ACTION),   # Move up (decrease y)\n      ((-1, 0), LEFT_ACTION), # Move left (decrease x)\n      ((1, 0), RIGHT_ACTION), # Move right (increase x)\n  ]\n\n  # 4. Identify all grid cells that contain the target primitive.\n  primitive_locations = []\n  # Iterate over the grid to find all occurrences of the primitive.\n  for x in range(grid.shape[0]): # grid_width\n      for y in range(grid.shape[1]): # grid_height\n          if grid[x, y, primitive_idx] > 0:  # Check if the primitive kind exists at this cell.\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If no instances of the primitive are found on the map, no actions are possible.\n      return []\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The goal is to reach any cell from which the 'USE' action can successfully\n  # collect the primitive (i.e., within a 3x3 neighborhood of a primitive).\n\n  # Queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # The 'visited' set keeps track of positions already explored to prevent cycles.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is within the effective range for the 'USE' action\n      # relative to any of the primitive's locations.\n      # The 'USE' action collects items in a 3x3 neighborhood (including current cell).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break  # Found a primitive within 'USE' range.\n      \n      if is_adjacent_to_primitive:\n          # If a position from which the primitive can be 'USED' is found,\n          # append the 'USE' action and return the complete path.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Use the helper function to determine if the next position is traversable.\n          if not _is_traversable(next_x, next_y, grid, world_config, primitive_idx):\n              continue  # Skip this next position if it's an obstacle or out of bounds.\n\n          # If the cell is traversable and has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path)  # Create a new path list for this branch to avoid modifying shared references.\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS completes and no path to a collectable position was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:29:42.304709", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    This function finds the shortest path for the agent to reach and collect\n    a specified primitive item in the CraftLab environment using Breadth-First Search (BFS).\n    It ensures robust navigation around obstacles and efficient collection by\n    prioritizing the shortest path to any cell from which the 'USE' action\n    can be performed on the primitive.\n\n    The strategy involves:\n    1. Identifying the integer ID for the target primitive.\n    2. Locating all instances of the primitive on the grid.\n    3. Performing a BFS from the agent's current position to find the shortest\n       sequence of movement actions that lead to a cell from which the 'USE'\n       action can successfully collect the primitive.\n    4. Appending a 'USE' action to the found path.\n\n    Obstacles: The BFS uses a helper function `_is_traversable` to determine\n    if a grid cell can be moved onto. Non-grabbable entities like 'BOUNDARY'\n    are typically impassable, while 'WORKSHOP' or 'WATER' are traversable\n    interaction points. The primitive itself is always traversable for movement.\n\n    Args:\n        env (env.CraftLab): The CraftLab environment instance.\n        primitive (str): The string name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A list of integer action IDs representing the shortest path\n                   to collect the primitive, ending with a 'USE' action.\n                   Returns an empty list if the primitive is not found or is unreachable.\n  \"\"\"\n\n  # Helper function to check if a grid position is traversable for movement.\n  def _is_traversable(x: int, y: int, grid: np.ndarray, world_config: craft.CraftWorld, target_primitive_idx: int) -> bool:\n      \"\"\"\n      Checks if a given grid position (x, y) is traversable by the agent for movement.\n      \n      Args:\n          x (int): The x-coordinate of the position to check.\n          y (int): The y-coordinate of the position to check.\n          grid (np.ndarray): The current grid state.\n          world_config (craft.CraftWorld): The world configuration for obstacle definitions.\n          target_primitive_idx (int): The index of the primitive being collected.\n      \n      Returns:\n          bool: True if the position is traversable, False otherwise.\n      \"\"\"\n      grid_width, grid_height, num_kinds = grid.shape\n\n      # 1. Check if the position is out of grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False # Out of bounds is not traversable.\n\n      # 2. Check entities present at the position for impassability.\n      # Iterate through all 'kinds' (layers) at the given cell.\n      for k_idx in range(num_kinds):\n          if grid[x, y, k_idx] > 0: # If something of kind `k_idx` is present at (x, y)\n              # The target primitive itself is always traversable for movement,\n              # as you often need to move onto it to collect.\n              if k_idx == target_primitive_idx:\n                  continue\n              \n              # Check if it's a non-grabbable entity.\n              if k_idx in world_config.non_grabbable_indices:\n                  # Special non-grabbable entities like workshops and water are traversable.\n                  if k_idx in world_config.workshop_indices or k_idx == world_config.water_index:\n                      continue\n                  else:\n                      # Any other non-grabbable entity (e.g., 'BOUNDARY') is an obstacle.\n                      return False # Impassable\n      return True # No impassable entity found at this position, so it's traversable.\n\n  # 1. Resolve the primitive's string name to its unique integer ID.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      return [] # Primitive name not recognized.\n\n  # 2. Extract crucial information from the current environment state.\n  state = env._current_state\n  initial_pos = state.pos\n  grid = state.grid\n  world_config = env.world # Reference to CraftWorld instance for obstacle checks\n\n  # Grid dimensions for boundary checks\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Obtain the integer mappings for movement and interaction actions.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down, action_id\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up, action_id\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left, action_id\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right, action_id\n  ]\n\n  # 4. Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return [] # No instances of the primitive found on the map.\n\n  # 5. Perform Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # The 'visited' set keeps track of positions already explored to prevent cycles.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is within the effective range for the 'USE' action.\n      # The 'USE' action can collect items in a 3x3 neighborhood around the agent (including on the same cell).\n      # This means max(abs(agent_x - item_x), abs(agent_y - item_y)) <= 1\n      is_within_use_range = False\n      for px, py in primitive_locations:\n          if max(abs(cx - px), abs(cy - py)) <= 1:\n              is_within_use_range = True\n              break # Found a primitive within 'USE' range.\n      \n      if is_within_use_range:\n          # If a position from which the primitive can be 'USED' is found,\n          # append the 'USE' action and return the complete path.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Use the helper function to determine if the next position is traversable.\n          if not _is_traversable(next_x, next_y, grid, world_config, primitive_idx):\n              continue # Skip this next position if it's an obstacle or out of bounds.\n\n          # If the cell is traversable and has not been visited, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path) # Create a new path list for this branch.\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS completes and no path to a collectable position was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:30:07.676477", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # Retrieve the integer index for the target primitive from the cookbook.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, return an empty list as it cannot be collected.\n    return []\n\n  # Map action names to their corresponding integer IDs using the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define all possible single-step movements as (delta_x, delta_y, action_id).\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  # Get the dimensions of the grid for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Initialize the agent's starting position for the BFS.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) initialization:\n  # The queue `q` stores tuples of (current_position, list_of_actions_taken_to_reach_current_position).\n  # The `visited` set keeps track of grid positions that have already been explored\n  # to prevent infinite loops and redundant pathfinding.\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # Determine the classification of the primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # These are fixed environmental features; \"collecting\" them means simply reaching their location.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Main BFS loop to find the shortest path to the primitive.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object at `current_pos`. This allows us to\n    # query the environment (e.g., check `next_to`, `grid` contents) as if the\n    # agent were physically at `current_pos`, without modifying the actual game state.\n    # The agent's direction and inventory are not relevant for geometric pathfinding,\n    # so they are kept constant from the initial state.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal condition for collecting the primitive.\n    # Since BFS explores layer by layer, the first path found is guaranteed to be the shortest.\n    if is_grabbable:\n      # For grabbable items (e.g., 'WOOD', 'IRON'), the agent must be adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives, \"collecting\" means simply being present\n      # on the same grid cell as the primitive. No 'USE' action is typically required.\n      # We check if the primitive's kind is present at the current coordinates.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, return the actions to reach this spot.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and the queue is empty, it means no path to the primitive was found\n  # from the starting position.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:30:08.866048", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # Retrieve the integer index for the target primitive from the cookbook.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, return an empty list as it cannot be collected.\n    return []\n\n  # Map action names to their corresponding integer IDs using the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define all possible single-step movements as (delta_x, delta_y, action_id).\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  # Get the dimensions of the grid for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Initialize the agent's starting position for the BFS.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) initialization:\n  # The queue `q` stores tuples of (current_position, list_of_actions_taken_to_reach_current_position).\n  # The `visited` set keeps track of grid positions that have already been explored\n  # to prevent infinite loops and redundant pathfinding.\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # Determine the classification of the primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # These are fixed environmental features; \"collecting\" them means simply reaching their location.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Main BFS loop to find the shortest path to the primitive.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object at `current_pos`. This allows us to\n    # query the environment (e.g., check `next_to`, `grid` contents) as if the\n    # agent were physically at `current_pos`, without modifying the actual game state.\n    # The agent's direction and inventory are not relevant for geometric pathfinding,\n    # so they are kept constant from the initial state.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal condition for collecting the primitive.\n    # Since BFS explores layer by layer, the first path found is guaranteed to be the shortest.\n    if is_grabbable:\n      # For grabbable items (e.g., 'WOOD', 'IRON'), the agent must be adjacent to them\n      # and then perform a 'USE' action to pick them up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives, \"collecting\" means simply being present\n      # on the same grid cell as the primitive. No 'USE' action is typically required.\n      # We check if the primitive's kind is present at the current coordinates.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, return the actions to reach this spot.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and the queue is empty, it means no path to the primitive was found\n  # from the starting position.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:30:55.688097", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with obstacle avoidance for movement.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # If the agent is already adjacent to the primitive, perform the USE action\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # to any cell that is adjacent to any instance of the primitive.\n  # Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n  \n  # Get the set of indices for non-grabbable entities from the world configuration.\n  # These entities represent obstacles that the agent cannot move onto.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  all_kind_indices = env.world.cookbook.kinds # All possible kinds of entities in the game\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations.\n    # We do this check here to find the *shortest path to an adjacent cell*.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # 1. Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # 2. Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # 3. Obstacle check: Determine if the 'next_pos' cell contains any non-grabbable item.\n      #    If it does, the agent cannot move onto this cell, so it's an obstacle for pathfinding.\n      is_obstacle = False\n      # Iterate over all known entity kinds to check the content of 'next_pos'\n      for k_idx in all_kind_indices: \n        # If the cell contains this kind (grid[...]>0) AND this kind is non-grabbable,\n        # then this cell is an obstacle.\n        if grid[next_x, next_y, k_idx] > 0 and k_idx in non_grabbable_indices:\n          is_obstacle = True\n          break # Found an obstacle, no need to check other kinds in this cell\n      \n      if is_obstacle:\n        continue # Cannot move to this cell, it's blocked by a non-grabbable entity\n\n      # If all checks pass (within bounds, not visited, not an obstacle), add to queue\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
