{"timestamp": "2025-08-01T22:30:44.316490", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive) # Get integer ID for the primitive\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Check if the primitive is already in inventory (if it's a grabbable item).\n  # If so, no actions are needed to collect it.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # MOVE_ACTIONS[action_id] = (dr, dc, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Move North (up), face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (right), face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (down), face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (left), face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable item that is not a workshop.\n      # Workshops are walkable. Other non-grabbables like WATER, STONE are not.\n      for idx in non_grabbable_indices:\n          if current_state.grid[r, c, idx] == 1:\n              if idx not in workshop_indices:\n                  return False # Blocked by a non-grabbable, non-workshop item.\n      \n      return True # Cell is considered walkable.\n\n  # Find all occurrences of the target primitive on the grid.\n  # This set will be used for goal checking in BFS.\n  primitive_locations = set()\n  for r_grid in range(WIDTH):\n      for c_grid in range(HEIGHT):\n          if current_state.grid[r_grid, c_grid, primitive_idx] == 1:\n              primitive_locations.add((r_grid, c_grid))\n  \n  # If the primitive is not found on the grid at all, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state allows for collecting the primitive.\n      if primitive_idx in world.grabbable_indices:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n          if (r, c) in primitive_locations:\n              return path # Path found to the grabbable item's location.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items (e.g., WATER, STONE, WORKSHOP), the agent needs to be adjacent\n          # to the item, facing it, then perform a 'USE' action.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Check if the cell in front is within bounds and contains the target primitive.\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                  (front_r, front_c) in primitive_locations):\n              return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n          next_state_dir = next_dir_after_move # The direction after moving to next_r, next_c\n\n          # Check if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_dir)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_state_dir, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
