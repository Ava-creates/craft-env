{"timestamp": "2025-08-01T23:19:35.568556", "function_name": "collect", "function_body": "  state = env._current_state\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  if primitive_id is None:\n      # The primitive name is not recognized by the environment.\n      return []\n\n  # Get current agent position and grid dimensions\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping from action names to integer IDs\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Mapping of (dr, dc) movement deltas to corresponding action IDs\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # Standard 4-directional movement deltas for BFS\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Get the index for water, which acts as an untraversable obstacle\n  i_water = env.world.water_index\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_non_grabbable = primitive_id in env.world.non_grabbable_indices\n\n  # If the primitive is neither grabbable nor non-grabbable, it's not something\n  # that can be 'collected' by this function (e.g., an output of a recipe, or an invalid ID)\n  if not is_grabbable and not is_non_grabbable:\n      return []\n\n  # Early exit: If it's a grabbable item and already in inventory, no need to collect.\n  if is_grabbable and state.inventory[primitive_id] > 0:\n      return []\n\n  # 1. First, identify all actual locations of the primitive on the grid.\n  primitive_locations_on_grid = []\n  for r_obj in range(HEIGHT):\n      for c_obj in range(WIDTH):\n          if grid[r_obj, c_obj, primitive_id] > 0:\n              primitive_locations_on_grid.append((r_obj, c_obj))\n  \n  if not primitive_locations_on_grid:\n      # No instances of the primitive found on the grid.\n      return []\n\n  # 2. Determine the set of target cells the agent needs to reach for collection.\n  # These are the cells the agent must occupy (or be adjacent to) to perform the collection.\n  # The set will only include cells that are traversable (i.e., not water).\n  target_cells_for_bfs = set()\n  add_use_action_at_end = False\n\n  if is_grabbable:\n      add_use_action_at_end = True\n      for r_obj, c_obj in primitive_locations_on_grid:\n          # For grabbable items, the agent must move to any cell in the 3x3\n          # neighborhood around the primitive, then use the 'USE' action.\n          for dr_adj in [-1, 0, 1]:\n              for dc_adj in [-1, 0, 1]:\n                  nr, nc = r_obj + dr_adj, c_obj + dc_adj\n                  # Check bounds and if the potential target cell is traversable (no water)\n                  if (0 <= nr < HEIGHT and 0 <= nc < WIDTH and \n                      grid[nr, nc, i_water] == 0):\n                      target_cells_for_bfs.add((nr, nc))\n  elif is_non_grabbable:\n      # For non-grabbable items (e.g., WORKSHOP, STONE, WATER if it were collectable),\n      # the agent needs to stand directly on the cell containing the primitive.\n      # No 'USE' action is required after reaching the location.\n      for r_obj, c_obj in primitive_locations_on_grid:\n          # Agent must be able to stand on this cell (r_obj, c_obj)\n          if grid[r_obj, c_obj, i_water] == 0: # Ensure no water in the target cell\n              target_cells_for_bfs.add((r_obj, c_obj))\n  \n  # If no valid, traversable target cells are found (e.g., all primitives are in water),\n  # then it's impossible to collect this primitive from the current state.\n  if not target_cells_for_bfs:\n      return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path from the\n  # agent's current position to any of the identified target cells.\n  queue = collections.deque([(current_row, current_col, [])]) # (row, col, list_of_actions_to_reach_here)\n  visited = {(current_row, current_col)} # Set to keep track of visited (row, col) coordinates to avoid cycles\n  \n  shortest_path_actions = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # If the current cell is one of our target cells, we've found the shortest path.\n      if (r, c) in target_cells_for_bfs:\n          shortest_path_actions = path\n          break \n\n      # Explore 4-connected neighbors (UP, DOWN, LEFT, RIGHT)\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc # Next row, next column\n\n          # Check if the next cell is within grid boundaries\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if the next cell is traversable (does not contain water)\n          if grid[nr, nc, i_water] > 0:\n              continue\n\n          # If the cell has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a new list for the path to avoid modifying shared references\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  # If no path was found to any target cell, return an empty list.\n  if shortest_path_actions is None:\n      return []\n\n  # 4. Construct the final sequence of actions by appending the 'USE' action\n  # if the primitive requires it for collection.\n  final_actions = list(shortest_path_actions)\n  if add_use_action_at_end:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:19:36.821921", "function_name": "collect", "function_body": "  state = env._current_state\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  if primitive_id is None:\n      # The primitive name is not recognized by the environment.\n      return []\n\n  # Get current agent position, direction, and grid dimensions\n  current_row, current_col = state.pos\n  current_dir = state.dir # Agent's initial facing direction (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT)\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping from action names to integer IDs\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Map movement actions to their (dr, dc) deltas and the resulting direction the agent will face.\n  # The CraftState.step function updates agent's direction to match the movement direction.\n  # CraftState.dir mapping: 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT\n  # Action specs values are: DOWN=0, UP=1, LEFT=2, RIGHT=3\n  MOVE_ACTIONS_MAP = {\n      UP_ACTION: (-1, 0, 0),    # Action UP (val 1) -> dr=-1, dc=0, new_dir=0 (UP)\n      DOWN_ACTION: (1, 0, 1),   # Action DOWN (val 0) -> dr=1, dc=0, new_dir=1 (DOWN)\n      LEFT_ACTION: (0, -1, 2),  # Action LEFT (val 2) -> dr=0, dc=-1, new_dir=2 (LEFT)\n      RIGHT_ACTION: (0, 1, 3)   # Action RIGHT (val 3) -> dr=0, dc=1, new_dir=3 (RIGHT)\n  }\n\n  # Get the index for water, which acts as an untraversable obstacle\n  i_water = env.world.water_index\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_non_grabbable = primitive_id in env.world.non_grabbable_indices\n\n  # If the primitive is neither grabbable nor non-grabbable, it's not something\n  # that can be 'collected' by this function (e.g., an output of a recipe, or an invalid ID)\n  if not is_grabbable and not is_non_grabbable:\n      return []\n\n  # Early exit: If it's a grabbable item and already in inventory, no need to collect.\n  if is_grabbable and state.inventory[primitive_id] > 0:\n      return []\n\n  # Helper function to get coordinates of the cell directly in front of the agent\n  def get_coords_in_front(r, c, direction):\n      if direction == 0: return r - 1, c # UP\n      if direction == 1: return r + 1, c # DOWN\n      if direction == 2: return r, c - 1 # LEFT\n      if direction == 3: return r, c + 1 # RIGHT\n      return None, None # Should not happen with valid direction inputs\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (row, col, current_direction, path_actions)\n  queue = collections.deque([(current_row, current_col, current_dir, [])])\n  # Visited set stores (row, col, direction) to prevent cycles and ensure shortest path considering orientation\n  visited = {(current_row, current_col, current_dir)}\n\n  shortest_path_actions = None\n  add_use_action_at_end = False\n\n  while queue:\n      r, c, d, path = queue.popleft() # Current position (r, c) and direction (d)\n\n      # Check if the current state satisfies the goal\n      if is_grabbable:\n          # For grabbable items, the agent needs to be positioned such that\n          # the primitive is in the cell directly in front, then USE action.\n          target_r, target_c = get_coords_in_front(r, c, d)\n          \n          # Check bounds for the cell in front and if it contains the primitive\n          if (0 <= target_r < HEIGHT and 0 <= target_c < WIDTH and\n              grid[target_r, target_c, primitive_id] > 0):\n              shortest_path_actions = path\n              add_use_action_at_end = True\n              break # Found shortest path, exit BFS\n      elif is_non_grabbable:\n          # For non-grabbable items, the agent needs to stand directly on the primitive's cell.\n          if grid[r, c, primitive_id] > 0:\n              shortest_path_actions = path\n              add_use_action_at_end = False\n              break # Found shortest path, exit BFS\n\n      # Explore neighbors by attempting movement actions\n      for action_id, (dr, dc, new_dir) in MOVE_ACTIONS_MAP.items():\n          nr, nc = r + dr, c + dc # New position after taking action\n\n          # Check if the new position is within grid boundaries\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if the new position contains water (un-traversable)\n          if grid[nr, nc, i_water] > 0:\n              continue\n\n          # If this (position, direction) state has not been visited\n          if (nr, nc, new_dir) not in visited:\n              visited.add((nr, nc, new_dir))\n              new_path = list(path) # Create a new list for the path\n              new_path.append(action_id)\n              queue.append((nr, nc, new_dir, new_path))\n              \n  # If no path was found to any valid target state\n  if shortest_path_actions is None:\n      return []\n\n  # Assemble the final sequence of actions\n  final_actions = list(shortest_path_actions)\n  if add_use_action_at_end:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:20:23.440889", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` to handle impassable terrain during pathfinding.\"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  world = env.world # Access to CraftWorld attributes like water_index\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Identify impassable terrain indices.\n  # Assuming WATER is impassable. Check if 'BOUNDARY' is an indexed entity\n  # and add its index if it exists, as boundaries can also be impassable.\n  impassable_indices = {world.water_index}\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_indices.add(cookbook.index['BOUNDARY'])\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any cells from which the agent can successfully 'USE' the primitive.\n  # This means any walkable cell in the 3x3 neighborhood around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        # Check if the potential target cell is within grid bounds\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # Ensure the potential target cell is itself walkable\n          is_walkable_target = True\n          for kind_idx in impassable_indices:\n              if grid[nx, ny, kind_idx] == 1: # If the cell contains an impassable kind\n                  is_walkable_target = False\n                  break\n          if is_walkable_target:\n              bfs_target_cells.add((nx, ny))\n  \n  # If no walkable target cells found, it means the primitive is unreachable\n  # (e.g., entirely surrounded by or on impassable terrain).\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set to keep track of visited cells to avoid cycles and redundant paths\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell from which the primitive can be USEd.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Relative movements for cardinal directions\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is impassable terrain\n      is_impassable = False\n      for kind_idx in impassable_indices:\n          if grid[next_x, next_y, kind_idx] == 1: # If the next cell contains an impassable kind\n              is_impassable = True\n              break\n      if is_impassable:\n          continue\n\n      # Check if the next position has already been visited (to ensure shortest path and prevent loops)\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell,\n  # it means the primitive is unreachable from the current agent_pos.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:20:24.556313", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,   # Up (decrement y)\n      (0, 1): DOWN,  # Down (increment y)\n      (-1, 0): LEFT, # Left (decrement x)\n      (1, 0): RIGHT, # Right (increment x)\n  }\n\n  grid_width, grid_height, n_kinds = grid.shape # Unpack grid dimensions\n\n  # Get indices of non-grabbable items that act as obstacles.\n  # The agent cannot move into cells containing these items.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        # Check if the potential target cell is within grid bounds\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          bfs_target_cells.add((nx, ny))\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    # (i.e., a cell from which state.next_to(primitive_idx) would be True)\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position is an obstacle (contains a non-grabbable item).\n      # The agent cannot move into such cells.\n      is_obstacle = False\n      for obstacle_idx in non_grabbable_indices:\n        # If the cell contains any non-grabbable item, it's an obstacle.\n        if grid[next_x, next_y, obstacle_idx] == 1:\n          is_obstacle = True\n          break # Found an obstacle, no need to check further.\n      \n      if is_obstacle:\n        continue # Skip this path if it leads to an obstacle.\n\n      # Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:21:26.649321", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` which correctly distinguishes between\n     grabbable and non-grabbable primitives, and uses the appropriate collection mechanism.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  # Helper function to check adjacency for non-grabbable items (requiring USE)\n  def _is_adjacent_to_kind(grid_data, agent_pos, target_idx, grid_width, grid_height):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around agent_pos contains the target_idx.\n      This mimics CraftState.next_to behavior, which is used for the 'USE' action\n      when interacting with non-grabbable entities like trees or rocks.\n      \"\"\"\n      ax, ay = agent_pos\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              check_x, check_y = ax + dx_adj, ay + dy_adj\n              # Ensure the checked position is within grid boundaries\n              if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                  # Check if the target kind is present at the adjacent cell\n                  if grid_data[check_x, check_y, target_idx] == 1:\n                      return True\n      return False\n\n  try:\n      # 1. Get the integer index for the primitive from the cookbook's index.\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the index, it cannot be collected.\n      return []\n\n  # 2. Validate that the target is indeed a \"primitive\" resource that can be collected.\n  # This prevents trying to collect crafted items or environment features that are not primitives.\n  if primitive_idx not in env.world.cookbook.primitives:\n      return []\n\n  # 3. Get current state information from the environment.\n  current_state = env._current_state\n  \n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to collect it, so return an empty list.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  grid = current_state.grid\n  agent_pos = current_state.pos # The agent's current (x, y) tuple position.\n  \n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  grid_width, grid_height, _ = grid.shape\n\n  # 5. Determine if the primitive is grabbable (picked up by moving onto its cell)\n  # or non-grabbable (requires 'USE' action when adjacent).\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 6. Get action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each cardinal direction action (dx, dy).\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles during movement.\n  # The agent cannot move into a cell that contains any of these items.\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # 7. Perform Breadth-First Search (BFS) to find the shortest path to collect the primitive.\n  # The queue stores tuples: ((agent_x, agent_y), [list_of_actions_taken_to_reach_here])\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting cells and infinite loops,\n  # ensuring that the shortest path is found.\n  visited = {agent_pos}\n  \n  # Initial check for immediate collection from the agent's starting position.\n  if is_primitive_grabbable:\n      # If grabbable, check if the agent is already standing on the primitive.\n      if grid[agent_pos[0], agent_pos[1], primitive_idx] == 1:\n          return [] # Already collected by being on it.\n  else: # Non-grabbable primitive\n      # If non-grabbable, check if the agent is already adjacent to the primitive.\n      if _is_adjacent_to_kind(grid, agent_pos, primitive_idx, grid_width, grid_height):\n          return [USE_ACTION] # Agent is adjacent, just use.\n\n  while queue:\n      (curr_x, curr_y), path_so_far = queue.popleft() # Current agent position and the path taken to reach it.\n\n      # Explore all possible cardinal moves (UP, DOWN, LEFT, RIGHT) from the current position.\n      for move_action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy # Calculate the next potential agent position.\n\n          # Check if the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if this neighbor cell has already been visited in the BFS.\n          if (next_x, next_y) in visited:\n              continue\n\n          # Check if the neighbor cell is blocked by any non-grabbable obstacle.\n          is_obstacle = False\n          # Get all kind indices present at the potential next position (nx, ny).\n          kinds_at_next_pos = np.where(grid[nx, ny, :] == 1)[0]\n          for kind_idx in kinds_at_next_pos:\n              if kind_idx in non_grabbable_obstacle_indices:\n                  is_obstacle = True\n                  break # Found an obstacle, cannot move to this cell.\n          \n          if is_obstacle:\n              continue # Skip this cell, as it's an obstacle.\n\n          # Mark the cell as visited.\n          visited.add((nx, ny))\n          \n          # Construct the path to reach this new position.\n          new_path = path_so_far + [move_action_id]\n\n          # Check if the primitive can be collected from this `next_x, next_y` position,\n          # based on whether it's grabbable or non-grabbable.\n          if is_primitive_grabbable:\n              # For grabbable primitives, the goal is to move directly onto the primitive's cell.\n              if grid[next_x, next_y, primitive_idx] == 1:\n                  return new_path # Path found, return the sequence of moves.\n          else: # Non-grabbable primitive (requires USE action when adjacent)\n              # The agent moves to (next_x, next_y). We then check if the primitive\n              # is adjacent to this new agent position.\n              if _is_adjacent_to_kind(grid, (next_x, next_y), primitive_idx, grid_width, grid_height):\n                  return new_path + [USE_ACTION] # Path found, append USE action.\n          \n          # If not collected yet, add this position to the queue for further exploration.\n          queue.append(((nx, ny), new_path))\n\n  # If the BFS queue is exhausted and no path to a collectable primitive location was found,\n  # it means the primitive is unreachable in the current scenario.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-01T23:21:27.932329", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the specified primitive in the passed env.\n    \n    Collection mechanism depends on the primitive type:\n    - Grabbable primitives (e.g., WOOD): Collected by moving onto their cell.\n    - Non-grabbable primitives (e.g., WATER, WORKSHOP): Collected by moving adjacent to them, then using the 'USE' action.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current state and world configuration.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"WATER\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute. Returns an empty list\n                   if the primitive is already in inventory, is invalid, or is unreachable.\n  \"\"\"\n  def _is_primitive_adjacent(grid, check_pos, target_idx, grid_width, grid_height):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around `check_pos` contains `target_idx`.\n      This is used for non-grabbable items which require a 'USE' action when adjacent.\n      It mimics `CraftState.next_to` behavior.\n      \"\"\"\n      cx, cy = check_pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              px, py = cx + dx, cy + dy\n              # Check grid boundaries for the potential primitive location\n              if 0 <= px < grid_width and 0 <= py < grid_height:\n                  # If the primitive is found at (px, py)\n                  if grid[px, py, target_idx] == 1:\n                      return True\n      return False\n\n  try:\n      # 1. Get the integer index for the primitive from the cookbook's index.\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the index, it cannot be collected.\n      return []\n\n  # 2. Validate that the target is indeed a \"primitive\" resource that can be collected.\n  # This prevents trying to collect crafted items or environment features that are not primitives.\n  if primitive_idx not in env.world.cookbook.primitives:\n      return []\n\n  # 3. Get current state information from the environment.\n  current_state = env._current_state\n  \n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to collect it, so return an empty list.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  grid = current_state.grid\n  agent_pos = current_state.pos # The agent's current (x, y) tuple position.\n  \n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  grid_width, grid_height, _ = grid.shape\n\n  # 5. Get action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each cardinal direction action (dx, dy).\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles during movement.\n  # The agent cannot move into a cell that contains any of these items.\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n  \n  # Determine if the target primitive is grabbable or non-grabbable.\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 6. Perform Breadth-First Search (BFS) to find the shortest path to collect the primitive.\n  # The queue stores tuples: ((agent_x, agent_y), [list_of_actions_taken_to_reach_here])\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting cells and infinite loops,\n  # ensuring that the shortest path is found.\n  visited = {agent_pos}\n  \n  # Initial check for immediate collection *if agent starts at a collecting position*\n  # This handles cases where agent is already on a grabbable item or adjacent to a non-grabbable item.\n  if is_primitive_grabbable:\n      # If agent is currently on the grabbable primitive, it's considered collected.\n      if grid[agent_pos[0], agent_pos[1], primitive_idx] == 1:\n          return [] \n  else: # Non-grabbable primitive\n      # If agent is currently adjacent to a non-grabbable primitive, just USE.\n      if _is_primitive_adjacent(grid, agent_pos, primitive_idx, grid_width, grid_height):\n          return [USE_ACTION]\n\n  while queue:\n      (curr_x, curr_y), path_to_curr = queue.popleft()\n\n      # Explore possible moves from the current agent position (curr_x, curr_y)\n      for move_action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy # The cell the agent would move to\n\n          # Check if the next agent position is within grid bounds\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if the next agent position has already been visited, skip\n          if (next_x, next_y) in visited:\n              continue\n\n          # Check if the next agent position is an obstacle (contains any non-grabbable item)\n          # A cell is an obstacle if it contains any kind that is non-grabbable.\n          is_obstacle = False\n          # Get all kind indices present at (next_x, next_y)\n          kinds_at_next_pos = np.where(grid[next_x, next_y, :] == 1)[0]\n          for kind_idx in kinds_at_next_pos:\n              if kind_idx in non_grabbable_obstacle_indices:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue # Skip this cell, it's an obstacle\n\n          # Mark the cell as visited *before* checking the goal to ensure shortest path\n          # and prevent re-queueing of already processed positions.\n          visited.add((next_x, next_y))\n          \n          # Construct the path to reach this new position\n          new_path = path_to_curr + [move_action_id]\n\n          # Check if the goal is met at this new position based on primitive type\n          if is_primitive_grabbable:\n              # For grabbable primitives, the goal is to move directly onto the primitive's cell.\n              if grid[next_x, next_y, primitive_idx] == 1:\n                  return new_path # Path found, no USE action needed for grabbable items\n          else: # Non-grabbable primitive\n              # For non-grabbable primitives, the goal is to move to a cell adjacent to it, then USE.\n              if _is_primitive_adjacent(grid, (next_x, next_y), primitive_idx, grid_width, grid_height):\n                  return new_path + [USE_ACTION] # Path found, append USE action\n          \n          # If not collected yet, add this position to the queue for further exploration\n          queue.append(((next_x, next_y), new_path))\n\n  # If the queue is exhausted and no path to the primitive was found, it means\n  # the primitive is unreachable in the current scenario.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:22:21.107740", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACT_DOWN = action_map['DOWN']\n  ACT_UP = action_map['UP']\n  ACT_LEFT = action_map['LEFT']\n  ACT_RIGHT = action_map['RIGHT']\n  ACT_USE = action_map['USE']\n\n  # Get the integer index for the primitive. Handle cases where the primitive name is not recognized.\n  try:\n    i_primitive = env.world.cookbook.index[primitive]\n  except KeyError:\n    return [] # Unknown primitive, no actions possible.\n\n  current_state = env._current_state\n  \n  # Optimization 1: If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Determine if the primitive is \"grabbable\" (can be picked up by moving onto its cell)\n  # or \"non-grabbable\" (requires an explicit USE action when adjacent).\n  is_grabbable = i_primitive in env.world.grabbable_indices\n\n  # Optimization 2: If it's a non-grabbable item and the agent is already next to it,\n  # the immediate action is to 'USE' it. This avoids running BFS unnecessarily.\n  if not is_grabbable and current_state.next_to(i_primitive):\n      return [ACT_USE]\n\n  # Initialize BFS.\n  start_pos = current_state.pos  # Agent's current (row, col) position\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Cells containing these indices are generally considered impassable obstacles for movement.\n  # The agent cannot step onto these cells. This includes things like BOUNDARY, WATER, or WORKSHOPS\n  # (unless the WORKSHOP itself is the target for interaction, in which case we still don't step *on* it).\n  general_obstacles = set(env.world.non_grabbable_indices)\n\n  # BFS queue: stores tuples of (current_position_x, current_position_y, list_of_actions_taken_to_reach_here)\n  queue = collections.deque()\n  queue.append((start_pos[0], start_pos[1], []))\n\n  # Set to keep track of visited grid positions to prevent cycles and redundant exploration.\n  visited = set()\n  visited.add(start_pos) # Store as (x, y) tuple\n\n  # Define possible moves and their corresponding action indices.\n  # Each tuple: ((delta_x, delta_y), action_index)\n  moves = [\n      ((0, 1), ACT_DOWN),    # Move South (increase y, 'down' in array indices)\n      ((0, -1), ACT_UP),     # Move North (decrease y, 'up' in array indices)\n      ((1, 0), ACT_RIGHT),   # Move East (increase x, 'right')\n      ((-1, 0), ACT_LEFT),   # Move West (decrease x, 'left')\n  ]\n\n  # BFS loop\n  while queue:\n      curr_x, curr_y, path_actions = queue.popleft()\n\n      # Check if the goal condition is met from the *current* cell (curr_x, curr_y).\n      if is_grabbable:\n          # For grabbable primitives, the goal is to move onto the cell containing it.\n          # If the agent is currently on a cell with the grabbable primitive, it's collected.\n          if grid[curr_x, curr_y, i_primitive] > 0:\n              return path_actions \n      else:\n          # For non-grabbable primitives, the goal is to move to a cell *adjacent* to the\n          # primitive and then 'USE' it. We check the 3x3 neighborhood around (curr_x, curr_y).\n          found_adjacent_primitive = False\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  adj_x, adj_y = curr_x + dx, curr_y + dy\n                  # Ensure the adjacent cell is within grid boundaries\n                  if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                      # If the adjacent cell contains the target non-grabbable primitive.\n                      if grid[adj_x, adj_y, i_primitive] > 0:\n                          found_adjacent_primitive = True\n                          break\n              if found_adjacent_primitive:\n                  break\n          \n          if found_adjacent_primitive:\n              # If we are adjacent to the primitive, append the 'USE' action and return the path.\n              return path_actions + [ACT_USE]\n\n      # Explore valid neighboring cells.\n      for (dx, dy), action in moves:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # 1. Check if the next position is within grid boundaries.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # 2. Check if the next position has already been visited.\n          if next_pos in visited:\n              continue\n\n          # 3. Check for obstacles: The agent cannot move onto any cell that contains a non-grabbable item.\n          # This correctly prevents moving onto water, boundaries, or a non-grabbable primitive itself.\n          is_obstacle = False\n          for obstacle_idx in general_obstacles:\n              if grid[next_x, next_y, obstacle_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue # Cannot move onto an obstacle cell, try next action.\n\n          # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue.\n          visited.add(next_pos)\n          new_path_actions = path_actions + [action]\n          queue.append((next_x, next_y, new_path_actions))\n\n  # If the BFS completes and no path to the primitive (or its interaction point)\n  # was found, return an empty list of actions, indicating it's unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:22:22.310696", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  current_state = env._current_state\n  \n  # 1. Get the integer index for the primitive from the cookbook.\n  try:\n    i_primitive = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Determine if the primitive is \"grabbable\" (can be picked up by moving onto its cell)\n  # or \"non-grabbable\" (requires an explicit USE action when adjacent).\n  is_grabbable = i_primitive in env.world.grabbable_indices\n\n  # Get grid dimensions and the agent's starting position.\n  grid = current_state.grid\n  grid_rows, grid_cols, _ = grid.shape\n  start_pos = current_state.pos\n\n  # Define possible movement actions and their corresponding (delta_row, delta_col)\n  # tuples. These are used to explore adjacent cells in the BFS.\n  MOVE_ACTIONS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  # Identify obstacles: Any entity in `non_grabbable_indices` (like water, boundaries,\n  # or workshops) cannot be moved onto directly. These cells act as impassable barriers\n  # for agent movement.\n  obstacle_indices = set(env.world.non_grabbable_indices)\n  \n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each item in the queue is a tuple: (current_position (row, col), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])])\n  \n  # Keep track of visited grid positions to prevent infinite loops and redundant exploration.\n  visited = {start_pos}\n\n  # Start BFS traversal\n  while q:\n    curr_pos, path_actions = q.popleft()\n    curr_row, curr_col = curr_pos\n\n    # --- Goal Check ---\n    # Case 1: The primitive is grabbable (e.g., WOOD, IRON).\n    # The goal is to move onto the cell that contains the primitive. Once the agent\n    # is on that cell, the primitive is implicitly collected by the environment's mechanics.\n    if is_grabbable and grid[curr_row, curr_col, i_primitive] > 0:\n        return path_actions # Path found to the grabbable item's cell.\n\n    # Case 2: The primitive is non-grabbable (e.g., STONE, WORKSHOP).\n    # The goal is to move to a cell *adjacent* to the primitive and then use the 'USE' action.\n    if not is_grabbable:\n        # Check the 3x3 neighborhood around the current position for the primitive.\n        found_adjacent_primitive = False\n        for dr_adj in [-1, 0, 1]:\n            for dc_adj in [-1, 0, 1]:\n                adj_row, adj_col = curr_row + dr_adj, curr_col + dc_adj\n                \n                # Ensure the adjacent cell is within grid boundaries.\n                if 0 <= adj_row < grid_rows and 0 <= adj_col < grid_cols:\n                    # If the adjacent cell contains the target non-grabbable primitive.\n                    if grid[adj_row, adj_col, i_primitive] > 0:\n                        found_adjacent_primitive = True\n                        break # Found, no need to check further adjacent cells.\n            if found_adjacent_primitive:\n                break # Found, no need to check further adjacent rows.\n        \n        if found_adjacent_primitive:\n            # If the agent is currently adjacent to the primitive, append the 'USE' action\n            # to the path and return the complete sequence of actions.\n            return path_actions + [ACTION_USE]\n\n    # --- Explore Neighbors ---\n    # If the goal is not met at the current position, explore valid neighboring cells.\n    for action_val, (dr_move, dc_move) in MOVE_ACTIONS.items():\n      next_pos = (curr_row + dr_move, curr_col + dc_move)\n      next_row, next_col = next_pos\n\n      # 1. Check if the next position is within grid boundaries.\n      if not (0 <= next_row < grid_rows and 0 <= next_col < grid_cols):\n        continue\n\n      # 2. Check if the next position has already been visited.\n      if next_pos in visited:\n        continue\n\n      # 3. Check for obstacles: The agent cannot move onto any cell that contains\n      # any of the defined non-grabbable obstacles.\n      is_cell_obstacle = False\n      for kind_idx in obstacle_indices:\n          if grid[next_row, next_col, kind_idx] > 0:\n              is_cell_obstacle = True\n              break\n      \n      if is_cell_obstacle:\n          continue # Skip this move if the target cell is an obstacle.\n\n      # If the move is valid (within bounds, not visited, not an obstacle), add it to the queue.\n      visited.add(next_pos)\n      q.append((next_pos, path_actions + [action_val]))\n\n  # If the BFS completes and the queue becomes empty without finding a path\n  # to the primitive (or an adjacent interaction point), the primitive is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:22:50.170228", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  # Note: `env.action_specs()` provides the mapping from action names to integers\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Get indices for non-walkable terrain\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position contains an obstacle (water or stone)\n      # Cells containing water or stone are non-walkable.\n      is_obstacle = (grid[next_x, next_y, water_idx] > 0 or\n                     grid[next_x, next_y, stone_idx] > 0)\n      if is_obstacle:\n        continue\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:22:51.383398", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get indices of non-grabbable entities that act as obstacles\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Obstacle check: A cell is an obstacle if it contains any non-grabbable item.\n      is_obstacle = False\n      for k_idx in non_grabbable_indices:\n        if grid[next_x, next_y, k_idx] > 0: # If this non-grabbable kind is present at the next position\n          is_obstacle = True\n          break\n      \n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:23:24.440266", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify indices of impassable terrain for pathfinding\n  # Assuming WATER and STONE are generally impassable\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position contains an obstacle (Water or Stone)\n      is_obstacle = False\n      if grid[next_x, next_y, water_idx] > 0 or grid[next_x, next_y, stone_idx] > 0:\n        is_obstacle = True\n      \n      # We can also check against the entire set of non-grabbable *environment* items\n      # that are not meant to be walked upon (excluding workshops, etc. if applicable).\n      # For simplicity here, we stick to Water and Stone as definite obstacles.\n      # A more comprehensive check might be:\n      # for k_idx in env.world.cookbook.environment:\n      #    if k_idx != primitive_idx and grid[next_x, next_y, k_idx] > 0:\n      #        is_obstacle = True\n      #        break\n\n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:23:25.618567", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 1. Check if the agent is already adjacent to the primitive\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 2. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Get the set of indices for non-grabbable entities, which act as obstacles for movement\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # If it is, this path is a candidate for the shortest path to an adjacent cell.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Obstacle check: A cell is considered an obstacle if it contains any non-grabbable item.\n      # The agent cannot move onto such cells (e.g., water, stone, workshops).\n      is_walkable = True\n      for k in non_grabbable_indices:\n        if grid[next_x, next_y, k] > 0:\n          is_walkable = False\n          break\n      \n      if not is_walkable:\n        continue # This cell is blocked, cannot move here\n\n      # Check if the next position has already been visited\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 4. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:24:05.560549", "function_name": "collect", "function_body": "  # Retrieve current state from the environment\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # Get the integer ID for the primitive.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, return an empty list of actions.\n    return []\n\n  # Map action names to their integer IDs for clarity and access.\n  action_map = env.action_specs()\n  ACTIONS = {\n      'UP': action_map['UP'],\n      'DOWN': action_map['DOWN'],\n      'LEFT': action_map['LEFT'],\n      'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Define possible movements (change in x, change in y) and their corresponding action IDs.\n  # This makes the BFS exploration cleaner.\n  MOVE_DELTAS = [\n      (0, -1, ACTIONS['UP']),\n      (0, 1, ACTIONS['DOWN']),\n      (-1, 0, ACTIONS['LEFT']),\n      (1, 0, ACTIONS['RIGHT']),\n  ]\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  grid_width, grid_height, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # BFS Queue: stores (current_position, path_to_current_position).\n  queue = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant paths.\n  visited_positions = {start_pos} \n\n  # Classify the primitive type to determine the collection condition.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_station = primitive_idx in env.world.workshop_indices\n  is_fixed_feature = (primitive_idx == env.world.water_index or \n                      primitive_idx == env.world.stone_index or \n                      primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Perform Breadth-First Search.\n  while queue:\n    current_pos, path_actions = queue.popleft()\n\n    # Create a transient CraftState object for the current position. This allows us to\n    # use state-dependent checks (like `next_to`) without altering the actual environment state.\n    temp_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position fulfills the goal to 'collect' the primitive.\n    # BFS guarantees the shortest path on an unweighted graph, so the first path found is optimal.\n    if is_grabbable_item:\n      # For grabbable items (e.g., 'WOOD', 'IRON'), the agent must be adjacent to them\n      # and then perform a 'USE' action.\n      if temp_state.next_to(primitive_idx):\n        return path_actions + [ACTIONS['USE']]\n    elif is_workshop_station or is_fixed_feature:\n      # For workshops or fixed features (e.g., 'WATER', 'STONE', 'BOUNDARY'),\n      # 'collecting' means reaching the location itself. Check if the primitive is present.\n      if temp_state.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return path_actions # No 'USE' action is needed, just reach the location.\n    \n    # If the goal is not met, explore valid, unvisited neighbors.\n    for dx, dy, action in MOVE_DELTAS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within grid boundaries.\n      if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n        # If this position has not been explored yet.\n        if new_pos not in visited_positions:\n          visited_positions.add(new_pos)\n          queue.append((new_pos, path_actions + [action]))\n  \n  # If the BFS completes and no path was found, return an empty list.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:24:06.686204", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not have an ID, we cannot collect it.\n    return []\n\n  # Retrieve action mappings (integer IDs) from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (change in x, change in y) and their corresponding action IDs.\n  # This list helps iterate over adjacent cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move Down (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move Right (increases X coordinate)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position in the grid.\n  start_pos = state.pos\n\n  # --- BFS (Breadth-First Search) Setup ---\n  # The queue will store tuples: (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # Determine the type of the target primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, or boundary.\n  # \"Collecting\" these typically means simply reaching their location without a `USE` action.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # --- BFS Algorithm Execution ---\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object representing the agent *at* `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) or directly inspect `grid` content\n    # as if the agent were physically at this specific cell during pathfinding.\n    # Agent's direction and inventory are kept constant as they do not affect the geometry of pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the `current_pos` satisfies the goal for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time\n    # a goal state is reached (i.e., its path is popped from the queue), that path is the shortest.\n    if is_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move\n      # to a cell *adjacent* to it and then perform a `USE` action to pick it up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No `USE` action is typically needed.\n      # We check if the primitive_idx layer at the current position has a count greater than 0.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, no additional action needed beyond movement.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries (0 <= x < WIDTH, 0 <= y < HEIGHT).\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this position hasn't been visited yet, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and the queue becomes empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T23:25:20.615725", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with enhanced comments and clarity for pathfinding to collect a primitive.\n\n    This function uses Breadth-First Search (BFS) to find the shortest sequence of actions\n    to collect a specified primitive resource. Collection involves either moving onto\n    the primitive's cell (for grabbable items) or moving adjacent and performing a 'USE'\n    action (for non-grabbable, interactable items like water or stone).\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation environment.\n        primitive (str): The name of the primitive resource to collect (e.g., \"WOOD\", \"STONE\", \"WATER\").\n\n    Returns:\n        List[int]: A sequence of action indices (from craft.py) to execute to collect the primitive.\n                   Returns an empty list if the primitive is already collected, is not a collectible\n                   primitive resource, or if no path to it can be found.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Retrieve the integer index for the target primitive from the cookbook's index.\n  primitive_idx = cookbook.index.index(primitive)\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # --- Initial Checks for Early Exit ---\n\n  # 1. Check if the target 'primitive' is a recognized collectible resource.\n  #    The DSL lists some items like 'BOUNDARY' or 'WORKSHOP' as 'primitives',\n  #    but these are typically environmental features, not resources to be 'collected'.\n  #    Only items in `cookbook.primitives` are actual resources that can be gathered.\n  if primitive_idx not in cookbook.primitives:\n      return [] # Not a collectible primitive resource, so no actions are needed.\n\n  # 2. If the primitive is a grabbable item (e.g., WOOD, IRON) and it's already\n  #    present in the agent's inventory, no further actions are required.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # --- Define Movement Mappings and Constants ---\n\n  # Map action IDs (from craft.py) to their effect on (row_delta, col_delta, new_facing_direction).\n  # Agent directions: 0=North(UP), 1=East(RIGHT), 2=South(DOWN), 3=West(LEFT).\n  # When agent moves, it automatically faces the direction of movement.\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Action: Move UP (North). Result: (row-1, col), face North (dir 0).\n      craft.RIGHT: ( 0,  1, 1), # Action: Move RIGHT (East). Result: (row, col+1), face East (dir 1).\n      craft.DOWN:  ( 1,  0, 2), # Action: Move DOWN (South). Result: (row+1, col), face South (dir 2).\n      craft.LEFT:  ( 0, -1, 3)  # Action: Move LEFT (West). Result: (row, col-1), face West (dir 3).\n  }\n  \n  # Map agent facing direction to the (row_delta, col_delta) of the cell directly in front.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache frequently used indices for performance and readability.\n  non_grabbable_indices = world.non_grabbable_indices\n  grabbable_indices = world.grabbable_indices\n  workshop_indices = world.workshop_indices\n  water_index = world.water_index\n  stone_index = world.stone_index\n\n  # --- Helper Function: Determines if a grid cell is traversable ---\n  def _is_walkable(r: int, c: int) -> bool:\n      \"\"\"Checks if the given grid cell (r, c) is a valid and walkable location for the agent.\"\"\"\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # 2. Check for globally impassable terrains like deep water or solid stone.\n      #    Agent cannot move onto these, even if they are the target primitive (e.g., WATER, STONE\n      #    source blocks require being adjacent to be 'used').\n      if current_state.grid[r, c, water_index] == 1 or \\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # 3. Check for other non-grabbable obstacles.\n      #    Workshops are a special type of non-grabbable entity that ARE walkable (agent can stand on them).\n      for idx in non_grabbable_indices:\n          # Skip specific non-grabbable types that are handled (water, stone) or are always walkable (workshops).\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue \n          \n          # If the cell contains any other non-grabbable item (e.g., a hard wall), it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is considered walkable.\n\n  # --- Breadth-First Search (BFS) for Shortest Path ---\n\n  # Initialize the BFS queue. Each element is a tuple:\n  # (current_row, current_col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is uniquely defined by (row, col, facing_direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # --- Goal Check: Has the primitive been collected from the current state? ---\n\n      # Case 1: Target primitive is grabbable (e.g., WOOD, IRON, GOLD).\n      # Agent collects it by simply moving onto its cell.\n      if primitive_idx in grabbable_indices:\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Goal reached: Agent is on the grabbable item.\n\n      # Case 2: Target primitive is non-grabbable but interactable (e.g., STONE, WATER).\n      # Agent needs to be adjacent to it, facing it, then perform a 'USE' action.\n      # This check is only relevant if `primitive_idx` is also a valid `cookbook.primitive`.\n      elif primitive_idx in non_grabbable_indices: # Already confirmed `primitive_idx` is in `cookbook.primitives`\n          # Calculate coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n          \n          # Check if the cell in front is within bounds and contains the target primitive.\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and \\\n             current_state.grid[front_r, front_c, primitive_idx] == 1:\n              return path + [craft.USE] # Goal reached: Agent is adjacent and can 'USE' the item.\n\n      # --- Explore Possible Movements from Current State ---\n      # For each possible move action (UP, DOWN, LEFT, RIGHT):\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc # Calculate the next cell's coordinates.\n          next_state_dir = next_dir_after_move # The new facing direction after moving.\n\n          # Check if the proposed next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_dir)\n              \n              # If this state (position + direction) hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_state_dir, path + [action_id]))\n\n  # If the BFS queue becomes empty and no path was found, it means the primitive is unreachable.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:25:21.817522", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive)\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Initial checks:\n  # A. If the primitive is not a recognized collectible resource in the cookbook's primitives set,\n  #    then it cannot be \"collected\" by this function.\n  if primitive_idx not in cookbook.primitives:\n      return [] \n\n  # B. If the primitive is a grabbable item (like WOOD, IRON) and we already have it in inventory,\n  #    no actions are needed to collect it.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Format: action_id: (row_delta, col_delta, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Moving up makes agent face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Moving right makes agent face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Moving down makes agent face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Moving left makes agent face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  # Used for checking targets for the 'USE' action.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access and clearer logic.\n  # Convert lists to sets for O(1) average time complexity for 'in' checks.\n  non_grabbable_indices_set = set(world.non_grabbable_indices)\n  grabbable_indices_set = set(world.grabbable_indices)\n  workshop_indices_set = set(world.workshop_indices)\n  water_index = world.water_index\n  stone_index = world.stone_index\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  # A cell is walkable if it's within bounds and does not contain impassable objects.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for globally impassable terrains (like water and stone).\n      # These are typically non-grabbable and block movement.\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles that block movement.\n      # Workshops are special non-grabbable entities that *are* walkable (agent can stand on them).\n      # Any other non-grabbable entity (excluding water/stone already checked) will block movement.\n      for idx in non_grabbable_indices_set:\n          if idx == water_index or idx == stone_index or idx in workshop_indices_set:\n              continue # These are either handled by global checks or are explicitly walkable.\n          \n          # If the cell contains any other non-grabbable item not in the above exceptions, it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is considered walkable.\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the collection goal.\n      # A. If the primitive is grabbable (e.g., WOOD, IRON, GRASS):\n      #    The goal is achieved when the agent moves onto the cell containing the primitive.\n      if primitive_idx in grabbable_indices_set:\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found to a grabbable item's location.\n\n      # B. If the primitive is non-grabbable and collectible (e.g., STONE or WATER source, if it's the target):\n      #    The goal is achieved when the agent is adjacent to the primitive, facing it, and performs a 'USE' action.\n      #    We must ensure it's specifically a *collectible* non-grabbable from the `cookbook.primitives` set.\n      elif primitive_idx in non_grabbable_indices_set and primitive_idx in cookbook.primitives:\n          front_dr, front_dc = DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n          \n          # Check bounds for the cell directly in front of the agent.\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the primitive, we can collect it with USE.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next cell is walkable before adding to queue.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the queue becomes empty and no path was found to the primitive, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T23:26:02.081674", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Define indices for truly impassable terrain (blocking movement).\n  # Based on common grid-world conventions, BOUNDARY and WATER are usually movement blockers.\n  IMPASSABLE_NAMES = ['BOUNDARY', 'WATER']\n  impassable_indices = {\n      cookbook.index[name] for name in IMPASSABLE_NAMES \n      if name in cookbook.index.contents # Ensure the name exists in the index\n  }\n\n  # Helper function to check if a cell is traversable.\n  # A cell is traversable if it's within bounds and does not contain any of the explicitly defined impassable entities.\n  def is_cell_traversable(x, y):\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Contains an impassable object\n      return True\n\n  # Check if the agent's starting position is traversable. If not, no path is possible.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any traversable cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for px, py in primitive_locations: # Primitive location\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        tx, ty = px + dx_n, py + dy_n # Potential target cell for the agent\n        \n        # A potential target cell must be within grid bounds AND traversable by the agent\n        if is_cell_traversable(tx, ty):\n          bfs_target_cells.add((tx, ty))\n\n  # If no valid traversable target cells exist (e.g., primitive is surrounded by impassable terrain\n  # or there are no traversable spots in its 3x3 neighborhood), no path is possible.\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # If the current position is one of our valid target cells, we found the shortest path.\n    if current_pos in bfs_target_cells:\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Standard cardinal directions\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries, is traversable, and hasn't been visited\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.5}}
