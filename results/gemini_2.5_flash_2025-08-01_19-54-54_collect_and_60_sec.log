{"timestamp": "2025-08-02T05:23:58.261015", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Agent's current (x, y) position\n  cookbook = env.world.cookbook\n  \n  # Attempt to get the integer ID for the target primitive from the cookbook.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook's index, it's unknown.\n    return []\n\n  # Retrieve integer action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT, _ = grid.shape # Unpack grid dimensions.\n\n  # Identify entity indices that represent impassable terrain.\n  # Based on CraftWorld typical mechanics, 'WATER' and 'BOUNDARY' are common blockers.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a cell (x, y) is within grid boundaries\n  # and does not contain any impassable entity.\n  def is_traversable(x: int, y: int) -> bool:\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Position is out of bounds.\n    \n    # Check if any impassable kind is present at this cell.\n    # The grid[:, :, idx] gives a 2D map for a specific kind.\n    # grid[x, y, idx] == 1 means that kind is present at (x, y).\n    for idx in impassable_kind_indices:\n      if grid[x, y, idx] == 1:\n        return False  # Cell contains an obstacle.\n    return True\n\n  # Find all grid coordinates where the target primitive is located.\n  # np.argwhere returns an array of (row, col) indices where the condition is true.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive does not exist on the grid, it cannot be collected.\n    return []\n\n  # --- Initial Check: Is the agent already adjacent to the primitive? ---\n  # If the agent is within a 3x3 neighborhood of *any* primitive instance,\n  # a single 'USE' action is sufficient.\n  # `state.next_to` directly checks this for the current agent position.\n  if state.next_to(primitive_idx):\n    return [USE]\n\n  # --- Breadth-First Search (BFS) for Shortest Pathfinding ---\n  # The queue stores tuples: ((current_x, current_y), [list_of_actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set keeps track of (x, y) positions already explored to prevent loops.\n  visited = {agent_pos}\n\n  # Define the (dx, dy) changes for each cardinal movement action.\n  move_deltas = {\n      UP: (0, -1),   # Moving UP decreases the Y-coordinate.\n      DOWN: (0, 1),   # Moving DOWN increases the Y-coordinate.\n      LEFT: (-1, 0),  # Moving LEFT decreases the X-coordinate.\n      RIGHT: (1, 0),  # Moving RIGHT increases the X-coordinate.\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue current position and its path.\n\n    # Explore all four possible movement directions from the current position.\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the coordinates of the neighboring cell.\n      new_position = (nx, ny)\n\n      # Check if the new position is traversable (within bounds and no obstacles)\n      # and has not been visited in this BFS search.\n      if is_traversable(nx, ny) and new_position not in visited:\n        new_path_actions = path_actions + [action_type] # Build the path to this new position.\n        \n        # Check if this new position (nx, ny) is adjacent to any of the primitive locations.\n        # Adjacency here means Chebyshev distance (max(abs(dx), abs(dy))) <= 1.\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations_on_grid:\n          if max(abs(nx - px), abs(ny - py)) <= 1:\n            is_adjacent_to_primitive = True\n            break # Found an adjacent primitive, no need to check other locations.\n        \n        if is_adjacent_to_primitive:\n          # If a path is found to a cell adjacent to a primitive,\n          # append the 'USE' action and return this complete sequence.\n          # BFS guarantees this is the shortest sequence of movement actions.\n          return new_path_actions + [USE]\n        else:\n          # If not yet adjacent to a primitive, add this new position to the queue\n          # for further exploration and mark it as visited.\n          visited.add(new_position)\n          queue.append((new_position, new_path_actions))\n        \n  # If the BFS completes (queue becomes empty) and no path to an adjacent primitive\n  # was found, it implies the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
