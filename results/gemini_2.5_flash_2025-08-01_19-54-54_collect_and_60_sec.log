{"timestamp": "2025-08-02T06:17:40.522256", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with a refined obstacle checking logic.\"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action\n  # Remember: CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  # Determine if the primitive is grabbable.\n  # Non-grabbable primitives like WORKSHOPs should not be 'USE'd for collection.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    cx, cy = current_pos\n\n    # Create a temporary CraftState object to check the 'next_to' condition\n    # This allows us to simulate the agent's position without changing the\n    # actual environment state during pathfinding.\n    # The grid, direction, and inventory remain constant for the pathfinding.\n    temp_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position\n    if temp_state.next_to(primitive_idx):\n      # If found, check if it's grabbable to decide whether to append 'USE'\n      if is_grabbable:\n        return current_path + [USE]\n      else:\n        # If not grabbable (e.g., a workshop), just return the path to get next to it.\n        # The 'collect' action in DSL for non-grabbable items implies getting adjacent to them.\n        return current_path\n\n    # Explore valid neighbors\n    for action, (dx, dy) in moves:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue # Out of bounds\n\n      # Check for obstacles: A cell is considered an obstacle if it contains any\n      # entity from the `non_grabbable_indices` set. These are typically impassable terrains\n      # or structures like water, stone, or workshops.\n      is_blocked = False\n      for blocking_idx in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, blocking_idx] == 1:\n              is_blocked = True\n              break\n      \n      if is_blocked:\n          continue # Cannot move into a blocked cell\n\n      # Check if the next position has already been visited\n      if next_pos not in visited:\n        visited.add(next_pos)\n        queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T06:18:47.567992", "function_name": "collect", "function_body": "  # 1. Initialize State and World Components\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  \n  # 2. Map Primitive Name to its Integer ID\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 3. Get Action Mappings\n  # These are the integer codes for each possible agent action.\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # Define relative position changes (dx, dy) for each movement action for BFS.\n  move_deltas = {\n      UP: (0, -1),   # Y-axis is inverted (UP is decrease in Y)\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # 4. Identify Blocking Entities\n  # These are entities on the grid that the agent cannot walk through.\n  blocking_kind_indices = set()\n  # Typically, water and boundary elements are impassable.\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  # Note: Workshops are generally non-grabbable but often traversable,\n  # so they are not included in `blocking_kind_indices` here.\n\n  # 5. Pre-compute Traversability Map for Efficiency\n  # Create a boolean 2D array indicating which grid cells are walkable.\n  traversable_map = np.full((WIDTH, HEIGHT), True, dtype=bool)\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # A cell is non-traversable if it contains any blocking kind.\n      is_blocked = False\n      for blocking_idx in blocking_kind_indices:\n        if grid[x, y, blocking_idx] == 1:\n          is_blocked = True\n          break # Found a blocking entity, no need to check others for this cell\n      if is_blocked:\n        traversable_map[x, y] = False\n  \n  # Helper function to quickly check if a position is traversable using the pre-computed map.\n  def is_traversable(x: int, y: int) -> bool:\n    # Check grid bounds first.\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  \n    return traversable_map[x, y]\n\n  # 6. Find All Locations of the Primitive on the Grid\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # The primitive does not exist on the current grid, so it cannot be collected.\n    return []\n\n  # 7. Determine Valid \"Target USE Locations\"\n  # These are traversable cells from which the agent can successfully apply 'USE'\n  # to collect the primitive (i.e., they are within 3x3 neighborhood of a primitive instance).\n  target_use_locations = set()\n  for px, py in primitive_locations_on_grid:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    # The 'USE' action typically works on anything in a 3x3 area around the agent.\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Only add positions that are within bounds and traversable.\n        if is_traversable(nx, ny):\n          target_use_locations.add((nx, ny))\n  \n  # If there are no valid, traversable positions from which the primitive can be used,\n  # it means it's effectively unreachable or un-collectable.\n  if not target_use_locations:\n      return []\n\n  # 8. Initial Check: Is the agent already positioned to collect the primitive?\n  # `state.next_to` checks if the primitive is in the agent's 3x3 neighborhood.\n  if state.next_to(primitive_idx):\n      # If so, only the 'USE' action is needed. This is the shortest path possible.\n      return [USE]\n\n  # 9. Breadth-First Search (BFS) to Find the Shortest Path\n  # The BFS aims to find the minimum sequence of movement actions to reach\n  # any of the `target_use_locations`.\n  \n  # Queue for BFS: stores tuples of ((current_x, current_y), [list_of_actions_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])]) \n  # Set to keep track of visited grid cells to prevent cycles and redundant exploration.\n  visited = {agent_pos} \n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue the current position and its path.\n\n    # Explore all four possible movement directions from the current cell.\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the coordinates of the next potential position.\n\n      # Check if the new position is valid (within grid bounds), traversable (not blocked),\n      # and has not been visited yet in this BFS traversal.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_position = (nx, ny)\n        new_path_actions = path_actions + [action_type] # Extend the sequence of actions.\n        \n        # If this new position is one of our designated target_use_locations,\n        # we have found the shortest path.\n        if new_position in target_use_locations:\n          # Append the 'USE' action to the path and return the complete sequence.\n          return new_path_actions + [USE]\n        else:\n          # If not a target, add this new position to the queue for further exploration\n          # and mark it as visited to avoid redundant processing.\n          visited.add(new_position)\n          queue.append((new_position, new_path_actions))\n        \n  # 10. Primitive Unreachable\n  # If the BFS queue becomes empty and no path to any `target_use_location` was found,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
