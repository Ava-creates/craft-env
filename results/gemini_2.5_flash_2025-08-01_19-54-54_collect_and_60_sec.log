{"timestamp": "2025-08-02T08:52:27.768799", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Improvement for v2: Check if the primitive is already in the agent's inventory.\n  # If it is, no collection actions are needed. This addresses \"use already available items\".\n  if state.inventory[primitive_idx] > 0:\n    return [] # Primitive is already collected.\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Pre-determine properties of the target primitive for goal checking efficiency\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Optimization: If the current path is already longer than or equal to \n    # the best path found so far, there's no need to explore this branch further.\n    # Because BFS explores layer by layer, any path popped at this length or greater\n    # cannot be shorter than what's already recorded for `min_path_len`.\n    if len(current_actions) >= min_path_len:\n      continue \n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # We don't break here because BFS guarantees the shortest path to any *node*.\n      # Our \"goal\" might be a complex condition (e.g., `next_to` which covers multiple cells,\n      # or combining movement with a `USE` action). We need to exhaust the BFS to find the globally \n      # shortest sequence of actions considering all possible goal locations/conditions.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries and hasn't been visited\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Before adding to queue, check if adding this path (current_actions + [action])\n        # would exceed or equal the current best path length. This is an additional\n        # pruning step specifically for cases where the target is not a single point\n        # but a condition like `next_to`.\n        if len(current_actions) + 1 < min_path_len:\n          if new_pos not in visited:\n            visited.add(new_pos)\n            q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:52:40.130202", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action\n  # Remember: CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    cx, cy = current_pos\n\n    # Create a temporary CraftState object to check the 'next_to' condition\n    # This allows us to simulate the agent's position without changing the\n    # actual environment state during pathfinding.\n    # The grid, direction, and inventory remain constant for the pathfinding.\n    temp_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position\n    if temp_state.next_to(primitive_idx):\n      # If found, append the 'USE' action and return the complete path\n      return current_path + [USE]\n\n    # Explore valid neighbors\n    for action, (dx, dy) in moves:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position has already been visited\n        if next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:52:41.234672", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible moves as (action, (dx, dy)) tuples\n  # (dx, dy) represent the change in (x, y) coordinates for each action\n  # Remember: CraftWorld uses (x, y) where x is horizontal, y is vertical.\n  # DOWN increases y, UP decreases y, RIGHT increases x, LEFT decreases x.\n  moves = [\n      (UP, (0, -1)),\n      (DOWN, (0, 1)),\n      (LEFT, (-1, 0)),\n      (RIGHT, (1, 0))\n  ]\n\n  # Breadth-First Search (BFS) for the shortest path\n  # queue stores (current_position_tuple, path_list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # visited set stores positions (x, y) to avoid cycles and redundant processing\n  visited = {agent_pos}\n\n  while queue:\n    current_pos, current_path = queue.popleft()\n    cx, cy = current_pos\n\n    # Create a temporary CraftState object to check the 'next_to' condition\n    # This allows us to simulate the agent's position without changing the\n    # actual environment state during pathfinding.\n    # The grid, direction, and inventory remain constant for the pathfinding.\n    temp_state = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the primitive is in the 3x3 neighborhood of the current position\n    if temp_state.next_to(primitive_idx):\n      # If found, append the 'USE' action and return the complete path\n      return current_path + [USE]\n\n    # Explore valid neighbors\n    for action, (dx, dy) in moves:\n      next_x, next_y = cx + dx, cy + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the next position has already been visited\n        if next_pos not in visited:\n          visited.add(next_pos)\n          queue.append((next_pos, current_path + [action]))\n  \n  # If the queue becomes empty and no path was found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:53:26.819258", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Directly access the grid from the state\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in the cookbook, cannot collect it.\n    return []\n\n  # IMPROVEMENT for collect_v2:\n  # Check if the primitive is already in the inventory. If so, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # Get action mappings (integer IDs) from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) setup for pathfinding.\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {start_pos} \n\n  # Initialize variables to store the shortest path found.\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine the type of primitive to apply appropriate collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, or boundary are \"collected\" by simply reaching their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Check if the current position satisfies the goal for collecting the primitive.\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Actions required once at the target position/adjacency (e.g., USE)\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then use ACTION_USE.\n      # Manually check the 3x3 neighborhood around current_pos for the primitive_idx.\n      found_adjacent = False\n      for nx in range(max(0, current_pos[0] - 1), min(WIDTH, current_pos[0] + 2)):\n          for ny in range(max(0, current_pos[1] - 1), min(HEIGHT, current_pos[1] + 2)):\n              if grid[nx, ny, primitive_idx] > 0:\n                  found_adjacent = True\n                  break\n          if found_adjacent:\n              break\n      \n      if found_adjacent:\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundaries, \"collecting\" means simply being on their cell.\n      # Check if the primitive is present at the current cell.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No additional action like USE is typically needed.\n    \n    # If a goal state is reached, update the `best_path_actions` if the current path is shorter.\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Do NOT break here. BFS finds the shortest path to *any node*.\n      # To find the shortest *sequence of actions* that satisfies the goal (which might include an ACTION_USE\n      # after reaching a position, or being adjacent), we must explore all paths.\n\n    # Explore neighbors of the current position.\n    for dx, dy, action_id in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action_id]))\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  return best_path_actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:53:27.957510", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid \n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in the cookbook, cannot collect it.\n    return []\n\n  # Get action mappings (integer IDs) from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) setup for pathfinding.\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {start_pos} \n\n  # Determine the type of primitive to apply appropriate collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, or boundary are \"collected\" by simply reaching their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Check if the current position satisfies the goal for collecting the primitive.\n    \n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then use ACTION_USE.\n      # Check the 3x3 neighborhood around current_pos for the primitive_idx.\n      found_adjacent = False\n      for nx in range(max(0, current_pos[0] - 1), min(WIDTH, current_pos[0] + 2)):\n          for ny in range(max(0, current_pos[1] - 1), min(HEIGHT, current_pos[1] + 2)):\n              if grid[nx, ny, primitive_idx] > 0:\n                  found_adjacent = True\n                  break\n          if found_adjacent:\n              break\n      \n      if found_adjacent:\n        # Shortest path found to a position from which the item can be collected.\n        # Since this is a BFS on an unweighted graph, the first path found is the shortest.\n        return current_actions + [ACTION_USE]\n    \n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundaries, \"collecting\" means simply being on their cell.\n      # Check if the primitive is present at the current cell.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # Shortest path found to a cell containing the item.\n        # Since this is a BFS on an unweighted graph, the first path found is the shortest.\n        return current_actions # No additional action like USE is typically needed.\n    \n    # Explore neighbors of the current position.\n    for dx, dy, action_id in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      # Assuming all non-boundary cells within grid are traversable unless specified otherwise.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action_id]))\n  \n  # If the BFS completes without finding the primitive, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:54:20.250664", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Determine if the target primitive is a grabbable item (can be picked up into inventory).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 2. If the primitive is grabbable and already in the inventory, no actions are needed.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Get the index for 'BOUNDARY' to check for impassable cells\n  boundary_idx = cookbook.index['BOUNDARY']\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    else: # This covers all non-grabbable items like workshops, water, stone, boundary.\n          # For these, \"collecting\" means reaching the location itself.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      # BFS finds the shortest path to a *cell*. However, our \"goal\" might be\n      # to be adjacent to a resource and then use it, or to be on a specific cell.\n      # We continue searching to ensure we find the shortest *overall sequence*\n      # of (movement + optional USE) actions.\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position is traversable.\n        # The agent cannot move onto a 'BOUNDARY' cell.\n        is_boundary_at_new_pos = False\n        if boundary_idx is not None and grid[new_x, new_y, boundary_idx] > 0:\n            is_boundary_at_new_pos = True\n\n        if new_pos not in visited and not is_boundary_at_new_pos:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:54:21.560206", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # 2. If the primitive is already in the inventory, no actions are needed.\n  # This avoids unnecessary pathfinding if the goal is already met.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Get boundary index for obstacle checking during BFS.\n  # Boundary cells are typically impassable.\n  boundary_idx = cookbook.index['BOUNDARY']\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    else: \n      # For non-grabbable items (workshops, water, stone, boundary), \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      # If we found a path of equal or shorter length, update the best path.\n      # BFS guarantees the shortest path to any *cell*. By processing all neighbors\n      # before expanding further, we ensure we find the shortest sequence of (move + optional USE) actions.\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # We do NOT break here. This is crucial because a goal like `next_to`\n      # can be satisfied from multiple adjacent cells, and the shortest *overall*\n      # sequence (moves + potential USE action) might involve a slightly longer\n      # movement path to a different adjacent cell.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      is_in_bounds = 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT\n\n      # Check if the new position contains an impassable 'BOUNDARY'\n      # The agent cannot move onto a boundary cell.\n      is_boundary_cell = False\n      if boundary_idx is not None and is_in_bounds:\n        if grid[new_x, new_y, boundary_idx] > 0:\n          is_boundary_cell = True\n\n      # Only add valid and unvisited positions to the queue\n      if is_in_bounds and new_pos not in visited and not is_boundary_cell:\n        visited.add(new_pos)\n        q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T08:55:33.993050", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This version refines the BFS pathfinding for primitive collection, enhancing clarity\n    and consistency in variable naming and conditional logic. It handles grabbable items\n    (requiring adjacency + USE), stationary environment features like workshops, water, stone\n    (requiring reaching the location), and the special case for pathfinding directly to a 'BOUNDARY'.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive to collect (e.g., 'WOOD', 'WORKSHOP0').\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is already collected or unreachable.\n  \"\"\"\n  # Retrieve essential components from the environment state.\n  current_state = env._current_state\n  world_config = env.world\n  cookbook = world_config.cookbook\n  current_grid = current_state.grid \n  agent_current_pos = current_state.pos\n\n  # 1. Map the primitive name (string) to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Cache action IDs for direct use and readability.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define cardinal movement offsets (dx, dy) and their corresponding action IDs.\n  # Assuming (0,0) is top-left, x increases rightwards, y increases downwards.\n  MOVEMENT_OPTIONS = [\n      (0, -1, ACTION_UP),    # North: Decreases Y-coordinate.\n      (0, 1, ACTION_DOWN),   # South: Increases Y-coordinate.\n      (-1, 0, ACTION_LEFT),  # West: Decreases X-coordinate.\n      (1, 0, ACTION_RIGHT),  # East: Increases X-coordinate.\n  ]\n\n  # Get grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = current_grid.shape\n\n  # Identify the 'BOUNDARY' kind index, which typically represents impassable terrain.\n  boundary_kind_idx = cookbook.index['BOUNDARY'] if 'BOUNDARY' in cookbook.index.contents else None\n  \n  # Determine the collection type and properties of the target primitive.\n  is_primitive_grabbable = primitive_idx in world_config.grabbable_indices\n  is_primitive_workshop = primitive_idx in world_config.workshop_indices\n  is_primitive_stationary_env_feature = (primitive_idx == world_config.water_index or \n                                         primitive_idx == world_config.stone_index)\n  # Special case: If the collection target itself IS the boundary (e.g., \"collect boundary\").\n  is_primitive_target_boundary = (boundary_kind_idx is not None and primitive_idx == boundary_kind_idx)\n\n  # 2. Early exit check: Is the primitive already \"collected\" at the current state?\n  # For grabbable items, \"collected\" means present in the agent's inventory.\n  if is_primitive_grabbable and current_state.inventory[primitive_idx] > 0:\n    return [] \n  # For non-grabbable targets (workshops, stationary features, or boundary itself),\n  # \"collected\" means the agent is currently standing directly on a cell containing that primitive.\n  elif (is_primitive_workshop or is_primitive_stationary_env_feature or is_primitive_target_boundary) and \\\n       current_grid[agent_current_pos[0], agent_current_pos[1], primitive_idx] > 0:\n    return [] \n\n  # 3. Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_this_position).\n  bfs_queue = collections.deque([(agent_current_pos, [])]) \n  # The `visited_positions` set tracks explored grid coordinates to prevent redundant work and cycles.\n  visited_positions = {agent_current_pos} \n\n  # BFS loop: Continues as long as there are positions to explore in the queue.\n  while bfs_queue:\n    current_path_pos, actions_taken_so_far = bfs_queue.popleft()\n    \n    # Create a temporary CraftState instance for checking conditions at `current_path_pos`.\n    # This allows leveraging `CraftState` methods (e.g., `next_to`, `grid` checks)\n    # as if the agent were physically at `current_path_pos`.\n    # Agent's direction and inventory are kept constant as they do not affect spatial pathfinding here.\n    temp_state_at_path_pos = craft.CraftState(current_state.scenario, current_grid, \n                                              current_path_pos, current_state.dir, \n                                              current_state.inventory)\n\n    # 4. Check if `current_path_pos` is a valid goal state for collecting the primitive.\n    is_goal_achieved = False\n    final_actions_at_goal = [] # Actions required once at the goal location (e.g., a 'USE' action).\n\n    if is_primitive_grabbable:\n      # For grabbable items, the agent needs to be adjacent to the primitive and then perform ACTION_USE.\n      if temp_state_at_path_pos.next_to(primitive_idx):\n        is_goal_achieved = True\n        final_actions_at_goal = [ACTION_USE]\n    elif is_primitive_workshop or is_primitive_stationary_env_feature or is_primitive_target_boundary:\n      # For workshops, stationary environment features, or the boundary itself,\n      # merely reaching the cell where the primitive is located is sufficient.\n      if temp_state_at_path_pos.grid[current_path_pos[0], current_path_pos[1], primitive_idx] > 0:\n        is_goal_achieved = True\n        final_actions_at_goal = [] # No additional action like 'USE' is required.\n    \n    # If a goal state is achieved at `current_path_pos`, return the complete sequence of actions.\n    # BFS guarantees that the first path found is the shortest in an unweighted graph.\n    if is_goal_achieved:\n      return actions_taken_so_far + final_actions_at_goal\n\n    # 5. Explore neighboring cells from `current_path_pos`.\n    for dx, dy, action in MOVEMENT_OPTIONS:\n      next_x, next_y = current_path_pos[0] + dx, current_path_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT:\n        # Determine if the new position is an impassable obstacle.\n        # An obstacle is a 'BOUNDARY' cell, UNLESS 'BOUNDARY' itself is the primitive we are trying to collect.\n        is_impassable_obstacle = (boundary_kind_idx is not None and \n                                  current_grid[next_x, next_y, boundary_kind_idx] > 0 and \n                                  not is_primitive_target_boundary)\n\n        # If the new position has not been visited and is not an impassable obstacle, add it to the BFS queue.\n        if next_pos not in visited_positions and not is_impassable_obstacle:\n          visited_positions.add(next_pos) # Mark the new position as visited.\n          bfs_queue.append((next_pos, actions_taken_so_far + [action])) # Add to queue with updated path.\n  \n  # If the BFS completes (queue becomes empty) and no path to the primitive was found,\n  # it means the primitive is unreachable from the current position in the given environment.\n  return []", "island_id": 5, "scores": {"3": 0.5}}
