{"timestamp": "2025-08-02T01:48:08.255657", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # 1. Input Validation and Early Exits\n  # Get the integer index for the primitive.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name is not recognized by the cookbook.\n    return []\n\n  # A 'collect' action implies adding to inventory. Thus, the item must be grabbable.\n  # Non-grabbable items include environmental features like workshops, boundaries, water.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # If the primitive is already in the agent's inventory, no collection is needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  \n  # Map action names from the DSL to their integer representations.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (dx, dy) movement vectors to corresponding action indices.\n  # This is used to reconstruct the path from the BFS parent pointers.\n  dir_to_action = {\n      (0, -1): UP,   # Move North (decrease Y)\n      (0, 1): DOWN,  # Move South (increase Y)\n      (-1, 0): LEFT, # Move West (decrease X)\n      (1, 0): RIGHT, # Move East (increase X)\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify entity indices that represent impassable terrain.\n  # These are typically 'BOUNDARY' and 'WATER' in CraftWorld.\n  impassable_indices = set()\n  # Add specific impassable entities if they exist in the cookbook's index.\n  for item_name in ['BOUNDARY', 'WATER']:\n      if item_name in cookbook.index.contents:\n          impassable_indices.add(cookbook.index[item_name])\n\n  # Helper function to determine if a given grid cell is traversable by the agent.\n  def is_cell_traversable(x: int, y: int) -> bool:\n      # Check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds.\n\n      # Check if the cell contains any identified impassable object.\n      # Assuming grid uses one-hot encoding for entities at each cell.\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Cell contains an impassable object.\n      return True # Cell is within bounds and does not contain impassable objects.\n\n  # Before starting BFS, check if the agent's current position is traversable.\n  # If not, no path can be found from this starting point.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # 2. Locate Primitive on the Grid\n  # Find all (x, y) coordinates where the primitive item is present on the grid.\n  # np.argwhere returns a list of [x, y] arrays for non-zero elements.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # The primitive is not visible on the current grid.\n    return []\n\n  # 3. Define BFS Target Cells\n  # A target cell for BFS is any traversable cell from which the agent can successfully\n  # interact with (i.e., 'USE') the primitive. `CraftState.next_to` implies the\n  # 'USE' action operates on any cell within the 3x3 neighborhood of the agent's position.\n  bfs_target_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood around each primitive location.\n    # This includes the primitive's own cell and all 8 surrounding cells.\n    for dx_offset in [-1, 0, 1]:\n      for dy_offset in [-1, 0, 1]:\n        nx, ny = px + dx_offset, py + dy_offset\n        \n        # Add the neighboring cell to the set of BFS targets if it's traversable.\n        if is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no traversable target cells exist (e.g., all primitives are surrounded by impassable terrain),\n  # then the primitive cannot be reached.\n  if not bfs_target_cells:\n      return []\n\n  # 4. Perform Breadth-First Search (BFS)\n  # BFS finds the shortest path from the agent's current position to any of the target cells.\n  q = collections.deque([agent_pos])\n  visited = {agent_pos} # Keep track of visited cells to avoid cycles and redundant paths.\n  parent = {agent_pos: None} # Stores parent pointers for path reconstruction. (child_pos: parent_pos)\n\n  target_reached_pos = None # Stores the specific target cell that was reached first.\n\n  while q:\n    current_pos = q.popleft()\n    \n    # If the current position is one of our valid target cells, we found the shortest path.\n    if current_pos in bfs_target_cells:\n      target_reached_pos = current_pos\n      break # Exit BFS, as we found the shortest path to an interaction point.\n\n    # Explore all 4-directional neighbors (UP, DOWN, LEFT, RIGHT).\n    # Diagonal moves are generally not allowed in CraftWorld's basic movement.\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is valid (within bounds, traversable, and not yet visited).\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        parent[next_pos] = current_pos # Record parent for path reconstruction.\n        q.append(next_pos)\n  \n  # 5. Path Reconstruction\n  if target_reached_pos is None:\n    # If BFS completes without reaching any target cell, the primitive is unreachable.\n    return []\n  \n  # Reconstruct the path by backtracking from the target_reached_pos to the agent_pos.\n  path_to_target = []\n  current = target_reached_pos\n  while parent[current] is not None:\n    prev = parent[current]\n    # Determine the action taken to move from `prev` to `current`.\n    dx, dy = current[0] - prev[0], current[1] - prev[1]\n    path_to_target.append(dir_to_action[(dx, dy)])\n    current = prev\n  \n  path_to_target.reverse() # The path was built in reverse; reverse it to get correct order.\n  \n  # 6. Final Action Sequence\n  # After reaching the target cell, the 'USE' action is performed to collect the primitive.\n  return path_to_target + [USE]", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:48:37.418758", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Resolve the primitive name to its integer ID.\n  primitive_idx = cookbook.index.get(primitive) \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook, it's an invalid target.\n    return []\n\n  # 2. Get action integer mappings from the environment's specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define possible relative movements (dx, dy) and their corresponding action IDs.\n  # These are used to explore adjacent cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  # 4. Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Agent's current starting position.\n  start_pos = state.pos\n\n  # 6. Initialize Breadth-First Search (BFS) structures.\n  # The queue stores tuples: (current_position (x,y), list_of_actions_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set tracks explored positions to prevent cycles and redundant processing.\n  visited = {start_pos} \n\n  # 7. Categorize the primitive type to determine the \"collection\" condition.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special stationary primitives like water, stone, or boundary.\n  # These are \"collected\" by simply reaching their location, no `USE` action is needed.\n  is_stationary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      primitive_idx == cookbook.index.get('BOUNDARY') # Use .get() for safety\n  )\n  \n  # 8. Execute BFS to find the shortest path to the primitive.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) or directly inspect\n    # the `grid` as if the agent were at this specific location during pathfinding.\n    # We maintain the original scenario, grid, direction, and inventory for this temporary state.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the goal condition for collecting the primitive is met at `current_pos`.\n    # BFS guarantees that the first path found is the shortest for unweighted graphs.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent\n      # to the item and then perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops (e.g., BENCH) or stationary environment primitives (WATER, STONE),\n      # \"collecting\" means reaching the exact cell where the item is located.\n      # Check if the target primitive kind exists at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, no additional action (like USE) needed.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos) # Mark as visited\n          # Enqueue the new position along with the accumulated path to reach it.\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and the queue is empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-02T01:48:38.601510", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not have an ID, we cannot collect it.\n    return []\n\n  # 2. Retrieve action mappings (integer IDs) from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define possible movements (change in x, change in y) and their corresponding action IDs.\n  # This list helps iterate over adjacent cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # 4. Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Agent's current starting position in the grid.\n  start_pos = state.pos\n\n  # --- BFS (Breadth-First Search) Setup ---\n  # The queue will store tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # 6. Determine the type of the target primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, or boundary.\n  # \"Collecting\" these typically means simply reaching their location without a `USE` action.\n  boundary_idx = cookbook.index.get('BOUNDARY') # Get boundary index safely\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (boundary_idx is not None and primitive_idx == boundary_idx))\n  \n  # --- BFS Algorithm Execution ---\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object representing the agent *at* `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) or directly inspect `grid` content\n    # as if the agent were physically at this specific cell during pathfinding.\n    # Agent's direction and inventory are kept constant as they do not affect the geometry of pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 7. Check if the `current_pos` satisfies the goal for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time\n    # a goal state is reached (i.e., its path is popped from the queue), that path is the shortest.\n    if is_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move\n      # to a cell *adjacent* to it and then perform a `USE` action to pick it up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No `USE` action is typically needed.\n      # We check if the primitive_idx layer at the current position has a count greater than 0.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, no additional action needed beyond movement.\n    \n    # 8. If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries (0 <= x < WIDTH, 0 <= y < HEIGHT).\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this position hasn't been visited yet, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # 9. If the BFS completes and the queue becomes empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-02T01:51:41.073001", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  \n  # Map the primitive's string name to its unique integer ID.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's an unknown item.\n    return []\n\n  # Retrieve action codes for movement and 'USE' from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Identify entity indices that represent impassable terrain.\n  # In CraftWorld, 'WATER' and 'BOUNDARY' typically block movement.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a cell is within grid bounds and traversable.\n  def is_traversable(x: int, y: int) -> bool:\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of bounds\n    \n    # Check if any impassable kind is present at this cell.\n    for idx in impassable_kind_indices:\n      if grid[x, y, idx] == 1:\n        return False  # Cell contains an obstacle\n    return True\n\n  # Locate all occurrences of the target primitive on the grid.\n  # np.argwhere returns (x, y) coordinates for non-zero elements.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not found on the grid, it cannot be collected.\n    return []\n\n  # Helper function: Check if a given position is adjacent to any of the target locations.\n  # Adjacency is defined as Chebyshev distance <= 1 (3x3 neighborhood).\n  def is_adjacent_to_any_target(current_pos, target_locations):\n    curr_x, curr_y = current_pos\n    for target_x, target_y in target_locations:\n      if max(abs(curr_x - target_x), abs(curr_y - target_y)) <= 1:\n        return True\n    return False\n\n  # --- Initial Check: Is the agent already adjacent to the primitive? ---\n  # If so, a single 'USE' action is sufficient. This is an optimization for the shortest path.\n  if is_adjacent_to_any_target(agent_pos, primitive_locations_on_grid):\n    return [USE]\n\n  # --- Breadth-First Search (BFS) for Shortest Pathfinding ---\n  # Queue stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set prevents infinite loops and redundant exploration.\n  visited = {agent_pos}\n\n  # Define the (dx, dy) for each movement action.\n  moves_directions = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue current position and its path.\n\n    # Explore all four cardinal neighbors.\n    for action_type, (dx, dy) in moves_directions.items():\n      nx, ny = cx + dx, cy + dy  # Calculate coordinates of the neighbor.\n      new_position = (nx, ny)\n\n      # Check if the neighbor is valid (traversable) and not yet visited.\n      if is_traversable(nx, ny) and new_position not in visited:\n        new_path_actions = path_actions + [action_type] # Append the action to the path.\n        \n        # Check if this new position is adjacent to any primitive location.\n        # This is the \"goal check\" for BFS: find the shortest path to *any* cell from which USE can be applied.\n        if is_adjacent_to_any_target(new_position, primitive_locations_on_grid):\n          # If an adjacent position is found, append 'USE' and return the complete path.\n          # BFS guarantees this is the shortest sequence of movement actions.\n          return new_path_actions + [USE]\n        else:\n          # If not yet adjacent, add this new position to the queue for further exploration\n          # and mark it as visited.\n          visited.add(new_position)\n          queue.append((new_position, new_path_actions))\n        \n  # If the BFS completes and the queue is empty without finding a path,\n  # the primitive is unreachable from the current agent position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:51:42.265869", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  \n  # Map the primitive's string name to its unique integer ID.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's an unknown item.\n    return []\n\n  # Check if the agent already possesses the primitive.\n  # If the goal of 'collect' is simply to have at least one of the item,\n  # and the agent already has it, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # Retrieve action codes for movement and 'USE' from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Identify entity indices that represent impassable terrain.\n  # In CraftWorld, 'WATER' and 'BOUNDARY' typically block movement.\n  impassable_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a cell is within grid bounds and traversable.\n  def is_traversable(x: int, y: int) -> bool:\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of bounds\n    \n    # Check if any impassable kind is present at this cell.\n    # The cell is non-traversable if it contains any of the blocking indices.\n    for idx in impassable_kind_indices:\n      if grid[x, y, idx] == 1:\n        return False  # Cell contains an obstacle\n    return True\n\n  # Locate all occurrences of the target primitive on the grid.\n  # np.argwhere returns (x, y) coordinates for non-zero elements.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not found on the grid, it cannot be collected.\n    return []\n\n  # Breadth-First Search (BFS) for Shortest Pathfinding to an adjacent cell.\n  # Queue stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set prevents infinite loops and redundant exploration.\n  visited = {agent_pos}\n\n  # Define the (dx, dy) for each movement action.\n  move_deltas = {\n      UP: (0, -1),  # Move up (decrease y)\n      DOWN: (0, 1),   # Move down (increase y)\n      LEFT: (-1, 0),  # Move left (decrease x)\n      RIGHT: (1, 0),  # Move right (increase x)\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue current position and its path.\n\n    # Check if the current position is adjacent to any of the target primitive locations.\n    # Adjacency is defined as Chebyshev distance <= 1 (3x3 neighborhood).\n    # This means max(abs(curr_x - target_x), abs(curr_y - target_y)) <= 1.\n    is_adjacent = False\n    for target_x, target_y in primitive_locations_on_grid:\n      if max(abs(cx - target_x), abs(cy - target_y)) <= 1:\n        is_adjacent = True\n        break\n    \n    if is_adjacent:\n      # If the current position is adjacent to a primitive, append 'USE' and return the path.\n      # BFS guarantees this is the shortest sequence of movement actions to reach an adjacent spot.\n      return path_actions + [USE]\n\n    # Explore all four cardinal neighbors.\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate coordinates of the neighbor.\n      new_position = (nx, ny)\n\n      # Check if the neighbor is valid (traversable) and not yet visited.\n      if is_traversable(nx, ny) and new_position not in visited:\n        new_path_actions = path_actions + [action_type] # Append the action to the path.\n        \n        # Add this new position to the queue for further exploration\n        # and mark it as visited.\n        visited.add(new_position)\n        queue.append((new_position, new_path_actions))\n        \n  # If the BFS completes and the queue is empty without finding a path,\n  # the primitive is unreachable from the current agent position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:52:39.140027", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  This version accounts for non-walkable terrain (e.g., water and stone).\n  \"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # Define impassable terrain indices. Water and Stone are typical obstacles.\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # Helper function to check if a cell is passable\n  def is_passable(pos_x, pos_y):\n    # Check boundaries\n    if not (0 <= pos_x < WIDTH and 0 <= pos_y < HEIGHT):\n      return False\n    # Check if any impassable item is present at this cell\n    for idx in impassable_indices:\n      if grid[pos_x, pos_y, idx] > 0:\n        return False  # Contains an impassable object\n    return True  # No impassable objects found, and within bounds\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}  # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # Iterate over all primitive locations to find the closest one from the current node in BFS.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is passable and has not been visited\n      if is_passable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T01:52:40.269924", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` with obstacle avoidance (specifically, avoiding water).\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  # Note: `env.action_specs()` provides the mapping from action names to integers\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n  \n  # Get the index for water, which is assumed to be an impassable obstacle\n  water_idx = env.world.water_index\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # We want to find a path to a walkable cell *adjacent* to the primitive.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # V2 Improvement: Obstacle avoidance\n      # Check if the next position contains water (assumed to be impassable)\n      is_blocked = False\n      if grid[next_x, next_y, water_idx] > 0:\n        is_blocked = True\n      \n      if is_blocked:\n        continue\n\n      # If the cell is not blocked and not visited, add it to the queue\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T01:53:11.411804", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # The current grid layout from the environment state\n  \n  # Map the string primitive name to its unique integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve the integer action codes from the environment's action specifications.\n  # These are used to construct the sequence of actions.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible agent movements as (delta_x, delta_y, action_id).\n  # These tuples represent moving one step in each cardinal direction.\n  MOVE_ACTIONS = [\n      (0, -1, ACTION_UP),    # North: Decreases Y-coordinate\n      (0, 1, ACTION_DOWN),   # South: Increases Y-coordinate\n      (-1, 0, ACTION_LEFT),  # West: Decreases X-coordinate\n      (1, 0, ACTION_RIGHT),  # East: Increases X-coordinate\n  ]\n\n  # Get the dimensions of the grid for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Initialize the Breadth-First Search (BFS).\n  # The queue `q` stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  # `visited` set keeps track of positions already explored to avoid cycles and redundant paths.\n  start_pos = state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # Determine how the primitive is \"collected\".\n  # Grabbable items need a 'USE' action when adjacent to them.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Workshops and certain natural features are \"collected\" by merely standing on their location.\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_stationary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      primitive_idx == cookbook.index['BOUNDARY'] # Boundary is treated as stationary for pathfinding.\n  )\n  \n  # BFS loop to find the shortest path to collect the primitive.\n  while q:\n    current_pos, path_actions = q.popleft()\n    cx, cy = current_pos # Deconstruct current position for convenience\n\n    # --- Goal Check ---\n    # Since BFS finds the shortest path in an unweighted graph, the first time we\n    # satisfy the goal condition, we've found the optimal sequence of actions.\n    if is_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move\n      # to a cell *adjacent* to it and then perform a 'USE' action.\n      found_adjacent = False\n      for dx_adj in range(-1, 2):\n        for dy_adj in range(-1, 2):\n          # Skip the agent's current position (0,0 relative offset) as it's not \"adjacent\"\n          if dx_adj == 0 and dy_adj == 0:\n            continue\n          \n          nx, ny = cx + dx_adj, cy + dy_adj\n          # Check if the potential adjacent cell is within grid boundaries\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n            # Check if the primitive exists in this adjacent cell's layer\n            if grid[nx, ny, primitive_idx] > 0:\n              found_adjacent = True\n              break\n        if found_adjacent:\n          break # Found an adjacent primitive, no need to check further neighbors\n\n      if found_adjacent:\n        # Path found! Append the 'USE' action and return the full sequence.\n        return path_actions + [ACTION_USE]\n        \n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No 'USE' action is typically needed.\n      # Check if the primitive is present at the agent's current position.\n      if grid[cx, cy, primitive_idx] > 0:\n        # Path found! Return the sequence of actions to reach this position.\n        return path_actions\n    \n    # --- Explore Neighbors ---\n    # If the current position is not the goal, add its unvisited neighbors to the queue.\n    for dx, dy, action in MOVE_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, path_actions + [action]))\n  \n  # If the BFS completes and the queue is empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:53:12.637429", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Finds the shortest path to a primitive item using Breadth-First Search (BFS)\n  and returns the sequence of actions to collect it.\n  \n  Args:\n      env (env.CraftLab): The CraftLab object representing the current simulation state.\n      primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"WORKSHOP0\").\n\n  Returns:\n      List[int]: A list of integer action codes (e.g., CraftLab.action_specs() values)\n                 representing the path and collection action. Returns an empty list\n                 if the primitive is not found or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # The grid layout of the current environment\n  \n  # Map the string primitive name to its integer ID using the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve the integer action codes from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement directions (dx, dy) and their corresponding action IDs.\n  # This helps in exploring neighbors in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # North: (x, y-1)\n      (0, 1, ACTION_DOWN),   # South: (x, y+1)\n      (-1, 0, ACTION_LEFT),  # West: (x-1, y)\n      (1, 0, ACTION_RIGHT),  # East: (x+1, y)\n  ]\n\n  # Get grid dimensions for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Initialize BFS:\n  # The queue `q` stores tuples: (current_position (x,y), list_of_actions_taken_to_reach_here).\n  # The `visited` set prevents revisiting positions, ensuring the shortest path is found\n  # and avoiding infinite loops.\n  start_pos = current_state.pos\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # Determine how the primitive is collected based on its type:\n  # Grabbable items require a 'USE' action when adjacent.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  # Workshops and certain stationary primitives (water, stone, boundary) are 'collected'\n  # by merely reaching their location.\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_stationary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      primitive_idx == cookbook.index['BOUNDARY'] # Boundary can be \"collected\" by being adjacent (or on)\n  )\n  \n  # Execute the BFS algorithm.\n  while q:\n    current_pos, path_actions = q.popleft()\n    cx, cy = current_pos # Current x and y coordinates\n\n    # GOAL CHECK:\n    # Check if the current position satisfies the condition for \"collecting\" the primitive.\n    # Since BFS explores level by level, the first path found is guaranteed to be the shortest.\n    \n    if is_grabbable:\n      # For grabbable items (e.g., 'WOOD', 'IRON'), the agent must be adjacent to them,\n      # then perform a 'USE' action. Check the 3x3 neighborhood around the agent.\n      found_adjacent_primitive = False\n      for dx_adj in range(-1, 2):\n        for dy_adj in range(-1, 2):\n          # Skip the agent's current position itself for adjacency check (dx=0, dy=0)\n          if dx_adj == 0 and dy_adj == 0:\n            continue\n\n          nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n          # Ensure neighbor cell is within grid boundaries\n          if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n            # Check if the primitive exists at this neighbor cell's layer.\n            if grid[nx_adj, ny_adj, primitive_idx] > 0:\n              found_adjacent_primitive = True\n              break # Found it in the neighborhood, no need to check further adjacent cells.\n        if found_adjacent_primitive:\n          break # Break outer loop too\n      \n      if found_adjacent_primitive:\n        # Path found: move to current_pos, then use.\n        return path_actions + [ACTION_USE]\n        \n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means being *on* that cell.\n      # Check if the current cell contains the primitive.\n      if grid[cx, cy, primitive_idx] > 0:\n        return path_actions # Path found, no additional action (like USE) needed.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx_move, dy_move, action_id in MOVES:\n      new_x, new_y = cx + dx_move, cy + dy_move\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this position hasn't been visited yet, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, path_actions + [action_id]))\n  \n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:53:57.196993", "function_name": "collect", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-02T01:53:58.546566", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in the cookbook, cannot collect it.\n    return []\n\n  # Early exit: If the primitive is already in the agent's inventory,\n  # no collection actions are needed. This fulfills the \"use already available items\"\n  # aspect by indicating that if it's present, the goal is already met.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings (integer IDs) from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) setup for pathfinding.\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of positions already explored to avoid cycles and redundant paths.\n  visited = {start_pos} \n\n  # Determine the type of primitive to apply appropriate collection logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, or boundary are \"collected\"\n  # by simply reaching their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at `current_pos`.\n    # This allows us to use `CraftState` methods like `next_to` or directly query the `grid`\n    # as if the agent were physically at this `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal for collecting the primitive.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        # BFS finds the shortest path. Appending a single ACTION_USE to it maintains this property\n        # for the total sequence of actions to acquire the item.\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means simply being on their cell.\n      # Check if the primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        # This is the shortest path to a cell containing the primitive. No additional action is needed.\n        return current_actions \n    \n    # Explore neighbors of the current position.\n    for dx, dy, action_id in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action_id]))\n  \n  # If the BFS completes without finding the primitive (e.g., it's not on the grid),\n  # return an empty list, indicating it cannot be collected.\n  return []", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T01:55:50.344996", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive. This includes sources of primitives (e.g., trees for wood)\n      # or items directly on the ground.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Pre-fetch indices for common impassable terrain for movement\n  # Assuming 'water' is always an impassable block\n  water_idx = env.world.water_index \n  # Assuming 'boundary' is always an impassable block. It might not always be in the index.\n  boundary_idx = env.world.cookbook.index.get('BOUNDARY') \n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # It's important to find the *shortest* path to *any* adjacent cell.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # 1. Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # 2. Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # 3. Obstacle avoidance check (new for v2)\n      # A cell is considered impassable for movement if it contains water or a boundary.\n      is_impassable = False\n      \n      # Check if the next cell contains water\n      if grid[next_x, next_y, water_idx] > 0:\n        is_impassable = True\n      \n      # Check if the next cell contains a boundary block (if 'BOUNDARY' is defined in the cookbook)\n      if boundary_idx is not None and grid[next_x, next_y, boundary_idx] > 0:\n        is_impassable = True\n      \n      if is_impassable:\n        continue # Skip this move if it leads to an impassable cell\n\n      # If all checks pass, add the next position to the queue\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-02T01:55:51.577013", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # Get the set of non-grabbable (obstacle) indices\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive,\n  #    while avoiding non-grabbable obstacles.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position contains any non-grabbable obstacles\n      is_obstacle = False\n      # Iterate through all possible kinds at the next cell\n      # and check if any of them are non_grabbable and present\n      for k in range(grid.shape[2]): # k is the kind_idx\n          if k in non_grabbable_indices and grid[next_x, next_y, k] > 0:\n              is_obstacle = True\n              break\n      \n      if is_obstacle:\n        continue # Cannot move into an obstacle cell\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
