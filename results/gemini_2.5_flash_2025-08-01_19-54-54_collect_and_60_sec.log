{"timestamp": "2025-08-01T20:31:58.957711", "function_name": "collect", "function_body": "  # 1. Get primitive ID from the cookbook's index\n  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the index, it cannot be collected.\n      return []\n\n  # 2. Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos # (x, y) tuple\n  \n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  # WIDTH corresponds to x-coordinates, HEIGHT to y-coordinates\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each action (dx, dy)\n  # Corresponding to (x_change, y_change) for a given (x, y) position\n  DELTAS = {\n      UP_ACTION: (0, -1),   # x: no change, y: -1 (move up means decrease y)\n      DOWN_ACTION: (0, 1),    # x: no change, y: +1 (move down means increase y)\n      LEFT_ACTION: (-1, 0),   # x: -1, y: no change (move left means decrease x)\n      RIGHT_ACTION: (1, 0)    # x: +1, y: no change (move right means increase x)\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles for movement\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # BFS for pathfinding to a cell adjacent to the primitive\n  # queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # visited stores (x, y) tuples to avoid cycles and redundant exploration\n  visited = {current_pos}\n  \n  # The list of actions to be returned if a path is found\n  final_actions = []\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if any neighbor of the current position (x, y) contains the primitive\n      for move_action_id, (dx, dy) in DELTAS.items():\n          nx, ny = x + dx, y + dy # Neighbor coordinates\n\n          # Check if the neighbor is within grid bounds\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # If the neighbor cell contains the target primitive\n          if grid[nx, ny, primitive_idx] == 1:\n              # We have found a cell (x, y) that is adjacent to the primitive.\n              # The agent needs to move to (x, y) (if not already there), then USE.\n              final_actions = path + [USE_ACTION]\n              return final_actions # Path found, return the sequence of actions\n\n      # If no primitive found in immediate neighborhood, explore traversable neighbors for movement\n      for move_action_id, (dx, dy) in DELTAS.items():\n          nx, ny = x + dx, y + dy # Neighbor coordinates\n\n          # Check if the neighbor is within grid bounds\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Check if this neighbor has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the neighbor cell is an obstacle (contains any non-grabbable item)\n          is_obstacle = False\n          for obstacle_idx in non_grabbable_obstacle_indices:\n              if grid[nx, ny, obstacle_idx] == 1:\n                  is_obstacle = True\n                  break # Found an obstacle in this cell, cannot move here\n          \n          if is_obstacle:\n              continue # Skip this cell, it's an obstacle\n\n          # If the neighbor is traversable and not visited, add it to the queue\n          visited.add((nx, ny))\n          queue.append(((nx, ny), path + [move_action_id]))\n\n  # If the queue is exhausted and no path to the primitive was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:32:00.149266", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  initial_dir = current_state.dir\n\n  action_map = env.action_specs()\n  # Map action names to their integer indices for clarity\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get grid dimensions (Height, Width, Kinds)\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Get the integer ID for the target primitive from the cookbook's index\n  primitive_idx = world.cookbook.index[primitive]\n\n  # Define constants for movement and direction logic based on CraftState internals\n  # _action_to_delta: maps a move action index (0-3) to its (dr, dc) change in position\n  _action_to_delta = {\n      ACTION_UP: (-1, 0),    # Moves agent up (row decreases)\n      ACTION_DOWN: (1, 0),   # Moves agent down (row increases)\n      ACTION_LEFT: (0, -1),  # Moves agent left (column decreases)\n      ACTION_RIGHT: (0, 1),  # Moves agent right (column increases)\n  }\n  # _action_to_dir: maps a move action index (0-3) to the agent's resulting direction (0-3)\n  _action_to_dir = {\n      ACTION_UP: 0,    # UP action sets direction to North (0)\n      ACTION_DOWN: 2,  # DOWN action sets direction to South (2)\n      ACTION_LEFT: 3,  # LEFT action sets direction to West (3)\n      ACTION_RIGHT: 1, # RIGHT action sets direction to East (1)\n  }\n  # _dir_to_delta: maps a direction index (0-3) to the (dr, dc) offset of the cell in front\n  _dir_to_delta = {\n      0: (-1, 0), # North: cell above\n      1: (0, 1),  # East: cell to the right\n      2: (1, 0),  # South: cell below\n      3: (0, -1), # West: cell to the left\n  }\n\n  # Check if the primitive is a \"grabbable\" resource (i.e., requires a USE action)\n  # This typically means it's a resource that goes into inventory.\n  requires_use_action = (primitive_idx in world.cookbook.primitives)\n\n  # BFS Queue: stores tuples of ((row, col, direction), list_of_actions_taken)\n  q = collections.deque([((pos[0], pos[1], initial_dir), [])])\n  \n  # Visited set: stores (row, col, direction) tuples to prevent redundant exploration and cycles\n  visited = {(pos[0], pos[1], initial_dir)}\n\n  while q:\n    (r, c, current_dir), path = q.popleft()\n\n    # Check if the current state (agent at (r,c) facing current_dir) allows us to \"collect\" the primitive.\n    # This means the cell directly in front of the agent must contain the primitive.\n    dr_face, dc_face = _dir_to_delta[current_dir]\n    target_cell_r, target_cell_c = r + dr_face, c + dc_face\n\n    # Check if the cell in front is within grid boundaries\n    if 0 <= target_cell_r < HEIGHT and 0 <= target_cell_c < WIDTH:\n      # Check if the cell in front actually contains the target primitive\n      if grid[target_cell_r, target_cell_c, primitive_idx] > 0:\n        # Found a state from which the primitive can be collected.\n        if requires_use_action:\n          # If it's a collectable resource, append the USE action and return the full path.\n          return path + [ACTION_USE]\n        else:\n          # If it's a non-collectable entity (e.g., workshop, water), just reaching this position\n          # and facing it is considered \"collecting\" (i.e., being next to it).\n          return path\n\n    # Explore next states by taking valid move actions (UP, DOWN, LEFT, RIGHT)\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dr_move, dc_move = _action_to_delta[action_idx]\n      next_r, next_c = r + dr_move, c + dc_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move action\n\n      # Check if the new agent position is within grid boundaries\n      if 0 <= next_r < HEIGHT and 0 <= next_c < WIDTH:\n        next_state_key = (next_r, next_c, next_dir)\n        # If this new state (position + direction) hasn't been visited yet, add it to the queue\n        if next_state_key not in visited:\n          visited.add(next_state_key)\n          q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:33:31.632366", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v0`.\n  This version refactors the walkability check in the BFS for better clarity and robustness,\n  and explicitly pre-computes impassable terrain types.\n  \"\"\"\n\n  # Pre-compute common environment parameters for efficiency and readability\n  current_state = env._current_state\n  action_map = env.action_specs()\n  \n  # Map action names to their integer values for clear usage\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  primitive_id = env.world.cookbook.index.index(primitive)\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Determine which item kinds are truly impassable terrain.\n  # Workshops are considered non-grabbable but are generally walkable (agent can move onto them).\n  impassable_kind_ids = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  def _is_cell_walkable(r: int, c: int) -> bool:\n    \"\"\"\n    Helper function to check if a grid cell at (r, c) is walkable.\n    A cell is walkable if it's within bounds and does not contain any impassable item kind.\n    \"\"\"\n    if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n      return False # Cell is out of grid boundaries\n    \n    # Iterate through known impassable kinds. If any are present, the cell is blocked.\n    for kind_idx in impassable_kind_ids:\n      if grid[r, c, kind_idx] > 0: # Check if this impassable kind occupies the cell\n        return False # Cell contains an impassable obstacle\n    return True # Cell is walkable\n\n  def _find_shortest_path_internal(start_pos: tuple[int, int], target_cells: set[tuple[int, int]]) -> tuple[list[int] | None, tuple[int, int] | None]:\n    \"\"\"\n    Finds the shortest sequence of actions (path) from `start_pos` to any of the `target_cells`\n    on the current grid, using a Breadth-First Search (BFS) algorithm.\n\n    Args:\n        start_pos (tuple): The agent's starting (row, col) position.\n        target_cells (set): A set of (row, col) coordinates representing valid target destinations.\n\n    Returns:\n        tuple: (list of int actions, tuple (row, col) of the target cell reached) if a path is found,\n               else (None, None).\n    \"\"\"\n    q = collections.deque([(start_pos, [])])  # Queue: (current_position, path_actions_taken)\n    visited = {start_pos} # Set to keep track of visited positions to prevent cycles and redundant exploration\n\n    # Define possible movements corresponding to action values\n    moves_map = {\n        UP_ACTION: (-1, 0),  # Row change, Column change\n        DOWN_ACTION: (1, 0),\n        LEFT_ACTION: (0, -1),\n        RIGHT_ACTION: (0, 1),\n    }\n\n    while q:\n      (r, c), path = q.popleft() # Dequeue the current position and path\n\n      # If the current position is one of the desired target cells, a path has been found\n      if (r, c) in target_cells:\n        return path, (r, c)\n\n      # Explore neighboring cells\n      for action_val, (dr, dc) in moves_map.items():\n        nr, nc = r + dr, c + dc # Calculate new row and column\n        \n        # Check if the new cell is walkable and has not been visited yet\n        if _is_cell_walkable(nr, nc) and (nr, nc) not in visited:\n          visited.add((nr, nc)) # Mark as visited\n          q.append(((nr, nc), path + [action_val])) # Enqueue new state\n\n    return None, None  # No path could be found to any target cell\n\n  # --- Main logic of collect_v1 function ---\n\n  # Determine specific characteristics of the primitive item\n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_workshop = primitive_id in env.world.workshop_indices\n  \n  # 1. Early exit: If the primitive is grabbable and already in the agent's inventory\n  if is_grabbable and current_state.inventory[primitive_id] > 0:\n    return [] # No actions needed, it's already collected\n\n  # 2. Early exit: If the agent is already in the desired position (next to or on) the primitive\n  if current_state.next_to(primitive_id):\n    if is_grabbable:\n      # If it's a grabbable item and we are already next to it, the action is to USE it to collect.\n      return [USE_ACTION]\n    else:\n      # If it's a non-grabbable (e.g., workshop, water, boundary, or stone that cannot be picked up),\n      # being next to it is considered \"collected\" for the purpose of this DSL's 'collect' primitive.\n      return [] # No further movement/action is needed\n\n  # 3. Locate all instances of the primitive on the current grid\n  primitive_grid_locations = []\n  for r_idx in range(HEIGHT):\n    for c_idx in range(WIDTH):\n      if grid[r_idx, c_idx, primitive_id] > 0: # Check if the primitive is at this cell\n        primitive_grid_locations.append((r_idx, c_idx))\n  \n  if not primitive_grid_locations:\n    return [] # The primitive is not found anywhere on the current map\n\n  # 4. Define the set of potential target cells for pathfinding\n  # The agent needs to reach these cells to interact with the primitive.\n  potential_path_target_cells = set()\n  \n  if is_workshop:\n    # For workshops, the agent typically needs to move directly onto the workshop's cell.\n    potential_path_target_cells.update(primitive_grid_locations)\n  else:\n    # For other items (grabbable resources, water, boundary, stone), the agent generally\n    # needs to be adjacent (one step away) to interact or \"collect\".\n    for tr, tc in primitive_grid_locations:\n      # Consider all four direct neighbors of the primitive's location as potential targets\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Representing UP, DOWN, LEFT, RIGHT movements\n        nr, nc = tr + dr, tc + dc\n        if 0 <= nr < HEIGHT and 0 <= nc < WIDTH: # Ensure the neighbor cell is within grid boundaries\n          potential_path_target_cells.add((nr, nc))\n\n  if not potential_path_target_cells:\n    # This can happen if, for example, a primitive is completely surrounded by impassable terrain\n    # and no adjacent walkable cell exists.\n    return [] \n\n  # 5. Use the internal BFS helper to find the shortest action sequence to one of the target cells\n  path_actions, _ = _find_shortest_path_internal(\n      current_state.pos, \n      potential_path_target_cells\n  )\n\n  if path_actions is None:\n    return [] # No reachable path to any instance of the primitive was found\n\n  # 6. If the primitive is grabbable, append a 'USE' action after reaching the target position.\n  # This assumes that being adjacent (or on, for workshops that might also be grabbable in theory)\n  # is sufficient for the 'USE' action to succeed in collecting the item.\n  if is_grabbable:\n    path_actions.append(USE_ACTION)\n  \n  return path_actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:33:32.896168", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  def _find_path_and_orientation(start_pos, start_dir, primitive_id, grid, non_grabbable_indices, workshop_indices, action_map, world_ref):\n    \"\"\"\n    Finds the shortest sequence of actions (movement and implied turns) to position the agent\n    to interact with the primitive.\n\n    Args:\n        start_pos (tuple): Agent's starting (row, col) position.\n        start_dir (int): Agent's starting direction (0=N, 1=E, 2=S, 3=W).\n        primitive_id (int): The index of the primitive to interact with.\n        grid (numpy.ndarray): The current game grid (HEIGHT, WIDTH, n_kinds).\n        non_grabbable_indices (set): Indices of non-grabbable items that are generally impassable.\n        workshop_indices (list): Indices of workshop items.\n        action_map (dict): Mapping from action names (e.g., 'UP') to integer indices.\n        world_ref: Reference to env.world for primitive properties (cookbook, grabbable_indices, workshop_indices).\n\n    Returns:\n        list of int actions: A sequence of action indices, or None if no path.\n    \"\"\"\n    HEIGHT, WIDTH, _ = grid.shape\n    \n    # State in BFS: (row, col, direction)\n    q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])]) # (r, c, d, path_actions)\n    visited = {(start_pos[0], start_pos[1], start_dir)}\n\n    # Map action values to (dr, dc, new_dir) movements.\n    # CraftState.step updates the agent's direction to match the last movement.\n    action_move_effects = {\n        action_map['UP']: (-1, 0, 0),    # dr, dc, new_direction (N: 0)\n        action_map['DOWN']: (1, 0, 2),   # dr, dc, new_direction (S: 2)\n        action_map['LEFT']: (0, -1, 3),  # dr, dc, new_direction (W: 3)\n        action_map['RIGHT']: (0, 1, 1),  # dr, dc, new_direction (E: 1)\n    }\n\n    # Pre-calculate primitive locations on the grid\n    primitive_grid_locations = set()\n    for r in range(HEIGHT):\n        for c in range(WIDTH):\n            if grid[r, c, primitive_id] > 0:\n                primitive_grid_locations.add((r, c))\n    \n    if not primitive_grid_locations:\n        return None # Primitive not found anywhere on the map\n\n    is_workshop = primitive_id in world_ref.workshop_indices\n\n    def is_walkable(r, c):\n        \"\"\"Checks if a grid cell (r, c) is walkable.\"\"\"\n        if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n            return False\n        # A cell is blocked if it contains a non-grabbable item that is NOT a workshop.\n        # Workshops are considered walkable.\n        for kind_idx in non_grabbable_indices:\n            if grid[r, c, kind_idx] > 0 and kind_idx not in workshop_indices:\n                return False\n        return True\n\n    def is_target_state(r_a, c_a, d_a):\n        \"\"\"Checks if the current agent state (position and direction) is a valid target for interaction.\"\"\"\n        # r_a, c_a: agent's current position\n        # d_a: agent's current direction\n        \n        if is_workshop:\n            # If the primitive is a workshop, the agent needs to be on its cell.\n            # Direction doesn't matter for 'USE' on self (i.e., crafting).\n            return (r_a, c_a) in primitive_grid_locations\n        else:\n            # For other primitives (grabbable items like WOOD, IRON, or non-grabbables like WATER, STONE),\n            # the agent needs to be adjacent to the item AND facing it to 'USE'.\n            r_front, c_front = r_a, c_a # Initialize to agent's position\n\n            # Determine the cell directly in front of the agent based on its direction\n            if d_a == 0: # North\n                r_front -= 1\n            elif d_a == 1: # East\n                c_front += 1\n            elif d_a == 2: # South\n                r_front += 1\n            elif d_a == 3: # West\n                c_front -= 1\n            \n            # Check if the cell in front contains the primitive\n            return (r_front, c_front) in primitive_grid_locations\n\n    while q:\n        r, c, d, path = q.popleft()\n\n        # Check if the current state (r, c, d) satisfies the target condition\n        if is_target_state(r, c, d):\n            return path # Found a path that leads to the correct position and orientation\n\n        # Explore neighbors by applying movement actions\n        for action_val, (dr, dc, new_dir) in action_move_effects.items():\n            nr, nc = r + dr, c + dc # Calculate new position\n            \n            # Only consider valid and unvisited walkable cells\n            if is_walkable(nr, nc) and (nr, nc, new_dir) not in visited:\n                visited.add((nr, nc, new_dir))\n                q.append((nr, nc, new_dir, path + [action_val]))\n\n    return None # No path found to any target state\n\n  primitive_id = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  action_map = env.action_specs()\n  \n  is_grabbable = primitive_id in env.world.grabbable_indices\n  is_workshop = primitive_id in env.world.workshop_indices\n  \n  # 1. Early exit condition: If the primitive is grabbable and already in inventory\n  if is_grabbable and current_state.inventory[primitive_id] > 0:\n      return []\n\n  # 2. Find the shortest path and the correct final orientation using BFS.\n  # This function already considers if the agent is initially in the target state.\n  path_actions = _find_path_and_orientation(\n      current_state.pos, \n      current_state.dir, \n      primitive_id, \n      current_state.grid, \n      env.world.non_grabbable_indices, \n      env.world.workshop_indices, \n      action_map,\n      env.world # Pass world_ref for primitive properties\n  )\n\n  if path_actions is None:\n      return [] # No path could be found to interact with the primitive\n\n  # 3. If the primitive is a grabbable item (and not a workshop, as workshops are \"used\" by being on them),\n  # append a 'USE' action after reaching the correct position and orientation.\n  if is_grabbable and not is_workshop:\n      path_actions.append(action_map['USE'])\n  \n  return path_actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:34:23.946072", "function_name": "collect", "function_body": "  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the index, it cannot be collected.\n      return []\n\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already adjacent or at the current position (within 3x3 neighborhood).\n  # If so, a single USE action might suffice.\n  if current_state.next_to(primitive_idx):\n      action_map = env.action_specs()\n      USE_ACTION = action_map['USE']\n      return [USE_ACTION]\n\n  grid = current_state.grid\n  current_pos = current_state.pos # (x, y) tuple\n  \n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # 2. Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each action (dx, dy)\n  DELTAS = {\n      UP_ACTION: (0, -1),   # Move up means decrease y-coordinate\n      DOWN_ACTION: (0, 1),    # Move down means increase y-coordinate\n      LEFT_ACTION: (-1, 0),   # Move left means decrease x-coordinate\n      RIGHT_ACTION: (1, 0)    # Move right means increase x-coordinate\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles for movement\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # BFS for pathfinding to a cell from which the primitive can be 'USE'd.\n  # queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # visited stores (x, y) tuples to avoid cycles and redundant exploration\n  visited = {current_pos}\n  \n  while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if any cell in the 3x3 neighborhood around the current position (x, y) contains the primitive.\n      # This aligns with the 'next_to' definition and assumes 'USE' acts on items in this range.\n      found_primitive_adjacent_to_current_bfs_node = False\n      for i in range(-1, 2):  # iterate through rows in 3x3 neighborhood (-1, 0, 1)\n          for j in range(-1, 2): # iterate through columns in 3x3 neighborhood (-1, 0, 1)\n              nx, ny = x + i, y + j # Neighbor coordinates\n\n              # Check if the neighbor is within grid bounds\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # If the neighbor cell contains the target primitive\n                  if grid[nx, ny, primitive_idx] == 1:\n                      found_primitive_adjacent_to_current_bfs_node = True\n                      break # Found it, no need to check other neighbors for this (x, y)\n          if found_primitive_adjacent_to_current_bfs_node:\n              break\n      \n      if found_primitive_adjacent_to_current_bfs_node:\n          # We have found a cell (x, y) from which the primitive can be 'USE'd.\n          # The agent needs to move to (x, y) (if not already there), then USE.\n          return path + [USE_ACTION] # Path found, return the sequence of actions\n\n      # If no primitive found in immediate neighborhood, explore traversable neighbors for movement\n      for move_action_id, (dx, dy) in DELTAS.items():\n          nx, ny = x + dx, y + dy # Neighbor coordinates\n\n          # Check if the neighbor is within grid bounds\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Check if this neighbor has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the neighbor cell is an obstacle (contains any non-grabbable item)\n          is_obstacle = False\n          for obstacle_idx in non_grabbable_obstacle_indices:\n              if grid[nx, ny, obstacle_idx] == 1:\n                  is_obstacle = True\n                  break # Found an obstacle in this cell, cannot move here\n          \n          if is_obstacle:\n              continue # Skip this cell, it's an obstacle\n\n          # If the neighbor is traversable and not visited, add it to the queue\n          visited.add((nx, ny))\n          queue.append(((nx, ny), path + [move_action_id]))\n\n  # If the queue is exhausted and no path to the primitive was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:34:25.194928", "function_name": "collect", "function_body": "  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the index, it cannot be collected.\n      return []\n\n  # Get current state information from the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos # (x, y) tuple\n  \n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each action (dx, dy)\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles for movement.\n  # These are entities the agent cannot pass through.\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a primitive is in the 3x3 neighborhood of a given position\n  # This replicates the logic of CraftState.next_to\n  def _is_primitive_next_to(check_grid, agent_pos, target_primitive_idx):\n      ax, ay = agent_pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = ax + dx, ay + dy\n              # Check grid boundaries\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # Check if the target primitive is at this neighboring cell\n                  if check_grid[nx, ny, target_primitive_idx] == 1:\n                      return True\n      return False\n\n  # BFS for pathfinding to a cell from which the agent can USE the primitive.\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # The visited set stores (x, y) tuples to avoid cycles and redundant exploration\n  visited = {current_pos}\n  \n  while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if the current position (x, y) allows the agent to USE the primitive.\n      # This is the goal condition for our BFS.\n      if _is_primitive_next_to(grid, (x, y), primitive_idx):\n          # If so, we've found our target position. Append the USE_ACTION and return the full path.\n          return path + [USE_ACTION]\n\n      # If the current position is not the goal, explore traversable neighbors for movement\n      for move_action_id, (dx, dy) in DELTAS.items():\n          nx, ny = x + dx, y + dy # Calculate neighbor coordinates\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Check if this neighbor has already been visited in the BFS\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the neighbor cell is an obstacle (contains any non-grabbable item).\n          # An agent cannot move into a cell occupied by a non-grabbable item.\n          is_obstacle = False\n          for obstacle_idx in non_grabbable_obstacle_indices:\n              if grid[nx, ny, obstacle_idx] == 1:\n                  is_obstacle = True\n                  break # Found an obstacle, cannot move to this cell\n          \n          if is_obstacle:\n              continue\n\n          # If the neighbor is traversable and not visited, add it to the queue\n          visited.add((nx, ny))\n          queue.append(((nx, ny), path + [move_action_id]))\n\n  # If the queue is exhausted and no path to a usable primitive location was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:35:30.170437", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state \n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not recognized.\n    return []\n\n  # Determine if the target primitive is grabbable\n  is_target_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get grid dimensions (assuming grid shape is (WIDTH, HEIGHT, n_kinds))\n  grid_width, grid_height, _ = current_state.grid.shape\n\n  # BFS setup\n  start_pos = current_state.pos # (x, y)\n  \n  # A queue for BFS: (position (x,y), list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited positions to avoid cycles\n  visited = {start_pos}\n\n  # Define possible moves and their corresponding actions\n  # (dx, dy) represents change in (x, y) coordinates\n  # x: horizontal (columns), y: vertical (rows)\n  moves = {\n      (0, -1): ACTION_UP,    # Move UP: y decreases\n      (0, 1): ACTION_DOWN,   # Move DOWN: y increases\n      (-1, 0): ACTION_LEFT,  # Move LEFT: x decreases\n      (1, 0): ACTION_RIGHT,  # Move RIGHT: x increases\n  }\n\n  # Identify all cells on the grid that contain the primitive\n  # np.where returns (row_indices, col_indices), so (y, x)\n  ys_primitive, xs_primitive = np.where(current_state.grid[:, :, primitive_idx] > 0)\n  \n  # Convert to (x, y) format consistent with agent's pos\n  primitive_grid_locations = [(x, y) for x, y in zip(xs_primitive, ys_primitive)]\n\n  if not primitive_grid_locations:\n      return [] # Primitive not found anywhere on the grid\n\n  # Determine all possible agent positions from which the primitive can be 'USE'd.\n  # Based on CraftState.next_to, USE works from any cell in the 3x3 neighborhood.\n  target_agent_positions = set()\n  for px, py in primitive_grid_locations:\n      # Iterate over 3x3 neighborhood including the primitive's cell itself\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              agent_target_x, agent_target_y = px + dx_offset, py + dy_offset\n              # Check if the potential agent position is within grid boundaries\n              if 0 <= agent_target_x < grid_width and 0 <= agent_target_y < grid_height:\n                  target_agent_positions.add((agent_target_x, agent_target_y))\n\n  # Perform BFS to find the shortest path to any `target_agent_position`\n  path_to_primitive_area = []\n  found_path = False\n\n  while queue and not found_path:\n      (curr_x, curr_y), path_actions = queue.popleft()\n\n      # If the current position is one of the target agent positions\n      if (curr_x, curr_y) in target_agent_positions:\n          path_to_primitive_area = path_actions\n          found_path = True\n          break\n\n      # Explore neighbors\n      for (dx, dy), action in moves.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid bounds\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          if (next_x, next_y) in visited:\n              continue\n          \n          # Traversability Check: Can the agent move to (next_x, next_y)?\n          # A cell is an obstacle if it contains any non-grabbable item,\n          # UNLESS that item is the target primitive itself AND the primitive is grabbable\n          # (meaning the agent can move onto its cell).\n          is_traversable = True\n          # Iterate over all non-grabbable items to check for obstacles\n          for kind_id in env.world.non_grabbable_indices:\n              if current_state.grid[next_x, next_y, kind_id] > 0:\n                  # If the cell contains a non-grabbable item\n                  if kind_id == primitive_idx:\n                      # If it's the primitive we want to collect:\n                      # Agent cannot step on a non-grabbable primitive (e.g., WORKSHOP)\n                      if not is_target_primitive_grabbable:\n                          is_traversable = False\n                          break\n                  else:\n                      # It's another non-grabbable item (e.g., WATER, BOUNDARY, STONE)\n                      # This acts as an obstacle.\n                      is_traversable = False\n                      break\n          \n          if not is_traversable:\n              continue\n\n          # If the cell is traversable and not visited, add it to the queue\n          visited.add((next_x, next_y))\n          queue.append(((next_x, next_y), path_actions + [action]))\n\n  if not found_path:\n      return [] # Cannot reach any area from which the primitive can be collected\n\n  # Append the found movement actions\n  actions.extend(path_to_primitive_area)\n\n  # After moving to the target area, perform the USE action to collect the primitive.\n  # The USE action is generally how interaction (collection/crafting) happens.\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:35:31.440148", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n\n  primitive_idx = cookbook.index[primitive]\n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Define movements as (dx, dy, action_id)\n  MOVES = [\n      (0, -1, ACTIONS['UP']),\n      (0, 1, ACTIONS['DOWN']),\n      (-1, 0, ACTIONS['LEFT']),\n      (1, 0, ACTIONS['RIGHT'])\n  ]\n\n  agent_pos = current_state.pos\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  # Determine if the primitive is a non-grabbable entity that cannot be stepped upon.\n  # Examples: WORKSHOP, WATER, STONE (if it's an environmental block, not a collectible item).\n  is_primitive_non_grabbable_obstacle = primitive_idx in env.world.non_grabbable_indices\n\n  # Find all grid locations where the primitive is present.\n  primitive_ys, primitive_xs = np.where(grid[:, :, primitive_idx] > 0)\n  primitive_locations = set(zip(primitive_xs, primitive_ys))  # Store as (x, y) tuples\n\n  if not primitive_locations:\n    return []  # Primitive not found anywhere on the grid.\n\n  # Determine all possible agent positions from which the primitive can be interacted with (using USE).\n  # This includes cells in the 3x3 neighborhood around each primitive location.\n  # If the primitive is a non-grabbable obstacle, the agent cannot step on its cell,\n  # so cells directly containing the primitive are excluded from target_agent_positions.\n  target_agent_positions = set()\n  for px, py in primitive_locations:\n    for dx_offset in [-1, 0, 1]:\n      for dy_offset in [-1, 0, 1]:\n        # Candidate agent position (ax, ay)\n        ax, ay = px + dx_offset, py + dy_offset\n\n        # Check if the candidate agent position is within grid boundaries\n        if not (0 <= ax < width and 0 <= ay < height):\n          continue\n\n        # If the primitive is a non-grabbable obstacle, the agent cannot occupy its cell.\n        # So, if (ax, ay) is the same as the primitive's location (px, py), it's not a valid target for agent movement.\n        if is_primitive_non_grabbable_obstacle and (ax, ay) == (px, py):\n          continue\n\n        target_agent_positions.add((ax, ay))\n\n  # BFS to find the shortest path to any `target_agent_position`\n  q = collections.deque([(agent_pos, [])])  # (current_position (x,y), list_of_actions_to_reach_here)\n  visited = {agent_pos}  # Set to keep track of visited positions to avoid cycles\n\n  shortest_path_to_target = None\n\n  while q:\n    (curr_x, curr_y), path_actions = q.popleft()\n\n    # If the current position is one of the target agent positions, we've found a path.\n    if (curr_x, curr_y) in target_agent_positions:\n      shortest_path_to_target = path_actions\n      break  # Found the shortest path, no need to explore further\n\n    # Explore neighbors\n    for dx, dy, action_id in MOVES:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next position is within grid bounds\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n\n      # Check if this cell has already been visited in the shortest path search\n      if (next_x, next_y) in visited:\n        continue\n\n      # Traversability check for (next_x, next_y):\n      # A cell is considered an obstacle if it contains any non-grabbable entity.\n      # This assumes agents cannot move onto cells occupied by workshops, water, boundary, etc.\n      is_obstacle = False\n      for kind_id in env.world.non_grabbable_indices:\n        if grid[next_x, next_y, kind_id] > 0:\n          is_obstacle = True\n          break\n\n      if is_obstacle:\n        continue  # Cannot move into an obstacle cell\n\n      # If the cell is traversable and not visited, add it to the queue\n      visited.add((next_x, next_y))\n      q.append(((next_x, next_y), path_actions + [action_id]))\n\n  if shortest_path_to_target:\n    # Append the found movement actions\n    actions.extend(shortest_path_to_target)\n    # After moving to the target area, perform the USE action to collect the primitive\n    actions.append(ACTIONS['USE'])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:36:44.600086", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index[primitive]\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Directions relative to current position, mapped to actions\n  # (dr, dc) -> action\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # For BFS neighbors (4-connected)\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Get the ID for 'BOUNDARY' to check for impassable cells\n  boundary_id = env.world.cookbook.index['BOUNDARY']\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive_id] > 0:\n      return []\n\n  # 2. Determine target cells for BFS and whether a USE action is needed\n  target_cells_for_bfs = set()\n  add_use_action = False\n\n  if primitive_id in env.world.grabbable_indices:\n      # For grabbable items (e.g., WOOD, IRON), we need to move to a cell\n      # in its 3x3 neighborhood, then apply the USE action.\n      add_use_action = True\n      for r_item in range(HEIGHT):\n          for c_item in range(WIDTH):\n              if grid[r_item, c_item, primitive_id] > 0:\n                  # This cell (r_item, c_item) contains the grabbable primitive.\n                  # The agent can pick it up from any cell in its 3x3 neighborhood.\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r_item + dr_adj, c_item + dc_adj\n                          \n                          # Check bounds\n                          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                              continue\n                          \n                          # Improvement: A cell containing a boundary is impassable to move into.\n                          # If the target primitive is NOT 'BOUNDARY' and the adjacent cell is a 'BOUNDARY',\n                          # then this adjacent cell should not be considered a valid target cell.\n                          if not (primitive_id != boundary_id and grid[nr, nc, boundary_id] > 0):\n                              target_cells_for_bfs.add((nr, nc))\n\n  elif primitive_id in env.world.non_grabbable_indices:\n      # For non-grabbable items (e.g., WORKSHOP, WATER, STONE), \"collecting\"\n      # means reaching a cell that contains the primitive. No USE action is needed.\n      add_use_action = False\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0:\n                  # If the primitive itself is a boundary, we can attempt to path to it.\n                  # If it's another non-grabbable on a boundary cell, this needs careful thought,\n                  # but for now, we assume direct target cells are valid. The BFS below\n                  # will prevent moving *through* other boundary cells.\n                  target_cells_for_bfs.add((r, c))\n  else:\n      # The primitive is not a recognized grabbable or non-grabbable entity that can be collected.\n      return []\n\n  if not target_cells_for_bfs:\n      # No target cells found (e.g., primitive not present on the grid, or all are impassable targets).\n      return []\n\n  # 3. Find shortest path to any target cell using Breadth-First Search (BFS)\n  queue = collections.deque([(current_row, current_col, [])])\n  visited = {(current_row, current_col)}\n  \n  shortest_path = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      if (r, c) in target_cells_for_bfs:\n          shortest_path = path\n          break # Found the shortest path to a valid target cell\n\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc\n\n          # Check bounds\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n          \n          # Improvement: Avoid moving into boundary cells unless the target primitive itself is 'BOUNDARY'.\n          # If the current target primitive is NOT 'BOUNDARY' and the neighboring cell 'nr, nc' contains 'BOUNDARY',\n          # then this cell is impassable for movement.\n          if primitive_id != boundary_id and grid[nr, nc, boundary_id] > 0:\n              continue\n\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy to avoid modifying shared list\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  if shortest_path is None:\n      return [] # No path found to any valid target cell\n\n  final_actions = list(shortest_path)\n  if add_use_action:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T20:36:45.791513", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index[primitive]\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Directions relative to current position, mapped to actions\n  # (dr, dc) -> action\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # For BFS neighbors (4-connected)\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Identify impassable terrain types from CraftWorld\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n  impassable_indices = {water_index, stone_index} # Assume water and stone are impassable\n\n  # Helper function to check if a cell is traversable\n  def is_cell_traversable(r, c):\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False # Out of bounds\n      for impassable_id in impassable_indices:\n          if grid[r, c, impassable_id] > 0:\n              return False # Contains an impassable kind\n      return True\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive_id] > 0:\n      return []\n\n  # 2. Determine target cells for BFS and whether a USE action is needed\n  target_cells_for_bfs = set()\n  add_use_action = False\n\n  if primitive_id in env.world.grabbable_indices:\n      # Grabbable items: Need to move to a cell in its 3x3 neighborhood, then USE.\n      add_use_action = True\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0:\n                  # This cell (r, c) contains the grabbable primitive.\n                  # Agent can pick it up from any cell in its 3x3 neighborhood.\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r + dr_adj, c + dc_adj\n                          # Only add to targets if the adjacent cell is traversable\n                          if is_cell_traversable(nr, nc):\n                              target_cells_for_bfs.add((nr, nc))\n\n  elif primitive_id in env.world.non_grabbable_indices:\n      # Non-grabbable items: \"Collecting\" means reaching the cell that contains it. No USE action.\n      add_use_action = False\n      for r in range(HEIGHT):\n          for c in range(WIDTH):\n              if grid[r, c, primitive_id] > 0:\n                  # Only add to targets if the primitive's cell itself is traversable\n                  if is_cell_traversable(r, c):\n                      target_cells_for_bfs.add((r, c))\n  else:\n      # The primitive is not a recognized collectible entity.\n      return []\n\n  if not target_cells_for_bfs:\n      return [] # No valid target cells found (e.g., primitive not present or all instances are in impassable areas)\n\n  # 3. Find shortest path to any target cell using Breadth-First Search (BFS)\n  # Only add current position to queue if it's traversable (which it should be, as agent starts there)\n  if not is_cell_traversable(current_row, current_col):\n      return [] # Agent starts in an impassable cell (unlikely scenario for a valid state)\n\n  queue = collections.deque([(current_row, current_col, [])])\n  visited = {(current_row, current_col)}\n  \n  shortest_path = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # If the current cell is one of the desired target cells, we found the shortest path\n      if (r, c) in target_cells_for_bfs:\n          shortest_path = path\n          break\n\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc\n\n          # Check if the next cell is within bounds and traversable, and not yet visited\n          if is_cell_traversable(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy to avoid modifying shared list\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  if shortest_path is None:\n      return [] # No traversable path found to any target cell\n\n  final_actions = list(shortest_path)\n  if add_use_action:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:37:30.419995", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by considering non-traversable cells as obstacles.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # 2. Get current state details\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get indices of non-traversable items (obstacles).\n  # We assume that any kind in env.world.non_grabbable_indices is an obstacle\n  # unless it's a workshop (which are generally traversable).\n  # The problem description for CraftWorld implies non_grabbable_indices\n  # includes things like water, stone, boundary, which are typically obstacles.\n  obstacle_indices = env.world.non_grabbable_indices\n\n  # 3. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # The agent needs to be within a 3x3 neighborhood of the primitive to 'USE' it.\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Helper function to check if a cell is traversable\n  # A cell is traversable if it's within bounds and does not contain any obstacle kind.\n  def is_cell_traversable(x, y, current_grid):\n    # Check if within bounds (redundant if called after boundary check, but good for robustness)\n    if not (0 <= x < grid_width and 0 <= y < grid_height):\n      return False\n\n    # Check if the cell contains any non-traversable obstacle\n    # Iterate through all kinds present at this cell (grid[x,y,k] > 0 means kind k is there)\n    for k in range(num_kinds):\n      if current_grid[x, y, k] > 0:\n        # If this kind is present and it is one of the defined obstacle indices\n        # (e.g., BOUNDARY, WATER, STONE, etc.)\n        if k in obstacle_indices:\n          return False # This cell contains an un-walkable obstacle\n    return True # No un-walkable obstacles found in this cell\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries AND is traversable\n      if (0 <= next_x < grid_width and 0 <= next_y < grid_height) and is_cell_traversable(next_x, next_y, grid):\n        # If the next position has not been visited, add it to the queue\n        if next_pos not in visited:\n          visited.add(next_pos)\n          q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:37:31.670695", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by considering impassable terrain (BOUNDARIES).\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n    # Get index for 'BOUNDARY' to check for impassable terrain\n    boundary_idx = env.world.cookbook.index.index('BOUNDARY')\n  except KeyError:\n    # If the primitive or BOUNDARY string is not known, it cannot be collected or path cannot be calculated safely.\n    return []\n\n  # 2. Get current state details\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check for impassable terrain (BOUNDARY).\n      # If the cell contains a BOUNDARY, we cannot move into it.\n      if grid[next_x, next_y, boundary_idx] > 0:\n        continue \n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable or blocked), return an empty list\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-01T20:38:50.453237", "function_name": "collect", "function_body": "  actions_list = []\n\n  current_state = env._current_state\n  grid_height, grid_width, _ = current_state.grid.shape\n  start_x, start_y = current_state.pos # Agent's position is (x, y) where x is column, y is row\n\n  # Get the integer index for the target primitive from the cookbook\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Map action names to their integer indices\n  actions_map = env.action_specs()\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Determine if interacting with this primitive requires a 'USE' action.\n  # Grabbable items (like WOOD) and workshops typically require a 'USE' action.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  requires_use_action = is_grabbable or is_workshop\n\n  # Define indices for entities that block agent movement (impassable terrain).\n  # In CraftWorld, 'water' is explicitly defined as a movement blocker.\n  # Other entities (like 'stone', 'wood', or 'workshops') can generally be walked\n  # onto or adjacent to, and then interacted with.\n  impassable_for_movement_indices = {env.world.water_index}\n\n  # Find all grid locations where the primitive instances exist.\n  # np.argwhere returns a list of (row, col) pairs, which corresponds to (y, x).\n  primitive_locations_yx = np.argwhere(current_state.grid[:, :, primitive_idx] > 0)\n\n  # If the primitive is not found anywhere on the map, return an empty list of actions.\n  if primitive_locations_yx.size == 0:\n      return []\n\n  # Identify all potential target cells for BFS.\n  # The `CraftState.next_to` method checks a 3x3 neighborhood around the agent's position.\n  # Therefore, any walkable cell within this 3x3 area of a primitive instance is a valid\n  # target for the agent to reach to be able to 'USE' or 'collect' the primitive.\n  target_cells = set()\n  # Define all 9 relative positions for a 3x3 neighborhood (including (0,0) for the center).\n  neighbor_deltas = [\n      (dy, dx) for dy in range(-1, 2) for dx in range(-1, 2)\n  ]\n\n  for py, px in primitive_locations_yx: # Iterate through each primitive instance's (row, col)\n      for dy, dx in neighbor_deltas:    # Check all cells in its 3x3 neighborhood\n          ny, nx = py + dy, px + dx # Calculate new_y, new_x (row, col) for the neighbor cell\n\n          # Ensure the neighbor cell is within the grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the neighbor cell is blocked by any impassable terrain.\n          is_cell_blocked = any(current_state.grid[ny, nx, k] > 0 for k in impassable_for_movement_indices)\n          \n          # If the cell is not blocked, it's a valid target for the agent to move to.\n          if not is_cell_blocked:\n              target_cells.add((nx, ny)) # Store as (x, y) tuple for consistency with agent's position format\n\n  # If no reachable target cells are found for any primitive instance, return empty.\n  if not target_cells:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # starting position to any of the identified target cells.\n  # The queue stores tuples: (current_x, current_y, list_of_coordinates_in_path).\n  queue = collections.deque([(start_x, start_y, [])])\n  visited = set([(start_x, start_y)]) # Keep track of visited cells to avoid cycles and redundant paths.\n\n  path_found_coordinates = None # This will store the sequence of (x,y) coordinates of the shortest path.\n\n  while queue:\n      cx, cy, current_path_coordinates = queue.popleft()\n\n      # If the current cell is one of our target cells, we have found the shortest path.\n      if (cx, cy) in target_cells:\n          path_found_coordinates = current_path_coordinates\n          break\n\n      # Explore the 4 direct neighbors (up, down, left, right) for standard grid movement.\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # (right, left, down, up relative to (x,y) or (col, row))\n          nx, ny = cx + dx, cy + dy # Calculate new_x, new_y\n\n          # Check if the new cell is within grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the new cell is blocked by impassable terrain.\n          is_cell_blocked = any(current_state.grid[ny, nx, k] > 0 for k in impassable_for_movement_indices)\n          \n          if is_cell_blocked:\n              continue\n          \n          # If the new cell has not been visited, add it to the queue for exploration.\n          if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append((nx, ny, current_path_coordinates + [(nx, ny)]))\n\n  # If no path was found to any target cell, return an empty list.\n  if path_found_coordinates is None:\n      return []\n\n  # Convert the sequence of (x,y) coordinates in the found path into a sequence of action indices.\n  px, py = start_x, start_y\n  for nx, ny in path_found_coordinates:\n      if nx > px:\n          actions_list.append(ACTION_RIGHT)\n      elif nx < px:\n          actions_list.append(ACTION_LEFT)\n      elif ny > py:\n          actions_list.append(ACTION_DOWN) # Increasing y means moving down in NumPy array indexing.\n      elif ny < py:\n          actions_list.append(ACTION_UP)   # Decreasing y means moving up in NumPy array indexing.\n      px, py = nx, ny # Update current position for the next step in the path.\n\n  # If the primitive requires a 'USE' action (e.g., to pick up or interact with a workshop),\n  # append it after the agent has moved to the target location.\n  if requires_use_action:\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:38:51.578729", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid_height, grid_width, _ = current_state.grid.shape\n  start_pos = current_state.pos # Agent's position (x, y)\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  actions_map = env.action_specs()\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Determine if the primitive requires a 'USE' action after reaching it.\n  # This includes grabbable items (e.g., WOOD) and workshops.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  requires_use = is_grabbable or is_workshop\n\n  # Define indices of entities that block agent movement.\n  # For CraftWorld, typically only water is strictly impassable for movement.\n  impassable_for_movement_indices = {env.world.water_index}\n\n  # Find all grid locations where the primitive exists\n  # np.argwhere returns (row, col) pairs (y, x)\n  primitive_locations_yx = np.argwhere(current_state.grid[:, :, primitive_idx] > 0)\n\n  if primitive_locations_yx.size == 0:\n      # Primitive not found on the map\n      return []\n\n  # Identify all potential target cells for BFS.\n  # The agent needs to be in a 3x3 neighborhood around the primitive to 'USE' it effectively.\n  # These are the cells that, if reached, would allow interaction with the primitive.\n  target_cells = set()\n  # Relative coordinates for a 3x3 neighborhood centered at (0,0)\n  neighbor_deltas = [\n      (dy, dx) for dy in range(-1, 2) for dx in range(-1, 2)\n  ]\n\n  for py, px in primitive_locations_yx:\n      for dy, dx in neighbor_deltas:\n          ny, nx = py + dy, px + dx\n\n          # Check if the potential target cell is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the potential target cell is walkable.\n          # A cell is walkable if it does not contain any strictly impassable objects.\n          is_cell_blocked = False\n          for k in impassable_for_movement_indices:\n              if current_state.grid[ny, nx, k] > 0:\n                  is_cell_blocked = True\n                  break\n          \n          if not is_cell_blocked:\n              target_cells.add((nx, ny)) # Add as (x, y) tuple for consistency with agent.pos\n\n  if not target_cells:\n      # No reachable target cells from which to interact with the primitive\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path.\n  # This version uses a parent map to reconstruct the path, which is more\n  # memory-efficient than storing the full path in each queue element.\n  queue = collections.deque([start_pos])\n  visited = {start_pos} # Stores (x, y) tuples of visited cells\n  \n  # parent_map stores (current_x, current_y): ((parent_x, parent_y), action_from_parent_to_current)\n  parent_map = {} \n  \n  found_target_cell = None # Will store the first target cell found by BFS\n\n  # Define possible moves and their corresponding actions\n  move_options = [\n      (0, -1, ACTION_UP),    # UP (dy, dx, action)\n      (0, 1, ACTION_DOWN),   # DOWN\n      (-1, 0, ACTION_LEFT),  # LEFT\n      (1, 0, ACTION_RIGHT)   # RIGHT\n  ]\n\n  while queue:\n      cx, cy = queue.popleft()\n\n      # If the current cell is one of the target cells, we found the shortest path\n      if (cx, cy) in target_cells:\n          found_target_cell = (cx, cy)\n          break\n\n      for dx, dy, action in move_options:\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the new cell is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the new cell is walkable (not occupied by any strictly impassable object)\n          is_cell_blocked = False\n          for k in impassable_for_movement_indices:\n              if current_state.grid[ny, nx, k] > 0:\n                  is_cell_blocked = True\n                  break\n          \n          if is_cell_blocked:\n              continue\n          \n          new_pos = (nx, ny)\n          # If the new cell has not been visited, add it to the queue and record its parent\n          if new_pos not in visited:\n              visited.add(new_pos)\n              parent_map[new_pos] = ((cx, cy), action)\n              queue.append(new_pos)\n\n  if found_target_cell is None:\n      # No path found to any target cell\n      return []\n\n  # Reconstruct the path by backtracking from the found target cell to the start position\n  actions_list = []\n  current = found_target_cell\n  \n  # Trace back until we reach the starting position.\n  while current != start_pos:\n      # This check ensures robustness, though it should ideally not be triggered\n      # if a valid path was found and found_target_cell is correct.\n      if current not in parent_map:\n          return [] \n      \n      prev_pos, action_to_current = parent_map[current]\n      actions_list.append(action_to_current)\n      current = prev_pos\n  \n  actions_list.reverse() # The path was built in reverse order, so reverse it\n\n  # If the primitive requires a 'USE' action, append it after reaching the target location\n  if requires_use:\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:39:49.474139", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Optimization: If the primitive is already in inventory, no actions are needed to \"collect\" it from the environment.\n  # This aligns with \"use already available items\" implying that if it's available in inventory, no further collection is needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Indices for impassable terrain (excluding the primitive itself if it's a target location)\n  i_boundary = cookbook.index['BOUNDARY']\n  i_water = env.world.water_index\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == i_water or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == i_boundary)\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: For BOUNDARY, \"collecting\" it means reaching its cell, which is often impassable for movement,\n      # but this condition is for the goal state once reached.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Do not break here; BFS finds the shortest path to *nodes*.\n      # A goal might be satisfiable by multiple nodes (e.g., being next to a large resource patch),\n      # and the *globally* shortest sequence of actions (including the final USE) needs full BFS exploration.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for traversability: Ensure the new position does not contain blocking entities.\n        # A cell is considered blocked if it contains a significant amount (>0) of 'BOUNDARY'\n        # or 'WATER' (unless WATER itself is the primitive we are trying to collect,\n        # in which case it must be traversable to reach it).\n        is_blocked = False\n        if grid[new_x, new_y, i_boundary] > 0:\n            is_blocked = True\n        # Water is an obstacle unless it's the target primitive\n        if primitive_idx != i_water and grid[new_x, new_y, i_water] > 0:\n            is_blocked = True\n        # Other non_grabbable_indices like workshops or stone are typically traversable for movement.\n\n        if not is_blocked and new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T20:39:50.724486", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time a\n    # goal node (or a node satisfying the goal condition) is popped from the queue,\n    # the path to it is the shortest. We can return immediately.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No USE action is typically needed for these\n    \n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T20:40:51.245554", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Define movements as (dx, dy, action_id)\n  # (dx, dy) represents the change in (x, y) coordinates for each action.\n  # Assuming (x, y) coordinates where x increases right, y increases down.\n  MOVES = [\n      (0, -1, ACTIONS['UP']),    # Move to (x, y-1) by performing UP action\n      (0, 1, ACTIONS['DOWN']),   # Move to (x, y+1) by performing DOWN action\n      (-1, 0, ACTIONS['LEFT']),  # Move to (x-1, y) by performing LEFT action\n      (1, 0, ACTIONS['RIGHT'])   # Move to (x+1, y) by performing RIGHT action\n  ]\n\n  current_state = env._current_state\n  agent_pos = current_state.pos\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  q = collections.deque([(agent_pos[0], agent_pos[1], [])]) # (x, y, path_actions)\n  visited = set([(agent_pos[0], agent_pos[1])])\n\n  target_reached_path = None\n\n  while q:\n    curr_x, curr_y, path_actions = q.popleft()\n\n    # Check if the current position (curr_x, curr_y) allows us to collect the primitive.\n    if is_primitive_grabbable:\n      # If the primitive is grabbable, we need to move onto its cell to collect it.\n      # Check if this cell contains the primitive.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        target_reached_path = path_actions\n        break # Found the shortest path to the grabbable primitive\n    else:\n      # If the primitive is non-grabbable, we need to move to an adjacent cell and USE it.\n      # Check 4-directional adjacency from (curr_x, curr_y) to any primitive location.\n      for dx_adj, dy_adj, _ in MOVES: # Iterate over standard adjacency offsets (N, S, E, W)\n        px_adj, py_adj = curr_x + dx_adj, curr_y + dy_adj\n        # Check if the adjacent cell is within bounds and contains the primitive\n        if 0 <= px_adj < width and 0 <= py_adj < height and grid[px_adj, py_adj, primitive_idx] > 0:\n          # If we are adjacent to the non-grabbable primitive, add a USE action.\n          target_reached_path = path_actions + [ACTIONS['USE']]\n          break # Found the shortest path to an adjacent cell for non-grabbable primitive\n      if target_reached_path:\n        break # Stop BFS as a path to a target has been found\n\n    # Explore neighbors\n    for dx, dy, action_id in MOVES:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n      \n      # Check if this cell has already been visited in the shortest path search\n      if (next_x, next_y) in visited:\n        continue\n      \n      # Check traversability of (next_x, next_y)\n      # A cell is considered non-traversable (an obstacle) if it contains any non-grabbable item\n      # UNLESS that item is the specific primitive we are looking for AND that primitive is grabbable (meaning we can move onto it).\n      is_traversable = True\n      for kind_id in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_id] > 0: # If this non-grabbable item is present at (next_x, next_y)\n              # If it's the primitive we want AND it's grabbable, we can move there.\n              # Otherwise, it's an obstacle.\n              if not (is_primitive_grabbable and kind_id == primitive_idx):\n                  is_traversable = False\n                  break\n      \n      if not is_traversable:\n        continue\n\n      # If the cell is traversable and not visited, add it to the queue\n      visited.add((next_x, next_y))\n      q.append((next_x, next_y, path_actions + [action_id]))\n\n  if target_reached_path:\n    return target_reached_path\n  else:\n    # If the BFS completes and no path to the primitive or its adjacent cell was found.\n    return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:40:52.347095", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Define movements as (dx, dy, action_id) for cardinal directions.\n  # (dx, dy) represents the change in (x, y) coordinates for each action.\n  # Assuming (x, y) coordinates where x increases right, y increases down.\n  MOVES = [\n      (0, -1, ACTIONS['UP']),    # Move to (x, y-1) by performing UP action\n      (0, 1, ACTIONS['DOWN']),   # Move to (x, y+1) by performing DOWN action\n      (-1, 0, ACTIONS['LEFT']),  # Move to (x-1, y) by performing LEFT action\n      (1, 0, ACTIONS['RIGHT'])   # Move to (x+1, y) by performing RIGHT action\n  ]\n\n  current_state = env._current_state\n  agent_pos = current_state.pos\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # BFS queue: (x, y, path_actions_to_reach_here)\n  q = collections.deque([(agent_pos[0], agent_pos[1], [])]) \n  # Visited set to prevent cycles and find shortest path: (x, y)\n  visited = set([(agent_pos[0], agent_pos[1])])\n\n  target_reached_path = None\n\n  while q:\n    curr_x, curr_y, path_actions = q.popleft()\n\n    # --- Check if the current position allows us to collect the primitive ---\n    if is_primitive_grabbable:\n      # If the primitive is grabbable, we need to move onto its cell to collect it.\n      # Check if this cell contains the primitive.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        target_reached_path = path_actions\n        break # Found the shortest path to the grabbable primitive\n    else:\n      # If the primitive is non-grabbable, we need to move to an adjacent cell and USE it.\n      # Check 3x3 neighborhood (including diagonals, excluding current cell) around (curr_x, curr_y)\n      # to see if any primitive is present. This mirrors the CraftState.next_to behavior.\n      found_primitive_adjacent = False\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              # Skip the agent's current cell itself when checking for adjacency for USE\n              if dx_offset == 0 and dy_offset == 0:\n                  continue \n              \n              px_potential_primitive, py_potential_primitive = curr_x + dx_offset, curr_y + dy_offset\n              \n              # Check if the potential primitive location is within grid bounds\n              if 0 <= px_potential_primitive < width and 0 <= py_potential_primitive < height:\n                  # Check if the primitive is present at this location\n                  if grid[px_potential_primitive, py_potential_primitive, primitive_idx] > 0:\n                      target_reached_path = path_actions + [ACTIONS['USE']]\n                      found_primitive_adjacent = True\n                      break # Found an adjacent primitive, no need to check other adjacencies from this curr_x, curr_y\n          if found_primitive_adjacent:\n              break # Break from outer dx_offset loop as well\n      if target_reached_path:\n        break # Stop BFS as a path to a target has been found\n\n    # --- Explore neighbors (possible moves) ---\n    for dx, dy, action_id in MOVES:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n      \n      # Check if this cell has already been visited in the shortest path search\n      if (next_x, next_y) in visited:\n        continue\n      \n      # Check traversability of (next_x, next_y)\n      # A cell is considered non-traversable (an obstacle) if it contains any non-grabbable item\n      # UNLESS that item is the specific primitive we are looking for AND that primitive is grabbable\n      # (meaning we can move onto it to collect).\n      is_traversable = True\n      for kind_id in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_id] > 0: # If this non-grabbable item is present at (next_x, next_y)\n              # If it's the primitive we want AND it's grabbable, we can move there.\n              # Otherwise, it's an obstacle.\n              if not (is_primitive_grabbable and kind_id == primitive_idx):\n                  is_traversable = False\n                  break\n      \n      if not is_traversable:\n        continue\n\n      # If the cell is traversable and not visited, add it to the queue\n      visited.add((next_x, next_y))\n      q.append((next_x, next_y, path_actions + [action_id]))\n\n  if target_reached_path:\n    return target_reached_path\n  else:\n    # If the BFS completes and no path to the primitive or its adjacent cell was found.\n    return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:41:58.417301", "function_name": "collect", "function_body": "  actions_list = []\n\n  current_state = env._current_state\n  grid_height, grid_width, _ = current_state.grid.shape\n  start_x, start_y = current_state.pos # Agent's position is (x, y) where x is column, y is row\n\n  # Get the integer index for the target primitive from the cookbook\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # If the agent already has at least one of the primitive, no collection actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Map action names to their integer indices\n  actions_map = env.action_specs()\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Determine if interacting with this primitive requires a 'USE' action.\n  # Grabbable items (like WOOD) and workshops typically require a 'USE' action.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  requires_use_action = is_grabbable or is_workshop\n\n  # Define indices for entities that block agent movement (impassable terrain).\n  # In CraftWorld, 'water' is explicitly defined as a movement blocker.\n  impassable_for_movement_indices = {env.world.water_index}\n\n  # Find all grid locations where the primitive instances exist.\n  # np.argwhere returns a list of (row, col) pairs, which corresponds to (y, x).\n  primitive_locations_yx = np.argwhere(current_state.grid[:, :, primitive_idx] > 0)\n\n  # If the primitive is not found anywhere on the map, return an empty list of actions.\n  if primitive_locations_yx.size == 0:\n      return []\n\n  # Identify all potential target cells for BFS.\n  # The `CraftState.next_to` method checks a 3x3 neighborhood around the agent's position.\n  # Therefore, any walkable cell within this 3x3 area of a primitive instance is a valid\n  # target for the agent to reach to be able to 'USE' or 'collect' the primitive.\n  target_cells = set()\n  # Define all 9 relative positions for a 3x3 neighborhood (including (0,0) for the center).\n  neighbor_deltas = [\n      (dy, dx) for dy in range(-1, 2) for dx in range(-1, 2)\n  ]\n\n  for py, px in primitive_locations_yx: # Iterate through each primitive instance's (row, col)\n      for dy, dx in neighbor_deltas:    # Check all cells in its 3x3 neighborhood\n          ny, nx = py + dy, px + dx # Calculate new_y, new_x (row, col) for the neighbor cell\n\n          # Ensure the neighbor cell is within the grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the neighbor cell is blocked by any impassable terrain.\n          is_cell_blocked = any(current_state.grid[ny, nx, k] > 0 for k in impassable_for_movement_indices)\n          \n          # If the cell is not blocked, it's a valid target for the agent to move to.\n          if not is_cell_blocked:\n              target_cells.add((nx, ny)) # Store as (x, y) tuple for consistency with agent's position format\n\n  # If no reachable target cells are found for any primitive instance, return empty.\n  if not target_cells:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # starting position to any of the identified target cells.\n  # The queue stores tuples: (current_x, current_y, list_of_coordinates_in_path).\n  queue = collections.deque([(start_x, start_y, [])])\n  visited = set([(start_x, start_y)]) # Keep track of visited cells to avoid cycles and redundant paths.\n\n  path_found_coordinates = None # This will store the sequence of (x,y) coordinates of the shortest path.\n\n  while queue:\n      cx, cy, current_path_coordinates = queue.popleft()\n\n      # If the current cell is one of our target cells, we have found the shortest path.\n      if (cx, cy) in target_cells:\n          path_found_coordinates = current_path_coordinates\n          break\n\n      # Explore the 4 direct neighbors (up, down, left, right) for standard grid movement.\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # (dx, dy) => (change in x, change in y)\n          nx, ny = cx + dx, cy + dy # Calculate new_x, new_y\n\n          # Check if the new cell is within grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the new cell is blocked by impassable terrain.\n          is_cell_blocked = any(current_state.grid[ny, nx, k] > 0 for k in impassable_for_movement_indices)\n          \n          if is_cell_blocked:\n              continue\n          \n          # If the new cell has not been visited, add it to the queue for exploration.\n          if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append((nx, ny, current_path_coordinates + [(nx, ny)]))\n\n  # If no path was found to any target cell, return an empty list.\n  if path_found_coordinates is None:\n      return []\n\n  # Convert the sequence of (x,y) coordinates in the found path into a sequence of action indices.\n  px, py = start_x, start_y\n  for nx, ny in path_found_coordinates:\n      if nx > px:\n          actions_list.append(ACTION_RIGHT)\n      elif nx < px:\n          actions_list.append(ACTION_LEFT)\n      elif ny > py:\n          actions_list.append(ACTION_DOWN) # Increasing y means moving down in NumPy array indexing.\n      elif ny < py:\n          actions_list.append(ACTION_UP)   # Decreasing y means moving up in NumPy array indexing.\n      px, py = nx, ny # Update current position for the next step in the path.\n\n  # If the primitive requires a 'USE' action (e.g., to pick up or interact with a workshop),\n  # append it after the agent has moved to the target location.\n  if requires_use_action:\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:41:59.506285", "function_name": "collect", "function_body": "  actions_list = []\n\n  # Retrieve the current state of the agent and environment\n  current_state = env._current_state\n  grid_height, grid_width, _ = current_state.grid.shape\n  start_x, start_y = current_state.pos  # Agent's current position (column, row)\n\n  # Get the integer ID for the target primitive from the environment's cookbook.\n  # This relies on the primitive name being valid and present in the cookbook's index.\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Map symbolic action names to their corresponding integer indices.\n  actions_map = env.action_specs()\n  ACTION_UP = actions_map['UP']\n  ACTION_DOWN = actions_map['DOWN']\n  ACTION_LEFT = actions_map['LEFT']\n  ACTION_RIGHT = actions_map['RIGHT']\n  ACTION_USE = actions_map['USE']\n\n  # Determine if interaction with this primitive requires a 'USE' action.\n  # Based on CraftWorld's definition, items in `grabbable_indices` (like 'wood', 'iron')\n  # and `workshop_indices` (like 'workshop0') typically require a 'USE' action.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  # A `USE` action is performed if the item is grabbable or it's a workshop.\n  requires_use_action = is_grabbable or is_workshop\n\n  # Define indices for entities that block agent movement (impassable terrain).\n  # 'water' is explicitly defined as an impassable obstacle.\n  impassable_for_movement_indices = {env.world.water_index}\n\n  # Find all grid locations where instances of the target primitive exist.\n  # np.argwhere returns coordinates in (row, column) format, i.e., (y, x).\n  primitive_locations_yx = np.argwhere(current_state.grid[:, :, primitive_idx] > 0)\n\n  # If no instances of the primitive are found on the map, no actions can be taken.\n  if primitive_locations_yx.size == 0:\n      return []\n\n  # Identify all potential target cells for BFS. These are cells the agent can move to\n  # and from which it can interact with the primitive.\n  # The CraftState.next_to method (likely used internally by 'USE' action for checking proximity)\n  # checks a 3x3 neighborhood around the agent. Thus, any walkable cell within a 3x3\n  # region of a primitive instance is considered a valid target cell to reach.\n  target_cells = set()\n  # Define relative coordinates for a 3x3 neighborhood (including (0,0) for the center).\n  neighbor_deltas = [\n      (dy, dx) for dy in range(-1, 2) for dx in range(-1, 2)\n  ]\n\n  for py, px in primitive_locations_yx:  # Iterate through each primitive instance's (row, col)\n      for dy, dx in neighbor_deltas:     # Check all cells in its 3x3 neighborhood\n          ny, nx = py + dy, px + dx      # Calculate new_y (row), new_x (col)\n\n          # Ensure the potential target cell is within the grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the cell is blocked by any impassable terrain.\n          # If any layer at (ny, nx) contains an impassable item, the cell is blocked.\n          is_cell_blocked = any(current_state.grid[ny, nx, k] > 0 for k in impassable_for_movement_indices)\n          \n          # If the cell is not blocked, it's a valid target for the agent to move to.\n          # Store as (x, y) tuple for consistency with agent's position format.\n          if not is_cell_blocked:\n              target_cells.add((nx, ny))\n\n  # If no reachable target cells are found for any primitive instance, return empty.\n  if not target_cells:\n      return []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # starting position to any of the identified target cells.\n  # The queue stores tuples: (current_x, current_y, list_of_coordinates_in_path).\n  # The path_coordinates list records the (x, y) steps taken to reach (current_x, current_y).\n  queue = collections.deque([(start_x, start_y, [])])\n  # Keep track of visited cells to prevent cycles and redundant explorations.\n  visited = set([(start_x, start_y)])\n\n  path_found_coordinates = None  # This will store the (x, y) sequence of the shortest path.\n\n  while queue:\n      cx, cy, current_path_coordinates = queue.popleft()\n\n      # If the current cell is one of the target cells, we have found the shortest path.\n      if (cx, cy) in target_cells:\n          path_found_coordinates = current_path_coordinates\n          break\n\n      # Explore the 4 direct neighbors (up, down, left, right) for movement.\n      # (dx, dy) deltas for (change in x, change in y)\n      # (0, 1) -> RIGHT, (0, -1) -> LEFT\n      # (1, 0) -> DOWN, (-1, 0) -> UP (due to (row, col) indexing convention)\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nx, ny = cx + dx, cy + dy  # Calculate new_x, new_y\n\n          # Check if the new cell is within grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n          \n          # Check if the new cell is blocked by any impassable terrain.\n          is_cell_blocked = any(current_state.grid[ny, nx, k] > 0 for k in impassable_for_movement_indices)\n          \n          if is_cell_blocked:\n              continue\n          \n          # If the new cell has not been visited, add it to the queue for further exploration.\n          if (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append((nx, ny, current_path_coordinates + [(nx, ny)]))\n\n  # If no path was found to any target cell (e.g., all targets are unreachable), return an empty list.\n  if path_found_coordinates is None:\n      return []\n\n  # Convert the sequence of (x, y) coordinates in the found path into a sequence of action indices.\n  px, py = start_x, start_y\n  for nx, ny in path_found_coordinates:\n      if nx > px:\n          actions_list.append(ACTION_RIGHT)\n      elif nx < px:\n          actions_list.append(ACTION_LEFT)\n      elif ny > py:\n          # In NumPy arrays, increasing row index (y) means moving downwards.\n          actions_list.append(ACTION_DOWN)\n      elif ny < py:\n          # In NumPy arrays, decreasing row index (y) means moving upwards.\n          actions_list.append(ACTION_UP)\n      px, py = nx, ny  # Update current position for the next step in the path.\n\n  # After moving to the target location, if the primitive requires a 'USE' action\n  # (e.g., to pick up an item or interact with a workshop), append it to the actions list.\n  if requires_use_action:\n      actions_list.append(ACTION_USE)\n\n  return actions_list", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T20:43:00.327005", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index[primitive] # Returns int or None\n\n  if primitive_id is None: # Primitive name not recognized\n      return []\n\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Action mapping\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # Directions relative to current position, mapped to actions\n  # (dr, dc) -> action\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  # For BFS neighbors (4-connected movement)\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  # Get water index for traversability check. Water is generally an untraversable obstacle.\n  i_water = env.world.water_index\n\n  # 1. Check if the primitive is already in inventory (if it's a grabbable item)\n  # Or if the agent is already in a position to \"collect\" a non-grabbable item.\n  if primitive_id in env.world.grabbable_indices and state.inventory[primitive_id] > 0:\n      return []\n  # If it's a non-grabbable item (e.g., WORKSHOP), \"collecting\" means reaching it.\n  # If the agent is already next to it, and no 'USE' is needed, then perhaps no actions are needed.\n  # However, for a generic 'collect' action, we assume a path is always needed unless already \"collected\".\n\n  # 2. Determine target cells for BFS and whether a USE action is needed after reaching the target.\n  target_cells_for_bfs = set()\n  add_use_action = False\n\n  if primitive_id in env.world.grabbable_indices:\n      # For grabbable items (e.g., WOOD, IRON), we need to move to a cell\n      # in its 3x3 neighborhood, then apply the USE action.\n      add_use_action = True\n      for r_obj in range(HEIGHT):\n          for c_obj in range(WIDTH):\n              if grid[r_obj, c_obj, primitive_id] > 0:\n                  # This cell (r_obj, c_obj) contains the grabbable primitive.\n                  # The agent can pick it up from any cell in its 3x3 neighborhood.\n                  # Only add traversable cells to the target_cells_for_bfs set.\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r_obj + dr_adj, c_obj + dc_adj\n                          # Check if neighbor is within bounds and traversable (not water)\n                          if (0 <= nr < HEIGHT and 0 <= nc < WIDTH and \n                              grid[nr, nc, i_water] == 0): # Cell must not contain water\n                              target_cells_for_bfs.add((nr, nc))\n\n  elif primitive_id in env.world.non_grabbable_indices:\n      # For non-grabbable items (e.g., WORKSHOP, STONE), \"collecting\" means\n      # reaching a cell that contains the primitive itself (standing on it).\n      # No USE action is typically needed.\n      add_use_action = False\n      for r_obj in range(HEIGHT):\n          for c_obj in range(WIDTH):\n              if grid[r_obj, c_obj, primitive_id] > 0:\n                  # The agent must be able to stand on this cell (r_obj, c_obj)\n                  if grid[r_obj, c_obj, i_water] == 0: # Cell must not contain water\n                      target_cells_for_bfs.add((r_obj, c_obj))\n  else:\n      # The primitive is not a recognized grabbable or non-grabbable entity that can be collected.\n      return []\n\n  if not target_cells_for_bfs:\n      # No valid target cells found (e.g., primitive not present on the grid,\n      # or all potential target cells are blocked by water).\n      return []\n\n  # 3. Find shortest path to any target cell using Breadth-First Search (BFS)\n  queue = collections.deque([(current_row, current_col, [])]) # (row, col, list_of_actions_to_reach_here)\n  visited = {(current_row, current_col)} # Keep track of visited (row, col) tuples\n  \n  shortest_path = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      if (r, c) in target_cells_for_bfs:\n          shortest_path = path\n          break # Found the shortest path to a valid target cell\n\n      # Explore valid neighbors (Up, Down, Left, Right)\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc # Next row, next column\n\n          # Check if the next cell is within grid bounds\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          # Check if the next cell is an obstacle (e.g., contains water)\n          if grid[nr, nc, i_water] > 0:\n              continue\n\n          # If the cell has not been visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy to avoid modifying shared list\n              new_path.append(move_deltas_to_action[(dr, dc)])\n              queue.append((nr, nc, new_path))\n              \n  if shortest_path is None:\n      return [] # No path found to any target cell\n\n  final_actions = list(shortest_path)\n  if add_use_action:\n      final_actions.append(USE_ACTION)\n\n  return final_actions", "island_id": 5, "scores": {"3": 0.0}}
