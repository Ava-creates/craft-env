{"timestamp": "2025-08-02T04:10:58.995507", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state (numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds))\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found, it cannot be collected.\n    return []\n\n  # OPTIMIZATION: If the agent already has the primitive in its inventory,\n  # no actions are needed to collect it again.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get the integer action IDs from the environment's action_specs.\n  # This ensures compatibility with the CraftLab's internal action mapping.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements as (delta_x, delta_y, action_id).\n  # The grid is indexed as (x, y) where x is column and y is row.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up (decreases y-coordinate)\n      (0, 1, ACTION_DOWN),   # Move Down (increases y-coordinate)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases x-coordinate)\n      (1, 0, ACTION_RIGHT),  # Move Right (increases x-coordinate)\n  ]\n\n  # Get grid dimensions to check for boundaries during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position for the BFS search.\n  start_pos = state.pos\n\n  # Identify the index for 'BOUNDARY' to treat it as an impassable obstacle during pathfinding.\n  # It's important to check if 'BOUNDARY' actually exists in the cookbook's index.\n  boundary_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      boundary_idx = cookbook.index['BOUNDARY']\n\n  # Initialize BFS (Breadth-First Search) structures.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of positions already explored to prevent cycles and redundant work.\n  visited = {start_pos} \n\n  # Classify the target primitive based on how it's \"collected\".\n  # This determines the goal condition for the BFS.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Other stationary primitives like water or stone, or even boundary itself if it's the target.\n  is_stationary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      (boundary_idx is not None and primitive_idx == boundary_idx)\n  )\n\n  # BFS loop: Continues as long as there are positions to explore in the queue.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a *hypothetical* CraftState object at the `current_pos` in the search space.\n    # This allows us to use CraftState methods (like `next_to`) to evaluate goal conditions\n    # as if the agent were physically at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the `current_pos` represents a state where the primitive can be collected.\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Additional actions (e.g., USE) needed once at the target location.\n\n    if is_grabbable:\n      # For grabbable items, the agent must be in a 3x3 neighborhood and then perform ACTION_USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives, collecting simply means being on the same cell.\n      # Check if the primitive exists (count > 0) at the `current_pos`.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No additional action needed once on the spot.\n    \n    # If a goal state is found, return the path immediately.\n    # BFS guarantees that the first path found is the shortest (in terms of moves) in an unweighted graph.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore valid neighboring positions from the `current_pos`.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Determine if the new position is an impassable obstacle.\n        # A cell is considered an impassable obstacle if it contains 'BOUNDARY'\n        # AND the target primitive itself is NOT 'BOUNDARY'. This allows pathing *to* a boundary\n        # if boundary is the goal, but not *through* it otherwise.\n        is_impassable_obstacle = False\n        if boundary_idx is not None:\n            if grid[new_x, new_y, boundary_idx] > 0 and primitive_idx != boundary_idx:\n                is_impassable_obstacle = True\n\n        # If the new position hasn't been visited yet and is not an obstacle, add it to the queue.\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes (queue is empty) and no path to the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T04:11:00.237875", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # The static grid layout for pathfinding\n\n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  # The Index class's __getitem__ method returns an int ID or None if the item is not found.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early exit: If the agent already has the primitive in its inventory,\n  # the collection goal is already satisfied, so no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve integer action IDs from the environment's action specifications.\n  # This ensures correct mapping of action names (e.g., 'UP') to the integers expected by env.step().\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 4. Define movement vectors (delta_x, delta_y) and their corresponding action IDs.\n  # Grid coordinates are typically (column, row).\n  possible_moves = [\n      (0, -1, ACTION_UP),    # Move Up (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move Down (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases X)\n      (1, 0, ACTION_RIGHT),  # Move Right (increases X)\n  ]\n\n  # 5. Get grid dimensions for boundary checks during pathfinding.\n  grid_width, grid_height, _ = grid.shape\n\n  # 6. Set the agent's current position as the starting point for the search.\n  start_pos = current_state.pos\n\n  # 7. Identify the index for 'BOUNDARY' to treat it as an impassable obstacle.\n  # Safely check if 'BOUNDARY' exists in the cookbook's index.\n  boundary_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      boundary_idx = cookbook.index['BOUNDARY']\n\n  # 8. Initialize Breadth-First Search (BFS) data structures.\n  # The queue stores (current_position, list_of_actions_to_reach_here).\n  search_queue = collections.deque([(start_pos, [])]) \n  # The visited set keeps track of explored positions to prevent cycles and redundant work,\n  # ensuring the shortest path is found.\n  visited_positions = {start_pos} \n\n  # 9. Classify the target primitive to determine the specific conditions for collection.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  \n  # Check if the primitive is a stationary, non-grabbable entity (like water, stone, or the boundary itself).\n  is_stationary_target = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      (boundary_idx is not None and primitive_idx == boundary_idx) # If target IS boundary\n  )\n\n  # 10. BFS loop: Continues as long as there are positions to explore in the queue.\n  while search_queue:\n    current_pos, path_actions = search_queue.popleft()\n\n    # Create a hypothetical CraftState object for the `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) to evaluate collection conditions\n    # as if the agent were at `current_pos`, without actually modifying the environment's state.\n    # Agent's current direction and inventory are passed but don't typically affect spatial pathfinding.\n    hypothetical_state = craft.CraftState(\n        scenario=current_state.scenario, \n        grid=current_state.grid, \n        pos=current_pos, \n        dir=current_state.dir, \n        inventory=current_state.inventory\n    )\n\n    # Determine if the primitive can be collected from `current_pos`.\n    is_goal_achieved = False\n    additional_actions_for_goal = [] # Actions like ACTION_USE, if required after reaching location.\n\n    if is_grabbable_item:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them\n      # and then perform the ACTION_USE.\n      if hypothetical_state.next_to(primitive_idx):\n        is_goal_achieved = True\n        additional_actions_for_goal = [ACTION_USE]\n    elif is_workshop_location or is_stationary_target:\n      # For workshops or stationary primitives (water, stone, boundary),\n      # \"collection\" means simply being on the same cell as the primitive.\n      # Check if the primitive is present (count > 0) at the current cell.\n      if hypothetical_state.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_achieved = True\n        additional_actions_for_goal = [] # No ACTION_USE is typically needed for these.\n    \n    # If the goal condition is met at the `current_pos`, return the complete path of actions.\n    # BFS guarantees that the first path found to a goal state is the shortest.\n    if is_goal_achieved:\n      return path_actions + additional_actions_for_goal\n\n    # Explore valid neighbors from the `current_pos`.\n    for dx, dy, action_id in possible_moves:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_position = (new_x, new_y)\n\n      # Check if the new position is within the defined grid boundaries.\n      if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n        # Determine if the new position is an impassable obstacle.\n        # A cell is an obstacle if it contains 'BOUNDARY' AND the target primitive is NOT 'BOUNDARY'.\n        # This allows pathing *to* the boundary if that's the goal, but not *through* it otherwise.\n        is_impassable_obstacle = False\n        if boundary_idx is not None:\n            if grid[new_x, new_y, boundary_idx] > 0 and primitive_idx != boundary_idx:\n                is_impassable_obstacle = True\n\n        # If the new position hasn't been visited yet and is not an obstacle, add it to the queue.\n        if new_position not in visited_positions and not is_impassable_obstacle:\n          visited_positions.add(new_position)\n          search_queue.append((new_position, path_actions + [action_id]))\n  \n  # If the BFS completes and the queue becomes empty without finding a path,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T04:12:01.809274", "function_name": "collect", "function_body": "  # Mappings for directions to (dx, dy) offsets for the cell *in front* of the agent\n  # Agent direction: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  DIR_TO_OFFSET = {\n      0: (0, -1), # UP\n      1: (1, 0),  # RIGHT\n      2: (0, 1),  # DOWN\n      3: (-1, 0)  # LEFT\n  }\n\n  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index.get(primitive) # Use .get() for safer lookup, returns None if not found\n  if primitive_idx is None:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Mapping of movement actions to (dx, dy) and new direction after the move\n  # The direction is implicitly set by the movement action.\n  ACTION_TO_MOVE_AND_DIR = {\n      ACTION_UP: (0, -1, 0),    # dx, dy, new_dir (0=UP)\n      ACTION_DOWN: (0, 1, 2),   # dx, dy, new_dir (2=DOWN)\n      ACTION_LEFT: (-1, 0, 3),  # dx, dy, new_dir (3=LEFT)\n      ACTION_RIGHT: (1, 0, 1),  # dx, dy, new_dir (1=RIGHT)\n  }\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine properties of the target primitive\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # These are non-grabbable entities where \"collection\" means reaching their cell.\n  # This includes water, stone, and the boundary.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index.get('BOUNDARY'))\n\n  # BFS setup\n  # Queue stores tuples: ((current_pos_x, current_pos_y, current_dir), list_of_actions_to_reach_here)\n  start_pos_x, start_pos_y = state.pos\n  start_dir = state.dir\n  \n  q = collections.deque([(((start_pos_x, start_pos_y), start_dir), [])]) \n  \n  # Visited set stores (pos_x, pos_y, dir) tuples to avoid re-processing states\n  visited = {((start_pos_x, start_pos_y), start_dir)}\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # BFS loop\n  while q:\n    ((curr_x, curr_y), curr_dir), current_actions = q.popleft()\n\n    # Optimization: If the current path is already longer than or equal to the best found path, prune.\n    if len(current_actions) >= min_path_len:\n        continue\n\n    # --- Check if the current state (position + direction) can satisfy the goal ---\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Actions to perform *after* reaching current_pos and current_dir\n\n    if is_grabbable:\n      # For grabbable items, the agent must be adjacent and facing the item to USE it.\n      dx_front, dy_front = DIR_TO_OFFSET[curr_dir]\n      front_x, front_y = curr_x + dx_front, curr_y + dy_front\n\n      # Check if the cell in front is within bounds and contains the primitive\n      if 0 <= front_x < WIDTH and 0 <= front_y < HEIGHT:\n        if grid[front_x, front_y, primitive_idx] > 0: \n          is_goal_reached = True\n          actions_to_complete_goal = [ACTION_USE] # The USE action collects the item\n\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n        # No 'break' here. BFS explores all paths of minimal length,\n        # and this ensures we find the absolute shortest sequence of actions,\n        # including the potential ACTION_USE.\n\n    # --- Explore next states (by taking movement actions) ---\n    for action, (dx, dy, new_dir) in ACTION_TO_MOVE_AND_DIR.items():\n      new_x, new_y = curr_x + dx, curr_y + dy\n      new_pos = (new_x, new_y)\n      next_state_tuple = (new_pos, new_dir) # State in BFS is (position, direction)\n\n      # Check if the new position is within grid boundaries and this (position, direction) state has not been visited\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          q.append((next_state_tuple, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-02T04:12:03.089312", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current state of the world grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  # The Index class's __getitem__ method returns an int ID or None if not found.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve integer mappings for actions from the environment's specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions in terms of (delta_x, delta_y, action_id).\n  # These tuples facilitate exploration of neighboring cells during the BFS.\n  MOVE_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move agent Up (decreases Y-coordinate)\n      (0, 1, ACTION_DOWN),   # Move agent Down (increases Y-coordinate)\n      (-1, 0, ACTION_LEFT),  # Move agent Left (decreases X-coordinate)\n      (1, 0, ACTION_RIGHT),  # Move agent Right (increases X-coordinate)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT, number_of_kinds).\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position.\n  start_pos = state.pos\n\n  # Initialize Breadth-First Search (BFS):\n  # The queue will store tuples of (current_position, list_of_actions_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # A set to keep track of visited positions to avoid cycles and redundant processing.\n  visited = {start_pos} \n\n  # Variables to store the shortest sequence of actions found so far.\n  min_total_actions_len = float('inf')\n  shortest_path_actions = []\n\n  # Categorize the primitive to apply appropriate collection logic.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  is_workshop_location = primitive_idx in env.world.workshop_indices\n  # Immobile environment elements like water, stone, or boundaries that are 'collected' by merely reaching their cell.\n  is_immobile_environment = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical `CraftState` object at the `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) to check conditions\n    # as if the agent were actually at this position, without modifying the real environment state.\n    # The agent's direction and inventory are kept constant as they don't affect grid-based pathfinding for location.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Determine if the primitive can be 'collected' from the `current_pos`.\n    # This acts as the goal condition for our BFS.\n    goal_met_at_current_pos = False\n    # Actions that might be needed *after* reaching `current_pos` to complete collection (e.g., USE).\n    post_movement_actions_for_collection = []\n\n    if is_grabbable_item:\n      # For items that can be picked up (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        goal_met_at_current_pos = True\n        post_movement_actions_for_collection = [ACTION_USE]\n    elif is_workshop_location or is_immobile_environment:\n      # For workshops or environmental features, \"collecting\" means being on the same cell as the item.\n      # We check if the target primitive is present at the `current_pos`.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        goal_met_at_current_pos = True\n        post_movement_actions_for_collection = [] # No additional action like USE is required.\n\n    # If the goal condition is met at the current position, evaluate this path.\n    if goal_met_at_current_pos:\n      total_path_candidate = current_actions + post_movement_actions_for_collection\n      # If this path is shorter than any previously found path, update the shortest path.\n      if len(total_path_candidate) < min_total_actions_len:\n        min_total_actions_len = len(total_path_candidate)\n        shortest_path_actions = total_path_candidate\n      # IMPORTANT: We do NOT `break` here. BFS guarantees the shortest path to a *node*.\n      # However, our \"goal\" might involve an action (like `USE`) taken from a node,\n      # and multiple nodes (e.g., different adjacent cells) could satisfy the condition.\n      # We must continue the BFS to ensure we find the absolute shortest *sequence of actions*\n      # that leads to successful collection.\n\n    # Explore valid neighbors of the current position.\n    for dx, dy, action in MOVE_ACTIONS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # Return the shortest sequence of actions found to collect the primitive.\n  return shortest_path_actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T04:13:22.681377", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # For grabbable items, we still need to find the overall shortest path,\n  # which might require exploring multiple adjacent cells.\n  min_path_len = float('inf') # This will store the length of the shortest *total* action sequence (including USE)\n  best_path_actions = [] # This will store the actual sequence\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      if is_workshop or is_stationary_primitive:\n        # For these primitives, simply being on the tile is the goal.\n        # Since BFS explores in layers, the first time we reach *any* such tile,\n        # current_actions represents the shortest path to that tile.\n        return current_actions # Found the shortest path, return immediately for efficiency.\n      elif is_grabbable:\n        # For grabbable items, we need to find the shortest path to *any* adjacent cell\n        # and then perform a USE action. We must continue BFS to ensure we find the\n        # globally shortest path across all possible adjacent cells.\n        total_actions = current_actions + actions_to_complete_goal\n        if len(total_actions) < min_path_len:\n          min_path_len = len(total_actions)\n          best_path_actions = total_actions\n        # Do not break here; continue BFS to find potentially shorter paths to other adjacent locations.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS queue is exhausted and a path was found (relevant for grabbable items), return it.\n  # If no path was found (e.g., primitive not on the map or unreachable), best_path_actions will be empty,\n  # which is the correct behavior.\n  return best_path_actions", "island_id": 8, "scores": {"3": 0.5}}
