{"timestamp": "2025-08-02T10:25:58.862843", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Convert the primitive name (string) to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    return []\n\n  # 2. Early Exit: Check if the primitive is already present in the agent's inventory.\n  # If so, no further collection actions are needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve action mappings for movement and 'USE' action.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] \n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # The agent's current position is the starting point for BFS.\n  start_pos = state.pos\n\n  # 4. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of grid positions already explored to prevent cycles\n  # and ensure we always find the shortest path to a given cell.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found.\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # 5. Determine the collection mechanism based on the primitive's type.\n  # These flags help decide the goal condition within the BFS.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for other special non-grabbable primitives (water, stone, boundary)\n  # whose \"collection\" means simply reaching the cell where they are located.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # 6. BFS Traversal Loop: Continues until all reachable paths are explored.\n  while q:\n    current_pos, current_actions = q.popleft()\n    cx, cy = current_pos # Unpack current position coordinates (X, Y).\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos` in the simulation.\n    # Agent's direction and inventory are kept constant as they don't affect geometric pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 7. Check if the current position satisfies the goal condition for collecting the primitive.\n    is_current_goal_met = False\n    actions_to_complete_goal = [] # Additional actions (e.g., USE) needed after reaching current_pos.\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON, GRASS), the agent needs to be adjacent\n      # to them (within a 3x3 neighborhood) and then perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_current_goal_met = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # The agent needs to be on the cell containing the primitive.\n      if temp_state_at_pos.grid[cx, cy, primitive_idx] > 0:\n        is_current_goal_met = True\n        actions_to_complete_goal = [] # No 'USE' action is typically needed for these.\n    \n    # If a goal state is reached at the current position, evaluate if this path is the shortest.\n    if is_current_goal_met:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # We don't break here because BFS guarantees the shortest path to any *node*,\n      # but our \"goal\" might be met at multiple nodes or require an additional action ('USE'),\n      # so we must explore all paths to ensure the globally shortest action sequence is found.\n\n    # 8. Explore valid neighbors (movement actions) from `current_pos`.\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the `new_pos` is within the grid boundaries and has not been visited yet.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT and new_pos not in visited:\n        visited.add(new_pos) # Mark `new_pos` as visited to prevent redundant processing.\n        # Add the new position to the queue along with the accumulated path to reach it.\n        q.append((new_pos, current_actions + [move_action]))\n  \n  # 9. Return the shortest sequence of actions found to collect the primitive.\n  # If the BFS completes and no goal was reached, best_path_actions will remain empty.\n  return best_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:26:00.035298", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` using a robust BFS strategy to find the shortest action sequence.\"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid \n  \n  # 1. Convert the primitive name (string) to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # 2. Early Exit: Check if the primitive is already in inventory.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve action mappings for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X)\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position is the BFS start node.\n  start_pos = current_state.pos\n\n  # 4. Determine the collection mechanism based on the primitive's type.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_stationary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      primitive_idx == cookbook.index['BOUNDARY'] # Boundary is a special stationary item\n  )\n\n  # 5. BFS Initialization:\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The 'visited' set keeps track of grid positions already explored to prevent cycles.\n  visited = {start_pos} \n\n  # Initialize variables to track the shortest path found so far.\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # 6. BFS Traversal Loop: Continues until all reachable paths are explored.\n  while q:\n    current_pos, actions_to_current_pos = q.popleft()\n    \n    # Create a hypothetical CraftState at `current_pos` to easily check conditions\n    # like `next_to` or `grid` contents as if the agent were there.\n    temp_state_at_pos = craft.CraftState(\n        current_state.scenario, \n        current_state.grid, \n        current_pos, \n        current_state.dir, \n        current_state.inventory\n    )\n\n    # Check if the current position allows for collecting the primitive.\n    is_goal_reached_at_this_pos = False\n    actions_to_complete_goal = [] # Additional actions needed (e.g., USE)\n\n    if is_grabbable:\n      # For grabbable items, the agent must be adjacent and use ACTION_USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached_at_this_pos = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or other stationary primitives, the agent must be on the cell.\n      cx, cy = current_pos\n      if temp_state_at_pos.grid[cx, cy, primitive_idx] > 0:\n        is_goal_reached_at_this_pos = True\n        actions_to_complete_goal = [] # No additional USE action needed\n\n    # If a goal condition is met at this position, update the best path.\n    if is_goal_reached_at_this_pos:\n      total_actions = actions_to_current_pos + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # IMPORTANT: Do not break here. Continue BFS to ensure finding the absolute\n      # shortest sequence of actions, as different paths to \"goal-enabling\" tiles\n      # might lead to different total action counts (due to the `USE` action).\n\n    # Explore valid neighbors (movement actions) from `current_pos`.\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the `new_pos` is within grid boundaries and not yet visited.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT and new_pos not in visited:\n        visited.add(new_pos) # Mark as visited.\n        # Add the new position to the queue along with the accumulated path.\n        q.append((new_pos, actions_to_current_pos + [move_action]))\n  \n  # 7. Return the shortest path found after exhausting the BFS.\n  # If no path was found, best_path_actions will remain an empty list.\n  return best_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:26:42.758624", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (x, y) coordinates of the agent\n  cookbook = env.world.cookbook\n  \n  # Map the primitive's string name to its integer ID used in the grid and inventory.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve the integer codes for movement and 'USE' actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Define indices of grid elements that block agent movement.\n  # In CraftWorld, 'water' and 'boundary' are typically impassable.\n  blocking_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a given grid coordinate is valid (within bounds)\n  # and traversable (does not contain any blocking entity).\n  def is_traversable(x: int, y: int) -> bool:\n    # Check for grid boundary violations.\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    \n    # Check if the cell at (x, y) is occupied by any blocking kind.\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False  # This cell is an obstacle.\n    return True\n\n  # Locate all occurrences of the target primitive on the current grid.\n  # np.argwhere returns an array of (x, y) coordinates where the primitive is present.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # --- Pre-calculate all grid cells from which the agent can 'USE' the primitive. ---\n  # A spot (ux, uy) is a valid 'USE' spot if it's within Chebyshev distance 1\n  # of any primitive_location (px, py). Pre-calculating this boolean grid makes the\n  # goal check inside the BFS loop an efficient O(1) lookup.\n  collectable_use_spots_grid = np.full((WIDTH, HEIGHT), False, dtype=bool)\n  for px, py in primitive_locations_on_grid:\n    # Iterate over the 3x3 neighborhood (including the center) around each primitive location.\n    for dx_use in [-1, 0, 1]:\n      for dy_use in [-1, 0, 1]:\n        ux, uy = px + dx_use, py + dy_use\n        # Ensure the potential use spot is within grid bounds.\n        if 0 <= ux < WIDTH and 0 <= uy < HEIGHT:\n          collectable_use_spots_grid[ux, uy] = True\n\n  # Initial check: Is the agent already at a collectable_use_spot?\n  # If so, only the 'USE' action is needed.\n  if collectable_use_spots_grid[agent_pos[0], agent_pos[1]]:\n      return [USE]\n\n  # --- Breadth-First Search (BFS) for Shortest Pathfinding ---\n  # The goal of BFS is to find the shortest sequence of actions to move the agent\n  # to a position from which it can 'USE' the primitive.\n\n  # BFS queue: stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set: stores (x, y) coordinates to prevent revisiting locations and cycles.\n  visited = {agent_pos}\n\n  # Define the relative position changes (dx, dy) for each movement action.\n  move_deltas = {\n      UP: (0, -1),   # Move North (decreasing y)\n      DOWN: (0, 1),    # Move South (increasing y)\n      LEFT: (-1, 0),   # Move West (decreasing x)\n      RIGHT: (1, 0),   # Move East (increasing x)\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue the current position and its path.\n\n    # Explore all four possible neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the coordinates of the new potential position.\n\n      # Check if the new position (nx, ny) is valid, traversable, and unvisited.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_actions + [action_type] # Extend the path to this new position.\n        \n        # Check if this new position is one of the pre-calculated collectable 'USE' spots.\n        if collectable_use_spots_grid[nx, ny]:\n          # If an adjacent position is found, append the 'USE' action and return\n          # the complete sequence of actions. BFS guarantees this is the shortest path.\n          return new_path_actions + [USE]\n        else:\n          # If not yet at a 'USE' spot, add this new position to the queue\n          # for further exploration and mark it as visited.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # If the BFS completes and the queue becomes empty without finding a path\n  # to an adjacent primitive location, it means the primitive is unreachable\n  # from the agent's current position given the obstacles.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:26:43.936196", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (x, y) coordinates of the agent\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive from the cookbook's index mapping.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Retrieve the integer codes for movement and 'USE' actions from the environment.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Define indices of grid elements that block agent movement.\n  # In CraftWorld, \"water\" and \"boundary\" are typically impassable.\n  blocking_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a given grid coordinate is valid (within bounds)\n  # and traversable (does not contain any blocking entity).\n  def is_traversable(x: int, y: int) -> bool:\n    # Check for grid boundary violations.\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    \n    # Check if the cell at (x, y) is occupied by any blocking kind.\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False  # This cell is an obstacle.\n    return True\n\n  # Locate all occurrences of the target primitive on the current grid.\n  # np.argwhere returns an array of (x, y) coordinates where the primitive is present.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # Pre-calculate all grid cells from which the agent can \"USE\" the primitive.\n  # A cell (ux, uy) is a valid 'USE' spot if it's within Chebyshev distance 1\n  # (i.e., in the 3x3 neighborhood) of any primitive_location (px, py).\n  collectable_use_spots = np.full((WIDTH, HEIGHT), False, dtype=bool)\n  for px, py in primitive_locations_on_grid:\n    # Iterate over the 3x3 neighborhood (including the center) around each primitive location.\n    for dx_use in [-1, 0, 1]:\n      for dy_use in [-1, 0, 1]:\n        ux, uy = px + dx_use, py + dy_use\n        # Ensure the potential use spot is within grid bounds.\n        if 0 <= ux < WIDTH and 0 <= uy < HEIGHT:\n          collectable_use_spots[ux, uy] = True\n\n  # Initial Check: Is the agent already at a position from which it can \"USE\" the primitive?\n  if collectable_use_spots[agent_pos[0], agent_pos[1]]:\n    return [USE]\n\n  # Breadth-First Search (BFS) for Shortest Pathfinding.\n  # The goal of BFS is to find the shortest sequence of actions to move the agent\n  # to a position from which it can 'USE' the primitive (i.e., a position marked\n  # as a `collectable_use_spot`).\n\n  # BFS queue: stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set: stores (x, y) coordinates to prevent revisiting locations and cycles.\n  visited = {agent_pos}\n\n  # Define the relative position changes (dx, dy) for each movement action.\n  move_deltas = {\n      UP: (0, -1),   # Move North (decreasing y)\n      DOWN: (0, 1),    # Move South (increasing y)\n      LEFT: (-1, 0),   # Move West (decreasing x)\n      RIGHT: (1, 0),   # Move East (increasing x)\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue the current position and its path.\n\n    # Explore all four possible neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the coordinates of the new potential position.\n\n      # Check if the new position (nx, ny) is valid, traversable, and unvisited.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_actions + [action_type] # Extend the path to this new position.\n        \n        # Check if this new position (nx, ny) is one of the pre-calculated 'USE' spots.\n        if collectable_use_spots[nx, ny]:\n          # If a path is found to a 'USE' spot, append the 'USE' action and return\n          # the complete sequence of actions. BFS guarantees this is the shortest path.\n          return new_path_actions + [USE]\n        else:\n          # If not yet at a 'USE' spot, add this new position to the queue\n          # for further exploration and mark it as visited.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # If the BFS completes and the queue becomes empty without finding a path\n  # to a 'USE' spot, it means the primitive is unreachable\n  # from the agent's current position given the obstacles.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:27:44.828631", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid layout (WIDTH, HEIGHT, n_kinds)\n  \n  # 1. Resolve the primitive name to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name isn't in the cookbook's index, it's an invalid target.\n    return []\n\n  # 2. Early exit: If the agent already has the primitive in inventory, it's considered collected.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Obtain action mappings for clearer code.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement directions and their corresponding action IDs.\n  # (delta_x, delta_y, action_id)\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North\n      (0, 1, ACTION_DOWN),   # Move South\n      (-1, 0, ACTION_LEFT),  # Move West\n      (1, 0, ACTION_RIGHT),  # Move East\n  ]\n\n  # Grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position for the BFS.\n  start_pos = state.pos\n\n  # BFS Queue: Stores tuples of (current_position, list_of_movement_actions_to_reach_here).\n  # We only track movement actions here; the final 'USE' action is added at goal detection.\n  q = collections.deque([(start_pos, [])]) \n  \n  # Visited set: Keeps track of grid positions that have been added to the queue to prevent cycles\n  # and redundant processing (since BFS finds the shortest path to a node first).\n  visited = {start_pos} \n\n  # Initialize variables to store the shortest path found so far.\n  min_total_actions_len = float('inf') # Tracks the length of the shortest path including 'USE'\n  best_path_actions = []               # Stores the actual sequence of actions\n\n  # Pre-classify the target primitive type for efficient goal condition checking.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Specific stationary primitives that are \"collected\" by simply being on their cell.\n  # \"BOUNDARY\" is also a kind of stationary primitive which the agent can be \"next to\"\n  # or even on (if it's a wall on the edge of the map, but agent can't move into it)\n  # For the purpose of \"collecting\" it means reaching the cell it occupies.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Main BFS loop: Explores the grid layer by layer.\n  while q:\n    current_pos, current_move_actions = q.popleft()\n\n    # Pruning: If the current sequence of movement actions is already as long as\n    # or longer than the best *total* action sequence found so far, then this\n    # path (and any path extending from it) cannot be shorter.\n    # This comparison assumes 'USE' is a single action, and movement actions also cost 1.\n    if len(current_move_actions) >= min_total_actions_len:\n      continue \n\n    # Create a temporary CraftState instance at `current_pos`.\n    # This allows us to leverage `CraftState` methods like `next_to` or inspect `grid` content\n    # as if the agent were physically at `current_pos`.\n    # Agent's direction and inventory are held constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Determine if the current position satisfies the goal for collecting the primitive.\n    is_goal_satisfied_at_current_pos = False\n    actions_to_complete_goal = [] # Actions required *after* reaching `current_pos` (e.g., `USE`).\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent must be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_satisfied_at_current_pos = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means simply being on that cell.\n      # We check if the primitive is present at the current cell's location.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_satisfied_at_current_pos = True\n        actions_to_complete_goal = [] # No additional action (like USE) is typically required.\n    \n    # If a goal condition is met at `current_pos`, evaluate if this path is the new shortest.\n    if is_goal_satisfied_at_current_pos:\n      total_actions_for_this_path = current_move_actions + actions_to_complete_goal\n      \n      # Update `min_total_actions_len` and `best_path_actions` if a shorter path is found.\n      if len(total_actions_for_this_path) < min_total_actions_len:\n        min_total_actions_len = len(total_actions_for_this_path)\n        best_path_actions = total_actions_for_this_path\n      \n      # IMPORTANT: Do NOT break here. BFS guarantees the shortest path to any *node*.\n      # However, our \"goal\" might be a *condition* (e.g., `next_to` covering multiple adjacent cells),\n      # or involve an additional action (`USE`). Continuing the BFS ensures we find the\n      # globally shortest sequence of actions, considering all possible locations and conditions.\n      # The `min_total_actions_len` pruning handles efficiency by cutting off longer branches.\n\n    # Explore valid neighboring cells.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the `new_pos` is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Before adding to the queue, check if this new path segment, if extended,\n        # could potentially be shorter than the current best path.\n        # `len(current_move_actions) + 1` is the length of the movement path to `new_pos`.\n        # If this length is already greater than or equal to `min_total_actions_len`,\n        # then any path originating from `new_pos` cannot be shorter than the current best.\n        if len(current_move_actions) + 1 < min_total_actions_len:\n          # Only add to the queue if the position hasn't been visited via a shorter or equal path.\n          # BFS ensures the first time we visit a node, it's via the shortest path to that node.\n          if new_pos not in visited:\n            visited.add(new_pos) # Mark as visited before adding to queue.\n            # Add the new position and the cumulative movement actions to the queue.\n            q.append((new_pos, current_move_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:27:45.944441", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Early exit: If the primitive is already in the agent's inventory, it's considered \"collected\".\n  # This avoids unnecessary pathfinding if the goal is already met.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment for clarity and robustness.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position for the BFS.\n  start_pos = state.pos\n\n  # BFS Setup:\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here).\n  # `list_of_actions_to_reach_here` only contains movement actions.\n  q = collections.deque([(start_pos, [])]) \n  \n  # `visited` set keeps track of grid positions that have already been added to the queue\n  # to prevent redundant processing and infinite loops.\n  visited = {start_pos} \n\n  # `min_total_actions` tracks the length of the shortest path found so far,\n  # including movement actions and any final 'USE' action.\n  min_total_actions = float('inf')\n  best_path_actions = [] # Stores the actual sequence of actions for the best path.\n\n  # Pre-determine properties of the target primitive for efficient goal checking.\n  # These checks are done once outside the BFS loop.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special non-grabbable primitives like water, stone, boundary.\n  # Their \"collection\" means simply reaching the cell where they are located.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS Loop: Explores the grid layer by layer to find the shortest path.\n  # This guarantees finding the shortest path in an unweighted graph.\n  while q:\n    current_pos, current_move_actions = q.popleft()\n\n    # Pruning Optimization: If the current path of movement actions is already \n    # equal to or longer than the shortest *total* path found so far,\n    # then this branch cannot lead to a shorter overall action sequence.\n    # This prevents exploring paths that are guaranteed to be suboptimal, significantly\n    # speeding up the search for large grids.\n    if len(current_move_actions) >= min_total_actions:\n      continue \n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or directly inspect the `grid`\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry\n    # for determining the *location* of the primitive.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if `current_pos` satisfies the goal condition for collecting the primitive.\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Actions required *after* reaching current_pos (e.g., USE).\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" implies reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No additional action (like USE) required for these.\n    \n    # If a goal state is reached at `current_pos`, update the best path found so far.\n    if is_goal_reached:\n      total_actions_for_this_path = current_move_actions + actions_to_complete_goal\n      if len(total_actions_for_this_path) < min_total_actions:\n        min_total_actions = len(total_actions_for_this_path)\n        best_path_actions = total_actions_for_this_path\n      \n      # Important: Do not break here. While BFS finds the shortest path *to a node*,\n      # our \"goal\" might be a condition that can be met from multiple nodes\n      # (e.g., `next_to` covers a 3x3 area) or involves an additional action (`USE`).\n      # Continuing the BFS ensures we find the globally shortest sequence of actions\n      # that fulfills the collection objective across all possible locations.\n      # The `min_total_actions` pruning handles efficiency by discarding longer paths.\n\n    # Explore valid neighbors of the current position.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Pruning: Only add to queue if this new path (current_actions + 1 move)\n        # could potentially be shorter than the best path found so far,\n        # AND it has not been visited to avoid redundant work and cycles.\n        if len(current_move_actions) + 1 < min_total_actions:\n          if new_pos not in visited:\n            visited.add(new_pos) # Mark as visited before adding to queue.\n            q.append((new_pos, current_move_actions + [action])) # Add to queue with new path.\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:29:14.255675", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    This function implements a Breadth-First Search (BFS) algorithm to determine\n    the shortest sequence of actions (movements and a final 'USE' action if applicable)\n    for the agent to acquire a specified primitive item from the CraftWorld environment.\n\n    It accurately distinguishes between two main collection mechanisms:\n    1. Grabbable items (e.g., \"WOOD\", \"IRON\", \"GRASS\"): Require the agent to be in\n       the 3x3 neighborhood of the item, followed by an `ACTION_USE`.\n    2. Stationary items (e.g., \"WORKSHOP0\", \"WATER\", \"STONE\", \"BOUNDARY\" if it's the target):\n       Require the agent to be directly on the cell containing the item. No explicit\n       `ACTION_USE` is typically needed for these in the context of \"collection\" (i.e., reaching).\n\n    The pathfinding process accounts for:\n    - Grid boundaries: Ensures agent does not move off the map.\n    - Impassable terrain: Cells occupied by \"BOUNDARY\" items (unless \"BOUNDARY\" itself is the target\n      primitive) are treated as obstacles.\n    - Early exit conditions: If the primitive is already in the agent's inventory,\n      or if the primitive name is unrecognized, no actions are generated.\n\n    The BFS ensures that the returned path is the shortest possible in terms of action count.\n    Pruning strategies are employed to optimize search efficiency by discarding paths\n    that are guaranteed to be longer than an already found optimal path.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current state of the simulation.\n        primitive (str): The string name of the primitive item that the agent needs to collect.\n                         Examples: \"WOOD\", \"STONE\", \"WORKSHOP0\", \"WATER\".\n\n    Returns:\n        List[int]: A list of integer action IDs (e.g., `[ACTION_UP, ACTION_RIGHT, ACTION_USE]`)\n                   representing the shortest sequence of steps to collect the primitive.\n                   Returns an empty list if the primitive is already in inventory, is unknown,\n                   or is unreachable within the current environment configuration.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Reference to the current grid layout for item locations.\n  \n  # 1. Resolve the primitive name (string) to its unique integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook's index, it's an invalid target.\n    return []\n\n  # 2. Early exit: If the agent already possesses the primitive in its inventory,\n  # no further collection actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Retrieve integer action codes for clarity and robustness, from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE'] # Action required for grabbable items once adjacent.\n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  # These tuples represent the change in (x, y) coordinates and the corresponding action.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y-coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y-coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X-coordinate)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X-coordinate)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT) to enforce boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position for the BFS.\n  start_pos = current_state.pos\n\n  # Determine the collection logic based on the nature of the primitive.\n  # These flags help decide if 'USE' is needed and how proximity is defined.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_water = primitive_idx == env.world.water_index\n  is_stone = primitive_idx == env.world.stone_index\n  \n  # Get the index for the 'BOUNDARY' kind. This is critical for identifying impassable terrain.\n  boundary_kind_idx = cookbook.index['BOUNDARY']\n  # Flag to indicate if the 'BOUNDARY' item itself is the target for collection.\n  # This handles the special case where one might want to \"collect\" (i.e., reach) a boundary.\n  is_boundary_primitive_target = (boundary_kind_idx is not None and primitive_idx == boundary_kind_idx)\n\n  # BFS initialization:\n  # The queue will store (position_tuple, path_to_position) pairs.\n  q = collections.deque([(start_pos, [])]) \n  \n  # The 'visited' set keeps track of grid positions that have been added to the queue,\n  # preventing redundant processing and ensuring shortest paths to each cell.\n  visited = {start_pos} \n\n  # Variables to store the optimal path found.\n  # `min_total_actions_len`: Length of the shortest *complete* path (movement + collection action).\n  min_total_actions_len = float('inf') \n  # `shortest_path_actions`: The actual sequence of action IDs for the optimal path.\n  shortest_path_actions = []     \n\n  # Start the Breadth-First Search traversal.\n  while q:\n    current_pos, actions_to_current_pos = q.popleft()\n    cx, cy = current_pos # Unpack current x, y coordinates for easy grid access.\n\n    # Pruning 1: If the current path to `current_pos`, plus the minimum cost to collect\n    # from this position, is already equal to or longer than the best path found so far,\n    # then this path cannot lead to a new optimal solution. We can safely skip it.\n    estimated_min_cost_to_collect = 1 if is_grabbable else 0 # 1 for 'USE', 0 otherwise.\n    if len(actions_to_current_pos) + estimated_min_cost_to_collect >= min_total_actions_len:\n        continue \n\n    # --- Check if the primitive can be collected from the current position ---\n    can_collect_from_here = False\n    # List to hold actions required *after* reaching `current_pos` to complete collection.\n    actions_after_reaching_pos = [] \n\n    if is_grabbable:\n      # For grabbable items, the agent must be *adjacent* (in a 3x3 neighborhood, including self)\n      # to the item to collect it with ACTION_USE.\n      found_in_neighborhood = False\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adj_x, adj_y = cx + dx_adj, cy + dy_adj\n          # Ensure the adjacent cell is within grid boundaries.\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n            # Check if the primitive is present in the specified kind-layer of the adjacent cell.\n            if grid[adj_x, adj_y, primitive_idx] > 0:\n              found_in_neighborhood = True\n              break # Found in neighborhood, no need to check other adjacent cells.\n        if found_in_neighborhood:\n            break # Break outer loop too.\n      \n      if found_in_neighborhood:\n        can_collect_from_here = True\n        actions_after_reaching_pos = [ACTION_USE] # The 'USE' action is required.\n    else: # This covers stationary items like workshops, water, stone, or boundary (if target).\n      # For stationary items, the agent simply needs to be directly *on* the cell containing the item.\n      if grid[cx, cy, primitive_idx] > 0:\n        can_collect_from_here = True\n        actions_after_reaching_pos = [] # No additional 'USE' action is needed here.\n    \n    # If collection is possible from `current_pos`, evaluate if this path is the new shortest.\n    if can_collect_from_here:\n      current_full_path_len = len(actions_to_current_pos) + len(actions_after_reaching_pos)\n      \n      # If this path is strictly shorter than the current best, update the best.\n      if current_full_path_len < min_total_actions_len:\n        min_total_actions_len = current_full_path_len\n        shortest_path_actions = actions_to_current_pos + actions_after_reaching_pos\n      # Important: Do not `break` here. BFS must continue to find the *absolute* shortest path,\n      # as there might be other paths of equal length to different instances of the primitive,\n      # or even to the same instance via a different, equally short route. The pruning logic handles\n      # efficiency by avoiding longer paths.\n\n    # --- Explore valid neighboring cells (movement actions) ---\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the defined grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for impassable terrain: If the cell contains 'BOUNDARY' and 'BOUNDARY'\n        # is *not* the primitive we are trying to collect, then this cell is an obstacle.\n        if boundary_kind_idx is not None and grid[new_x, new_y, boundary_kind_idx] > 0 and not is_boundary_primitive_target:\n            continue # This path is blocked, skip this move.\n\n        # If the new position has not been visited yet through an equal or shorter path.\n        if new_pos not in visited:\n          # Pruning 2: Calculate an admissible heuristic for the total path length\n          # if we were to move to `new_pos` and then collect.\n          # Cost to reach `new_pos` = `len(actions_to_current_pos) + 1` (for the `move_action`).\n          # Estimated minimal collection cost from `new_pos` = `1` if grabbable (for `ACTION_USE`), else `0`.\n          estimated_total_path_via_new_pos = len(actions_to_current_pos) + 1 + estimated_min_cost_to_collect\n          \n          # Only add `new_pos` to the queue if this estimated total path is strictly shorter\n          # than the best complete path found so far. This significantly reduces redundant exploration.\n          if estimated_total_path_via_new_pos < min_total_actions_len: \n              visited.add(new_pos) # Mark the new position as visited.\n              q.append((new_pos, actions_to_current_pos + [move_action])) # Add to queue with its path.\n  \n  # After the BFS has completed, `shortest_path_actions` will contain the shortest sequence\n  # of actions to collect the primitive from any reachable location. If no path was found,\n  # it will remain an empty list.\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:29:15.362865", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n    \n    This function implements an optimized Breadth-First Search (BFS) to find the shortest\n    sequence of actions (movements and potentially a 'USE' action) required\n    for the agent to collect a specified primitive item in the environment.\n\n    It distinguishes between grabbable items (which require an ACTION_USE when\n    adjacent to be collected) and non-grabbable items (which are collected by\n    the agent standing directly on their cell). The pathfinding accounts for\n    grid boundaries and impassable 'BOUNDARY' terrain, unless 'BOUNDARY' itself\n    is the target primitive to be collected.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current simulation state.\n        primitive (str): The string name of the primitive item to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A list of integer action IDs representing the shortest path\n                   to collect the primitive. Returns an empty list if the primitive\n                   is already in the inventory, is unknown, or is unreachable.\n  \"\"\"\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # Access the current grid for primitive locations\n  \n  # 1. Map the primitive name (string) to its integer ID using the Cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not exist in the cookbook,\n    # it cannot be collected, so return an empty list of actions.\n    return []\n\n  # 2. Early exit: If the primitive is already present in the agent's inventory,\n  # no collection actions are needed from the environment.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Get integer action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement actions as (dx, dy, action_id) tuples.\n  # These represent changes in x, y coordinates and the action to achieve them.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreases y)\n      (0, 1, ACTION_DOWN),   # Move South (increases y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases x)\n      (1, 0, ACTION_RIGHT),  # Move East (increases x)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for the Breadth-First Search (BFS).\n  start_pos = current_state.pos\n\n  # Determine the collection mechanism based on the primitive type:\n  # - Grabbable items (e.g., WOOD, IRON, GRASS, ROCK, GOLD, GEM) require being\n  #   adjacent and then using ACTION_USE.\n  # - Non-grabbable items (e.g., WORKSHOPs, WATER, STONE, BOUNDARY itself if targeted)\n  #   are collected by being directly on their cell.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Get the index for the 'BOUNDARY' kind. This is used to check for impassable terrain.\n  boundary_kind_idx = cookbook.index['BOUNDARY'] \n  # Handle the specific edge case where 'BOUNDARY' itself is the primitive target.\n  # In this scenario, 'BOUNDARY' is the goal, not an obstacle to be avoided.\n  is_boundary_primitive_target = (boundary_kind_idx is not None and primitive_idx == boundary_kind_idx)\n\n  # BFS initialization:\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  \n  # The 'visited' set keeps track of grid positions already explored via a shortest path.\n  # This prevents cycles and redundant computations, ensuring the first path found to any cell is shortest to that cell.\n  visited = {start_pos} \n\n  # Variables to store the shortest path found to a collection point.\n  # `min_total_actions_len` stores the length of the shortest *complete* path \n  # (movement actions + final collection action, e.g., USE). Initialized to infinity.\n  min_total_actions_len = float('inf') \n  # `shortest_path_actions` stores the actual sequence of action IDs for this best path.\n  shortest_path_actions = []     \n\n  # BFS traversal loop. Continues as long as there are positions to explore.\n  while q:\n    current_pos, actions_to_current_pos = q.popleft()\n    cx, cy = current_pos # Unpack current position coordinates.\n\n    # Pruning 1 (after popping from queue):\n    # If the path to this position, plus the *minimal* additional cost to collect\n    # (1 for 'USE' if grabbable, 0 otherwise), is already as long as or longer than\n    # the best complete collection path found so far, then this branch cannot\n    # lead to a shorter solution. Skip exploring it further.\n    estimated_min_cost_from_current_pos = 1 if is_grabbable else 0\n    if len(actions_to_current_pos) + estimated_min_cost_from_current_pos >= min_total_actions_len:\n        continue # Prune this path and its descendants.\n\n    # --- Check if the primitive can be collected from `current_pos` ---\n    can_collect_from_here = False\n    actions_to_complete_collection = [] # Any additional actions (like ACTION_USE) needed for collection.\n\n    if is_grabbable:\n      # For grabbable items, the agent needs to be in the 3x3 neighborhood of the item.\n      # Check all 9 cells in the 3x3 neighborhood centered at `current_pos` for the primitive.\n      found_in_neighborhood = False\n      for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n          adj_x, adj_y = cx + dx_adj, cy + dy_adj\n          # Ensure the adjacent cell is within grid boundaries.\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n            # Check if the primitive exists in the specified cell's kind-dimension.\n            if grid[adj_x, adj_y, primitive_idx] > 0:\n              found_in_neighborhood = True\n              break # Primitive found in neighborhood.\n        if found_in_neighborhood:\n            break # Break outer loop too.\n      \n      if found_in_neighborhood:\n        can_collect_from_here = True\n        actions_to_complete_collection = [ACTION_USE] # Grabbable items typically require a 'USE' action.\n    else: # This branch covers all non-grabbable primitives (e.g., WORKSHOPs, WATER, STONE, BOUNDARY).\n          # For these, the agent needs to be directly on the cell containing the primitive.\n      if grid[cx, cy, primitive_idx] > 0:\n        can_collect_from_here = True\n        actions_to_complete_collection = [] # Non-grabbable items typically don't require 'USE'.\n    \n    # If the primitive can be collected from `current_pos`, evaluate this path.\n    if can_collect_from_here:\n      current_full_path_len = len(actions_to_current_pos) + len(actions_to_complete_collection)\n      \n      # If this path is strictly shorter than the best found so far, update the best.\n      if current_full_path_len < min_total_actions_len:\n        min_total_actions_len = current_full_path_len\n        shortest_path_actions = actions_to_current_pos + actions_to_complete_collection\n\n    # --- Explore valid neighbors (movement actions) ---\n    for dx, dy, move_action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Prevent moving into 'BOUNDARY' cells, unless 'BOUNDARY' itself is the target primitive.\n        # 'BOUNDARY' cells are typically impassable obstacles for movement.\n        if boundary_kind_idx is not None and grid[new_x, new_y, boundary_kind_idx] > 0 and not is_boundary_primitive_target:\n            continue # This cell is blocked, so skip this move.\n\n        # If this position has not been visited yet via a shorter or equal path.\n        if new_pos not in visited:\n          # Pruning 2 (before adding to queue):\n          # Estimate the total path length if we were to reach `new_pos` and\n          # then immediately collect from there. This acts as an admissible heuristic.\n          # Cost to reach `new_pos` is `len(actions_to_current_pos) + 1` (for the `move_action`).\n          # Estimated minimal cost from `new_pos` to collect is `1` for grabbable (for `ACTION_USE`), `0` for others.\n          estimated_total_path_via_new_pos = len(actions_to_current_pos) + 1 + (1 if is_grabbable else 0)\n          \n          # Only add `new_pos` to the queue if its estimated total path length\n          # is strictly shorter than the best complete path found so far.\n          # This avoids exploring paths that are known to be longer or equal to an already found optimal path.\n          if estimated_total_path_via_new_pos < min_total_actions_len: \n              visited.add(new_pos) # Mark `new_pos` as visited.\n              q.append((new_pos, actions_to_current_pos + [move_action])) # Enqueue `new_pos` and its path.\n  \n  # After BFS completes, `shortest_path_actions` will contain the shortest sequence of actions\n  # to collect the primitive from any reachable location, or an empty list if unreachable.\n  return shortest_path_actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:29:51.607899", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-02T10:29:52.811695", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid layout (WIDTH, HEIGHT, n_kinds)\n  \n  # 1. Resolve the primitive name to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name isn't in the cookbook's index, it's an invalid target.\n    return []\n\n  # 2. Early exit: If the agent already has the primitive in inventory, it's considered collected.\n  # This avoids unnecessary search if the item is already held.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # 3. Obtain action mappings for clearer code.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movement directions and their corresponding action IDs.\n  # (delta_x, delta_y, action_id)\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up on screen)\n      (0, 1, ACTION_DOWN),   # Move South (Down on screen)\n      (-1, 0, ACTION_LEFT),  # Move West (Left on screen)\n      (1, 0, ACTION_RIGHT),  # Move East (Right on screen)\n  ]\n\n  # Grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position for the BFS.\n  start_pos = state.pos\n\n  # BFS Queue: Stores tuples of (current_position, list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  \n  # Visited set: Keeps track of grid positions that have been added to the queue to prevent cycles\n  # and redundant processing (since BFS finds the shortest path to a node first).\n  visited = {start_pos} \n\n  # Initialize variables to store the shortest path found so far.\n  min_total_actions_len = float('inf') # Tracks the length of the shortest path including final 'USE'\n  best_path_actions = []               # Stores the actual sequence of actions\n\n  # Pre-classify the target primitive type for efficient goal condition checking.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Specific stationary primitives that are \"collected\" by simply being on their cell.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Main BFS loop: Explores the grid layer by layer.\n  while q:\n    current_pos, current_move_actions = q.popleft()\n\n    # Pruning: If the current sequence of movement actions is already as long as\n    # or longer than the best *total* action sequence found so far, then this\n    # path (and any path extending from it) cannot be shorter.\n    # This comparison assumes 'USE' is a single action (if needed) and movement actions cost 1.\n    if len(current_move_actions) >= min_total_actions_len:\n      continue \n\n    # Create a temporary CraftState instance at `current_pos`.\n    # This allows us to leverage `CraftState` methods like `next_to` or inspect `grid` content\n    # as if the agent were physically at `current_pos`.\n    # Agent's direction and inventory are held constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Determine if the current position satisfies the goal for collecting the primitive.\n    is_goal_satisfied_at_current_pos = False\n    actions_to_complete_goal = [] # Actions required *after* reaching `current_pos` (e.g., `USE`).\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent must be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_satisfied_at_current_pos = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means simply being on that cell.\n      # We check if the primitive is present at the current cell's location.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_satisfied_at_current_pos = True\n        actions_to_complete_goal = [] # No additional action (like USE) is typically required.\n    \n    # If a goal condition is met at `current_pos`, evaluate if this path is the new shortest.\n    if is_goal_satisfied_at_current_pos:\n      total_actions_for_this_path = current_move_actions + actions_to_complete_goal\n      \n      # Update `min_total_actions_len` and `best_path_actions` if a shorter path is found.\n      if len(total_actions_for_this_path) < min_total_actions_len:\n        min_total_actions_len = len(total_actions_for_this_path)\n        best_path_actions = total_actions_for_this_path\n      \n      # IMPORTANT: Do NOT break here. BFS guarantees the shortest path to any *node*.\n      # However, our \"goal\" might be a *condition* (e.g., `next_to` covering multiple adjacent cells),\n      # or involve an additional action (`USE`). Continuing the BFS ensures we find the\n      # globally shortest sequence of actions, considering all possible locations and conditions.\n      # The `min_total_actions_len` pruning handles efficiency by cutting off longer branches.\n\n    # Explore valid neighboring cells.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the `new_pos` is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if this new position has already been visited (to avoid cycles and redundant paths).\n        if new_pos not in visited:\n          # Before adding to the queue, make sure this path, even if only movement so far,\n          # is not already too long compared to the best total path found.\n          if len(current_move_actions) + 1 < min_total_actions_len:\n            visited.add(new_pos) # Mark as visited before adding to queue.\n            # Add the new position and the cumulative movement actions to the queue.\n            q.append((new_pos, current_move_actions + [action]))\n  \n  return best_path_actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:30:53.837430", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Access the current grid layout\n\n  # 1. Resolve the primitive string name to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    # This might happen if an invalid primitive string is passed.\n    return []\n\n  # 2. Determine the characteristics of the target primitive to apply correct collection logic.\n  # Grabbable items (e.g., WOOD, IRON) are picked up and added to inventory using 'USE'.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  # Workshops (e.g., BENCH) are locations where crafting occurs; 'collection' means reaching the spot.\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Identify the index for 'BOUNDARY' which typically represents impassable terrain.\n  # This is crucial for defining what constitutes an \"obstacle\" during pathfinding.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n  \n  # A primitive is considered \"stationary\" if it's an environmental feature like WATER, STONE,\n  # or a BOUNDARY itself. For these, collection means reaching their grid location, not adding to inventory.\n  # Note: If the primitive to collect IS 'BOUNDARY', it should be treated as reachable.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n\n  # 3. Early exit conditions: If the primitive is already \"collected\" based on its type,\n  #    no further actions are needed. This avoids unnecessary pathfinding.\n  #    - For grabbable items, \"collected\" means present in the agent's inventory.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return [] \n  #    - For workshops or stationary environment features, \"collected\" means the agent is\n  #      currently standing on a cell containing that primitive.\n  elif (is_workshop or is_stationary_primitive) and grid[state.pos[0], state.pos[1], primitive_idx] > 0:\n    return [] \n\n  # 4. Get the integer action IDs from the environment's action specifications.\n  # These are used to construct the action sequence for the agent.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements as (dx, dy, action_id) tuples.\n  # These represent the changes in (x, y) coordinates and the corresponding action.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decrement Y)\n      (0, 1, ACTION_DOWN),   # Move South (increment Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decrement X)\n      (1, 0, ACTION_RIGHT),  # Move East (increment X)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks during pathfinding.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position, serving as the starting point for the BFS.\n  start_pos = state.pos\n\n  # 5. Initialize Breadth-First Search (BFS) for efficient shortest pathfinding.\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set tracks positions already explored to prevent cycles and redundant computations.\n  visited = {start_pos} \n\n  # BFS loop: Continues as long as there are unvisited positions to explore in the queue.\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    # Create a hypothetical CraftState at the `current_pos`.\n    # This allows us to leverage `CraftState`'s methods (like `next_to()`) for goal checks\n    # as if the agent were physically at `current_pos`, without actually stepping the environment.\n    # The `scenario`, `dir`, and `inventory` are carried over from the actual state,\n    # as they don't affect spatial pathfinding or `next_to` for this purpose.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    is_goal_reached = False\n    actions_to_complete_goal = [] # Actions specifically needed *after* reaching current_pos to \"collect\"\n\n    # 6. Check if the `current_pos` represents a successful goal state for collecting the primitive.\n    if is_grabbable:\n      # For grabbable items, the agent must be adjacent to them to 'USE' them.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE] # The USE action is appended as the final step.\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives (like WATER, STONE, or BOUNDARY),\n      # \"collecting\" means simply being on the same grid cell.\n      # Check if the primitive is present at the current position's layer in the grid.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No `USE` action is typically needed for these types.\n    \n    # If a goal state is reached, immediately return the path found.\n    # BFS guarantees that the first path found to any goal state is the shortest in an unweighted graph.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # 7. Explore neighboring cells from the `current_pos`.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Determine if the new position is an impassable obstacle.\n        # An obstacle is typically a 'BOUNDARY' cell, unless the target primitive itself IS 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' AND the target primitive is NOT 'BOUNDARY',\n            # then it is considered an obstacle and cannot be moved into.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        # If the new position has not been visited and is not an impassable obstacle,\n        # add it to the queue for further exploration.\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos) # Mark the new position as visited to avoid redundant checks.\n          q.append((new_pos, current_actions + [action])) # Enqueue with the path updated.\n  \n  # If the BFS completes (queue becomes empty) and no path to the primitive was found,\n  # it implies the primitive is either unreachable (e.g., completely enclosed by obstacles)\n  # or does not exist in the current environment state.\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:30:55.121890", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Access the current grid layout (numpy.ndarray)\n  \n  # 1. Resolve the primitive string name to its integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized by the cookbook, it cannot be collected.\n    # Return an empty list, indicating no actions are possible.\n    return []\n\n  # 2. Determine the characteristics of the target primitive.\n  # These characteristics dictate how \"collection\" is defined (e.g., grab from inventory, reach location).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Identify the index for 'BOUNDARY' which typically represents impassable terrain.\n  # This is crucial for obstacle avoidance during pathfinding.\n  impassable_kind_idx = cookbook.index['BOUNDARY'] if 'BOUNDARY' in cookbook.index.contents else None\n  \n  # A primitive is considered \"stationary\" if it's an environmental feature like water, stone,\n  # or a boundary. For these, \"collection\" means simply reaching their grid location,\n  # as they are not added to the agent's inventory.\n  is_stationary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx)\n  )\n\n  # 3. Early exit conditions: If the primitive is already \"collected,\" no actions are needed.\n  #    - For grabbable items: check if the item is already in the agent's inventory.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return [] \n  #    - For workshops or stationary primitives: check if the agent is currently standing\n  #      on a cell that contains the target primitive.\n  elif (is_workshop or is_stationary_primitive) and grid[state.pos[0], state.pos[1], primitive_idx] > 0:\n    return [] \n\n  # 4. Get the integer action IDs from the environment's action specifications.\n  # This ensures compatibility with the `env.step()` method.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (change in x, change in y, corresponding action ID).\n  # These are used to explore neighboring cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move East (increases X coordinate)\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for the Breadth-First Search (BFS).\n  start_pos = state.pos\n\n  # Helper function to check if the target primitive is in the 3x3 neighborhood of a given position.\n  # This avoids creating `CraftState` objects repeatedly inside the BFS loop for efficiency.\n  def _is_primitive_next_to(check_pos, target_idx):\n      cx, cy = check_pos\n      for dx_adj in [-1, 0, 1]:  # Iterate through relative X coordinates (-1, 0, 1)\n          for dy_adj in [-1, 0, 1]:  # Iterate through relative Y coordinates (-1, 0, 1)\n              nx_adj, ny_adj = cx + dx_adj, cy + dy_adj\n              # Ensure the neighbor position is within grid boundaries.\n              if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT:\n                  # Check if the target primitive is present at this neighbor cell.\n                  # `grid[x, y, kind_idx] > 0` means the primitive is present.\n                  if grid[nx_adj, ny_adj, target_idx] > 0:\n                      return True\n      return False\n\n  # 5. Initialize Breadth-First Search (BFS) for shortest pathfinding.\n  # The queue stores tuples: (current_position_tuple, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set tracks positions already explored to prevent cycles and redundant work,\n  # ensuring that BFS finds the shortest path in an unweighted graph.\n  visited = {start_pos} \n\n  # BFS loop: Continue as long as there are positions to explore in the queue.\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    # 6. Check if the `current_pos` represents a valid goal state for collecting the primitive.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to the primitive\n      # and then perform a 'USE' action to collect it.\n      if _is_primitive_next_to(current_pos, primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE] # Append the USE action to perform once adjacent.\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives (e.g., WATER, STONE, BOUNDARY),\n      # \"collection\" means simply reaching the cell where the primitive is located.\n      # No additional 'USE' action is typically required.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] \n    \n    # If a goal state is found, return the accumulated path immediately.\n    # BFS guarantees that the first path found to a goal state is the shortest path.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # 7. Explore neighboring cells from the `current_pos`.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: The agent cannot move into a `BOUNDARY` cell\n        # unless `BOUNDARY` itself is the primitive being collected (i.e., it's the target).\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains an impassable object (BOUNDARY)\n            # and the target primitive is NOT that object, then it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        # If the new position has not been visited and is not an impassable obstacle, add it to the queue.\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos) # Mark the new position as visited.\n          q.append((new_pos, current_actions + [action])) # Add to queue with updated action list.\n  \n  # If the BFS completes (queue is empty) and no path to the primitive was found,\n  # it means the primitive is unreachable (e.g., completely surrounded by obstacles)\n  # or does not exist in the current environment state.\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T10:31:44.900312", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # Determine if the primitive is grabbable (needs USE action when adjacent) or non-grabbable (just needs reaching the cell).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # --- V2 Improvement: Explicit \"already collected\" check at the very beginning ---\n  # This avoids running BFS if the agent is already in a \"collected\" state for the primitive.\n  if is_grabbable:\n    # For grabbable items, \"collected\" means having at least one in inventory.\n    if state.inventory[primitive_idx] > 0:\n      return [] \n  else: # This covers all non-grabbable items like workshops, water, stone, boundary.\n    # For non-grabbable items, \"collected\" means being on the cell that contains them.\n    # Check if the target primitive is present at the agent's current cell.\n    if grid[start_pos[0], start_pos[1], primitive_idx] > 0:\n      return []\n  # ---------------------------------------------------------------------------------\n\n  # BFS setup for pathfinding.\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {start_pos} \n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    else: # This covers non-grabbable primitives like workshops, water, stone, or boundary.\n      # For non-grabbable primitives, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
