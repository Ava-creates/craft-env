= collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    # (i.e., a cell from which state.next_to(primitive_idx) would be True)\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T21:28:57.324438", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Mapping of CraftState.dir (0:UP, 1:DOWN, 2:LEFT, 3:RIGHT) to (dx, dy)\n  # This matches the CraftState.dir_vec attribute: [[0, -1], [0, 1], [-1, 0], [1, 0]]\n  DIR_TO_DELTAS = {\n      0: (0, -1), # UP\n      1: (0, 1),  # DOWN\n      2: (-1, 0), # LEFT\n      3: (1, 0)   # RIGHT\n  }\n\n  # Define movement actions as (dx, dy, action_id, new_direction_after_move)\n  # When a movement action is performed, the agent's direction updates to match the action.\n  MOVE_ACTIONS_INFO = [\n      (0, -1, ACTIONS['UP'], 0),    # Move UP, new_direction is 0 (UP)\n      (0, 1, ACTIONS['DOWN'], 1),   # Move DOWN, new_direction is 1 (DOWN)\n      (-1, 0, ACTIONS['LEFT'], 2),  # Move LEFT, new_direction is 2 (LEFT)\n      (1, 0, ACTIONS['RIGHT'], 3)   # Move RIGHT, new_direction is 3 (RIGHT)\n  ]\n  \n  current_state = env._current_state\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # BFS queue: (current_x, current_y, current_direction, path_actions_to_reach_here)\n  q = collections.deque([(agent_pos[0], agent_pos[1], agent_dir, [])]) \n  # Visited set to prevent cycles and find shortest path: (x, y, direction)\n  visited = set([(agent_pos[0], agent_pos[1], agent_dir)])\n\n  target_reached_path = None\n\n  while q:\n    curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n    # --- Check if the current state (position and direction) allows collecting the primitive ---\n    if is_primitive_grabbable:\n      # If the primitive is grabbable, we need to move onto its cell to collect it.\n      # Check if the current cell contains the primitive.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        target_reached_path = path_actions\n        break # Found the shortest path to the grabbable primitive\n    else:\n      # If the primitive is non-grabbable, we need to be adjacent to it and USE it.\n      # The USE action acts on the cell directly in front of the agent.\n      dx_front, dy_front = DIR_TO_DELTAS[curr_dir]\n      front_x, front_y = curr_x + dx_front, curr_y + dy_front\n\n      # Check if the cell in front is within grid bounds and contains the primitive.\n      if (0 <= front_x < width and 0 <= front_y < height and \n          grid[front_x, front_y, primitive_idx] > 0):\n        target_reached_path = path_actions + [ACTIONS['USE']]\n        break # Path found to be adjacent and use the non-grabbable primitive\n\n    # --- Explore neighbors (possible moves) ---\n    for dx, dy, action_id, new_dir in MOVE_ACTIONS_INFO:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n      \n      # Check traversability of (next_x, next_y).\n      # A cell is considered non-traversable (an obstacle) if it contains any non-grabbable item,\n      # UNLESS that item is the specific primitive we are looking for AND that primitive is grabbable.\n      is_traversable = True\n      for kind_id in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_id] > 0: # If this non-grabbable item is present at (next_x, next_y)\n              # If it's the primitive we want AND it's grabbable, we can move there.\n              # Otherwise, it's an obstacle.\n              if not (is_primitive_grabbable and kind_id == primitive_idx):\n                  is_traversable = False\n                  break\n      \n      if not is_traversable:\n        continue\n\n      # If the cell is traversable and this (position, direction) state has not been visited, add it to the queue.\n      if (next_x, next_y, new_dir) in visited:\n        continue\n      \n      visited.add((next_x, next_y, new_dir))\n      q.append((next_x, next_y, new_dir, path_actions + [action_id]))\n\n  if target_reached_path:\n    return target_reached_path\n  else:\n    # If the BFS completes and no path to the primitive or its adjacent cell was found.\n    return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:28:58.529350", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n\n  primitive_idx = cookbook.index[primitive]\n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  # V2 Improvement: Check if the primitive is already in inventory.\n  # If we already have the primitive, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n    return [] \n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Define movement actions and their resulting (dx, dy) and new direction.\n  # Agent directions: 0: UP, 1: DOWN, 2: LEFT, 3: RIGHT. This matches the internal\n  # representation for CraftState.dir.\n  MOVE_ACTIONS_INFO = [\n      (0, -1, ACTIONS['UP'], 0),    # Move UP: (dx=0, dy=-1), new direction is 0 (UP)\n      (0, 1, ACTIONS['DOWN'], 1),   # Move DOWN: (dx=0, dy=1), new direction is 1 (DOWN)\n      (-1, 0, ACTIONS['LEFT'], 2),  # Move LEFT: (dx=-1, dy=0), new direction is 2 (LEFT)\n      (1, 0, ACTIONS['RIGHT'], 3)   # Move RIGHT: (dx=1, dy=0), new direction is 3 (RIGHT)\n  ]\n  \n  # Map directions to (dx, dy) for checking the cell directly in front of the agent.\n  # This mapping is consistent with the `new_dir` values used in `MOVE_ACTIONS_INFO`.\n  DIR_TO_DELTAS = {\n      0: (0, -1),  # UP (North)\n      1: (0, 1),   # DOWN (South)\n      2: (-1, 0),  # LEFT (West)\n      3: (1, 0)    # RIGHT (East)\n  }\n\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # BFS queue: Stores tuples of (current_x, current_y, current_direction, path_actions_to_reach_here).\n  q = collections.deque([(agent_pos[0], agent_pos[1], agent_dir, [])]) \n  # Visited set: Stores tuples of (x, y, direction) to prevent cycles and ensure shortest path.\n  visited = set([(agent_pos[0], agent_pos[1], agent_dir)])\n\n  target_reached_path = None\n\n  while q:\n    curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n    # --- Goal Check ---\n    # Determine if the current state allows for collecting the primitive.\n    if is_primitive_grabbable:\n      # For grabbable primitives, the agent must move onto the same cell.\n      # If the current cell (curr_x, curr_y) contains the primitive, we have found it.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        target_reached_path = path_actions\n        break # Path found\n    else:\n      # For non-grabbable primitives, the agent must be adjacent to it and use the 'USE' action.\n      # The 'USE' action interacts with the cell directly in front of the agent.\n      dx_front, dy_front = DIR_TO_DELTAS[curr_dir]\n      front_x, front_y = curr_x + dx_front, curr_y + dy_front\n\n      # Check if the cell in front is within grid bounds and contains the primitive.\n      if (0 <= front_x < width and 0 <= front_y < height and \n          grid[front_x, front_y, primitive_idx] > 0):\n        # We are at (curr_x, curr_y) and facing the primitive. Append USE action.\n        target_reached_path = path_actions + [ACTIONS['USE']]\n        break # Path found\n\n    # --- Explore Neighbors ---\n    # Iterate through possible movement actions (UP, DOWN, LEFT, RIGHT).\n    for dx, dy, action_id, new_dir in MOVE_ACTIONS_INFO:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next position is within grid boundaries.\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n      \n      # Check traversability of the (next_x, next_y) cell.\n      # A cell is considered non-traversable (an obstacle) if it contains any\n      # item from `env.world.non_grabbable_indices`.\n      # This means the agent cannot move onto cells containing water, workshops, etc.\n      is_traversable = True\n      for kind_id in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_id] > 0:\n              is_traversable = False\n              break\n      \n      if not is_traversable:\n        continue\n\n      # If the cell is traversable and this (position, direction) state has not been visited,\n      # add it to the queue for further exploration.\n      if (next_x, next_y, new_dir) in visited:\n        continue\n      \n      visited.add((next_x, next_y, new_dir))\n      q.append((next_x, next_y, new_dir, path_actions + [action_id]))\n\n  if target_reached_path:\n    return target_reached_path\n  else:\n    # If the BFS completes and no path to the primitive or its interaction point was found,\n    # return an empty list of actions.\n    return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:29:55.083382", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACT_DOWN = action_map['DOWN']\n  ACT_UP = action_map['UP']\n  ACT_LEFT = action_map['LEFT']\n  ACT_RIGHT = action_map['RIGHT']\n  ACT_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  \n  # 1. Check if the primitive is already in inventory\n  if current_state.inventory[primitive_idx] > 0:\n    return [] # Already collected\n\n  # 2. Check if the primitive is in the immediate 3x3 neighborhood (including current cell)\n  # If it is, attempt to USE it.\n  if current_state.next_to(primitive_idx):\n    return [ACT_USE]\n\n  # 3. Perform BFS to find the closest primitive on the global grid and a path to it.\n  agent_x, agent_y = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Queue for BFS: stores (x, y, list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_x, agent_y, [])])\n  # Set to keep track of visited grid cells to avoid cycles and redundant paths\n  visited = {(agent_x, agent_y)}\n\n  # Define possible moves and their corresponding actions and (dx, dy)\n  moves_info = {\n      ACT_LEFT: (-1, 0),\n      ACT_RIGHT: (1, 0),\n      ACT_UP: (0, -1),\n      ACT_DOWN: (0, 1)\n  }\n  \n  shortest_path_to_primitive = None\n\n  while queue:\n    curr_x, curr_y, path_actions = queue.popleft()\n\n    # Check if the current cell contains the primitive.\n    # If it does, we've found the closest one (due to BFS property).\n    if grid[curr_x, curr_y, primitive_idx] > 0:\n        shortest_path_to_primitive = path_actions\n        break # Path found, exit BFS\n\n    # Explore neighbors\n    for action, (dx, dy) in moves_info.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check if the next cell is within grid boundaries and hasn't been visited\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and (next_x, next_y) not in visited:\n        visited.add((next_x, next_y))\n        new_path_actions = path_actions + [action]\n        queue.append((next_x, next_y, new_path_actions))\n\n  # If a path was found to a cell containing the primitive:\n  if shortest_path_to_primitive is not None:\n    # Once the agent reaches the target cell, it needs to 'USE' the primitive.\n    # The 'USE' action in CraftState's step will handle the collection\n    # if the primitive is in the 3x3 neighborhood (which it will be if the agent\n    # moves onto the cell containing it).\n    return shortest_path_to_primitive + [ACT_USE]\n  else:\n    # If the primitive was not found anywhere on the grid after exploring all reachable cells,\n    # return an empty list of actions, indicating it cannot be collected this way.\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:29:56.280306", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  \n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n  \n  inventory = current_state.inventory \n  grid = current_state.grid\n  agent_x, agent_y = current_state.pos\n\n  WIDTH, HEIGHT, _ = grid.shape # Grid dimensions from the current state\n\n  # 1. Check if the primitive is already in the inventory\n  if inventory[primitive_idx] > 0:\n    return [] # Already collected\n\n  # 2. Check if the primitive is in the immediate 3x3 neighborhood (including current cell).\n  # If so, a single 'USE' action is sufficient.\n  if current_state.next_to(primitive_idx):\n    return [action_map['USE']]\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path to a cell containing the primitive.\n  # The queue stores tuples: (current_x, current_y, list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_x, agent_y, [])])\n  visited = set([(agent_x, agent_y)])\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy, action_id) - (x: horizontal, y: vertical)\n  # Assuming (0,0) is top-left, x increases to the right, y increases downwards.\n  move_deltas = [\n      (0, -1, action_map['UP']),    # Move Up (decreases y)\n      (0, 1, action_map['DOWN']),   # Move Down (increases y)\n      (-1, 0, action_map['LEFT']),  # Move Left (decreases x)\n      (1, 0, action_map['RIGHT']),  # Move Right (increases x)\n  ]\n\n  # Get the index for 'BOUNDARY' to check for impassable cells.\n  boundary_idx = env.world.cookbook.index.get('BOUNDARY', -1)\n\n  while queue:\n    curr_x, curr_y, path_so_far = queue.popleft()\n\n    # If the current cell contains the primitive, we've found our target location.\n    # The BFS guarantees this is the shortest path to *a* primitive cell.\n    if grid[curr_x, curr_y, primitive_idx] > 0:\n      # Append the 'USE' action after moving to the target cell.\n      # The `next_to` check at the beginning ensures that if we are already\n      # on or next to the primitive, we don't start a BFS.\n      return path_so_far + [action_map['USE']]\n\n    # Explore valid neighbors\n    for dx, dy, action in move_deltas:\n      next_x, next_y = curr_x + dx, curr_y + dy\n\n      # Check boundary conditions of the grid\n      if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT:\n        # Check if the cell has already been visited\n        if (next_x, next_y) not in visited:\n            # Check if the next cell is traversable (e.g., not a solid 'BOUNDARY').\n            # This check can be expanded for more complex obstacles if needed.\n            is_boundary = (boundary_idx != -1 and grid[next_x, next_y, boundary_idx] > 0)\n            \n            if not is_boundary: \n                visited.add((next_x, next_y))\n                queue.append((next_x, next_y, path_so_far + [action]))\n\n  # If the queue is exhausted and no path to the primitive was found\n  # (i.e., it's unreachable or not present on the map), return an empty list.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-01T21:30:28.331875", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the set of non-grabbable indices to identify obstacles\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is walkable\n  def is_walkable(x, y):\n    # Check boundary conditions\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    # Check if the cell contains any non-grabbable entity\n    for ng_idx in non_grabbable_indices:\n      if grid[x, y, ng_idx] > 0:\n        return False # This cell contains an obstacle\n    return True # Cell is within bounds and does not contain an obstacle\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and walkable (i.e., not an obstacle)\n      if not is_walkable(next_x, next_y):\n        continue\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:30:29.562499", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 1. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 2. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 3. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 4. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Determine which entity kinds are truly impassable obstacles.\n  # These are non-grabbable entities that are NOT workshops (which are often walkable).\n  # Common examples: WATER, STONE, BOUNDARY.\n  impassable_kind_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position contains any impassable terrain\n      is_impassable = False\n      for k_idx in impassable_kind_indices:\n          # If the cell contains an impassable kind, it's blocked.\n          if grid[next_x, next_y, k_idx] > 0:\n              is_impassable = True\n              break\n      \n      if is_impassable:\n          continue # Cannot move to this position, skip to next neighbor\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 5. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:31:05.072086", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  # These are relative movements from the current position\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position (x, y)\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position (x,y), list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant processing\n  visited = {start_pos} \n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special stationary primitives that are \"collected\" by simply being on their tile\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             # 'BOUNDARY' might also be a primitive name for unpassable terrain\n                             # Check if it's in the cookbook's index to avoid KeyError\n                             (primitive == 'BOUNDARY' and cookbook.index['BOUNDARY'] == primitive_idx))\n  \n  # BFS loop to find the shortest path\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to leverage `CraftState` methods like `next_to`\n    # or directly inspect the `grid` as if the agent were at `current_pos`.\n    # We maintain the original scenario, grid, direction, and inventory for this hypothetical state.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current_pos satisfies the goal condition for collecting the primitive.\n    # For unweighted graphs like this grid, BFS guarantees the first path found is the shortest.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON, GRASS, ROCK, GOLD, GEM),\n      # the agent needs to be adjacent to them and then use the ACTION_USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops (e.g., BENCH) or stationary environment primitives (WATER, STONE, BOUNDARY),\n      # \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # grid[x, y, kind_index] > 0 indicates presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No USE action is typically needed for these\n    \n    # If the goal is not met at current_pos, explore its neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position has not been visited yet\n        if new_pos not in visited:\n          visited.add(new_pos) # Mark as visited\n          # Enqueue the new position along with the path to reach it\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T21:31:06.325814", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Pre-calculate indices for impassable terrain.\n  # Assuming 'BOUNDARY' and 'WATER' are impassable obstacles.\n  # 'STONE' is generally walkable, as it's a resource to be collected or walked over.\n  boundary_idx = cookbook.index['BOUNDARY']\n  water_idx = env.world.water_index\n  \n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary.\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == water_idx or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == boundary_idx)\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time a\n    # goal node (or a node satisfying the goal condition) is popped from the queue,\n    # the path to it is the shortest. We can return immediately.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No USE action is typically needed for these\n    \n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position contains an impassable object (e.g., BOUNDARY or WATER)\n        is_impassable_cell = False\n        if grid[new_x, new_y, boundary_idx] > 0 or \\\n           grid[new_x, new_y, water_idx] > 0:\n          is_impassable_cell = True\n        \n        if not is_impassable_cell and new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T21:31:42.587201", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  # Note: `env.action_specs()` provides the mapping from action names to integers\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Get the set of non-grabbable indices to identify obstacles\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position is blocked by a non-grabbable item (obstacle)\n      is_blocked = False\n      for kind_idx in non_grabbable_indices:\n        # A cell is blocked if it contains a non-grabbable item\n        # and that item is NOT the primitive we are trying to collect.\n        # We can move onto the target primitive's cell if it's the only non-grabbable there.\n        # But for general movement, any other non_grabbable is an obstacle.\n        # For this version, we'll consider any non-grabbable as blocking passage,\n        # UNLESS it's the specific primitive we are looking for and we are moving to that cell.\n        # However, the goal is always to move ADJACENT, not ONTO, the primitive.\n        # So, any non_grabbable item in the 'next_pos' is an obstacle.\n        if grid[next_x, next_y, kind_idx] > 0:\n          is_blocked = True\n          break\n      \n      if is_blocked:\n        continue # This position is an obstacle, cannot move here\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:31:43.711988", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 1. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 2. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 3. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 4. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Define unwalkable cell types for pathfinding.\n  # We assume items that are non-grabbable but *not* workshops are obstacles.\n  # Workshops (BENCH, etc.) are typically non-grabbable but walkable locations.\n  unwalkable_indices_set = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  def is_cell_walkable(cell_x, cell_y, current_grid, world_obj, unwalkable_types_set):\n    \"\"\"Checks if a given cell (x, y) is traversable.\"\"\"\n    # Check if the next position is within grid boundaries\n    if not (0 <= cell_x < WIDTH and 0 <= cell_y < HEIGHT):\n      return False\n    \n    # Check if the cell contains any item from the unwalkable set\n    for k_idx in range(world_obj.n_kinds):\n      if current_grid[cell_x, cell_y, k_idx] > 0: # If this kind exists in the cell\n        if k_idx in unwalkable_types_set:\n          return False # It contains an unwalkable item, so this cell is blocked\n\n    # If no unwalkable items found, the cell is walkable\n    return True\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # CRITICAL IMPROVEMENT: Check if the next position is walkable before adding to queue\n      if not is_cell_walkable(next_x, next_y, grid, env.world, unwalkable_indices_set):\n        continue # This cell is an obstacle, do not traverse\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 5. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-01T21:32:17.574705", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time a\n    # goal node (or a node satisfying the goal condition) is popped from the queue,\n    # the path to it is the shortest. We can return immediately.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # We check the grid directly as `next_to` is about adjacency, not being on the cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No USE action is typically needed for these\n    \n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T21:32:18.762991", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This function implements a Breadth-First Search (BFS) algorithm to find the shortest\n    sequence of movement actions (UP, DOWN, LEFT, RIGHT) to reach a target primitive\n    on the grid. Depending on the type of primitive, an additional 'USE' action\n    might be appended to the sequence.\n\n    Args:\n        env (env.CraftLab): The CraftLab object representing the current environment state.\n        primitive (str): The name of the primitive resource (e.g., \"WOOD\", \"WATER\", \"WORKSHOP0\") to collect.\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute in the environment.\n                   Returns an empty list if the primitive is not found or cannot be collected.\n  \"\"\"\n  # Get the current state from the environment\n  state = env._current_state\n  \n  # Access the cookbook for mapping names to integer IDs and for recipe details\n  cookbook = env.world.cookbook\n  \n  # Get the current grid layout from the state\n  grid = state.grid\n  \n  # 1. Map the primitive name to its integer ID using the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  \n  # If the primitive name is not recognized, it cannot be collected.\n  if primitive_idx is None:\n    return []\n\n  # 2. Retrieve the integer mappings for common actions from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible directional movements and their corresponding action IDs.\n  # These are (dx, dy, action_id) tuples.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (decreasing Y)\n      (0, 1, ACTION_DOWN),   # Move South (increasing Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreasing X)\n      (1, 0, ACTION_RIGHT),  # Move East (increasing X)\n  ]\n\n  # Get the dimensions of the grid (WIDTH, HEIGHT, number_of_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's starting position for the BFS\n  start_pos = state.pos\n\n  # 3. Initialize BFS structures.\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_this_position).\n  q = collections.deque([(start_pos, [])]) \n  \n  # The visited set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # 4. Determine the 'collection' criteria for the target primitive.\n  # This dictates whether the agent needs to be adjacent and 'USE', or simply occupy the cell.\n  \n  # Grabbable items (e.g., WOOD, IRON) require being adjacent and then using the 'USE' action.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Workshops (e.g., BENCH) are non-grabbable but are 'used' by standing on them.\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Stationary primitives like water, stone, or boundaries are also non-grabbable.\n  # Their \"collection\" or interaction typically means simply reaching the cell where they are located.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # 5. Execute the BFS algorithm.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to leverage methods like `next_to` or directly query `grid` contents\n    # as if the agent were physically at `current_pos`.\n    # The agent's direction and inventory are kept constant as they don't affect grid geometry for pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal condition for collecting the primitive.\n    # BFS guarantees that the first time a goal state is reached, the path found is the shortest.\n    if is_grabbable:\n      # For grabbable items, the agent must be next to it and then perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives, the agent simply needs to be on the cell containing them.\n      # No 'USE' action is typically needed in this context, as interaction is implicit by being on the spot.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions \n    \n    # If the current position is not a goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the valid grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If the new position has not been visited yet, add it to the queue.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and no path to the primitive is found (i.e., the queue becomes empty),\n  # return an empty list, indicating the primitive cannot be collected from the current state.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T21:33:56.088595", "function_name": "collect", "function_body": "  # Direction constants for agent's `dir` attribute\n  # Based on common DMLab patterns and action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # It's assumed that agent.dir follows a consistent integer mapping for cardinal directions.\n  # Let's assume:\n  _UP_DIR = 0\n  _DOWN_DIR = 1\n  _LEFT_DIR = 2\n  _RIGHT_DIR = 3\n\n  # Delta (dx, dy) for each direction for a (x,y) grid where x increases right, y increases down\n  _DIR_TO_DELTA = {\n      _UP_DIR: (0, -1),\n      _DOWN_DIR: (0, 1),\n      _LEFT_DIR: (-1, 0),\n      _RIGHT_DIR: (1, 0),\n  }\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    # The primitive name is not recognized by the cookbook.\n    return []\n\n  current_state = env._current_state\n  # Check if the primitive is already in the inventory.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Map action IDs to the direction the agent will face after performing that move action\n  # This assumes moving in a cardinal direction makes the agent face that direction.\n  _ACTION_TO_DIR_MAP = {\n      ACTIONS['UP']: _UP_DIR,\n      ACTIONS['DOWN']: _DOWN_DIR,\n      ACTIONS['LEFT']: _LEFT_DIR,\n      ACTIONS['RIGHT']: _RIGHT_DIR,\n  }\n\n  # Define movements as (dx, dy, action_id) for cardinal directions.\n  # (dx, dy) represents the change in (x, y) coordinates for each action.\n  MOVES = [\n      (_DIR_TO_DELTA[_UP_DIR][0], _DIR_TO_DELTA[_UP_DIR][1], ACTIONS['UP']),\n      (_DIR_TO_DELTA[_DOWN_DIR][0], _DIR_TO_DELTA[_DOWN_DIR][1], ACTIONS['DOWN']),\n      (_DIR_TO_DELTA[_LEFT_DIR][0], _DIR_TO_DELTA[_LEFT_DIR][1], ACTIONS['LEFT']),\n      (_DIR_TO_DELTA[_RIGHT_DIR][0], _DIR_TO_DELTA[_RIGHT_DIR][1], ACTIONS['RIGHT'])\n  ]\n\n  agent_start_pos = current_state.pos\n  agent_start_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # BFS queue: (x, y, current_direction, path_actions_to_reach_here)\n  # The initial path has no actions, so the direction is the agent's current_state.dir\n  q = collections.deque([(agent_start_pos[0], agent_start_pos[1], agent_start_dir, [])]) \n  \n  # Visited set to prevent cycles and find shortest path: (x, y, direction)\n  visited = set([(agent_start_pos[0], agent_start_pos[1], agent_start_dir)])\n\n  target_reached_path = None\n\n  while q:\n    curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n    # --- Check if the current position and direction allow us to collect the primitive ---\n    if is_primitive_grabbable:\n      # If the primitive is grabbable, we need to move onto its cell to collect it.\n      # Direction does not matter for grabbable items once the agent is on the square.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        target_reached_path = path_actions\n        break # Found the shortest path to the grabbable primitive\n    else:\n      # If the primitive is non-grabbable, we need to move to an adjacent cell and USE it.\n      # The USE action is assumed to act on the cell directly in front of the agent.\n      \n      # Calculate the coordinates of the cell directly in front of the agent\n      front_dx, front_dy = _DIR_TO_DELTA[curr_dir]\n      target_x, target_y = curr_x + front_dx, curr_y + front_dy\n\n      # Check if the target cell is within bounds and contains the primitive\n      if (0 <= target_x < width and 0 <= target_y < height and\n          grid[target_x, target_y, primitive_idx] > 0):\n        target_reached_path = path_actions + [ACTIONS['USE']]\n        break # Found a path to collect the non-grabbable primitive\n\n    # --- Explore neighbors (possible moves) ---\n    for move_dx, move_dy, move_action_id in MOVES:\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = _ACTION_TO_DIR_MAP[move_action_id] # Agent faces the direction of the move\n\n      # Check boundary conditions\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n      \n      # Check if this state (position + direction) has already been visited\n      if (next_x, next_y, next_dir) in visited:\n        continue\n      \n      # Check traversability of (next_x, next_y)\n      # A cell is considered non-traversable (an obstacle) if it contains any non-grabbable item\n      # UNLESS that item is the specific primitive we are looking for AND that primitive is grabbable\n      # (meaning we can move onto it to collect).\n      is_traversable = True\n      for kind_id in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_id] > 0: # If this non-grabbable item is present at (next_x, next_y)\n              # If it's the primitive we want AND it's grabbable, we can move there.\n              # Otherwise, it's an obstacle.\n              if not (is_primitive_grabbable and kind_id == primitive_idx):\n                  is_traversable = False\n                  break\n      \n      if not is_traversable:\n        continue\n\n      # If the cell is traversable and state not visited, add it to the queue\n      visited.add((next_x, next_y, next_dir))\n      q.append((next_x, next_y, next_dir, path_actions + [move_action_id]))\n\n  if target_reached_path:\n    return target_reached_path\n  else:\n    # If the BFS completes and no path to the primitive or its adjacent cell (facing it) was found.\n    return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:33:57.216280", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n    return []\n\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  action_map = env.action_specs()\n  ACTIONS = {\n      'DOWN': action_map['DOWN'], 'UP': action_map['UP'],\n      'LEFT': action_map['LEFT'], 'RIGHT': action_map['RIGHT'],\n      'USE': action_map['USE'],\n  }\n\n  # Mappings for directions and actions\n  # CraftState.dir: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  MOVE_VECTORS = { # (dx, dy) for the cell agent MOVES TO\n      ACTIONS['UP']: (0, -1),\n      ACTIONS['DOWN']: (0, 1),\n      ACTIONS['LEFT']: (-1, 0),\n      ACTIONS['RIGHT']: (1, 0),\n  }\n  NEW_DIR_AFTER_MOVE = { # New direction index of the agent AFTER the move action\n      ACTIONS['UP']: 0, # Agent will be facing UP (dir 0)\n      ACTIONS['DOWN']: 2, # Agent will be facing DOWN (dir 2)\n      ACTIONS['LEFT']: 3, # Agent will be facing LEFT (dir 3)\n      ACTIONS['RIGHT']: 1, # Agent will be facing RIGHT (dir 1)\n  }\n  DIR_FACE_VECTORS = { # (dx, dy) for the cell in front of the agent, based on agent's direction\n      0: (0, -1),  # UP\n      1: (1, 0),   # RIGHT\n      2: (0, 1),   # DOWN\n      3: (-1, 0),  # LEFT\n  }\n\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir # Initial direction of the agent\n  grid = current_state.grid\n  width, height, _ = grid.shape\n\n  is_primitive_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # BFS queue: (x, y, current_direction_idx, path_actions_to_reach_here)\n  q = collections.deque([(agent_pos[0], agent_pos[1], agent_dir, [])]) \n  # Visited set to prevent cycles and find shortest path: (x, y, current_direction_idx)\n  visited = set([(agent_pos[0], agent_pos[1], agent_dir)])\n\n  target_reached_path = None\n\n  while q:\n    curr_x, curr_y, curr_dir, path_actions = q.popleft()\n\n    # --- Check if the current state (position and direction) allows us to collect the primitive ---\n    if is_primitive_grabbable:\n      # If the primitive is grabbable, we need to move onto its cell to collect it.\n      # The direction does not matter for collection, only the position.\n      if grid[curr_x, curr_y, primitive_idx] > 0:\n        target_reached_path = path_actions\n        break # Found the shortest path to the grabbable primitive\n    else:\n      # If the primitive is non-grabbable, we need to be adjacent to it and USE it while facing it.\n      face_dx, face_dy = DIR_FACE_VECTORS[curr_dir]\n      target_cell_x = curr_x + face_dx\n      target_cell_y = curr_y + face_dy\n      \n      # Check if the cell in front of the agent is within bounds and contains the primitive\n      if (0 <= target_cell_x < width and 0 <= target_cell_y < height and\n          grid[target_cell_x, target_cell_y, primitive_idx] > 0):\n        target_reached_path = path_actions + [ACTIONS['USE']]\n        break # Found a path to a position/direction from which we can USE the primitive\n\n    # --- Explore neighbors (possible moves) ---\n    for move_action_id in [ACTIONS['UP'], ACTIONS['DOWN'], ACTIONS['LEFT'], ACTIONS['RIGHT']]:\n      move_dx, move_dy = MOVE_VECTORS[move_action_id]\n      next_x, next_y = curr_x + move_dx, curr_y + move_dy\n      next_dir = NEW_DIR_AFTER_MOVE[move_action_id]\n\n      # Check boundary conditions\n      if not (0 <= next_x < width and 0 <= next_y < height):\n        continue\n      \n      # Check if this state (position + direction) has already been visited\n      if (next_x, next_y, next_dir) in visited:\n        continue\n      \n      # Check traversability of (next_x, next_y)\n      # A cell is considered non-traversable (an obstacle) if it contains ANY non-grabbable item.\n      is_traversable = True\n      # Iterate through all kinds that are defined as non-grabbable by the world configuration\n      for kind_id in env.world.non_grabbable_indices:\n          if grid[next_x, next_y, kind_id] > 0: # If this specific non-grabbable item is present at (next_x, next_y)\n              is_traversable = False # Then this cell is an obstacle and cannot be moved onto\n              break\n      \n      if not is_traversable:\n        continue\n\n      # If the cell is traversable and the state (pos+dir) not visited, add it to the queue\n      visited.add((next_x, next_y, next_dir))\n      q.append((next_x, next_y, next_dir, path_actions + [move_action_id]))\n\n  if target_reached_path:\n    return target_reached_path\n  else:\n    # If the BFS completes and no path to the primitive or its adjacent cell was found.\n    return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:34:56.246332", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Pre-check: If the primitive is already in inventory and is a grabbable item.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Format: action_id: (dr, dc, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), # Moving up makes agent face North (dir 0)\n      craft.RIGHT: (  0,  1, 1), # Moving right makes agent face East (dir 1)\n      craft.DOWN:  (  1,  0, 2), # Moving down makes agent face South (dir 2)\n      craft.LEFT:  (  0, -1, 3)  # Moving left makes agent face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for globally impassable terrains (like water and stone).\n      if current_state.grid[r, c, water_index] == 1 or \\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles.\n      # Workshops are special non-grabbable entities that *are* walkable (agent can stand on them).\n      for idx in non_grabbable_indices:\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue # Already handled or are explicitly considered walkable.\n          \n          # If a cell contains any other non-grabbable item (not water, stone, or workshop), it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is considered walkable.\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the collection goal.\n      # For grabbable items, the agent needs to move onto the item's cell.\n      if primitive_idx in grabbable_indices:\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found to a grabbable item's location.\n      # For non-grabbable items, the agent needs to be adjacent to the item\n      # and facing it, then use the 'USE' action.\n      elif primitive_idx in non_grabbable_indices:\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check bounds for the cell in front\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the primitive, we can collect it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:34:57.461244", "function_name": "collect", "function_body": "  world = env.world\n  cookbook = world.cookbook\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # Get the integer ID for the target primitive.\n  # This might raise an error if `primitive` is not in the cookbook's index,\n  # which is an expected behavior for invalid DSL input.\n  primitive_idx = cookbook.index.index(primitive)\n  \n  # 1. Check if the primitive is already in inventory.\n  # If it's a grabbable item and the agent already has it, no actions are needed.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # MOVE_ACTIONS: Maps action_id -> (delta_row, delta_col, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), \n      craft.DOWN:  (  1,  0, 2),\n      craft.LEFT:  (  0, -1, 3),\n      craft.RIGHT: (  0,  1, 1),\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  # This is crucial for checking the 'USE' action target.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP) -> (row-1, col)\n      1: (0, 1),   # East (RIGHT) -> (row, col+1)\n      2: (1, 0),   # South (DOWN) -> (row+1, col)\n      3: (0, -1)   # West (LEFT) -> (row, col-1)\n  }\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  # It uses values from the outer scope for `world` attributes (e.g., world.non_grabbable_indices).\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for globally impassable terrains (like deep water and large stones).\n      # These are typically hard obstacles.\n      if current_state.grid[r, c, world.water_index] == 1 or \\\n         current_state.grid[r, c, world.stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles.\n      # Workshops (WORKSHOP0, WORKSHOP1, WORKSHOP2) are considered walkable as the agent\n      # can stand on them to craft. Other non-grabbable items might block movement.\n      for idx in world.non_grabbable_indices:\n          # Skip types already handled or known to be walkable (like workshops).\n          if idx == world.water_index or idx == world.stone_index or idx in world.workshop_indices:\n              continue \n          \n          # If the cell contains any other non-grabbable item (not water, stone, or workshop), it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is considered walkable.\n\n  # Initialize BFS queue with the agent's current state:\n  # Each element is (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction) because direction affects actions.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # --- Goal Check ---\n      if primitive_idx in world.grabbable_indices:\n          # For grabbable items (like WOOD, IRON, GRASS, etc.), the agent collects them\n          # by simply moving onto their cell.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found: agent is on the item's location.\n      elif primitive_idx in world.non_grabbable_indices:\n          # For non-grabbable items (like BOUNDARY, WATER, STONE, WORKSHOPS),\n          # the agent needs to be adjacent to the item and face it, then use 'USE'.\n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check bounds for the cell in front\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the primitive, we can collect (interact with) it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # --- Explore Possible Actions (Movement) ---\n      for action_id, (dr, dc, new_facing_direction_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next cell is walkable using the helper function.\n          if _is_walkable(next_r, next_c):\n              \n              next_state_tuple = (next_r, next_c, new_facing_direction_after_move)\n              # If this new state (position + direction) hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, new_facing_direction_after_move, path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:35:44.231434", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone.\n  # BOUNDARY is handled separately for obstacle avoidance, but if it's the target,\n  # it behaves like a stationary primitive.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index)\n  \n  # Get boundary index for obstacle checking.\n  boundary_idx = cookbook.index['BOUNDARY']\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time a\n    # goal node (or a node satisfying the goal condition) is popped from the queue,\n    # the path to it is the shortest. We can return immediately.\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive or primitive_idx == boundary_idx:\n      # For workshops, water, stone, or boundary (if boundary is the target),\n      # \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No USE action is typically needed for these\n    \n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles (e.g., BOUNDARY). We should not move into a boundary cell\n        # unless the boundary itself is the target primitive (which implies we want to reach it).\n        is_obstacle = grid[new_x, new_y, boundary_idx] > 0\n        if is_obstacle and primitive_idx != boundary_idx:\n            continue # Skip this path, it's blocked by a boundary\n\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path to the primitive is found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-01T21:35:45.432155", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # Get the integer ID for the primitive from the cookbook's index.\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not recognized or does not have an ID, we cannot collect it.\n    return []\n\n  # Retrieve action mappings (integer IDs) from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (change in x, change in y) and their corresponding action IDs.\n  # This list helps iterate over adjacent cells in the BFS.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up (decreases Y coordinate)\n      (0, 1, ACTION_DOWN),   # Move Down (increases Y coordinate)\n      (-1, 0, ACTION_LEFT),  # Move Left (decreases X coordinate)\n      (1, 0, ACTION_RIGHT),  # Move Right (increases X coordinate)\n  ]\n\n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current starting position in the grid.\n  start_pos = state.pos\n\n  # --- BFS (Breadth-First Search) Setup ---\n  # The queue will store tuples: (current_position, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to prevent cycles and redundant paths.\n  visited = {start_pos} \n\n  # Determine the type of the target primitive to apply the correct \"collection\" logic.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, or boundary.\n  # \"Collecting\" these typically means simply reaching their location without a `USE` action.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # --- BFS Algorithm Execution ---\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState object representing the agent *at* `current_pos`.\n    # This allows us to use `CraftState` methods (like `next_to`) or directly inspect `grid` content\n    # as if the agent were physically at this specific cell during pathfinding.\n    # Agent's direction and inventory are kept constant as they do not affect the geometry of pathfinding.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the `current_pos` satisfies the goal for collecting the primitive.\n    # For unweighted graphs (like this grid movement), BFS guarantees that the first time\n    # a goal state is reached (i.e., its path is popped from the queue), that path is the shortest.\n    if is_grabbable:\n      # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move\n      # to a cell *adjacent* to it and then perform a `USE` action to pick it up.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # If the primitive is a workshop, water, stone, or boundary, \"collecting\" it\n      # means reaching the cell where it is located. No `USE` action is typically needed.\n      # We check if the primitive_idx layer at the current position has a count greater than 0.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Path found, no additional action needed beyond movement.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries (0 <= x < WIDTH, 0 <= y < HEIGHT).\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # If this position hasn't been visited yet, add it to the queue for exploration.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and the queue becomes empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T21:36:42.571205", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  world = env.world\n  cookbook = world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        # Check if the potential target cell is within grid bounds\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          bfs_target_cells.add((nx, ny))\n\n  # Define impassable terrain indices.\n  # These are entities that the agent generally cannot step onto.\n  # From CraftWorld attributes, non_grabbable_indices contains items that cannot be picked up.\n  # Workshops are in non_grabbable_indices but are traversable locations.\n  # Therefore, impassable cells are those containing a non_grabbable_index that is not a workshop.\n  impassable_kind_indices = set(world.non_grabbable_indices) - set(world.workshop_indices)\n  \n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of (x, y) coordinates visited\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # 1. Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Check if the next position is impassable\n      # A cell is impassable if it contains any kind from impassable_kind_indices\n      is_impassable = False\n      for kind_idx in impassable_kind_indices:\n          if grid[next_x, next_y, kind_idx] == 1:\n              is_impassable = True\n              break\n      \n      if is_impassable:\n        continue # Cannot move into an impassable cell\n\n      # 3. Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.0}}
