{"timestamp": "2025-08-02T08:51:28.854236", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # 2. Check if the primitive is already in the inventory.\n  # If the agent possesses at least one unit of the primitive, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # Determine if the primitive is grabbable or a stationary/location type.\n  # Grabbable items are those that can be picked up (not in non_grabbable_indices).\n  # Stationary/location items are those you just need to reach or be next to (in non_grabbable_indices).\n  is_grabbable = primitive_idx not in env.world.non_grabbable_indices\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    else: # This covers all non-grabbable items like workshops, water, stone, boundary.\n          # For these, \"collecting\" means reaching the location itself.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      # If we found a path of equal length, we prefer the current one because BFS\n      # ensures the first path to any *cell* is shortest to that cell. By processing\n      # all neighbors before expanding further, we ensure we find the shortest sequence\n      # of (move + optional USE) actions.\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n        # Note: We don't break here. This is crucial because the \"goal\" state for\n        # grabbable items involves being *adjacent* and then using ACTION_USE.\n        # It's possible that a slightly longer movement path leads to a cell from\n        # which a shorter (or equally short) `USE` action path is available.\n        # By continuing, we ensure we find the shortest *overall* action sequence.\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Avoid obstacles: Check if the new position is traversable.\n        # This typically means it's not a 'BOUNDARY' or some other impassable block.\n        # Assuming agent can move onto any cell that is not a 'BOUNDARY'.\n        # The environment implicitly handles non-traversable cells during `step`.\n        # For BFS, we simply don't add positions that are known to be blocked.\n        # The prompt doesn't specify non-traversable blocks explicitly other than BOUNDARY.\n        # We can safely assume the agent can move onto any cell *unless* it's a BOUNDARY.\n        # Let's check if the new cell itself is a 'BOUNDARY'.\n        is_boundary_at_new_pos = False\n        boundary_idx = cookbook.index['BOUNDARY']\n        if boundary_idx is not None:\n          if grid[new_x, new_y, boundary_idx] > 0:\n            is_boundary_at_new_pos = True\n\n        if new_pos not in visited and not is_boundary_at_new_pos:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  return best_path_actions", "island_id": 7, "scores": {"3": 0.5}}
