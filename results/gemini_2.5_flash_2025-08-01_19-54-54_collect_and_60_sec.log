      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if boundary_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            if grid[new_x, new_y, boundary_idx] > 0 and primitive_idx != boundary_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:48:55.283735", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state from the environment\n  \n  # 1. Resolve the primitive's string name to its unique integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook (e.g., a typo), it cannot be collected.\n    return []\n\n  # 2. Map symbolic action names to their corresponding integer IDs from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define the set of possible movement actions (dx, dy, action_id) for BFS exploration.\n  # These tuples represent the relative change in coordinates (dx, dy) and the action\n  # needed to perform that movement.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreasing Y)\n      (0, 1, ACTION_DOWN),   # Move South (increasing Y)\n      (-1, 0, ACTION_LEFT),  # Move West (decreasing X)\n      (1, 0, ACTION_RIGHT),  # Move East (increasing X)\n  ]\n\n  # 4. Extract grid dimensions for boundary checks during pathfinding.\n  grid_width, grid_height, _ = grid.shape\n\n  # 5. Initialize BFS components:\n  #    - `queue`: A `collections.deque` to store (current_position, list_of_actions_taken) tuples.\n  #               This allows for efficient additions and removals from both ends, suitable for BFS.\n  #    - `visited_positions`: A `set` to keep track of grid positions already explored. This prevents\n  #                           revisiting positions (avoiding cycles) and ensures the shortest path is found.\n  start_pos = state.pos\n  queue = collections.deque([(start_pos, [])]) \n  visited_positions = {start_pos} \n\n  # 6. Classify the primitive type to determine the specific \"collection\" condition.\n  #    Different primitives are \"collected\" in different ways:\n  #    - Grabbable items (e.g., WOOD, IRON) require being adjacent and then a 'USE' action.\n  #    - Stationary items (e.g., WORKSHOPS, WATER, STONE, BOUNDARY) are \"collected\" by merely reaching their cell.\n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  \n  # Define the set of primitives that are collected by simply being on their cell.\n  on_cell_primitives = set(env.world.workshop_indices)\n  on_cell_primitives.add(env.world.water_index)\n  on_cell_primitives.add(env.world.stone_index)\n  \n  # Add 'BOUNDARY' to on_cell_primitives if it's a valid indexed item.\n  boundary_idx = cookbook.index['BOUNDARY']\n  if boundary_idx is not None:\n      on_cell_primitives.add(boundary_idx)\n  \n  # 7. Execute Breadth-First Search (BFS) algorithm.\n  while queue:\n    current_pos, path_actions = queue.popleft()\n    cx, cy = current_pos\n\n    # Create a temporary CraftState object for the current BFS position.\n    # This allows us to leverage CraftState's methods (like `next_to` and direct `grid` access)\n    # to check for the primitive's presence relative to the `current_pos` without\n    # altering the actual environment's state.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # 8. Check if the current position (or its vicinity) satisfies the collection goal.\n    #    Because BFS explores layer by layer, the first time a goal is met, the path\n    #    leading to it is guaranteed to be the shortest one.\n    if is_grabbable_item:\n      # If the target is a grabbable item, the agent needs to be adjacent to it and then 'USE'.\n      # The `next_to` method efficiently checks the 3x3 neighborhood around `temp_state_at_pos.pos`.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return path_actions + [ACTION_USE] # Path found, append the 'USE' action.\n    elif primitive_idx in on_cell_primitives:\n      # If the target is a stationary primitive (workshop, water, stone, boundary),\n      # \"collection\" means simply arriving at the cell where the entity exists.\n      # We check if the primitive_idx layer at the current position (cx, cy) has a count > 0.\n      if temp_state_at_pos.grid[cx, cy, primitive_idx] > 0:\n        return path_actions # Path found; reaching the location is sufficient, no additional action needed.\n    \n    # 9. If the goal is not yet met at `current_pos`, explore all valid, unvisited neighboring cells.\n    for dx, dy, action in MOVEMENT_ACTIONS:\n      new_x, new_y = cx + dx, cy + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n        # If this new position has not been visited before, add it to the queue for future exploration\n        # and mark it as visited.\n        if new_pos not in visited_positions:\n          visited_positions.add(new_pos)\n          queue.append((new_pos, path_actions + [action]))\n  \n  # 10. If the BFS queue becomes empty and no path to the primitive was found,\n  #     it means the primitive is unreachable from the current position.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:48:56.488534", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = env.world.cookbook\n  grid = current_state.grid # The grid layout of the current environment\n  \n  # 1. Resolve the primitive's string name to its unique integer ID.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook, it's not a valid target.\n    return []\n\n  # 2. Map symbolic action names to their corresponding integer IDs from the environment.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # 3. Define the set of possible movement actions (dx, dy, action_id) for BFS exploration.\n  #    These map to UP, DOWN, LEFT, RIGHT movements on the grid.\n  MOVEMENT_ACTIONS = [\n      (0, -1, ACTION_UP),    # Move North (decreasing Y-coordinate)\n      (0, 1, ACTION_DOWN),   # Move South (increasing Y-coordinate)\n      (-1, 0, ACTION_LEFT),  # Move West (decreasing X-coordinate)\n      (1, 0, ACTION_RIGHT),  # Move East (increasing X-coordinate)\n  ]\n\n  # 4. Extract grid dimensions for boundary checks during pathfinding.\n  grid_width, grid_height, _ = grid.shape\n\n  # 5. Initialize BFS components:\n  #    - `queue`: A deque to store (position, path_taken) tuples, for breadth-first exploration.\n  #      `position` is a (x, y) tuple. `path_taken` is a list of action IDs.\n  #    - `visited_positions`: A set to keep track of already explored grid positions\n  #      to prevent cycles and ensure the shortest path is found.\n  start_pos = current_state.pos\n  queue = collections.deque([(start_pos, [])]) \n  visited_positions = {start_pos} \n\n  # 6. Classify the primitive type to determine the specific \"collection\" condition.\n  #    - Grabbable items (e.g., WOOD, IRON): Require agent to be adjacent and then perform 'USE'.\n  #    - On-Cell primitives (e.g., WORKSHOP0, WATER, STONE, BOUNDARY): Agent needs to be ON the cell.\n  \n  is_grabbable_item = primitive_idx in env.world.grabbable_indices\n  \n  # Compile a set of indices for primitives that are 'collected' by simply\n  # moving onto their tile (not requiring 'USE' while adjacent).\n  on_cell_primitives = set(env.world.workshop_indices)\n  on_cell_primitives.add(env.world.water_index)\n  on_cell_primitives.add(env.world.stone_index)\n  \n  # Add BOUNDARY if it's a valid index and treated as an on-cell primitive.\n  # This assumes 'BOUNDARY' is an entity that can be occupied.\n  boundary_idx = cookbook.index['BOUNDARY']\n  if boundary_idx is not None:\n      on_cell_primitives.add(boundary_idx)\n  \n  # 7. Execute Breadth-First Search.\n  while queue:\n    current_pos, path_actions = queue.popleft()\n    \n    # Create a temporary CraftState object for the current BFS position.\n    # This allows us to leverage methods like `next_to` which abstract\n    # checking the neighborhood based on the agent's simulated position.\n    # The inventory and direction from the *initial* state are sufficient,\n    # as collecting doesn't change these until the final 'USE' action.\n    temp_state_at_pos = craft.CraftState(\n        current_state.scenario, \n        current_state.grid, \n        current_pos, \n        current_state.dir, \n        current_state.inventory\n    )\n\n    # 8. Check if the current position (or its vicinity) satisfies the collection goal.\n    #    Since BFS explores layer by layer, the first time a goal is met, the path\n    #    leading to it is guaranteed to be the shortest one.\n    if is_grabbable_item:\n      # For grabbable items, the agent must be adjacent (within 3x3) and then 'USE'.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return path_actions + [ACTION_USE]\n    elif primitive_idx in on_cell_primitives:\n      # For workshops, fixed terrain (water, stone), or boundary markers,\n      # \"collection\" means simply arriving at the cell where the entity exists.\n      # Check if the current cell contains the primitive.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return path_actions # No 'USE' action needed; reaching the location is enough.\n    \n    # 9. If the goal is not yet met, explore all valid, unvisited neighboring cells.\n    for dx, dy, action in MOVEMENT_ACTIONS:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Ensure the new position is within the grid boundaries.\n      if 0 <= new_x < grid_width and 0 <= new_y < grid_height:\n        # Avoid revisiting positions to ensure shortest path and prevent infinite loops.\n        if new_pos not in visited_positions:\n          visited_positions.add(new_pos)\n          queue.append((new_pos, path_actions + [action]))\n  \n  # 10. If the BFS completes and no path to the primitive is found (i.e., it's unreachable),\n  #     return an empty list of actions.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:49:39.104895", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  \n  # Map the primitive's string name to its unique integer ID.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found, it's an unknown item for collection.\n    return []\n\n  # Retrieve the integer codes for movement and 'USE' actions.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Identify entity indices that represent impassable terrain.\n  # These are generally 'WATER' and 'BOUNDARY' in CraftWorld.\n  impassable_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    impassable_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    impassable_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a grid cell is within bounds and traversable.\n  def is_traversable(x: int, y: int) -> bool:\n    # Check if coordinates are within the grid boundaries.\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    \n    # Check if the cell at (x, y) contains any impassable entities.\n    for idx in impassable_indices:\n      if grid[x, y, idx] == 1:\n        return False  # This cell is blocked.\n    return True\n\n  # Find all grid locations where the target primitive exists.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # If the primitive is not present on the grid, it cannot be collected.\n    return []\n\n  # --- Optimized: Check for immediate collection if already adjacent ---\n  # If the agent is already in the 3x3 neighborhood of a primitive, just use it.\n  # The `state.next_to()` method checks exactly this.\n  if state.next_to(primitive_idx):\n      return [USE]\n\n  # --- Breadth-First Search (BFS) for pathfinding to an adjacent cell ---\n  # BFS queue: stores (current_position, list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set: to prevent cycles and redundant exploration.\n  visited = {agent_pos}\n\n  # Define movement vectors for each action.\n  move_deltas = {\n      UP: (0, -1),   # (dx, dy)\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_so_far = queue.popleft() # Dequeue the current state.\n\n    # Explore all possible adjacent moves.\n    for action, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate new potential position.\n\n      # Check if the new position is traversable and hasn't been visited yet.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_so_far + [action] # Extend the action sequence.\n        \n        # Check if this new position (nx, ny) is adjacent to any instance of the primitive.\n        # Adjacency means Chebyshev distance <= 1.\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations:\n          if max(abs(nx - px), abs(ny - py)) <= 1:\n            is_adjacent_to_primitive = True\n            break\n        \n        if is_adjacent_to_primitive:\n          # If we've reached a cell adjacent to the primitive, append 'USE'\n          # and return this shortest sequence of actions.\n          return new_path_actions + [USE]\n        else:\n          # If not yet adjacent, add this new valid position to the queue\n          # for further exploration and mark it as visited.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # If the BFS completes and the queue is empty without finding a path,\n  # it means the primitive is unreachable or not present.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:49:40.278029", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # Current agent position (x, y)\n  cookbook = env.world.cookbook\n  \n  # Map the primitive's string name to its unique integer ID, as used in the grid and inventory.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook's index, it's an unknown item.\n    return []\n\n  # Retrieve the integer codes for movement and 'USE' actions from the environment's action space.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Identify entities that block agent movement. In CraftWorld, 'WATER' and 'BOUNDARY'\n  # are typically impassable. Workshops (WORKSHOP0, etc.) are generally traversable.\n  blocking_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a given grid coordinate is within bounds and does not\n  # contain any blocking entity.\n  def is_traversable(x: int, y: int) -> bool:\n    # Check for grid boundary violations.\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    \n    # Check if the cell at (x, y) is occupied by any blocking kind.\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False  # This cell is an obstacle.\n    return True\n\n  # Locate all occurrences of the target primitive on the current grid.\n  # np.argwhere returns (row, col) which corresponds to (y, x) if grid is (H, W),\n  # but here grid is (WIDTH, HEIGHT), so it's (x, y).\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # Optimization: Initial Check for Immediate Adjacency\n  # If the agent is already within a 3x3 neighborhood (Chebyshev distance <= 1)\n  # of the primitive, only the 'USE' action is required.\n  for px, py in primitive_locations_on_grid:\n    # `max(abs(dx), abs(dy)) <= 1` means the agent is adjacent (within a 3x3 square).\n    if max(abs(agent_pos[0] - px), abs(agent_pos[1] - py)) <= 1:\n      return [USE]\n\n  # Breadth-First Search (BFS) for Shortest Pathfinding\n  # BFS queue: stores tuples of ((current_x, current_y), [actions_taken_to_reach_here]).\n  queue = collections.deque([(agent_pos, [])])\n  # Visited set: prevents revisiting locations and infinite loops in BFS.\n  visited = {agent_pos}\n\n  # Define the relative position changes (dx, dy) for each movement action.\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft() # Dequeue the current position and its path.\n\n    # Explore all four possible neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in move_deltas.items():\n      nx, ny = cx + dx, cy + dy  # Calculate the coordinates of the new potential position.\n\n      # Check if the new position is valid (within grid bounds), traversable (not blocked),\n      # and has not been visited yet in this BFS.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_actions + [action_type] # Extend the path.\n        \n        # Check if this new position (nx, ny) is adjacent to any primitive location.\n        # This is the goal condition for our BFS: finding the shortest path to a cell\n        # from which the primitive can be 'USE'd.\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations_on_grid:\n          if max(abs(nx - px), abs(ny - py)) <= 1:\n            is_adjacent_to_primitive = True\n            break\n        \n        if is_adjacent_to_primitive:\n          # If an adjacent position is found, append the 'USE' action and return the complete path.\n          # BFS guarantees this is the shortest sequence of actions.\n          return new_path_actions + [USE]\n        else:\n          # If not yet adjacent to a primitive, add this new position to the queue\n          # for further exploration and mark it as visited.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # If the BFS completes and the queue becomes empty without finding a path\n  # to an adjacent primitive location, it means the primitive is unreachable\n  # from the agent's current position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:50:24.036276", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  \n  Returns a list of actions to find, move to, and collect the specified primitive.\n  This involves pathfinding to a location from which the 'USE' action can acquire the item.\n  \n  Args:\n      env (env.CraftLab): The CraftLab environment object.\n      primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"IRON\").\n\n  Returns:\n      List[int]: A sequence of action indices (integers) to execute,\n                 or an empty list if the primitive is not found, cannot be collected,\n                 or is unreachable.\n  \"\"\"\n  # 1. Validate primitive name and ensure it's a grabbable item.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized by the environment's cookbook.\n      return []\n\n  if primitive_idx not in env.world.grabbable_indices:\n      # The 'collect' function specifically refers to acquiring an item from the grid\n      # and adding it to the agent's inventory via the 'USE' action. This is only\n      # possible for items designated as 'grabbable'. If the target primitive is\n      # not grabbable, no sequence of actions (movement + USE) will lead to collecting it.\n      return []\n\n  # 2. Get the current state of the environment and its relevant attributes.\n  state = env._current_state\n  initial_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout: (WIDTH, HEIGHT, n_kinds) occupancy.\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # 3. Retrieve the integer mappings for movement and 'USE' actions from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define all possible single-step movements and their corresponding action IDs.\n  # These tuples represent (dx, dy) for the move, and the action to take.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one step down (increase y)\n      ((0, -1), UP_ACTION),   # Move one step up (decrease y)\n      ((-1, 0), LEFT_ACTION), # Move one step left (decrease x)\n      ((1, 0), RIGHT_ACTION), # Move one step right (increase x)\n  ]\n\n  # 4. Locate all occurrences of the target primitive on the grid.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If there is at least one unit of the target primitive at this grid cell.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not present anywhere on the map, it cannot be collected.\n      return []\n\n  # 5. Use Breadth-First Search (BFS) to find the shortest sequence of actions\n  #    (movements) to reach a cell from which the primitive can be 'USE'd.\n  #    The queue stores tuples: (current_position (x,y), list_of_actions_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # Keep track of visited positions to avoid redundant paths and infinite loops.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path_to_current = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to any of the primitive's locations.\n      # \"Adjacent\" for the 'USE' action means within a 3x3 neighborhood (Manhattan distance <= 1).\n      is_adjacent_to_target_primitive = False\n      for px, py in primitive_locations:\n          # Check if current position (cx, cy) is within Manhattan distance 1 of (px, py)\n          # This covers the current cell itself and the 8 surrounding cells.\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_target_primitive = True\n              break\n      \n      if is_adjacent_to_target_primitive:\n          # If an adjacent location is found, append the 'USE' action\n          # and return the complete action sequence.\n          path_to_current.append(USE_ACTION)\n          return path_to_current\n\n      # Explore all four possible neighboring cells from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # First, ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this grid cell.\n                  if k_idx == primitive_idx:\n                      # If the cell contains the primitive itself, it's generally traversable\n                      # as you might need to move onto the primitive's square to collect it.\n                      pass \n                  elif k_idx in env.world.non_grabbable_indices:\n                      # Some non-grabbable entities (like workshops or water) are traversable\n                      # or interactive points, not necessarily blocking movement.\n                      if k_idx in env.world.workshop_indices or k_idx == env.world.water_index:\n                          pass # Allow movement onto these specific non-grabbables.\n                      else:\n                          # Other non-grabbable entities not in workshop_indices or water_index\n                          # are considered impassable obstacles (e.g., walls, certain boundaries).\n                          is_impassable = True\n                          break # This cell contains an obstacle, no need to check other kinds in it.\n          \n          if is_impassable:\n              continue # Skip this path; the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to maintain independence for each BFS branch.\n              new_path = list(path_to_current) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive location\n  # was found, it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:50:25.315857", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Specifically ensures the primitive is grabbable before attempting collection,\n  and refines the traversability logic for clarity regarding obstacles.\n  \"\"\"\n  # 1. Validate the primitive name and check if it's a grabbable item\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # Primitive name not recognized by the environment's cookbook\n      return []\n\n  # The 'collect' function implies picking up an item into inventory.\n  # This is only possible for items designated as 'grabbable'.\n  if primitive_idx not in env.world.grabbable_indices:\n      # If the target primitive is not a grabbable item, it cannot be collected\n      # in the sense of adding it to inventory via a 'USE' action sequence.\n      return []\n\n  # 2. Extract relevant information from the current environment state\n  state = env._current_state\n  agent_pos = state.pos  # Agent's current (x, y) position\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # 3. Get the integer action mappings for movement and 'USE'\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),\n      ((0, -1), UP_ACTION),\n      ((-1, 0), LEFT_ACTION),\n      ((1, 0), RIGHT_ACTION),\n  ]\n\n  # 4. Find all locations on the grid where the target primitive exists\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If there's any quantity of the target primitive at this cell\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, no actions can be taken\n      return []\n\n  # 5. Use Breadth-First Search (BFS) to find the shortest path to a cell\n  #    from which the primitive can be 'USE'd.\n  # The queue stores tuples: (current_position (x,y), list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # Keep track of visited positions to avoid redundant paths and infinite loops.\n  # For unweighted graphs like this, the first time we visit a position is always via the shortest path.\n  visited = {agent_pos}\n\n  while queue:\n      current_pos, path_to_current = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to any of the primitive's locations.\n      # The 'USE' action in CraftWorld typically applies to a 3x3 neighborhood.\n      is_adjacent_to_primitive_for_use = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1: # Manhattan distance <= 1 covers 3x3\n              is_adjacent_to_primitive_for_use = True\n              break\n      \n      if is_adjacent_to_primitive_for_use:\n          # If an adjacent location is found, append the 'USE' action\n          # and return the complete action sequence.\n          path_to_current.append(USE_ACTION)\n          return path_to_current\n\n      # Explore all four possible neighboring cells from the current position.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # First, ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable.\n          # A cell is considered impassable if it contains any non-grabbable\n          # entity that is NOT a workshop and NOT water.\n          is_impassable = False\n          # Iterate through all kinds present at the next cell.\n          for k_idx in range(num_kinds):\n              if grid[next_x, next_y, k_idx] > 0: # If something of kind k_idx is present\n                  # If the entity is the primitive we are collecting, it's traversable.\n                  # The agent might move onto the cell containing the primitive itself.\n                  if k_idx == primitive_idx:\n                      continue \n                  # Check if this kind is a non-grabbable obstacle.\n                  # Workshops and water are special non-grabbables that are generally traversable.\n                  if k_idx in env.world.non_grabbable_indices:\n                      if k_idx in env.world.workshop_indices or k_idx == env.world.water_index:\n                          continue # Allow movement onto these specific non-grabbables.\n                      else:\n                          # This is a non-grabbable entity that blocks movement (e.g., 'BOUNDARY', 'STONE' if not grabbable).\n                          is_impassable = True\n                          break # The cell is blocked, no need to check other kinds in it.\n          \n          if is_impassable:\n              continue # Skip this path; the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to maintain independence for each BFS branch.\n              new_path = list(path_to_current) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive location\n  # was found, it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:51:24.236805", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # --- IMPROVEMENT FOR V2: Refine early exit for inventory ---\n  # If the primitive is a grabbable item (can be picked up and stored in inventory)\n  # and the agent already has at least one of it, no actions are needed to collect more.\n  # For non-grabbable primitives (like workshops, water, stone, boundary),\n  # the goal is to reach their location, not to put them in inventory.\n  # So, this inventory check should only apply to grabbable items.\n  if primitive_idx in env.world.grabbable_indices and state.inventory[primitive_idx] > 0:\n    return [] \n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary.\n  # Their \"collection\" means simply reaching the cell where they are located.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell `current_pos`.\n      # Note: The grid stores counts, so a value > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these, just being there.\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph (like this grid-based movement), BFS guarantees the first\n    # path found to a goal state is the shortest one.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target primitive is NOT 'BOUNDARY',\n            # then this new position is considered an impassable obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        # If the new position has not been visited and is not an obstacle, add it to the queue.\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and no path is found (e.g., the primitive is unreachable\n  # due to being blocked by obstacles or not existing in the environment),\n  # return an empty list of actions.\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:51:25.422077", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # 2. Determine the type of primitive to apply correct \"collection\" logic and early exit conditions.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Identify boundary for obstacle checking.\n  boundary_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      boundary_idx = cookbook.index['BOUNDARY']\n  \n  # A primitive is \"stationary\" if it's water, stone, or boundary itself (which doesn't move/go to inventory).\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (boundary_idx is not None and primitive_idx == boundary_idx))\n\n  # 3. Early exit if the primitive is already \"collected\" based on its type.\n  if is_grabbable:\n    # For grabbable items, \"collected\" means having it in inventory.\n    if state.inventory[primitive_idx] > 0:\n      return [] # Already possess the grabbable item.\n  elif is_workshop or is_stationary_primitive:\n    # For workshops or stationary environment features, \"collected\" means being at their location.\n    # Check if the agent is currently standing on the target primitive's cell.\n    if grid[state.pos[0], state.pos[1], primitive_idx] > 0:\n      return [] # Agent is already at the target location.\n\n  # 4. Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # 5. BFS setup for pathfinding.\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    \n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    if is_grabbable:\n      # For grabbable items, the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops or stationary primitives, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for impassable obstacles: do not move into a 'BOUNDARY' cell\n        # unless we are specifically collecting 'BOUNDARY' itself.\n        is_impassable_obstacle = False\n        if boundary_idx is not None:\n            if grid[new_x, new_y, boundary_idx] > 0 and primitive_idx != boundary_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:51:57.411179", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive.\n  # If the primitive name is not recognized in the cookbook, it cannot be collected.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  # 2. Check if the primitive is actually a grabbable item.\n  # The 'collect' action implies adding an item to the agent's inventory.\n  # Entities like WORKSHOPs, BOUNDARY, or WATER are not grabbable and cannot be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # 3. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no further actions are needed to collect it.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Action integer mappings provided by the environment's action space.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping from (dx, dy) movement vector to the corresponding action index.\n  # This is used to reconstruct the path from BFS results.\n  dir_to_action = {\n      (0, -1): UP,    # Move UP means y decreases\n      (0, 1): DOWN,   # Move DOWN means y increases\n      (-1, 0): LEFT,  # Move LEFT means x decreases\n      (1, 0): RIGHT,  # Move RIGHT means x increases\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Define indices for entities that block agent movement.\n  # 'BOUNDARY' and 'WATER' are typically untraversable in CraftWorld.\n  impassable_indices = set()\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_indices.add(cookbook.index['BOUNDARY'])\n  if 'WATER' in cookbook.index.contents:\n      impassable_indices.add(cookbook.index['WATER'])\n\n  # Helper function to check if a given grid cell (x, y) is traversable by the agent.\n  # A cell is traversable if it is within the grid boundaries and does not contain any impassable entities.\n  def is_cell_traversable(x, y):\n      # Check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n\n      # Check if the cell contains any impassable objects.\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Cell contains an impassable object\n      return True\n\n  # Early exit: If the agent's current position is not traversable, it cannot move or act.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # 4. Find all locations on the grid where the target primitive is present.\n  # `np.argwhere` returns coordinates (row, col) which correspond to (x, y) if grid is grid[x, y, kind],\n  # which is typical for CraftWorld grids.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  # Early exit: If the primitive is not found anywhere on the grid, it cannot be collected.\n  if len(primitive_locations) == 0:\n    return []\n\n  # 5. Determine the set of target cells for the agent's movement.\n  # These are traversable cells from which the agent can successfully 'USE' the primitive.\n  # According to `CraftState.next_to`, this means any cell in the 3\u00d73 neighborhood (including itself)\n  # around a primitive's location.\n  bfs_target_cells = set()\n  for px, py in primitive_locations: # (px, py) is a coordinate of a primitive instance\n    # Iterate through the 3x3 neighborhood around the primitive location (px, py).\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        tx, ty = px + dx_n, py + dy_n # (tx, ty) is a potential cell for the agent to stand on\n\n        # Only add a cell to the target set if it's within bounds and traversable by the agent.\n        if is_cell_traversable(tx, ty):\n          bfs_target_cells.add((tx, ty))\n\n  # Early exit: If no valid traversable target cells exist (e.g., the primitive is\n  # surrounded by impassable terrain), no path can be found.\n  if not bfs_target_cells:\n      return []\n\n  # 6. Perform Breadth-First Search (BFS) to find the shortest path from the agent's current position\n  # to any of the `bfs_target_cells`.\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(agent_pos, [])])\n  # The 'visited' set keeps track of (x,y) positions already processed to prevent cycles and redundant work.\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path_so_far = q.popleft()\n    \n    # If the current position is one of our `bfs_target_cells`, we have found the shortest path.\n    if current_pos in bfs_target_cells:\n      # Append the 'USE' action to the path and return the complete sequence.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells in cardinal directions (UP, DOWN, LEFT, RIGHT).\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is traversable and has not been visited yet in this BFS.\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        # Create a new path by appending the action required to move to `next_pos`.\n        new_path = path_so_far + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # 7. If the queue becomes empty and no path was found to any target cell,\n  # it means the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:51:58.616231", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # 1. Get the integer index for the primitive.\n  # If the primitive name is not recognized in the cookbook, it cannot be collected.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    return []\n\n  # 2. Action integer mappings provided by the environment's action space.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping from (dx, dy) movement vector to the corresponding action index.\n  # This is used to reconstruct the path from BFS results.\n  dir_to_action = {\n      (0, -1): UP,    # Move UP (y decreases)\n      (0, 1): DOWN,   # Move DOWN (y increases)\n      (-1, 0): LEFT,  # Move LEFT (x decreases)\n      (1, 0): RIGHT,  # Move RIGHT (x increases)\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Define indices for entities that block agent movement.\n  # 'BOUNDARY' and 'WATER' are typically untraversable in CraftWorld.\n  IMPASSABLE_NAMES = ['BOUNDARY', 'WATER']\n  impassable_indices = {\n      cookbook.index[name] for name in IMPASSABLE_NAMES \n      if name in cookbook.index.contents # Ensure the name exists in the index\n  }\n\n  # Helper function to check if a given grid cell (x, y) is traversable by the agent.\n  # A cell is traversable if it is within the grid boundaries and does not contain any impassable entities.\n  def is_cell_traversable(x, y):\n      # Check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n\n      # Check if the cell contains any impassable objects.\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Cell contains an impassable object\n      return True\n\n  # Early exit: If the agent's current position is not traversable, it cannot move or act.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # 4. Check if the primitive is actually a grabbable item.\n  # The 'collect' action implies adding an item to the agent's inventory.\n  # Entities like WORKSHOPs, BOUNDARY, or WATER are not grabbable and cannot be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # 5. Check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the item, no further actions are needed to collect it.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # 6. Find all locations on the grid where the target primitive is present.\n  # `np.argwhere` returns coordinates (row, col) which correspond to (x, y) for grid[x, y, k].\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  # Early exit: If the primitive is not found anywhere on the grid, it cannot be collected.\n  if len(primitive_locations) == 0:\n    return []\n\n  # 7. Determine the set of target cells for the agent's movement.\n  # These are traversable cells from which the agent can successfully 'USE' the primitive.\n  # According to `CraftState.next_to`, this means any cell in the 3x3 neighborhood (including itself)\n  # around a primitive's location.\n  bfs_target_cells = set()\n  for px, py in primitive_locations: # (px, py) is a coordinate of a primitive instance\n    # Iterate through the 3x3 neighborhood around the primitive location (px, py).\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        tx, ty = px + dx_n, py + dy_n # (tx, ty) is a potential cell for the agent to stand on\n\n        # Only add a cell to the target set if it's within bounds and traversable by the agent.\n        if is_cell_traversable(tx, ty):\n          bfs_target_cells.add((tx, ty))\n\n  # Early exit: If no valid traversable target cells exist (e.g., the primitive is\n  # surrounded by impassable terrain), no path can be found.\n  if not bfs_target_cells:\n      return []\n\n  # 8. Perform Breadth-First Search (BFS) to find the shortest path from the agent's current position\n  # to any of the `bfs_target_cells`.\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(agent_pos, [])])\n  # The 'visited' set keeps track of (x,y) positions already processed to prevent cycles and redundant work.\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path_so_far = q.popleft()\n    \n    # If the current position is one of our `bfs_target_cells`, we have found the shortest path.\n    if current_pos in bfs_target_cells:\n      # Append the 'USE' action to the path and return the complete sequence.\n      return path_so_far + [USE]\n\n    # Explore valid neighboring cells in cardinal directions (UP, DOWN, LEFT, RIGHT).\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is traversable and has not been visited yet in this BFS.\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos) # Mark the new position as visited.\n        # Create a new path by appending the action required to move to `next_pos`.\n        new_path = path_so_far + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # 9. If the queue becomes empty and no path was found to any target cell,\n  # it means the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:52:51.302470", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # OPTIMIZATION: If the agent already has the primitive, no actions are needed to collect it.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get correct action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up (Y decreases)\n      (0, 1, ACTION_DOWN),   # Down (Y increases)\n      (-1, 0, ACTION_LEFT),  # Left (X decreases)\n      (1, 0, ACTION_RIGHT),  # Right (X increases)\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  impassable_kind_idx = cookbook.index['BOUNDARY'] if 'BOUNDARY' in cookbook.index.contents else None\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary.\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n    current_x, current_y = current_pos # Unpack for direct grid access and next_to logic\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      # Inlining CraftState.next_to logic to avoid object re-instantiation.\n      found_adjacent_primitive = False\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              nx, ny = current_x + dx_adj, current_y + dy_adj\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  if grid[nx, ny, primitive_idx] > 0: # Check if the primitive is in this cell\n                      found_adjacent_primitive = True\n                      break \n          if found_adjacent_primitive:\n              break \n      \n      if found_adjacent_primitive:\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if grid[current_x, current_y, primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_x + dx, current_y + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:52:52.471886", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # OPTIMIZATION: If the agent already has the primitive, no actions are needed to collect it.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get correct action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up (Y decreases)\n      (0, 1, ACTION_DOWN),   # Down (Y increases)\n      (-1, 0, ACTION_LEFT),  # Left (X decreases)\n      (1, 0, ACTION_RIGHT),  # Right (X increases)\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  # This makes the BFS avoid moving into these cells unless the goal itself is that primitive.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, or if the primitive itself is a boundary.\n  # For these, \"collection\" means simply reaching the cell where they are.\n  is_stationary_or_boundary_primitive = (\n      primitive_idx == env.world.water_index or \n      primitive_idx == env.world.stone_index or \n      (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx)\n  )\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_or_boundary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            # This logic ensures we can pathfind *to* a boundary if the goal is boundary, but not *through* it otherwise.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T02:53:37.836749", "function_name": "collect", "function_body": "  state = env._current_state # Get the current state of the environment.\n  world = env.world # Get the CraftWorld instance for item classifications.\n  cookbook = world.cookbook # Access the cookbook for item indices.\n  grid = state.grid # The current grid layout, which is static for the duration of this pathfinding.\n  \n  # 1. Resolve the primitive name to its integer index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook, it's an invalid target.\n    return []\n\n  # Cache action mappings for clarity and efficiency.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define different types of primitives based on how they are \"collected\".\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_workshop = primitive_idx in world.workshop_indices\n  # Stationary primitives are collected by simply being on their cell (e.g., water, stone, boundary).\n  is_stationary_primitive = (primitive_idx == world.water_index or \n                             primitive_idx == world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # Optimization: If the primitive is grabbable and already in inventory, no actions are needed.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Direction vectors: Maps agent's internal direction (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT)\n  # to (dx, dy) changes for calculating the cell in front.\n  # (dx, dy) = (change in x, change in y)\n  DIR_VECTORS = {\n      0: (0, -1), # UP: x stays, y decreases\n      1: (0, 1),  # DOWN: x stays, y increases\n      2: (-1, 0), # LEFT: x decreases, y stays\n      3: (1, 0)   # RIGHT: x increases, y stays\n  }\n\n  # BFS Initialization:\n  # The queue stores tuples: (current_position (x,y), current_direction, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(state.pos, state.dir, [])]) \n  \n  # The `visited` set tracks (position, direction) pairs to prevent redundant exploration\n  # and infinite loops, ensuring that each unique agent state (position + orientation) is processed once.\n  visited = {(state.pos, state.dir)} \n\n  # `min_path_len` and `best_path_actions` track the shortest complete path found so far.\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # BFS Loop: Explores states layer by layer to guarantee the shortest path.\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    # Pruning: If the current path length already equals or exceeds the shortest\n    # complete path found previously, this branch cannot lead to a shorter solution.\n    if len(current_actions) >= min_path_len:\n        continue # Skip processing this path and its descendants.\n\n    # --- Goal Check for the Current State ---\n    # Determine if the primitive can be collected from the `current_pos` and `current_dir`.\n    is_goal_condition_met = False\n    actions_to_finalize_collection = [] # Actions (e.g., USE) to complete collection if at target\n\n    if is_grabbable:\n      # For grabbable items, the agent must be adjacent to the item AND facing it, then USE.\n      dx, dy = DIR_VECTORS[current_dir]\n      fwd_x, fwd_y = current_pos[0] + dx, current_pos[1] + dy\n      \n      # Check if the cell in front is within grid boundaries and contains the primitive.\n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT:\n        if grid[fwd_x, fwd_y, primitive_idx] > 0:\n          is_goal_condition_met = True\n          actions_to_finalize_collection = [ACTION_USE] # 'USE' is the final action.\n\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundaries, \"collecting\" means simply being\n      # at the location of the primitive. No extra 'USE' action is needed.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_condition_met = True\n        actions_to_finalize_collection = [] # No additional actions.\n    \n    # If the goal condition is met from the current state, update the best path.\n    if is_goal_condition_met:\n      total_actions = current_actions + actions_to_finalize_collection\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # IMPORTANT: Do not `break` here. BFS finds the shortest path to a *state*.\n      # The goal (collecting the item) might be achievable from multiple states\n      # (e.g., different positions or directions), and a path that arrives at a\n      # particular state later might still lead to an overall shorter solution\n      # if it requires fewer final collection actions. We must continue exploring\n      # until `min_path_len` prunes all non-optimal paths.\n\n    # --- Explore Neighbors (Movement Actions) ---\n    # Try all four fundamental movement actions from the current state.\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # Simulate the effect of taking `action_type`. It's crucial to use `CraftState.step`\n      # because it correctly handles environmental interactions like collisions,\n      # boundary checks, and how the agent's position and direction change.\n      \n      # Create a temporary CraftState to simulate the step without altering the real env state.\n      temp_state_for_step = craft.CraftState(\n          state.scenario, state.grid, current_pos, current_dir, state.inventory\n      )\n      \n      # Execute the action on the temporary state. We only care about the new state, not reward.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir) # This represents the unique state for BFS.\n\n      # If this new (position, direction) state has not been visited,\n      # add it to the queue for future exploration and mark it as visited.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_actions + [action_type]))\n  \n  # After BFS completes, `best_path_actions` will contain the shortest sequence\n  # of actions to collect the primitive, or an empty list if no path was found.\n  return best_path_actions", "island_id": 1, "scores": {"3": 1.0}}
