{"timestamp": "2025-08-01T21:37:55.169676", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Initial checks:\n  # Ensure the target 'primitive' is actually a collectible resource defined in the cookbook's primitives.\n  # This filters out non-collectible environment features like WORKSHOPs or BOUNDARY.\n  if primitive_idx not in env.world.cookbook.primitives:\n      return [] # Not a collectible primitive resource according to the cookbook\n\n  # If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Format: action_id: (dr, dc, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), # Moving up makes agent face North (dir 0)\n      craft.RIGHT: (  0,  1, 1), # Moving right makes agent face East (dir 1)\n      craft.DOWN:  (  1,  0, 2), # Moving down makes agent face South (dir 2)\n      craft.LEFT:  (  0, -1, 3)  # Moving left makes agent face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for globally impassable terrains (like water and stone).\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles.\n      # Workshops are special non-grabbable entities that *are* walkable (agent can stand on them).\n      for idx in non_grabbable_indices:\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue # Already handled or are explicitly considered walkable.\n          \n          # If a cell contains any other non-grabbable item (not water, stone, or workshop), it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is considered walkable.\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the collection goal.\n      # For grabbable primitive resources, the agent needs to move onto the item's cell.\n      if primitive_idx in grabbable_indices:\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found to a grabbable item's location.\n      # For non-grabbable primitive resources (e.g., STONE, WATER source blocks),\n      # the agent needs to be adjacent to the item and facing it, then use the 'USE' action.\n      # This check only applies if primitive_idx is indeed a non-grabbable *resource*.\n      elif primitive_idx in non_grabbable_indices and primitive_idx in env.world.cookbook.primitives:\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check bounds for the cell in front\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the primitive, we can collect it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:37:56.403133", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Immediate Check: If the primitive is already in inventory (and is grabbable), we're done.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Format: action_id: (delta_row, delta_col, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), # Moving up makes agent face North (dir 0)\n      craft.RIGHT: (  0,  1, 1), # Moving right makes agent face East (dir 1)\n      craft.DOWN:  (  1,  0, 2), # Moving down makes agent face South (dir 2)\n      craft.LEFT:  (  0, -1, 3)  # Moving left makes agent face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  # This is used to check for non-grabbable items requiring a 'USE' action.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access and cleaner code.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Helper function to determine if a grid cell is traversable/walkable by the agent.\n  # This function is defined inside `collect_v2` to easily access `current_state` and `env.world` attributes.\n  def _is_walkable(r: int, c: int) -> bool:\n      # Check if coordinates are within grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for globally impassable terrains (e.g., deep water, large stone formations).\n      # Agent cannot walk onto cells containing these specific non-grabbable items.\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles that block movement.\n      # Workshops are special non-grabbable entities that *are* walkable (agent can stand on them).\n      for idx in non_grabbable_indices:\n          # Skip water, stone (already checked) and workshop indices (which are walkable).\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue \n          \n          # If the cell contains any other non-grabbable item that is *not* a workshop, it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      # If all checks pass, the cell is considered safe and traversable.\n      return True \n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction) as facing direction matters for 'USE' action.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  # BFS guarantees finding the shortest path to *any* instance of the primitive on the grid.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state (position and direction) allows collecting the primitive.\n      if primitive_idx in grabbable_indices:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Shortest path found to collect the grabbable item.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items (e.g., WORKSHOP0, WATER, STONE, GRASS), \n          # the agent typically needs to be adjacent to the item and use 'USE' action.\n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Ensure the cell in front is within grid boundaries.\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the target primitive, we can 'USE' it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Shortest path found, append the final USE action.\n\n      # Explore possible movement actions from the current state (r, c, current_dir).\n      for action_id, (dr, dc, new_facing_direction_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc # Calculate the next position after taking the action.\n\n          # Only explore if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              # The new state includes the new position and the new direction after the move.\n              next_state_tuple = (next_r, next_c, new_facing_direction_after_move)\n              \n              # If this next state hasn't been visited before, add it to the queue for exploration.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, new_facing_direction_after_move, path + [action_id]))\n\n  # If the BFS queue is exhausted and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:38:58.724180", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # Early exit: If the grabbable primitive is already in inventory, no actions are needed.\n  # Non-grabbable items are not typically \"in inventory\" in the same way, so this check\n  # specifically applies to grabbable resources.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions are 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT).\n  # Format: action_id: (row_change, col_change, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), # Move North (up in grid), agent faces North\n      craft.RIGHT: (  0,  1, 1), # Move East (right in grid), agent faces East\n      craft.DOWN:  (  1,  0, 2), # Move South (down in grid), agent faces South\n      craft.LEFT:  (  0, -1, 3)  # Move West (left in grid), agent faces West\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  # This is crucial for checking and interacting with non-grabbable items.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # Facing North (UP): cell is one row up\n      1: (0, 1),   # Facing East (RIGHT): cell is one col right\n      2: (1, 0),   # Facing South (DOWN): cell is one row down\n      3: (0, -1)   # Facing West (LEFT): cell is one col left\n  }\n\n  # Pre-compute and cache sets for efficient lookups of different entity types.\n  # These sets remain constant for the duration of the pathfinding.\n  # Items that are inherently impassable terrain.\n  impassable_terrain_indices = {env.world.water_index, env.world.stone_index}\n  # Workshop indices are non-grabbable but agents can walk onto their cells.\n  walkable_non_grabbable_indices = set(env.world.workshop_indices) \n  \n  # Helper function to determine if a given grid cell (r, c) is walkable by the agent.\n  # A cell is walkable if it's within grid boundaries and doesn't contain any impassable entity.\n  def _is_walkable(r: int, c: int) -> bool:\n      # Check if the cell is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for universally impassable terrain (e.g., water, stone).\n      # If the cell contains any of these, it's not walkable.\n      for idx in impassable_terrain_indices:\n          if current_state.grid[r, c, idx] == 1:\n              return False\n\n      # Check for other non-grabbable entities that might block movement.\n      # We explicitly exclude entities already checked (impassable_terrain_indices)\n      # and those that are walkable despite being non-grabbable (e.g., workshops).\n      for idx in env.world.non_grabbable_indices:\n          if idx in impassable_terrain_indices or idx in walkable_non_grabbable_indices:\n              continue # These are already handled or explicitly considered walkable.\n          \n          # If the cell contains any other non-grabbable item (not water, stone, or workshop),\n          # it is considered an obstacle and thus not walkable.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # The cell is considered safe and walkable.\n\n  # Initialize BFS queue with the agent's current state:\n  # Each element in the queue is a tuple: (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is uniquely defined by (row, col, current_facing_direction).\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Goal Check: Determine if the current state satisfies the condition for collecting the primitive.\n      if primitive_idx in env.world.grabbable_indices:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n          # If the current cell (r, c) contains the primitive, we've found it.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Return the sequence of movements to reach the item.\n      elif primitive_idx in env.world.non_grabbable_indices:\n          # For non-grabbable items (e.g., STONE, WORKSHOP0), the agent needs to be adjacent to the item\n          # and facing it, then use the 'USE' action to interact with/collect it.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check bounds for the cell directly in front of the agent.\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the target primitive, we can collect it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Append the USE action and return the complete path.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, new_facing_dir) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n          next_state_tuple = (next_r, next_c, new_facing_dir)\n\n          # Check if the next cell is valid and walkable, and if this state hasn't been visited.\n          if _is_walkable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              # Add the new state to the queue along with the extended action path.\n              q.append((next_r, next_c, new_facing_dir, path + [action_id]))\n\n  # If the BFS completes and no path was found to the primitive, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:39:00.012724", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Pre-check: If the primitive is already in inventory and is a grabbable item,\n  # no actions are needed to collect it.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Format: action_id: (dr, dc, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), \n      craft.RIGHT: (  0,  1, 1),\n      craft.DOWN:  (  1,  0, 2),\n      craft.LEFT:  (  0, -1, 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check for globally impassable terrains (like water and stone).\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable obstacles.\n      # Workshops are special non-grabbable entities that *are* walkable (agent can stand on them).\n      # If a cell contains any other non-grabbable item (not water, stone, or workshop), it's blocked.\n      for idx in non_grabbable_indices:\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue \n          \n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      return True # Cell is considered walkable.\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  # The goal check is designed to find *any* instance of the primitive.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the collection goal.\n      if primitive_idx in grabbable_indices:\n          # For grabbable items, the agent needs to move onto the item's cell.\n          # If the current cell (r, c) contains the primitive, we've reached it.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found to a grabbable item's location.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items, the agent needs to be adjacent to the item\n          # and facing it, then use the 'USE' action.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check bounds for the cell in front\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the primitive, we can collect it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:39:42.753930", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n  \n  # Get the index for water, which is explicitly defined as an impassable entity.\n  water_idx = env.world.water_index\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # V2 Improvement: Check if the next position is blocked by impassable terrain.\n      # In CraftWorld, water is an explicit impassable entity.\n      if grid[next_x, next_y, water_idx] > 0:\n        continue # This cell contains water, so it's not walkable.\n      \n      # Future improvements might consider other non_grabbable_indices that are not workshops\n      # as obstacles, but for V2, water is the primary explicit obstacle.\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:39:44.018736", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` by incorporating obstacle avoidance.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get indices of non-walkable entities from the cookbook's environment set.\n  # These are assumed to be obstacles that block movement.\n  blocking_entities = env.world.cookbook.environment \n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # NEW IMPROVEMENT FOR V2: Check for obstacles at next_pos\n      is_blocked = False\n      # Find all kinds present at the next position\n      kinds_at_next_pos = np.where(grid[next_x, next_y] > 0)[0] \n      \n      # Check if any of the kinds at next_pos are in the set of blocking entities\n      for kind_present in kinds_at_next_pos:\n          if kind_present in blocking_entities:\n              is_blocked = True\n              break\n      \n      if is_blocked:\n          continue # Do not add blocked cell to queue\n\n      # If not visited and not blocked, add to queue\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:40:54.062764", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  \n  # Agent's current position (x, y) where x is column index, y is row index.\n  # This matches the grid's shape convention: grid[x_idx, y_idx, kind_idx].\n  initial_pos_x, initial_pos_y = current_state.pos \n  \n  # Agent's current direction (0:North, 1:East, 2:South, 3:West)\n  initial_dir = current_state.dir   \n  \n  grid = current_state.grid\n  \n  # Grid dimensions are WIDTH, HEIGHT, n_kinds.\n  # So, grid.shape[0] is WIDTH, grid.shape[1] is HEIGHT.\n  grid_width, grid_height, _ = grid.shape\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for movement and direction logic consistent with CraftState internals.\n  # _action_to_delta: maps a move action index (0-3) to its (dx, dy) change in position.\n  # dx: change in column, dy: change in row.\n  _action_to_delta = {\n      ACTION_UP: (0, -1),    # Move agent up (y decreases, x no change)\n      ACTION_DOWN: (0, 1),   # Move agent down (y increases, x no change)\n      ACTION_LEFT: (-1, 0),  # Move agent left (x decreases, y no change)\n      ACTION_RIGHT: (1, 0),  # Move agent right (x increases, y no change)\n  }\n  # _action_to_dir: maps a move action index (0-3) to the agent's resulting direction (0-3).\n  # CraftState.dir: 0:North (-Y), 1:East (+X), 2:South (+Y), 3:West (-X).\n  _action_to_dir = {\n      ACTION_UP: 0,    # UP action sets direction to North (0)\n      ACTION_DOWN: 2,  # DOWN action sets direction to South (2)\n      ACTION_LEFT: 3,  # LEFT action sets direction to West (3)\n      ACTION_RIGHT: 1, # RIGHT action sets direction to East (1)\n  }\n  # _dir_to_delta: maps a direction index (0-3) to the (dx, dy) offset of the cell directly in front.\n  _dir_to_delta = {\n      0: (0, -1), # North: cell at (x, y-1)\n      1: (1, 0),  # East: cell at (x+1, y)\n      2: (0, 1),  # South: cell at (x, y+1)\n      3: (-1, 0), # West: cell at (x-1, y)\n  }\n\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it cannot be collected.\n    return []\n\n  # Determine if the primitive requires a USE action (i.e., it's a grabbable resource).\n  # Primitives that can be picked up are explicitly listed in `world.cookbook.primitives`.\n  requires_use_action = (primitive_idx in world.cookbook.primitives)\n\n  # Get indices of non-grabbable items which act as obstacles for movement.\n  # The agent cannot move into cells containing these.\n  non_grabbable_obstacle_indices = world.non_grabbable_indices\n\n  # BFS Queue: stores tuples of ((current_x, current_y, current_dir), list_of_actions_taken_to_reach_here)\n  q = collections.deque([((initial_pos_x, initial_pos_y, initial_dir), [])])\n  \n  # Visited set: stores (x, y, direction) tuples to prevent redundant exploration and cycles.\n  visited = {(initial_pos_x, initial_pos_y, initial_dir)}\n\n  while q:\n    (current_x, current_y, current_dir), path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current (x, y, current_dir) state.\n    # This means the cell directly in front of the agent must contain the primitive.\n    dx_face, dy_face = _dir_to_delta[current_dir]\n    target_cell_x, target_cell_y = current_x + dx_face, current_y + dy_face\n\n    # Check if the target cell is within grid boundaries.\n    if 0 <= target_cell_x < grid_width and 0 <= target_cell_y < grid_height:\n      # Check if the target cell actually contains the primitive.\n      # grid[x, y, kind]\n      if grid[target_cell_x, target_cell_y, primitive_idx] > 0:\n        # Found a state from which the primitive can be collected.\n        if requires_use_action:\n          # If it's a grabbable resource (e.g., WOOD, STONE), append the USE action and return the full path.\n          return path + [ACTION_USE]\n        else:\n          # If it's a non-grabbable entity (e.g., WORKSHOP, WATER, BOUNDARY),\n          # simply reaching this position and facing it is considered \"collected\" according to the DSL's concept.\n          # No USE action is appended as it's not \"picked up\".\n          return path\n\n    # 2. Explore next states by taking valid move actions (UP, DOWN, LEFT, RIGHT).\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dx_move, dy_move = _action_to_delta[action_idx]\n      next_x, next_y = current_x + dx_move, current_y + dy_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move action.\n\n      # Check if the new agent position is within grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue # Out of bounds.\n\n      # Check if the new agent position contains any obstacle (non-grabbable item).\n      # The agent cannot move into a cell that contains an obstacle.\n      is_obstacle = False\n      for obstacle_kind_idx in non_grabbable_obstacle_indices:\n        # If the cell at (next_x, next_y) has any quantity of an obstacle kind, it's an obstacle.\n        if grid[next_x, next_y, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break # Found an obstacle, cannot move here.\n      \n      if is_obstacle:\n        continue # Skip this cell, it's an obstacle.\n\n      next_state_key = (next_x, next_y, next_dir)\n      # If this new state (position + direction) hasn't been visited yet, add it to the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:40:55.294764", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  pos_x, pos_y = current_state.pos # Agent's current (col, row)\n  initial_dir = current_state.dir   # Agent's current direction (0:N, 1:E, 2:S, 3:W)\n  grid = current_state.grid         # Grid is (WIDTH, HEIGHT, n_kinds)\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for movement and direction logic based on CraftState internals\n  # _action_to_delta: maps a move action index (0-3) to its (dx, dy) change in position\n  # CraftState's position is (x, y) where x is column, y is row.\n  _action_to_delta = {\n      ACTION_UP: (0, -1),    # x: no change, y: -1 (move up means decrease y)\n      ACTION_DOWN: (0, 1),   # x: no change, y: +1 (move down means increase y)\n      ACTION_LEFT: (-1, 0),  # x: -1, y: no change (move left means decrease x)\n      ACTION_RIGHT: (1, 0),  # x: +1, y: no change (move right means increase x)\n  }\n  # _action_to_dir: maps a move action index (0-3) to the agent's resulting direction (0-3)\n  # CraftState.dir: 0:North, 1:East, 2:South, 3:West\n  _action_to_dir = {\n      ACTION_UP: 0,    # UP action sets direction to North (0)\n      ACTION_DOWN: 2,  # DOWN action sets direction to South (2)\n      ACTION_LEFT: 3,  # LEFT action sets direction to West (3)\n      ACTION_RIGHT: 1, # RIGHT action sets direction to East (1)\n  }\n  # _dir_to_delta: maps a direction index (0-3) to the (dx, dy) offset of the cell in front\n  _dir_to_delta = {\n      0: (0, -1), # North: cell above (y decreases)\n      1: (1, 0),  # East: cell to the right (x increases)\n      2: (0, 1),  # South: cell below (y increases)\n      3: (-1, 0), # West: cell to the left (x decreases)\n  }\n\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it cannot be collected.\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT, Kinds)\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Determine if the primitive requires a USE action (i.e., it's a grabbable resource)\n  requires_use_action = (primitive_idx in world.cookbook.primitives)\n\n  # Get indices of non-grabbable items which act as obstacles for movement.\n  # Agent cannot move into cells containing these.\n  non_grabbable_obstacle_indices = world.non_grabbable_indices\n\n  # BFS Queue: stores tuples of ((current_x, current_y, direction), list_of_actions_taken)\n  q = collections.deque([((pos_x, pos_y, initial_dir), [])])\n  \n  # Visited set: stores (x, y, direction) tuples to prevent redundant exploration and cycles\n  visited = {(pos_x, pos_y, initial_dir)}\n\n  while q:\n    (x, y, current_dir), path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current (x, y, current_dir) state.\n    # This means the cell directly in front of the agent must contain the primitive.\n    dx_face, dy_face = _dir_to_delta[current_dir]\n    target_cell_x, target_cell_y = x + dx_face, y + dy_face\n\n    # Check if the target cell is within grid boundaries\n    if 0 <= target_cell_x < GRID_WIDTH and 0 <= target_cell_y < GRID_HEIGHT:\n      # Check if the target cell actually contains the primitive\n      # Grid indexing is (x, y, kind_idx)\n      if grid[target_cell_x, target_cell_y, primitive_idx] > 0:\n        # Found a state from which the primitive can be collected.\n        if requires_use_action:\n          # If it's a grabbable resource, append the USE action and return the full path.\n          return path + [ACTION_USE]\n        else:\n          # If it's a non-grabbable entity (e.g., workshop, water, boundary),\n          # just reaching this position and facing it is considered \"collecting\".\n          # No USE action is appended.\n          return path\n\n    # 2. Explore next states by taking valid move actions (UP, DOWN, LEFT, RIGHT)\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dx_move, dy_move = _action_to_delta[action_idx]\n      next_x, next_y = x + dx_move, y + dy_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move action\n\n      # Check if the new agent position is within grid boundaries\n      if not (0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT):\n        continue # Out of bounds\n\n      # Check if the new agent position contains any obstacle (non-grabbable item).\n      # The agent cannot move into a cell that contains an obstacle.\n      is_obstacle = False\n      for obstacle_kind_idx in non_grabbable_obstacle_indices:\n        # If the cell at (next_x, next_y) has any quantity of an obstacle kind, it's an obstacle.\n        # Grid indexing is (x, y, kind_idx)\n        if grid[next_x, next_y, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break # Found an obstacle, cannot move here\n      \n      if is_obstacle:\n        continue # Skip this cell, it's an obstacle\n\n      next_state_key = (next_x, next_y, next_dir)\n      # If this new state (position + direction) hasn't been visited yet, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:41:28.081948", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` that accounts for non-walkable terrain.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # Check if the agent is already adjacent to the primitive\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions\n\n  best_path_to_adjacent = None\n\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  # Get indices of non-grabbable items that should be treated as obstacles\n  # We assume that items in non_grabbable_indices are impassable for movement.\n  impassable_indices = env.world.non_grabbable_indices\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break\n    \n    if best_path_to_adjacent:\n      break\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited\n      if next_pos in visited:\n        continue\n\n      # NEW: Check if the next position contains an impassable item\n      is_walkable = True\n      for obstacle_idx in impassable_indices:\n        if grid[next_x, next_y, obstacle_idx] > 0: # If an obstacle is present in this cell\n          is_walkable = False\n          break\n      \n      if not is_walkable:\n        continue # Cannot move to this cell if it contains an obstacle\n\n      visited.add(next_pos)\n      new_path = path + [action_idx]\n      q.append((next_pos, new_path))\n  \n  # If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:41:29.376384", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` that considers non-walkable terrain.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  state = env._current_state\n  actions = []\n\n  # Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Identify non-walkable indices based on the environment's non_grabbable_indices.\n  # These are entities that the agent cannot move onto (e.g., water, walls, workshops).\n  non_walkable_indices = env.world.non_grabbable_indices\n\n  # Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # to any cell that is adjacent to any instance of the primitive.\n  # Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    # If yes, this path leads to a cell from which the primitive can be 'used'.\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position contains any non-walkable items.\n      # A cell is considered non-walkable if it contains any item whose index\n      # is in the `non_walkable_indices` set.\n      is_walkable = True\n      for non_walkable_idx in non_walkable_indices:\n          # If the cell contains this non-walkable item, it's an obstacle\n          if grid[next_x, next_y, non_walkable_idx] > 0:\n              is_walkable = False\n              break\n      \n      if not is_walkable:\n          continue # Skip this cell, as it's an obstacle\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T21:42:27.550999", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      return []\n\n  # Check if the primitive is already in the agent's inventory. If so, no collection actions are needed.\n  state = env._current_state\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # The 'collect' function implies obtaining the item in inventory.\n  # If the primitive is not in the set of items that can be picked up (grabbable),\n  # it cannot be \"collected\" in the sense of adding to inventory.\n  # Examples like BOUNDARY, WATER, WORKSHOP0 are in the DSL's 'primitive' list\n  # but are not designed to be picked up by the agent.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve current state information for pathfinding.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs for BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),\n      ((0, -1), UP_ACTION),\n      ((-1, 0), LEFT_ACTION),\n      ((1, 0), RIGHT_ACTION),\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is adjacent to the target primitive.\n  # The 'USE' action in CraftWorld typically works on items in the 3x3 neighborhood.\n  queue = collections.deque([(agent_pos, [])]) # Stores (current_position, path_taken_to_reach_here).\n  visited = {agent_pos} # Set of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. This allows for the 'USE' action.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # A cell is considered \"adjacent\" if it's within 1 unit of Manhattan distance\n          # in both x and y, forming a 3x3 square (including the center).\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement path + use action).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is not explicitly defined as traversable (e.g., workshops, water).\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this cell...\n                  if k_idx in env.world.non_grabbable_indices and\\\n                     k_idx not in env.world.workshop_indices and\\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # This cell is blocked by an impassable object.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position given the current grid.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T21:42:28.649426", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T21:43:39.957531", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Define indices for impassable terrain.\n  # Based on common grid-world conventions, BOUNDARY and WATER typically block movement.\n  # Workshops are usually traversable.\n  IMPASSABLE_NAMES = ['BOUNDARY', 'WATER']\n  impassable_indices = {\n      cookbook.index[name] for name in IMPASSABLE_NAMES \n      if name in cookbook.index.contents\n  }\n\n  # Helper function to check if a cell is traversable.\n  # A cell is traversable if it's within bounds and does not contain any impassable entity.\n  def is_cell_traversable(x, y):\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Contains an impassable object\n      return True\n\n  # Check if the agent's starting position is traversable. If not, no path is possible.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any traversable cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        \n        # A potential target cell must be within grid bounds AND traversable by the agent\n        if is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no valid traversable target cells exist, no path is possible\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # If the current position is one of our valid target cells, we found the shortest path.\n    if current_pos in bfs_target_cells:\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries, is traversable, and hasn't been visited\n      if is_cell_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.5}}
