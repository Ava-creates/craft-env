{"timestamp": "2025-08-02T00:04:21.766730", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # Get current state details\n  current_state = env._current_state\n  \n  # Improvement for collect_v2:\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Grid and position details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # This function checks the static grid for the primitive's location relative to check_pos\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:04:23.102705", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # This function checks the static grid for the primitive's location relative to check_pos\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:04:58.282791", "function_name": "collect", "function_body": "  # Get the integer index for the target primitive from the environment's cookbook.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  state = env._current_state\n\n  # If the agent already has at least one of the primitive, no collection actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # If the primitive is not in the set of grabbable items, it cannot be \"collected\" via USE.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape # Dimensions of the grid.\n\n  # Get the integer action mappings for movement (UP, DOWN, LEFT, RIGHT) and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas (dx, dy) and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one step down (increase y).\n      ((0, -1), UP_ACTION),   # Move one step up (decrease y).\n      ((-1, 0), LEFT_ACTION), # Move one step left (decrease x).\n      ((1, 0), RIGHT_ACTION), # Move one step right (increase x).\n  ]\n\n  # Define specific non-grabbable entities that the agent can traverse (e.g., workshops, water).\n  # These are exceptions to the general rule that non-grabbables block movement.\n  traversable_non_grabbables = set(env.world.workshop_indices)\n  if env.world.water_index is not None:\n      traversable_non_grabbables.add(env.world.water_index)\n\n  # Helper function to check if a given grid cell (x, y) is traversable by the agent.\n  # A cell is considered traversable if it's within grid boundaries and does not\n  # contain any non-grabbable entities that are not workshops or water.\n  def _is_traversable(x: int, y: int) -> bool:\n      # First, check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False # Out of bounds.\n\n      # Iterate through all possible kinds of entities in the environment at (x,y).\n      kinds_at_cell = np.where(grid[x, y] > 0)[0]\n      for k_idx in kinds_at_cell:\n          # A cell is considered impassable if it contains any non-grabbable\n          # entity that is NOT in our set of traversable non-grabbables.\n          if k_idx in env.world.non_grabbable_indices and k_idx not in traversable_non_grabbables:\n              return False # This cell contains an impassable obstacle.\n      return True # If no obstacles are found, the cell is traversable.\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # The `visited` set keeps track of positions already explored to prevent cycles\n  # and redundant computations, ensuring the shortest path.\n  visited = {agent_pos} \n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos # Current agent's x, y coordinates.\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. The 'USE' action typically\n      # applies to entities in the agent's 3x3 neighborhood (including current cell).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # Check if the current position (cx, cy) is within 1 unit (Manhattan distance)\n          # of a primitive location (px, py). This covers the 3x3 neighborhood.\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break # Found an adjacent primitive, no need to check other locations.\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action to the path\n          # and return the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if _is_traversable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:04:59.415569", "function_name": "collect", "function_body": "  # Helper function to check if a given grid cell (x, y) is traversable by the agent.\n  # A cell is considered traversable if it's within grid boundaries and does not\n  # contain any non-grabbable entities that are not workshops or water.\n  def _is_traversable(x: int, y: int, grid: np.ndarray, world_data: craft.CraftWorld) -> bool:\n      grid_width, grid_height, num_kinds = grid.shape\n\n      # First, check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False # Out of bounds\n\n      # Iterate through all possible kinds of entities in the environment.\n      for k_idx in range(num_kinds):\n          # If there's an entity of kind k_idx present at this cell (x, y).\n          if grid[x, y, k_idx] > 0:\n              # A cell is considered impassable if it contains any non-grabbable\n              # entity that is NOT a workshop and NOT water. These are specific\n              # exceptions for typically traversable or interactable non-grabbables.\n              if k_idx in world_data.non_grabbable_indices and\\\n                 k_idx not in world_data.workshop_indices and\\\n                 k_idx != world_data.water_index:\n                  return False # This cell contains an impassable obstacle.\n      return True # If no obstacles are found, the cell is traversable.\n\n  # Get the integer index for the target primitive from the environment's cookbook.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook,\n      # so no actions can be taken to collect it.\n      return []\n\n  state = env._current_state\n  # If the agent already has at least one of the primitive, no collection actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # The 'collect' function is designed for items that go into the agent's inventory.\n  # If the primitive is not in the set of grabbable items, it cannot be \"collected\" this way.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve current state information necessary for pathfinding.\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape # Dimensions of the grid.\n\n  # Get the integer action mappings for movement (UP, DOWN, LEFT, RIGHT) and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas (dx, dy) and their corresponding action IDs.\n  # These are used for exploring neighboring cells during the Breadth-First Search (BFS).\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one step down (increase y).\n      ((0, -1), UP_ACTION),   # Move one step up (decrease y).\n      ((-1, 0), LEFT_ACTION), # Move one step left (decrease x).\n      ((1, 0), RIGHT_ACTION), # Move one step right (increase x).\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  # This helps in determining potential targets for collection.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # The `visited` set keeps track of positions already explored to prevent cycles\n  # and redundant computations, ensuring the shortest path.\n  visited = {agent_pos} \n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos # Current agent's x, y coordinates.\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. The 'USE' action typically\n      # applies to entities in the agent's 3x3 neighborhood (including current cell).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          # Check if the current position (cx, cy) is within 1 unit (Manhattan distance)\n          # of a primitive location (px, py). This covers the 3x3 neighborhood.\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break # Found an adjacent primitive, no need to check other locations.\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action to the path\n          # and return the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Use the helper function to determine if the next cell is traversable.\n          # This combines boundary checking and obstacle checking.\n          if not _is_traversable(next_x, next_y, grid, env.world):\n              continue # Skip this path if the cell is blocked or out of bounds.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:05:57.000334", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Determine if the primitive is grabbable (i.e., can be held in inventory).\n  # Grabbable items are things like WOOD, IRON, GRASS, etc.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Optimization: If the primitive is grabbable and already in inventory, \n  # no collection actions are needed. The item is already \"collected\".\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine other properties of the target primitive for goal checking.\n  # Workshops (WORKSHOP0, WORKSHOP1, WORKSHOP2) and stationary environmental \n  # features (WATER, STONE, BOUNDARY) are not grabbable, and 'collecting' them\n  # means reaching their location, not picking them up with 'USE'.\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS setup\n  # Queue stores tuples: (current_position, current_direction, list_of_actions_to_reach_here)\n  # Agent's direction is crucial because the 'USE' action is direction-sensitive for grabbable items.\n  q = collections.deque([(state.pos, state.dir, [])]) \n  # Visited set now tracks (position, direction) pairs to avoid redundant exploration and cycles.\n  visited = {(state.pos, state.dir)} \n\n  min_path_len = float('inf')\n  best_path_actions = []\n\n  # BFS loop\n  while q:\n    current_pos, current_dir, current_actions = q.popleft()\n\n    # Check if this (current_pos, current_dir) state allows for goal completion\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD), the agent needs to be facing the item and then USE.\n      # Calculate the cell coordinates directly in front of the agent based on current_dir.\n      fwd_x, fwd_y = current_pos\n      if current_dir == 0: # UP\n        fwd_y -= 1\n      elif current_dir == 1: # DOWN\n        fwd_y += 1\n      elif current_dir == 2: # LEFT\n        fwd_x -= 1\n      elif current_dir == 3: # RIGHT\n        fwd_x += 1\n      \n      # Check if the cell in front is within grid bounds and contains the primitive\n      if 0 <= fwd_x < WIDTH and 0 <= fwd_y < HEIGHT:\n        if grid[fwd_x, fwd_y, primitive_idx] > 0:\n          is_goal_reached = True\n          actions_to_complete_goal = [ACTION_USE] # Appending USE action to complete collection\n\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell where the agent is.\n      if grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, update the best path found so far.\n    # We continue the BFS even after finding a goal to ensure we find the globally shortest path,\n    # as a path that arrives at a goal cell later might require fewer final actions (e.g., if already facing correctly).\n    if is_goal_reached:\n      total_actions = current_actions + actions_to_complete_goal\n      if len(total_actions) < min_path_len:\n        min_path_len = len(total_actions)\n        best_path_actions = total_actions\n      # Do NOT return here. Continue BFS to find the truly shortest path.\n\n    # Explore neighbors by simulating movement actions (UP, DOWN, LEFT, RIGHT).\n    # Each movement potentially changes both position and direction.\n    for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      # Create a temporary CraftState reflecting the current BFS node's (pos, dir).\n      # The grid and inventory remain constant during pathfinding on the current map.\n      temp_state_for_step = craft.CraftState(\n          state.scenario, state.grid, current_pos, current_dir, state.inventory\n      )\n      \n      # Perform the movement action on the temporary state to get the new position and direction.\n      # The reward is not relevant for pathfinding, only the resulting new_state.\n      _, new_temp_state = temp_state_for_step.step(action_type)\n      \n      new_pos = new_temp_state.pos\n      new_dir = new_temp_state.dir\n\n      new_state_tuple = (new_pos, new_dir)\n\n      # If this new (position, direction) state has not been visited, add it to the queue.\n      if new_state_tuple not in visited:\n        visited.add(new_state_tuple)\n        q.append((new_pos, new_dir, current_actions + [action_type]))\n  \n  return best_path_actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-02T00:05:58.185856", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-02T00:07:14.876265", "function_name": "collect", "function_body": "  # Helper function to check if a position (x, y) is \"next to\" a given kind_idx on the grid.\n  # \"Next to\" means the kind_idx is present in the 3x3 neighborhood around (check_x, check_y),\n  # including the cell (check_x, check_y) itself.\n  def _is_next_to_kind(check_x: int, check_y: int, kind_idx: int, current_grid: np.ndarray) -> bool:\n      grid_width, grid_height, _ = current_grid.shape\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = check_x + dx, check_y + dy\n              # Ensure the neighbor is within grid boundaries\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # Check if the target kind is present at the neighbor cell\n                  if current_grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  # Helper function to determine if a specific 'kind' at a cell acts as an obstacle for movement.\n  def _is_obstacle_kind(kind_idx_at_cell: int, target_primitive_idx: int, world_config: craft.CraftWorld) -> bool:\n      # If the kind at the cell is the target primitive itself, it's generally traversable.\n      # Agent can either move onto it (if grabbable) or move past it.\n      if kind_idx_at_cell == target_primitive_idx:\n          return False\n      \n      # Check if the kind is in the set of non-grabbable entities.\n      if kind_idx_at_cell in world_config.non_grabbable_indices:\n          # Some non-grabbable entities like workshops or water are specifically traversable.\n          if kind_idx_at_cell in world_config.workshop_indices or \\\n             kind_idx_at_cell == world_config.water_index:\n              return False  # These specific non-grabbables are traversable.\n          else:\n              # Other non-grabbable entities are considered impassable obstacles (e.g., solid walls).\n              return True\n      \n      # Any other kind (typically grabbable items like wood, iron) is considered traversable.\n      return False\n\n  # 1. Get the integer index for the primitive from the cookbook.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # Primitive name not recognized by the environment.\n      return []\n\n  # 2. Get the current state information.\n  state = env._current_state\n  initial_pos = state.pos\n  grid = state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get the integer action mappings.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down, action_id\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up, action_id\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left, action_id\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right, action_id\n  ]\n\n  # 4. Use Breadth-First Search (BFS) to find the shortest sequence of movement actions\n  #    to reach a position from which the primitive can be \"used\" (collected).\n  # BFS queue stores (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(initial_pos, [])])\n  # Set to keep track of visited positions to prevent infinite loops.\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is valid for 'USE' action on the primitive.\n      # This means the primitive is within the 3x3 neighborhood of the agent.\n      if _is_next_to_kind(cx, cy, primitive_idx, grid):\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four cardinal neighboring cells.\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell contains an impassable obstacle.\n          is_impassable = False\n          # Iterate through all possible kinds that might be present at the next cell.\n          for k_idx in range(grid.shape[2]):\n              # If a specific kind is present at the next cell, check if it's an obstacle.\n              if grid[next_x, next_y, k_idx] > 0:\n                  if _is_obstacle_kind(k_idx, primitive_idx, env.world):\n                      is_impassable = True\n                      break # Found an obstacle, no need to check other kinds in this cell.\n          \n          if is_impassable:\n              continue # Skip this path if the next cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path) # Create a new path list to avoid modifying shared lists.\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n  \n  # If the BFS completes and no path to collect the primitive is found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:07:16.136399", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This improved version refines the BFS pathfinding logic to ensure robust navigation\n    around obstacles and efficient collection of the target primitive. It prioritizes\n    shortest path to any cell from which the 'USE' action can be performed on the primitive.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect (e.g., \"WOOD\", \"STONE\").\n\n    Returns:\n        List[int]: A sequence of action indices to execute to collect the primitive.\n                   Returns an empty list if the primitive is not found or unreachable.\n  \"\"\"\n  # 1. Retrieve the integer ID for the target primitive from the cookbook's index\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized, it cannot be collected\n      return []\n\n  # 2. Get the current state information needed for pathfinding\n  state = env._current_state\n  initial_pos = state.pos  # Agent's current (x, y) position\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Get the integer action mappings for movement and 'USE' from the environment\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas (dx, dy) and their corresponding action IDs\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move down\n      ((0, -1), UP_ACTION),   # Move up\n      ((-1, 0), LEFT_ACTION), # Move left\n      ((1, 0), RIGHT_ACTION), # Move right\n  ]\n\n  # 4. Identify all grid cells that contain the target primitive\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if the primitive kind exists at this cell\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If no instances of the primitive are found on the map, no actions are possible\n      return []\n\n  # 5. Use Breadth-First Search (BFS) to find the shortest path to a cell\n  #    from which the primitive can be 'USE'd. The 'USE' action works\n  #    if the agent is in the 3x3 neighborhood (including on the same cell)\n  #    as the target item.\n\n  # Queue stores (current_position, path_taken_to_reach_here)\n  queue = collections.deque([(initial_pos, [])])\n  # Set of visited positions to avoid cycles and redundant exploration\n  visited = {initial_pos}\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is within 'USE' range of any primitive location.\n      # This means the agent is on the primitive, or one square away (orthogonally or diagonally).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If a suitable position is found, append the 'USE' action and return the path\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four neighboring cells (UP, DOWN, LEFT, RIGHT)\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable.\n          # A cell is impassable if it contains certain non-grabbable entities\n          # that are not workshops or water (e.g., boundaries).\n          is_impassable = False\n          for k_idx in range(grid.shape[2]): # Iterate through all kinds present at the next cell\n              if grid[next_x, next_y, k_idx] > 0: # If something of kind k_idx is present\n                  if k_idx == primitive_idx:\n                      # If the cell contains the target primitive itself, it's always traversable;\n                      # the agent can move onto it to collect.\n                      pass \n                  elif k_idx in env.world.non_grabbable_indices:\n                      # For other non-grabbable entities:\n                      # Workshops and water are typically traversable or interactive points.\n                      if k_idx in env.world.workshop_indices or k_idx == env.world.water_index:\n                          pass # Allow movement onto these\n                      else:\n                          # Other non-grabbable entities (like solid boundaries/obstacles) block movement.\n                          is_impassable = True\n                          break # No need to check other kinds in this cell\n\n          if is_impassable:\n              continue # Skip this path if the cell is blocked by an obstacle\n\n          # If the cell is traversable and has not been visited yet, add it to the queue\n          if next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path) # Create a new path list to avoid modifying shared references\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:07:53.361949", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  # 1. Resolve the primitive name to its corresponding integer index.\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized by the environment's index,\n      # it cannot be collected.\n      return []\n\n  # 2. Crucial check: Verify if the primitive is designed to be 'grabbable'.\n  #    Only grabbable items can be directly added to the inventory via collection.\n  #    For example, 'WOOD' (trees) might not be grabbable, but 'PLANK' (produced from trees) is.\n  #    This function aims to put the `primitive` itself into inventory.\n  if primitive_idx not in env.world.grabbable_indices:\n      # If the item cannot be picked up or directly put into inventory using 'USE' action,\n      # this `collect` function is not applicable for it.\n      return []\n\n  # 3. Retrieve the current state of the environment.\n  state = env._current_state\n  agent_pos = state.pos  # Agent's current (x, y) grid coordinates.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # 4. Obtain the integer action mappings for movement and 'USE' from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs for BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # 5. Identify all grid cells where the target primitive is located.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0: # Check if the cell contains any amount of the primitive.\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not present anywhere on the grid, it cannot be collected.\n      return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path.\n  #    The queue stores tuples of (current_position, list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # Keep track of visited positions to prevent infinite loops in cycles and redundant paths.\n  visited = {agent_pos} \n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on top of) any primitive location.\n      # The 'USE' action typically operates on a 3x3 neighborhood around the agent.\n      # This matches the behavior of CraftState.next_to(i_kind).\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return the full path.\n          path.append(USE_ACTION)\n          return path\n\n      # Explore neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the valid grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is impassable if it contains a non-grabbable entity that is\n          # neither a workshop nor water (which are typically traversable points of interaction).\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # Check if any item kind is present at the cell.\n                  if k_idx in env.world.non_grabbable_indices and \\\n                     k_idx not in env.world.workshop_indices and \\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # Found an impassable obstacle; no need to check further kinds in this cell.\n          \n          if is_impassable:\n              continue # Skip this path; the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive was found,\n  # it means the primitive is currently unreachable from the agent's position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:07:54.482258", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # The requested primitive name is not recognized by the environment's cookbook.\n      # This means the item cannot exist in the environment or be collected.\n      return []\n\n  # The 'collect' function's objective is to obtain the item into the agent's inventory.\n  # This implies that the item must be 'grabbable' (i.e., can be picked up).\n  # If the primitive is not in the set of `grabbable_indices`, it cannot be directly\n  # 'collected' and placed into the inventory using the 'USE' action in this context.\n  # For example, a 'WOOD' block (tree) might be non-grabbable, but 'PLANK' is grabbable.\n  # To \"collect\" planks, one would typically use an axe on wood, which yields planks.\n  # So, `collect(\"WOOD\")` would be invalid if WOOD is not grabbable; one should `collect(\"PLANK\")`.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve the current state of the crafting environment.\n  state = env._current_state\n  agent_pos = state.pos  # The agent's current (x, y) coordinates.\n  grid = state.grid        # The current grid layout, a 3D NumPy array.\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Obtain the integer mappings for various actions from the environment's action specifications.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define the possible movements (deltas for x, y) and their corresponding action IDs.\n  # These are used in the Breadth-First Search (BFS) to explore neighboring cells.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # Move one step down (increase y).\n      ((0, -1), UP_ACTION),   # Move one step up (decrease y).\n      ((-1, 0), LEFT_ACTION), # Move one step left (decrease x).\n      ((1, 0), RIGHT_ACTION), # Move one step right (increase x).\n  ]\n\n  # Identify all cells on the grid that contain the target primitive.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell `(x, y)` has at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, it cannot be collected.\n  return [] if not primitive_locations else []\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is 'adjacent' to the target primitive.\n  # 'Adjacent' in this context means being within the 3x3 neighborhood, including the cell itself,\n  # which is where the 'USE' action becomes effective according to `CraftState.next_to`.\n  \n  # The queue stores tuples of (current_position, list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # The 'visited' set keeps track of positions already explored to prevent cycles and redundant computations.\n  visited = {agent_pos} \n\n  while queue:\n      current_pos, path_to_current = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to any of the primitive's locations.\n      # A cell is considered adjacent if its coordinates are within +/- 1 of a primitive's coordinates.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action as the final step\n          # and return the complete sequence of actions (movement path + use action).\n          path_to_current.append(USE_ACTION)\n          return path_to_current\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is NOT specifically a workshop or water, which are generally traversable.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's content of kind `k_idx` at `next_pos`.\n                  if k_idx in env.world.non_grabbable_indices and \\\n                     k_idx not in env.world.workshop_indices and \\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # This cell is blocked by an obstacle; no need to check other kinds.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path_to_current) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the BFS queue becomes empty and no path to an adjacent primitive location\n  # was found, it implies that the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T00:09:02.826877", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid # Current grid from the state\n  \n  # 1. Get the integer ID for the primitive\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Cache non_grabbable_indices for faster lookup.\n  # These are entities that block movement in CraftWorld's internal _is_walkable_at logic.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is walkable.\n  # This replicates CraftState's _is_walkable_at logic to ensure consistency with environment's movement rules.\n  def _is_cell_walkable(x, y):\n      # Check grid boundaries\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n      # Check if the cell contains any non-grabbable entity, which would make it impassable.\n      for i_kind in non_grabbable_indices:\n          if grid[x, y, i_kind] > 0:\n              return False\n      return True\n\n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` method to check for adjacency.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Goal check: For collection, the agent needs to be adjacent to the primitive.\n    # Then, a 'USE' action will be performed to interact with it.\n    if temp_state_at_pos.next_to(primitive_idx):\n      # If adjacent, we found a path. Append ACTION_USE to complete the collection.\n      return current_actions + [ACTION_USE]\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Only explore positions that are within bounds, walkable, and not yet visited.\n      if _is_cell_walkable(new_x, new_y):\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or no walkable path exists),\n  # return an empty list of actions.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T00:09:04.092455", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs\n  MOVES = [\n      (0, -1, ACTION_UP),    # Up\n      (0, 1, ACTION_DOWN),   # Down\n      (-1, 0, ACTION_LEFT),  # Left\n      (1, 0, ACTION_RIGHT),  # Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position\n  start_pos = state.pos\n\n  # Identify \"impassable\" kinds. Assume 'BOUNDARY' is an obstacle.\n  impassable_kind_idx = None\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_kind_idx = cookbook.index['BOUNDARY']\n\n  # BFS setup\n  # Queue stores tuples: (current_position, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles\n\n  # Determine properties of the target primitive for goal checking\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Check for special non-grabbable primitives like water, stone, boundary.\n  # Their \"collection\" means simply reaching the cell where they are.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             (impassable_kind_idx is not None and primitive_idx == impassable_kind_idx))\n  \n  # BFS loop\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState at the current BFS position.\n    # This allows us to use CraftState's `next_to` or check `grid` contents\n    # as if the agent were actually at `current_pos`.\n    # Agent's direction and inventory are kept constant as they don't affect pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if this `current_pos` represents a goal state for collecting the primitive\n    is_goal_reached = False\n    actions_to_complete_goal = []\n\n    if is_grabbable:\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then USE.\n      if temp_state_at_pos.next_to(primitive_idx):\n        is_goal_reached = True\n        actions_to_complete_goal = [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, water, stone, or boundary, \"collecting\" means reaching the location itself.\n      # Check if the target primitive is present at the current cell.\n      # Note: The grid stores counts, so > 0 means presence.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        is_goal_reached = True\n        actions_to_complete_goal = [] # No USE action is typically needed for these\n    \n    # If a goal state is reached, return the path immediately.\n    # For an unweighted graph, BFS guarantees the first path found to a goal state is the shortest.\n    if is_goal_reached:\n      return current_actions + actions_to_complete_goal\n\n    # Explore neighbors of the current position\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within grid boundaries\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check for obstacles: do not move into a 'BOUNDARY' cell unless we are specifically collecting 'BOUNDARY'.\n        is_impassable_obstacle = False\n        if impassable_kind_idx is not None:\n            # If the new position contains a 'BOUNDARY' and the target is NOT 'BOUNDARY', it's an obstacle.\n            if grid[new_x, new_y, impassable_kind_idx] > 0 and primitive_idx != impassable_kind_idx:\n                is_impassable_obstacle = True\n\n        if new_pos not in visited and not is_impassable_obstacle:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If BFS completes and no path is found (e.g., primitive is unreachable or blocked by obstacles)\n  return []", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:09:40.508869", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  # 1. Improvement for collect_v2:\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  current_state = env._current_state\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # 2. Check if the primitive is actually a grabbable item (from collect_v1).\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Grid and position details\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas for each action\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  # This function checks the static grid for the primitive's location relative to check_pos\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:09:41.793479", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive string is not known to the cookbook, it cannot be collected.\n    return []\n\n  current_state = env._current_state\n  # Improvement from collect_v1:\n  # Check if the primitive is already in the agent's inventory.\n  # If it is, no actions are needed to \"collect\" it, as it's already collected.\n  if current_state.inventory[primitive_idx] > 0:\n    return []\n\n  # From collect_v0:\n  # Check if the primitive is actually a grabbable item.\n  # The 'collect' function implies acquiring an item into inventory.\n  # If the primitive is marked as non-grabbable in the world configuration,\n  # it cannot be 'collected' in this manner, so no actions are returned.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  grid = current_state.grid\n  start_pos = current_state.pos\n  grid_width, grid_height, _ = grid.shape\n  # Cache the set of non-grabbable indices for efficient lookup in the BFS.\n  non_grabbable_indices_set = env.world.non_grabbable_indices \n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  MOVE_DELTAS = {\n      ACTION_UP: (0, -1),\n      ACTION_DOWN: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0)\n  }\n\n  # Helper function to check if a given position is next to (or on) the target primitive\n  def is_next_to_target(check_pos, target_idx, current_grid):\n    px, py = check_pos\n    # Check the 3x3 neighborhood around the current position\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the neighbor position is within grid boundaries\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          # If the target primitive is found in this neighbor cell, return True\n          # We check if the count of the primitive at (nx, ny, target_idx) is greater than 0\n          if current_grid[nx, ny, target_idx] > 0:\n            return True\n    return False\n\n  # Improvement for collect_v2: Helper function to check if a cell is traversable (not blocked by obstacles)\n  def is_traversable(x, y, current_grid):\n    # A cell is traversable if it's not occupied by any non-grabbable entity that acts as an obstacle.\n    # We iterate through all known non-grabbable indices. If any of these are present in the cell,\n    # it means the cell is an obstacle and cannot be moved into.\n    for k in non_grabbable_indices_set:\n      # If the cell (x, y) contains any non-grabbable item, it's not traversable.\n      if current_grid[x, y, k] > 0:\n        return False\n    return True\n\n  # Initialize BFS queue with the starting position and an empty path\n  q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n  # Keep track of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  # BFS loop\n  while q:\n    curr_pos, path = q.popleft()\n\n    # If the current position is next to (or on) the primitive, we've found a path\n    if is_next_to_target(curr_pos, primitive_idx, grid):\n      # Append the USE action and return the complete sequence of actions\n      return path + [ACTION_USE]\n\n    # Explore all possible moves from the current position\n    for action, delta in MOVE_DELTAS.items():\n      dx, dy = delta\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n      \n      # Improvement for collect_v2: Check if the next position is traversable (not an obstacle)\n      if not is_traversable(next_x, next_y, grid):\n          continue\n\n      # If the next position has not been visited, add it to the queue\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path is found (primitive is unreachable), return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T00:10:54.159416", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # Primitive name not recognized by the environment\n      return []\n\n  # Get the current state of the environment and its relevant attributes\n  state = env._current_state\n  initial_pos = state.pos  # Agent's current (x, y) position\n  initial_dir = state.dir  # Agent's current facing direction (0: N, 1: E, 2: S, 3: W)\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, n_kinds = grid.shape\n\n  # Get the integer action mappings for movement and 'USE'\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Map movement actions to their resulting (dx, dy) and new direction index\n  # (dx, dy) represents the change in position\n  # new_dir_idx represents the direction the agent will be facing after the move\n  move_action_details = {\n      UP_ACTION: ((0, -1), 0),  # Move North, face North (dir 0)\n      RIGHT_ACTION: ((1, 0), 1), # Move East, face East (dir 1)\n      DOWN_ACTION: ((0, 1), 2),  # Move South, face South (dir 2)\n      LEFT_ACTION: ((-1, 0), 3), # Move West, face West (dir 3)\n  }\n\n  # Map direction index to (dx, dy) for the cell directly in front of the agent\n  # This is used to determine which cell the USE action would apply to.\n  faced_deltas = {\n      0: (0, -1), # Facing North, cell in front is (x, y-1)\n      1: (1, 0),  # Facing East, cell in front is (x+1, y)\n      2: (0, 1),  # Facing South, cell in front is (x, y+1)\n      3: (-1, 0), # Facing West, cell in front is (x-1, y)\n  }\n\n  # Find all locations on the grid where the target primitive exists\n  primitive_locations = set() # Using a set for efficient lookup\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # Check if there's any amount of the primitive kind at this cell\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.add((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, no actions can be taken\n      return []\n\n  # BFS state: (current_x, current_y, current_direction_idx, path_list)\n  # Path_list stores the sequence of action IDs to reach this state.\n  queue = collections.deque([(initial_pos[0], initial_pos[1], initial_dir, [])])\n  # Visited states: (x, y, dir_idx) to avoid cycles and redundant exploration\n  visited = {(initial_pos[0], initial_pos[1], initial_dir)}\n\n  while queue:\n      cx, cy, current_dir, path = queue.popleft()\n\n      # First, check if the current state (position and direction) allows for immediate collection\n      # by performing a USE action.\n      faced_dx, faced_dy = faced_deltas[current_dir]\n      target_x, target_y = cx + faced_dx, cy + faced_dy\n\n      # Check if the faced cell is within grid boundaries and contains the primitive\n      if 0 <= target_x < grid_width and 0 <= target_y < grid_height:\n          if (target_x, target_y) in primitive_locations:\n              # If we are facing a cell with the primitive, we can USE it.\n              return path + [USE_ACTION]\n\n      # If USE is not immediately possible, explore possible movement actions\n      for action_id, ((dx, dy), new_dir) in move_action_details.items():\n          nx, ny = cx + dx, cy + dy  # New position after taking the action\n          next_state_tuple = (nx, ny, new_dir) # The complete state (pos + dir)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Determine if the next cell is impassable (acts as a wall/obstacle)\n          is_impassable = False\n          for k_idx in range(n_kinds): # Iterate through all entity kinds at the next cell\n              if grid[nx, ny, k_idx] > 0: # If something of kind k_idx is present at (nx,ny)\n                  if k_idx == primitive_idx:\n                      # If the cell contains the primitive itself, it's generally traversable.\n                      # Agent might walk onto it to interact or pass over it.\n                      pass\n                  elif k_idx in env.world.non_grabbable_indices:\n                      # Non-grabbable entities can be obstacles or interactive points.\n                      # CraftWorld specific logic: workshops and water are traversable/interactive.\n                      if k_idx in env.world.workshop_indices or k_idx == env.world.water_index:\n                          pass # Allow movement onto these specific non-grabbable types\n                      else:\n                          # Other non-grabbable entities are considered impassable obstacles\n                          is_impassable = True\n                          break\n          if is_impassable:\n              continue # Skip this path if the cell is blocked\n\n          # If the next state (position and direction) has not been visited, add it to the queue\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              # Add the current action to the path and enqueue the new state\n              queue.append((nx, ny, new_dir, path + [action_id]))\n\n  # If the BFS completes and no path to collect the primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T00:10:55.375743", "function_name": "collect", "function_body": "  # Helper function for checking if a cell is traversable.\n  def _is_traversable(x, y, grid, target_primitive_idx, world_config):\n      \"\"\"\n      Checks if a grid cell at (x, y) is traversable for the agent.\n      A cell is traversable if it's within bounds and doesn't contain an impassable obstacle.\n      \n      Args:\n          x (int): x-coordinate of the cell.\n          y (int): y-coordinate of the cell.\n          grid (np.ndarray): The current grid layout.\n          target_primitive_idx (int): The index of the primitive the agent is trying to collect.\n          world_config (CraftWorld): The CraftWorld instance for non-grabbable and workshop indices.\n      \n      Returns:\n          bool: True if the cell is traversable, False otherwise.\n      \"\"\"\n      grid_width, grid_height, _ = grid.shape\n      \n      # 1. Check boundary conditions\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False # Out of bounds\n\n      # 2. Check for impassable obstacles at the cell (x, y)\n      # Iterate through all kinds present at (x, y)\n      for k_idx in range(grid.shape[2]):\n          if grid[x, y, k_idx] > 0: # If something of kind k_idx is present at this cell\n              if k_idx == target_primitive_idx:\n                  # The target primitive itself is traversable; the agent might step on it to collect.\n                  continue \n              elif k_idx in world_config.non_grabbable_indices:\n                  # If it's a non-grabbable item, check if it's an exception (traversable interactive point)\n                  if k_idx in world_config.workshop_indices or k_idx == world_config.water_index:\n                      continue # Workshops and water are traversable interactive points\n                  else:\n                      # Other non-grabbable items are considered impassable obstacles (e.g., BOUNDARY walls)\n                      return False\n      return True # No impassable obstacles found, so it's traversable\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      return []\n\n  state = env._current_state\n  initial_pos = state.pos\n  grid = state.grid\n  world_config = env.world # Reference to CraftWorld for configuration details\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right\n  ]\n\n  # Find all locations on the grid where the target primitive exists\n  primitive_locations = []\n  grid_width, grid_height, _ = grid.shape\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path\n  # to a cell that is adjacent to (or on the same cell as) the primitive.\n  # collections.deque is assumed to be available from outer scope imports.\n  queue = collections.deque([(initial_pos, [])]) # (current_position, path_taken_to_reach_here)\n  visited = {initial_pos} # Set of visited positions to avoid cycles\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on) any of the primitive's locations.\n      # The 'USE' action can be effective from a 3x3 neighborhood around the target.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return the complete path\n          path.append(USE_ACTION)\n          return path\n\n      # Explore neighboring cells (UP, DOWN, LEFT, RIGHT)\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Use the helper function to check traversability and avoid already visited cells\n          if _is_traversable(next_x, next_y, grid, primitive_idx, world_config) and next_pos not in visited:\n              visited.add(next_pos)\n              new_path = list(path) # Create a new list for the path to avoid modifying shared references\n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:12:12.927993", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n  \n  # Identify blocking elements. In CraftWorld, \"water\" and \"boundary\" are typical obstacles.\n  blocking_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1).tolist()\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Helper function to check if a position is valid and traversable\n  def is_valid_and_traversable(x, y):\n    # Check bounds\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False\n    \n    # Check if the cell contains any blocking kind\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False\n    return True\n\n  # Pre-calculate all target positions (cells from which USE can be performed)\n  # These are cells in the 3x3 neighborhood of a primitive, and are traversable.\n  target_collectable_positions = set()\n  for px, py in primitive_locations:\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = px + dx_adj, py + dy_adj\n        if is_valid_and_traversable(adj_x, adj_y):\n            target_collectable_positions.add((adj_x, adj_y))\n\n  if not target_collectable_positions:\n    # If no valid reachable position to collect the primitive from (e.g., all surrounded by obstacles)\n    return []\n\n  # Heuristic: Manhattan distance to the closest target_collectable_position\n  # This heuristic is admissible (never overestimates the actual cost).\n  def heuristic(pos):\n    min_h = float('inf')\n    for tx, ty in target_collectable_positions:\n      min_h = min(min_h, abs(pos[0] - tx) + abs(pos[1] - ty))\n    return min_h\n\n  # A* search initialization\n  # Priority queue stores (f_score, g_score, (current_x, current_y), list_of_actions)\n  # f_score = g_score + h_score\n  start_h = heuristic(agent_pos)\n  pq = [(start_h, 0, agent_pos, [])] \n  \n  # g_scores_dict stores the minimum cost (number of steps) to reach a node (x, y) from the start\n  g_scores_dict = {agent_pos: 0}\n  \n  # Define possible moves (dx, dy) corresponding to actions\n  moves_directions = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while pq:\n    f_score, g_score, (cx, cy), path_actions = heapq.heappop(pq)\n\n    # If we found a shorter path to (cx, cy) already, skip this entry\n    if g_score > g_scores_dict.get((cx, cy), float('inf')):\n      continue\n    \n    # Check if the current position is one of our target collectable positions\n    if (cx, cy) in target_collectable_positions:\n      # If so, we have found the shortest path to a valid collection point.\n      # Append the USE action and return the path.\n      return path_actions + [USE]\n\n    # Explore valid neighbors\n    for action_type, (dx, dy) in moves_directions.items():\n      nx, ny = cx + dx, cy + dy\n      \n      if is_valid_and_traversable(nx, ny):\n        new_g_score = g_score + 1 # Cost to move to a neighbor is 1\n        \n        # If this new path to (nx, ny) is shorter than any previously found path\n        if new_g_score < g_scores_dict.get((nx, ny), float('inf')):\n          g_scores_dict[(nx, ny)] = new_g_score\n          new_f_score = new_g_score + heuristic((nx, ny))\n          heapq.heappush(pq, (new_f_score, new_g_score, (nx, ny), path_actions + [action_type]))\n        \n  # If the priority queue becomes empty and no path to an adjacent primitive location is found\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-02T00:12:14.154490", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This version uses Breadth-First Search (BFS) for pathfinding, ensuring the shortest path\n    to a collectable primitive while considering impassable terrain. It first checks if the\n    primitive is already adjacent, then performs a BFS if not.\n\n    Args:\n        env (env.CraftLab): The CraftLab object.\n        primitive (str): The name of the primitive to collect.\n\n    Returns:\n        List[int]: A sequence of action indices to execute.\n  \"\"\"\n  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive from the cookbook's index mapping.\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Get action integer mappings for movement and the 'USE' action.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n\n  # Determine impassable (blocking) terrain kinds.\n  # Based on common CraftWorld entities, 'WATER' and 'BOUNDARY' are typically blocking.\n  # 'WORKSHOP' items are generally non-grabbable but traversable.\n  blocking_kind_indices = set()\n  if 'WATER' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['WATER'])\n  # Add 'BOUNDARY' if it's a defined entity kind in the cookbook.\n  if 'BOUNDARY' in cookbook.index.contents:\n    blocking_kind_indices.add(cookbook.index['BOUNDARY'])\n  \n  # Helper function to check if a given grid position (x, y) is within bounds\n  # and does not contain any blocking terrain.\n  def is_traversable(x, y):\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False  # Out of grid bounds\n    \n    # Check if the cell at (x, y) contains any blocking kind.\n    for blocking_idx in blocking_kind_indices:\n      if grid[x, y, blocking_idx] == 1:\n        return False  # This cell contains an impassable obstacle\n    return True\n\n  # Find all grid locations where the desired primitive is present.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations_on_grid) == 0:\n    # If the primitive is not present anywhere on the grid, it cannot be collected.\n    return []\n\n  # --- Initial check: Is the agent already adjacent to the primitive? ---\n  # If so, only the 'USE' action is needed.\n  for px, py in primitive_locations_on_grid:\n    # `state.next_to` checks the 3x3 neighborhood (Chebyshev distance <= 1).\n    if max(abs(agent_pos[0] - px), abs(agent_pos[1] - py)) <= 1:\n      return [USE]\n\n  # --- Breadth-First Search (BFS) for pathfinding ---\n  # The queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting nodes and endless loops.\n  visited = {agent_pos}\n\n  # Define possible movement directions (dx, dy) corresponding to actions.\n  # These map directly to changes in the agent's grid position.\n  moves_directions = {\n      UP: (0, -1),   # (dx, dy)\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n  \n  while queue:\n    (cx, cy), path_actions = queue.popleft()\n\n    # Explore all four neighboring cells (Up, Down, Left, Right).\n    for action_type, (dx, dy) in moves_directions.items():\n      nx, ny = cx + dx, cy + dy  # Calculate new potential position\n\n      # Check if the new position is traversable and has not been visited yet.\n      if is_traversable(nx, ny) and (nx, ny) not in visited:\n        new_path_actions = path_actions + [action_type]\n        \n        # Check if this new position (nx, ny) is adjacent to any of the primitive locations.\n        # This is our goal condition for pathfinding: reaching a cell from which `USE` can be applied.\n        is_adjacent_to_primitive = False\n        for px, py in primitive_locations_on_grid:\n          if max(abs(nx - px), abs(ny - py)) <= 1:\n            is_adjacent_to_primitive = True\n            break\n        \n        if is_adjacent_to_primitive:\n          # If a path is found to an adjacent cell, append the 'USE' action and return the complete sequence.\n          # BFS guarantees this is the shortest path.\n          return new_path_actions + [USE]\n        else:\n          # If not yet adjacent to a primitive, add this new position to the queue for further exploration.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), new_path_actions))\n        \n  # If the BFS queue becomes empty and no path to an adjacent primitive location was found,\n  # it means the primitive is unreachable from the current agent position.\n  return []", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-02T00:12:37.981686", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  # The Index class's __getitem__ method returns int or None.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # If the primitive name is not found in the cookbook, it cannot be collected.\n    return []\n\n  # Get action mappings for clarity and direct use.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements (dx, dy) and their corresponding action IDs.\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move Up (change in row, change in col, action)\n      (0, 1, ACTION_DOWN),   # Move Down\n      (-1, 0, ACTION_LEFT),  # Move Left\n      (1, 0, ACTION_RIGHT),  # Move Right\n  ]\n\n  # Grid dimensions (WIDTH, HEIGHT, n_kinds).\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position.\n  start_pos = state.pos\n\n  # BFS (Breadth-First Search) setup for shortest pathfinding.\n  # The queue stores tuples: (current_position (tuple), list_of_actions_to_reach_here (list)).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant exploration.\n  visited = {start_pos} \n\n  # Determine properties of the target primitive for defining the \"collection\" goal condition.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Primitives that are \"collected\" by simply reaching their cell (not requiring a USE action).\n  # This includes water, stone, and the boundary itself (if that's the goal).\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n\n  # Get the index for boundary cells, which are generally impassable obstacles for movement.\n  # We assume 'BOUNDARY' is always present in the cookbook.\n  boundary_idx = cookbook.index['BOUNDARY'] \n\n  # BFS loop to find the shortest path to the primitive.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a hypothetical CraftState instance at `current_pos`.\n    # This allows us to leverage `CraftState` methods like `next_to` or inspect `grid` content\n    # as if the agent was actually at this position. This is crucial for defining and checking goal states.\n    # Agent's direction and inventory are kept constant as they do not affect grid-based pathfinding geometry.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # **Goal Check**:\n    # For grabbable items (e.g., WOOD, IRON), the agent needs to be adjacent to them and then use the 'USE' action.\n    if is_grabbable:\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE] # Found path to adjacency + USE action\n    # For workshops, water, stone, or boundary (stationary features), \"collecting\" means\n    # simply reaching the cell where the primitive is located. No 'USE' action is typically needed.\n    elif is_workshop or is_stationary_primitive:\n      # Check if the target primitive is present at the current cell.\n      # We check the grid directly; `next_to` is specifically for checking adjacency, not presence at `pos`.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # Found path to the location\n    \n    # **Explore Neighbors**:\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # 1. Check if the new position is within grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # 2. Check if the new position is traversable (e.g., not a solid boundary).\n        # We treat cells containing 'BOUNDARY' as impassable obstacles,\n        # UNLESS 'BOUNDARY' itself is the primitive we are trying to \"collect\" (i.e., reach).\n        if (boundary_idx is not None and \n            grid[new_x, new_y, boundary_idx] > 0 and \n            primitive_idx != boundary_idx):\n            continue # This cell contains an impassable boundary and is not our goal, so skip it.\n\n        # 3. Check if this new position has already been visited to avoid cycles and redundant paths.\n        if new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS queue becomes empty and no path to the primitive was found, it means the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": 0.5}}
