{"timestamp": "2025-08-01T22:42:27.740659", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive)\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # MOVE_ACTIONS[action_id] = (dr, dc, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Move North (up), face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (right), face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (down), face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (left), face West (dir 3)\n  }\n  \n  # Define deltas for the cell directly in front of the agent based on its facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n\n  # Helper function to determine if a grid cell is walkable by the agent.\n  def _is_walkable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable item that is not a workshop.\n      # Workshops are walkable. Other non-grabbables like WATER, STONE are typically not.\n      for idx in non_grabbable_indices:\n          if current_state.grid[r, c, idx] == 1:\n              if idx not in workshop_indices:\n                  return False # Blocked by a non-grabbable, non-workshop item.\n      \n      return True # Cell is considered walkable.\n\n  # Find all occurrences of the target primitive on the grid.\n  # This set will be used for goal checking in BFS.\n  primitive_locations = set()\n  for r_grid in range(WIDTH):\n      for c_grid in range(HEIGHT):\n          if current_state.grid[r_grid, c_grid, primitive_idx] == 1:\n              primitive_locations.add((r_grid, c_grid))\n  \n  # If the primitive is not found on the grid at all, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Helper function to check if the current state satisfies the collection goal.\n  # Returns a list of actions (e.g., [] for grabbable, [craft.USE] for non-grabbable)\n  # or None if the goal is not met at this state.\n  def _check_collection_goal(r, c, current_dir):\n      # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n      if primitive_idx in world.grabbable_indices:\n          if (r, c) in primitive_locations:\n              return [] # Goal reached by moving to this cell.\n      # For non-grabbable items (e.g., WATER, STONE, WORKSHOP), the agent needs to be adjacent\n      # to the item, facing it, then perform a 'USE' action.\n      elif primitive_idx in world.non_grabbable_indices:\n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Check if the cell in front is within bounds and contains the target primitive.\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                  (front_r, front_c) in primitive_locations):\n              return [craft.USE] # Goal reached by using the item in front.\n      return None # Goal not met from this state.\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the collection goal.\n      goal_actions = _check_collection_goal(r, c, current_dir)\n      if goal_actions is not None:\n          return path + goal_actions # Path found, return the sequence of actions.\n\n      # Explore possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n          next_state_dir = next_dir_after_move # The direction after moving to next_r, next_c\n\n          # Check if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_dir)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_state_dir, path + [action_id]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:42:29.100527", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find, use already available items, and collect the primitive in the passed env.\n    \n    This version refines pathfinding and obstacle handling for robustness.\n\n    Args:\n        env (env.CraftLab): The CraftLab object containing the current game state.\n        primitive (str): The name of the primitive item to collect (e.g., \"WOOD\", \"STONE\", \"WORKSHOP0\").\n\n    Returns:\n        List[int]: A sequence of action indices (integers) to execute to collect the primitive.\n                   Returns an empty list if the primitive is already collected or unreachable.\n  \"\"\"\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook # Access to index for item IDs, and item properties\n\n  # Retrieve the integer index for the target primitive from the cookbook's index.\n  # This mapping is crucial for interacting with the grid and inventory.\n  try:\n    primitive_idx = cookbook.index.index(primitive)\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    # This acts as a defensive check, though the problem implies valid primitive names.\n    return []\n\n  # Extract grid dimensions for boundary checks.\n  GRID_WIDTH, GRID_HEIGHT, _ = current_state.grid.shape\n\n  # 1. Early Exit: If the primitive is a grabbable item and already in the inventory,\n  # no further actions are needed. This prioritizes using existing resources.\n  is_grabbable = primitive_idx in world.grabbable_indices\n  if is_grabbable and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and facing direction.\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  # Each entry maps an action ID (e.g., craft.UP) to (row_delta, col_delta, new_facing_direction).\n  MOVE_ACTION_DELTAS = {\n      craft.UP:    (-1,  0, 0), # Move North (row-1), face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (col+1), face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (row+1), face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (col-1), face West (dir 3)\n  }\n  \n  # Define coordinate deltas for the cell directly in front of the agent, based on its facing direction.\n  # This is used for checking what the agent is looking at for 'USE' actions.\n  FACING_DIR_TO_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache sets of special item indices for efficient lookups.\n  # These are non-grabbable items that explicitly block movement (e.g., WATER, STONE, BOUNDARY).\n  # Workshops are non-grabbable but are generally walkable.\n  non_grabbable_obstacles = set(world.non_grabbable_indices) - set(world.workshop_indices)\n  \n  # Helper function to determine if a given grid cell (r, c) is walkable by the agent.\n  # A cell is walkable if it's within bounds and does not contain any impassable non-grabbable items.\n  def _is_walkable(r: int, c: int) -> bool:\n      # 1. Check grid boundaries.\n      if not (0 <= r < GRID_WIDTH and 0 <= c < GRID_HEIGHT):\n          return False\n      \n      # 2. Check for impassable non-grabbable obstacles.\n      # Iterate through known impassable obstacle indices. If the cell contains any of these, it's not walkable.\n      for obstacle_idx in non_grabbable_obstacles:\n          if current_state.grid[r, c, obstacle_idx] == 1:\n              return False # This cell contains an impassable obstacle (e.g., water, stone, boundary).\n      \n      return True # Cell is clear and within bounds, thus considered walkable.\n\n  # Identify all grid locations where the target primitive exists.\n  # This optimizes goal checking during BFS, preventing redundant grid scans.\n  primitive_locations = set()\n  for r_scan in range(GRID_WIDTH):\n      for c_scan in range(GRID_HEIGHT):\n          if current_state.grid[r_scan, c_scan, primitive_idx] == 1:\n              primitive_locations.add((r_scan, c_scan))\n  \n  # If the primitive doesn't exist anywhere on the map, it's unreachable for collection.\n  if not primitive_locations:\n      return []\n\n  # Initialize BFS queue. Each element is a tuple:\n  # (current_row, current_col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  bfs_queue = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to avoid cycles and redundant computations.\n  # A state is defined by (row, col, current_facing_direction).\n  visited_states = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while bfs_queue:\n      r, c, current_dir, path_so_far = bfs_queue.popleft()\n\n      # Check if the current state satisfies the collection goal.\n      if is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n          if (r, c) in primitive_locations:\n              return path_so_far # Path found: agent is on the grabbable item.\n      else: # Primitive is a non-grabbable item (e.g., STONE, WORKSHOP)\n          # For non-grabbable items, the agent needs to be adjacent to the item,\n          # facing it, and then perform a 'USE' action.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = FACING_DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Check if the cell in front is within bounds and contains the target primitive.\n          if (0 <= front_r < GRID_WIDTH and 0 <= front_c < GRID_HEIGHT and\n                  (front_r, front_c) in primitive_locations):\n              return path_so_far + [craft.USE] # Path found: append the USE action.\n\n      # Explore all possible movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTION_DELTAS.items():\n          next_r, next_c = r + dr, c + dc\n          next_state_direction = next_dir_after_move\n\n          # Only proceed if the next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_direction)\n              \n              # If this new state hasn't been visited before, add it to the queue.\n              if next_state_tuple not in visited_states:\n                  visited_states.add(next_state_tuple)\n                  bfs_queue.append((next_r, next_c, next_state_direction, path_so_far + [action_id]))\n\n  # If the BFS queue becomes empty and no path was found, the primitive is unreachable.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:43:12.773895", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        # Check if the potential target cell is within grid bounds\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          bfs_target_cells.add((nx, ny))\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    # (i.e., a cell from which state.next_to(primitive_idx) would be True)\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T22:43:13.962688", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Improvement for v2: If the primitive is already in inventory, no collection is needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        # Check if the potential target cell is within grid bounds\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n          bfs_target_cells.add((nx, ny))\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    # (i.e., a cell from which state.next_to(primitive_idx) would be True)\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T22:43:49.363018", "function_name": "collect", "function_body": "  try:\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the cookbook's index, it cannot be collected.\n      return []\n\n  # Ensure the target item is indeed classified as a primitive resource that can be collected.\n  # This prevents trying to 'collect' non-primitive items like workshops or crafted items\n  # that are not directly 'collected' via the USE action on a grid cell.\n  if primitive_idx not in env.world.cookbook.primitives:\n      return []\n\n  current_state = env._current_state\n  \n  # Optimization: If the primitive is already in the inventory, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return [] \n\n  grid = current_state.grid\n  agent_pos = current_state.pos # (x, y) tuple\n  \n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n\n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each action (dx, dy)\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles for movement.\n  # The agent cannot move into cells occupied by these items.\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # BFS for pathfinding to a cell from which the agent can USE the primitive.\n  # The queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to avoid cycles and redundant exploration\n  visited = {agent_pos}\n  \n  while queue:\n      (cx, cy), path_so_far = queue.popleft() # Current position and path to reach it\n\n      # Goal check: Determine if the primitive is in the 3x3 neighborhood of (cx, cy).\n      # This matches the CraftState.next_to logic, which is typically how USE works.\n      is_primitive_reachable_from_current_pos = False\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              px, py = cx + dx, cy + dy # Potential primitive location\n              # Check grid boundaries for the potential primitive location\n              if 0 <= px < grid_width and 0 <= py < grid_height:\n                  # If the primitive is found at (px, py)\n                  if grid[px, py, primitive_idx] == 1:\n                      is_primitive_reachable_from_current_pos = True\n                      break # Found primitive in neighborhood, no need to check other cells\n          if is_primitive_reachable_from_current_pos:\n              break\n\n      if is_primitive_reachable_from_current_pos:\n          # If the primitive is reachable from the current position (cx, cy),\n          # append the USE_ACTION and return the full path.\n          return path_so_far + [USE_ACTION]\n\n      # Explore traversable neighbors for movement\n      for move_action_id, (dx, dy) in DELTAS.items():\n          nx, ny = cx + dx, cy + dy # Calculate neighbor coordinates\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Check if this neighbor has already been visited in the BFS\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the neighbor cell is an obstacle (contains any non-grabbable item).\n          # An agent cannot move into a cell occupied by a non-grabbable item.\n          is_obstacle = False\n          # Iterate through all kinds present at (nx, ny) to check for obstacles\n          kinds_at_next_pos = np.where(grid[nx, ny, :] == 1)[0]\n          for kind_idx in kinds_at_next_pos:\n              if kind_idx in non_grabbable_obstacle_indices:\n                  is_obstacle = True\n                  break # Found an obstacle, cannot move to this cell\n          \n          if is_obstacle:\n              continue # Skip this cell, it's an obstacle\n\n          # If the neighbor is traversable and not visited, add it to the queue\n          visited.add((nx, ny))\n          queue.append(((nx, ny), path_so_far + [move_action_id]))\n\n  # If the queue is exhausted and no path to a usable primitive location was found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:43:50.604357", "function_name": "collect", "function_body": "  # Helper function to check if a primitive is in the 3x3 neighborhood of a given position\n  def _is_primitive_adjacent(grid, check_pos, target_idx, grid_width, grid_height):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around `check_pos` contains `target_idx`.\n      This mimics CraftState.next_to behavior, which is how `USE` actions determine if an item is available.\n      \"\"\"\n      cx, cy = check_pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              px, py = cx + dx, cy + dy\n              # Check grid boundaries for the potential primitive location\n              if 0 <= px < grid_width and 0 <= py < grid_height:\n                  # If the primitive is found at (px, py)\n                  if grid[px, py, target_idx] == 1:\n                      return True\n      return False\n\n  try:\n      # 1. Get the integer index for the primitive from the cookbook's index.\n      primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not found in the index, it cannot be collected.\n      return []\n\n  # 2. Validate that the target is indeed a \"primitive\" resource that can be collected.\n  # This prevents trying to collect crafted items or environment features that are not primitives.\n  if primitive_idx not in env.world.cookbook.primitives:\n      return []\n\n  # 3. Get current state information from the environment.\n  current_state = env._current_state\n  \n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to collect it, so return an empty list.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  grid = current_state.grid\n  agent_pos = current_state.pos # The agent's current (x, y) tuple position.\n  \n  # Get grid dimensions (WIDTH, HEIGHT) for boundary checks.\n  grid_width, grid_height, _ = grid.shape\n\n  # 5. Get action mappings from the environment's action_specs for clarity.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define movement deltas for each cardinal direction action (dx, dy).\n  DELTAS = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0)\n  }\n  \n  # Get indices of non-grabbable items which act as obstacles during movement.\n  # The agent cannot move into a cell that contains any of these items.\n  non_grabbable_obstacle_indices = env.world.non_grabbable_indices\n\n  # 6. Perform Breadth-First Search (BFS) to find the shortest path to collect the primitive.\n  # The queue stores tuples: ((agent_x, agent_y), [list_of_actions_taken_to_reach_here])\n  queue = collections.deque([(agent_pos, [])])\n  # The visited set stores (x, y) tuples to prevent revisiting cells and infinite loops,\n  # ensuring that the shortest path is found.\n  visited = {agent_pos}\n  \n  while queue:\n      (cx, cy), path_so_far = queue.popleft() # Current agent position and the path taken to reach it.\n\n      # Check if the primitive is collectable from the current position (cx, cy).\n      # This means checking if the primitive is in the 3x3 neighborhood of (cx, cy).\n      if _is_primitive_adjacent(grid, (cx, cy), primitive_idx, grid_width, grid_height):\n          # If the primitive is reachable from the current position, we've found a path.\n          # Append the USE_ACTION to the path and return the complete sequence of actions.\n          return path_so_far + [USE_ACTION]\n\n      # Explore all possible cardinal moves (UP, DOWN, LEFT, RIGHT) from the current position.\n      for move_action_id, (dx, dy) in DELTAS.items():\n          nx, ny = cx + dx, cy + dy # Calculate the next potential agent position.\n\n          # Check if the next position is within the grid boundaries.\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Check if this neighbor cell has already been visited in the BFS.\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the neighbor cell is blocked by any non-grabbable obstacle.\n          # The agent cannot move into a cell if it contains a non-grabbable item.\n          is_obstacle = False\n          # Get all kind indices present at the potential next position (nx, ny).\n          kinds_at_next_pos = np.where(grid[nx, ny, :] == 1)[0]\n          for kind_idx in kinds_at_next_pos:\n              if kind_idx in non_grabbable_obstacle_indices:\n                  is_obstacle = True\n                  break # Found an obstacle, cannot move to this cell.\n          \n          if is_obstacle:\n              continue # Skip this cell, as it's an obstacle.\n\n          # If the neighbor cell is traversable and not yet visited, add it to the queue\n          # for further exploration. Mark it as visited.\n          visited.add((nx, ny))\n          queue.append(((nx, ny), path_so_far + [move_action_id]))\n\n  # If the BFS queue is exhausted and no path to a usable primitive location was found,\n  # it means the primitive is unreachable in the current scenario.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:44:48.126245", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive) # Get integer ID for the primitive\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Early exit: If the primitive is already in inventory (and is a grabbable item), no actions are needed.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions (delta_row, delta_col, new_facing_direction).\n  # Directions: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT)\n  MOVE_ACTIONS_MAP = {\n      craft.UP:    (-1,  0, 0), # Move North (up), face North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (right), face East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (down), face South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (left), face West (dir 3)\n  }\n  \n  # Define direction deltas for the cell directly in front of the agent.\n  DIR_TO_FRONT_DELTA = {\n      0: (-1, 0),  # North (UP)\n      1: (0, 1),   # East (RIGHT)\n      2: (1, 0),   # South (DOWN)\n      3: (0, -1)   # West (LEFT)\n  }\n\n  # Cache common environment indices for quicker access.\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n\n  # Helper function to determine if a grid cell is traversable by the agent.\n  def _is_traversable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False # Out of bounds.\n      \n      # A cell is not traversable if it contains a non-grabbable item that is not a workshop.\n      # Workshops are considered walkable/traversable. Other non-grabbables like WATER, STONE are not.\n      for idx in non_grabbable_indices:\n          if current_state.grid[r, c, idx] == 1:\n              if idx not in workshop_indices:\n                  return False # Blocked by a non-grabbable, non-workshop item.\n      \n      return True # Cell is considered traversable.\n\n  # Find all occurrences of the target primitive on the grid.\n  # This set will store (row, col) coordinates for quick lookup during BFS.\n  target_primitive_grid_locations = set()\n  for r_grid in range(WIDTH):\n      for c_grid in range(HEIGHT):\n          if current_state.grid[r_grid, c_grid, primitive_idx] == 1:\n              target_primitive_grid_locations.add((r_grid, c_grid))\n  \n  # If no instance of the primitive is found on the grid, it cannot be collected.\n  if not target_primitive_grid_locations:\n      return []\n\n  # Initialize BFS queue with the agent's current state:\n  # (row, col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_r, start_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_r, start_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by (row, col, current_facing_direction).\n  visited_states = {(start_r, start_c, start_dir)}\n\n  # Determine if the primitive is a grabbable item or requires the 'USE' action.\n  is_grabbable = (primitive_idx in world.grabbable_indices)\n  \n  # Perform Breadth-First Search (BFS) to find the shortest action sequence.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check for the goal condition. The condition differs based on item type.\n      if is_grabbable:\n          # For grabbable items (e.g., WOOD, IRON), the agent needs to move onto the item's cell.\n          if (r, c) in target_primitive_grid_locations:\n              return path # Goal reached: agent is now on the grabbable item's location.\n      else:\n          # For non-grabbable items (e.g., WATER, STONE, WORKSHOP), the agent needs to be adjacent\n          # to the item, facing it, then perform a 'USE' action.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_FRONT_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Check if the cell in front is within bounds and contains the target primitive.\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                  (front_r, front_c) in target_primitive_grid_locations):\n              # Goal reached: agent is adjacent and facing the non-grabbable item.\n              return path + [craft.USE] # Append the USE action to the path.\n\n      # Explore all possible movement actions from the current state.\n      for action_id, (dr, dc, next_facing_dir) in MOVE_ACTIONS_MAP.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Only proceed if the next cell is traversable.\n          if _is_traversable(next_r, next_c):\n              next_state = (next_r, next_c, next_facing_dir)\n              # If this state hasn't been visited before, add it to the queue.\n              if next_state not in visited_states:\n                  visited_states.add(next_state)\n                  q.append((next_r, next_c, next_facing_dir, path + [action_id]))\n\n  # If the BFS completes and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:44:49.371105", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_idx = cookbook.index.index(primitive) \n  \n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Early exit: Check if the primitive is already in inventory.\n  # If it's a grabbable item (like WOOD, IRON) and we already have some,\n  # no further actions are needed to collect it.\n  if primitive_idx in world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define possible agent movements and their impact on position and facing direction.\n  # Directions are typically: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT).\n  # MOVE_ACTIONS maps action ID to (row_delta, col_delta, new_facing_direction).\n  MOVE_ACTIONS = {\n      craft.UP:    (-1,  0, 0), # Move North (up), agent faces North (dir 0)\n      craft.RIGHT: ( 0,  1, 1), # Move East (right), agent faces East (dir 1)\n      craft.DOWN:  ( 1,  0, 2), # Move South (down), agent faces South (dir 2)\n      craft.LEFT:  ( 0, -1, 3)  # Move West (left), agent faces West (dir 3)\n  }\n  \n  # Define deltas to find the cell directly in front of the agent, based on its current direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # Facing North (UP): cell in front is above\n      1: (0, 1),   # Facing East (RIGHT): cell in front is to the right\n      2: (1, 0),   # Facing South (DOWN): cell in front is below\n      3: (0, -1)   # Facing West (LEFT): cell in front is to the left\n  }\n\n  # Cache frequently used index sets for faster lookups.\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices # Workshops are non-grabbable but walkable.\n\n  # Helper function to determine if a grid cell is safe for the agent to move into.\n  def _is_walkable(r, c):\n      # Check if the coordinates are within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check if the cell contains any non-grabbable entity that blocks movement.\n      # Workshops (e.g., BENCH) are non-grabbable but the agent can stand on them.\n      for idx in non_grabbable_indices:\n          if current_state.grid[r, c, idx] == 1: # If this non-grabbable item is present\n              if idx not in workshop_indices: # And it's not a workshop\n                  return False # Then the cell is blocked and not walkable.\n      \n      return True # The cell is within bounds and doesn't contain blocking non-grabbables.\n\n  # Discover all grid locations where the target primitive can be found.\n  primitive_locations = set()\n  for r_grid in range(WIDTH):\n      for c_grid in range(HEIGHT):\n          if current_state.grid[r_grid, c_grid, primitive_idx] == 1:\n              primitive_locations.add((r_grid, c_grid))\n  \n  # If the primitive is not present anywhere on the current grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue stores tuples: (current_row, current_col, current_direction, list_of_actions_taken).\n  start_pos_r, start_pos_c = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos_r, start_pos_c, start_dir, [])])\n  \n  # Keep track of visited states to prevent redundant exploration and infinite loops.\n  # A state is defined by (row, col, facing_direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Begin BFS traversal.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the collection condition for the primitive.\n      if primitive_idx in world.grabbable_indices:\n          # For grabbable items (e.g., WOOD, IRON), collection happens by moving onto the cell.\n          # If the agent is currently on a cell containing the primitive, the path is found.\n          if (r, c) in primitive_locations:\n              return path # Return the sequence of actions to reach this location.\n      else: # This implies primitive_idx is in non_grabbable_indices (e.g., WATER, STONE, WORKSHOP).\n          # For non-grabbable items, collection requires being adjacent to and facing the item,\n          # then performing a 'USE' action.\n          \n          # Calculate coordinates of the cell directly in front of the agent.\n          front_dr, front_dc = DIR_TO_DELTA[current_dir]\n          front_r, front_c = r + front_dr, c + front_dc\n\n          # Check if the cell in front is within bounds and contains the target primitive.\n          if (0 <= front_r < WIDTH and 0 <= front_c < HEIGHT and\n                  (front_r, front_c) in primitive_locations):\n              # Path found; append the USE action and return the complete sequence.\n              return path + [craft.USE] \n\n      # Explore next possible states by applying movement actions.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n          # The agent's new facing direction after this movement action.\n          next_state_dir = next_dir_after_move \n\n          # Check if the potential next cell is walkable.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_state_dir)\n              # If this new state hasn't been visited before, add it to the queue for exploration.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_state_dir, path + [action_id]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # return an empty list, indicating failure.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:45:23.939725", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # Primitive name not recognized by the environment's cookbook.\n      return []\n\n  # IMPROVEMENT (re-introduction from v0): Check if the target primitive is actually grabbable.\n  # If an item is not in `grabbable_indices`, it cannot be picked up and added to inventory\n  # via the 'USE' action. For example, 'BOUNDARY', 'WATER', 'WORKSHOP0' are primitives\n  # in the DSL but are not meant to be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve current state information from the environment.\n  state = env._current_state\n  agent_pos = state.pos  # Agent's current (x, y) position on the grid.\n  grid = state.grid        # The current grid layout (WIDTH, HEIGHT, n_kinds).\n  grid_width, grid_height, num_kinds = grid.shape\n\n  # Get the integer action mappings from the environment for movement and 'USE'.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Define possible movement deltas and their corresponding action IDs.\n  # These are used to explore neighboring cells in the BFS.\n  move_deltas_and_actions = [\n      ((0, 1), DOWN_ACTION),  # (dx, dy) for moving down.\n      ((0, -1), UP_ACTION),   # (dx, dy) for moving up.\n      ((-1, 0), LEFT_ACTION), # (dx, dy) for moving left.\n      ((1, 0), RIGHT_ACTION), # (dx, dy) for moving right.\n  ]\n\n  # Identify all grid locations where the target primitive exists.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          # If the cell contains at least one unit of the target primitive.\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the map, it cannot be collected.\n      return []\n\n  # Use Breadth-First Search (BFS) to find the shortest path from the agent's\n  # current position to any cell that is adjacent to the target primitive.\n  # The queue stores (current_position, path_taken_to_reach_here).\n  queue = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of visited positions to prevent cycles and redundant computations.\n\n  while queue:\n      current_pos, path = queue.popleft()\n      cx, cy = current_pos\n\n      # Check if the current position is adjacent to (or on the same cell as)\n      # any of the primitive's known locations. A 3x3 neighborhood is considered\n      # \"adjacent\" for the purpose of the 'USE' action, as per `CraftState.next_to`.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(cx - px) <= 1 and abs(cy - py) <= 1:\n              is_adjacent_to_primitive = True\n              break\n      \n      if is_adjacent_to_primitive:\n          # If an adjacent cell is found, append the 'USE' action and return\n          # the complete sequence of actions (movement + use).\n          path.append(USE_ACTION)\n          return path\n\n      # Explore all four possible neighboring cells (UP, DOWN, LEFT, RIGHT).\n      for (dx, dy), action_id in move_deltas_and_actions:\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          # Ensure the next position is within the grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Determine if the next cell is traversable or an impassable obstacle.\n          # A cell is considered impassable if it contains any non-grabbable entity\n          # that is NOT a workshop and NOT water. Workshops and water are traversable.\n          is_impassable = False\n          for k_idx in range(num_kinds): \n              if grid[next_x, next_y, k_idx] > 0: # If there's something of kind k_idx at this cell...\n                  if k_idx in env.world.non_grabbable_indices and \\\n                     k_idx not in env.world.workshop_indices and \\\n                     k_idx != env.world.water_index:\n                      is_impassable = True\n                      break # No need to check other kinds in this cell; it's blocked.\n          \n          if is_impassable:\n              continue # Skip this path if the cell is blocked.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              # Create a new list for the path to avoid modifying shared lists across BFS branches.\n              new_path = list(path) \n              new_path.append(action_id)\n              queue.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to an adjacent primitive is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T22:45:25.041726", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-01T22:46:04.535388", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify impassable terrain indices more generally using CraftWorld's non_grabbable_indices.\n  # These are entities the agent cannot traverse through.\n  # This is an improvement over hardcoding 'BOUNDARY' and 'WATER' as in v0.\n  impassable_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is traversable\n  def is_cell_traversable(x, y):\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n      # Check if any impassable object is present at (x, y)\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1: # If the impassable entity is present\n              return False  # Contains an impassable object\n      return True\n\n  # Check if the agent's starting position is traversable. If not, no path is possible.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        \n        # A potential target cell must be within grid bounds AND traversable by the agent\n        if is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no valid traversable target cells exist, no path is possible\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos}\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    # (i.e., a cell from which state.next_to(primitive_idx) would be True if primitive is there)\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and is traversable\n      if not is_cell_traversable(next_x, next_y):\n        continue\n\n      # Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:46:05.651703", "function_name": "collect", "function_body": "  state = env._current_state\n  grid = state.grid\n  agent_pos = state.pos  # (px, py)\n  cookbook = env.world.cookbook\n  \n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive not found in the cookbook, return empty actions\n    return []\n\n  # Action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Directions mapping to actions for BFS path reconstruction\n  # (dx, dy) -> action (movement from current_pos to next_pos)\n  dir_to_action = {\n      (0, -1): UP,\n      (0, 1): DOWN,\n      (-1, 0): LEFT,\n      (1, 0): RIGHT,\n  }\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Identify impassable terrain indices.\n  # Movement onto cells containing these items is blocked by the environment.\n  # It's crucial to filter these during BFS to find a truly traversable path.\n  impassable_indices = set()\n  if 'BOUNDARY' in cookbook.index.contents:\n      impassable_indices.add(cookbook.index['BOUNDARY'])\n  if 'WATER' in cookbook.index.contents:\n      impassable_indices.add(cookbook.index['WATER'])\n\n  # Helper function to check if a cell is traversable\n  def is_cell_traversable(x, y):\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False  # Out of bounds\n      for imp_idx in impassable_indices:\n          if grid[x, y, imp_idx] == 1:\n              return False  # Contains an impassable object\n      return True\n\n  # Check if the agent's starting position is traversable. If not, no path is possible.\n  if not is_cell_traversable(agent_pos[0], agent_pos[1]):\n      return []\n\n  # Find all occurrences of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n    # Primitive not present on the current grid, return empty actions\n    return []\n\n  # Define the set of target cells for BFS.\n  # These are any traversable cells from which the agent can successfully 'USE' the primitive.\n  # According to CraftState.next_to, this means any cell in the 3x3 neighborhood\n  # (including the cell itself) around a primitive's location.\n  bfs_target_cells = set()\n  for tx, ty in primitive_locations:\n    # Iterate through the 3x3 neighborhood around the primitive location\n    for dx_n in [-1, 0, 1]:\n      for dy_n in [-1, 0, 1]:\n        nx, ny = tx + dx_n, ty + dy_n\n        \n        # A potential target cell must be within grid bounds AND traversable by the agent\n        if is_cell_traversable(nx, ny):\n          bfs_target_cells.add((nx, ny))\n\n  # If no valid traversable target cells exist, no path is possible\n  if not bfs_target_cells:\n      return []\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Set of (x, y) tuples to avoid cycles and redundant paths\n\n  while q:\n    current_pos, path = q.popleft()\n    \n    # Check if the current position is one of our valid target cells\n    # (i.e., a cell from which state.next_to(primitive_idx) would be True)\n    if current_pos in bfs_target_cells:\n      # We found the shortest path to a cell adjacent to the primitive.\n      # Append the USE action and return the complete sequence.\n      return path + [USE]\n\n    # Explore valid neighbors (UP, DOWN, LEFT, RIGHT)\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries and is traversable\n      if not is_cell_traversable(next_x, next_y):\n        continue\n\n      # Check if the next position has already been visited in a shorter path\n      if next_pos not in visited:\n        visited.add(next_pos)\n        # Create a new path by appending the action to move to next_pos\n        new_path = path + [dir_to_action[(dx, dy)]]\n        q.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path was found to any target cell\n  return []", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-01T22:46:26.683804", "function_name": "collect", "function_body": "  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not recognized, cannot collect\n    return []\n\n  # 2. Get the current state of the environment\n  state = env._current_state\n  actions = []\n\n  # 3. Check if the agent is already adjacent to the primitive\n  # If so, just perform the USE action to collect/interact with it\n  if state.next_to(primitive_idx):\n    actions.append(env.action_specs()['USE'])\n    return actions\n\n  # 4. Initialize grid dimensions and agent position\n  grid = state.grid\n  agent_pos = state.pos\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  # Get non-grabbable (obstacle) indices\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 5. Find all locations of the target primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if this cell contains the primitive\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere on the map, return an empty list\n  if not primitive_locations:\n    return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path\n  #    to any cell that is adjacent to any instance of the primitive,\n  #    avoiding non-grabbable (obstacle) cells.\n  #    Queue stores tuples of (current_position, path_actions_so_far)\n  q = collections.deque([(agent_pos, [])])\n  visited = {agent_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n  best_path_to_adjacent = None\n\n  # Define possible moves and their corresponding action indices\n  moves = [\n      ((0, 1), env.action_specs()['DOWN']),\n      ((0, -1), env.action_specs()['UP']),\n      ((1, 0), env.action_specs()['RIGHT']),\n      ((-1, 0), env.action_specs()['LEFT'])\n  ]\n\n  while q:\n    current_pos, path = q.popleft()\n    curr_x, curr_y = current_pos\n\n    # Check if the current position is adjacent to any of the primitive locations\n    for target_x, target_y in primitive_locations:\n      # Manhattan distance of 1 means it's adjacent\n      if abs(curr_x - target_x) + abs(curr_y - target_y) == 1:\n        best_path_to_adjacent = path\n        break  # Found the shortest path to an adjacent cell, exit inner loop\n    \n    if best_path_to_adjacent:\n      break  # Path found, exit BFS\n\n    # Explore neighboring cells\n    for (dx, dy), action_idx in moves:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check for obstacles (non-grabbable items) at the next position\n      is_obstacle = False\n      for kind_idx in range(N_KINDS):\n        if grid[next_x, next_y, kind_idx] > 0 and kind_idx in non_grabbable_indices:\n          is_obstacle = True\n          break\n      if is_obstacle:\n        continue # Cannot move to an obstacle cell\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        new_path = path + [action_idx]\n        q.append((next_pos, new_path))\n  \n  # 7. If a path to an adjacent cell was found, append the USE action\n  if best_path_to_adjacent is not None:\n    actions.extend(best_path_to_adjacent)\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
