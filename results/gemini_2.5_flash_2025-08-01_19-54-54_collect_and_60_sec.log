{"timestamp": "2025-08-01T22:05:18.960235", "function_name": "collect", "function_body": "  world = env.world\n  current_state = env._current_state\n  pos_x, pos_y = current_state.pos # Agent's current (col, row)\n  initial_dir = current_state.dir   # Agent's current direction (0:N, 1:E, 2:S, 3:W)\n  grid = current_state.grid         # Grid is (WIDTH, HEIGHT, n_kinds)\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define constants for movement and direction logic based on CraftState internals\n  # _action_to_delta: maps a move action index (0-3) to its (dx, dy) change in position\n  # CraftState's position is (x, y) where x is column, y is row.\n  _action_to_delta = {\n      ACTION_UP: (0, -1),    # x: no change, y: -1 (move up means decrease y)\n      ACTION_DOWN: (0, 1),   # x: no change, y: +1 (move down means increase y)\n      ACTION_LEFT: (-1, 0),  # x: -1, y: no change (move left means decrease x)\n      ACTION_RIGHT: (1, 0),  # x: +1, y: no change (move right means increase y)\n  }\n  # _action_to_dir: maps a move action index (0-3) to the agent's resulting direction (0-3)\n  # CraftState.dir: 0:North, 1:East, 2:South, 3:West\n  _action_to_dir = {\n      ACTION_UP: 0,    # UP action sets direction to North (0)\n      ACTION_DOWN: 2,  # DOWN action sets direction to South (2)\n      ACTION_LEFT: 3,  # LEFT action sets direction to West (3)\n      ACTION_RIGHT: 1, # RIGHT action sets direction to East (1)\n  }\n  # _dir_to_delta: maps a direction index (0-3) to the (dx, dy) offset of the cell in front\n  _dir_to_delta = {\n      0: (0, -1), # North: cell above (y decreases)\n      1: (1, 0),  # East: cell to the right (x increases)\n      2: (0, 1),  # South: cell below (y increases)\n      3: (-1, 0), # West: cell to the left (x decreases)\n  }\n\n  try:\n    primitive_idx = world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the index, it cannot be collected.\n    return []\n\n  # Get grid dimensions (WIDTH, HEIGHT, Kinds)\n  GRID_WIDTH, GRID_HEIGHT, _ = grid.shape\n\n  # Determine if the primitive requires a USE action (i.e., it's a grabbable resource)\n  requires_use_action = (primitive_idx in world.cookbook.primitives)\n\n  # Get indices of non-grabbable items which act as obstacles for movement.\n  # Agent cannot move into cells containing these.\n  non_grabbable_obstacle_indices = world.non_grabbable_indices\n\n  # BFS Queue: stores tuples of ((current_x, current_y, direction), list_of_actions_taken)\n  q = collections.deque([((pos_x, pos_y, initial_dir), [])])\n  \n  # Visited set: stores (x, y, direction) tuples to prevent redundant exploration and cycles\n  visited = {(pos_x, pos_y, initial_dir)}\n\n  while q:\n    (x, y, current_dir), path = q.popleft()\n\n    # 1. Check if the primitive can be collected from the current (x, y, current_dir) state.\n    # This means the cell directly in front of the agent must contain the primitive.\n    dx_face, dy_face = _dir_to_delta[current_dir]\n    target_cell_x, target_cell_y = x + dx_face, y + dy_face\n\n    # Check if the target cell is within grid boundaries\n    if 0 <= target_cell_x < GRID_WIDTH and 0 <= target_cell_y < GRID_HEIGHT:\n      # Check if the target cell actually contains the primitive\n      # Grid indexing is (x, y, kind_idx)\n      if grid[target_cell_x, target_cell_y, primitive_idx] > 0:\n        # Found a state from which the primitive can be collected.\n        if requires_use_action:\n          # If it's a grabbable resource, append the USE action and return the full path.\n          return path + [ACTION_USE]\n        else:\n          # If it's a non-grabbable entity (e.g., workshop, water, boundary),\n          # just reaching this position and facing it is considered \"collecting\".\n          # No USE action is appended.\n          return path\n\n    # 2. Explore next states by taking valid move actions (UP, DOWN, LEFT, RIGHT)\n    for action_idx in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n      dx_move, dy_move = _action_to_delta[action_idx]\n      next_x, next_y = x + dx_move, y + dy_move\n      next_dir = _action_to_dir[action_idx] # The agent's new direction after this move action\n\n      # Check if the new agent position is within grid boundaries\n      if not (0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT):\n        continue # Out of bounds\n\n      # Check if the new agent position contains any obstacle (non-grabbable item).\n      # The agent cannot move into a cell that contains an obstacle.\n      is_obstacle = False\n      for obstacle_kind_idx in non_grabbable_obstacle_indices:\n        # If the cell at (next_x, next_y) has any quantity of an obstacle kind, it's an obstacle.\n        # Grid indexing is (x, y, kind_idx)\n        if grid[next_x, next_y, obstacle_kind_idx] > 0:\n          is_obstacle = True\n          break # Found an obstacle, cannot move here\n      \n      if is_obstacle:\n        continue # Skip this cell, it's an obstacle\n\n      next_state_key = (next_x, next_y, next_dir)\n      # If this new state (position + direction) hasn't been visited yet, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state_key, path + [action_idx]))\n\n  # If the BFS completes without finding any path to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:06:14.389470", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Check if the primitive is already in inventory (if it's a grabbable item).\n  # If so, no actions are needed to collect it.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions are typically: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT).\n  # Format: action_id: (row_delta, col_delta, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), \n      craft.RIGHT: (  0,  1, 1),\n      craft.DOWN:  (  1,  0, 2),\n      craft.LEFT:  (  0, -1, 3)\n  }\n  \n  # Define the spatial delta for the cell directly in front of the agent,\n  # based on its current facing direction.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # Facing North (UP)\n      1: (0, 1),   # Facing East (RIGHT)\n      2: (1, 0),   # Facing South (DOWN)\n      3: (0, -1)   # Facing West (LEFT)\n  }\n\n  # Cache frequently used environment indices for efficient lookup.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Pre-calculate a set of non-grabbable entities that *explicitly* block movement.\n  # This excludes workshops (which are walkable) and water/stone (which are handled separately\n  # as global impassable terrains). This makes the _is_walkable function more explicit.\n  blocking_non_grabbables = set()\n  for idx in non_grabbable_indices:\n      if idx != water_index and idx != stone_index and idx not in workshop_indices:\n          blocking_non_grabbables.add(idx)\n\n  # Helper function to determine if a given grid cell (r, c) is walkable by the agent.\n  def _is_walkable(r, c):\n      # First, check if the cell is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # Check if the cell contains globally impassable terrain like water or stone.\n      if current_state.grid[r, c, water_index] == 1 or\\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # Check for other non-grabbable entities that are defined as blocking.\n      for idx in blocking_non_grabbables:\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      # If none of the above conditions are met, the cell is considered walkable.\n      return True\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (row, col, current_facing_direction, list_of_actions_taken)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is uniquely defined by (row, col, current_facing_direction).\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform BFS to find the shortest sequence of actions to collect *any* instance of the primitive.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current agent state (position and direction) satisfies the collection goal.\n      if primitive_idx in grabbable_indices:\n          # For grabbable items (e.g., WOOD, GRASS), the agent simply needs to move onto the item's cell.\n          # If the current cell (r, c) contains the primitive, we've reached it.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found to a grabbable item's location.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items (e.g., WATER, STONE, WORKSHOP), the agent needs to be\n          # adjacent to the item and facing it, then perform the 'USE' action.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check bounds for the cell directly in front of the agent.\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the primitive, we can collect it.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore all possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the next cell is a valid and walkable location.\n          if _is_walkable(next_r, next_c):\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              # If this new state hasn't been visited before, add it to the queue\n              # and mark it as visited.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the BFS queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:06:15.579140", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  WIDTH, HEIGHT, _ = current_state.grid.shape\n\n  # 1. Optimization: If the primitive is a grabbable item and already in the agent's inventory,\n  # no actions are needed. Return an empty list of actions.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Define agent movement actions and their effects on position and direction.\n  # Directions are typically: 0 (North/UP), 1 (East/RIGHT), 2 (South/DOWN), 3 (West/LEFT).\n  # Format: action_id: (row_delta, col_delta, new_facing_direction_after_move)\n  MOVE_ACTIONS = {\n      craft.UP:    ( -1,  0, 0), # Move up, new direction North\n      craft.RIGHT: (  0,  1, 1), # Move right, new direction East\n      craft.DOWN:  (  1,  0, 2), # Move down, new direction South\n      craft.LEFT:  (  0, -1, 3)  # Move left, new direction West\n  }\n  \n  # Define the spatial delta for the cell directly in front of the agent,\n  # based on its current facing direction. This is used for 'USE' actions.\n  DIR_TO_DELTA = {\n      0: (-1, 0),  # Facing North: cell in front is one row up\n      1: (0, 1),   # Facing East: cell in front is one col right\n      2: (1, 0),   # Facing South: cell in front is one row down\n      3: (0, -1)   # Facing West: cell in front is one col left\n  }\n\n  # Cache frequently used environment indices for efficient lookup in _is_walkable.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  grabbable_indices = env.world.grabbable_indices\n  workshop_indices = env.world.workshop_indices\n  water_index = env.world.water_index\n  stone_index = env.world.stone_index\n\n  # Helper function to determine if a given grid cell (r, c) is walkable by the agent.\n  # A cell is walkable if it's within bounds and does not contain impassable objects.\n  def _is_walkable(r, c):\n      # 1. Check if the cell is within the grid boundaries.\n      if not (0 <= r < WIDTH and 0 <= c < HEIGHT):\n          return False\n      \n      # 2. Check if the cell contains globally impassable terrain like water or stone.\n      if current_state.grid[r, c, water_index] == 1 or \\\n         current_state.grid[r, c, stone_index] == 1:\n          return False\n\n      # 3. Check for other non-grabbable entities that block movement.\n      # Workshops are special non-grabbable entities that the agent *can* walk onto.\n      for idx in non_grabbable_indices:\n          # Skip water, stone (already checked as strictly impassable), and workshop indices\n          # (which are explicitly considered walkable for agent interaction).\n          if idx == water_index or idx == stone_index or idx in workshop_indices:\n              continue \n          \n          # If the cell contains any *other* non-grabbable item, it's blocked.\n          if current_state.grid[r, c, idx] == 1:\n              return False \n      \n      # If none of the above conditions make the cell impassable, it's considered walkable.\n      return True\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple:\n  # (current_row, current_col, current_facing_direction, list_of_actions_taken_to_reach_this_state)\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is uniquely defined by (row, col, current_facing_direction).\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Perform BFS to find the shortest sequence of actions.\n  while q:\n      r, c, current_dir, path = q.popleft()\n\n      # Check if the current agent state (position and direction) satisfies the collection goal.\n      if primitive_idx in grabbable_indices:\n          # For grabbable items (e.g., WOOD, GRASS), the agent collects them by walking onto their cell.\n          # If the current cell (r, c) contains the target primitive, we've reached it.\n          if current_state.grid[r, c, primitive_idx] == 1:\n              return path # Path found to a grabbable item's location.\n      elif primitive_idx in non_grabbable_indices:\n          # For non-grabbable items (e.g., WATER, WORKSHOP), the agent needs to be\n          # adjacent to the item and facing it, then perform the 'USE' action.\n          \n          # Calculate the coordinates of the cell directly in front of the agent.\n          front_r, front_c = r + DIR_TO_DELTA[current_dir][0], c + DIR_TO_DELTA[current_dir][1]\n          \n          # Check if the 'front' cell is within grid bounds.\n          if 0 <= front_r < WIDTH and 0 <= front_c < HEIGHT:\n              # If the cell in front contains the target primitive, we can collect it using 'USE'.\n              if current_state.grid[front_r, front_c, primitive_idx] == 1:\n                  return path + [craft.USE] # Path found, append the USE action.\n\n      # Explore all possible movement actions from the current state.\n      for action_id, (dr, dc, next_dir_after_move) in MOVE_ACTIONS.items():\n          next_r, next_c = r + dr, c + dc\n\n          # Check if the potential next cell is valid and walkable.\n          if _is_walkable(next_r, next_c):\n              # Define the new state (position and direction) after this move.\n              next_state_tuple = (next_r, next_c, next_dir_after_move)\n              \n              # If this new state hasn't been visited before, add it to the queue\n              # and mark it as visited to avoid cycles.\n              if next_state_tuple not in visited:\n                  visited.add(next_state_tuple)\n                  q.append((next_r, next_c, next_dir_after_move, path + [action_id]))\n\n  # If the BFS queue becomes empty and no path was found to any instance of the primitive,\n  # it means the primitive is unreachable or not present on the grid.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-01T22:07:15.414767", "function_name": "collect", "function_body": "  state = env._current_state\n  primitive_id = env.world.cookbook.index.get(primitive)\n\n  if primitive_id is None:\n      # The requested primitive name does not exist in the cookbook's index.\n      return []\n\n  current_row, current_col = state.pos\n  grid = state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  action_specs = env.action_specs()\n  UP_ACTION = action_specs['UP']\n  DOWN_ACTION = action_specs['DOWN']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  move_deltas_to_action = {\n      (-1, 0): UP_ACTION,\n      (1, 0): DOWN_ACTION,\n      (0, -1): LEFT_ACTION,\n      (0, 1): RIGHT_ACTION\n  }\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] # For BFS neighbors (4-connected)\n\n  # 1. Check if primitive is already in inventory\n  if state.inventory[primitive_id] > 0:\n      return []\n\n  # Define entities that are generally impassable for agent movement.\n  # Water is typically impassable. Boundary (if defined) should also be impassable.\n  impassable_for_movement_general = {env.world.water_index}\n  if 'BOUNDARY' in env.world.cookbook.index:\n      impassable_for_movement_general.add(env.world.cookbook.index['BOUNDARY'])\n\n  # Helper function to check if a cell (nr, nc) is traversable during pathfinding.\n  # target_p_id_for_collection: If the agent is trying to 'collect' this ID by standing on it\n  # (e.g., water), then this specific ID is *not* considered impassable for the path.\n  def is_traversable_for_path(r, c, target_p_id_for_collection=None):\n      # Check bounds\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False\n      \n      # Check if the cell contains any generally impassable entities.\n      for idx in impassable_for_movement_general:\n          # If the current impassable entity is the specific item we are trying to collect\n          # by walking onto its cell (e.g., water), then allow traversal onto it.\n          if idx == target_p_id_for_collection and grid[r, c, idx] > 0:\n              continue # This specific 'impassable' is the target, so allow passage\n          \n          # If the cell contains any other impassable entity, it's not traversable.\n          if grid[r, c, idx] > 0:\n              return False # Not traversable due to this obstacle\n      return True # Cell is traversable\n\n  # 2. Determine target cells for BFS and whether a USE action is needed.\n  target_cells_for_bfs_approach = set() # Cells the agent needs to pathfind *to*\n  add_use_action_at_end = False # Flag to append USE_ACTION if needed\n\n  # Case A: Primitive is grabbable (e.g., WOOD, IRON, GRASS). Requires a USE action.\n  if primitive_id in env.world.grabbable_indices:\n      add_use_action_at_end = True\n      # Agent needs to reach a cell in the 3x3 neighborhood of a primitive instance.\n      for r_obj in range(HEIGHT):\n          for c_obj in range(WIDTH):\n              if grid[r_obj, c_obj, primitive_id] > 0: # Found an instance of the primitive\n                  # Add all traversable cells in its 3x3 neighborhood as BFS targets.\n                  for dr_adj in [-1, 0, 1]:\n                      for dc_adj in [-1, 0, 1]:\n                          nr, nc = r_obj + dr_adj, c_obj + dc_adj\n                          # For grabbable items, pathfinding should avoid water/boundary.\n                          if is_traversable_for_path(nr, nc): \n                              target_cells_for_bfs_approach.add((nr, nc))\n\n  # Case B: Primitive is water. Special non-grabbable but collected by standing on it.\n  elif primitive_id == env.world.water_index:\n      add_use_action_at_end = False # No USE action needed, collection happens by moving onto.\n      # Agent needs to reach the cell containing water.\n      for r_obj in range(HEIGHT):\n          for c_obj in range(WIDTH):\n              if grid[r_obj, c_obj, primitive_id] > 0: # Found a water cell\n                  # Crucially, for pathfinding to water, we allow moving onto water cells.\n                  if is_traversable_for_path(r_obj, c_obj, primitive_id): \n                      target_cells_for_bfs_approach.add((r_obj, c_obj))\n\n  # Case C: Other non-grabbable entities (e.g., WORKSHOP, BOUNDARY).\n  # These are not 'collected' in the sense of adding to inventory by this function.\n  else:\n      return [] # Not a collectable primitive for this function\n\n  if not target_cells_for_bfs_approach:\n      # No valid target cells found (e.g., primitive not present or all surrounding cells are impassable).\n      return []\n\n  # 3. BFS to find the shortest path to any of the target cells.\n  queue = collections.deque([(current_row, current_col, [])]) # (row, col, list_of_actions_to_reach_here)\n  visited = {(current_row, current_col)} # Keep track of visited positions to avoid cycles\n\n  shortest_path_actions = None\n\n  while queue:\n      r, c, path = queue.popleft()\n\n      # If the current position is one of our target cells, we found a shortest path.\n      if (r, c) in target_cells_for_bfs_approach:\n          shortest_path_actions = path\n          break # Found the shortest path, exit BFS\n\n      # Explore valid neighbors (Up, Down, Left, Right)\n      for dr, dc in DELTAS:\n          nr, nc = r + dr, c + dc\n          \n          # Determine the 'target_p_id_for_collection' for the traversability check.\n          # This is only relevant if we are collecting water by walking on it.\n          target_for_check = primitive_id if not add_use_action_at_end else None\n          \n          if (nr, nc) not in visited and is_traversable_for_path(nr, nc, target_for_check):\n              visited.add((nr, nc))\n              new_path = list(path) # Create a copy of the path\n              new_path.append(move_deltas_to_action[(dr, dc)]) # Add the action to reach (nr, nc)\n              queue.append((nr, nc, new_path))\n              \n  if shortest_path_actions is None:\n      # No path found to any target cell after exhausting the queue.\n      return []\n\n  # 4. Append USE action if the primitive type requires it.\n  if add_use_action_at_end:\n      shortest_path_actions.append(USE_ACTION)\n\n  return shortest_path_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T22:07:16.595714", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.get(primitive)\n  if i_primitive is None:\n      # Primitive name not found in cookbook index\n      return []\n\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  # Assuming grid.shape is (num_rows, num_cols, num_kinds)\n  # and current_pos is (row, col)\n  NUM_ROWS, NUM_COLS, _ = grid.shape \n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Mapping of (dr, dc) to action for moving\n  move_deltas_to_action = {\n      (-1, 0): UP,    # (delta_row, delta_col) for UP\n      (1, 0): DOWN,   # (delta_row, delta_col) for DOWN\n      (0, -1): LEFT,  # (delta_row, delta_col) for LEFT\n      (0, 1): RIGHT,  # (delta_row, delta_col) for RIGHT\n  }\n  # Standard 4-directional moves for BFS exploration\n  DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  # 1. Check if primitive is already in inventory\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # 2. Ensure the primitive is grabbable. 'collect' implies picking up into inventory.\n  # If the primitive is a non-grabbable entity (like a workshop or a boundary),\n  # this function should not attempt to 'collect' it.\n  if i_primitive not in env.world.grabbable_indices:\n    return []\n\n  # Define impassable terrain for movement.\n  # Water and Boundary are typically obstacles that cannot be moved onto.\n  impassable_kinds_indices = set()\n  if env.world.water_index is not None:\n      impassable_kinds_indices.add(env.world.water_index)\n  if 'BOUNDARY' in env.world.cookbook.index:\n      impassable_kinds_indices.add(env.world.cookbook.index['BOUNDARY'])\n  # Other non-grabbable items like WORKSHOPs are generally traversable.\n\n  # Helper function to check if a cell is traversable for agent movement.\n  # A cell is traversable if it's within grid bounds and does not contain any known impassable entity.\n  def is_cell_traversable(r, c):\n      # Check bounds\n      if not (0 <= r < NUM_ROWS and 0 <= c < NUM_COLS):\n          return False \n      # Check if the cell contains any known impassable obstacle\n      for idx in impassable_kinds_indices:\n          if grid[r, c, idx] > 0:\n              return False \n      return True\n\n  # 3. Perform Breadth-First Search (BFS) for the shortest path\n  # The goal is to find a position from which the agent can successfully 'USE'\n  # to collect the target primitive.\n  queue = collections.deque([(current_pos, [])]) # (position: (row, col), list_of_actions_to_reach_position)\n  visited = {current_pos} # Set of visited positions to avoid cycles\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # Create a temporary CraftState to check the `next_to` condition at the current BFS position.\n    # The `scenario`, `dir`, and `inventory` typically remain constant during pathfinding.\n    temp_state = craft.CraftState(\n        scenario=current_state.scenario, \n        grid=grid, \n        pos=(r, c), \n        dir=current_state.dir, \n        inventory=current_state.inventory\n    )\n    \n    # Check if the current BFS position (r, c) is a goal state:\n    # A goal state is any position from which the agent's `next_to` method\n    # indicates that the primitive is within range for the 'USE' action.\n    if temp_state.next_to(i_primitive):\n        # Found the shortest path to a suitable position.\n        # Append the USE action as the final step.\n        return path + [USE] \n\n    # Explore valid 4-connected neighbors (Up, Down, Left, Right)\n    for dr, dc in DELTAS:\n      nr, nc = r + dr, c + dc # Next row, next column\n\n      # Check if the neighbor cell is traversable and has not been visited yet\n      if is_cell_traversable(nr, nc) and (nr, nc) not in visited:\n        visited.add((nr, nc))\n        action_to_take = move_deltas_to_action[(dr, dc)]\n        queue.append(((nr, nc), path + [action_to_take]))\n\n  # 4. If the BFS queue is exhausted and no path was found, the primitive is unreachable.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-01T22:08:03.177770", "function_name": "collect", "function_body": "  state = env._current_state\n  cookbook = env.world.cookbook\n  grid = state.grid\n  \n  # 1. Get the integer ID for the primitive from the cookbook's index.\n  primitive_idx = cookbook.index[primitive] \n  if primitive_idx is None:\n    # Primitive name not found in cookbook, cannot collect.\n    return []\n\n  # Get numerical action IDs from the environment's action_specs.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define possible movements as (dx, dy, action_id).\n  MOVES = [\n      (0, -1, ACTION_UP),    # Move North (Up)\n      (0, 1, ACTION_DOWN),   # Move South (Down)\n      (-1, 0, ACTION_LEFT),  # Move West (Left)\n      (1, 0, ACTION_RIGHT),  # Move East (Right)\n  ]\n\n  # Get grid dimensions for boundary checks.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Agent's current position to start the BFS.\n  start_pos = state.pos\n\n  # Identify indices of entities that block movement.\n  # Water and Boundary are typically impassable terrain for movement,\n  # unless the primitive we are trying to collect is itself water or boundary.\n  blocking_indices = []\n  if env.world.water_index is not None:\n    blocking_indices.append(env.world.water_index)\n  if 'BOUNDARY' in cookbook.index.contents and cookbook.index['BOUNDARY'] is not None:\n    blocking_indices.append(cookbook.index['BOUNDARY'])\n\n  # BFS initialization:\n  # q: A deque storing tuples of (current_position, list_of_actions_taken_to_reach_current_position).\n  # visited: A set to keep track of visited grid positions to prevent cycles and redundant exploration.\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos} \n\n  # Determine the 'collection' criteria based on the primitive's type.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # Special stationary primitives that are 'collected' by simply reaching their location.\n  is_stationary_primitive = (primitive_idx == env.world.water_index or \n                             primitive_idx == env.world.stone_index or \n                             primitive_idx == cookbook.index['BOUNDARY'])\n  \n  # BFS loop to find the shortest path.\n  while q:\n    current_pos, current_actions = q.popleft()\n\n    # Create a temporary CraftState at the `current_pos`. This allows us to leverage\n    # CraftState's methods (like `next_to`) as if the agent were physically there,\n    # without actually modifying the environment's state.\n    # Agent's direction and inventory are kept constant as they are not relevant for pathfinding\n    # geometry or immediate primitive checks.\n    temp_state_at_pos = craft.CraftState(state.scenario, state.grid, current_pos, state.dir, state.inventory)\n\n    # Check if the current position satisfies the goal condition for collecting the primitive.\n    # Since it's BFS on an unweighted grid, the first time we find a goal, it's the shortest path.\n    if is_grabbable:\n      # For grabbable items (e.g., 'WOOD', 'IRON'), the agent needs to be adjacent to them\n      # and then perform a 'USE' action.\n      if temp_state_at_pos.next_to(primitive_idx):\n        return current_actions + [ACTION_USE]\n    elif is_workshop or is_stationary_primitive:\n      # For workshops, 'water', 'stone', or 'BOUNDARY', 'collecting' means being *on* that location.\n      # Check if the primitive is present in the current cell.\n      if temp_state_at_pos.grid[current_pos[0], current_pos[1], primitive_idx] > 0:\n        return current_actions # No 'USE' action is typically needed to \"collect\" these.\n    \n    # If the current position is not the goal, explore its unvisited neighbors.\n    for dx, dy, action in MOVES:\n      new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n      new_pos = (new_x, new_y)\n\n      # Check if the new position is within the grid boundaries.\n      if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT:\n        # Check if the new position is blocked by impassable terrain.\n        is_blocked = False\n        for blocking_idx in blocking_indices:\n          # A cell is blocked if it contains a blocking item AND that item is not our target.\n          if blocking_idx != primitive_idx and grid[new_x, new_y, blocking_idx] > 0:\n            is_blocked = True\n            break\n        \n        # If not blocked and not visited, add to queue.\n        if not is_blocked and new_pos not in visited:\n          visited.add(new_pos)\n          q.append((new_pos, current_actions + [action]))\n  \n  # If the BFS completes and the queue becomes empty, it means no path to the primitive was found.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
