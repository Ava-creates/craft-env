   shortest_path = path_to_primitive\n\n  # Ensure the agent has a tool if needed (e.g., BRIDGE to cross WATER)\n  tools_needed = {\n      'WATER': ['BRIDGE'],\n      'ROCK': ['PICKAXE']\n  }\n  i_primitive = env.world.cookbook.index[primitive]\n  obstacles_to_avoid = []\n\n  for obj in env.world.cookbook.objects():\n      if grid[:, :, obj].sum() > 0:\n          obstacle_pos = np.argwhere(grid[:, :, obj] > 0)\n          for pos in obstacle_pos:\n              pos_tuple = (pos[0], pos[1])\n              if any(grid[pos[0], pos[1], tool] > 0 for tool in tools_needed.get(obj, [])):\n                  continue\n              obstacles_to_avoid.append(pos_tuple)\n\n  def can_use_tool(tool):\n      return current_state.inventory[env.world.cookbook.index[tool]] > 0\n\n  actions = []\n  if shortest_path:\n      for i in range(len(shortest_path) - 1):\n          from_pos = shortest_path[i]\n          to_pos = shortest_path[i + 1]\n          dx = to_pos[0] - from_pos[0]\n          dy = to_pos[1] - from_pos[1]\n\n          if (to_pos in obstacles_to_avoid and\n              any(can_use_tool(tool) for tool in tools_needed.get(env.world.cookbook.index_at_position(to_pos), []))):\n              # Use the appropriate tool before moving\n              actions.append(action_map['USE'])\n\n          if dx == 1:\n              actions.append(action_map['RIGHT'])\n          elif dx == -1:\n              actions.append(action_map['LEFT'])\n          elif dy == 1:\n              actions.append(action_map['DOWN'])\n          elif dy == -1:\n              actions.append(action_map['UP'])\n\n      # Ensure the agent picks up the primitive once it reaches the position\n      if grid[shortest_path[-1][0], shortest_path[-1][1], i_primitive] > 0:\n          actions.append(action_map['USE'])\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-03T08:14:45.573353", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Placeholder for actual tool determination logic based on the world's rules\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], start_pos[2], [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, pos_direction, path + [(dx, dy)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = (current_state.pos[0], current_state.pos[1], current_state.dir)\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if not path_to_primitive:\n      print(f\"No path found to collect {primitive}.\")\n      return actions\n\n  for (dx, dy) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n      # Determine direction based on relative position\n      target_direction = None\n      if dx == 0 and dy == -1:\n          target_direction = \"UP\"\n      elif dx == 0 and dy == 1:\n          target_direction = \"DOWN\"\n      elif dx == -1 and dy == 0:\n          target_direction = \"LEFT\"\n      elif dx == 1 and dy == 0:\n          target_direction = \"RIGHT\"\n\n      # Align the agent to the target direction\n      while current_state.dir != ACTION_MAP[target_direction]:\n          actions.append((current_state.dir + 1) % 4 if current_state.dir < 3 else 0)\n      \n      # Move towards the target position\n      actions.append(ACTION_MAP[target_direction])\n\n  # Collect the primitive\n  actions.append(ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-03T08:14:46.557480", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Placeholder for actual tool determination logic based on the world's rules\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], start_pos[2], [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, (pos_direction + 1) % 4, path + [(dx, dy)]))\n      return None\n\n  def align_and_collect(pos, target_pos, actions, use_tool=False):\n      dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n      \n      if dy < 0:\n          while current_state.dir != 0:  # UP\n              current_state.dir = (current_state.dir - 1) % 4\n              actions.append(ACTION_MAP[\"UP\"])\n          for _ in range(abs(dy)):\n              actions.append(ACTION_MAP[\"UP\"])\n      elif dy > 0:\n          while current_state.dir != 1:  # DOWN\n              current_state.dir = (current_state.dir + 1) % 4\n          for _ in range(abs(dy)):\n              actions.append(ACTION_MAP[\"DOWN\"])\n      if dx < 0:\n          while current_state.dir != 2:  # LEFT\n              current_state.dir = (current_state.dir - 1) % 4\n          for _ in range(abs(dx)):\n              actions.append(ACTION_MAP[\"LEFT\"])\n      elif dx > 0:\n          while current_state.dir != 3:  # RIGHT\n              current_state.dir = (current_state.dir + 1) % 4\n          for _ in range(abs(dx)):\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      if use_tool:\n          actions.append(ACTION_MAP[\"USE\"])\n      \n      return target_pos\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = (current_state.pos[0], current_state.pos[1], current_state.dir)\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if not path_to_primitive:\n      print(f\"No path found to collect {primitive}.\")\n      return actions\n\n  for (dx, dy) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n      # Determine direction based on relative position\n      if dx == 0 and dy == -1:\n          actions.append(ACTION_MAP[\"UP\"])\n      elif dx == 0 and dy == 1:\n          actions.append(ACTION_MAP[\"DOWN\"])\n      elif dx == -1 and dy == 0:\n          actions.append(ACTION_MAP[\"LEFT\"])\n      elif dx == 1 and dy == 0:\n          actions.append(ACTION_MAP[\"RIGHT\"])\n\n  # Collect the primitive\n  align_and_collect(pos[:-1], path_to_primitive[-1], actions, use_tool=True)\n  \n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T08:16:21.717440", "function_name": "collect", "function_body": "  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path_with_tools(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction, current_inventory):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and current_inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction, inventory):\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path_with_tools(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
