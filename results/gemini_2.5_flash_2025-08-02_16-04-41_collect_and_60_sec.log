 + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y, current_state.dir)\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-03T16:34:57.580563", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, tool_needed=None):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T16:36:38.608485", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [], [])])  # (x, y, path, direction_history)\n      visited = set()\n      while queue:\n          x, y, path, direction_history = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)], direction_history[-1]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_direction = (dx, dy)\n                  queue.append((nx, ny, path + [(nx, ny)], direction_history + [new_direction]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive, final_direction = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = ACTION_MAP[\"UP\"]\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = ACTION_MAP[\"DOWN\"]\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = ACTION_MAP[\"LEFT\"]\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = ACTION_MAP[\"RIGHT\"]\n\n          if current_state.dir != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T16:36:39.640829", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # LEFT, RIGHT, UP, DOWN\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [], [])])  # (x, y, path, direction_history)\n      visited = set()\n      while queue:\n          x, y, path, direction_history = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)], direction_history[-1]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_direction = get_action_from_delta(dx, dy)\n                  queue.append((nx, ny, path + [(nx, ny)], direction_history + [new_direction]))\n      return None\n\n  def get_action_from_delta(dx: int, dy: int) -> int:\n      if dx == 0 and dy < 0:  # LEFT\n          return ACTION_MAP[\"LEFT\"]\n      elif dx == 0 and dy > 0:  # RIGHT\n          return ACTION_MAP[\"RIGHT\"]\n      elif dx < 0 and dy == 0:  # UP\n          return ACTION_MAP[\"UP\"]\n      elif dx > 0 and dy == 0:  # DOWN\n          return ACTION_MAP[\"DOWN\"]\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive, final_direction = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          target_direction = get_action_from_delta(dx, dy)\n\n          if current_state.dir != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
