           \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          if dx == 0 and dy < 0:\n              target_direction = \"UP\"\n          elif dx == 0 and dy > 0:\n              target_direction = \"DOWN\"\n          elif dx < 0 and dy == 0:\n              target_direction = \"LEFT\"\n          elif dx > 0 and dy == 0:\n              target_direction = \"RIGHT\"\n\n          if current_direction != target_direction:\n              actions.append(ACTION_MAP[target_direction])\n              current_state.dir = ACTION_MAP[target_direction]\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T15:08:46.276787", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          if dx == 0 and dy < 0:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy > 0:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx < 0 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T15:10:15.791621", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def determine_tool(kind_index):\n      kind_name = current_state.world.cookbook.index.get(kind_index)\n      if kind_name == \"WATER\":\n          return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n      elif kind_name == \"ROCK\":\n          return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n      else:\n          return None\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      queue = deque([(start_pos, current_state.dir, [])])\n      visited = set()\n      while queue:\n          pos, _, path = queue.popleft()\n          x, y = pos\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [pos]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny):\n                  queue.append((new_pos, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          actions.append(ACTION_MAP[\"UP\" if dy == -1 else \"DOWN\" if dy == 1 else \"LEFT\" if dx == -1 else \"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T15:10:16.773174", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def determine_tool(kind_index):\n      kind_name = current_state.world.cookbook.index.get(kind_index)\n      tool_map = {\n          \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n          \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n          \"BOUNDARY\": None,                          # Boundary does not require a tool\n          \"WOOD\": None,\n          \"IRON\": None,\n          \"GRASS\": None,\n          \"GOLD\": None,\n          \"GEM\": current_state.world.stone_index     # Assuming gems need a pickaxe tool\n      }\n      return tool_map.get(kind_name)\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      queue = deque([(start_pos, current_state.dir, [])])\n      visited = set()\n      while queue:\n          pos, _, path = queue.popleft()\n          x, y = pos\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [pos]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny):\n                  queue.append((new_pos, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T15:11:57.477161", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))  # Note: pos_direction remains unchanged here\n      return None\n\n  def compute_path_actions(path, start_pos, current_direction):\n      actions = []\n      for (x, y) in path[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - start_pos[0], y - start_pos[1]\n          \n          if dx == 0 and dy < 0:\n              target_direction = \"UP\"\n          elif dx == 0 and dy > 0:\n              target_direction = \"DOWN\"\n          elif dx < 0 and dy == 0:\n              target_direction = \"LEFT\"\n          elif dx > 0 and dy == 0:\n              target_direction = \"RIGHT\"\n\n          if current_direction != ACTION_MAP[target_direction]:\n              actions.append(ACTION_MAP[target_direction])\n              current_direction = ACTION_MAP[target_direction]\n\n          actions.append(ACTION_MAP[\"USE\"])\n      return actions\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      actions.extend(compute_path_actions(path_to_primitive, pos, current_state.dir))\n      actions.append(ACTION_MAP[\"USE\"])  # Collect the primitive\n\n  return actions", "island_id": 3, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T15:11:58.465063", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  new_pos_direction = (dx, dy)\n                  queue.append((nx, ny, current_state.dir, path + [(nx, ny)]))  # Note: pos_direction remains unchanged here\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          if dx == 0 and dy < 0:\n              target_direction = \"UP\"\n          elif dx == 0 and dy > 0:\n              target_direction = \"DOWN\"\n          elif dx < 0 and dy == 0:\n              target_direction = \"LEFT\"\n          elif dx > 0 and dy == 0:\n              target_direction = \"RIGHT\"\n\n          if current_direction != target_direction:\n              actions.append(ACTION_MAP[target_direction])\n              current_state.dir = ACTION_MAP[target_direction]\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T15:13:44.084055", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_pos_direction):\n                  queue.append((nx, ny, new_pos_direction, path + [(nx, ny)]))\n      return None\n\n  def calculate_turns(current_dir, target_dir):\n      \"\"\"Calculate the number of turns needed to face the target direction.\"\"\"\n      dirs = [(-1, 0), (0, -1), (1, 0), (0, 1)]\n      current_idx = dirs.index(current_dir)\n      target_idx = dirs.index(target_dir)\n\n      # Calculate the difference in indices\n      diff = (target_idx - current_idx) % len(dirs)\n      \n      if diff == 1:\n          return [ACTION_MAP[\"RIGHT\"]]\n      elif diff == 2:\n          return [ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"RIGHT\"]]\n      elif diff == 3:\n          return [ACTION_MAP[\"LEFT\"]]\n      else:\n          return []\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          target_direction = (dx, dy)\n\n          turns_needed = calculate_turns(current_state.dir, target_direction)\n          actions.extend(turns_needed)\n\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n          # Update the current position\n          pos = (x, y)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
