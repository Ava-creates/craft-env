for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T09:53:38.144802", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  current_state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor, path):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  def is_valid_move(pos, path):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return (0 <= x < width and 0 <= y < height) and not env.world.cookbook.index['BOUNDARY'] in current_state.grid[x, y]\n\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  def use_tool(tool):\n      tool_index = env.world.cookbook.index[tool]\n      if tool_index < len(current_state.inventory) and current_state.inventory[tool_index] > 0:\n          actions.append(action_map['USE'])\n          return True\n      return False\n  \n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n      # Check for WATER and use BRIDGE if available\n      if env.world.cookbook.index['WATER'] in current_state.grid[to_pos[0], to_pos[1]]:\n          if not use_tool('BRIDGE'):\n              raise ValueError(\"No BRIDGE available to cross the water.\")\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n\n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T09:53:39.118782", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  current_state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def bfs(start, goal, tools_needed=[]):\n      queue = collections.deque([(start, [], [])])  # (current_pos, path, used_tools)\n      visited = set([start])\n\n      while queue:\n          pos, path, used_tools = queue.popleft()\n          if pos == goal:\n              return path, used_tools\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor, path, used_tools):\n                  new_path = path + [neighbor]\n                  new_used_tools = used_tools.copy()\n                  for tool, usage_positions in tools_needed.items():\n                      if neighbor in usage_positions:\n                          i_tool = env.world.cookbook.index[tool]\n                          if current_state.grid[pos[0], pos[1], i_tool] > 0 and tool not in used_tools:\n                              new_used_tools.append(tool)\n                              break\n                  visited.add(neighbor)\n                  queue.append((neighbor, new_path, new_used_tools))\n\n      return None, []\n\n  def is_valid_move(pos, path, used_tools):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      if env.world.cookbook.index['BOUNDARY'] in current_state.grid[x, y]:\n          return False\n      \n      for tool, usage_positions in tools_needed.items():\n          if pos in usage_positions:\n              i_tool = env.world.cookbook.index[tool]\n              if current_state.grid[pos[0], pos[1], i_tool] > 0 and tool not in used_tools:\n                  return True\n      return True\n\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  def find_tool_positions(tool):\n      i_tool = env.world.cookbook.index[tool]\n      positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_tool] > 0:\n                  positions.append((x, y))\n      return positions\n\n  # Define the tools needed and their usage positions\n  tools_needed = {\n      'BRIDGE': find_tool_positions('WATER'),\n      'PICKAXE': find_tool_positions('GEM')\n  }\n\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  start_position = current_state.pos\n  path_to_primitive, used_tools = bfs(start_position, goal_position, tools_needed)\n\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n      # Use tool if needed at the current position\n      for tool in used_tools:\n          i_tool = env.world.cookbook.index[tool]\n          if current_state.grid[from_pos[0], from_pos[1], i_tool] > 0:\n              actions.append(action_map['USE'])\n  \n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-03T09:55:17.205547", "function_name": "collect", "function_body": "  from collections import deque\n  from numpy.linalg import norm\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T09:55:18.193974", "function_name": "collect", "function_body": "  from collections import deque\n  from numpy.linalg import norm\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = (dx, dy)\n\n          # Calculate direction to move\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n          # Update current position\n          pos = (x, y)\n\n      # Collect the primitive at the target cell\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T09:57:29.192311", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find all positions of the primitive in the grid\n  def find_all_primitive_positions(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  positions.append((x, y))\n      return positions\n\n  # Define a function to find the closest position of the primitive\n  def find_closest_primitive_position(start):\n      goal_positions = find_all_primitive_positions(primitive)\n      min_distance = float('inf')\n      closest_goal = None\n      for goal in goal_positions:\n          distance = abs(goal[0] - start[0]) + abs(goal[1] - start[1])\n          if distance < min_distance:\n              min_distance = distance\n              closest_goal = goal\n      return closest_goal\n\n  # Define a function to check if an obstacle can be overcome with available tools\n  def can_overcome_obstacle(pos, tool):\n      i_tool = env.world.cookbook.index[tool]\n      return current_state.inventory[i_tool] > 0\n\n  # Define the list of obstacles and corresponding tools\n  obstacles_and_tools = {\n      'WATER': 'BRIDGE',\n      'GEM_ROCK': 'PICKAXE'\n  }\n\n  # Find all positions of the primitive\n  goal_positions = find_all_primitive_positions(primitive)\n  if not goal_positions:\n      raise ValueError(f\"No instances of {primitive} found in the grid.\")\n\n  # Initialize shortest path to None\n  shortest_path = None\n\n  # Iterate over each goal position and find the shortest reachable path\n  start_position = current_state.pos\n  closest_goal = find_closest_primitive_position(start_position)\n  \n  if closest_goal:\n      if is_reachable_directly(start_position, closest_goal):\n          path_to_primitive = bfs(start_position, closest_goal)\n          if path_to_primitive:\n              shortest_path = path_to_primitive\n\n  # If no direct paths found, consider using tools\n  if not shortest_path:\n      for tool in obstacles_and_tools.values():\n          if current_state.inventory[env.world.cookbook.index[tool]] > 0:\n              # Find the position of the tool\n              tool_positions = find_all_primitive_positions(tool)\n              for tool_position in tool_positions:\n                  path_to_tool = bfs(start_position, tool_position)\n                  if path_to_tool:\n                      for goal_position in goal_positions:\n                          path_from_tool_to_primitive = bfs(tool_position, goal_position)\n                          if path_from_tool_to_primitive:\n                              full_path = path_to_tool + path_from_tool_to_primitive\n                              if shortest_path is None or len(full_path) < len(shortest_path):\n                                  shortest_path = full_path\n\n  # If still no valid path found, raise an error\n  if not shortest_path:\n      raise ValueError(f\"No valid path found to collect {primitive} with available tools.\")\n\n  # Convert the path to actions\n  actions = []\n  for i in range(len(shortest_path) - 1):\n      from_pos = shortest_path[i]\n      to_pos = shortest_path[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if shortest_path and current_state.grid[shortest_path[-1][0], shortest_path[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-03T09:57:30.180677", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find all positions of the primitive in the grid\n  def find_all_primitive_positions(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  positions.append((x, y))\n      return positions\n\n  # Define a function to check if the primitive can be reached directly\n  def is_reachable_directly(start, goal):\n      path = bfs(start, goal)\n      return path is not None\n\n  # Find all positions of the primitive\n  goal_positions = find_all_primitive_positions(primitive)\n  if not goal_positions:\n      raise ValueError(f\"No instances of {primitive} found in the grid.\")\n\n  # Define a function to check if an obstacle can be overcome with available tools\n  def can_overcome_obstacle(pos, tool):\n      i_tool = env.world.cookbook.index[tool]\n      return current_state.inventory[i_tool] > 0\n\n  # Initialize shortest path to None\n  shortest_path = None\n\n  # Define the list of obstacles and corresponding tools\n  obstacles_and_tools = {\n      'WATER': 'BRIDGE',\n      'GEM_ROCK': 'PICKAXE'\n  }\n\n  start_position = current_state.pos\n\n  # Check direct paths first\n  for goal_position in goal_positions:\n      if is_reachable_directly(start_position, goal_position):\n          path_to_primitive = bfs(start_position, goal_position)\n          if path_to_primitive and (shortest_path is None or len(path_to_primitive) < len(shortest_path)):\n              shortest_path = path_to_primitive\n\n  # If no direct paths found, consider using tools\n  if not shortest_path:\n      for obstacle, tool in obstacles_and_tools.items():\n          i_obstacle = env.world.cookbook.index[obstacle]\n          if current_state.inventory[env.world.cookbook.index[tool]] > 0:\n              # Find the position of the tool\n              tool_positions = find_all_primitive_positions(tool)\n              for tool_position in tool_positions:\n                  path_to_tool = bfs(start_position, tool_position)\n                  if path_to_tool:\n                      # Check if a path from the tool to any primitive exists\n                      for goal_position in goal_positions:\n                          path_from_tool_to_primitive = bfs(tool_position, goal_position)\n                          if path_from_tool_to_primitive:\n                              full_path = path_to_tool + path_from_tool_to_primitive\n                              if shortest_path is None or len(full_path) < len(shortest_path):\n                                  shortest_path = full_path\n\n  # If still no valid path found, raise an error\n  if not shortest_path:\n      raise ValueError(f\"No valid path found to collect {primitive} with available tools.\")\n\n  # Convert the path to actions\n  actions = []\n  for i in range(len(shortest_path) - 1):\n      from_pos = shortest_path[i]\n      to_pos = shortest_path[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if shortest_path and current_state.grid[shortest_path[-1][0], shortest_path[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T09:59:12.116429", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  current_state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return (0 <= x < width) and (0 <= y < height)\n\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  def can_use_tool(tool):\n      i_tool = env.world.cookbook.index[tool]\n      return current_state.inventory[i_tool] > 0\n\n  tool_requirements = {\n      'GOLD': 'PICKAXE',\n      'GEM': 'PICKAXE',\n      'STONE': None,\n      'WOOD': None,  # Assuming wood is directly collectible\n      # Add other primitives and their required tools here\n  }\n\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Check tool requirements before using the primitive\n  tool = tool_requirements.get(primitive)\n  if tool and not can_use_tool(tool):\n      raise ValueError(f\"Cannot collect {primitive} without a {tool}\")\n\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n\n  # Handle obstacles like water by using bridges\n  obstacle_actions = handle_obstacles(env, primitive)\n  if obstacle_actions:\n      actions.extend(obstacle_actions)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
