  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          current_direction = current_state.dir\n          \n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y)\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T19:32:58.974079", "function_name": "collect", "function_body": "  from collections import deque\n  import numpy as np\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define mapping of kind to required tools based on the world's rules\n          tool_map = {\n              \"WATER\": current_state.world.water_index,\n              \"GEM\": current_state.world.stone_index,\n              # Add more mappings as necessary\n          }\n          return tool_map.get(kind_name, None)\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          # Determine target direction based on relative position\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y)\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      dx, dy = path_to_primitive[-1][0] - pos[0], path_to_primitive[-1][1] - pos[1]\n      if dx == 0 and dy < 0:  # UP\n          target_direction = 0\n      elif dx == 0 and dy > 0:  # DOWN\n          target_direction = 1\n      elif dx < 0 and dy == 0:  # LEFT\n          target_direction = 2\n      elif dx > 0 and dy == 0:  # RIGHT\n          target_direction = 3\n\n      if current_state.dir != target_direction:\n          actions.append(target_direction)  # Add action to change direction\n\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-03T19:32:59.954134", "function_name": "collect", "function_body": "  from collections import deque\n  import heapq\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define mapping of kind to required tools based on the world's rules\n          tool_map = {\n              \"WATER\": current_state.world.water_index,\n              \"GEM\": current_state.world.stone_index,\n              # Add more mappings as necessary\n          }\n          return tool_map.get(kind_name, None)\n\n      priority_queue = []\n      heapq.heappush(priority_queue, (0, start_pos[0], start_pos[1], []))\n      visited = set()\n      \n      while priority_queue:\n          _, x, y, path = heapq.heappop(priority_queue)\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  heapq.heappush(priority_queue, (heuristic((nx, ny), start_pos) + len(path) + 1, nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y)\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      dx, dy = path_to_primitive[-1][0] - pos[0], path_to_primitive[-1][1] - pos[1]\n      if dx == 0 and dy < 0:  # UP\n          target_direction = 0\n      elif dx == 0 and dy > 0:  # DOWN\n          target_direction = 1\n      elif dx < 0 and dy == 0:  # LEFT\n          target_direction = 2\n      elif dx > 0 and dy == 0:  # RIGHT\n          target_direction = 3\n\n      if current_state.dir != target_direction:\n          actions.append(target_direction)  # Add action to change direction\n\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-03T19:34:39.191632", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define mappings for tools based on environment rules\n          if kind_name == \"WATER\":\n              bridge_index = current_state.world.cookbook.index.index(\"BRIDGE\")\n              if inventory[bridge_index] > 0:\n                  return bridge_index\n              boat_index = current_state.world.cookbook.index.index(\"BOAT\")\n              if inventory[boat_index] > 0:\n                  return boat_index\n          elif kind_name == \"ROCK\":\n              pickaxe_index = current_state.world.cookbook.index.index(\"PICKAXE\")\n              if inventory[pickaxe_index] > 0:\n                  return pickaxe_index\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if can_move(nx, ny):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          # Determine the required direction to move\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])  # Move and potentially use tool\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T19:34:40.212179", "function_name": "collect", "function_body": "  from collections import deque\n  import random\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              # Assuming bridge or boat is needed to cross water, use any tool for now\n              for tool_kind in range(len(inventory)):\n                  if inventory[tool_kind] > 0:\n                      tool_name = current_state.world.cookbook.index.get(tool_kind)\n                      if tool_name == \"BRIDGE\":  # Or other appropriate tools\n                          return tool_kind\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rock needs a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          random.shuffle(directions)  # Randomize movement to avoid getting stuck in loops\n\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if can_move(nx, ny):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])  # Move and potentially use tool\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T19:36:16.909639", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          # Determine target direction based on delta coordinates\n          if dx == 0 and dy < 0:  # UP\n              target_direction = ACTION_MAP[\"UP\"]\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = ACTION_MAP[\"DOWN\"]\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = ACTION_MAP[\"LEFT\"]\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = ACTION_MAP[\"RIGHT\"]\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y)  # Update position for the next iteration\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T19:36:17.897408", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T19:38:00.592316", "function_name": "collect", "function_body": "  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_mapping = {\n              \"ROCK\": env._current_state.world.stone_index,  # Assuming rocks need a pickaxe tool\n              \"WATER\": None,  # No specific tool needed for water, but might require bridge or boat\n              # Add more mappings as necessary\n          }\n          return tool_mapping.get(kind_name)\n\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos[0], start_pos[1], current_state.dir, []))\n      came_from = {}\n      g_score = {(start_pos[0], start_pos[1]): 0}\n      \n      while open_set:\n          _, x, y, pos_direction, path = heapq.heappop(open_set)\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny, pos_direction):\n                  tentative_g_score = g_score.get((x, y), 0) + 1\n                  \n                  if new_pos not in g_score or tentative_g_score < g_score[new_pos]:\n                      came_from[new_pos] = (x, y, path)\n                      g_score[new_pos] = tentative_g_score\n                      priority = tentative_g_score + heuristic(new_pos, start_pos)\n                      heapq.heappush(open_set, (priority, nx, ny, pos_direction, path + [new_pos]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          # Determine target direction based on movement\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          # Move in the new direction\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
