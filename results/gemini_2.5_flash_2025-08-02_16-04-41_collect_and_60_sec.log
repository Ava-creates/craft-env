entory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          direction_map = {(0, -1): \"UP\", (0, 1): \"DOWN\", (-1, 0): \"LEFT\", (1, 0): \"RIGHT\"}\n          action = direction_map.get((dx, dy))\n          if action:\n              actions.append(ACTION_MAP[action])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:52:56.250127", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define required tools for different kinds\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  def generate_actions(path):\n      actions = []\n      current_pos = env._current_state.pos\n      for (x, y) in path[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - current_pos[0], y - current_pos[1]\n          \n          if dx == 0 and dy < 0:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy > 0:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx < 0 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n      return actions\n\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      actions = generate_actions(path_to_primitive)\n  else:\n      actions = []\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:54:37.099891", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def determine_tool(kind_index, inventory):\n      kind_name = current_state.world.cookbook.index.get(kind_index)\n      \n      # Define tool mappings\n      if kind_name == \"WATER\":\n          for item in [\"BRIDGE\", \"BOAT\"]:\n              index = current_state.world.cookbook.index.index(item)\n              if inventory[index] > 0:\n                  return index\n      elif kind_name == \"ROCK\":\n          index = current_state.world.stone_index\n          if inventory[index] > 0:\n              return index\n      \n      # Add more mappings as needed\n\n      return None\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n      \n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind, inventory)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      \n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_position = (nx, ny)\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, pos_direction, path + [new_position]))\n      \n      return None\n\n  def get_direction(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      \n      dx, dy = tx - cx, ty - cy\n      \n      if dx == 0 and dy < 0:\n          return \"UP\"\n      elif dx == 0 and dy > 0:\n          return \"DOWN\"\n      elif dx < 0 and dy == 0:\n          return \"LEFT\"\n      elif dx > 0 and dy == 0:\n          return \"RIGHT\"\n      \n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          direction = get_direction(pos, (x, y))\n          actions.append(ACTION_MAP[direction])\n          pos = (x, y)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:54:38.080895", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Assuming specific mappings for demonstration purposes\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, (dx, dy), path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          # Determine the direction to move\n          if dx == 0 and dy == -1:\n              target_direction = \"UP\"\n          elif dx == 0 and dy == 1:\n              target_direction = \"DOWN\"\n          elif dx == -1 and dy == 0:\n              target_direction = \"LEFT\"\n          elif dx == 1 and dy == 0:\n              target_direction = \"RIGHT\"\n\n          # Turn towards the target direction\n          while current_direction != ACTION_MAP[target_direction]:\n              if (current_direction + 1) % 4 == ACTION_MAP[target_direction]:\n                  actions.append(ACTION_MAP[\"RIGHT\"])\n              else:\n                  actions.append(ACTION_MAP[\"LEFT\"])\n              current_direction = (current_direction + 1) % 4\n\n          # Move forward\n          actions.append(ACTION_MAP[target_direction])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
