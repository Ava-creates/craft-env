{"timestamp": "2025-08-03T16:16:09.397495", "function_name": "collect", "function_body": "  from collections import deque\n  from heapq import heappop, heappush\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], current_state.dir, []))\n      visited = set()\n      while queue:\n          cost, x, y, pos_direction, path = heappop(queue)\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_cost = cost + heuristic((nx, ny), start_pos) + 1  # Adding 1 to the cost for each step taken\n                  heappush(queue, (new_cost, nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          # Determine target direction based on movement vector\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T16:17:53.146897", "function_name": "collect", "function_body": "  from collections import deque\n  from heapq import heappop, heappush\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], start_pos[2], []))  # (cost, x, y, direction, path)\n      visited = set()\n      while queue:\n          cost, x, y, current_direction, path = heappop(queue)\n          if (x, y, current_direction) in visited:\n              continue\n          visited.add((x, y, current_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(current_direction, (x, y))]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  new_cost = cost + heuristic((nx, ny), start_pos)\n                  # Determine target direction based on movement vector\n                  if dx == 0 and dy < 0:  # UP\n                      target_direction = 0\n                  elif dx == 0 and dy > 0:  # DOWN\n                      target_direction = 1\n                  elif dx < 0 and dy == 0:  # LEFT\n                      target_direction = 2\n                  elif dx > 0 and dy == 0:  # RIGHT\n                      target_direction = 3\n\n                  new_path = path + [(target_direction, (nx, ny))]\n                  heappush(queue, (new_cost, nx, ny, target_direction, new_path))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos + (current_state.dir,), primitives_index, inventory)\n  if path_to_primitive:\n      for (target_direction, (x, y)) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          current_direction = current_state.dir\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T16:17:54.120970", "function_name": "collect", "function_body": "  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], [], 0))  # (cost, x, y, path, direction)\n      visited = set()\n      while queue:\n          cost, x, y, path, current_direction = heappop(queue)\n          if (x, y, current_direction) in visited:\n              continue\n          visited.add((x, y, current_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(current_direction, (x, y))]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_cost = cost + heuristic((nx, ny), start_pos)\n                  # Determine target direction based on movement vector\n                  if dx == 0 and dy < 0:  # UP\n                      target_direction = 0\n                  elif dx == 0 and dy > 0:  # DOWN\n                      target_direction = 1\n                  elif dx < 0 and dy == 0:  # LEFT\n                      target_direction = 2\n                  elif dx > 0 and dy == 0:  # RIGHT\n                      target_direction = 3\n\n                  new_path = path + [(target_direction, (nx, ny))]\n                  heappush(queue, (new_cost, nx, ny, new_path, target_direction))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (target_direction, (x, y)) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          current_direction = current_state.dir\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-03T16:19:28.438100", "function_name": "collect", "function_body": "  def get_neighbors(pos):\n    x, y = pos\n    return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  def is_valid_pos(x, y, grid_shape):\n    return 0 <= x < grid_shape[0] and 0 <= y < grid_shape[1]\n\n  def has_required_tools(kind_index, inventory):\n    kind_name = current_state.world.cookbook.index.get(kind_index)\n    if kind_name == \"WATER\":\n      return inventory[current_state.world.water_index] > 0\n    elif kind_name == \"ROCK\":\n      return inventory[current_state.world.stone_index] > 0\n    else:\n      return True\n\n  def find_shortest_path_bfs(grid, start_pos, target_kind, inventory):\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n    \n    while queue:\n        pos = queue.popleft()\n        if (pos[0], pos[1]) in visited:\n            continue\n        visited.add((pos[0], pos[1]))\n        \n        # Check if target is found\n        x, y = pos\n        if grid[x, y, target_kind] == 1 and has_required_tools(target_kind, inventory):\n            return reconstruct_path(parent, start_pos, pos)\n        \n        for neighbor in get_neighbors(pos):\n            nx, ny = neighbor\n            if is_valid_pos(nx, ny, grid.shape) and (nx, ny) not in visited:\n                queue.append(neighbor)\n                parent[neighbor] = pos\n    \n    return None\n\n  def reconstruct_path(parent, start, end):\n    path = []\n    while end != start:\n        path.append(end)\n        end = parent[end]\n    path.append(start)\n    path.reverse()\n    return path\n\n  def actions_to_reach(pos):\n    x, y = pos\n    cx, cy = current_state.pos\n    dx, dy = x - cx, y - cy\n    \n    if dx < 0:\n      direction = ACTION_MAP[\"LEFT\"]\n    elif dx > 0:\n      direction = ACTION_MAP[\"RIGHT\"]\n    else:\n      if dy < 0:\n        direction = ACTION_MAP[\"UP\"]\n      else:\n        direction = ACTION_MAP[\"DOWN\"]\n    \n    return [direction]\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path_bfs(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          actions.extend(actions_to_reach((x, y)))\n          \n          # Add USE action to collect/prune obstacles using available tools\n          kind_index = np.argmax(grid[x, y])\n          if not has_required_tools(kind_index, inventory):\n              actions.append(ACTION_MAP[\"USE\"])\n      \n      # Move to the last position and use it to collect the primitive\n      actions.extend(actions_to_reach(path_to_primitive[-1]))\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-03T16:19:29.459613", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T16:21:29.344046", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          else:\n              is_clear = True\n          \n          # Check if the direction change is needed and if it's in inventory\n          new_direction = (x - start_pos[0], y - start_pos[1])\n          if current_direction != new_direction and abs(new_direction[0]) + abs(new_direction[1]) == 1:\n              turn_action = determine_turn(current_state.dir, new_direction)\n              if turn_action is not None and inventory[turn_action] <= 0:\n                  is_clear = False\n          \n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Mapping of kinds to required tools\n          tool_map = {\n              \"WATER\": current_state.world.water_index,\n              \"ROCK\": current_state.world.stone_index\n          }\n          return tool_map.get(kind_name, None)\n\n      def determine_turn(current_direction, new_direction):\n          turn_map = {\n              ((-1, 0), (0, -1)): 2,  # LEFT to UP\n              ((-1, 0), (0, 1)): 3,   # LEFT to DOWN\n              ((1, 0), (0, -1)): 3,   # RIGHT to UP\n              ((1, 0), (0, 1)): 2,    # RIGHT to DOWN\n              ((0, -1), (-1, 0)): 3,  # UP to LEFT\n              ((0, -1), (1, 0)): 2,   # UP to RIGHT\n              ((0, 1), (-1, 0)): 2,   # DOWN to LEFT\n              ((0, 1), (1, 0)): 3     # DOWN to RIGHT\n          }\n          return turn_map.get((current_direction, new_direction), None)\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, (dx, dy), path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          current_direction = current_state.dir\n          new_direction = (dx, dy)\n          if current_direction != new_direction:\n              turn_action = determine_turn(current_direction, new_direction)\n              actions.append(ACTION_MAP[\"LEFT\" if turn_action == 2 else \"RIGHT\"])\n              \n          # Move in the new direction\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-03T16:21:30.331158", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  new_path = path.copy()\n                  new_path.append((nx, ny))\n                  \n                  # Calculate the action needed to move from (x, y) to (nx, ny)\n                  if nx == x - 1 and ny == y:\n                      actions_needed = [ACTION_MAP[\"UP\"]]\n                  elif nx == x + 1 and ny == y:\n                      actions_needed = [ACTION_MAP[\"DOWN\"]]\n                  elif nx == x and ny == y - 1:\n                      actions_needed = [ACTION_MAP[\"LEFT\"]]\n                  elif nx == x and ny == y + 1:\n                      actions_needed = [ACTION_MAP[\"RIGHT\"]]\n\n                  # Update the position and direction\n                  new_x, new_y = nx, ny\n                  new_direction = (nx - x, ny - y)\n                  \n                  queue.append((new_x, new_y, new_direction, new_path))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T16:23:16.936157", "function_name": "collect", "function_body": "  from collections import deque\n  from heapq import heappop, heappush\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], current_state.dir, []))\n      visited = set()\n      while queue:\n          cost, x, y, pos_direction, path = heappop(queue)\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_cost = cost + heuristic((nx, ny), start_pos) + 1  # Adding 1 to the cost for each step taken\n                  heappush(queue, (new_cost, nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          # Determine target direction based on movement vector\n          if dx == 0 and dy < 0:  # UP\n              target_direction = ACTION_MAP[\"UP\"]\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = ACTION_MAP[\"DOWN\"]\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = ACTION_MAP[\"LEFT\"]\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = ACTION_MAP[\"RIGHT\"]\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])  # Move towards the next cell or collect\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 1.5}}
