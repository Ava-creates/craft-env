{"timestamp": "2025-08-02T16:46:34.607815", "function_name": "collect", "function_body": "  # Extract the current state from the environment.\n  current_state = env._current_state\n\n  # Retrieve the index for the target primitive.\n  primitive_index = current_state.world.cookbook.index.index(primitive)\n\n  # Check if the primitive is already in the inventory.\n  if current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect if already available.\n\n  # Identify all positions of the primitive in the grid.\n  primitive_positions = np.argwhere(current_state.grid[:, :, primitive_index])\n\n  # Define a function to check if a position is walkable (i.e., not blocked by obstacles).\n  def is_walkable(pos):\n    x, y = pos\n    return current_state.world.cookbook.index.get(np.argmax(current_state.grid[x, y])) in current_state.world.grabbable_indices\n\n  # Filter out positions that are not walkable.\n  reachable_positions = [pos for pos in primitive_positions if is_walkable(pos)]\n\n  # If no reachable positions, try using tools from the inventory to make them accessible.\n  if not reachable_positions:\n    # Check if there's a bridge tool available and place it over water.\n    bridge_index = current_state.world.cookbook.index.index(\"BRIDGE\")\n    if current_state.inventory[bridge_index] > 0:\n      water_index = current_state.world.water_index\n      water_positions = np.argwhere(current_state.grid[:, :, water_index])\n      for water_pos in water_positions:\n        if is_walkable((water_pos[0], water_pos[1])):\n          # Place a bridge at the water position.\n          reachable_positions.append(water_pos)\n    else:\n      raise ValueError(\"No accessible path to primitive and no tools available.\")\n\n  # Use BFS to find the shortest path to any of the reachable positions.\n  from collections import deque\n\n  def bfs(start, goal):\n    queue = deque([(start, [])])\n    visited = set([tuple(start)])\n    while queue:\n      (x, y), path = queue.popleft()\n      if tuple(goal) == (x, y):\n        return path\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1] and is_walkable((nx, ny)):\n          if (nx, ny) not in visited:\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n\n  # Find the shortest paths to all reachable positions.\n  all_paths = []\n  for goal_pos in reachable_positions:\n    path_to_goal = bfs(current_state.pos, goal_pos)\n    if path_to_goal is not None:\n      all_paths.append(path_to_goal)\n\n  # If no paths found, raise an error.\n  if not all_paths:\n    raise ValueError(\"No accessible path to primitive.\")\n\n  # Select the shortest path from the list of paths.\n  best_path = min(all_paths, key=len)\n\n  # Convert direction changes into action indices (0: DOWN, 1: UP, 2: LEFT, 3: RIGHT).\n  actions = []\n  for dx, dy in best_path:\n    if dx == -1 and dy == 0:\n      actions.append(1)  # UP\n    elif dx == 1 and dy == 0:\n      actions.append(0)  # DOWN\n    elif dx == 0 and dy == -1:\n      actions.append(2)  # LEFT\n    elif dx == 0 and dy == 1:\n      actions.append(3)  # RIGHT\n\n  # Append the USE action to collect the primitive.\n  actions.append(4)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
