on):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))  # Keep current direction as pos_direction\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T19:08:09.203677", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define mapping of kind to required tools based on the world's rules\n          tool_map = {\n              \"WATER\": current_state.world.water_index,\n              \"GEM\": current_state.world.stone_index,\n              # Add more mappings as necessary\n          }\n          return tool_map.get(kind_name, None)\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y)\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      dx, dy = path_to_primitive[-1][0] - pos[0], path_to_primitive[-1][1] - pos[1]\n      if dx == 0 and dy < 0:  # UP\n          target_direction = 0\n      elif dx == 0 and dy > 0:  # DOWN\n          target_direction = 1\n      elif dx < 0 and dy == 0:  # LEFT\n          target_direction = 2\n      elif dx > 0 and dy == 0:  # RIGHT\n          target_direction = 3\n\n      if current_state.dir != target_direction:\n          actions.append(target_direction)  # Add action to change direction\n\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-03T19:08:10.179525", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_dir):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n\n          # Check for obstacles and whether the agent needs to change direction\n          dx, dy = x - start_pos[0], y - start_pos[1]\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_dir != target_direction:\n              return False\n          \n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name in [\"WATER\", \"GEM\"]:\n              # Assuming water needs a bridge or boat tool and GEM needs a pickaxe tool\n              return current_state.world.water_index  # Placeholder, adjust as needed\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], 0, [])])  # (x, y, direction, path)\n      visited = set()\n      while queue:\n          x, y, current_dir, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny, current_dir):\n                  queue.append((nx, ny, current_dir, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          # Determine target direction based on relative position\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          current_direction = current_state.dir\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive at the last position\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-03T19:09:51.367999", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          \n          # Check direction change\n          target_direction = (y - start_pos[1], x - start_pos[0])\n          if current_direction != target_direction:\n              return True, \"TURN\"\n          else:\n              return is_clear, None\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + ny\n              can_move_result, action_needed = can_move(nx, ny, pos_direction)\n              \n              if can_move_result:\n                  if action_needed:\n                      queue.append((nx, ny, (dx, dy), path + [action_needed]))\n                  else:\n                      queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for action in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          if isinstance(action, str):\n              actions.append(ACTION_MAP[action])\n          else:\n              dx, dy = action[0] - pos[0], action[1] - pos[1]\n              if dx == 0 and dy == -1:\n                  actions.append(ACTION_MAP[\"UP\"])\n              elif dx == 0 and dy == 1:\n                  actions.append(ACTION_MAP[\"DOWN\"])\n              elif dx == -1 and dy == 0:\n                  actions.append(ACTION_MAP[\"LEFT\"])\n              elif dx == 1 and dy == 0:\n                  actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-03T19:09:52.384284", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction, next_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              # Determine the direction to move and check if it's valid\n              if can_move(nx, ny, pos_direction, (dx, dy)):\n                  queue.append((nx, ny, (dx, dy), path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = None\n          if dx == 0 and dy < 0:\n              current_direction = \"UP\"\n          elif dx == 0 and dy > 0:\n              current_direction = \"DOWN\"\n          elif dx < 0 and dy == 0:\n              current_direction = \"LEFT\"\n          elif dx > 0 and dy == 0:\n              current_direction = \"RIGHT\"\n\n          if current_direction:\n              actions.append(ACTION_MAP[current_direction])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
