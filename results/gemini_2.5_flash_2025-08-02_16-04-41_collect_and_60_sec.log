USE will use the appropriate tool in inventory\n                              visited.add(next_pos)\n\n                              # Determine direction to move after using tool\n                              new_dir = None\n                              if dx == 1 and dy == 0:\n                                  new_dir = RIGHT\n                              elif dx == -1 and dy == 0:\n                                  new_dir = LEFT\n                              elif dx == 0 and dy == 1:\n                                  new_dir = UP\n                              elif dx == 0 and dy == -1:\n                                  new_dir = DOWN\n\n                              # Turn if necessary\n                              new_path = path.copy()\n                              while current_dir != new_dir:\n                                  if (current_dir + 3) % 4 == new_dir:\n                                      new_path.append(LEFT)\n                                  else:\n                                      new_path.append(RIGHT)\n                                  current_dir = (current_dir + 1) % 4\n\n                              # Move\n                              new_path.append(new_dir)\n\n                              queue.append((next_pos, new_dir, new_path))\n\n      return None\n\n  # Find a path to the primitive using BFS with obstacle handling.\n  path_to_primitive = bfs(pos, dir)\n\n  if path_to_primitive:\n      action_sequence = path_to_primitive\n      # Use the primitive if necessary (e.g., for GEM, use PICKAXE to mine it).\n      if state.next_to(primitive_index):\n          if tool_index is not None and grid[pos[0], pos[1], tool_index] > 0:\n              action_sequence.append(USE)\n\n      return action_sequence\n\n  return []", "island_id": 9, "scores": {"3": 0.0}}
