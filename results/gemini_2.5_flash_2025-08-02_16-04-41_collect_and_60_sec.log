f can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T14:32:38.252932", "function_name": "collect", "function_body": "  from collections import deque\n  from numpy.linalg import norm\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          if dx == 0 and dy < 0:\n              target_direction = \"UP\"\n          elif dx == 0 and dy > 0:\n              target_direction = \"DOWN\"\n          elif dx < 0 and dy == 0:\n              target_direction = \"LEFT\"\n          elif dx > 0 and dy == 0:\n              target_direction = \"RIGHT\"\n\n          if current_direction != target_direction:\n              actions.append(ACTION_MAP[target_direction])\n              current_state.dir = ACTION_MAP[target_direction]\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T14:32:39.228647", "function_name": "collect", "function_body": "  from collections import deque\n  from numpy.linalg import norm\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  def get_direction(pos1, pos2):\n      \"\"\"Determine the direction to move from pos1 to pos2.\"\"\"\n      dx, dy = pos2[0] - pos1[0], pos2[1] - pos1[1]\n      if dx == 0 and dy < 0:\n          return \"UP\"\n      elif dx == 0 and dy > 0:\n          return \"DOWN\"\n      elif dx < 0 and dy == 0:\n          return \"LEFT\"\n      elif dx > 0 and dy == 0:\n          return \"RIGHT\"\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def turn_to_direction(current_direction, target_direction):\n      \"\"\"Determine the actions needed to turn from current_direction to target_direction.\"\"\"\n      if current_direction == target_direction:\n          return []\n      \n      directions = [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]\n      current_index = directions.index(current_direction)\n      target_index = directions.index(target_direction)\n      \n      # Calculate the shortest way to turn\n      diff = (target_index - current_index) % 4\n      if diff == 1:\n          return [ACTION_MAP[target_direction]]\n      elif diff == 2:\n          return [ACTION_MAP[target_direction], ACTION_MAP[target_direction]]\n      elif diff == 3:\n          # Turn in the opposite direction twice\n          opposite_direction = directions[(current_index + 2) % 4]\n          return [ACTION_MAP[opposite_direction]] * 2\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          current_direction = get_direction(pos, (x, y))\n          turn_actions = turn_to_direction(current_state.dir, current_direction)\n          actions.extend(turn_actions)\n          actions.append(ACTION_MAP[\"USE\"])\n          pos = (x, y)  # Update position\n\n      # Collect the primitive\n      final_turn_actions = turn_to_direction(current_state.dir, get_direction(pos, path_to_primitive[-1]))\n      actions.extend(final_turn_actions)\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-03T14:34:17.292323", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], current_state.dir, []))\n      visited = set()\n      while queue:\n          cost, x, y, pos_direction, path = heappop(queue)\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  new_cost = cost + heuristic((nx, ny), start_pos)\n                  heappush(queue, (new_cost, nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          # Determine target direction based on movement vector\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])  # Attempt to use any tool needed for movement\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
