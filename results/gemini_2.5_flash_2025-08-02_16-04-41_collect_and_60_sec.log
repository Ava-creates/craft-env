n\n                  queue.append(new_state)\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-02T17:08:24.574554", "function_name": "collect", "function_body": "  # Get the index for the desired primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  if primitive_index is None:\n    raise ValueError(f\"Unknown primitive: {primitive}\")\n\n  # Initialize a queue for BFS and a set to track visited positions\n  queue = collections.deque([(env._current_state.pos, [])])\n  visited = set()\n  directions = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1)\n  }\n\n  # Define the actions corresponding to each direction\n  action_dict = {\n      \"UP\": craft.ACTIONS[\"UP\"],\n      \"DOWN\": craft.ACTIONS[\"DOWN\"],\n      \"LEFT\": craft.ACTIONS[\"LEFT\"],\n      \"RIGHT\": craft.ACTIONS[\"RIGHT\"]\n  }\n  \n  while queue:\n    current_pos, path = queue.popleft()\n    \n    # If the primitive is found in any of the neighboring cells\n    for dx, dy in [(0, 1), (1, 0), (-1, 0), (0, -1)]:\n      neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n      \n      if env._current_state.grid[neighbor_pos] == primitive_index:\n        # Move to the neighboring cell and collect the primitive\n        move_action = action_dict[directions[(dx, dy)]]\n        path.append(move_action)\n        return path\n\n    # Explore neighbors that are not obstacles or already visited\n    for direction, (dx, dy) in directions.items():\n      neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n      \n      if neighbor_pos not in visited:\n        if env._current_state.grid[neighbor_pos] != craft.ACTIONS[\"OBSTACLE\"]:\n          visited.add(neighbor_pos)\n          move_action = action_dict[direction]\n          queue.append((neighbor_pos, path + [move_action]))\n          \n  return []  # If the primitive cannot be found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-02T17:08:25.802859", "function_name": "collect", "function_body": "  # Define constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_action_to_move(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dy > 0:\n          return DOWN\n      elif dy < 0:\n          return UP\n      elif dx > 0:\n          return RIGHT\n      elif dx < 0:\n          return LEFT\n\n      return None\n\n  def find_path(grid, start, target):\n      # Use BFS to find the shortest path from start to target\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          (x, y), path = queue.popleft()\n\n          if (x, y) == target:\n              return path\n\n          for nx, ny in [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]:\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      new_path = path + [get_action_to_move((x, y), (nx, ny))]\n                      queue.append(((nx, ny), new_path))\n                      visited.add((nx, ny))\n\n      return None\n\n  def find_closest_primitive(grid, primitive_index):\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, primitive_index] > 0:\n                  return (x, y)\n\n      return None\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Find the closest position of the primitive\n  target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n\n  if not target_pos:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n\n  # Get the start position and direction of the agent\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the target position\n  path_to_primitive = find_path(env._current_state.grid, start_pos, target_pos)\n\n  if not path_to_primitive:\n      raise ValueError(\"No path found to the primitive.\")\n\n  return path_to_primitive", "island_id": 4, "scores": {"3": 0.0}}
