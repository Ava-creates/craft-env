def get_next_action(current_pos, target_pos):\n    if current_pos[0] < target_pos[0]:\n        return craft.DOWN\n    elif current_pos[0] > target_pos[0]:\n        return craft.UP\n    elif current_pos[1] < target_pos[1]:\n        return craft.RIGHT\n    else:\n        return craft.LEFT\n\n  def get_actions_to_path(path):\n      actions = []\n      for i in range(len(path) - 1):\n          next_action = get_next_action(path[i], path[i + 1])\n          if next_action is not None:\n              actions.append(next_action)\n      return actions\n\n  def collect_tools(tool_name, inventory, env):\n      tool_index = env.world.cookbook.index[tool_name]\n      if inventory[tool_index] > 0:\n          return []\n      \n      # Find path to nearest tool\n      tool_path = find_nearest_resource(env._current_state.grid, env._current_state.pos, tool_index, inventory, env.world)\n      if not tool_path:\n          return None\n      \n      actions_to_tool = get_actions_to_path(tool_path[:-1])\n      actions_to_tool.append(craft.USE)  # Use the tool once found\n      for action in actions_to_tool:\n          _, done, _ = env.step(action)\n          if done:\n              break\n      \n      inventory[tool_index] += 1\n      return actions_to_tool\n\n  primitive_index = get_primitive_index(primitive)\n  grid = env._current_state.grid.copy()\n  current_position = env._current_state.pos\n  inventory = collections.Counter(env._current_state.inventory)\n\n  tools_required = {'WATER': 'BRIDGE', 'STONE': 'PICKAXE'}\n  \n  # Collect required tools first\n  for non_grab_index in env.world.non_grabbable_indices:\n      if grid[current_position[0], current_position[1], non_grab_index] > 0:\n          tool_name = tools_required.get(env.world.cookbook.index[non_grab_index])\n          if tool_name and inventory[tool_index] == 0:\n              actions_to_tool = collect_tools(tool_name, inventory, env)\n              if not actions_to_tool:\n                  return []\n\n  # Find path to the nearest resource\n  path_to_resource = find_nearest_resource(grid, current_position, primitive_index, inventory, env.world)\n\n  if not path_to_resource:\n      return []\n\n  actions_to_target = get_actions_to_path(path_to_resource[:-1])\n  actions_to_target.append(craft.USE)  # Add the USE action to collect the resource\n\n  return actions_to_target", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T04:00:28.272134", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  current_state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  def use_tool_if_needed(pos):\n      tool_used = False\n      tools_requirements = [('BRIDGE', 'WATER'), ('PICKAXE', 'ROCK')]\n      for tool, requirement in tools_requirements:\n          if env.world.cookbook.index[tool] in current_state.inventory:\n              obstacle_pos = find_primitive_position(requirement)\n              if obstacle_pos and pos == obstacle_pos:\n                  actions.append(action_map['USE'])\n                  tool_used = True\n      return tool_used\n\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n      # Check for tools in inventory that can help cross obstacles\n      use_tool_if_needed(to_pos)\n\n  # Use the primitive once it's reached\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n\n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T04:00:29.269509", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  current_state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  def find_tool_position(tool):\n      i_tool = env.world.cookbook.index[tool]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_tool] > 0:\n                  return (x, y)\n      return None\n\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Check for tools in inventory that can help cross obstacles\n  def use_tool_if_needed(pos):\n      tool_used = False\n      for tool, requirement in [('BRIDGE', 'WATER'), ('PICKAXE', 'ROCK')]:\n          if env.world.cookbook.index[tool] in current_state.inventory:\n              obstacle_pos = find_tool_position(requirement)\n              if obstacle_pos and pos == obstacle_pos:\n                  actions.append(action_map['USE'])\n                  tool_used = True\n      return tool_used\n\n  for i, pos in enumerate(path_to_primitive):\n      use_tool_if_needed(pos)\n\n  # Use the primitive once it's reached\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T04:02:01.684660", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, visited):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n\n          # Check for existing bridges on WATER\n          water_index = current_state.world.water_index\n          if grid[x, y, water_index] > 0:\n              return True\n\n          return (x, y) not in visited\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_mapping = {\n              \"WATER\": None,  # No specific tool needed if bridge exists\n              \"ROCK\": current_state.world.stone_index,\n              \"TREE\": None,  # Assuming trees don't require tools to be cut down\n              # Add other mappings as needed\n          }\n          return tool_mapping.get(kind_name)\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, visited):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          action_sequence = []\n          \n          if dy < 0:\n              action_sequence.append(ACTION_MAP[\"UP\"])\n          elif dy > 0:\n              action_sequence.append(ACTION_MAP[\"DOWN\"])\n          if dx < 0:\n              action_sequence.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0:\n              action_sequence.append(ACTION_MAP[\"RIGHT\"])\n\n          # Append the sequence of actions to move in the correct direction\n          actions.extend(action_sequence)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T04:02:02.666939", "function_name": "collect", "function_body": "  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, visited):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n\n          # Check for existing bridges on water tiles\n          if current_state.world.cookbook.index.get(target_kind) == \"WATER\":\n              bridge_index = current_state.world.water_index\n              if grid[x, y, bridge_index] > 0:\n                  return True\n\n          return (x, y) not in visited\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_mapping = {\n              \"WATER\": current_state.world.water_index,\n              # Add other mappings as needed\n          }\n          return tool_mapping.get(kind_name)\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, visited):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          action_sequence = []\n          if dx < 0:\n              action_sequence.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0:\n              action_sequence.append(ACTION_MAP[\"RIGHT\"])\n          if dy < 0:\n              action_sequence.append(ACTION_MAP[\"UP\"])\n          elif dy > 0:\n              action_sequence.append(ACTION_MAP[\"DOWN\"])\n\n          # Append the sequence of actions to move in the correct direction\n          actions.extend(action_sequence)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-03T04:03:34.109280", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          actions.append(ACTION_MAP[\"UP\"] * (dy < 0) + ACTION_MAP[\"DOWN\"] * (dy > 0))\n          actions.append(ACTION_MAP[\"LEFT\"] * (dx < 0) + ACTION_MAP[\"RIGHT\"] * (dx > 0))\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T04:03:35.075186", "function_name": "collect", "function_body": "  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], start_pos[2], [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-03T04:05:15.209241", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n\n  # Convert the primitive name to its corresponding index\n  primitive_index = cookbook.index[primitive]\n\n  actions = []\n\n  def find_path_to_primitive(current_pos, target_kind):\n    \"\"\"Find a path from current position to the closest cell containing the target kind.\"\"\"\n    grid = current_state.grid\n    width, height, _ = grid.shape\n\n    # Directions: (delta_x, delta_y)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_valid(x, y):\n        return 0 <= x < width and 0 <= y < height\n\n    queue = collections.deque([(current_pos[0], current_pos[1], [])])\n    visited = set()\n\n    while queue:\n        x, y, path = queue.popleft()\n        \n        if grid[x, y, target_kind] > 0:\n            return path\n        \n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if is_valid(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path + [direction_to_action(dx, dy)]))\n\n    return []\n\n  def direction_to_action(dx: int, dy: int) -> int:\n      \"\"\"Convert a grid direction to an action index.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"UP\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"DOWN\"]\n\n      raise ValueError(\"Invalid direction\")\n\n  def find_and_use_tool(primitive: str, required_tools: list[str]):\n    \"\"\"Find a tool in inventory and use it.\"\"\"\n    for tool in required_tools:\n        tool_index = cookbook.index[tool]\n        if current_state.inventory[tool_index] > 0:\n            actions.append(env.action_specs()[\"USE\"])  # Use the tool\n            return True\n\n    raise ValueError(f\"No suitable tool in inventory to collect {primitive}.\")\n\n  def use_tool_if_needed(primitive: str):\n      \"\"\"Check and use a tool if needed for collecting or mining.\"\"\"\n      if primitive in ['GOLD', 'GEM']:\n          find_and_use_tool(primitive, ['PICKAXE', 'AXE'])\n      elif primitive == 'STONE':\n          find_and_use_tool(primitive, ['HAMMER'])\n      # Add more conditions as necessary\n\n  # Use the tool if needed\n  use_tool_if_needed(primitive)\n\n  # Find the path to the closest cell containing the target kind\n  actions.extend(find_path_to_primitive(current_state.pos, primitive_index))\n\n  # Finally, add the USE action to collect or mine the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T04:05:16.179560", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  inventory = current_state.inventory\n\n  # Convert the primitive name to its corresponding index\n  primitive_index = cookbook.index[primitive]\n\n  actions = []\n\n  def find_path_to_primitive(current_pos, target_kind):\n    \"\"\"Find a path from current position to the closest cell containing the target kind.\"\"\"\n    grid = current_state.grid\n    width, height, _ = grid.shape\n\n    # Directions: (delta_x, delta_y)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_valid(x, y):\n        return 0 <= x < width and 0 <= y < height\n\n    queue = collections.deque([(current_pos[0], current_pos[1], [])])\n    visited = set()\n\n    while queue:\n        x, y, path = queue.popleft()\n        \n        if grid[x, y, target_kind] > 0:\n            return path\n        \n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if is_valid(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path + [direction_to_action(dx, dy)]))\n\n    return []\n\n  def direction_to_action(dx: int, dy: int) -> int:\n      \"\"\"Convert a grid direction to an action index.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"UP\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"DOWN\"]\n\n      raise ValueError(\"Invalid direction\")\n\n  def find_and_use_tool(primitive: str, required_tools: list[str]):\n    \"\"\"Find a tool in inventory and use it.\"\"\"\n    for tool in required_tools:\n        tool_index = cookbook.index[tool]\n        if inventory[tool_index] > 0:\n            actions.append(env.action_specs()[\"USE\"])  # Use the tool\n            return True\n\n    raise ValueError(f\"No suitable tool in inventory to collect {primitive}.\")\n\n  def use_tool_if_needed(primitive: str):\n      \"\"\"Check and use a tool if needed for collecting or mining.\"\"\"\n      if primitive in ['GOLD', 'GEM']:\n          find_and_use_tool(primitive, ['PICKAXE', 'AXE'])\n      elif primitive == 'STONE':\n          find_and_use_tool(primitive, ['HAMMER'])\n      # Add more conditions as necessary\n\n  def is_primitive_reachable(pos: tuple[int, int], target_kind: int) -> bool:\n    \"\"\"Check if the primitive can be reached from a given position without obstacles.\"\"\"\n    grid = current_state.grid\n    width, height, _ = grid.shape\n\n    # Directions: (delta_x, delta_y)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_valid(x, y):\n        return 0 <= x < width and 0 <= y < height\n\n    queue = collections.deque([pos])\n    visited = set()\n\n    while queue:\n        x, y = queue.popleft()\n        \n        if grid[x, y, target_kind] > 0:\n            return True\n        \n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if is_valid(nx, ny) and (nx, ny) not in visited:\n                # Check if the next cell is walkable or a tool is available there\n                if grid[nx, ny, world_cookbook.index[\"BOUNDARY\"]] == 0 or current_state.next_to(world_cookbook.index[tool]):\n                    visited.add((nx, ny))\n                    queue.append((nx, ny))\n\n    return False\n\n  # Use the tool if needed\n  use_tool_if_needed(primitive)\n\n  # Check if the primitive is reachable\n  if not is_primitive_reachable(current_state.pos, primitive_index):\n      raise ValueError(f\"{primitive} is not reachable from the current position.\")\n\n  # Find the path to the closest cell containing the target kind\n  actions.extend(find_path_to_primitive(current_state.pos, primitive_index))\n\n  # Finally, add the USE action to collect or mine the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-03T04:06:40.148888", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find the position of the primitive in the grid\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  # Find the position of the primitive\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  # Find the shortest path to the primitive using BFS\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  # Convert the path to actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 9, "scores": {"3": 0.5}}
