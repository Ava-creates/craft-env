    for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T09:02:40.855374", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n      \"TURN_LEFT\": 5,  # Assuming a turn left action exists\n      \"TURN_RIGHT\": 6  # Assuming a turn right action exists\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          # For now, we assume some mappings for demonstration purposes\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  def turn_towards(current_direction, target_direction):\n      # This function calculates the necessary turns to face the target direction\n      # For simplicity, assume the directions are represented as tuples (dx, dy)\n      # and we have actions for turning left or right.\n      if current_direction == (-1, 0) and target_direction == (0, -1):  # UP -> LEFT\n          return [ACTION_MAP[\"TURN_LEFT\"]]\n      elif current_direction == (-1, 0) and target_direction == (0, 1):  # UP -> RIGHT\n          return [ACTION_MAP[\"TURN_RIGHT\"]]\n      elif current_direction == (1, 0) and target_direction == (0, -1):  # DOWN -> LEFT\n          return [ACTION_MAP[\"TURN_LEFT\"], ACTION_MAP[\"TURN_LEFT\"]]  # or TURN_180\n      elif current_direction == (1, 0) and target_direction == (0, 1):  # DOWN -> RIGHT\n          return [ACTION_MAP[\"TURN_RIGHT\"]]\n      elif current_direction == (0, -1) and target_direction == (-1, 0):  # LEFT -> UP\n          return [ACTION_MAP[\"TURN_RIGHT\"]]\n      elif current_direction == (0, -1) and target_direction == (1, 0):  # LEFT -> DOWN\n          return [ACTION_MAP[\"TURN_LEFT\"]]\n      elif current_direction == (0, 1) and target_direction == (-1, 0):  # RIGHT -> UP\n          return [ACTION_MAP[\"TURN_RIGHT\"]]\n      elif current_direction == (0, 1) and target_direction == (1, 0):  # RIGHT -> DOWN\n          return [ACTION_MAP[\"TURN_LEFT\"]]\n      else:\n          return []\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          target_direction = (dx, dy)\n\n          actions.extend(turn_towards(current_state.dir, target_direction))\n          actions.append(ACTION_MAP[\"USE\"])\n          \n          pos = (x, y)  # Update position\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T09:05:14.771164", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find all positions of the primitive in the grid\n  def find_all_primitive_positions(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  positions.append((x, y))\n      return positions\n\n  # Define a function to find the nearest position of the primitive in the grid\n  def find_nearest_primitive_position(primitive):\n      goal_positions = find_all_primitive_positions(primitive)\n      if not goal_positions:\n          return None\n      start_position = current_state.pos\n      min_distance = float('inf')\n      nearest_goal_position = None\n\n      for goal_position in goal_positions:\n          distance = abs(goal_position[0] - start_position[0]) + abs(goal_position[1] - start_position[1])\n          if distance < min_distance:\n              min_distance = distance\n              nearest_goal_position = goal_position\n      \n      return nearest_goal_position\n\n  # Define a function to check if the primitive can be reached directly\n  def is_reachable_directly(start, goals):\n      for goal in goals:\n          path = bfs(start, goal)\n          if path:\n              return path, True\n      return None, False\n\n  # Define a function to find all obstacles that need tools to cross\n  def find_obstacles():\n      obstacles = ['WATER']  # Example obstacle\n      obstacle_positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if any(current_state.grid[x, y, env.world.cookbook.index[obstacle]] > 0 for obstacle in obstacles):\n                  obstacle_positions.append((x, y))\n      return obstacle_positions\n\n  # Define a function to find the nearest tool position\n  def find_nearest_tool_position(tool):\n      tool_index = env.world.cookbook.index[tool]\n      positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, tool_index] > 0:\n                  positions.append((x, y))\n      return positions\n\n  # Define a function to find the nearest reachable goal using available tools\n  def find_path_with_tool(start, goals):\n      obstacles = find_obstacles()\n      for obstacle in obstacles:\n          for tool in ['BRIDGE', 'PICKAXE']:  # Example tools\n              if current_state.inventory[env.world.cookbook.index[tool]] > 0:\n                  tool_positions = find_nearest_tool_position(tool)\n                  for tool_pos in tool_positions:\n                      path_to_tool = bfs(start, tool_pos)\n                      if path_to_tool:\n                          reachable_goals_from_tool = [goal for goal in goals if is_reachable_directly(tool_pos, [goal])[1]]\n                          if reachable_goals_from_tool:\n                              min_distance_goal = None\n                              min_distance = float('inf')\n                              for goal in reachable_goals_from_tool:\n                                  distance = abs(goal[0] - tool_pos[0]) + abs(goal[1] - tool_pos[1])\n                                  if distance < min_distance:\n                                      min_distance = distance\n                                      min_distance_goal = goal\n                              path_from_tool_to_primitive = bfs(tool_pos, min_distance_goal)\n                              if path_from_tool_to_primitive:\n                                  return path_to_tool + path_from_tool_to_primitive, True\n      return None, False\n\n  # Find all positions of the primitive in the grid\n  goals = find_all_primitive_positions(primitive)\n  if not goals:\n      raise ValueError(f\"No instances of {primitive} found in the grid.\")\n\n  # Check if any goal is reachable directly\n  start_position = current_state.pos\n  path, found_direct_path = is_reachable_directly(start_position, goals)\n\n  if found_direct_path:\n      shortest_path = path\n  else:\n      # If not reachable directly, find a path using available tools\n      shortest_path_with_tool, found_tool_path = find_path_with_tool(start_position, goals)\n      if found_tool_path:\n          shortest_path = shortest_path_with_tool\n      else:\n          raise ValueError(f\"No valid path found to collect {primitive} with available tools.\")\n\n  # Convert the shortest path to actions\n  actions = []\n  for i in range(len(shortest_path) - 1):\n      from_pos = shortest_path[i]\n      to_pos = shortest_path[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if shortest_path and current_state.grid[shortest_path[-1][0], shortest_path[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T09:05:15.754661", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find all positions of the primitive in the grid\n  def find_all_primitive_positions(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      positions = []\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  positions.append((x, y))\n      return positions\n\n  # Define a function to find the nearest position of the primitive in the grid\n  def find_nearest_primitive_position(primitive):\n      goal_positions = find_all_primitive_positions(primitive)\n      if not goal_positions:\n          raise ValueError(f\"No instances of {primitive} found in the grid.\")\n      \n      start_position = current_state.pos\n      min_distance = float('inf')\n      nearest_goal_position = None\n\n      for goal_position in goal_positions:\n          distance = abs(goal_position[0] - start_position[0]) + abs(goal_position[1] - start_position[1])\n          if distance < min_distance:\n              min_distance = distance\n              nearest_goal_position = goal_position\n      \n      return nearest_goal_position\n\n  # Define a function to check if the agent needs a tool and find the path with tool usage\n  def find_path_with_tool(start, goals):\n      tools = ['BRIDGE', 'PICKAXE']  # Example tools\n      for tool in tools:\n          if current_state.inventory[env.world.cookbook.index[tool]] > 0:\n              tool_position = find_primitive_position(tool)\n              if tool_position:\n                  path_to_tool = bfs(start, tool_position)\n                  reachable_goals_from_tool = [goal for goal in goals if is_reachable_directly(tool_position, goal)]\n                  if reachable_goals_from_tool:\n                      min_distance_goal = None\n                      min_distance = float('inf')\n                      for goal in reachable_goals_from_tool:\n                          distance = abs(goal[0] - tool_position[0]) + abs(goal[1] - tool_position[1])\n                          if distance < min_distance:\n                              min_distance = distance\n                              min_distance_goal = goal\n                      path_from_tool_to_primitive = bfs(tool_position, min_distance_goal)\n                      return path_to_tool + path_from_tool_to_primitive, True\n      return None, False\n\n  # Define a function to check if the primitive can be reached directly\n  def is_reachable_directly(start, goal):\n      path = bfs(start, goal)\n      return path is not None\n\n  # Find all positions of the primitive in the grid\n  goals = find_all_primitive_positions(primitive)\n\n  # Check if any goal is reachable directly\n  start_position = current_state.pos\n  reachable_goals = [goal for goal in goals if is_reachable_directly(start_position, goal)]\n\n  if reachable_goals:\n      min_distance_goal = None\n      min_distance = float('inf')\n      for goal in reachable_goals:\n          distance = abs(goal[0] - start_position[0]) + abs(goal[1] - start_position[1])\n          if distance < min_distance:\n              min_distance = distance\n              min_distance_goal = goal\n      \n      shortest_path = bfs(start_position, min_distance_goal)\n  else:\n      # If not reachable directly, find a path using available tools\n      shortest_path_with_tool, found_tool_path = find_path_with_tool(start_position, goals)\n      if found_tool_path:\n          shortest_path = shortest_path_with_tool\n      else:\n          raise ValueError(f\"No valid path found to collect {primitive} with available tools.\")\n\n  # Convert the shortest path to actions\n  actions = []\n  for i in range(len(shortest_path) - 1):\n      from_pos = shortest_path[i]\n      to_pos = shortest_path[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if shortest_path and current_state.grid[shortest_path[-1][0], shortest_path[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T09:09:51.458104", "function_name": "collect", "function_body": "  from collections import deque\n  from numpy.linalg import norm\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Assuming specific mappings for demonstration purposes\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      def heuristic(x, y, target_x, target_y):\n          return norm(np.array([x, y]) - np.array([target_x, target_y]))\n\n      queue = deque([(start_pos[0], start_pos[1], 0)])\n      visited = set()\n      parent_map = {}\n      \n      while queue:\n          x, y, cost = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              path = []\n              while (x, y) != start_pos:\n                  path.append((x, y))\n                  x, y = parent_map[(x, y)]\n              return path[::-1]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_cost = cost + heuristic(nx, ny, start_pos[0], start_pos[1])\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, new_cost))\n                  parent_map[(nx, ny)] = (x, y)\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-03T09:09:52.574386", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Assuming specific mappings for demonstration purposes\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      def heuristic(x, y):\n          return abs(x - start_pos[0]) + abs(y - start_pos[1])\n\n      queue = deque([(start_pos[0], start_pos[1], 0, [])])\n      visited = set()\n      while queue:\n          x, y, cost, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_cost = cost + heuristic(nx, ny)\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, new_cost, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n  \n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
