get_action_to_move((x, y), (nx, ny))]\n                          else:\n                              continue\n\n                      if (nx, ny) not in cost_so_far or new_cost < cost_so_far[(nx, ny)]:\n                          cost_so_far[(nx, ny)] = new_cost\n                          priority = new_cost + heuristic(target, (nx, ny))\n                          queue.append(((nx, ny), new_path, priority))\n                          visited.add((nx, ny))\n                          came_from[(nx, ny)] = (x, y)\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return [get_action_to_move(start, next_pos) for start, next_pos in zip(path, path[1:])]\n\n  def get_required_tool_for_cell(cell_contents, inventory):\n      # Determine the tool required to interact with a cell based on its contents\n      for i in cell_contents:\n          item_name = env.world.cookbook.index.get(i)\n          if item_name == \"WATER\":\n              if \"BRIDGE\" in inventory:\n                  return env.world.cookbook.index.index(\"BRIDGE\")\n          elif item_name == \"ROCK\":\n              if \"PICKAXE\" in inventory:\n                  return env.world.cookbook.index.index(\"PICKAXE\")\n\n      return None\n\n  def find_closest_primitive(grid, primitive_index):\n      min_distance = float('inf')\n      closest_pos = None\n      start_pos = env._current_state.pos\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, primitive_index] > 0:\n                  distance = heuristic(start_pos, (x, y))\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_pos = (x, y)\n\n      return closest_pos\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Find the closest position of the primitive\n  target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n\n  if not target_pos:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n\n  # Get the start position and direction of the agent\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the target position considering obstacles and tools\n  path_to_primitive = find_path(env._current_state.grid, start_pos, target_pos, env._current_state.inventory)\n\n  if not path_to_primitive:\n      raise ValueError(\"No path found to the primitive.\")\n\n  return path_to_primitive", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T00:39:14.826194", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_action_to_move(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dy > 0:\n          actions.extend([DOWN] * dy)\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n      if dx > 0:\n          actions.extend([RIGHT] * dx)\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n\n      return actions\n\n  def heuristic(a, b):\n      # Manhattan distance as the heuristic for A*\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_path(grid, start, target, inventory):\n      queue = collections.deque([(start, [], 0)])\n      visited = set([start])\n      came_from = {}\n      cost_so_far = {start: 0}\n\n      while queue:\n          (x, y), path, cost = queue.popleft()\n\n          if (x, y) == target:\n              return reconstruct_path(came_from, start, (x, y)) + [USE]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      cell_contents = np.where(grid[nx, ny] > 0)[0]\n                      required_tool = get_required_tool_for_cell(cell_contents, inventory)\n                      if required_tool is not None and required_tool in inventory:\n                          new_cost = cost + 2  # Cost for moving and using the tool\n                          new_path = path + [USE]\n                      else:\n                          if all(env.world.cookbook.index.get(i) not in env.world.non_grabbable_indices for i in cell_contents):\n                              new_cost = cost + 1\n                              new_path = path + get_action_to_move((x, y), (nx, ny))\n                          else:\n                              continue\n\n                      if (nx, ny) not in cost_so_far or new_cost < cost_so_far[(nx, ny)]:\n                          cost_so_far[(nx, ny)] = new_cost\n                          priority = new_cost + heuristic(target, (nx, ny))\n                          queue.append(((nx, ny), new_path, priority))\n                          visited.add((nx, ny))\n                          came_from[(nx, ny)] = (x, y)\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return [action for pos in path for action in get_action_to_move(env._current_state.pos, pos)]\n\n  def get_required_tool_for_cell(cell_contents, inventory):\n      # Determine the tool required to interact with a cell based on its contents\n      for i in cell_contents:\n          item_name = env.world.cookbook.index.get(i)\n          if item_name == \"WATER\":\n              if \"BRIDGE\" in inventory:\n                  return env.world.cookbook.index.index(\"BRIDGE\")\n          elif item_name == \"ROCK\":\n              if \"PICKAXE\" in inventory:\n                  return env.world.cookbook.index.index(\"PICKAXE\")\n\n      return None\n\n  def find_closest_primitive(grid, primitive_index):\n      min_distance = float('inf')\n      closest_pos = None\n      start_pos = env._current_state.pos\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, primitive_index] > 0:\n                  distance = heuristic(start_pos, (x, y))\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_pos = (x, y)\n\n      return closest_pos\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Find the closest position of the primitive\n  target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n\n  if not target_pos:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n\n  # Get the start position and direction of the agent\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the target position considering obstacles and tools\n  path_to_primitive = find_path(env._current_state.grid, start_pos, target_pos, env._current_state.inventory)\n\n  if not path_to_primitive:\n      raise ValueError(\"No path found to the primitive.\")\n\n  return path_to_primitive", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T00:41:35.649050", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor, current_state.grid):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos, grid):\n      x, y = pos\n      width, height = grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find the position of the primitive in the grid\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  # Define a function to find the position of tools in the grid\n  def find_tool_position(tool):\n      i_tool = env.world.cookbook.index[tool]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_tool] > 0:\n                  return (x, y)\n      return None\n\n  # Define a function to use tools based on the environment\n  def use_tools(tool):\n      tool_position = find_tool_position(tool)\n      if tool_position and is_valid_move(tool_position, current_state.grid):\n          path_to_tool = bfs(current_state.pos, tool_position)\n          actions = []\n          for i in range(len(path_to_tool) - 1):\n              from_pos = path_to_tool[i]\n              to_pos = path_to_tool[i + 1]\n              dx = to_pos[0] - from_pos[0]\n              dy = to_pos[1] - from_pos[1]\n\n              if dx == 1:\n                  actions.append(action_map['RIGHT'])\n              elif dx == -1:\n                  actions.append(action_map['LEFT'])\n              elif dy == 1:\n                  actions.append(action_map['DOWN'])\n              elif dy == -1:\n                  actions.append(action_map['UP'])\n\n          # Ensure the agent picks up the tool once it reaches the position\n          if path_to_tool and current_state.grid[path_to_tool[-1][0], path_to_tool[-1][1], env.world.cookbook.index[tool]] > 0:\n              actions.append(action_map['USE'])\n          return actions\n      return []\n\n  # Define a function to check for necessary tools to collect the primitive\n  def find_required_tools(primitive):\n      if primitive in ['GOLD', 'GEM']:\n          return ['PICKAXE']\n      elif primitive == 'WATER':\n          return ['BRIDGE']\n      else:\n          return []\n\n  # Find required tools and use them if necessary\n  actions = []\n  required_tools = find_required_tools(primitive)\n  for tool in required_tools:\n      actions.extend(use_tools(tool))\n\n  # Find the position of the primitive\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  # Find the shortest path to the primitive using BFS\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  # Convert the path to actions\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
