n\n  # Find the shortest path to the primitive using BFS\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  # Convert the path to actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], i_primitive] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T03:47:07.811061", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find the position of the primitive in the grid\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  # Find the position of the primitive\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  # Check if the agent already has the primitive in inventory and can skip collection\n  i_primitive = env.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n      return []\n\n  # Define a function to check if there are tools available for specific obstacles\n  def find_tool_for_obstacle(obstacle):\n      tool_map = {\n          'WATER': ['BRIDGE'],\n          'ROCK': ['PICKAXE']\n      }\n      obstacle_index = env.world.cookbook.index[obstacle]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, obstacle_index] > 0:\n                  for tool in tool_map.get(obstacle, []):\n                      tool_index = env.world.cookbook.index[tool]\n                      if current_state.inventory[tool_index] > 0:\n                          return (x, y), tool\n      return None, None\n\n  # Check for obstacles on the path and use tools if available\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  actions = []\n  i = 0\n  while i < len(path_to_primitive) - 1:\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n\n      # Check if there is an obstacle between the current position and the next position\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n      \n      # Move to the next position\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n      # Check for obstacles and use tools if available\n      obstacle_position, tool = find_tool_for_obstacle(primitive)\n      if obstacle_position and current_state.grid[to_pos[0], to_pos[1], env.world.cookbook.index(obstacle)] > 0:\n          # Move to the obstacle position\n          obstacle_path = bfs(from_pos, obstacle_position)\n          for pos in range(len(obstacle_path) - 1):\n              from_obstacle_pos = obstacle_path[pos]\n              to_obstacle_pos = obstacle_path[pos + 1]\n              dx = to_obstacle_pos[0] - from_obstacle_pos[0]\n              dy = to_obstacle_pos[1] - from_obstacle_pos[1]\n\n              if dx == 1:\n                  actions.append(action_map['RIGHT'])\n              elif dx == -1:\n                  actions.append(action_map['LEFT'])\n              elif dy == 1:\n                  actions.append(action_map['DOWN'])\n              elif dy == -1:\n                  actions.append(action_map['UP'])\n\n          # Use the tool\n          actions.append(action_map['USE'])\n\n          # Update the path to the primitive after using the tool\n          start_position = from_pos\n          path_to_primitive = bfs(start_position, goal_position)\n          i = 0  # Restart from the beginning of the new path\n      else:\n          i += 1\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T03:49:25.592857", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_action_to_move(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dy > 0:\n          return DOWN\n      elif dy < 0:\n          return UP\n      elif dx > 0:\n          return RIGHT\n      elif dx < 0:\n          return LEFT\n\n      return None\n\n  def heuristic(a, b):\n      # Manhattan distance as the heuristic for A*\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_path(grid, start, target, inventory):\n      # Use A* to find the shortest path from start to target considering obstacles and tools in inventory\n      queue = collections.deque([(start, [], 0)])\n      visited = set([start])\n      came_from = {}\n      cost_so_far = {start: 0}\n\n      while queue:\n          (x, y), path, cost = queue.popleft()\n\n          if (x, y) == target:\n              return reconstruct_path(came_from, start, (x, y)) + [USE]\n\n          for nx, ny in [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]:\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      cell_contents = np.where(grid[nx, ny] > 0)[0]\n                      # Check for obstacles that can be removed with tools\n                      if any(env.world.cookbook.index.get(i) in env.world.non_grabbable_indices for i in cell_contents):\n                          required_tool = get_required_tool_for_cell(cell_contents, inventory)\n                          if required_tool is not None and required_tool in inventory:\n                              new_cost = cost + 2  # Cost includes moving and using the tool\n                              grid_copy = np.copy(grid)  # Simulate removing the obstacle\n                              grid_copy[nx, ny, required_tool] -= 1\n                              new_path = path + [USE]\n                      else:\n                          new_cost = cost + 1\n                          new_path = path + [get_action_to_move((x, y), (nx, ny))]\n\n                      if (nx, ny) not in cost_so_far or new_cost < cost_so_far[(nx, ny)]:\n                          cost_so_far[(nx, ny)] = new_cost\n                          priority = new_cost + heuristic(target, (nx, ny))\n                          queue.append(((nx, ny), new_path, priority))\n                          visited.add((nx, ny))\n                          came_from[(nx, ny)] = (x, y)\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return [get_action_to_move(start, next_pos) for start, next_pos in zip(path, path[1:])]\n\n  def get_required_tool_for_cell(cell_contents, inventory):\n      # Determine the tool required to interact with a cell based on its contents\n      for i in cell_contents:\n          item_name = env.world.cookbook.index.get(i)\n          if item_name == \"WATER\":\n              if \"BRIDGE\" in inventory:\n                  return env.world.cookbook.index.index(\"BRIDGE\")\n          elif item_name == \"ROCK\":\n              if \"PICKAXE\" in inventory:\n                  return env.world.cookbook.index.index(\"PICKAXE\")\n\n      return None\n\n  def find_closest_primitive(grid, primitive_index):\n      # Find the closest position of the primitive using a simple BFS\n      queue = collections.deque([env._current_state.pos])\n      visited = set()\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n      while queue:\n          x, y = queue.popleft()\n          if grid[x, y, primitive_index] > 0:\n              return (x, y)\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  cell_contents = np.where(grid[nx, ny] > 0)[0]\n                  if all(env.world.cookbook.index.get(i) not in env.world.non_grabbable_indices for i in cell_contents):\n                      queue.append((nx, ny))\n                      visited.add((nx, ny))\n\n      return None\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Find the closest position of the primitive\n  target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n\n  if not target_pos:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n\n  # Get the start position and direction of the agent\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the target position considering obstacles and tools\n  path_to_primitive = find_path(env._current_state.grid, start_pos, target_pos, env._current_state.inventory)\n\n  if not path_to_primitive:\n      raise ValueError(\"No path found to the primitive.\")\n\n  return path_to_primitive", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T03:49:26.581579", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_action_to_move(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dy > 0:\n          return DOWN\n      elif dy < 0:\n          return UP\n      elif dx > 0:\n          return RIGHT\n      elif dx < 0:\n          return LEFT\n\n      return None\n\n  def heuristic(a, b):\n      # Manhattan distance as the heuristic for A*\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_path(grid, start, target, inventory):\n      queue = collections.deque([(start, [], 0)])\n      visited = set([start])\n      came_from = {}\n      cost_so_far = {start: 0}\n\n      while queue:\n          (x, y), path, cost = queue.popleft()\n\n          if (x, y) == target:\n              return reconstruct_path(came_from, start, (x, y)) + [USE]\n\n          for nx, ny in [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]:\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      cell_contents = np.where(grid[nx, ny] > 0)[0]\n                      required_tool = get_required_tool_for_cell(cell_contents, inventory)\n\n                      if required_tool is not None and required_tool in inventory:\n                          # Simulate using the tool to clear the obstacle\n                          new_cost = cost + 2  # Cost for moving and using the tool\n                          new_path = path + [USE]\n                      else:\n                          if all(env.world.cookbook.index.get(i) not in env.world.non_grabbable_indices for i in cell_contents):\n                              new_cost = cost + 1\n                              new_path = path + [get_action_to_move((x, y), (nx, ny))]\n                          else:\n                              continue\n\n                      if (nx, ny) not in cost_so_far or new_cost < cost_so_far[(nx, ny)]:\n                          cost_so_far[(nx, ny)] = new_cost\n                          priority = new_cost + heuristic(target, (nx, ny))\n                          queue.append(((nx, ny), new_path, priority))\n                          visited.add((nx, ny))\n                          came_from[(nx, ny)] = (x, y)\n\n      return None\n\n  def reconstruct_path(came_from, start, goal):\n      current = goal\n      path = []\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      return [get_action_to_move(start, next_pos) for start, next_pos in zip(path, path[1:])]\n\n  def get_required_tool_for_cell(cell_contents, inventory):\n      # Determine the tool required to interact with a cell based on its contents\n      for i in cell_contents:\n          item_name = env.world.cookbook.index.get(i)\n          if item_name == \"WATER\":\n              if \"BRIDGE\" in inventory:\n                  return env.world.cookbook.index.index(\"BRIDGE\")\n          elif item_name == \"ROCK\":\n              if \"PICKAXE\" in inventory:\n                  return env.world.cookbook.index.index(\"PICKAXE\")\n\n      return None\n\n  def find_closest_primitive(grid, primitive_index):\n      # Use BFS to find the closest primitive\n      queue = collections.deque([env._current_state.pos])\n      visited = set()\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n\n      while queue:\n          x, y = queue.popleft()\n          if grid[x, y, primitive_index] > 0:\n              return (x, y)\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  cell_contents = np.where(grid[nx, ny] > 0)[0]\n                  if all(env.world.cookbook.index.get(i) not in env.world.non_grabbable_indices for i in cell_contents):\n                      queue.append((nx, ny))\n                      visited.add((nx, ny))\n\n      return None\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Find the closest position of the primitive\n  target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n\n  if not target_pos:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n\n  # Get the start position and direction of the agent\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the target position considering obstacles and tools\n  path_to_primitive = find_path(env._current_state.grid, start_pos, target_pos, env._current_state.inventory)\n\n  if not path_to_primitive:\n      raise ValueError(\"No path found to the primitive.\")\n\n  return path_to_primitive", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T03:51:37.626782", "function_name": "collect", "function_body": "  action_map = {\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"UP\": env.action_specs()[\"UP\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"],\n      \"USE\": env.action_specs()[\"USE\"]\n  }\n\n  # Initialize the list to store actions.\n  actions = []\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Fetch the world's cookbook and index mapping.\n  world_cookbook = current_state.world.cookbook\n  world_index = world_cookbook.index\n\n  # Convert primitive name to its corresponding index.\n  primitive_index = world_index[primitive]\n\n  # Get the grid layout from the current state.\n  grid = current_state.grid\n\n  def next_to(kind_index: int) -> bool:\n      return current_state.next_to(kind_index)\n\n  def find_nearest_entity(kind_index: int, max_distance=50) -> tuple[int, int] or None:\n      pos = np.array(current_state.pos)\n      for distance in range(1, max_distance + 1):\n          for dx, dy in [(distance, 0), (-distance, 0), (0, distance), (0, -distance)]:\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  if grid[x, y, kind_index] > 0:\n                      return (x, y)\n      return None\n\n  def move_towards(target_pos: tuple[int, int]) -> list[int]:\n      current_pos = np.array(current_state.pos)\n      target_np = np.array(target_pos)\n      direction = target_np - current_pos\n      moves = []\n      if direction[0] > 0:\n          moves.append(action_map[\"RIGHT\"])\n      elif direction[0] < 0:\n          moves.append(action_map[\"LEFT\"])\n      if direction[1] > 0:\n          moves.append(action_map[\"DOWN\"])\n      elif direction[1] < 0:\n          moves.append(action_map[\"UP\"])\n      return moves\n\n  def collect_nearest_primitive(kind_index: int) -> list[int]:\n      target_pos = find_nearest_entity(kind_index)\n      if not target_pos:\n          return []\n      moves = move_towards(target_pos)\n      actions.extend(moves)\n      actions.append(action_map[\"USE\"])\n      return actions\n\n  def use_tool_on_entity(tool_index: int, target_kind_index: int) -> list[int]:\n      if not next_to(target_kind_index):\n          return []\n      if current_state.inventory[tool_index] > 0:\n          actions.append(action_map[\"USE\"])\n      return actions\n\n  def collect_water() -> list[int]:\n      water_index = world_index[\"WATER\"]\n      bridge_index = world_index[\"BRIDGE\"]\n      if next_to(water_index):\n          use_tool_on_entity(bridge_index, water_index)\n      return collect_nearest_primitive(water_index)\n\n  def collect_stone() -> list[int]:\n      stone_index = world_index[\"STONE\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(stone_index):\n          use_tool_on_entity(pickaxe_index, stone_index)\n      return collect_nearest_primitive(stone_index)\n\n  def collect_wood() -> list[int]:\n      wood_index = world_index[\"WOOD\"]\n      axe_index = world_index[\"AXE\"]\n      if next_to(wood_index):\n          use_tool_on_entity(axe_index, wood_index)\n      return collect_nearest_primitive(wood_index)\n\n  def collect_gold() -> list[int]:\n      gold_index = world_index[\"GOLD\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(gold_index):\n          use_tool_on_entity(pickaxe_index, gold_index)\n      return collect_nearest_primitive(gold_index)\n\n  def collect_gem() -> list[int]:\n      gem_index = world_index[\"GEM\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(gem_index):\n          use_tool_on_entity(pickaxe_index, gem_index)\n      return collect_nearest_primitive(gem_index)\n\n  def collect_iron() -> list[int]:\n      iron_index = world_index[\"IRON\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(iron_index):\n          use_tool_on_entity(pickaxe_index, iron_index)\n      return collect_nearest_primitive(iron_index)\n\n  # Dispatch the appropriate collection function based on the primitive.\n  if primitive == \"WATER\":\n      actions = collect_water()\n  elif primitive == \"STONE\":\n      actions = collect_stone()\n  elif primitive == \"WOOD\":\n      actions = collect_wood()\n  elif primitive == \"GOLD\":\n      actions = collect_gold()\n  elif primitive == \"GEM\":\n      actions = collect_gem()\n  elif primitive == \"IRON\":\n      actions = collect_iron()\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T03:51:38.656852", "function_name": "collect", "function_body": "  action_map = {\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"UP\": env.action_specs()[\"UP\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"],\n      \"USE\": env.action_specs()[\"USE\"]\n  }\n\n  # Initialize the list to store actions.\n  actions = []\n\n  # Get the current state of the environment.\n  current_state = env._current_state\n\n  # Fetch the world's cookbook and index mapping.\n  world_cookbook = current_state.world.cookbook\n  world_index = world_cookbook.index\n\n  # Convert primitive name to its corresponding index.\n  primitive_index = world_index[primitive]\n\n  # Get the grid layout from the current state.\n  grid = current_state.grid\n\n  def next_to(kind_index: int) -> bool:\n      return current_state.next_to(kind_index)\n\n  def find_nearest_entity(kind_index: int, max_distance=50) -> tuple[int, int] or None:\n      pos = np.array(current_state.pos)\n      for distance in range(1, max_distance + 1):\n          for dx, dy in [(distance, 0), (-distance, 0), (0, distance), (0, -distance)]:\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  if grid[x, y, kind_index] > 0:\n                      return (x, y)\n      return None\n\n  def move_towards(target_pos: tuple[int, int]) -> list[int]:\n      current_pos = np.array(current_state.pos)\n      target_np = np.array(target_pos)\n      direction = target_np - current_pos\n      moves = []\n      if direction[0] > 0:\n          for _ in range(direction[0]):\n              moves.append(action_map[\"RIGHT\"])\n      elif direction[0] < 0:\n          for _ in range(-direction[0]):\n              moves.append(action_map[\"LEFT\"])\n      if direction[1] > 0:\n          for _ in range(direction[1]):\n              moves.append(action_map[\"DOWN\"])\n      elif direction[1] < 0:\n          for _ in range(-direction[1]):\n              moves.append(action_map[\"UP\"])\n      return moves\n\n  def collect_nearest_primitive(kind_index: int) -> list[int]:\n      target_pos = find_nearest_entity(kind_index)\n      if not target_pos:\n          return []\n      moves = move_towards(target_pos)\n      actions.extend(moves)\n      actions.append(action_map[\"USE\"])\n      return actions\n\n  def use_tool_on_entity(tool_index: int, target_kind_index: int) -> list[int]:\n      if next_to(target_kind_index):\n          if current_state.inventory[tool_index] > 0:\n              actions.append(action_map[\"USE\"])\n      return actions\n\n  # Define a helper function to collect water using a bridge.\n  def collect_water() -> list[int]:\n      water_index = world_index[\"WATER\"]\n      bridge_index = world_index[\"BRIDGE\"]\n      if next_to(water_index):\n          use_tool_on_entity(bridge_index, water_index)\n      return collect_nearest_primitive(water_index)\n\n  # Define a helper function to collect stone.\n  def collect_stone() -> list[int]:\n      stone_index = world_index[\"STONE\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(stone_index):\n          use_tool_on_entity(pickaxe_index, stone_index)\n      return collect_nearest_primitive(stone_index)\n\n  # Define a helper function to collect wood.\n  def collect_wood() -> list[int]:\n      wood_index = world_index[\"WOOD\"]\n      axe_index = world_index[\"AXE\"]\n      if next_to(wood_index):\n          use_tool_on_entity(axe_index, wood_index)\n      return collect_nearest_primitive(wood_index)\n\n  # Define a helper function to collect gold.\n  def collect_gold() -> list[int]:\n      gold_index = world_index[\"GOLD\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(gold_index):\n          use_tool_on_entity(pickaxe_index, gold_index)\n      return collect_nearest_primitive(gold_index)\n\n  # Define a helper function to collect gem.\n  def collect_gem() -> list[int]:\n      gem_index = world_index[\"GEM\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(gem_index):\n          use_tool_on_entity(pickaxe_index, gem_index)\n      return collect_nearest_primitive(gem_index)\n\n  # Define a helper function to collect iron.\n  def collect_iron() -> list[int]:\n      iron_index = world_index[\"IRON\"]\n      pickaxe_index = world_index[\"PICKAXE\"]\n      if next_to(iron_index):\n          use_tool_on_entity(pickaxe_index, iron_index)\n      return collect_nearest_primitive(iron_index)\n\n  # Dispatch the appropriate collection function based on the primitive.\n  if primitive == \"WATER\":\n      actions = collect_water()\n  elif primitive == \"STONE\":\n      actions = collect_stone()\n  elif primitive == \"WOOD\":\n      actions = collect_wood()\n  elif primitive == \"GOLD\":\n      actions = collect_gold()\n  elif primitive == \"GEM\":\n      actions = collect_gem()\n  elif primitive == \"IRON\":\n      actions = collect_iron()\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T03:53:24.224267", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  inventory = current_state.inventory\n\n  # Convert the primitive name to its corresponding index\n  primitive_index = cookbook.index[primitive]\n\n  actions = []\n\n  def find_path_to_primitive(current_pos, primitive_index):\n    \"\"\"Find a path from current position to the closest cell containing the primitive.\"\"\"\n    grid = current_state.grid\n    width, height, _ = grid.shape\n\n    # Directions: (delta_x, delta_y)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_valid(x, y):\n        return 0 <= x < width and 0 <= y < height\n\n    queue = collections.deque([(current_pos[0], current_pos[1], [])])\n    visited = set()\n\n    while queue:\n        x, y, path = queue.popleft()\n        \n        if grid[x, y, primitive_index] > 0:\n            return path\n        \n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if is_valid(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path + [direction_to_action(dx, dy)]))\n\n    return []\n\n  def direction_to_action(dx: int, dy: int) -> int:\n      \"\"\"Convert a grid direction to an action index.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"UP\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"DOWN\"]\n\n      raise ValueError(\"Invalid direction\")\n\n  # Tools required for specific primitives\n  tool_required_for_primitive = {\n      'GOLD': ['PICKAXE', 'AXE'],\n      'GEM': ['PICKAXE', 'AXE'],\n      'STONE': ['HAMMER']\n  }\n\n  # Check if tools are needed and use them if available in inventory\n  has_tool = False\n  if primitive in tool_required_for_primitive:\n      for tool in tool_required_for_primitive[primitive]:\n          tool_index = cookbook.index.get(tool, -1)\n          if tool_index != -1 and inventory[tool_index] > 0:\n              actions.append(env.action_specs()[\"USE\"])  # Use the tool\n              has_tool = True\n              break\n\n      if not has_tool:\n          raise ValueError(f\"No suitable tool in inventory to collect {primitive}.\")\n\n  # Find the path to the primitive\n  path_to_primitive = find_path_to_primitive(current_state.pos, primitive_index)\n\n  if not path_to_primitive:\n      raise ValueError(f\"No path found to collect {primitive}.\")\n  \n  actions.extend(path_to_primitive)\n\n  # Check for water obstacles and place bridges if needed\n  width, height, _ = current_state.grid.shape\n\n  def is_water_cell(x, y):\n    return current_state.grid[x, y, cookbook.index['WATER']] > 0\n\n  def find_path_with_bridges():\n      \"\"\"Find a path from current position to the primitive, considering water and bridges.\"\"\"\n      queue = collections.deque([(current_pos[0], current_pos[1], [])])\n      visited = set()\n\n      while queue:\n          x, y, path = queue.popleft()\n          \n          if grid[x, y, primitive_index] > 0:\n              return path\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if is_valid(nx, ny) and (nx, ny) not in visited:\n                  if is_water_cell(nx, ny):\n                      # Check if there's a bridge or the agent can place one\n                      if inventory[cookbook.index['BRIDGE']] > 0:\n                          actions.append(direction_to_action(dx, dy))\n                          actions.append(env.action_specs()[\"USE\"])  # Place the bridge\n                          visited.add((nx, ny))\n                          queue.append((nx, ny, path + [direction_to_action(dx, dy)]))\n                      else:\n                          continue\n                  else:\n                      visited.add((nx, ny))\n                      queue.append((nx, ny, path + [direction_to_action(dx, dy)]))\n\n      return []\n\n  if any(is_water_cell(x, y) for x, _ in enumerate(range(width)) for y, _ in enumerate(range(height))):\n    path = find_path_with_bridges()\n    actions.extend(path)\n  else:\n    path = find_path_to_primitive(current_pos, primitive_index)\n    actions.extend(path)\n\n  # Finally, add the USE action to collect or mine the primitive\n  if primitive in ['GOLD', 'GEM', 'STONE']:\n    actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-03T03:53:25.202051", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  inventory = current_state.inventory\n\n  # Convert the primitive name to its corresponding index\n  primitive_index = cookbook.index[primitive]\n\n  actions = []\n\n  def find_path_to_primitive(current_pos, primitive_index):\n    \"\"\"Find a path from current position to the closest cell containing the primitive.\"\"\"\n    grid = current_state.grid\n    width, height, _ = grid.shape\n\n    # Directions: (delta_x, delta_y)\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_valid(x, y):\n        return 0 <= x < width and 0 <= y < height\n\n    queue = collections.deque([(current_pos[0], current_pos[1], [])])\n    visited = set()\n\n    while queue:\n        x, y, path = queue.popleft()\n        \n        if grid[x, y, primitive_index] > 0:\n            return path\n        \n        for dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            if is_valid(nx, ny) and (nx, ny) not in visited:\n                visited.add((nx, ny))\n                queue.append((nx, ny, path + [direction_to_action(dx, dy)]))\n\n    return []\n\n  def direction_to_action(dx: int, dy: int) -> int:\n      \"\"\"Convert a grid direction to an action index.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"UP\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"DOWN\"]\n\n      raise ValueError(\"Invalid direction\")\n\n  # Define tools required for specific primitives\n  tool_required_for_primitive = {\n      'GOLD': ['PICKAXE', 'AXE'],\n      'GEM': ['PICKAXE', 'AXE'],\n      'STONE': ['HAMMER']\n  }\n\n  # Check if the primitive can be directly collected without any tools.\n  if primitive not in tool_required_for_primitive:\n      path = find_path_to_primitive(current_state.pos, primitive_index)\n      actions.extend(path)\n      actions.append(env.action_specs()[\"USE\"])  # Collect the primitive\n      return actions\n\n  has_tool = False\n  for tool in tool_required_for_primitive[primitive]:\n      tool_index = cookbook.index.get(tool, -1)\n      if tool_index != -1 and inventory[tool_index] > 0:\n          actions.append(env.action_specs()[\"USE\"])  # Use the tool\n          has_tool = True\n          break\n\n  if not has_tool:\n      raise ValueError(f\"No suitable tool in inventory to collect {primitive}.\")\n\n  path = find_path_to_primitive(current_state.pos, primitive_index)\n  actions.extend(path)\n\n  # Finally, add the USE action to collect or mine the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T03:55:26.002931", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    \"\"\"Retrieve the index of the given primitive from the cookbook.\"\"\"\n    return env.world.cookbook.index[primitive]\n\n  def find_nearest_resource(grid, pos, resource_index, inventory, world):\n      \"\"\"Find the shortest path to the nearest resource using BFS.\"\"\"\n      from queue import Queue\n\n      q = Queue()\n      visited = set()\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      \n      # Start BFS at the agent's initial position\n      q.put((pos[0], pos[1], []))\n      visited.add(pos)\n      \n      while not q.empty():\n          x, y, path = q.get()\n          \n          if grid[x, y, resource_index] > 0:\n              return path + [(x, y)]  # Return the path to the resource\n      \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if (is_within_bounding_box(nx, ny, grid.shape[0], grid.shape[1])\n                  and (nx, ny) not in visited):\n                  # Check if the next cell is traversable or requires a tool\n                  if not any(world.non_grabbable_indices & set(grid[nx, ny])):\n                      q.put((nx, ny, path + [(x, y)]))\n                      visited.add((nx, ny))\n                  else:\n                      # Handle cells that require tools (e.g., WATER)\n                      for i_kind in world.non_grabbable_indices:\n                          if grid[nx, ny, i_kind] > 0 and inventory[world.cookbook.index[i_kind]] == 0:\n                              tool_name = None\n                              if i_kind == world.water_index:\n                                  tool_name = 'BRIDGE'\n                              elif i_kind == world.stone_index:\n                                  tool_name = 'PICKAXE'\n                              \n                              if tool_name:\n                                  # Collect the required tool\n                                  actions_to_tool = collect_tools(tool_name, inventory, env)\n                                  if not actions_to_tool:\n                                      return None\n                                  actions.extend(actions_to_tool)\n                                  q.put((nx, ny, path + [(x, y)]))\n                                  visited.add((nx, ny))\n      return None\n\n  def get_next_action(current_pos, target_pos):\n    \"\"\"Determine the next action to move from current_pos to target_pos.\"\"\"\n    if current_pos[0] < target_pos[0]:\n        return craft.DOWN\n    elif current_pos[0] > target_pos[0]:\n        return craft.UP\n    elif current_pos[1] < target_pos[1]:\n        return craft.RIGHT\n    else:\n        return craft.LEFT\n\n  def get_actions_to_path(path):\n      \"\"\"Convert a path of positions into a sequence of actions.\"\"\"\n      actions = []\n      for i in range(len(path) - 1):\n          next_action = get_next_action(path[i], path[i + 1])\n          if next_action is not None:\n              actions.append(next_action)\n      return actions\n\n  def collect_tools(tool_name, inventory, env):\n      \"\"\"Collect tools needed to reach the resource.\"\"\"\n      tool_index = env.world.cookbook.index[tool_name]\n      if inventory[tool_index] > 0:\n          return []\n      \n      # Find path to nearest tool\n      tool_path = find_nearest_resource(env._current_state.grid, env._current_state.pos, tool_index, inventory, env.world)\n      if not tool_path:\n          return None\n      \n      actions_to_tool = get_actions_to_path(tool_path[:-1])\n      actions_to_tool.append(craft.USE)  # Use the tool once found\n      for action in actions_to_tool:\n          _, done, _ = env.step(action)\n          if done:\n              break\n      \n      inventory[tool_index] += 1\n      return actions_to_tool\n\n  def is_within_bounding_box(x, y, width, height):\n    \"\"\"Check if a position (x, y) is within the bounding box defined by width and height.\"\"\"\n    return x >= 0 and x < width and y >= 0 and y < height\n\n  primitive_index = get_primitive_index(primitive)\n  grid = env._current_state.grid.copy()\n  current_position = env._current_state.pos\n  inventory = collections.Counter(env._current_state.inventory)\n  actions = []\n\n  path_to_resource = find_nearest_resource(grid, current_position, primitive_index, inventory, env.world)\n\n  if not path_to_resource:\n      return []\n\n  actions_to_target = get_actions_to_path(path_to_resource[:-1])\n  # Add the USE action to collect the resource\n  actions_to_target.append(craft.USE)\n\n  return actions + actions_to_target", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-03T03:55:26.969827", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    return env.world.cookbook.index[primitive]\n\n  def find_nearest_resource(grid, pos, resource_index, inventory, world):\n      # Use BFS to find the shortest path to the nearest resource\n      from queue import Queue\n\n      q = Queue()\n      visited = set()\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      \n      # Start BFS at the agent's initial position\n      q.put((pos[0], pos[1], []))\n      visited.add(pos)\n      \n      while not q.empty():\n          x, y, path = q.get()\n          \n          if grid[x, y, resource_index] > 0:\n              return path + [(x, y)]  # Return the path to the resource\n      \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if is_within_bounding_box(nx, ny, grid.shape[0], grid.shape[1]) and (nx, ny) not in visited:\n                  # Check if the next cell is traversable or requires a tool\n                  if not any(world.non_grabbable_indices & set(grid[nx, ny])):\n                      q.put((nx, ny, path + [(x, y)]))\n                      visited.add((nx, ny))\n                  else:\n                      # Handle cells that require tools (e.g., WATER)\n                      for i_kind in world.non_grabbable_indices:\n                          if grid[nx, ny, i_kind] > 0 and inventory[world.cookbook.index[env.world.cookbook.get_name(i_kind)]] > 0:\n                              q.put((nx, ny, path + [(x, y)]))\n                              visited.add((nx, ny))\n      return None\n\n  def get_next_action(current_pos, target_pos):\n    # Determine the next action to move from current_pos to target_pos\n    if current_pos[0] < target_pos[0]:\n        return craft.DOWN\n    elif current_pos[0] > target_pos[0]:\n        return craft.UP\n    elif current_pos[1] < target_pos[1]:\n        return craft.RIGHT\n    else:\n        return craft.LEFT\n\n  def get_actions_to_path(path):\n    # Convert a path of positions into a sequence of actions\n    actions = []\n    for i in range(len(path) - 1):\n        next_action = get_next_action(path[i], path[i + 1])\n        if next_action is not None:\n            actions.append(next_action)\n    return actions\n\n  def collect_tools(tool_name, inventory, env):\n      \"\"\"Collect tools needed to reach the resource.\"\"\"\n      tool_index = env.world.cookbook.index[tool_name]\n      if inventory[tool_index] > 0:\n          return []\n      \n      # Find path to nearest tool\n      tool_path = find_nearest_resource(env._current_state.grid, env._current_state.pos, tool_index, inventory, env.world)\n      if not tool_path:\n          return None\n      \n      actions_to_tool = get_actions_to_path(tool_path[:-1])\n      actions_to_tool.append(craft.USE)  # Use the tool once found\n      for action in actions_to_tool:\n          _, done, _ = env.step(action)\n          if done:\n              break\n      \n      inventory[tool_index] += 1\n      return actions_to_tool\n\n  def is_within_bounding_box(x, y, width, height):\n    \"\"\"Check if a position (x, y) is within the bounding box defined by width and height.\"\"\"\n    return x >= 0 and x < width and y >= 0 and y < height\n\n  primitive_index = get_primitive_index(primitive)\n  grid = env._current_state.grid.copy()\n  current_position = env._current_state.pos\n  inventory = collections.Counter(env._current_state.inventory)\n\n  # Collect tools if required (e.g., BRIDGE, PICKAXE)\n  tools_required = {'WATER': 'BRIDGE', 'STONE': 'PICKAXE'}\n  for non_grab_index in env.world.non_grabbable_indices:\n      if grid[current_position[0], current_position[1], non_grab_index] > 0:\n          tool_name = tools_required.get(env.world.cookbook.index[env.world.cookbook.get_name(non_grab_index)])\n          if tool_name and inventory[tool_index] == 0:\n              actions_to_tool = collect_tools(tool_name, inventory, env)\n              if not actions_to_tool:\n                  return []\n\n  path_to_resource = find_nearest_resource(grid, current_position, primitive_index, inventory, env.world)\n\n  if not path_to_resource:\n      return []\n\n  actions_to_target = get_actions_to_path(path_to_resource[:-1])\n  # Add the USE action to collect the resource\n  actions_to_target.append(craft.USE)\n\n  return actions_to_target", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-03T03:57:02.517669", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  # Define a function to check if a move is valid (not out of bounds or into an obstacle)\n  def is_valid_move(pos):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Define a function to find the position of the primitive in the grid\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  # Find the position of the primitive\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  # Find the shortest path to the primitive using BFS\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position)\n\n  # Convert the path to actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T03:57:03.481279", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to get neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Define the BFS to find the shortest path considering obstacles and tools in inventory\n  def bfs_with_tools(start, goal):\n      queue = collections.deque([(start, [], set(current_state.inventory))])\n      visited = set([start])\n\n      while queue:\n          pos, path, tools = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor, tools):\n                  visited.add(neighbor)\n                  new_tools = set(tools)\n                  new_path = path + [neighbor]\n                  queue.append((neighbor, new_path, new_tools))\n\n  # Define a function to check if a move is valid considering obstacles and tools\n  def is_valid_move(pos, tools):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n\n      # Check for boundary\n      if current_state.grid[x, y, env.world.cookbook.index['BOUNDARY']] > 0:\n          return False\n\n      # Check for water and bridge tool\n      if current_state.grid[x, y, env.world.cookbook.index['WATER']] > 0:\n          return 'BRIDGE' in tools\n\n      # Check for rock and pickaxe tool\n      if current_state.grid[x, y, env.world.cookbook.index['ROCK']] > 0:\n          return 'PICKAXE' in tools\n\n      # Check for gem and pickaxe tool\n      if current_state.grid[x, y, env.world.cookbook.index['GEM']] > 0:\n          return 'PICKAXE' in tools\n\n      # Add more checks for other obstacles and tools as needed\n      return True\n\n  # Define a function to find the position of the primitive in the grid\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  # Find the position of the primitive\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  # Find the shortest path to the primitive using BFS with tools consideration\n  start_position = current_state.pos\n  path_to_primitive = bfs_with_tools(start_position, goal_position)\n\n  # Convert the path to actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Ensure the agent picks up the primitive once it reaches the position\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-03T03:58:57.803862", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    return env.world.cookbook.index[primitive]\n\n  def find_nearest_resource(grid, pos, resource_index, inventory, world):\n      from queue import Queue\n      q = Queue()\n      visited = set()\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      q.put((pos[0], pos[1], []))\n      visited.add(pos)\n      \n      while not q.empty():\n          x, y, path = q.get()\n          \n          if grid[x, y, resource_index] > 0:\n              return path + [(x, y)]\n      \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if (nx >= 0 and nx < grid.shape[0] and ny >= 0 and ny < grid.shape[1]\n                  and (nx, ny) not in visited):\n                  non_grabbable_cells = set(grid[nx, ny]) & world.non_grabbable_indices\n                  if non_grabbable_cells:\n                      for i_kind in non_grabbable_cells:\n                          if i_kind == world.water_index and inventory[world.cookbook.index['BRIDGE']] > 0:\n                              q.put((nx, ny, path + [(x, y)]))\n                              visited.add((nx, ny))\n                          elif i_kind == world.stone_index and inventory[world.cookbook.index['PICKAXE']] > 0:\n                              q.put((nx, ny, path + [(x, y)]))\n                              visited.add((nx, ny))\n                  else:\n                      q.put((nx, ny, path + [(x, y)]))\n                      visited.add((nx, ny))\n      return None\n\n  def get_next_action(current_pos, target_pos):\n    if current_pos[0] < target_pos[0]:\n        return craft.DOWN\n    elif current_pos[0] > target_pos[0]:\n        return craft.UP\n    elif current_pos[1] < target_pos[1]:\n        return craft.RIGHT\n    else:\n        return craft.LEFT\n\n  def get_actions_to_path(path):\n      actions = []\n      for i in range(len(path) - 1):\n          next_action = get_next_action(path[i], path[i + 1])\n          if next_action is not None:\n              actions.append(next_action)\n      return actions\n\n  def collect_tools(tool_name, inventory, env):\n      tool_index = env.world.cookbook.index[tool_name]\n      if inventory[tool_index] > 0:\n          return []\n      \n      tool_path = find_nearest_resource(env._current_state.grid, env._current_state.pos, tool_index, inventory, env.world)\n      if not tool_path:\n          return None\n      \n      actions_to_tool = get_actions_to_path(tool_path[:-1])\n      actions_to_tool.append(craft.USE)  # Use the tool once found\n      for action in actions_to_tool:\n          _, done, _ = env.step(action)\n          if done:\n              break\n      \n      inventory[tool_index] += 1\n      return actions_to_tool\n\n  primitive_index = get_primitive_index(primitive)\n  grid = env._current_state.grid.copy()\n  current_position = env._current_state.pos\n  inventory = collections.Counter(env._current_state.inventory)\n\n  tools_required = {'WATER': 'BRIDGE', 'STONE': 'PICKAXE'}\n  \n  # Collect required tools first\n  for non_grab_index in env.world.non_grabbable_indices:\n      tool_name = tools_required.get(non_grab_index)\n      if tool_name and inventory[env.world.cookbook.index[tool_name]] == 0:\n          actions_to_tool = collect_tools(tool_name, inventory, env)\n          if not actions_to_tool:\n              return []\n\n  # Now find the path to the target resource\n  path_to_resource = find_nearest_resource(grid, current_position, primitive_index, inventory, env.world)\n\n  if not path_to_resource:\n      return []\n\n  actions_to_target = get_actions_to_path(path_to_resource[:-1])\n  actions_to_target.append(craft.USE)  # Add the USE action to collect the resource\n\n  return actions_to_target", "island_id": 3, "scores": {"3": 0.0}}
