{"timestamp": "2025-08-02T16:24:44.366655", "function_name": "collect", "function_body": "  # Helper function to compute the shortest path using BFS\n  def bfs(start_pos, target_kind):\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      queue = collections.deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if env._current_state.grid[x, y, target_kind] > 0:\n              return path\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if (nx, ny) not in visited and 0 <= nx < env.world.WIDTH and 0 <= ny < env.world.HEIGHT:\n                  visited.add((nx, ny))\n                  queue.append((nx, ny, path + [get_move_action(dx, dy)]))\n      return None\n\n  # Helper function to get the action index for a given move direction\n  def get_move_action(dx, dy):\n      if dx == 0 and dy == 1:\n          return craft.UP\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == -1 and dy == 0:\n          return craft.LEFT\n      else:\n          raise ValueError(\"Invalid move direction\")\n\n  # Get the index of the primitive to collect\n  primitive_index = env.world.cookbook.index(primitive)\n  \n  # Compute the shortest path to the primitive using BFS\n  path_to_primitive = bfs(env._current_state.pos, primitive_index)\n  \n  if not path_to_primitive:\n      raise ValueError(f\"No valid path found to {primitive}\")\n\n  return path_to_primitive", "island_id": 3, "scores": {"3": -1}}
