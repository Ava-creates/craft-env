tion_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Check if the primitive is collectible (e.g., not blocked by an obstacle)\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T08:25:32.273549", "function_name": "collect", "function_body": "  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  current_state = env._current_state\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def bfs(start, goal, obstacles=None, tools=None):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          pos, path = queue.popleft()\n          if pos == goal:\n              return path\n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_valid_move(neighbor, obstacles, tools):\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [neighbor]))\n\n  def is_valid_move(pos, obstacles=None, tools=None):\n      x, y = pos\n      width, height = current_state.grid.shape[:2]\n      if not (0 <= x < width) or not (0 <= y < height):\n          return False\n      \n      # Check for obstacles\n      if obstacles:\n          for obstacle in obstacles:\n              i_obstacle = env.world.cookbook.index[obstacle]\n              if current_state.grid[x, y, i_obstacle] > 0:\n                  return False\n      \n      # Check if any tool is required to move through this cell\n      if tools:\n          for tool, target in tools.items():\n              i_tool = env.world.cookbook.index[tool]\n              i_target = env.world.cookbook.index[target]\n              if current_state.grid[x, y, i_target] > 0 and not can_use_tool(tool):\n                  return False\n      \n      return True\n\n  def find_primitive_position(primitive):\n      i_primitive = env.world.cookbook.index[primitive]\n      for x in range(current_state.grid.shape[0]):\n          for y in range(current_state.grid.shape[1]):\n              if current_state.grid[x, y, i_primitive] > 0:\n                  return (x, y)\n      return None\n\n  def can_use_tool(tool):\n      i_tool = env.world.cookbook.index[tool]\n      return current_state.inventory[i_tool] > 0\n\n  # Identify obstacles and tools\n  obstacles = ['BOUNDARY']\n  tools_required = {\n      'WATER': 'BRIDGE',  # Example: to cross water, a bridge is needed\n      'ROCK': 'PICKAXE'   # Example: to mine rock, a pickaxe is needed\n  }\n\n  goal_position = find_primitive_position(primitive)\n  if not goal_position:\n      raise ValueError(f\"Primitive {primitive} not found in the grid.\")\n\n  start_position = current_state.pos\n  path_to_primitive = bfs(start_position, goal_position, obstacles=obstacles, tools=tools_required)\n\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      from_pos = path_to_primitive[i]\n      to_pos = path_to_primitive[i + 1]\n      dx = to_pos[0] - from_pos[0]\n      dy = to_pos[1] - from_pos[1]\n\n      if dx == 1:\n          actions.append(action_map['RIGHT'])\n      elif dx == -1:\n          actions.append(action_map['LEFT'])\n      elif dy == 1:\n          actions.append(action_map['DOWN'])\n      elif dy == -1:\n          actions.append(action_map['UP'])\n\n  # Check if the primitive is collectible (e.g., not blocked by an obstacle)\n  if path_to_primitive and current_state.grid[path_to_primitive[-1][0], path_to_primitive[-1][1], env.world.cookbook.index[primitive]] > 0:\n      actions.append(action_map['USE'])\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
