{"timestamp": "2025-08-02T16:25:34.476786", "function_name": "collect", "function_body": "  # Step 1: Retrieve the current state and relevant indices from the environment.\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  \n  # Step 2: Identify the index of the desired primitive.\n  primitive_index = cookbook.index(primitive)\n  \n  # Step 3: Check if the agent already has the primitive in its inventory. If so, return an empty list.\n  if current_state.inventory[primitive_index] > 0:\n    return []\n  \n  # Step 4: Use A* algorithm to find the shortest path to the nearest cell containing the desired primitive.\n  import heapq\n\n  def heuristic(pos1, pos2):\n      \"\"\"Heuristic function for A* algorithm using Manhattan distance.\"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def a_star_search(grid, start_pos, goal_index):\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {tuple(start_pos): 0}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if grid[current[0], current[1]].nonzero()[0] == goal_index:\n              return reconstruct_path(came_from, current)\n          \n          for direction in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              neighbor = (current[0] + direction[0], current[1] + direction[1])\n              \n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[tuple(current)] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(neighbor, start_pos)\n                      heapq.heappush(open_set, (f_score, neighbor))\n      \n      return None\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  start_pos = current_state.pos\n  goal_index = primitive_index\n  \n  # Step 5: Convert the path into a sequence of actions.\n  def path_to_actions(path):\n      actions = []\n      directions_map = {(0, 1): env.N_RIGHT, (0, -1): env.N_LEFT, (1, 0): env.N_DOWN, (-1, 0): env.N_UP}\n      \n      for i in range(len(path) - 1):\n          current, next_pos = path[i], path[i + 1]\n          direction = (next_pos[0] - current[0], next_pos[1] - current[1])\n          actions.append(directions_map[direction])\n      \n      # Step 6: Add the action to collect the primitive.\n      actions.append(env.USE)\n      return actions\n\n  path = a_star_search(current_state.grid, start_pos, goal_index)\n\n  if path is None:\n      return []  # No valid path found.\n\n  actions = path_to_actions(path)\n  return actions", "island_id": 5, "scores": {"3": -1}}
