{"timestamp": "2025-08-03T13:31:57.621029", "function_name": "collect", "function_body": "  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          \n          # Check if current direction allows movement to the next cell\n          if (dx, dy) in [(-1, 0), (1, 0)] and current_direction not in [0, 1]:\n              return False\n          elif (dx, dy) in [(0, -1), (0, 1)] and current_direction not in [2, 3]:\n              return False\n\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], start_pos[2], [])])\n      visited = set()\n      while queue:\n          x, y, current_direction, path = queue.popleft()\n          if (x, y, current_direction) in visited:\n              continue\n          visited.add((x, y, current_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny, current_direction):\n                  queue.append((nx, ny, (dx, dy), path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:33:40.474581", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_dir):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          \n          # Check if turning is needed\n          new_dir = get_new_direction(start_pos, (x, y))\n          return is_clear and current_dir == new_dir\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      def get_new_direction(start, end):\n          dx, dy = end[0] - start[0], end[1] - start[1]\n          if dx == -1 and dy == 0:\n              return \"LEFT\"\n          elif dx == 1 and dy == 0:\n              return \"RIGHT\"\n          elif dx == 0 and dy == -1:\n              return \"UP\"\n          elif dx == 0 and dy == 1:\n              return \"DOWN\"\n          else:\n              return None\n\n      queue = deque([(start_pos, current_state.dir, [])])\n      visited = set()\n      while queue:\n          pos, dir, path = queue.popleft()\n          x, y = pos\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [pos]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny, dir):\n                  queue.append((new_pos, get_new_direction(pos, new_pos), path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-03T13:33:41.453818", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos, current_state.dir, [])])\n      visited = set()\n      while queue:\n          pos, _, path = queue.popleft()\n          x, y = pos\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [pos]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny):\n                  queue.append((new_pos, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  def determine_direction_action(current_x, current_y, target_x, target_y):\n      \"\"\"Determines the direction action to move towards the target.\"\"\"\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx == 0 and dy == -1:\n          return ACTION_MAP[\"UP\"]\n      elif dx == 0 and dy == 1:\n          return ACTION_MAP[\"DOWN\"]\n      elif dx == -1 and dy == 0:\n          return ACTION_MAP[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return ACTION_MAP[\"RIGHT\"]\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          action = determine_direction_action(pos[0], pos[1], x, y)\n          actions.append(action)\n          pos = (x, y)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:35:26.394818", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, direction_index):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], 0, [])])  # (x, y, direction_index, path)\n      visited = set()\n      while queue:\n          x, y, dir_idx, path = queue.popleft()\n          if (x, y, dir_idx) in visited:\n              continue\n          visited.add((x, y, dir_idx))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for new_dir_idx, (dx, dy) in enumerate(directions):\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny, new_dir_idx):\n                  # Determine the action to turn to the correct direction\n                  current_direction = current_state.world.cookbook.index.get(dir_idx)\n                  target_direction = current_state.world.cookbook.index.get(new_dir_idx)\n                  actions_to_turn = determine_actions_to_turn(current_direction, target_direction)\n\n                  queue.append((nx, ny, new_dir_idx, path + [(x, y)] + actions_to_turn))\n      return None\n\n  def determine_actions_to_turn(current_direction, target_direction):\n      # Define the directions as indices\n      DIRECTIONS = [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]\n      \n      current_index = DIRECTIONS.index(current_direction)\n      target_index = DIRECTIONS.index(target_direction)\n\n      # Calculate the difference and wrap around if necessary\n      diff = (target_index - current_index) % 4\n\n      if diff == 0:\n          return []\n      elif diff == 1:\n          return [ACTION_MAP[\"RIGHT\"]]\n      elif diff == 2:\n          return [ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"RIGHT\"]]\n      elif diff == 3:\n          return [ACTION_MAP[\"LEFT\"]]\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          # Determine direction to move\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:35:27.385326", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, direction_index):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], 0, [])])  # (x, y, direction_index, path)\n      visited = set()\n      while queue:\n          x, y, dir_idx, path = queue.popleft()\n          if (x, y, dir_idx) in visited:\n              continue\n          visited.add((x, y, dir_idx))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for new_dir_idx, (dx, dy) in enumerate(directions):\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny, new_dir_idx):\n                  queue.append((nx, ny, new_dir_idx, path + [(nx, ny)]))\n      return None\n\n  def compute_direction_actions(start_pos, target_pos):\n      actions = []\n      dx, dy = target_pos[0] - start_pos[0], target_pos[1] - start_pos[1]\n      \n      while dx != 0 or dy != 0:\n          if dx < 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n              dx += 1\n          elif dx > 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n              dx -= 1\n          elif dy < 0:\n              actions.append(ACTION_MAP[\"UP\"])\n              dy += 1\n          elif dy > 0:\n              actions.append(ACTION_MAP[\"DOWN\"])\n              dy -= 1\n      \n      return actions\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          actions.extend(compute_direction_actions(pos, (x, y)))\n          pos = (x, y)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
