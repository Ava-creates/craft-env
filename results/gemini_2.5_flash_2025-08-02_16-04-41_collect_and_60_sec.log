.world.cookbook.index.index(current_state.world.cookbook.index.get(tool_needed_for_obstacle))\n          path_to_tool = find_tools(grid, pos, tool_index, inventory)\n          \n          if path_to_tool:\n              for (x, y) in path_to_tool[:-1]:  # Exclude the last position since we'll use there\n                  dx, dy = x - pos[0], y - pos[1]\n                  if dx == 0 and dy == -1:\n                      actions.append(ACTION_MAP[\"UP\"])\n                  elif dx == 0 and dy == 1:\n                      actions.append(ACTION_MAP[\"DOWN\"])\n                  elif dx == -1 and dy == 0:\n                      actions.append(ACTION_MAP[\"LEFT\"])\n                  elif dx == 1 and dy == 0:\n                      actions.append(ACTION_MAP[\"RIGHT\"])\n\n              # Collect the tool\n              actions.append(ACTION_MAP[\"USE\"])\n              \n              # Re-evaluate path to primitive with updated inventory\n              pos = (path_to_tool[-1][0], path_to_tool[-1][1])\n              path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
