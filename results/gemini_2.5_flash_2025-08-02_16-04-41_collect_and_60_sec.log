te.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          # Determine target direction based on movement vector\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          pos = (x, y)\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-03T15:29:59.596957", "function_name": "collect", "function_body": "  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          \n          # Check if the direction change requires a turn\n          dx, dy = direction\n          current_dx, current_dy = (start_pos[0] - x, start_pos[1] - y)\n          if current_dx != dx or current_dy != dy:\n              actions.append(ACTION_MAP[\"TURN\"])  # Assuming TURN is an action\n\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], [], start_pos[2]))  # Priority, x, y, path, direction\n      visited = set()\n      while queue:\n          _, x, y, path, pos_direction = heappop(queue)\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  heappush(queue, (heuristic((nx, ny), start_pos) + len(path), nx, ny, path + [(nx, ny)], (dx, dy)))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-03T15:30:00.585037", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index\n          else:\n              return None\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], []))\n      visited = set()\n      while queue:\n          _, x, y, path = heappop(queue)\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if can_move(nx, ny):\n                  heappush(queue, (heuristic((nx, ny), start_pos) + len(path), nx, ny, path + [(nx, ny)]))\n      return None\n\n  def plan_path(start, goal, inventory):\n      path = find_shortest_path(grid, start, goal, inventory)\n      if not path:\n          return []\n      \n      actions = []\n      for i in range(len(path) - 1):\n          x1, y1 = path[i]\n          x2, y2 = path[i + 1]\n          \n          dx, dy = x2 - x1, y2 - y1\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n      \n      return actions\n\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitive_index = current_state.world.cookbook.index.index(primitive)\n\n  path_to_primitive = find_shortest_path(grid, pos, primitive_index, inventory)\n  if not path_to_primitive:\n      return []\n\n  actions = plan_path(pos, path_to_primitive[-1], inventory)\n  actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-03T15:31:54.827318", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Placeholder for actual tool determination logic based on the world's rules\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, pos_direction):\n                  queue.append((nx, ny, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  def get_action_sequence(start_pos, end_pos):\n      actions = []\n      sx, sy = start_pos\n      ex, ey = end_pos\n      \n      while (sx, sy) != (ex, ey):\n          dx, dy = ex - sx, ey - sy\n          \n          if abs(dx) > abs(dy):\n              action = ACTION_MAP[\"LEFT\"] if dx < 0 else ACTION_MAP[\"RIGHT\"]\n          elif abs(dy) > abs(dx):\n              action = ACTION_MAP[\"UP\"] if dy < 0 else ACTION_MAP[\"DOWN\"]\n          else:\n              # If both dx and dy are zero, we're already at the target\n              break\n            \n          actions.append(action)\n          \n          # Update position based on action\n          if action == ACTION_MAP[\"LEFT\"]:\n              sx -= 1\n          elif action == ACTION_MAP[\"RIGHT\"]:\n              sx += 1\n          elif action == ACTION_MAP[\"UP\"]:\n              sy -= 1\n          elif action == ACTION_MAP[\"DOWN\"]:\n              sy += 1\n      \n      return actions\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if not path_to_primitive:\n      return actions\n\n  for i in range(len(path_to_primitive) - 1):\n      start_pos = path_to_primitive[i]\n      end_pos = path_to_primitive[i + 1]\n      actions.extend(get_action_sequence(start_pos, end_pos))\n\n  # Collect the primitive\n  actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-08-03T15:31:55.834114", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Placeholder for actual tool determination logic based on the world's rules\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  queue.append((nx, ny, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  def turn_to_direction(current_dir, target_dir):\n      # This function calculates the actions needed to turn from current_dir to target_dir.\n      # Placeholder for actual direction turning logic based on the world's rules\n      if current_dir == \"UP\":\n          if target_dir == \"LEFT\":\n              return [ACTION_MAP[\"LEFT\"]]\n          elif target_dir == \"RIGHT\":\n              return [ACTION_MAP[\"RIGHT\"]]\n          elif target_dir == \"DOWN\":\n              return [ACTION_MAP[\"DOWN\"], ACTION_MAP[\"DOWN\"]]\n      elif current_dir == \"DOWN\":\n          if target_dir == \"LEFT\":\n              return [ACTION_MAP[\"LEFT\"], ACTION_MAP[\"LEFT\"]]\n          elif target_dir == \"RIGHT\":\n              return [ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"RIGHT\"]]\n          elif target_dir == \"UP\":\n              return [ACTION_MAP[\"UP\"]]\n      elif current_dir == \"LEFT\":\n          if target_dir == \"DOWN\":\n              return [ACTION_MAP[\"DOWN\"]]\n          elif target_dir == \"UP\":\n              return [ACTION_MAP[\"UP\"]]\n          elif target_dir == \"RIGHT\":\n              return [ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"RIGHT\"]]\n      elif current_dir == \"RIGHT\":\n          if target_dir == \"DOWN\":\n              return [ACTION_MAP[\"DOWN\"]]\n          elif target_dir == \"UP\":\n              return [ACTION_MAP[\"UP\"]]\n          elif target_dir == \"LEFT\":\n              return [ACTION_MAP[\"LEFT\"], ACTION_MAP[\"LEFT\"]]\n      return []\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if not path_to_primitive:\n      return actions\n\n  for (x, y) in path_to_primitive[:-1]:\n      dx, dy = x - pos[0], y - pos[1]\n      \n      # Determine the direction based on relative position\n      target_direction = None\n      if abs(dx) > abs(dy):\n          target_direction = \"LEFT\" if dx < 0 else \"RIGHT\"\n      elif abs(dy) > abs(dx):\n          target_direction = \"UP\" if dy < 0 else \"DOWN\"\n\n      # Turn to the target direction\n      actions.extend(turn_to_direction(current_state.dir, target_direction))\n\n      # Move in the target direction\n      actions.append(ACTION_MAP[target_direction])\n\n      # Update current position and direction\n      pos = (x, y)\n      current_state.dir = target_direction\n\n  # Collect the primitive\n  actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
