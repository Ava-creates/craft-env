          \n          if dx == 0 and dy < 0:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy > 0:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx < 0 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n      return actions\n\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      actions = generate_actions(path_to_primitive)\n  else:\n      actions = []\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:18:32.401279", "function_name": "collect", "function_body": "  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n\n          # Check for direction compatibility (e.g., can't move diagonally)\n          if current_direction != (0, 0):\n              dx, dy = x - start_pos[0], y - start_pos[1]\n              if not (dx == 0 or dy == 0):  # Ensure only vertical or horizontal movement\n                  is_clear = False\n\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], 0, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              # Calculate the new direction\n              new_direction = (dx, dy)\n              if can_move(nx, ny, new_direction):\n                  queue.append((nx, ny, 0, path + [(nx, ny)]))\n\n      return None\n\n  def generate_actions(path, start_pos):\n      actions = []\n      current_x, current_y = start_pos\n      \n      for (x, y) in path:\n          dx, dy = x - current_x, y - current_y\n          \n          if dx == -1 and dy == 0:  # UP\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 1 and dy == 0:  # DOWN\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == 0 and dy == -1:  # LEFT\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 0 and dy == 1:  # RIGHT\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n          current_x, current_y = x, y\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n      return actions\n\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  \n  if path_to_primitive:\n      actions = generate_actions(path_to_primitive, pos)\n  else:\n      actions = []\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:20:30.517213", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def determine_tool(kind_index):\n      kind_name = current_state.world.cookbook.index.get(kind_index)\n      tool_map = {\n          \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n          \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n          \"BOUNDARY\": None,                          # Boundary does not require a tool\n          \"WOOD\": None,\n          \"IRON\": None,\n          \"GRASS\": None,\n          \"GOLD\": None,\n          \"GEM\": current_state.world.stone_index     # Assuming gems need a pickaxe tool\n      }\n      return tool_map.get(kind_name)\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      queue = deque([(start_pos, current_state.dir, [])])\n      visited = set()\n      while queue:\n          pos, _, path = queue.popleft()\n          x, y = pos\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [pos]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny):\n                  queue.append((new_pos, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(ACTION_MAP[\"LEFT\"])\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(ACTION_MAP[\"DOWN\"])\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(ACTION_MAP[\"UP\"])\n              current_y -= 1\n      return actions\n\n  def use_tool_if_needed(grid, pos, inventory):\n      x, y = pos\n      for i_kind in range(grid.shape[2]):\n          if grid[x, y, i_kind] == 1:\n              tool_needed = determine_tool(i_kind)\n              if tool_needed is not None and inventory[tool_needed] > 0:\n                  return ACTION_MAP[\"USE\"]\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          actions.extend(move_to_position(pos[0], pos[1], x, y))\n          pos = (x, y)\n\n          # Use tool if needed before moving to the next cell\n          action_tool = use_tool_if_needed(grid, pos, inventory)\n          if action_tool:\n              actions.append(action_tool)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:20:31.492891", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def determine_tool(kind_index):\n      kind_name = current_state.world.cookbook.index.get(kind_index)\n      tool_map = {\n          \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n          \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n          \"BOUNDARY\": None,                          # Boundary does not require a tool\n          \"WOOD\": None,\n          \"IRON\": None,\n          \"GRASS\": None,\n          \"GOLD\": None,\n          \"GEM\": current_state.world.stone_index     # Assuming gems need a pickaxe tool\n      }\n      return tool_map.get(kind_name)\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      queue = deque([(start_pos, current_state.dir, [])])\n      visited = set()\n      while queue:\n          pos, _, path = queue.popleft()\n          x, y = pos\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [pos]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_pos = (nx, ny)\n              \n              if can_move(nx, ny):\n                  queue.append((new_pos, current_state.dir, path + [(nx, ny)]))\n      return None\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(ACTION_MAP[\"LEFT\"])\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(ACTION_MAP[\"DOWN\"])\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(ACTION_MAP[\"UP\"])\n              current_y -= 1\n      return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n      # Calculate the difference in direction and rotate accordingly\n      dir_map = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # UP, DOWN, LEFT, RIGHT\n      current_index = dir_map.index(current_dir)\n      target_index = dir_map.index(target_dir)\n\n      if current_index == target_index:\n          return []\n      \n      actions = []\n      diff = (target_index - current_index) % 4\n      if diff == 1:\n          actions.append(ACTION_MAP[\"RIGHT\"])\n      elif diff == 2:\n          actions.extend([ACTION_MAP[\"RIGHT\"], ACTION_MAP[\"RIGHT\"]])\n      elif diff == 3:\n          actions.append(ACTION_MAP[\"LEFT\"])\n      \n      return actions\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          actions.extend(rotate_to_direction(current_state.dir, (y - pos[1], x - pos[0])))\n          actions.extend(move_to_position(pos[0], pos[1], x, y))\n          pos = (x, y)\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:22:08.796945", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          target_direction = None\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:22:09.777119", "function_name": "collect", "function_body": "  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          # Only append the \"USE\" action when necessary (e.g., moving over a bridge or picking up an item)\n          if grid[x, y, primitives_index] == 1:\n              actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:23:39.984990", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          tool_needed = None\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear, tool_needed\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              new_direction = (dx, dy)\n              \n              clear, tool_needed = can_move(nx, ny, new_direction)\n              if clear:\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:23:40.985040", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed is not None and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Mapping of kinds to tools\n          mapping = {\n              \"WATER\": current_state.world.water_index,\n              \"ROCK\": current_state.world.stone_index,\n              # Add more mappings as needed\n          }\n          return mapping.get(kind_name)\n\n      queue = deque([(start_pos[0], start_pos[1], [], [])])  # (x, y, path, tools_used)\n      visited = set()\n      while queue:\n          x, y, path, tools_used = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)], tools_used\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  queue.append((nx, ny, path + [(nx, ny)], tools_used))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  path_to_primitive, tools_used = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:28:24.114247", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n\n          # Check for direction compatibility (e.g., can't move diagonally)\n          if current_direction != (0, 0):\n              dx, dy = x - start_pos[0], y - start_pos[1]\n              if not (dx == 0 or dy == 0):  # Ensure only vertical or horizontal movement\n                  is_clear = False\n\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_mapping = {\n              \"WATER\": None,  # Water might require a bridge but no specific inventory item\n              \"ROCK\": current_state.world.stone_index,  # Rocks need a pickaxe\n              \"GOLD\": None,  # Gold may require a shovel but no specific inventory item\n              \"GEM\": current_state.world.stone_index  # Gems need a pickaxe\n          }\n          return tool_mapping.get(kind_name)\n\n      queue = deque([(start_pos[0], start_pos[1], [], 0)])  # (x, y, path, direction)\n      visited = set()\n      while queue:\n          x, y, path, dir = queue.popleft()\n          if (x, y) in visited and dir == 0:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  queue.append((nx, ny, path + [(nx, ny)], dir + 1))\n\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy < 0:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy > 0:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx < 0 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-03T13:28:25.096123", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, current_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n\n          # Check for direction compatibility (e.g., can't move diagonally)\n          if current_direction != (0, 0):\n              dx, dy = x - start_pos[0], y - start_pos[1]\n              if not (dx == 0 or dy == 0):  # Ensure only vertical or horizontal movement\n                  is_clear = False\n\n          return is_clear\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_mapping = {\n              \"WATER\": None,  # Water might require a bridge but no specific inventory item\n              \"ROCK\": current_state.world.stone_index,  # Rocks need a pickaxe\n              \"GOLD\": None,  # Gold may require a shovel but no specific inventory item\n              \"GEM\": current_state.world.stone_index  # Gems need a pickaxe\n          }\n          return tool_mapping.get(kind_name)\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  queue.append((nx, ny, current_state.dir, path + [(nx, ny)]))\n\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          if dx == 0 and dy < 0:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy > 0:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx < 0 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx > 0 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-03T13:30:06.747475", "function_name": "collect", "function_body": "  from collections import deque\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          if kind_name == \"WATER\":\n              return current_state.world.water_index  # Assuming water needs a bridge or boat tool\n          elif kind_name == \"ROCK\":\n              return current_state.world.stone_index  # Assuming rocks need a pickaxe tool\n          else:\n              return None\n\n      queue = deque([(start_pos[0], start_pos[1], [])])\n      visited = set()\n      while queue:\n          x, y, path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n\n              if can_move(nx, ny):\n                  queue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n          \n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 1.5}}
