ue.append((nx, ny, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          actions.extend(compute_directional_actions(current_state.dir, x, y))\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-03T14:43:47.460293", "function_name": "collect", "function_body": "  from collections import deque\n  from heapq import heappop, heappush\n\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], [], 0))  # (cost, x, y, path, direction)\n      visited = set()\n      while queue:\n          cost, x, y, path, current_direction = heappop(queue)\n          if (x, y, current_direction) in visited:\n              continue\n          visited.add((x, y, current_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny):\n                  new_cost = cost + heuristic((nx, ny), start_pos)\n                  # Determine target direction based on movement vector\n                  if dx == 0 and dy < 0:  # UP\n                      target_direction = 0\n                  elif dx == 0 and dy > 0:  # DOWN\n                      target_direction = 1\n                  elif dx < 0 and dy == 0:  # LEFT\n                      target_direction = 2\n                  elif dx > 0 and dy == 0:  # RIGHT\n                      target_direction = 3\n\n                  new_path = path + [(target_direction, (nx, ny))]\n                  heappush(queue, (new_cost, nx, ny, new_path, target_direction))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (target_direction, (x, y)) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          current_direction = current_state.dir\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-08-03T14:43:48.439762", "function_name": "collect", "function_body": "  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      return False\n          return True\n\n      def determine_tool(kind_index):\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          # Define the tools required for each kind of obstacle\n          tools = {\n              \"WATER\": current_state.world.water_index,  # Assuming water needs a bridge or boat tool\n              \"ROCK\": current_state.world.stone_index,   # Assuming rocks need a pickaxe tool\n              # Add more mappings as needed\n          }\n          return tools.get(kind_name)\n\n      queue = []\n      heappush(queue, (0, start_pos[0], start_pos[1], current_state.dir, []))\n      visited = set()\n      while queue:\n          cost, x, y, pos_direction, path = heappop(queue)\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_cost = cost + heuristic((nx, ny), start_pos)\n                  heappush(queue, (new_cost, nx, ny, pos_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          current_direction = current_state.dir\n\n          # Determine target direction based on movement vector\n          if dx == 0 and dy < 0:  # UP\n              target_direction = 0\n          elif dx == 0 and dy > 0:  # DOWN\n              target_direction = 1\n          elif dx < 0 and dy == 0:  # LEFT\n              target_direction = 2\n          elif dx > 0 and dy == 0:  # RIGHT\n              target_direction = 3\n\n          if current_direction != target_direction:\n              actions.append(target_direction)  # Add action to change direction\n\n          actions.append(ACTION_MAP[\"USE\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-03T14:45:36.263982", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n      \"TURN_LEFT\": 5,  # Assuming there's a TURN_LEFT action in the environment\n      \"TURN_RIGHT\": 6  # Assuming there's a TURN_RIGHT action in the environment\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(0, -1, 'UP'), (0, 1, 'DOWN'), (-1, 0, 'LEFT'), (1, 0, 'RIGHT')]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, direction_name):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_map = {\n              \"WATER\": current_state.world.water_index,\n              \"ROCK\": current_state.world.stone_index\n          }\n          return tool_map.get(kind_name)\n\n      def turn_directions(current_direction, target_direction):\n          turns = []\n          direction_order = ['UP', 'RIGHT', 'DOWN', 'LEFT']\n          \n          current_index = direction_order.index(current_direction)\n          target_index = direction_order.index(target_direction)\n          \n          if current_index < target_index:\n              while current_index != target_index:\n                  current_index = (current_index + 1) % len(direction_order)\n                  turns.append(ACTION_MAP[\"TURN_RIGHT\"])\n          elif current_index > target_index:\n              while current_index != target_index:\n                  current_index = (current_index - 1) % len(direction_order)\n                  turns.append(ACTION_MAP[\"TURN_LEFT\"])\n          \n          return turns\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])  # (x, y, pos_direction, path)\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y, pos_direction)]\n          \n          for dx, dy, direction_name in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, direction_name):\n                  turns = turn_directions(pos_direction, direction_name)\n                  queue.append((nx, ny, direction_name, path + [(nx, ny, direction_name)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y, direction_name) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          dx, dy = x - pos[0], y - pos[1]\n          \n          # Determine action based on difference and current direction\n          turns = turn_directions(current_state.dir, direction_name)\n          actions.extend(turns)\n\n          if dx == 0 and dy == -1:\n              actions.append(ACTION_MAP[\"UP\"])\n          elif dx == 0 and dy == 1:\n              actions.append(ACTION_MAP[\"DOWN\"])\n          elif dx == -1 and dy == 0:\n              actions.append(ACTION_MAP[\"LEFT\"])\n          elif dx == 1 and dy == 0:\n              actions.append(ACTION_MAP[\"RIGHT\"])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-03T14:45:37.239967", "function_name": "collect", "function_body": "  from collections import deque\n\n  # Define action mappings\n  ACTION_MAP = {\n      \"UP\": 0,\n      \"DOWN\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def find_shortest_path(grid, start_pos, target_kind, inventory):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n\n      def can_move(x, y, pos_direction):\n          if not (0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]):\n              return False\n          \n          # Check for obstacles based on inventory\n          is_clear = True\n          for i_kind in range(grid.shape[2]):\n              if grid[x, y, i_kind] == 1:\n                  tool_needed = determine_tool(i_kind)\n                  if tool_needed and inventory[tool_needed] <= 0:\n                      is_clear = False\n                      break\n          return is_clear\n\n      def determine_tool(kind_index):\n          # This function should map kinds to required tools based on the world's rules\n          kind_name = current_state.world.cookbook.index.get(kind_index)\n          tool_map = {\n              \"WATER\": current_state.world.water_index,\n              \"ROCK\": current_state.world.stone_index\n          }\n          return tool_map.get(kind_name)\n\n      def compute_direction(current_dir, new_pos):\n          dx, dy = new_pos[0] - pos[0], new_pos[1] - pos[1]\n          if dx == 0 and dy == -1:\n              return \"UP\"\n          elif dx == 0 and dy == 1:\n              return \"DOWN\"\n          elif dx == -1 and dy == 0:\n              return \"LEFT\"\n          elif dx == 1 and dy == 0:\n              return \"RIGHT\"\n\n      queue = deque([(start_pos[0], start_pos[1], current_state.dir, [])])\n      visited = set()\n      while queue:\n          x, y, pos_direction, path = queue.popleft()\n          if (x, y, pos_direction) in visited:\n              continue\n          visited.add((x, y, pos_direction))\n          \n          # Check if target is found\n          if grid[x, y, target_kind] == 1:\n              return path + [(x, y)]\n          \n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              if can_move(nx, ny, (dx, dy)):\n                  new_direction = compute_direction(pos_direction, (nx, ny))\n                  queue.append((nx, ny, new_direction, path + [(nx, ny)]))\n      return None\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Map primitive names to their respective indices in the index list\n  primitives_index = current_state.world.cookbook.index.index(primitive)\n\n  # Find the shortest path to a cell containing the target kind\n  path_to_primitive = find_shortest_path(grid, pos, primitives_index, inventory)\n  if path_to_primitive:\n      for (x, y) in path_to_primitive[:-1]:  # Exclude the last position since we'll use there\n          new_direction = compute_direction(current_state.dir, (x, y))\n          \n          # Determine direction to move based on difference\n          actions.append(ACTION_MAP[new_direction])\n\n      # Collect the primitive\n      actions.append(ACTION_MAP[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
