{"timestamp": "2025-07-28T09:22:07.830386", "function_name": "collect", "function_body": "  actions = []\n  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3\n  }\n\n  # Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  if primitive_index is None:\n    raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n  while True:\n      # Check if the agent is next to the desired primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # Action for USE (collecting the item)\n          break\n\n      # Otherwise, move randomly until you find it\n      random_action = action_map[np.random.choice(['UP', 'DOWN', 'LEFT', 'RIGHT'])]\n      actions.append(random_action)\n\n      # Perform the action to update the state and check if the agent is next to the primitive\n      reward, done, observations = env.step(random_action)\n      if done:\n          break\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T09:27:07.854659", "function_name": "collect", "function_body": "  actions = []\n  action_map = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3\n  }\n\n  # Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  if primitive_index is None:\n    raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n  while True:\n    # Check if the agent is next to the desired primitive\n    if env._current_state.next_to(primitive_index):\n      actions.append(4)  # Action for USE (collecting the item)\n      break\n\n    # Otherwise, move towards a cell containing the primitive\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    possible_moves = []\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      x, y = pos[0] + dx, pos[1] + dy\n      if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n        possible_moves.append(((x, y), grid[x, y, primitive_index]))\n    \n    # Sort moves by the presence of the primitive in descending order\n    possible_moves.sort(key=lambda move: move[1], reverse=True)\n    \n    if possible_moves:\n      # Choose the move with highest likelihood of finding the primitive nearby\n      best_move = possible_moves[0][0]\n      direction_to_best_move = None\n      \n      if best_move[0] < pos[0]:\n          direction_to_best_move = 'LEFT'\n      elif best_move[0] > pos[0]:\n          direction_to_best_move = 'RIGHT'\n      elif best_move[1] < pos[1]:\n          direction_to_best_move = 'DOWN'\n      elif best_move[1] > pos[1]:\n          direction_to_best_move = 'UP'\n      \n      if direction_to_best_move:\n          actions.append(action_map[direction_to_best_move])\n      else:\n          # Random move if no specific direction is found\n          random_action = action_map[np.random.choice(['UP', 'DOWN', 'LEFT', 'RIGHT'])]\n          actions.append(random_action)\n    else:\n        # Random move if no possible moves are available\n        random_action = action_map[np.random.choice(['UP', 'DOWN', 'LEFT', 'RIGHT'])]\n        actions.append(random_action)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
