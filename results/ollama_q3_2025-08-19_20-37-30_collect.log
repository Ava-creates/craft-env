           gem_pos = (x, y)\n                              path_to_gem = [0] * abs(pos[1] - y) + [3] * abs(pos[0] - x)  # Simplified path\n                              queue.append((gem_pos, dir, list(inventory), path + path_to_gem))\n              elif tool_name == \"AXE\":\n                  # Find wood positions and plan paths to chop them\n                  for x in range(grid.shape[0]):\n                      for y in range(grid.shape[1]):\n                          if grid[x, y, env.world.cookbook.index.index(\"WOOD\")] > 0:\n                              wood_pos = (x, y)\n                              path_to_wood = [0] * abs(pos[1] - y) + [3] * abs(pos[0] - x)  # Simplified path\n                              queue.append((wood_pos, dir, list(inventory), path + path_to_wood))", "island_id": 8, "scores": {"3": -1}}
