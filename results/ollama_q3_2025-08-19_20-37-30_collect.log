 tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n      tool_index = cookbook.index[tool]\n      if np.any(inventory[tool_index] > 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if nearest_tool_positions:\n              actions.extend(move_to_position(nearest_tool_positions[0]))\n              actions.append(4)  # USE to place or use the tool\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T06:00:59.058847", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n\n    # Calculate the direction to move\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Determine the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    # Turn to face the correct direction\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    # Move forward and backward as needed\n    actions.extend([0] * abs(dx))\n    actions.extend([1] * abs(dy))\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      return actions  # Assuming that picking up a primitive is successful on the first try\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n      tool_index = cookbook.index[tool]\n      if np.any(inventory[tool_index] > 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if nearest_tool_positions:\n              actions.extend(move_to_position(nearest_tool_positions[0]))\n              actions.append(4)  # USE to place or use the tool\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T06:01:37.588325", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          return actions_taken\n\n      # Mark this state as visited by its ID\n      visited.add(id(state))\n\n      for action_name, action_idx in action_mapping.items():\n          reward, next_state = state.step(action_idx)\n\n          # Check if the primitive is now in the inventory or adjacent to the agent's position\n          if (next_state.inventory[primitive_index] > 0 or\n              next_state.next_to(primitive_index)):\n              new_actions = actions_taken + [action_idx]\n              \n              # If the primitive is already collected, return the path immediately\n              if next_state.inventory[primitive_index] > 0:\n                  return new_actions\n              \n              # Otherwise, add it to the queue for further exploration\n              if id(next_state) not in visited:\n                  queue.append((next_state, new_actions))\n\n  return []", "island_id": 7, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T06:01:38.637867", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          return actions_taken\n\n      # Mark this state as visited by its ID\n      visited.add(id(state))\n\n      for action in range(world.n_actions):\n          reward, next_state = state.step(action)\n\n          # Check if the primitive is now in the inventory or adjacent to the agent's position\n          if next_state.inventory[primitive_index] > 0:\n              return actions_taken + [action]\n\n          # If the next state has not been visited, add it to the queue\n          if id(next_state) not in visited:\n              new_actions = actions_taken + [action]\n              queue.append((next_state, new_actions))\n\n  return []", "island_id": 7, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T06:02:42.475104", "function_name": "collect", "function_body": "  # Get the current state\n  current_state = env._current_state\n\n  # Define the goal item index from its name\n  goal_item_index = current_state.world.cookbook.index[primitive]\n\n  # Find all positions of the goal item in the grid\n  target_positions = np.argwhere(current_state.grid[:, :, goal_item_index] > 0)\n  \n  # Check if there are any positions to move towards\n  if len(target_positions) == 0:\n      return []\n\n  # Calculate Manhattan distance to each target position\n  distances = []\n  for pos in target_positions:\n      dist = abs(pos[0] - current_state.pos[0]) + abs(pos[1] - current_state.pos[1])\n      distances.append((dist, tuple(pos)))\n\n  # Sort positions by their distance from the agent's current position\n  distances.sort()\n\n  # Find the closest target position\n  closest_target_pos = distances[0][1]\n\n  # Calculate the actions needed to reach the closest target position\n  actions_to_reach_goal = []\n  while current_state.pos != closest_target_pos:\n      # Determine the direction of movement towards the goal\n      if current_state.pos[0] < closest_target_pos[0]:\n          actions_to_reach_goal.append(env.action_specs()[\"DOWN\"])\n          current_state.pos = (current_state.pos[0] + 1, current_state.pos[1])\n      elif current_state.pos[0] > closest_target_pos[0]:\n          actions_to_reach_goal.append(env.action_specs()[\"UP\"])\n          current_state.pos = (current_state.pos[0] - 1, current_state.pos[1])\n      if current_state.pos[1] < closest_target_pos[1]:\n          actions_to_reach_goal.append(env.action_specs()[\"RIGHT\"])\n          current_state.pos = (current_state.pos[0], current_state.pos[1] + 1)\n      elif current_state.pos[1] > closest_target_pos[1]:\n          actions_to_reach_goal.append(env.action_specs()[\"LEFT\"])\n          current_state.pos = (current_state.pos[0], current_state.pos[1] - 1)\n\n  # Add the action to collect the item\n  actions_to_reach_goal.append(env.action_specs()[\"USE\"])\n\n  return actions_to_reach_goal", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T06:02:43.459448", "function_name": "collect", "function_body": "  # Find the index for the desired primitive\n  prim_index = env.world.cookbook.index(primitive)\n\n  # Get the current position and direction of the agent\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Get the grid layout\n  grid = env._current_state.grid\n\n  # Define possible movements (UP, DOWN, LEFT, RIGHT)\n  MOVES = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  DIRECTIONS = [\"LEFT\", \"RIGHT\", \"UP\", \"DOWN\"]\n\n  # Find all positions of the primitive in the grid\n  prim_positions = np.argwhere(grid[:, :, prim_index] > 0)\n\n  if len(prim_positions) == 0:\n    raise ValueError(f\"No {primitive} found in the grid.\")\n\n  # Initialize a queue for BFS and a set to keep track of visited positions\n  queue = collections.deque([(pos, dir)])\n  visited = set()\n  visited.add(pos)\n\n  # Dictionary to store the path from start to each position\n  came_from = {}\n  came_from[pos] = None\n\n  # Perform BFS to find the shortest path to any primitive\n  while queue:\n    current_pos, current_dir = queue.popleft()\n\n    for move_index in range(len(MOVES)):\n      move = MOVES[move_index]\n      new_pos = (current_pos[0] + move[0], current_pos[1] + move[1])\n\n      # Check if the new position is within bounds and not visited\n      if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1] and new_pos not in visited:\n        visited.add(new_pos)\n        queue.append((new_pos, move_index))\n        came_from[new_pos] = (current_pos, current_dir)\n\n        # Check if the new position contains the primitive\n        if grid[new_pos[0], new_pos[1], prim_index] > 0:\n          break\n\n    else:\n      continue  # only executed if the inner loop did NOT break\n    break  # only executed if the inner loop DID break\n\n  if (new_pos, move_index) not in came_from:\n    raise ValueError(f\"No path found to collect {primitive}.\")\n\n  # Reconstruct the path from start to the goal\n  path = []\n  current_pos = new_pos\n  while current_pos != pos:\n    path.append(came_from[current_pos])\n    current_pos = came_from[current_pos][0]\n\n  path.reverse()\n\n  # Generate actions based on the path\n  actions = []\n\n  for (next_pos, next_dir) in path:\n    if next_dir != dir:\n      if DIRECTIONS[next_dir] == \"UP\":\n        actions.append(env.action_specs()[\"UP\"])\n      elif DIRECTIONS[next_dir] == \"DOWN\":\n        actions.append(env.action_specs()[\"DOWN\"])\n      elif DIRECTIONS[next_dir] == \"LEFT\":\n        actions.append(env.action_specs()[\"LEFT\"])\n      elif DIRECTIONS[next_dir] == \"RIGHT\":\n        actions.append(env.action_specs()[\"RIGHT\"])\n\n    dir = next_dir\n    actions.append(env.action_specs()[\"USE\"])\n\n  # Add the final USE action to collect the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T06:04:10.649556", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(dx, dy):\n    current_x, current_y = env._current_state.pos\n    new_x, new_y = current_x + dx, current_y + dy\n\n    # Determine the direction to move\n    if dx > 0:\n      direction = 'RIGHT'\n    elif dx < 0:\n      direction = 'LEFT'\n    elif dy > 0:\n      direction = 'DOWN'\n    else:\n      direction = 'UP'\n\n    action = env.action_specs()[direction]\n    actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T06:04:11.734227", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T06:05:54.870859", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n              queue.append(((nx, ny), path + [(dx, dy)]))\n              visited.add((nx, ny))  # Mark as visited after handling the obstacle\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          continue\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T06:05:55.931359", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # Handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # Check again for obstacles after moving (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          continue\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T06:06:47.779586", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          # Check which tools are available in the inventory\n          available_tools = [tool for tool, count in enumerate(state.inventory) if count > 0 and tool != primitive_index]\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n\n              if (next_state.inventory[primitive_index] > 0 or \n                  next_state.next_to(primitive_index) and \n                  all(tool not in available_tools for tool, _ in enumerate(next_state.inventory))):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 4, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T06:06:48.892226", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              reward, next_state = state.step(action)\n\n              # Check if the next state has the primitive or is next to it\n              if (next_state.inventory[primitive_index] > 0 or \n                  next_state.next_to(primitive_index)):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 4, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T06:08:34.940504", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      current_state = env._current_state\n      grid = current_state.grid\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to place or use the tool\n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
