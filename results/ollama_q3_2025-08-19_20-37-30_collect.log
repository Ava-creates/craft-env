id, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n\n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n\n  actions = []\n  \n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    \n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        \n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to pick up the tool\n    \n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:20:43.440837", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              actions.append(action_idx)\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n\n              # Check if the new state has the primitive or is adjacent to it\n              if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n          # Consider using tools from inventory\n          for tool_index in world.cookbook.primitives:\n              if current_state.inventory[tool_index] > 0 and tool_index != primitive_index:\n                  _, next_state_with_tool_use = state.step(action_mapping[\"USE\"])\n                  if next_state_with_tool_use.next_to(primitive_index):\n                      parent_map[next_state_with_tool_use] = (action_mapping[\"USE\"], state)\n                      queue.append(next_state_with_tool_use)\n\n  return []", "island_id": 7, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T05:20:44.404647", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              actions.append(action_idx)\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n\n              # Check if the new state has the primitive or is adjacent to it\n              if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n          # Consider using tools from inventory\n          for tool_index in world.cookbook.primitives:\n              if current_state.inventory[tool_index] > 0 and tool_index != primitive_index:\n                  _, next_state_with_tool_use = state.step(action_mapping[\"USE\"])\n                  if next_state_with_tool_use.next_to(primitive_index):\n                      parent_map[next_state_with_tool_use] = (action_mapping[\"USE\"], state)\n                      queue.append(next_state_with_tool_use)\n\n          # Check for specific tool usage scenarios\n          if current_state.inventory[world.cookbook.index[\"BRIDGE\"]] > 0 and current_state.next_to(world.cookbook.index[\"WATER\"]):\n              _, next_state_bridge = state.step(action_mapping[\"USE\"])\n              if next_state_bridge.next_to(primitive_index):\n                  parent_map[next_state_bridge] = (action_mapping[\"USE\"], state)\n                  queue.append(next_state_bridge)\n\n          # Add more tool-specific scenarios here if needed\n\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:21:36.193132", "function_name": "collect", "function_body": "  # Get the current state\n  current_state = env._current_state\n\n  # Define direction mappings\n  DIRECTIONS = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  # Convert the primitive name to its corresponding index\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Define a helper function to check if the agent is next to the desired item\n  def is_next_to_item(state, item_index):\n      return state.next_to(item_index)\n\n  # Plan actions to move towards and collect the primitive\n  actions = []\n  \n  # Check if the agent is already next to the primitive\n  if is_next_to_item(current_state, primitive_index):\n      actions.append(DIRECTIONS[\"DOWN\"])  # Placeholder action for demonstration\n      actions.append(env.action_specs()[\"USE\"])\n  else:\n      # Placeholder logic: Move in a fixed direction until the item is found\n      while not is_next_to_item(current_state, primitive_index):\n          actions.append(DIRECTIONS[\"DOWN\"])  # Move down as an example\n          current_state, _ = current_state.step(DIRECTIONS[\"DOWN\"])\n\n      # Once next to the item, collect it\n      actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:21:37.188308", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  world = current_state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index(primitive)\n\n  # Find positions of the primitive in the grid\n  primitive_positions = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n  \n  if len(primitive_positions) == 0:\n      return []  # No primitives found, no actions needed\n\n  # Calculate the Manhattan distance from agent's position to each primitive position\n  distances = [np.abs(pos - current_state.pos).sum() for pos in primitive_positions]\n  \n  # Find the closest primitive position\n  closest_position = primitive_positions[np.argmin(distances)]\n\n  # Compute path to the closest primitive using simple BFS (breadth-first search)\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      parent = {tuple(start): None}\n      \n      while queue:\n          current = queue.popleft()\n          if np.array_equal(current, goal):\n              break\n          \n          # Generate neighbors by moving in four directions (UP, DOWN, LEFT, RIGHT)\n          for direction in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              neighbor = tuple(np.add(current, direction))\n              \n              if not (0 <= neighbor[0] < world.scenario.init_grid.shape[0] and \n                      0 <= neighbor[1] < world.scenario.init_grid.shape[1]):\n                  continue  # Skip out-of-bound neighbors\n              \n              if world.scenario.init_grid[neighbor[0], neighbor[1]].sum() == 0:\n                  queue.append(neighbor)\n                  parent[tuple(neighbor)] = tuple(current)\n      \n      path = []\n      step = goal\n      while step is not None:\n          path.append(step)\n          step = parent[tuple(step)]\n      \n      return path[::-1]\n\n  path_to_primitive = bfs(current_state.pos, closest_position)\n\n  # Translate the path into actions (UP, DOWN, LEFT, RIGHT)\n  action_mapping = {\n      (0, 1): env.action_specs()[\"RIGHT\"],\n      (0, -1): env.action_specs()[\"LEFT\"],\n      (-1, 0): env.action_specs()[\"UP\"],\n      (1, 0): env.action_specs()[\"DOWN\"]\n  }\n\n  for i in range(len(path_to_primitive) - 1):\n      diff = tuple(np.subtract(path_to_primitive[i + 1], path_to_primitive[i]))\n      actions.append(action_mapping[diff])\n\n  # Append the USE action to collect the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:22:46.542685", "function_name": "collect", "function_body": "  def find_path(start_pos, end_pos):\n    \"\"\"Finds a path from start_pos to end_pos using BFS.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    while queue:\n      pos, path = queue.popleft()\n      if pos == end_pos:\n        return path\n      x, y = pos\n      neighbors = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n      for nx, ny in neighbors:\n        if (nx, ny) not in visited and env._current_state.grid[nx, ny, 0] == 0:  # Assuming empty cells have 0\n          queue.append(((nx, ny), path + [(nx, ny)]))\n          visited.add((nx, ny))\n    return []\n\n  primitive_index = env.world.cookbook.index[primitive]\n  grid_shape = env._current_state.grid.shape[:2]\n\n  # Find all positions of the primitive in the grid\n  primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n  if not len(primitive_positions):\n    return []\n\n  # Choose the closest position to the current agent's position\n  start_pos = env._current_state.pos\n  end_pos = min(primitive_positions, key=lambda pos: abs(pos[0] - start_pos[0]) + abs(pos[1] - start_pos[1]))\n\n  path_to_primitive = find_path(start_pos, end_pos)\n\n  actions = []\n  # Convert path to actions\n  for (next_x, next_y) in path_to_primitive:\n    current_x, current_y = env._current_state.pos\n    dx, dy = next_x - current_x, next_y - current_y\n\n    if dx == 1:\n      actions.append(env.action_specs()[\"DOWN\"])\n    elif dx == -1:\n      actions.append(env.action_specs()[\"UP\"])\n    elif dy == 1:\n      actions.append(env.action_specs()[\"RIGHT\"])\n    elif dy == -1:\n      actions.append(env.action_specs()[\"LEFT\"])\n\n  # Add action to collect the primitive\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:22:47.559235", "function_name": "collect", "function_body": "  def action_spec(action_name):\n    return env.action_specs()[action_name]\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Define a function to check if the agent is next to an entity of a given kind\n  def is_next_to(kind_index):\n    return env._current_state.next_to(kind_index)\n\n  # Pathfinding algorithm using A* to find the shortest path to the primitive\n  def astar_search(start_pos, goal_kind_index):\n    open_set = collections.PriorityQueue()\n    start_node = (0, start_pos)\n    came_from = {}\n    g_score = {start_pos: 0}\n    f_score = {start_pos: heuristic(start_pos, goal_kind_index)}\n\n    open_set.put(start_node)\n\n    while not open_set.empty():\n      _, current_pos = open_set.get()\n\n      if is_next_to(goal_kind_index):\n        return reconstruct_path(came_from, current_pos)\n      \n      for neighbor in get_neighbors(current_pos):\n        tentative_g_score = g_score[current_pos] + 1\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current_pos\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_kind_index)\n          open_set.put((f_score[neighbor], neighbor))\n    \n    return None  # No path found\n\n  def heuristic(pos, goal_kind_index):\n    \"\"\"Manhattan distance to the nearest cell containing the goal kind.\"\"\"\n    min_distance = float('inf')\n    for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[y, x, goal_kind_index] > 0:\n          distance = abs(pos[0] - x) + abs(pos[1] - y)\n          min_distance = min(min_distance, distance)\n    return min_distance\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.append(current)\n    return list(reversed(total_path))\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions.\"\"\"\n      x, y = pos\n      neighbors = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n      # Filter out invalid positions\n      return [(nx, ny) for nx, ny in neighbors if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]]\n\n  def actions_from_path(path):\n    \"\"\"Convert a list of positions into a sequence of actions.\"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n    for next_pos in path:\n        dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n        if dx == 1: actions.append(action_spec(\"RIGHT\"))\n        elif dx == -1: actions.append(action_spec(\"LEFT\"))\n        elif dy == 1: actions.append(action_spec(\"DOWN\"))\n        elif dy == -1: actions.append(action_spec(\"UP\"))\n        current_pos = next_pos\n    return actions\n\n  # Collect actions to move towards the primitive if not already next to it\n  actions = []\n  if not is_next_to(primitive_index):\n      path = astar_search(env._current_state.pos, primitive_index)\n      if path:\n          actions.extend(actions_from_path(path))\n  \n  # Add action to collect the primitive\n  actions.append(action_spec(\"USE\"))\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:24:15.567260", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  current_state = env._current_state\n  grid = current_state.grid\n\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T05:24:16.668837", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T05:25:16.191026", "function_name": "collect", "function_body": "  # Define the mapping from direction names to action indices\n  dir_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  # Function to find the position of a given primitive in the grid\n  def find_primitive_position(grid, kind_index):\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, kind_index] > 0:\n                  return (i, j)\n      return None\n\n  # Function to compute a path from start_pos to end_pos using BFS\n  def bfs_path(start_pos, end_pos, grid):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == end_pos:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_x, new_y = pos[0] + dx, pos[1] + dy\n              if 0 <= new_x < grid.shape[0] and 0 <= new_y < grid.shape[1] and grid[new_x, new_y, env.world.water_index] == 0 and (new_x, new_y) not in visited:\n                  queue.append((new_x, new_y))\n                  visited.add((new_x, new_y))\n                  parent[(new_x, new_y)] = pos\n      return None\n\n  # Get the kind index of the primitive we want to collect\n  kind_index = env.world.cookbook.index.get(env.world.cookbook.primitives_for(primitive))\n\n  if not kind_index:\n      print(f\"Primitive '{primitive}' not found in cookbook.\")\n      return []\n\n  # Find the position of the primitive in the grid\n  target_pos = find_primitive_position(env._current_state.grid, kind_index)\n\n  if not target_pos:\n      print(f\"No instance of '{primitive}' found on the grid.\")\n      return []\n\n  # Compute the path from the current position to the target position\n  start_pos = env._current_state.pos\n  path = bfs_path(start_pos, target_pos, env._current_state.grid)\n\n  if not path:\n      print(\"No valid path to the primitive found.\")\n      return []\n\n  # Convert path positions into a sequence of actions\n  actions = []\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == -1:\n          actions.append(dir_map[\"UP\"])\n      elif dx == 1:\n          actions.append(dir_map[\"DOWN\"])\n      elif dy == -1:\n          actions.append(dir_map[\"LEFT\"])\n      elif dy == 1:\n          actions.append(dir_map[\"RIGHT\"])\n\n  # Add the USE action to collect the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:25:17.187753", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  state = env._current_state\n\n  # Define the actions based on the action specs\n  actions = {\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"UP\": env.action_specs()[\"UP\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"],\n      \"USE\": env.action_specs()[\"USE\"]\n  }\n\n  # Get the index of the primitive to collect\n  primitive_index = state.world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and visited set\n  queue = collections.deque([state])\n  visited = set()\n\n  # Dictionary to store parent states for path reconstruction\n  parent_states = {state: None}\n\n  # Perform BFS to find the shortest path to the primitive\n  while queue:\n      current_state = queue.popleft()\n      \n      if current_state in visited:\n          continue\n      \n      visited.add(current_state)\n\n      # Check if the current state has the desired primitive nearby\n      if current_state.next_to(primitive_index):\n          return reconstruct_path(parent_states, current_state) + [actions[\"USE\"]]\n\n      # Generate possible next states (moves)\n      for action_name in [\"DOWN\", \"UP\", \"LEFT\", \"RIGHT\"]:\n          _, new_state = current_state.step(actions[action_name])\n          if new_state not in visited:\n              queue.append(new_state)\n              parent_states[new_state] = current_state\n\n  return []  # Return an empty list if the primitive is unreachable", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:26:56.448250", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn (assuming RIGHT is index 2)\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    actions.extend([0] * abs(dx))  # move forward in x direction\n    actions.extend([1] * abs(dy))  # move forward in y direction\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    \n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n\n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n  \n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to place or use the tool\n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:26:57.584702", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to place or use the tool\n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
