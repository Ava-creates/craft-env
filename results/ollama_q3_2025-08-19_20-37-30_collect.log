ds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 5, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T13:07:11.063778", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  current_state = env._current_state\n  grid = current_state.grid\n\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check for USE action to collect the primitive at nearby positions.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path including USE action.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              use_path = path + [4]  # Add USE action\n                              move_to_pos_path = []\n                              if x != pos[0] or y != pos[1]:\n                                  if x > pos[0]:  # RIGHT\n                                      move_to_pos_path.append(3)\n                                  elif x < pos[0]:  # LEFT\n                                      move_to_pos_path.append(2)\n                                  if y > pos[1]:  # DOWN\n                                      move_to_pos_path.append(1)\n                                  elif y < pos[1]:  # UP\n                                      move_to_pos_path.append(0)\n                              goal_paths[(x, y)] = move_to_pos_path + use_path\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  if goal_paths:\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  return []", "island_id": 5, "scores": {"3": 4.0}}
