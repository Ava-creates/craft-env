{"timestamp": "2025-08-19T21:35:33.919095", "function_name": "collect", "function_body": "  # Get the current state from the environment.\n  current_state = env._current_state\n\n  # Fetch the index for the target primitive using the world's cookbook.\n  primitive_index = current_state.world.cookbook.index(primitive)\n\n  # Define the actions corresponding to movement directions in the DSL.\n  move_actions = {\n      'UP': 1,\n      'DOWN': 0,\n      'LEFT': 2,\n      'RIGHT': 3\n  }\n\n  # Initialize a queue for BFS and a set to keep track of visited states.\n  queue = collections.deque([(current_state, [])])\n  visited_states = set()\n\n  while queue:\n      state, actions_taken = queue.popleft()\n      \n      # Convert the current grid state to a hashable format.\n      grid_tuple = tuple(map(tuple, map(tuple, state.grid)))\n      if (grid_tuple, state.pos, state.dir) in visited_states:\n          continue\n      visited_states.add((grid_tuple, state.pos, state.dir))\n      \n      # Check if the desired primitive is next to the agent.\n      if state.next_to(primitive_index):\n          actions_taken.append(move_actions['USE'])\n          return actions_taken\n      \n      # Generate all possible movements from the current state.\n      for direction, action in move_actions.items():\n          new_state = state.copy()\n          reward, new_state = new_state.step(action)\n          queue.append((new_state, actions_taken + [action]))\n  \n  # If no path is found, return an empty list of actions.\n  return []", "island_id": 8, "scores": {"3": -1}}
