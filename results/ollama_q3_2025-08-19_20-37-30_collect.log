{"timestamp": "2025-08-20T11:12:01.808628", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n\n  current_state = env._current_state\n  grid = current_state.grid\n\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          if action == 0:\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:\n              new_pos = (pos[0] + 1, pos[1])\n\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n      # Handle tool usage to cross obstacles or mine resources.\n      for tool_index, count in enumerate(inventory):\n          if count > 0:\n              tool_name = env.world.cookbook.index.get(tool_index)\n              # Check if the agent can use the tool to interact with the environment (e.g., BRIDGE on WATER).\n              for dx in range(-1, 2):\n                  for dy in range(-1, 2):\n                      x, y = pos[0] + dx, pos[1] + dy\n                      if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                          # Determine the environment interaction based on the tool.\n                          if tool_name == \"BRIDGE\" and env.world.cookbook.index.index(\"WATER\") in grid[x, y]:\n                              new_pos = (x, y)\n                              new_path = path + [4]  # Assuming USE action to place a bridge\n                              queue.append((new_pos, dir, inventory[:], new_path))\n                          elif tool_name == \"PICKAXE\" and env.world.cookbook.index.index(\"GEM\") in grid[x, y]:\n                              new_pos = (x, y)\n                              new_inventory = inventory[:]\n                              new_inventory[tool_index] -= 1\n                              new_inventory[i_primitive] += 1\n                              new_path = path + [4]  # Assuming USE action to mine the gem\n                              queue.append((new_pos, dir, new_inventory, new_path))\n                          elif tool_name == \"AXE\" and env.world.cookbook.index.index(\"WOOD\") in grid[x, y]:\n                              new_pos = (x, y)\n                              new_inventory = inventory[:]\n                              new_inventory[tool_index] -= 1\n                              new_inventory[i_primitive] += 1\n                              new_path = path + [4]  # Assuming USE action to cut wood\n                              queue.append((new_pos, dir, new_inventory, new_path))\n                          elif tool_name == \"SHOVEL\" and env.world.cookbook.index.index(\"ROCK\") in grid[x, y]:\n                              new_pos = (x, y)\n                              new_inventory = inventory[:]\n                              new_inventory[tool_index] -= 1\n                              new_inventory[i_primitive] += 1\n                              new_path = path + [4]  # Assuming USE action to dig rock\n                              queue.append((new_pos, dir, new_inventory, new_path))\n\n  if goal_paths:\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  return []", "island_id": 0, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T11:13:36.073314", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(dx, dy):\n    current_x, current_y = env._current_state.pos\n    action = None\n\n    if dy > 0:\n      action = env.action_specs()['DOWN']\n    elif dy < 0:\n      action = env.action_specs()['UP']\n\n    if dx > 0:\n      action = env.action_specs()['RIGHT'] if action is None else action\n    elif dx < 0:\n      action = env.action_specs()['LEFT'] if action is None else action\n\n    if action:\n      actions.append(action)\n\n  def handle_obstacles(nx, ny):\n    grid = env._current_state.grid\n    inventory = env._current_state.inventory\n\n    # Check for water obstacles and use bridge if available\n    if grid[nx, ny, env.world.water_index] > 0:\n      if any(inventory[b] > 0 for b in bridge_indices):\n        actions.append(env.action_specs()['USE'])\n        return True\n\n    # Check for stone obstacles and use pickaxe if available\n    elif grid[nx, ny, env.world.stone_index] > 0:\n      if any(inventory[p] > 0 for p in pickaxe_indices):\n        actions.append(env.action_specs()['USE'])\n        return True\n\n    return False\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n              queue.append(((nx, ny), path + [(dx, dy)]))\n              visited.add((nx, ny))  # Mark as visited after handling obstacle\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n      handle_obstacles(nx, ny)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T11:13:37.111111", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      action = env.action_specs()['DOWN']\n    elif delta_y < 0:\n      action = env.action_specs()['UP']\n    else:\n      action = None\n\n    if delta_x > 0:\n      action = env.action_specs()['RIGHT'] if action is None else action\n    elif delta_x < 0:\n      action = env.action_specs()['LEFT'] if action is None else action\n\n    if action:\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n              queue.append(((nx, ny), path + [(dx, dy)]))\n              visited.add((nx, ny))  # Mark as visited after handling obstacles\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          continue\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T11:15:04.903662", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T11:15:06.009919", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T11:15:43.252720", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])  # Store state and path\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, return the path taken\n          return actions_taken\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action_name, action_idx in action_mapping.items():\n              _, next_state = state.step(action_idx)\n\n              if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n                  queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 6, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T11:16:06.438217", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])  # Store state and path\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0 or state.next_to(primitive_index):\n          # If we have collected the primitive or are next to it, return the path taken\n          return actions_taken\n\n      state_id = tuple(state.pos) + (state.dir,) + tuple(state.grid.flatten()) + tuple(state.inventory)\n      if state_id not in visited:\n          visited.add(state_id)\n\n          for action_name, action_idx in action_mapping.items():\n              _, next_state = state.step(action_idx)\n\n              queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-08-20T11:16:34.764931", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  while queue:\n      state, path = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          return path\n\n      # Mark the current state as visited by its ID\n      visited.add(id(state))\n\n      for action in range(world.n_actions):\n          reward, next_state = state.step(action)\n\n          # Check if the next state has the primitive or is adjacent to it\n          if (next_state.inventory[primitive_index] > 0 or \n              next_state.next_to(primitive_index)):\n              queue.append((next_state, path + [action]))\n          else:\n              # Only add unvisited states to the queue\n              if id(next_state) not in visited:\n                  queue.append((next_state, path + [action]))\n\n  return []", "island_id": 7, "scores": {"3": 3.4}}
{"timestamp": "2025-08-20T11:16:35.801794", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  while queue:\n      state, path = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          return path\n\n      # Mark the current state as visited by its ID\n      visited.add(id(state))\n\n      for action in range(world.n_actions):\n          reward, next_state = state.step(action)\n\n          # Check if the next state has the primitive or is adjacent to it\n          if (next_state.inventory[primitive_index] > 0 or \n              next_state.next_to(primitive_index)):\n              queue.append((next_state, path + [action]))\n          else:\n              # Only add unvisited states to the queue\n              if id(next_state) not in visited:\n                  queue.append((next_state, path + [action]))\n\n  return []", "island_id": 7, "scores": {"3": 3.4}}
{"timestamp": "2025-08-20T11:17:22.959616", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              reward, next_state = state.step(action)\n\n              # Check if the primitive is available or nearby\n              if (next_state.inventory[primitive_index] > 0 \n                  or next_state.next_to(primitive_index)\n                  or (reward == 1 and world.index.get(next_state.grid[state.pos]) == primitive)):\n                  \n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 5, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T11:17:24.014476", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              reward, next_state = state.step(action)\n\n              # Check if the primitive is available or nearby\n              if (next_state.inventory[primitive_index] > 0 \n                  or next_state.next_to(primitive_index)\n                  or (reward == 1 and world.index.get(next_state.grid[state.pos]) == primitive)):\n                  \n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 5, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T11:19:37.582619", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n      # Handle tool usage to cross obstacles or mine resources.\n      for tool_index, count in enumerate(inventory):\n          if count > 0:\n              tool_name = env.world.cookbook.index.get(tool_index)\n              # Check if the agent can use the tool to interact with the environment (e.g., BRIDGE on WATER).\n              for dx in range(-1, 2):\n                  for dy in range(-1, 2):\n                      x, y = pos[0] + dx, pos[1] + dy\n                      if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                          # Determine the environment interaction based on the tool.\n                          if tool_name == \"BRIDGE\" and env.world.cookbook.index.index(\"WATER\") in grid[x, y]:\n                              new_pos = (x, y)\n                              new_path = path + [4]  # Assuming USE action to place a bridge\n                              queue.append((new_pos, dir, inventory[:], new_path))\n                          elif tool_name == \"PICKAXE\" and env.world.cookbook.index.index(\"GEM\") in grid[x, y]:\n                              new_pos = (x, y)\n                              new_inventory = inventory[:]\n                              new_inventory[tool_index] -= 1\n                              new_inventory[i_primitive] += 1\n                              new_path = path + [4]  # Assuming USE action to mine the gem\n                              queue.append((new_pos, dir, new_inventory, new_path))\n\n  if goal_paths:\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  return []", "island_id": 0, "scores": {"3": 4.0}}
