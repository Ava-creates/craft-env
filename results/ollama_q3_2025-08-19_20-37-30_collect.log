            if dir == 4:\n                    dir -= 4\n            actions.extend([1] * abs(dx))  # move backward\n    else:\n        if dy > 0:\n            while dir != 0:  # face down (0)\n                actions.append(2)  # RIGHT turn\n                dir += 1\n                if dir == 4:\n                    dir -= 4\n            actions.extend([0] * abs(dy))  # move forward\n        elif dy < 0:\n            while dir != 2:  # face up (2)\n                actions.append(2)  # RIGHT turn\n                dir += 1\n                if dir == 4:\n                    dir -= 4\n            actions.extend([1] * abs(dy))  # move backward\n    \n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_pos = get_nearest_primitive_position(primitive_index)\n    if nearest_pos is None:\n      return []\n    actions = move_to_position(nearest_pos)\n    actions.append(4)  # USE to pick up the primitive\n    return actions\n\n  def place_tool(tool_index, required_primitive_index):\n    current_state = env._current_state\n    inventory = current_state.inventory\n    grid = current_state.grid\n    \n    if np.any(inventory[tool_index] == 0):\n      nearest_tool_pos = get_nearest_primitive_position(tool_index)\n      if nearest_tool_pos is None:\n        return []\n      \n      actions = move_to_position(nearest_tool_pos)\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    allowed_positions = np.argwhere(grid[..., required_primitive_index] > 0).tolist()\n    if len(allowed_positions) == 0:\n      return actions\n    \n    allowed_positions = set(map(tuple, allowed_positions))\n    \n    def is_path_using_tool(tool_index, required_primitive_index):\n        current_pos = np.array(current_state.pos)\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        visited = set()\n        \n        def bfs(pos):\n            queue = collections.deque([pos])\n            while queue:\n                pos = queue.popleft()\n                if grid[pos[0], pos[1], tool_index] > 0 and grid[pos[0], pos[1], required_primitive_index] > 0:\n                    return True\n                for dx, dy in directions:\n                    new_pos = tuple(pos + np.array((dx, dy)))\n                    if (0 <= new_pos[0] < grid.shape[0]) and (0 <= new_pos[1] < grid.shape[1]):\n                        if (new_pos not in visited) and grid[new_pos[0], new_pos[1]] > 0:\n                            visited.add(new_pos)\n                            queue.append(new_pos)\n            return False\n        \n        for pos in allowed_positions:\n            if bfs(pos):\n                return True\n        return False\n\n    if is_path_using_tool(tool_index, required_primitive_index):\n      nearest_pos = get_nearest_primitive_position(required_primitive_index, allowed_positions=allowed_positions)\n      if nearest_pos is None:\n        return actions\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n    else:\n      # If no path found using tool, collect tool and retry\n      nearest_tool_pos = get_nearest_primitive_position(tool_index)\n      if nearest_tool_pos is None:\n        return actions\n      \n      actions.extend(move_to_position(nearest_tool_pos))\n      actions.append(4)  # USE to pick up the tool\n      \n      nearest_pos = get_nearest_primitive_position(required_primitive_index)\n      if nearest_pos is None:\n        return actions\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  def find_path(start, end, grid):\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    visited = set()\n    queue = collections.deque([(start, [])])\n    \n    while queue:\n        pos, path = queue.popleft()\n        \n        if tuple(pos) == end:\n            return path\n        \n        for dx, dy in directions:\n            new_pos = tuple(np.array(pos) + np.array((dx, dy)))\n            if (0 <= new_pos[0] < grid.shape[0]) and (0 <= new_pos[1] < grid.shape[1]):\n                if grid[new_pos[0], new_pos[1]] > 0 and (new_pos not in visited):\n                    visited.add(new_pos)\n                    queue.append((new_pos, path + [move_to_position(new_pos)]))\n    \n    return []\n\n  def get_allowed_positions(tool_index, required_primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    allowed_positions = set()\n    tool_positions = np.argwhere(grid[..., tool_index] > 0).tolist()\n    \n    for tool_pos in tool_positions:\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        \n        for dx, dy in directions:\n            new_pos = tuple(np.array(tool_pos) + np.array((dx, dy)))\n            \n            if (0 <= new_pos[0] < grid.shape[0]) and (0 <= new_pos[1] < grid.shape[1]):\n                if grid[new_pos[0], new_pos[1], required_primitive_index] > 0:\n                    allowed_positions.add(tuple(tool_pos))\n    \n    return allowed_positions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  grid = current_state.grid\n  \n  primitive_index = env.world.cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n    return collect_primitive(primitive_index)\n  \n  required_tools = []\n  if primitive == \"GEM\":\n      if not np.any(inventory[env.world.cookbook.index[\"PICKAXE\"]] > 0):\n          required_tools.append(\"PICKAXE\")\n  elif primitive == \"WATER\":\n      if not np.any(inventory[env.world.cookbook.index[\"BRIDGE\"]] > 0):\n          required_tools.append(\"BRIDGE\")\n\n  actions = []\n  for tool in required_tools:\n    tool_index = env.world.cookbook.index[tool]\n    primitive_tool_map = {\n        \"PICKAXE\": \"GEM\",\n        \"BRIDGE\": \"WATER\"\n    }\n    \n    required_primitive_index = env.world.cookbook.index[primitive_tool_map[tool]]\n    allowed_positions = get_allowed_positions(tool_index, required_primitive_index)\n    \n    if np.any(inventory[tool_index] > 0):\n      nearest_primitive_pos = get_nearest_primitive_position(required_primitive_index, allowed_positions=allowed_positions)\n      if nearest_primitive_pos is not None:\n        path = find_path(current_state.pos, nearest_primitive_pos, grid)\n        if path:\n          for move in path:\n            actions.extend(move)\n          actions.append(4)  # USE to pick up the primitive\n    else:\n      nearest_tool_pos = get_nearest_primitive_position(tool_index)\n      if nearest_tool_pos is not None:\n        path = find_path(current_state.pos, nearest_tool_pos, grid)\n        if path:\n          for move in path:\n            actions.extend(move)\n          actions.append(4)  # USE to pick up the tool\n\n      nearest_primitive_pos = get_nearest_primitive_position(required_primitive_index, allowed_positions=allowed_positions)\n      if nearest_primitive_pos is not None:\n        path = find_path(current_state.pos, nearest_primitive_pos, grid)\n        if path:\n          for move in path:\n            actions.extend(move)\n          actions.append(4)  # USE to pick up the primitive\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T23:26:12.842905", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive]\n\n  # Step 1: Initialize a list to store actions.\n  actions = []\n\n  # Step 2: Define directions (UP, DOWN, LEFT, RIGHT) as action indices.\n  directions = [0, 1, 2, 3]\n  \n  # Step 3: Get the current position and direction of the agent.\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Step 4: Retrieve the grid from the environment.\n  grid = env._current_state.grid\n  \n  # Step 5: Implement a breadth-first search (BFS) to find the shortest path to the nearest cell containing the target primitive.\n  def bfs_with_tools(start_pos, grid):\n    from collections import deque\n    queue = deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n    tool_usage = {}  # Dictionary to store tool usage at each position\n\n    while queue:\n      current_pos = queue.popleft()\n      if grid[current_pos[0], current_pos[1], i_primitive] > 0:\n        return reconstruct_path(parent, start_pos, current_pos)\n      for d in directions:\n        new_pos = (current_pos[0] + (d == 3) - (d == 2),\n                   current_pos[1] + (d == 0) - (d == 1))\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1] and new_pos not in visited:\n          # Check for obstacles\n          obstacle = False\n          tool_needed = None\n          if grid[new_pos[0], new_pos[1], env.world.water_index] > 0:\n            obstacle = True\n            tool_needed = \"BRIDGE\"\n          elif grid[new_pos[0], new_pos[1], env.world.stone_index] > 0:\n            obstacle = True\n            tool_needed = \"PICKAXE\"\n\n          if not obstacle or (tool_needed and tool_needed in env._current_state.inventory):\n            visited.add(new_pos)\n            parent[new_pos] = current_pos\n            queue.append(new_pos)\n            \n            # Record the tool usage at this position\n            if tool_needed:\n              tool_usage[new_pos] = tool_needed\n\n    return None\n\n  def reconstruct_path(parent, start, end):\n    path = [end]\n    while path[-1] != start:\n      path.append(parent[path[-1]])\n    return path[::-1]\n\n  # Step 6: Perform BFS to find the shortest path to the target primitive.\n  path_to_primitive = bfs_with_tools(pos, grid)\n  \n  # Step 7: If no path is found, return an empty list of actions.\n  if not path_to_primitive:\n    return []\n\n  # Step 8: Translate the path into a sequence of movement actions (UP, DOWN, LEFT, RIGHT).\n  for i in range(1, len(path_to_primitive)):\n    current_pos = path_to_primitive[i - 1]\n    next_pos = path_to_primitive[i]\n\n    if next_pos[0] > current_pos[0]:\n      actions.append(1)  # DOWN\n    elif next_pos[0] < current_pos[0]:\n      actions.append(0)  # UP\n    elif next_pos[1] > current_pos[1]:\n      actions.append(3)  # RIGHT\n    elif next_pos[1] < current_pos[1]:\n      actions.append(2)  # LEFT\n\n  # Step 9: Add the action to collect the primitive (USE).\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T23:26:13.937371", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive]\n\n  # Step 1: Initialize a list to store actions.\n  actions = []\n\n  # Step 2: Define directions (UP, DOWN, LEFT, RIGHT) as action indices.\n  directions = [0, 1, 2, 3]\n  \n  # Step 3: Get the current position and direction of the agent.\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Step 4: Retrieve the grid from the environment.\n  grid = env._current_state.grid\n  \n  # Step 5: Define a function to perform BFS with tool usage.\n  def bfs_with_tools(start_pos, grid):\n    from collections import deque\n    queue = deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if grid[current_pos[0], current_pos[1], i_primitive] > 0:\n        return reconstruct_path(parent, start_pos, current_pos)\n      for d in directions:\n        new_pos = (current_pos[0] + (d == 3) - (d == 2),\n                   current_pos[1] + (d == 0) - (d == 1))\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1] and new_pos not in visited:\n          # Check for obstacles\n          obstacle = False\n          tool_needed = None\n          if grid[new_pos[0], new_pos[1], env.world.water_index] > 0:\n            obstacle = True\n            tool_needed = \"BRIDGE\"\n          elif grid[new_pos[0], new_pos[1], env.world.stone_index] > 0:\n            obstacle = True\n            tool_needed = \"PICKAXE\"\n\n          if not obstacle or (tool_needed and tool_needed in env._current_state.inventory):\n            visited.add(new_pos)\n            parent[new_pos] = current_pos\n            queue.append(new_pos)\n    return None\n\n  def reconstruct_path(parent, start, end):\n    path = [end]\n    while path[-1] != start:\n      path.append(parent[path[-1]])\n    return path[::-1]\n\n  # Step 6: Perform BFS to find the shortest path to the target primitive.\n  path_to_primitive = bfs_with_tools(pos, grid)\n  \n  # Step 7: If no path is found, return an empty list of actions.\n  if not path_to_primitive:\n    return []\n\n  # Step 8: Translate the path into a sequence of movement actions (UP, DOWN, LEFT, RIGHT).\n  for i in range(1, len(path_to_primitive)):\n    current_pos = path_to_primitive[i - 1]\n    next_pos = path_to_primitive[i]\n    \n    if next_pos[0] > current_pos[0]:\n      actions.append(1)  # DOWN\n    elif next_pos[0] < current_pos[0]:\n      actions.append(0)  # UP\n    elif next_pos[1] > current_pos[1]:\n      actions.append(3)  # RIGHT\n    elif next_pos[1] < current_pos[1]:\n      actions.append(2)  # LEFT\n\n  # Step 9: Add the action to collect the primitive (USE).\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T23:27:35.814037", "function_name": "collect", "function_body": "  def get_action_from_direction(dx, dy):\n    if dx == 1:\n      return env.action_specs()['RIGHT']\n    elif dx == -1:\n      return env.action_specs()['LEFT']\n    elif dy == 1:\n      return env.action_specs()['DOWN']\n    elif dy == -1:\n      return env.action_specs()['UP']\n\n  def bfs_shortest_path(start, goal_index, grid, inventory):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if we've reached the goal\n      if grid[x, y, goal_index] > 0:\n        return path\n\n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          # Check for obstacles and inventory tools\n          cell_index = grid[x, y].argmax()\n          can_move = True\n\n          if env.world.cookbook.index.get(cell_index) == 'WATER':\n            if env._current_state.inventory[env.world.water_index] == 0:\n              can_move = False\n          elif env.world.cookbook.index.get(cell_index) == 'ROCK':\n            if env._current_state.inventory['PICKAXE'] == 0:\n              can_move = False\n\n          # Add condition for workshop tools if needed\n          elif cell_index in env.world.workshop_indices and cell_index not in inventory:\n            can_move = False\n\n          if (nx, ny) not in visited and can_move:\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n\n    return None  # No path found\n\n  def convert_path_to_actions(path, current_pos):\n    actions = []\n    for dx, dy in path:\n      action = get_action_from_direction(dx, dy)\n      actions.append(action)\n\n      # Check if the agent needs to collect something at the current position\n      nx, ny = current_pos[0] + dx, current_pos[1] + dy\n      cell_index = env._current_state.grid[nx, ny].argmax()\n      if env.world.cookbook.index.get(cell_index) == primitive:\n        actions.append(env.action_specs()['USE'])\n\n      current_pos = (nx, ny)\n    return actions\n\n  # Get the goal index from the primitive name\n  goal_index = env.world.cookbook.index.index(primitive)\n\n  # Perform BFS to find the shortest path\n  path = bfs_shortest_path(\n    env._current_state.pos,\n    goal_index,\n    env._current_state.grid,\n    env._current_state.inventory\n  )\n\n  if path:\n    return convert_path_to_actions(path, env._current_state.pos)\n  else:\n    return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T23:27:36.858059", "function_name": "collect", "function_body": "  def get_action_from_direction(dx, dy):\n    if dx == 1:\n      return env.action_specs()['RIGHT']\n    elif dx == -1:\n      return env.action_specs()['LEFT']\n    elif dy == 1:\n      return env.action_specs()['DOWN']\n    elif dy == -1:\n      return env.action_specs()['UP']\n\n  def bfs_shortest_path(start, goal_index, grid, inventory):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if we've reached the goal\n      if grid[x, y, goal_index] > 0:\n        return path\n\n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          # Check for obstacles and inventory tools\n          cell_index = grid[nx, ny].argmax()\n          can_move = True\n\n          if env.world.cookbook.index.get(cell_index) == 'WATER':\n            if env._current_state.inventory[env.world.water_index] == 0:\n              can_move = False\n          elif env.world.cookbook.index.get(cell_index) == 'ROCK':\n            if 'PICKAXE' not in env._current_state.inventory:\n              can_move = False\n\n          # Add condition for workshop tools if needed\n          elif cell_index in env.world.workshop_indices and cell_index not in inventory:\n            can_move = False\n\n          if (nx, ny) not in visited and can_move:\n            queue.append(((nx, ny), path + [(dx, dy)]))\n            visited.add((nx, ny))\n\n    return None  # No path found\n\n  def convert_path_to_actions(path, current_pos):\n    actions = []\n    for dx, dy in path:\n      action = get_action_from_direction(dx, dy)\n      actions.append(action)\n\n      # Check if the agent needs to collect something at the current position\n      nx, ny = current_pos[0] + dx, current_pos[1] + dy\n      cell_index = env._current_state.grid[nx, ny].argmax()\n      if env.world.cookbook.index.get(cell_index) == primitive:\n        actions.append(env.action_specs()['USE'])\n\n      current_pos = (nx, ny)\n    return actions\n\n  # Get the goal index from the primitive name\n  goal_index = env.world.cookbook.index.index(primitive)\n\n  # Perform BFS to find the shortest path\n  path = bfs_shortest_path(\n    env._current_state.pos,\n    goal_index,\n    env._current_state.grid,\n    env._current_state.inventory\n  )\n\n  if path:\n    return convert_path_to_actions(path, env._current_state.pos)\n  else:\n    return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T23:33:10.106887", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  while queue:\n      state, path = queue.popleft()\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          if state.inventory[primitive_index] > 0 or state.next_to(primitive_index):\n              return path\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n              queue.append((next_state, path + [action]))\n\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-19T23:33:11.218433", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0 or (state.grid[state.pos] == primitive_index).any():\n          return actions_taken\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action_name, action_idx in action_mapping.items():\n              _, next_state = state.step(action_idx)\n\n              # Check if the new state is valid and not yet visited\n              if (next_state.grid[next_state.pos] == primitive_index).any() or next_state.inventory[primitive_index] > 0:\n                  queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T23:34:15.017452", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n\n              # Check if the new state has the primitive or is adjacent to it\n              if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n          # Consider using tools from inventory\n          for tool_index in world.cookbook.primitives:\n              if current_state.inventory[tool_index] > 0:\n                  _, next_state_with_tool_use = state.step(action_mapping[\"USE\"])\n                  if next_state_with_tool_use.next_to(primitive_index):\n                      parent_map[next_state_with_tool_use] = (action_mapping[\"USE\"], state)\n                      queue.append(next_state_with_tool_use)\n\n  return []", "island_id": 7, "scores": {"3": 3.0}}
{"timestamp": "2025-08-19T23:34:16.111979", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # Function to determine if a state is valid and useful for the BFS\n  def is_valid_state(state):\n      return id(state) not in visited\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if is_valid_state(state):\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              reward, next_state = state.step(action)\n\n              # Check if the action leads to a state where the primitive can be collected or is adjacent\n              if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 7, "scores": {"3": 3.0}}
{"timestamp": "2025-08-19T23:36:59.359752", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(primitive_indices):\n    current_state = env._current_state\n    grid = current_state.grid\n    pos_dict = {}\n    \n    for idx in primitive_indices:\n      positions = np.argwhere(grid[..., idx])\n      if len(positions) == 0:\n        continue\n      distances = np.linalg.norm(np.array(positions) - np.array(current_state.pos), axis=1)\n      nearest_pos = tuple(positions[np.argmin(distances)])\n      pos_dict[idx] = nearest_pos\n    \n    return pos_dict\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n    \n    # Determine the direction to move\n    if dx > 0:\n      while dir != 3:  # face right (3)\n        actions.append(2)  # RIGHT turn\n        dir += 1\n        if dir == 4:\n          dir -= 4\n      actions.extend([0] * abs(dx))  # move forward\n    elif dx < 0:\n      while dir != 1:  # face left (1)\n        actions.append(2)  # RIGHT turn\n        dir += 1\n        if dir == 4:\n          dir -= 4\n      actions.extend([1] * abs(dx))  # move backward\n    \n    if dy > 0:\n      while dir != 0:  # face down (0)\n        actions.append(2)  # RIGHT turn\n        dir += 1\n        if dir == 4:\n          dir -= 4\n      actions.extend([0] * abs(dy))  # move forward\n    elif dy < 0:\n      while dir != 2:  # face up (2)\n        actions.append(2)  # RIGHT turn\n        dir += 1\n        if dir == 4:\n          dir -= 4\n      actions.extend([1] * abs(dy))  # move backward\n    \n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_pos = get_nearest_positions([primitive_index])[primitive_index]\n    if nearest_pos is None:\n      return []\n    actions = move_to_position(nearest_pos)\n    actions.append(4)  # USE to pick up the primitive\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n    return collect_primitive(primitive_index)\n  \n  required_tools = []\n  adjacent_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n      # Add more tools and their adjacent primitives here\n  }\n\n  def use_tool(tool_name, primitive_name):\n    tool_index = cookbook.index[tool_name]\n    if np.any(inventory[tool_index] > 0):\n      nearest_tool_pos = get_nearest_positions([tool_index])[tool_index]\n      if nearest_tool_pos is not None:\n        actions = move_to_position(nearest_tool_pos)\n        actions.append(4)  # USE to place or use the tool\n        return actions, True\n    return [], False\n\n  def plan_path_to_primitive(primitive_index):\n    current_state = env._current_state\n    pos = current_state.pos\n    grid = current_state.grid\n    \n    # Breadth-first search for pathfinding\n    from collections import deque\n    \n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # right, down, left, up\n    queue = deque([(pos, [])])\n    visited = set([pos])\n    \n    while queue:\n      current_pos, path = queue.popleft()\n      \n      if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n        return path\n      \n      for dx, dy in directions:\n        next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= next_pos[0] < grid.shape[0] and 0 <= next_pos[1] < grid.shape[1]:\n          if next_pos not in visited:\n            new_path = path.copy()\n            new_path.append((dx, dy))\n            queue.append((next_pos, new_path))\n            visited.add(next_pos)\n    \n    return None\n\n  def convert_directions_to_actions(directions):\n    actions = []\n    current_dir = env._current_state.dir\n    \n    direction_map = {\n        (0, 1): 3,  # right\n        (1, 0): 0,  # down\n        (0, -1): 1,  # up\n        (-1, 0): 2   # left\n    }\n    \n    for dx, dy in directions:\n        target_dir = direction_map[(dx, dy)]\n        \n        while current_dir != target_dir:\n            actions.append(2)  # RIGHT turn\n            current_dir += 1\n            if current_dir == 4:\n                current_dir -= 4\n        \n        actions.append(0)  # move forward\n    \n    return actions\n\n  def get_adjacent_primitives(tool_name):\n    adjacent = {\n      \"PICKAXE\": [\"GEM\"],\n      \"BRIDGE\": [\"WATER\"]\n      # Add more tools and their adjacent primitives here\n    }\n    return adjacent.get(tool_name, [])\n\n  actions = []\n  for tool in adjacent_tools.get(primitive, []):\n    if np.any(inventory[cookbook.index[tool]] > 0):\n      nearest_tool_pos = get_nearest_positions([cookbook.index[tool]])[cookbook.index[tool]]\n      if nearest_tool_pos:\n        actions.extend(move_to_position(nearest_tool_pos))\n        actions.append(4)  # USE to place or use the tool\n\n  path_to_primitive = plan_path_to_primitive(primitive_index)\n  if path_to_primitive is not None:\n    actions.extend(convert_directions_to_actions(path_to_primitive))\n    actions.append(4)  # USE to pick up the primitive\n    return actions\n\n  for tool in adjacent_tools.get(primitive, []):\n    if np.any(inventory[cookbook.index[tool]] == 0):\n      continue\n      \n      nearest_tool_pos = get_nearest_positions([cookbook.index[tool]])[cookbook.index[tool]]\n      if nearest_tool_pos:\n        actions.extend(move_to_position(nearest_tool_pos))\n        actions.append(4)  # USE to place or use the tool\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
