for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          continue\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T07:36:27.374382", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          continue\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T07:37:58.531635", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T07:37:59.641897", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T07:39:11.432093", "function_name": "collect", "function_body": "  # Placeholder for finding the location of the primitive\n  def find_primitive():\n    grid = env._current_state.grid\n    index = env.world.cookbook.index.index(primitive)\n    width, height, _ = grid.shape\n    for x in range(width):\n      for y in range(height):\n        if grid[x, y, index] > 0:\n          return (x, y)\n    return None\n\n  # Placeholder for computing the shortest path to (x, y)\n  def compute_path_to(x, y):\n    start_x, start_y = env._current_state.pos\n    queue = collections.deque([(start_x, start_y, [])])\n    visited = set()\n    \n    while queue:\n      cx, cy, path = queue.popleft()\n      \n      if (cx, cy) == (x, y):\n        actions = []\n        for dx, dy in path:\n          if dx > 0: actions.append(env.action_specs()[\"DOWN\"])\n          elif dx < 0: actions.append(env.action_specs()[\"UP\"])\n          elif dy > 0: actions.append(env.action_specs()[\"RIGHT\"])\n          elif dy < 0: actions.append(env.action_specs()[\"LEFT\"])\n        return actions\n      \n      if (cx, cy) in visited:\n        continue\n      visited.add((cx, cy))\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = cx + dx, cy + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny, path + [(dx, dy)]))\n    \n    return []\n\n  primitive_location = find_primitive()\n  \n  if not primitive_location:\n    raise ValueError(f\"Primitive {primitive} not found in the environment.\")\n  \n  actions_to_move = compute_path_to(primitive_location[0], primitive_location[1])\n  actions_to_collect = [env.action_specs()[\"USE\"]]\n  \n  return actions_to_move + actions_to_collect", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-20T07:39:12.481901", "function_name": "collect", "function_body": "  def find_primitive():\n    # Placeholder for finding the location of the primitive\n    # Should return a tuple (x, y) indicating its position\n    primitive_index = env.world.cookbook.index[primitive]\n    grid = env._current_state.grid\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if np.any(grid[y, x] == primitive_index):\n          return (x, y)\n    return None\n\n  def compute_path_to(x, y):\n    # Placeholder for computing the shortest path to (x, y)\n    # Should return a list of action indices leading to (x, y)\n    start_pos = env._current_state.pos\n    path = astar_search(start_pos, (x, y), env._current_state.grid)\n    actions = []\n    current_dir = env._current_state.dir\n    for next_pos in path:\n      move_action = get_move_action(current_dir, start_pos, next_pos)\n      if move_action is not None:\n        actions.append(move_action)\n      start_pos = next_pos\n    return actions\n\n  def astar_search(start, goal, grid):\n    # Placeholder for A* search implementation\n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in get_neighbors(current, grid):\n        tentative_g_score = g_score[current] + 1\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def get_neighbors(pos, grid):\n      x, y = pos\n      neighbors = []\n      if x > 0 and grid[y, x-1].sum() == 0:\n          neighbors.append((x-1, y))\n      if x < grid.shape[1] - 1 and grid[y, x+1].sum() == 0:\n          neighbors.append((x+1, y))\n      if y > 0 and grid[y-1, x].sum() == 0:\n          neighbors.append((x, y-1))\n      if y < grid.shape[0] - 1 and grid[y+1, x].sum() == 0:\n          neighbors.append((x, y+1))\n      return neighbors\n\n  def get_move_action(current_dir, start_pos, next_pos):\n    sx, sy = start_pos\n    nx, ny = next_pos\n    if nx < sx:\n        target_dir = 2  # LEFT\n    elif nx > sx:\n        target_dir = 3  # RIGHT\n    elif ny < sy:\n        target_dir = 1  # UP\n    elif ny > sy:\n        target_dir = 0  # DOWN\n\n    actions = []\n    if current_dir != target_dir:\n        actions.append(target_dir)\n\n    actions.append(env.action_specs()[\"DOWN\"])  # Move forward to next position\n    return actions\n\n  primitive_location = find_primitive()\n  if not primitive_location:\n      return []\n\n  actions_to_move = compute_path_to(primitive_location[0], primitive_location[1])\n  actions_to_collect = [env.action_specs()[\"USE\"]]\n\n  return actions_to_move + actions_to_collect", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T07:40:44.515256", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n\n    # Use A* algorithm to find the shortest path\n    grid = env._current_state.grid\n    inventory = env._current_state.inventory\n    width, height = grid.shape[0], grid.shape[1]\n\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    queue = [(0, current_x, current_y, [])]\n    visited = set()\n\n    while queue:\n      cost, x, y, path = heapq.heappop(queue)\n      if (x, y) == (target_x, target_y):\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n\n              # Check for obstacles and tools needed to pass them\n              obstacle_cost = 0\n              if grid[nx, ny, env.world.water_index] > 0:\n                  if any(inventory[b] > 0 for b in bridge_indices):\n                      actions.append(env.action_specs()['USE'])\n                      obstacle_cost += 1\n              elif grid[nx, ny, env.world.stone_index] > 0:\n                  if any(inventory[p] > 0 for p in pickaxe_indices):\n                      actions.append(env.action_specs()['USE'])\n                      obstacle_cost += 1\n\n              new_cost = cost + 1 + obstacle_cost\n              heapq.heappush(queue, (new_cost, nx, ny, path + [(nx, ny)]))\n              visited.add((nx, ny))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find all positions of the desired primitive in the grid\n  primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if not primitive_positions.size:\n      return []\n\n  # Sort positions by proximity to the current position\n  current_x, current_y = env._current_state.pos\n  sorted_positions = sorted(primitive_positions, key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y))\n\n  for target_x, target_y in sorted_positions:\n      path = add_move(target_x, target_y)\n      if path is not None:\n          # Add actions to follow the path\n          for (nx, ny) in path:\n              add_move(nx, ny)\n\n          # Collect the primitive\n          actions.append(env.action_specs()['USE'])\n          break\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-20T07:40:45.481957", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def place_tool(tool_indices):\n    for tool_index in tool_indices:\n      if env._current_state.inventory[tool_index] > 0:\n        actions.append(env.action_specs()['USE'])\n        break\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  for dx, dy in path:\n    add_move(dx, dy)\n\n    # Check for obstacles and place tools as needed\n    x, y = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n    if grid[x, y, env.world.water_index] > 0:\n      place_tool(bridge_indices)\n    elif grid[x, ny, env.world.stone_index] > 0:\n      place_tool(pickaxe_indices)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-20T07:41:43.103134", "function_name": "collect", "function_body": "  # Determine the index of the desired primitive.\n  primitive_index = env.world.cookbook.index.primitive(primitive)\n\n  if not primitive_index:\n    raise ValueError(f\"Primitive '{primitive}' is unknown in the environment.\")\n\n  # Initialize the queue for BFS and a set to track visited states.\n  bfs_queue = collections.deque()\n  bfs_queue.append((env._current_state, []))  # (state, path)\n  visited_states = set()\n\n  while bfs_queue:\n    current_state, path = bfs_queue.popleft()\n\n    if current_state.next_to(primitive_index):\n      # If the primitive is next to the agent, return the path with a USE action.\n      return path + [env.action_specs()[\"USE\"]]\n\n    # Get possible actions based on the current state.\n    for direction in [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]:\n      move_action = env.action_specs()[direction]\n      new_state = current_state.step(move_action)[1]  # [1] is the new CraftState after the action.\n\n      # Check if this state has been visited before.\n      if hash(new_state) not in visited_states:\n        bfs_queue.append((new_state, path + [move_action]))\n        visited_states.add(hash(new_state))\n\n    # Optionally, add logic to use tools here if the agent is next to a tool and it might help.\n\n  return []  # Return an empty list if no path is found.", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T07:41:44.066193", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    # Get the index of the primitive from the environment's world\n    return env._current_state.world.cookbook.index[primitive]\n\n  def find_closest_primitive():\n    # Find the closest position of the primitive in the grid\n    i_kind = get_primitive_index(primitive)\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n\n    min_distance = float('inf')\n    target_pos = None\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, i_kind] > 0:\n                distance = abs(x - pos[0]) + abs(y - pos[1])\n                if distance < min_distance:\n                    min_distance = distance\n                    target_pos = (x, y)\n    return target_pos\n\n  def compute_shortest_path(target_pos):\n      # Compute the shortest path to the target position using a simple BFS\n      start_pos = env._current_state.pos\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if current_pos == target_pos:\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (0 <= new_pos[0] < grid.shape[0]) and (0 <= new_pos[1] < grid.shape[1]) and (new_pos not in visited):\n                  # Check for obstacles\n                  if is_path_clear(current_pos, new_pos):\n                      visited.add(new_pos)\n                      queue.append((new_pos, path + [get_move_action(dx, dy)]))\n      return []\n\n  def get_move_action(dx, dy):\n      # Convert position change to action index\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"UP\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"DOWN\"]\n\n  def is_path_clear(current_pos, new_pos):\n      # Check if the path between current position and new position is clear\n      grid = env._current_state.grid\n      x, y = (current_pos[0] + new_pos[0]) // 2, (current_pos[1] + new_pos[1]) // 2\n      return all(grid[x, y, i_kind] == 0 for i_kind in env._current_state.world.non_grabbable_indices)\n\n  target_pos = find_closest_primitive()\n  if target_pos is None:\n      # No primitive found, just stay put and use an action to avoid getting stuck\n      return [env.action_specs()[\"DOWN\"]]\n  \n  path_to_target = compute_shortest_path(target_pos)\n  actions_to_collect = path_to_target + [env.action_specs()[\"USE\"]]\n\n  return actions_to_collect", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T07:43:22.648498", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              actions.append(env.action_specs()['USE'])\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          continue\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T07:43:23.701092", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                actions.append(env.action_specs()['USE'])\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                actions.append(env.action_specs()['USE'])\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T07:45:07.071318", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n      # Use tools in inventory if needed (e.g., BRIDGE to cross WATER)\n      for tool in env.world.cookbook.index.ordered_items():\n          i_tool = env.world.cookbook.index.index(tool)\n          if inventory[i_tool] > 0:\n              for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  x, y = pos[0] + dx, pos[1] + dy\n                  if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                      # Check for specific obstacles like WATER that require a BRIDGE.\n                      i_obstacle = env.world.cookbook.index.index(\"WATER\")\n                      if grid[x, y, i_obstacle] > 0:\n                          # Use the tool to overcome the obstacle (e.g., place a BRIDGE).\n                          path_with_tool = path + [4]  # Assuming USE action places the bridge\n                          queue.append((pos, dir, inventory, path_with_tool))\n                          visited.add((pos, dir))\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": -1}}
