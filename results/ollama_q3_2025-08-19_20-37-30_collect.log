{"timestamp": "2025-08-20T05:32:19.822190", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n      current_state = env._current_state\n      grid = current_state.grid\n      return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n      pos_list = []\n      for index in indices:\n          pos_list.extend(np.argwhere(grid[..., index]))\n      distances = np.linalg.norm(\n          np.array(pos_list) - np.array(current_state.pos), axis=1)\n      sorted_indices = np.argsort(distances)\n      return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n      current_state = env._current_state\n      pos = current_state.pos\n      dir = current_state.dir\n      dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n      actions = []\n\n      # Calculate the shortest path direction\n      if abs(dx) >= abs(dy):\n          target_dir = 3 if dx > 0 else 1\n      else:\n          target_dir = 2 if dy < 0 else 0\n\n      while dir != target_dir:\n          actions.append(2)  # RIGHT turn\n          dir += 1\n          if dir == 4:\n              dir -= 4\n\n      actions.extend([0] * abs(dx))  # move forward as needed\n      actions.extend([1] * abs(dy))  # move backward as needed\n\n      return actions\n\n  def collect_primitive(primitive_index):\n      nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n      if not nearest_positions:\n          return []\n      for pos in nearest_positions:\n          actions = move_to_position(pos)\n          actions.append(4)  # USE to pick up the primitive\n          if is_primitive_available(primitive_index):\n              return actions\n      return []\n\n  def place_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      # Check and collect the tool if not already in inventory\n      if np.any(env._current_state.inventory[tool_index] == 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if not nearest_tool_positions:\n              return []\n          \n          actions = move_to_position(nearest_tool_positions[0])\n          actions.append(4)  # USE to pick up the tool\n      else:\n          actions = []\n\n      # Use the tool to access the required primitive\n      current_state = env._current_state\n      grid = current_state.grid\n      \n      combined_positions = set()\n      for pos in get_nearest_positions(grid, [required_primitive_index]):\n          if grid[pos[0], pos[1], tool_index] > 0:\n              combined_positions.add(pos)\n\n      if not combined_positions:\n          return actions\n    \n      nearest_pos = sorted(combined_positions,\n                           key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n\n      return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n      tool_index = cookbook.index[tool]\n      if np.any(inventory[tool_index] > 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if nearest_tool_positions:\n              actions.extend(move_to_position(nearest_tool_positions[0]))\n              actions.append(4)  # USE to place or use the tool\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:33:24.662028", "function_name": "collect", "function_body": "  # Fetch the current state and inventory\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Find the index of the target primitive in the world's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Check if we already have the primitive in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Create a grid representation with the position of the agent and the target primitive\n  grid = current_state.grid\n\n  # Identify all positions of the target primitive on the grid\n  target_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(target_positions) == 0:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n\n  # Calculate the shortest path to each target position using BFS (Breadth-First Search)\n  def bfs_shortest_path(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {}\n      while queue:\n          current_pos = queue.popleft()\n          if tuple(current_pos) == tuple(goal):\n              path = []\n              while tuple(current_pos) in parent:\n                  path.append(tuple(current_pos))\n                  current_pos = parent[tuple(current_pos)]\n              return path[::-1]\n          visited.add(tuple(current_pos))\n          for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n              if (0 <= neighbor[0] < grid.shape[0] and\n                  0 <= neighbor[1] < grid.shape[1] and\n                  tuple(neighbor) not in visited):\n                  queue.append(neighbor)\n                  parent[tuple(neighbor)] = current_pos\n      return None\n\n  # Find the shortest path to each target position\n  shortest_paths = []\n  for pos in target_positions:\n      path = bfs_shortest_path(current_state.pos, pos)\n      if path is not None:\n          shortest_paths.append(path)\n\n  if len(shortest_paths) == 0:\n      raise ValueError(\"No reachable path to any {primitive} found.\")\n\n  # Choose the shortest of all paths\n  chosen_path = min(shortest_paths, key=len)\n\n  # Convert the path into actions\n  def path_to_actions(path):\n      actions = []\n      current_pos = env._current_state.pos\n      for target_pos in path:\n          dx = target_pos[0] - current_pos[0]\n          dy = target_pos[1] - current_pos[1]\n          if dx == 1:\n              actions.append(env.action_specs()[\"DOWN\"])\n          elif dx == -1:\n              actions.append(env.action_specs()[\"UP\"])\n          elif dy == 1:\n              actions.append(env.action_specs()[\"RIGHT\"])\n          elif dy == -1:\n              actions.append(env.action_specs()[\"LEFT\"])\n          current_pos = target_pos\n      # Add the USE action to collect the primitive\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n\n  actions_to_take = path_to_actions(chosen_path)\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:33:25.660319", "function_name": "collect", "function_body": "  actions = []\n\n  # Define the directions for moving around the grid\n  DIRECTIONS = {\"UP\": 0, \"DOWN\": 1, \"LEFT\": 2, \"RIGHT\": 3}\n\n  # Get the current state and inventory of the agent\n  current_state = env._current_state\n\n  # Find the index of the primitive to collect\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  def bfs(start_pos):\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    while queue:\n      pos, path = queue.popleft()\n      if pos in visited:\n        continue\n      visited.add(pos)\n      x, y = pos\n\n      # Check all four directions (UP, DOWN, LEFT, RIGHT)\n      for direction, move in DIRECTIONS.items():\n        dx, dy = 0, 0\n        if direction == \"UP\":\n          dy -= 1\n        elif direction == \"DOWN\":\n          dy += 1\n        elif direction == \"LEFT\":\n          dx -= 1\n        elif direction == \"RIGHT\":\n          dx += 1\n\n        new_pos = (x + dx, y + dy)\n        if not (0 <= new_pos[0] < current_state.grid.shape[0] and 0 <= new_pos[1] < current_state.grid.shape[1]):\n          continue\n\n        # Check if the cell is occupied by a non-grabbable entity\n        if any(current_state.world.cookbook.environment & set(np.argmax(current_state.grid[new_pos], axis=2))):\n          continue\n\n        # Check if the cell contains the primitive\n        if current_state.grid[new_pos, primitive_index] > 0:\n          return path + [move]\n\n        queue.append((new_pos, path + [move]))\n\n    return None\n\n  # Perform BFS to find a path to the primitive\n  start_pos = current_state.pos\n  path = bfs(start_pos)\n  if path is not None:\n    actions.extend(path)\n\n  # Add the action to collect the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:35:24.448539", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    \n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  def use_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    nearest_positions = get_nearest_positions(current_state.grid, [required_primitive_index])\n    if not nearest_positions:\n      return []\n\n    actions = []\n    \n    for pos in nearest_positions:\n        # Check if the tool is available at this position\n        current_grid = env._current_state.grid\n        if current_grid[pos[0], pos[1], tool_index] > 0:\n            actions.extend(move_to_position(pos))\n            actions.append(4)  # USE to pick up the primitive using the tool\n\n    return actions\n\n  def use_inventory_tools():\n      inventory_actions = []\n      for item in env._current_state.inventory:\n          if np.any(item > 0):\n              item_name = [k for k, v in env.world.cookbook.index.items() if v == item][0]\n              if item_name in required_tools.get(primitive, []):\n                  inventory_actions.extend(use_tool(item_name, primitive))\n      return inventory_actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n\n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n\n  actions = use_inventory_tools()\n\n  if not actions:\n    for tool in required_tools.get(primitive, []):\n        tool_index = cookbook.index[tool]\n        \n        if np.any(inventory[tool_index] > 0):\n            nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n            \n            if nearest_tool_positions:\n                actions.extend(move_to_position(nearest_tool_positions[0]))\n                actions.append(4)  # USE to pick up the tool\n        \n        else:\n            actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 6, "scores": {"3": 2.5}}
