id, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n\n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n\n  actions = []\n  \n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    \n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        \n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to pick up the tool\n    \n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 6, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:36:50.374141", "function_name": "collect", "function_body": "  def find_closest_primitive(primitive_index):\n    # Find the closest primitive in the grid\n    pos = np.array(env._current_state.pos)\n    grid = env._current_state.grid\n    closest_distance = float('inf')\n    target_pos = None\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, primitive_index] > 0:\n                distance = np.linalg.norm(np.array([x, y]) - pos)\n                if distance < closest_distance:\n                    closest_distance = distance\n                    target_pos = (x, y)\n    return target_pos\n\n  def compute_shortest_path(start, end):\n      # Simple BFS to find the shortest path from start to end\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == end:\n              break\n          \n          x, y = current\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (x + dx, y + dy)\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and \\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1] and \\\n                 neighbor not in visited and \\\n                 env._current_state.grid[neighbor[0], neighbor[1], env.world.water_index] == 0:\n                  queue.append(neighbor)\n                  visited.add(neighbor)\n                  parent_map[neighbor] = current\n      \n      path = []\n      while end is not None:\n          path.append(end)\n          end = parent_map[end]\n      return path[::-1]\n\n  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index.get(primitive, None)\n  if primitive_index is None:\n      return []  # Primitive not found\n  \n  # Find the closest primitive in the grid\n  target_pos = find_closest_primitive(primitive_index)\n  if target_pos is None:\n      return []  # No primitives found\n  \n  # Compute the shortest path to the primitive\n  start_pos = env._current_state.pos\n  path = compute_shortest_path(start_pos, target_pos)\n  \n  # Convert path to actions\n  actions = []\n  current_dir = env._current_state.dir\n  for x, y in path:\n      while (x - env._current_state.pos[0], y - env._current_state.pos[1]) not in [(0, -1), (-1, 0), (1, 0), (0, 1)]:\n          time.sleep(0.1)  # Wait for the agent to move\n      dx = x - env._current_state.pos[0]\n      dy = y - env._current_state.pos[1]\n      \n      if dx == 0 and dy == -1:  # Move UP\n          actions.append(env.action_specs()[\"UP\"])\n      elif dx == 0 and dy == 1:  # Move DOWN\n          actions.append(env.action_specs()[\"DOWN\"])\n      elif dx == -1 and dy == 0:  # Move LEFT\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif dx == 1 and dy == 0:  # Move RIGHT\n          actions.append(env.action_specs()[\"RIGHT\"])\n      \n      # Update current direction based on action\n      if actions[-1] == env.action_specs()[\"UP\"]:\n          current_dir = 0\n      elif actions[-1] == env.action_specs()[\"DOWN\"]:\n          current_dir = 2\n      elif actions[-1] == env.action_specs()[\"LEFT\"]:\n          current_dir = 3\n      elif actions[-1] == env.action_specs()[\"RIGHT\"]:\n          current_dir = 1\n      \n      # Add USE action to collect the primitive\n      actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:36:51.344149", "function_name": "collect", "function_body": "  # Get the index of the target primitive\n  primitive_index = env.world.cookbook.index(primitive)\n\n  # Define actions for movement and collecting\n  action_up = env.action_specs()[\"UP\"]\n  action_down = env.action_specs()[\"DOWN\"]\n  action_left = env.action_specs()[\"LEFT\"]\n  action_right = env.action_specs()[\"RIGHT\"]\n  action_use = env.action_specs()[\"USE\"]\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Find all positions of the target primitive in the grid\n  positions_of_primitive = np.argwhere(current_state.grid[:, :, primitive_index] > 0)\n\n  if len(positions_of_primitive) == 0:\n    return []  # No primitives to collect, return empty action list\n\n  # Use A* search to find the shortest path to each position of the target primitive\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b))\n\n  def a_star_search(start, goal):\n    open_set = set([start])\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n      current = min(open_set, key=lambda k: f_score[k])\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      open_set.remove(current)\n\n      neighbors = [(current[0] + 1, current[1]), (current[0] - 1, current[1]),\n                   (current[1] + 1, current[1]), (current[1] - 1, current[1])]\n\n      for neighbor in neighbors:\n        tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.add(neighbor)\n\n    return None\n\n  actions_to_take = []\n\n  # Find the shortest path to each position of the target primitive and convert it into a sequence of actions\n  for pos in positions_of_primitive:\n    start_pos = current_state.pos\n    path = a_star_search(start_pos, tuple(pos))\n\n    if path is not None:\n      direction_map = {(1, 0): action_down, (-1, 0): action_up,\n                       (0, 1): action_right, (0, -1): action_left}\n\n      for i in range(len(path) - 1):\n        dx = path[i + 1][0] - path[i][0]\n        dy = path[i + 1][1] - path[i][1]\n\n        if (dx, dy) in direction_map:\n          actions_to_take.append(direction_map[(dx, dy)])\n\n      # Add the use action to collect the primitive\n      actions_to_take.append(action_use)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:38:40.246796", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n      current_state = env._current_state\n      grid = current_state.grid\n      return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n      pos_list = []\n      for index in indices:\n          pos_list.extend(np.argwhere(grid[..., index]))\n      distances = np.linalg.norm(\n          np.array(pos_list) - np.array(current_state.pos), axis=1)\n      sorted_indices = np.argsort(distances)\n      return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n      current_state = env._current_state\n      pos = current_state.pos\n      dir = current_state.dir\n      dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n      actions = []\n\n      # Calculate the shortest path direction\n      if abs(dx) >= abs(dy):\n          target_dir = 3 if dx > 0 else 1\n      else:\n          target_dir = 2 if dy < 0 else 0\n\n      while dir != target_dir:\n          actions.append(2)  # RIGHT turn\n          dir += 1\n          if dir == 4:\n              dir -= 4\n\n      actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n      return actions\n\n  def collect_primitive(primitive_index):\n      nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n      if not nearest_positions:\n          return []\n      for pos in nearest_positions:\n          actions = move_to_position(pos)\n          actions.append(4)  # USE to pick up the primitive\n          if is_primitive_available(primitive_index):\n              return actions\n      return []\n\n  def place_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      # Check and collect the tool if not already in inventory\n      if np.any(env._current_state.inventory[tool_index] == 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if not nearest_tool_positions:\n              return []\n          \n          actions = move_to_position(nearest_tool_positions[0])\n          actions.append(4)  # USE to pick up the tool\n      else:\n          actions = []\n\n      # Use the tool to access the required primitive\n      current_state = env._current_state\n      grid = current_state.grid\n      \n      combined_positions = set()\n      for pos in get_nearest_positions(grid, [required_primitive_index]):\n          if grid[pos[0], pos[1], tool_index] > 0:\n              combined_positions.add(pos)\n\n      if not combined_positions:\n          return actions\n      \n      nearest_pos = sorted(combined_positions,\n                           key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n\n      return actions\n\n  def use_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      # Find positions of the target primitive that can be reached using the tool\n      reachable_positions = get_nearest_positions(current_state.grid, [required_primitive_index])\n\n      if not reachable_positions:\n          return []\n\n      for pos in reachable_positions:\n          # Check if the tool is present at this position\n          if current_state.grid[pos[0], pos[1], tool_index] > 0:\n              actions = move_to_position(pos)\n              actions.append(4)  # USE to apply the tool to collect the primitive\n              return actions\n\n      return []\n\n  def collect_with_tools(primitive, tools):\n      for tool in tools:\n          if np.any(env._current_state.inventory[env.world.cookbook.index[tool]] > 0):\n              actions = use_tool(tool, primitive)\n              if actions:\n                  return actions\n      return []\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n      if np.any(inventory[env.world.cookbook.index[tool]] > 0):\n          actions.extend(use_tool(tool, primitive))\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
