{"timestamp": "2025-08-20T05:48:48.647289", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:50:35.643634", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n        target_dir = 3 if dx > 0 else 1\n    else:\n        target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n        actions.append(2)  # RIGHT turn\n        dir += 1\n        if dir == 4:\n            dir -= 4\n\n    actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n        return []\n    for pos in nearest_positions:\n        actions = move_to_position(pos)\n        actions.append(4)  # USE to pick up the primitive\n        if is_primitive_available(primitive_index):\n            return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      # Check and collect the tool if not already in inventory\n      if np.any(env._current_state.inventory[tool_index] == 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if not nearest_tool_positions:\n              return []\n          \n          actions = move_to_position(nearest_tool_positions[0])\n          actions.append(4)  # USE to pick up the tool\n      else:\n          actions = []\n\n      # Use the tool to access the required primitive\n      current_state = env._current_state\n      grid = current_state.grid\n      \n      combined_positions = set()\n      for pos in get_nearest_positions(grid, [required_primitive_index]):\n          if grid[pos[0], pos[1], tool_index] > 0:\n              combined_positions.add(pos)\n\n      if not combined_positions:\n          return actions\n      \n      nearest_pos = sorted(combined_positions,\n                           key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n\n      return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n\n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n\n  actions = []\n  for tool in required_tools.get(primitive, []):\n      tool_index = cookbook.index[tool]\n      if np.any(inventory[tool_index] > 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if nearest_tool_positions:\n              actions.extend(move_to_position(nearest_tool_positions[0]))\n              actions.append(4)  # USE to place or use the tool\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:50:36.707863", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n      current_state = env._current_state\n      grid = current_state.grid\n      return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n      pos_list = []\n      for index in indices:\n          pos_list.extend(np.argwhere(grid[..., index]))\n      distances = np.linalg.norm(\n          np.array(pos_list) - np.array(current_state.pos), axis=1)\n      sorted_indices = np.argsort(distances)\n      return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n      current_state = env._current_state\n      pos = current_state.pos\n      dir = current_state.dir\n      dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n      actions = []\n\n      # Calculate the shortest path direction\n      if abs(dx) >= abs(dy):\n          target_dir = 3 if dx > 0 else 1\n      else:\n          target_dir = 2 if dy < 0 else 0\n\n      while dir != target_dir:\n          actions.append(2)  # RIGHT turn (turn right)\n          dir += 1\n          if dir == 4:\n              dir -= 4\n\n      actions.extend([0] * abs(dx))  # move forward as needed\n      actions.extend([1] * abs(dy))  # move backward as needed\n\n      return actions\n\n  def collect_primitive(primitive_index):\n      nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n      if not nearest_positions:\n          return []\n      for pos in nearest_positions:\n          actions = move_to_position(pos)\n          actions.append(4)  # USE to pick up the primitive\n          if is_primitive_available(primitive_index):\n              return actions\n      return []\n\n  def place_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      # Check and collect the tool if not already in inventory\n      if np.any(env._current_state.inventory[tool_index] == 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if not nearest_tool_positions:\n              return []\n          \n          actions = move_to_position(nearest_tool_positions[0])\n          actions.append(4)  # USE to pick up the tool\n      else:\n          actions = []\n\n      # Use the tool to access the required primitive\n      current_state = env._current_state\n      grid = current_state.grid\n      \n      combined_positions = set()\n      for pos in get_nearest_positions(grid, [required_primitive_index]):\n          if grid[pos[0], pos[1], tool_index] > 0:\n              combined_positions.add(pos)\n\n      if not combined_positions:\n          return actions\n      \n      nearest_pos = sorted(combined_positions,\n                           key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n\n      return actions\n\n  def use_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      if np.any(env._current_state.inventory[tool_index] > 0):\n          nearest_positions = get_nearest_positions(current_state.grid, [required_primitive_index])\n          if not nearest_positions:\n              return []\n          \n          actions = move_to_position(nearest_positions[0])\n          actions.append(4)  # USE to pick up the primitive\n      else:\n          actions = place_tool(tool, target_primitive)\n\n      return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n\n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n\n  actions = []\n  for tool in required_tools.get(primitive, []):\n      actions.extend(use_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:52:24.149560", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n    if not nearest_tool_positions:\n      return []\n    \n    actions = move_to_position(nearest_tool_positions[0])\n    actions.append(4)  # USE to pick up the tool\n\n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  def find_path_with_tools(target_primitive):\n    required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n    }\n\n    primitive_index = cookbook.index[target_primitive]\n    if is_primitive_available(primitive_index):\n        return collect_primitive(primitive_index)\n\n    actions = []\n    for tool in required_tools.get(target_primitive, []):\n        tool_index = cookbook.index[tool]\n        if np.any(inventory[tool_index] > 0):\n            nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n            if nearest_tool_positions:\n                actions.extend(move_to_position(nearest_tool_positions[0]))\n                actions.append(4)  # USE to place or use the tool\n        else:\n            actions.extend(place_tool(tool, target_primitive))\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  return find_path_with_tools(primitive)", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:52:25.225892", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      if target_dir == (dir + 1) % 4:  # Turn right\n        actions.append(2)\n      elif target_dir == (dir - 1) % 4:  # Turn left\n        actions.append(3)\n      else:  # Turn around\n        actions.extend([2, 2])\n      dir = target_dir\n\n    # Move forward and backward as needed\n    for _ in range(abs(dx)):\n      actions.append(0 if dx > 0 else 1)  # DOWN or UP depending on direction\n    for _ in range(abs(dy)):\n      actions.append(3 if dy < 0 else 2)  # LEFT or RIGHT depending on direction\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to place or use the tool\n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:53:10.749292", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0 or state.next_to(primitive_index):\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n\n              # Check if the next state is valid and not yet visited\n              if next_state.next_to(primitive_index) and id(next_state) not in visited:\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:53:11.869925", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([current_state])\n  visited = set()\n  parent_map = {}\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, reconstruct the path\n          actions = []\n          while state in parent_map:\n              action_idx, prev_state = parent_map[state]\n              action_name = list(action_mapping.keys())[list(action_mapping.values()).index(action_idx)]\n              actions.append(action_mapping[action_name])\n              state = prev_state\n          return actions[::-1]\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action in range(world.n_actions):\n              _, next_state = state.step(action)\n\n              # Check if the next state has the primitive or is next to it\n              if (next_state.inventory[primitive_index] > 0 or \n                  next_state.next_to(primitive_index) and \n                  all(item == 0 for item in next_state.inventory if item not in world.cookbook.primitives)):\n                  parent_map[next_state] = (action, state)\n                  queue.append(next_state)\n\n  return []", "island_id": 4, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T05:54:44.434123", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T05:54:45.534209", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T05:56:14.587073", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:56:15.640211", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:57:03.298383", "function_name": "collect", "function_body": "  # Define the mapping from primitive names to action indices\n  primitive_to_action = {\n      \"BOUNDARY\": None,\n      \"WATER\": None,\n      \"STONE\": None,\n      \"WORKSHOP0\": None,\n      \"WORKSHOP1\": None,\n      \"WORKSHOP2\": None,\n      \"WOOD\": env.action_specs()[\"USE\"],\n      \"IRON\": env.action_specs()[\"USE\"],\n      \"GRASS\": env.action_specs()[\"USE\"],\n      \"ROCK\": env.action_specs()[\"USE\"],\n      \"GOLD\": env.action_specs()[\"USE\"],\n      \"GEM\": env.action_specs()[\"USE\"]\n  }\n\n  # Get the action index for the specified primitive\n  action = primitive_to_action.get(primitive)\n\n  if action is None:\n    raise ValueError(f\"No defined action for primitive: {primitive}\")\n\n  return [action]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:57:04.266992", "function_name": "collect", "function_body": "  def find_path(grid, start_pos, target_kind):\n    # Breadth-first search to find the shortest path from start_pos to a cell containing target_kind\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, target_kind] > 0:\n        return path + [target_kind]\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [dx, dy]))\n    return None\n\n  def can_use_tool(grid, pos, tool_kind):\n    # Check if there's a nearby cell with the required tool\n    for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n      nx, ny = pos[0] + dx, pos[1] + dy\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n        if grid[nx, ny, tool_kind] > 0:\n          return True\n    return False\n\n  # Get the current state of the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  inventory = current_state.inventory\n\n  # Find the index of the target primitive\n  target_index = current_state.world.cookbook.index(primitive)\n\n  # Find a path to the nearest cell containing the target primitive\n  path_to_target = find_path(grid, pos, target_index)\n  if not path_to_target:\n    return []\n\n  actions = []\n  for step in path_to_target[:-1]:\n    # Translate direction vector to action index\n    if step == (1, 0):\n      actions.append(env.action_specs()[\"DOWN\"])\n    elif step == (-1, 0):\n      actions.append(env.action_specs()[\"UP\"])\n    elif step == (0, 1):\n      actions.append(env.action_specs()[\"RIGHT\"])\n    elif step == (0, -1):\n      actions.append(env.action_specs()[\"LEFT\"])\n\n  # Check if the agent can use any tools required to collect the primitive\n  target_kind = path_to_target[-1]\n  tool_needed = get_tool_for_primitive(primitive)\n  if tool_needed and not can_use_tool(grid, pos, current_state.world.cookbook.index(tool_needed)):\n    return []\n\n  # Add action to pick up the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:59:07.023025", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction using A* algorithm for better efficiency\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    def a_star(start, goal):\n        open_set = collections.deque([(start, [])])\n        closed_set = set()\n        g_costs = {start: 0}\n\n        while open_set:\n            current_pos, path = open_set.popleft()\n\n            if current_pos in closed_set:\n                continue\n            closed_set.add(current_pos)\n\n            if current_pos == goal:\n                return path\n\n            for direction in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                neighbor = tuple(np.array(current_pos) + np.array(direction))\n                tentative_g_cost = g_costs[current_pos] + heuristic(neighbor, start)\n\n                if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                    continue\n                if current_state.grid[neighbor[0], neighbor[1], 0] > 0:  # Assuming obstacle index is 0\n                    continue\n\n                if neighbor not in g_costs or tentative_g_cost < g_costs[neighbor]:\n                    open_set.append((neighbor, path + [direction]))\n                    g_costs[neighbor] = tentative_g_cost\n\n        return None\n\n    path = a_star(pos, target_pos)\n    if path:\n      for dx, dy in path:\n          target_dir = 3 if dx > 0 else 1 if dx < 0 else (2 if dy < 0 else 0)\n\n          while dir != target_dir:\n              actions.append(2)  # RIGHT turn\n              dir += 1\n              if dir == 4:\n                  dir -= 4\n\n          actions.append(0 if dx == 0 and dy > 0 else 1 if dx == 0 and dy < 0 else (3 if dx > 0 else 1))\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n      tool_index = cookbook.index[tool]\n      if np.any(inventory[tool_index] > 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if nearest_tool_positions:\n              actions.extend(move_to_position(nearest_tool_positions[0]))\n              actions.append(4)  # USE to place or use the tool\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
