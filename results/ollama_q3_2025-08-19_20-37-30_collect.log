n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T05:00:57.244525", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T05:01:39.527828", "function_name": "collect", "function_body": "  # Fetch the current state from the environment\n  current_state = env._current_state\n\n  # Fetch the index for the specified primitive\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Define a queue to perform BFS (Breadth-First Search)\n  queue = collections.deque([(current_state, [])])\n  visited_states = set()\n\n  while queue:\n    state, path = queue.popleft()\n\n    # Check if the primitive is already in the inventory\n    if state.inventory[primitive_index] > 0:\n      return path\n\n    # Get all possible actions (UP, DOWN, LEFT, RIGHT, USE)\n    for action_name, action_index in env.action_specs().items():\n        new_state = None\n        reward, done, observations = None, False, {}\n\n        if action_name != \"USE\":\n          # Perform the movement action and get the new state\n          reward, done, observations = env.step(action_index, num_steps=1)\n          new_state = env._current_state\n\n          # Check if the new state is valid (not visited before)\n          if tuple(new_state.grid.flatten()) + tuple(new_state.pos) not in visited_states:\n            queue.append((new_state, path + [action_index]))\n            visited_states.add(tuple(new_state.grid.flatten()) + tuple(new_state.pos))\n        else:\n          # Check if the USE action can be applied\n          if state.next_to(primitive_index):\n            # Perform the USE action and get the new state\n            reward, done, observations = env.step(action_index, num_steps=1)\n            new_state = env._current_state\n\n            # Check if the new state is valid (not visited before)\n            if tuple(new_state.grid.flatten()) + tuple(new_state.pos) not in visited_states:\n              queue.append((new_state, path + [action_index]))\n              visited_states.add(tuple(new_state.grid.flatten()) + tuple(new_state.pos))\n\n  # If no path to collect the primitive is found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:01:40.626034", "function_name": "collect", "function_body": "  # Get the current state\n  current_state = env._current_state\n\n  # Define actions for movement and interaction\n  move_up = env.action_specs()[\"UP\"]\n  move_down = env.action_specs()[\"DOWN\"]\n  move_left = env.action_specs()[\"LEFT\"]\n  move_right = env.action_specs()[\"RIGHT\"]\n  use_action = env.action_specs()[\"USE\"]\n\n  # Helper function to determine if the agent is next to a specific item\n  def is_next_to(kind_index):\n    return current_state.next_to(kind_index)\n\n  # Get the index of the primitive from the world's cookbook\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  actions = []\n\n  # Check if the agent is already next to the primitive and can collect it\n  if is_next_to(primitive_index):\n    actions.append(use_action)\n  else:\n    # Placeholder: Perform a search for the nearest path to the primitive.\n    # For now, we assume a simple movement pattern that might not be optimal.\n\n    # Example of a hardcoded movement sequence (to be replaced with actual pathfinding logic)\n    example_movement_sequence = [move_down, move_right, use_action]\n\n    actions.extend(example_movement_sequence)\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:03:20.528792", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n      current_state = env._current_state\n      grid = current_state.grid\n      return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n      pos_list = []\n      for index in indices:\n          pos_list.extend(np.argwhere(grid[..., index]))\n      distances = np.linalg.norm(\n          np.array(pos_list) - np.array(current_state.pos), axis=1)\n      sorted_indices = np.argsort(distances)\n      return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n      current_state = env._current_state\n      pos = current_state.pos\n      dir = current_state.dir\n      dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n      actions = []\n\n      # Calculate the shortest path direction\n      if abs(dx) >= abs(dy):\n          target_dir = 3 if dx > 0 else 1\n      else:\n          target_dir = 2 if dy < 0 else 0\n\n      while dir != target_dir:\n          actions.append(2)  # RIGHT turn\n          dir += 1\n          if dir == 4:\n              dir -= 4\n\n      actions.extend([0] * abs(dx))  # move forward in x direction\n      actions.extend([1] * abs(dy))  # move forward in y direction\n\n      return actions\n\n  def collect_primitive(primitive_index):\n      nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n      if not nearest_positions:\n          return []\n      \n      for pos in nearest_positions:\n          actions = move_to_position(pos)\n          actions.append(4)  # USE to pick up the primitive\n          if is_primitive_available(primitive_index):\n              return actions\n      \n      return []\n\n  def place_tool(tool, target_primitive):\n      tool_index = env.world.cookbook.index[tool]\n      required_primitive_index = env.world.cookbook.index[target_primitive]\n\n      # Check and collect the tool if not already in inventory\n      if np.any(env._current_state.inventory[tool_index] == 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if not nearest_tool_positions:\n              return []\n          \n          actions = move_to_position(nearest_tool_positions[0])\n          actions.append(4)  # USE to pick up the tool\n      else:\n          actions = []\n\n      # Use the tool to access the required primitive\n      current_state = env._current_state\n      grid = current_state.grid\n      \n      combined_positions = set()\n      for pos in get_nearest_positions(grid, [required_primitive_index]):\n          if grid[pos[0], pos[1], tool_index] > 0:\n              combined_positions.add(pos)\n\n      if not combined_positions:\n          return actions\n      \n      nearest_pos = sorted(combined_positions,\n                           key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n      \n      actions.extend(move_to_position(nearest_pos))\n      actions.append(4)  # USE to pick up the primitive\n\n      return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n      tool_index = cookbook.index[tool]\n      if np.any(inventory[tool_index] > 0):\n          nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n          if nearest_tool_positions:\n              actions.extend(move_to_position(nearest_tool_positions[0]))\n              actions.append(4)  # USE to place or use the tool\n      else:\n          actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:03:21.580815", "function_name": "collect", "function_body": "  def is_primitive_available(primitive_index):\n    current_state = env._current_state\n    grid = current_state.grid\n    return np.any(grid[..., primitive_index] > 0)\n\n  def get_nearest_positions(grid, indices):\n    pos_list = []\n    for index in indices:\n      pos_list.extend(np.argwhere(grid[..., index]))\n    distances = np.linalg.norm(\n        np.array(pos_list) - np.array(current_state.pos), axis=1)\n    sorted_indices = np.argsort(distances)\n    return [tuple(pos_list[i]) for i in sorted_indices]\n\n  def move_to_position(target_pos):\n    current_state = env._current_state\n    pos = current_state.pos\n    dir = current_state.dir\n    dx, dy = target_pos[0] - pos[0], target_pos[1] - pos[1]\n    actions = []\n\n    # Calculate the shortest path direction\n    if abs(dx) >= abs(dy):\n      target_dir = 3 if dx > 0 else 1\n    else:\n      target_dir = 2 if dy < 0 else 0\n\n    while dir != target_dir:\n      actions.append(2)  # RIGHT turn\n      dir += 1\n      if dir == 4:\n        dir -= 4\n\n    actions.extend([0] * abs(dx) + [1] * abs(dy))  # move forward and backward as needed\n\n    return actions\n\n  def collect_primitive(primitive_index):\n    nearest_positions = get_nearest_positions(current_state.grid, [primitive_index])\n    if not nearest_positions:\n      return []\n    for pos in nearest_positions:\n      actions = move_to_position(pos)\n      actions.append(4)  # USE to pick up the primitive\n      if is_primitive_available(primitive_index):\n        return actions\n    return []\n\n  def place_tool(tool, target_primitive):\n    tool_index = env.world.cookbook.index[tool]\n    required_primitive_index = env.world.cookbook.index[target_primitive]\n\n    # Check and collect the tool if not already in inventory\n    if np.any(env._current_state.inventory[tool_index] == 0):\n      nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n      if not nearest_tool_positions:\n        return []\n      \n      actions = move_to_position(nearest_tool_positions[0])\n      actions.append(4)  # USE to pick up the tool\n    else:\n      actions = []\n\n    # Use the tool to access the required primitive\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    combined_positions = set()\n    for pos in get_nearest_positions(grid, [required_primitive_index]):\n        if grid[pos[0], pos[1], tool_index] > 0:\n            combined_positions.add(pos)\n\n    if not combined_positions:\n      return actions\n    \n    nearest_pos = sorted(combined_positions,\n                         key=lambda x: np.linalg.norm(np.array(x) - np.array(current_state.pos)))[0]\n    \n    actions.extend(move_to_position(nearest_pos))\n    actions.append(4)  # USE to pick up the primitive\n\n    return actions\n\n  current_state = env._current_state\n  inventory = current_state.inventory\n  cookbook = env.world.cookbook\n  \n  primitive_index = cookbook.index[primitive]\n  \n  if is_primitive_available(primitive_index):\n      return collect_primitive(primitive_index)\n\n  required_tools = {\n      \"GEM\": [\"PICKAXE\"],\n      \"WATER\": [\"BRIDGE\"]\n  }\n  \n  actions = []\n  for tool in required_tools.get(primitive, []):\n    tool_index = cookbook.index[tool]\n    if np.any(inventory[tool_index] > 0):\n        nearest_tool_positions = get_nearest_positions(current_state.grid, [tool_index])\n        if nearest_tool_positions:\n            actions.extend(move_to_position(nearest_tool_positions[0]))\n            actions.append(4)  # USE to place or use the tool\n    else:\n        actions.extend(place_tool(tool, primitive))\n\n  return actions", "island_id": 5, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T05:04:48.596164", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(dx, dy):\n    current_x, current_y = env._current_state.pos\n    new_x, new_y = current_x + dx, current_y + dy\n\n    # Determine the direction to move\n    if dx > 0:\n      direction = 'RIGHT'\n    elif dx < 0:\n      direction = 'LEFT'\n    elif dy > 0:\n      direction = 'DOWN'\n    elif dy < 0:\n      direction = 'UP'\n\n    action = env.action_specs()[direction]\n    actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:04:49.642671", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      directions = ['DOWN']\n    elif delta_y < 0:\n      directions = ['UP']\n    else:\n      directions = []\n\n    if delta_x > 0:\n      directions.append('RIGHT')\n    elif delta_x < 0:\n      directions.append('LEFT')\n\n    for direction in directions:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:05:26.527346", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  while queue:\n      state, actions_taken = queue.popleft()\n      \n      # Check if the primitive is in the inventory or next to the agent\n      if state.inventory[primitive_index] > 0 or state.next_to(primitive_index):\n          return actions_taken\n\n      # Mark this state as visited by its ID\n      visited.add(id(state))\n\n      for action_name, action_idx in action_mapping.items():\n          reward, next_state = state.step(action_idx)\n\n          if id(next_state) not in visited and (next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index)):\n              new_actions = actions_taken + [action_idx]\n              queue.append((next_state, new_actions))\n\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:05:27.579588", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0 or state.next_to(primitive_index):\n          return actions_taken\n\n      # Mark this state as visited by its ID\n      visited.add(id(state))\n\n      for action_name, action_idx in action_mapping.items():\n          reward, next_state = state.step(action_idx)\n\n          if id(next_state) not in visited and (next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index)):\n              new_actions = actions_taken + [action_idx]\n              queue.append((next_state, new_actions))\n\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:06:03.136655", "function_name": "collect", "function_body": "  # Get the index of the primitive we are looking for\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  actions = []\n\n  def move_to(x, y):\n    current_x, current_y = env._current_state.pos\n    while current_x != x:\n      if current_x < x:\n        actions.append(env.action_specs()[\"RIGHT\"])\n        current_x += 1\n      else:\n        actions.append(env.action_specs()[\"LEFT\"])\n        current_x -= 1\n\n    while current_y != y:\n      if current_y < y:\n        actions.append(env.action_specs()[\"DOWN\"])\n        current_y += 1\n      else:\n        actions.append(env.action_specs()[\"UP\"])\n        current_y -= 1\n\n  def find_primitive():\n    grid = env._current_state.grid\n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, primitive_idx] > 0:\n          return (i, j)\n    return None\n\n  target_pos = find_primitive()\n  if target_pos is not None:\n    move_to(target_pos[0], target_pos[1])\n    actions.append(env.action_specs()[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T05:06:04.100285", "function_name": "collect", "function_body": "  # Get the index of the desired primitive.\n  primitive_index = env.world.cookbook.index(primitive)\n  \n  # Get the agent's current state and grid.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Find all positions of the target primitive in the grid.\n  target_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if not target_positions.size:\n    return []  # No targets to collect.\n\n  # Calculate Manhattan distance from agent's position to each target position.\n  distances = np.sum(np.abs(target_positions - current_state.pos), axis=1)\n  \n  # Find the closest target position.\n  closest_target_position = tuple(target_positions[np.argmin(distances)])\n\n  actions = []\n\n  # Determine the direction and number of steps needed to reach the target position.\n  x_diff, y_diff = closest_target_position[0] - current_state.pos[0], closest_target_position[1] - current_state.pos[1]\n\n  if x_diff < 0:\n    actions.extend([env.action_specs()[\"UP\"] for _ in range(-x_diff)])\n  elif x_diff > 0:\n    actions.extend([env.action_specs()[\"DOWN\"] for _ in range(x_diff)])\n\n  if y_diff < 0:\n    actions.extend([env.action_specs()[\"LEFT\"] for _ in range(-y_diff)])\n  elif y_diff > 0:\n    actions.extend([env.action_specs()[\"RIGHT\"] for _ in range(y_diff)])\n\n  # Collect the target primitive.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:07:02.165984", "function_name": "collect", "function_body": "  def bfs(start_pos, target_kind):\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n      pos = queue.popleft()\n      if env._current_state.grid[pos[0], pos[1], target_kind] > 0:\n        path = []\n        while pos is not None:\n          path.append(pos)\n          pos = parent[pos]\n        return path[::-1]\n\n      visited.add(pos)\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (pos[0] + dx, pos[1] + dy)\n        if 0 <= new_pos[0] < env._current_state.grid.shape[0] and \\\n           0 <= new_pos[1] < env._current_state.grid.shape[1] and \\\n           new_pos not in visited:\n          queue.append(new_pos)\n          parent[new_pos] = pos\n\n    return None\n\n  def actions_from_path(path):\n      current_dir = env._current_state.dir\n      action_specs = env.action_specs()\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      actions = []\n\n      for i in range(len(path) - 1):\n          start, end = path[i], path[i + 1]\n          target_dir = None\n\n          for idx, direction in enumerate(directions):\n              if (start[0] + direction[0], start[1] + direction[1]) == end:\n                  target_dir = idx\n                  break\n\n          if target_dir != current_dir:\n              if (current_dir - target_dir) % 4 == 1 or (current_dir - target_dir) % 4 == -3:\n                  actions.append(action_specs[\"LEFT\"])\n              elif (current_dir - target_dir) % 4 == 2 or (current_dir - target_dir) % 4 == -2:\n                  actions.append(action_specs[\"LEFT\"])\n                  actions.append(action_specs[\"LEFT\"])\n              else:\n                  actions.append(action_specs[\"RIGHT\"])\n\n              current_dir = target_dir\n\n          actions.append(action_specs[\"USE\"])\n\n      return actions\n\n  primitive_index = env.world.cookbook.index(primitive)\n  path_to_primitive = bfs(env._current_state.pos, primitive_index)\n\n  if not path_to_primitive:\n    return []\n\n  actions = actions_from_path(path_to_primitive)\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:07:03.144787", "function_name": "collect", "function_body": "  # Initialize action list\n  actions = []\n\n  # Get the index of the primitive to collect from the environment's world cookbook.\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the primitive is already in the inventory\n  if env._current_state.inventory[primitive_index] > 0:\n    return actions\n\n  # Define a function to find adjacent cells that contain a given kind index\n  def get_adjacent_cells(pos, i_kind):\n      x, y = pos\n      adjacent_positions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      valid_adjacents = []\n      for ax, ay in adjacent_positions:\n          if 0 <= ax < env.world.scenario.init_grid.shape[0] and 0 <= ay < env.world.scenario.init_grid.shape[1]:\n              if np.any(env._current_state.grid[ax, ay] == i_kind):\n                  valid_adjacents.append((ax, ay))\n      return valid_adjacents\n\n  # Define a function to get the current position of the agent\n  def get_current_position():\n      return env._current_state.pos\n\n  # Get the current position of the agent\n  current_pos = get_current_position()\n\n  # Use BFS to find the shortest path to the primitive\n  queue = collections.deque([current_pos])\n  visited = set()\n  parent_map = {current_pos: None}\n\n  while queue:\n      pos = queue.popleft()\n      if env._current_state.next_to(primitive_index):\n          break\n\n      for next_pos in get_adjacent_cells(pos, primitive_index):\n          if next_pos not in visited:\n              visited.add(next_pos)\n              parent_map[next_pos] = pos\n              queue.append(next_pos)\n\n  # Reconstruct the path from start to goal\n  path = []\n  while pos is not None:\n      path.append(pos)\n      pos = parent_map[pos]\n  path.reverse()\n\n  # Translate path into actions\n  for i in range(len(path) - 1):\n      current_x, current_y = path[i]\n      next_x, next_y = path[i + 1]\n\n      if next_x < current_x:\n          actions.append(env.action_specs()[\"UP\"])\n      elif next_x > current_x:\n          actions.append(env.action_specs()[\"DOWN\"])\n      elif next_y < current_y:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif next_y > current_y:\n          actions.append(env.action_specs()[\"RIGHT\"])\n\n  # Add action to collect the primitive\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T05:08:32.796730", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      direction = 'DOWN'\n    elif delta_y < 0:\n      direction = 'UP'\n    else:\n      direction = None\n\n    if delta_x > 0:\n      direction = 'RIGHT' if direction is None else direction\n    elif delta_x < 0:\n      direction = 'LEFT' if direction is None else direction\n\n    if direction:\n      action = env.action_specs()[direction]\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if grid[nx, ny, env.world.water_index] > 0:\n              if any(inventory[b] > 0 for b in bridge_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after placing the bridge\n            elif grid[nx, ny, env.world.stone_index] > 0:\n              if any(inventory[p] > 0 for p in pickaxe_indices):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after mining the stone\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n    add_move(dx, dy)\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": 2.5}}
