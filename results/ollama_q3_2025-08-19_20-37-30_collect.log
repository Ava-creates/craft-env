{"timestamp": "2025-08-20T12:12:40.856496", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, return the path taken\n          return actions_taken\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action_name, action_idx in action_mapping.items():\n              _, next_state = state.step(action_idx)\n\n              if next_state.next_to(primitive_index):\n                  queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-20T12:12:41.984190", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, return the path taken\n          return actions_taken\n\n      if id(state) not in visited:\n          visited.add(id(state))\n\n          for action_name, action_idx in action_mapping.items():\n              _, next_state = state.step(action_idx)\n\n              if (next_state.inventory[primitive_index] > 0 or \n                  next_state.next_to(primitive_index) and\n                  id(next_state) not in visited):\n                  queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 6, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T12:14:22.387626", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      action = env.action_specs()['DOWN']\n    elif delta_y < 0:\n      action = env.action_specs()['UP']\n    else:\n      action = None\n\n    if delta_x > 0:\n      action = env.action_specs()['RIGHT'] if action is None else action\n    elif delta_x < 0:\n      action = env.action_specs()['LEFT'] if action is None else action\n\n    if action:\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after handling the obstacle\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          actions.append(env.action_specs()['USE'])\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T12:14:23.494231", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(dx, dy):\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = current_x + dx, current_y + dy\n\n    # Determine the direction to move\n    if dy > 0:\n      action = env.action_specs()['DOWN']\n    elif dy < 0:\n      action = env.action_specs()['UP']\n    else:\n      action = None\n\n    if dx > 0:\n      action = env.action_specs()['RIGHT'] if action is None else action\n    elif dx < 0:\n      action = env.action_specs()['LEFT'] if action is None else action\n\n    if action:\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after handling the obstacle\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          actions.append(env.action_specs()['USE'])\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T12:16:48.501305", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Priority queue for A* search with the starting position, direction, inventory, path, and cost.\n  pq = [(0, (current_state.pos, current_state.dir, list(current_state.inventory), []))]\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  while pq:\n      _, (pos, dir, inventory, path) = heapq.heappop(pq)\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, return the path with USE action.\n                          if i_kind == i_primitive:\n                              return path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos = pos\n\n          if action == 0 and pos[1] > 0:           # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1 and pos[1] < grid.shape[1] - 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2 and pos[0] > 0:           # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3 and pos[0] < grid.shape[0] - 1:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          if new_pos not in visited:\n              visited.add(new_pos)\n              cost = len(path) + 1 + manhattan_distance(new_pos, primitive_positions(grid, i_primitive)[0])\n              heapq.heappush(pq, (cost, (new_pos, dir, inventory, path + [action])))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0:\n          return path + [4]\n\n      # Handle tool usage in the environment.\n      new_inventory = list(inventory)\n      for tool_index, tool_count in enumerate(inventory):\n          if tool_count > 0 and tool_index != i_primitive:\n              tool_name = env.world.cookbook.index.get(tool_index)\n\n              # Use BRIDGE to cross WATER\n              if tool_name == \"BRIDGE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"WATER\")] > 0:\n                  new_grid = np.copy(grid)\n                  water_index = env.world.cookbook.index.index(\"WATER\")\n                  new_grid[pos[0], pos[1], water_index] -= 1\n                  new_inventory[tool_index] -= 1\n\n                  cost = len(path) + 1 + manhattan_distance(pos, primitive_positions(new_grid, i_primitive)[0])\n                  heapq.heappush(pq, (cost, (pos, dir, new_inventory, path + [4])))\n\n              # Use PICKAXE to mine GEM\n              elif tool_name == \"PICKAXE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"GEM\")] > 0:\n                  new_grid = np.copy(grid)\n                  gem_index = env.world.cookbook.index.index(\"GEM\")\n                  new_grid[pos[0], pos[1], gem_index] -= 1\n\n                  cost = len(path) + 1 + manhattan_distance(pos, primitive_positions(new_grid, i_primitive)[0])\n                  heapq.heappush(pq, (cost, (pos, dir, inventory, path + [4])))\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-20T12:16:49.557578", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Priority queue for A* search with the starting position, direction, inventory, path, and cost.\n  pq = collections.deque([(0, current_state.pos, current_state.dir, list(current_state.inventory), [])])\n  \n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while pq:\n      _, pos, dir, inventory, path = pq.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # Calculate the cost to move to the new position (manhattan distance + current path length).\n              cost = abs(new_pos[0] - pos[0]) + abs(new_pos[1] - pos[1]) + len(path)\n              \n              # If the state hasn't been visited, add it to the queue with the updated path and cost.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  pq.append((cost, new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n      # Handle tool usage in the environment.\n      for tool_index, tool_count in enumerate(inventory):\n          if tool_count > 0 and tool_index != i_primitive:\n              tool_name = env.world.cookbook.index.get(tool_index)\n              \n              # Use BRIDGE to cross WATER\n              if tool_name == \"BRIDGE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"WATER\")] > 0:\n                  new_grid = np.copy(grid)\n                  new_grid[pos[0], pos[1], env.world.cookbook.index.index(\"WATER\")] -= 1\n                  new_inventory = list(inventory)\n                  new_inventory[tool_index] -= 1\n                  \n                  # Add the state to the queue with the updated grid and inventory.\n                  pq.append((len(path) + 1, pos, dir, new_inventory, path + [4]))\n              \n              # Use PICKAXE to mine GEM\n              elif tool_name == \"PICKAXE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"GEM\")] > 0:\n                  new_grid = np.copy(grid)\n                  new_grid[pos[0], pos[1], env.world.cookbook.index.index(\"GEM\")] -= 1\n                  \n                  # Add the state to the queue with the updated grid.\n                  pq.append((len(path) + 1, pos, dir, inventory, path + [4]))\n\n      # Use tools that can help navigate or collect primitives\n      for tool_index, tool_count in enumerate(inventory):\n          if tool_count > 0 and tool_index != i_primitive:\n              tool_name = env.world.cookbook.index.get(tool_index)\n              \n              if tool_name == \"BRIDGE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"WATER\")] > 0:\n                  new_grid = np.copy(grid)\n                  new_grid[pos[0], pos[1], env.world.cookbook.index.index(\"WATER\")] -= 1\n                  new_inventory = list(inventory)\n                  new_inventory[tool_index] -= 1\n                  \n                  pq.append((len(path) + 1, pos, dir, new_inventory, path + [4]))\n              \n              elif tool_name == \"PICKAXE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"GEM\")] > 0:\n                  new_grid = np.copy(grid)\n                  new_grid[pos[0], pos[1], env.world.cookbook.index.index(\"GEM\")] -= 1\n                  \n                  pq.append((len(path) + 1, pos, dir, inventory, path + [4]))\n              \n              elif tool_name == \"AXE\" and grid[pos[0], pos[1], env.world.cookbook.index.index(\"WOOD\")] > 0:\n                  new_grid = np.copy(grid)\n                  new_grid[pos[0], pos[1], env.world.cookbook.index.index(\"WOOD\")] -= 1\n                  \n                  pq.append((len(path) + 1, pos, dir, inventory, path + [4]))\n\n              elif tool_name == \"HAMMER\" and grid[pos[0], pos[1], env.work.cookbook.index.index(\"STONE\")] > 0:\n                  new_grid = np.copy(grid)\n                  new_grid[pos[0], pos[1], env.world.cookbook.index.index(\"STONE\")] -= 1\n                  \n                  pq.append((len(path) + 1, pos, dir, inventory, path + [4]))\n\n      # Sort paths by length to find the shortest one.\n      if goal_paths:\n          shortest_path = min(goal_paths.values(), key=len)\n          \n          return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-08-20T12:17:26.657548", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, return the path taken\n          return actions_taken\n\n      # Mark this state as visited by using its id\n      visited.add(id(state))\n\n      for action_name, action_idx in action_mapping.items():\n          _, next_state = state.step(action_idx)\n\n          if (next_state.inventory[primitive_index] > 0 or \n              next_state.next_to(primitive_index)) and \\\n             id(next_state) not in visited:\n              queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 6, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T12:17:27.762580", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  # Define action mappings\n  action_mapping = {\n      \"UP\": craft.UP,\n      \"DOWN\": craft.DOWN,\n      \"LEFT\": craft.LEFT,\n      \"RIGHT\": craft.RIGHT,\n      \"USE\": craft.USE\n  }\n\n  # BFS to find the shortest path to collect the primitive\n  while queue:\n      state, actions_taken = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          # If we have collected the primitive, return the path taken\n          return actions_taken\n\n      visited.add(id(state))\n\n      for action_name, action_idx in action_mapping.items():\n          _, next_state = state.step(action_idx)\n\n          if (next_state.inventory[primitive_index] > 0 or \n              next_state.next_to(primitive_index) and\n              id(next_state) not in visited):\n              queue.append((next_state, actions_taken + [action_idx]))\n\n  return []", "island_id": 6, "scores": {"3": 3.0}}
{"timestamp": "2025-08-20T12:19:04.535894", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      action = env.action_specs()['DOWN']\n    elif delta_y < 0:\n      action = env.action_specs()['UP']\n    else:\n      action = None\n\n    if delta_x > 0:\n      action = env.action_specs()['RIGHT'] if action is None else action\n    elif delta_x < 0:\n      action = env.action_specs()['LEFT'] if action is None else action\n\n    if action:\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if grid[nx, ny].sum() > 0 and (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after handling the obstacle\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          actions.append(env.action_specs()['USE'])\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": 2.5}}
{"timestamp": "2025-08-20T12:19:05.674261", "function_name": "collect", "function_body": "  def get_tool_index(tool_name):\n    return env.world.cookbook.index[tool_name]\n\n  # Indices for tools\n  bridge_indices = [get_tool_index('BRIDGE')]\n  pickaxe_indices = [get_tool_index('PICKAXE')]\n\n  actions = []\n\n  def add_move(x, y):\n    current_x, current_y = env._current_state.pos\n    delta_x = x - current_x\n    delta_y = y - current_y\n\n    # Determine the direction to move\n    if delta_y > 0:\n      action = env.action_specs()['DOWN']\n    elif delta_y < 0:\n      action = env.action_specs()['UP']\n    else:\n      action = None\n\n    if delta_x > 0:\n      action = env.action_specs()['RIGHT'] if action is None else action\n    elif delta_x < 0:\n      action = env.action_specs()['LEFT'] if action is None else action\n\n    if action:\n      actions.append(action)\n\n  def find_path(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    inventory = env._current_state.inventory\n\n    # Use BFS to find the shortest path to the primitive\n    queue = collections.deque([(pos, [])])\n    visited = set([pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if grid[x, y, primitive_index] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n\n            # Check for obstacles and tools needed to pass them\n            if handle_obstacles(nx, ny):\n                actions.append(env.action_specs()['USE'])\n                queue.append(((nx, ny), path + [(dx, dy)]))\n                visited.add((nx, ny))  # Mark as visited after handling the obstacle\n            else:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), path + [(dx, dy)]))\n\n    return None\n\n  def handle_obstacles(nx, ny):\n      grid = env._current_state.grid\n      inventory = env._current_state.inventory\n\n      if grid[nx, ny, env.world.water_index] > 0:\n          if any(inventory[b] > 0 for b in bridge_indices):\n              return True\n      elif grid[nx, ny, env.world.stone_index] > 0:\n          if any(inventory[p] > 0 for p in pickaxe_indices):\n              return True\n\n      return False\n\n  # Get the index of the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Find the path to collect the primitive\n  path = find_path(primitive_index)\n  if path is None:\n    return []\n\n  # Add actions to follow the path\n  for dx, dy in path:\n      nx, ny = env._current_state.pos[0] + dx, env._current_state.pos[1] + dy\n\n      # First handle obstacles before moving\n      if handle_obstacles(nx, ny):\n          continue\n\n      add_move(dx, dy)\n\n      # After moving, check again for obstacles (in case of dynamic environment changes)\n      if handle_obstacles(nx, ny):\n          actions.append(env.action_specs()['USE'])\n\n  # Collect the primitive\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
