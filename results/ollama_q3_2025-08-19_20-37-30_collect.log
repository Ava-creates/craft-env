n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T14:08:29.041666", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found, store the path.\n                          if i_kind == i_primitive and (x, y) not in goal_paths:\n                              goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos, new_dir = pos, dir\n\n          # Calculate the new position based on direction.\n          if action == 0:  # UP\n              new_pos = (pos[0], pos[1] - 1)\n          elif action == 1:  # DOWN\n              new_pos = (pos[0], pos[1] + 1)\n          elif action == 2:  # LEFT\n              new_pos = (pos[0] - 1, pos[1])\n          elif action == 3:  # RIGHT\n              new_pos = (pos[0] + 1, pos[1])\n\n          # Check if the new position is within bounds.\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # If the state hasn't been visited, add it to the queue with the updated path.\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  queue.append((new_pos, new_dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T14:09:01.830042", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  while queue:\n      state, path = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          return path\n\n      # Mark the current state as visited by its ID\n      visited.add(id(state))\n\n      for action in range(world.n_actions):\n          reward, next_state = state.step(action)\n\n          # Check if the next state has the primitive or is adjacent to it\n          if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n              return path + [action]\n          else:\n              # Only add unvisited states to the queue\n              if id(next_state) not in visited:\n                  queue.append((next_state, path + [action]))\n\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T14:09:02.906659", "function_name": "collect", "function_body": "  world = env.world\n  scenario = env.scenario\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Get the index for the primitive to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize a queue for BFS and a set to track visited states\n  queue = collections.deque([(current_state, [])])\n  visited = set()\n\n  while queue:\n      state, path = queue.popleft()\n\n      if state.inventory[primitive_index] > 0:\n          return path\n\n      # Mark the current state as visited by its ID\n      visited.add(id(state))\n\n      for action in range(world.n_actions):\n          reward, next_state = state.step(action)\n\n          # Check if the next state has the primitive or is adjacent to it\n          if next_state.inventory[primitive_index] > 0 or next_state.next_to(primitive_index):\n              queue.append((next_state, path + [action]))\n          else:\n              # Only add unvisited states to the queue\n              if id(next_state) not in visited:\n                  queue.append((next_state, path + [action]))\n\n  return []", "island_id": 4, "scores": {"3": 3.4}}
{"timestamp": "2025-08-20T14:10:34.210775", "function_name": "collect", "function_body": "  def is_valid_position(x: int, y: int) -> bool:\n      \"\"\"Check if the position (x, y) is within grid bounds.\"\"\"\n      return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]\n\n  def can_use_tool(inventory: list[int], required_tool_index: int) -> bool:\n      \"\"\"Check if a tool is available in the inventory.\"\"\"\n      return inventory[required_tool_index] > 0\n\n  # Index of the primitive to collect.\n  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n  \n  # Dictionary to map primitives to their required tools (if any).\n  tool_requirements = {\n      \"GOLD\": None, \n      \"GEM\": None,\n      \"WOOD\": None,\n      \"IRON\": None,\n      \"ROCK\": None,\n      \"GRASS\": None,\n      \"BOUNDARY\": None,\n      \"WATER\": None,\n      # Add other primitives and their required tools here\n  }\n  \n  if primitive in tool_requirements:\n      required_tool_index = env.world.cookbook.index.index(tool_requirements[primitive]) if tool_requirements[primitive] else None\n  else:\n      raise ValueError(f\"Primitive '{primitive}' not recognized or no tool requirements specified.\")\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  # Dictionary to map positions where the primitive is found to the path taken.\n  goal_paths = {}\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if is_valid_position(x, y):\n                  # Check each layer to see if it contains the primitive.\n                  for i_kind in range(grid.shape[2]):\n                      if grid[x, y, i_kind] > 0:\n                          # If the primitive is found and meets any tool requirements, store the path.\n                          if i_kind == i_primitive:\n                              if required_tool_index is None or can_use_tool(inventory, required_tool_index):\n                                  goal_paths[(x, y)] = path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos = list(pos)\n          if action == 0:  # UP\n              new_pos[1] -= 1\n          elif action == 1:  # DOWN\n              new_pos[1] += 1\n          elif action == 2:  # LEFT\n              new_pos[0] -= 1\n          elif action == 3:  # RIGHT\n              new_pos[0] += 1\n\n          new_pos = tuple(new_pos)\n\n          if is_valid_position(*new_pos) and (new_pos, dir) not in visited:\n              visited.add((new_pos, dir))\n              queue.append((new_pos, dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          goal_paths[(pos[0], pos[1])] = path + [4]\n\n  # Check if any paths were found to reach the primitive.\n  if goal_paths:\n      # Find the shortest path among all possible paths.\n      shortest_path = min(goal_paths.values(), key=len)\n      \n      return shortest_path\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-20T14:10:35.248252", "function_name": "collect", "function_body": "  def is_valid_position(x: int, y: int) -> bool:\n      \"\"\"Check if the position (x, y) is within grid bounds.\"\"\"\n      return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]\n\n  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get the current state and its grid configuration.\n  current_state = env._current_state\n  grid = current_state.grid\n\n  # Initialize a queue for BFS with the starting position, direction, inventory, and path.\n  queue = collections.deque([(current_state.pos, current_state.dir, list(current_state.inventory), [])])\n\n  # Set to keep track of visited states (position + direction).\n  visited = set()\n  visited.add((current_state.pos, current_state.dir))\n\n  while queue:\n      pos, dir, inventory, path = queue.popleft()\n\n      # Check if the primitive is in the current position or nearby.\n      for dx in range(-1, 2):\n          for dy in range(-1, 2):\n              x, y = pos[0] + dx, pos[1] + dy\n              if is_valid_position(x, y) and grid[x, y, i_primitive] > 0:\n                  # If the primitive is found, return the path to collect it.\n                  return path + [4]\n\n      # Generate possible actions: UP, DOWN, LEFT, RIGHT\n      for action in range(4):  # Assuming 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n          new_pos = list(pos)\n          if action == 0:  # UP\n              new_pos[1] -= 1\n          elif action == 1:  # DOWN\n              new_pos[1] += 1\n          elif action == 2:  # LEFT\n              new_pos[0] -= 1\n          elif action == 3:  # RIGHT\n              new_pos[0] += 1\n\n          new_pos = tuple(new_pos)\n\n          if is_valid_position(*new_pos) and (new_pos, dir) not in visited:\n              visited.add((new_pos, dir))\n              queue.append((new_pos, dir, list(inventory), path + [action]))\n\n      # Check for USE action to collect the primitive at the current position\n      if grid[pos[0], pos[1], i_primitive] > 0 and inventory[i_primitive] == 0:\n          return path + [4]\n\n  # If no path was found, return an empty list.\n  return []", "island_id": 6, "scores": {"3": 2.0}}
