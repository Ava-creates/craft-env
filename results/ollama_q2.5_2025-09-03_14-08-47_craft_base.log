{"timestamp": "2025-09-03T22:49:11.756883", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop that can be used to craft this item\n  # This is a simplified assumption, in reality we would need to check which workshops are available and which can craft the item.\n  actions = []\n  \n  for workshop_idx in env.world.workshop_indices:\n      if env._current_state.next_to(workshop_idx):\n          # Move towards the workshop\n          actions.extend(move_to_workshop(env._current_state, workshop_idx))\n          \n          # Use the workshop to craft the item\n          actions.append(env.world.cookbook.index[\"USE\"])\n          break\n  \n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:49:57.857882", "function_name": "craft", "function_body": "  def find_workshop_for_item(item):\n    # Find the workshop needed for crafting the item\n    cookbook = env.world.cookbook.recipes\n    item_index = env.world.cookbook.index[item]\n    \n    # Check each recipe to see if it requires a specific workshop\n    for output, ingredients in cookbook.items():\n      if output == item_index:\n        for ingredient, count in ingredients.items():\n          if \"workshop\" in env.world.cookbook.index.get(ingredient, \"\").lower():\n            return ingredient\n    \n    # If no specific workshop is required, return None\n    return None\n\n  def move_to_workshop(workshop_index):\n      # Find the position of the workshop in the grid\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if positions.size == 0:\n          raise ValueError(f\"No workshop found for index {workshop_index}\")\n      \n      # Choose the nearest workshop\n      pos = env._current_state.pos\n      distances = np.linalg.norm(positions - pos, axis=1)\n      target_pos = tuple(positions[np.argmin(distances)][::-1])\n      \n      # Generate actions to move towards the workshop\n      actions = []\n      while env._current_state.pos != target_pos:\n          dx, dy = target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1]\n          \n          if abs(dx) > abs(dy):\n              action = 2 if dx < 0 else 3\n          else:\n              action = 0 if dy < 0 else 1\n          \n          actions.append(action)\n          # Update the state after each action (this is a simplified version; in reality, you would need to handle collisions and other game mechanics)\n          env.step(action, num_steps=1)\n      \n      return actions\n\n  def perform_craft_action():\n      # After reaching the workshop, perform the USE action to craft the item\n      return [4]\n\n  # Main logic\n  workshop_index = find_workshop_for_item(item)\n  \n  if workshop_index is not None:\n      move_actions = move_to_workshop(workshop_index)\n      craft_actions = perform_craft_action()\n      return move_actions + craft_actions\n  \n  else:\n      raise ValueError(f\"No workshop found for item {item}\")", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T22:49:59.764192", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n  \n  # Check which workshop is required to craft the item (if any)\n  workshops_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n  \n  if workshops_needed:\n    # Choose the first available workshop\n    workshop_index = workshops_needed[0]\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for {item}\")\n      \n    target_position = workshop_positions[0]\n    \n    # Move to the workshop\n    current_pos = env._current_state.pos\n    actions.extend(move_to(env, current_pos, target_position))\n    \n    # Perform the USE action at the workshop\n    actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:51:15.233796", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos, workshop_indices):\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    for workshop_index in workshop_indices:\n        workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n        for wp in workshop_positions:\n            distance = (wp[0] - pos[0]) ** 2 + (wp[1] - pos[1]) ** 2\n            if distance < min_distance:\n                min_distance = distance\n                closest_workshop_pos = tuple(wp)\n    return closest_workshop_pos\n\n  cookbook = env.world.cookbook\n\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n  \n  workshop_types_required = set()\n\n  # Determine which workshops are needed based on the ingredients\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          if ingredient in cookbook.primitives or ingredient in cookbook.environment:\n              continue\n\n          # Find the workshop required for the intermediate item\n          for w in env.world.workshop_indices:\n              workshop_index = w\n              workshop_recipe = cookbook.recipes.get(workshop_index, None)\n              if workshop_recipe and any(ingredient == i for i in workshop_recipe.values()):\n                  workshop_types_required.add(workshop_index)\n\n  # Navigate to the required workshops and craft items\n\n  actions = []\n  visited_workshops = set()\n  \n  while len(workshop_types_required) > 0:\n      workshop_type = workshop_types_required.pop()\n\n      if workshop_type not in visited_workshops:\n          # Find a position next to the workshop\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n\n          closest_workshop_pos = find_closest_workshop(grid, pos, [workshop_type])\n\n          if closest_workshop_pos is None:\n              raise ValueError(f\"No workshop found for item '{item}'.\")\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, closest_workshop_pos))\n          visited_workshops.add(workshop_type)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n      _, done, _ = env.step(actions[-1])\n      if done:\n          break\n\n      env._current_state = env.world.current_state\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:51:17.106810", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n\n  workshop_types_required = set()\n\n  # Determine which workshops are needed based on the ingredients\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          if ingredient in cookbook.primitives or ingredient in cookbook.environment:\n              continue\n\n          # Find the workshop required for the intermediate item\n          for w in env.world.workshop_indices:\n              workshop_index = w\n              workshop_recipe = cookbook.recipes.get(workshop_index, None)\n              if workshop_recipe and any(ingredient == i for i in workshop_recipe.values()):\n                  workshop_types_required.add(workshop_index)\n\n  actions = []\n  visited_workshops = set()\n\n  # Function to find the closest unvisited workshop of a specific type\n  def find_closest_unvisited_workshop(grid, pos, workshop_type):\n      workshop_positions = np.argwhere(grid[:, :, workshop_type] > 0)\n      for wp in workshop_positions:\n          if tuple(wp) not in visited_workshops:\n              return tuple(wp)\n      return None\n\n  # Navigate to each required workshop and perform the USE action\n  while len(workshop_types_required) > 0:\n      workshop_type = next(iter(workshop_types_required))\n      workshop_types_required.remove(workshop_type)\n\n      closest_workshop_pos = find_closest_unvisited_workshop(env._current_state.grid, env._current_state.pos, workshop_type)\n      \n      if closest_workshop_pos is None:\n          raise ValueError(f\"No unvisited workshop found for item '{item}'.\")\n\n      actions.extend(navigate_to(env._current_state, closest_workshop_pos))\n      visited_workshops.add(closest_workshop_pos)\n\n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:52:43.558105", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Determine the workshop type required by looking at the recipe's key\n  workshop_type_key = \"_key\" in env.world.cookbook.recipes[item_idx]\n  if workshop_type_key:\n      workshop_type = env.world.cookbook.recipes[item_idx][\"_key\"]\n  else:\n      # If no specific workshop is needed, use a default (e.g., WORKSHOP0)\n      workshop_type = \"WORKSHOP0\"\n  \n  # Get the index for the workshop type\n  workshop_idx = env.world.cookbook.index[workshop_type]\n  \n  # Determine if we need to go to a workshop\n  if workshop_idx in env.world.workshop_indices:\n    # Find positions of all workshops of the required type on the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n    \n    # If there are no available workshops, return an empty list (or raise an error)\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No available {workshop_type} on the grid.\")\n    \n    # Choose the closest workshop\n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n    closest_workshop_idx = np.argmin(distances)\n    closest_workshop = tuple(workshop_positions[closest_workshop_idx])\n  else:\n    # If no workshop is required, we can proceed to use the action at the current position\n    closest_workshop = env._current_state.pos\n  \n  # Calculate the movements needed to reach the closest workshop\n  actions_to_take = []\n  delta_x = closest_workshop[0] - current_pos[0]\n  delta_y = closest_workshop[1] - current_pos[1]\n  \n  if delta_x > 0:\n    actions_to_take.extend([env.world.N_RIGHT] * abs(delta_x))\n  elif delta_x < 0:\n    actions_to_take.extend([env.world.N_LEFT] * abs(delta_x))\n  \n  if delta_y > 0:\n    actions_to_take.extend([env.world.N_DOWN] * abs(delta_y))\n  elif delta_y < 0:\n    actions_to_take.extend([env.world.N_UP] * abs(delta_y))\n  \n  # Once at the workshop, perform the USE action to craft the item\n  actions_to_take.append(env.world.USE)\n  \n  return actions_to_take", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T22:52:45.688150", "function_name": "craft", "function_body": "  # Accessing the required data from the environment\n  cookbook = env.world.cookbook\n  \n  # Getting the index of the item to be crafted\n  item_idx = cookbook.index[item]\n  \n  # Check if there is a recipe for this item in the cookbook\n  if item_idx not in cookbook.recipes:\n    raise ValueError(f\"No recipe available for {item}\")\n\n  # Determine the workshop needed to craft the item\n  workshop_types = set([env.world.workshop_indices[0], env.world.workshop_indices[1], env.world.workshop_indices[2]])\n  \n  # Find a suitable workshop on the grid that is close enough to the agent's position\n  workshops = np.argwhere(np.any(env._current_state.grid[:, :, list(workshop_types)], axis=2))\n  if not workshops.size:\n    raise ValueError(\"No available workshop found.\")\n\n  # Calculate distances from the current position to each workshop and find the nearest one\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(agent_pos - workshops, axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop = tuple(workshops[nearest_workshop_idx])\n  \n  # Generate actions to move the agent to the nearest workshop\n  move_actions = []\n  while env._current_state.pos != nearest_workshop:\n    target_pos = np.array(nearest_workshop)\n    delta = target_pos - np.array(env._current_state.pos)\n    \n    if delta[0] > 0:\n      move_actions.append(craft.ACTIONS['RIGHT'])\n    elif delta[0] < 0:\n      move_actions.append(craft.ACTIONS['LEFT'])\n    elif delta[1] > 0:\n      move_actions.append(craft.ACTIONS['DOWN'])\n    else:\n      move_actions.append(craft.ACTIONS['UP'])\n\n    # Step the environment with each move action to update the agent's position\n    for move_action in move_actions:\n      _, done, _ = env.step(move_action)\n      if done:\n        break\n\n  # Once at the workshop, use the USE action to craft the item\n  use_action = craft.ACTIONS['USE']\n  move_actions.append(use_action)\n\n  return move_actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T22:53:48.954096", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Get all workshops that are part of the recipe requirements (if any)\n  workshop_indices_needed = [workshop_idx for workshop_idx in env.world.workshop_indices if workshop_idx in recipe]\n  \n  # If there are workshops needed, find the positions and move to one of them\n  if workshop_indices_needed:\n      # Choose the first available workshop\n      workshop_index = workshop_indices_needed[0]\n\n      # Find the position(s) of the chosen workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for {item}\")\n          \n      target_position = workshop_positions[0]\n      \n      # Move to the workshop\n      current_pos = env._current_state.pos\n      actions.extend(move_to(env, current_pos, target_position))\n      \n      # Perform the USE action at the workshop\n      actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:53:50.811626", "function_name": "craft", "function_body": "  # Fetch the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check which workshops are required to craft the item (if any)\n  workshops_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n\n  if workshops_needed:\n    # Choose the first available workshop\n    workshop_index = workshops_needed[0]\n    \n    # Locate the positions of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for {item}\")\n\n    target_position = workshop_positions[0]\n    \n    # Move to the workshop\n    current_pos = env._current_state.pos\n    actions.extend(move_to(env, current_pos, target_position))\n    \n    # Perform the USE action at the workshop\n    actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:56:32.302986", "function_name": "craft", "function_body": "  def navigate_to(state, target_pos):\n    x_diff = target_pos[1] - state.pos[1]\n    y_diff = target_pos[0] - state.pos[0]\n    \n    actions = []\n    if y_diff > 0:\n        actions.extend([env.world.N_DOWN] * y_diff)\n    elif y_diff < 0:\n        actions.extend([env.world.N_UP] * abs(y_diff))\n    \n    if x_diff > 0:\n        actions.extend([env.world.N_RIGHT] * x_diff)\n    elif x_diff < 0:\n        actions.extend([env.world.N_LEFT] * abs(x_diff))\n    \n    return actions\n\n  def get_workshops_for_ingredient(ingredient_index, cookbook):\n      workshops = []\n      for workshop in env.world.workshop_indices:\n          recipe = cookbook.recipes.get(workshop)\n          if recipe and ingredient_index in recipe:\n              workshops.append(workshop)\n      return workshops\n  \n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n\n  # Step 1: Determine which primitives are needed and how many of each\n  required_primitives = {k: v for k, v in recipe.items() if k != \"_key\" and int(k) in cookbook.primitives}\n\n  # Step 2: Check inventory to see what is already available\n  available_inventory = env._current_state.features_dict['inventory']\n\n  actions = []\n\n  # Step 3: Collect missing primitives\n  for primitive, required_amount in required_primitives.items():\n      available_amount = available_inventory.get(primitive, 0)\n      if available_amount < required_amount:\n          amount_to_collect = required_amount - available_amount\n          actions.extend(collect_v2(env, cookbook.index[primitive], amount=amount_to_collect))\n\n  # Step 4: Navigate to the required workshops and craft items\n  visited_workshops = set()\n  \n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          ingredient_index = int(ingredient)\n          \n          # Skip primitives as they are already collected\n          if ingredient_index in cookbook.primitives:\n              continue\n\n          # Determine which workshop is needed for the intermediate item\n          workshops = get_workshops_for_ingredient(ingredient_index, cookbook)\n\n          if not workshops:\n              raise ValueError(f\"No workshop found for ingredient '{ingredient}'.\")\n\n          # Navigate to a nearby workshop that can create the ingredient\n          selected_workshop = min(workshops, key=lambda w: len(navigate_to(env._current_state, np.argwhere(env._current_state.grid[:, :, w] > 0)[0])))\n          if selected_workshop not in visited_workshops:\n              target_pos = np.argwhere(env._current_state.grid[:, :, selected_workshop] > 0)[0]\n              actions.extend(navigate_to(env._current_state, tuple(target_pos)))\n              visited_workshops.add(selected_workshop)\n          \n          # Craft the intermediate item\n          actions.append(4)  # Assuming USE is mapped to 4\n\n  # Step 5: Navigate to the final workshop and craft the desired item\n  target_workshop = None\n  for workshop in env.world.workshop_indices:\n      if item_index in cookbook.recipes.get(workshop, {}).values():\n          target_workshop = workshop\n          break\n\n  if not target_workshop:\n      raise ValueError(f\"No workshop found to create '{item}'.\")\n\n  final_target_pos = np.argwhere(env._current_state.grid[:, :, target_workshop] > 0)[0]\n  actions.extend(navigate_to(env._current_state, tuple(final_target_pos)))\n\n  # Craft the final item\n  actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-03T22:56:34.439758", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n\n  # Determine which workshops are needed based on the ingredients\n  workshop_types_required = set()\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          ingredient_index = int(ingredient) if isinstance(ingredient, str) and ingredient.isdigit() else cookbook.index[ingredient]\n          if ingredient_index not in cookbook.primitives and ingredient_index not in cookbook.environment:\n              # Find the workshop required for the intermediate item\n              for w in env.world.workshop_indices:\n                  workshop_recipe = cookbook.recipes.get(w, None)\n                  if workshop_recipe and any(ingredient_index in w_r.keys() for w_r in workshop_recipe.values()):\n                      workshop_types_required.add(w)\n\n  actions = []\n\n  # Step 1: Craft intermediate items\n  visited_workshops = set()\n  \n  while len(workshop_types_required) > 0:\n      workshop_type = workshop_types_required.pop()\n\n      if workshop_type not in visited_workshops:\n          # Navigate to the nearest available workshop of the required type\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(grid[:, :, workshop_type] > 0)\n\n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop found for item '{item}'.\")\n\n          closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - pos[0]) ** 2 + (x[1] - pos[1]) ** 2)\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, tuple(closest_workshop_pos)))\n          visited_workshops.add(workshop_type)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  # Step 2: Craft the final item\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  # Find positions of all workshops that can create the desired item\n  workshop_positions = []\n  for w in env.world.workshop_indices:\n      if item_index in cookbook.recipes.get(w, {}).keys():\n          workshop_positions.extend(np.argwhere(grid[:, :, w] > 0))\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found that can create '{item}'.\")\n\n  closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - pos[0]) ** 2 + (x[1] - pos[1]) ** 2)\n\n  # Generate actions to move towards the closest workshop\n  actions.extend(navigate_to(env._current_state, tuple(closest_workshop_pos)))\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-03T22:59:37.339855", "function_name": "craft", "function_body": "  def navigate_to(state, target_pos):\n    x_diff = target_pos[0] - state.pos[0]\n    y_diff = target_pos[1] - state.pos[1]\n\n    actions = []\n\n    # Move horizontally\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    # Move vertically\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def find_workshop_for_item(cookbook, item_index):\n      for workshop_index in env.world.workshop_indices:\n          workshop_recipe = cookbook.recipes.get(workshop_index, {})\n          if workshop_recipe and any(item_index == w_r for w_r in workshop_recipe.values()):\n              return workshop_index\n      return None\n\n  def find_closest_workshop(grid, current_pos, workshop_index):\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for item '{item}'.\")\n      \n      closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - current_pos[0]) ** 2 + (x[1] - current_pos[1]) ** 2)\n      return tuple(closest_workshop_pos)\n\n  def gather_primitives(env, primitives):\n    actions = []\n    for primitive in primitives:\n        # Find the positions of the primitive on the grid\n        primitive_index = env.world.cookbook.index[primitive]\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n        \n        if len(primitive_positions) == 0:\n            raise ValueError(f\"No {primitive} found on the map.\")\n        \n        closest_primitive_pos = min(primitive_positions, key=lambda x: (x[0] - env._current_state.pos[0]) ** 2 + (x[1] - env._current_state.pos[1]) ** 2)\n        \n        # Navigate to the closest primitive\n        actions.extend(navigate_to(env._current_state, tuple(closest_primitive_pos)))\n        \n        # Collect the primitive by performing the USE action\n        actions.append(4)  # Assuming USE is mapped to 4\n    \n    return actions\n\n  cookbook = env.world.cookbook\n\n  if item not in cookbook.index:\n      raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for '{item}'.\")\n  \n  # Step 1: Gather required primitives\n  primitives_required = set()\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\" and ingredient in cookbook.primitives:\n          primitives_required.add(ingredient)\n  \n  actions = gather_primitives(env, primitives_required)\n\n  # Step 2: Determine which workshops are needed based on the ingredients\n  workshop_indices_required = set()\n\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          ingredient_index = cookbook.index[ingredient]\n          workshop_index = find_workshop_for_item(cookbook, ingredient_index)\n          \n          if workshop_index:\n              workshop_indices_required.add(workshop_index)\n\n  # Step 3: Navigate to the required workshops and craft items\n  visited_workshops = set()\n  \n  for workshop_type in workshop_indices_required:\n      if workshop_type not in visited_workshops:\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n\n          closest_workshop_pos = find_closest_workshop(grid, pos, workshop_type)\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, closest_workshop_pos))\n          visited_workshops.add(workshop_type)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T22:59:39.238796", "function_name": "craft", "function_body": "  def navigate_to(state, target_pos):\n    x_diff = target_pos[0] - state.pos[0]\n    y_diff = target_pos[1] - state.pos[1]\n\n    actions = []\n\n    # Move horizontally\n    if x_diff > 0:\n        actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n        actions.extend([2] * abs(x_diff))  # LEFT\n\n    # Move vertically\n    if y_diff > 0:\n        actions.extend([1] * abs(y_diff))  # UP\n    elif y_diff < 0:\n        actions.extend([0] * abs(y_diff))  # DOWN\n    \n    return actions\n\n  def find_workshop_for_item(cookbook, item_index):\n      for workshop_index in env.world.workshop_indices:\n          workshop_recipe = cookbook.recipes.get(workshop_index, {})\n          if workshop_recipe and any(item_index == w_r for w_r in workshop_recipe.values()):\n              return workshop_index\n      return None\n\n  def find_closest_workshop(grid, current_pos, workshop_index):\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for item '{item}'.\")\n      \n      closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - current_pos[0]) ** 2 + (x[1] - current_pos[1]) ** 2)\n      return tuple(closest_workshop_pos)\n\n  def gather_primitives(env, primitives):\n    actions = []\n    for primitive in primitives:\n        if env._current_state.inventory.get(primitive, 0) == 0:  # If the primitive is not in inventory\n            grid = env._current_state.grid\n            pos = env._current_state.pos\n\n            closest_primitive_pos = find_closest_resource(grid, pos, primitive)\n\n            # Generate actions to move towards the closest resource\n            actions.extend(navigate_to(env._current_state, closest_primitive_pos))\n            \n            # Collect the resource\n            actions.append(COLLECT_FUNC)  # Assuming COLLECT is mapped to some action index\n            \n    return actions\n\n  def find_closest_resource(grid, current_pos, primitive_index):\n      resource_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n      if len(resource_positions) == 0:\n          raise ValueError(f\"No {env.world.cookbook.index[primitive_index]} found.\")\n      \n      closest_resource_pos = min(resource_positions, key=lambda x: (x[0] - current_pos[0]) ** 2 + (x[1] - current_pos[1]) ** 2)\n      return tuple(closest_resource_pos)\n\n  cookbook = env.world.cookbook\n\n  if item not in cookbook.index:\n      raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for '{item}'.\")\n  \n  # Step 1: Gather primitives required for crafting\n  primitives_required = [ingredient for ingredient in recipe.keys() if ingredient != \"_key\"]\n  gather_actions = gather_primitives(env, primitives_required)\n  \n  # Step 2: Determine which workshops are needed based on the ingredients\n  workshop_indices_required = set()\n\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          ingredient_index = cookbook.index[ingredient]\n          workshop_index = find_workshop_for_item(cookbook, ingredient_index)\n          \n          if workshop_index:\n              workshop_indices_required.add(workshop_index)\n\n  # Step 3: Navigate to the required workshops and craft items\n  actions = []\n  visited_workshops = set()\n  \n  for workshop_type in workshop_indices_required:\n      if workshop_type not in visited_workshops:\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n\n          closest_workshop_pos = find_closest_workshop(grid, pos, workshop_type)\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, closest_workshop_pos))\n          visited_workshops.add(workshop_type)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  return gather_actions + actions", "island_id": 0, "scores": {"": -1}}
