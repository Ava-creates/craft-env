{"timestamp": "2025-09-03T20:13:13.061507", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe found for {item}.\")\n    return []\n\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  current_inventory = env._current_state.inventory\n  \n  missing_ingredients = {ingredient: count - current_inventory[ingredient] \n                         for ingredient, count in ingredients_required.items()\n                         if current_inventory[ingredient] < count}\n  \n  # If we have all required ingredients, proceed to crafting\n  if not missing_ingredients:\n    return craft_v0(env, item)\n\n  actions = []\n  # Collect missing ingredients and attempt crafting again after collection\n  for ingredient_index, amount in missing_ingredients.items():\n      ingredient_name = env.world.cookbook.index.get(ingredient_index, None)\n      if ingredient_name is None:\n          print(f\"Ingredient index {ingredient_index} does not have a corresponding name.\")\n          continue\n      \n      # Collect the required amount of the ingredient\n      collect_actions = collect_v0(env, ingredient_name)\n      \n      if len(collect_actions) == 0:\n          print(f\"No way to collect {ingredient_name}.\")\n          return []\n      \n      actions.extend(collect_actions)\n  \n  # After collecting all missing ingredients, try crafting again\n  actions.extend(craft_v0(env, item))\n  \n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T20:13:15.119526", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    neighbors = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # up, down, left, right\n    close_set = set()\n    came_from = {}\n    gscore = {start: 0}\n    fscore = {start: heuristic(start, goal)}\n    oheap = []\n    heapq.heappush(oheap, (fscore[start], start))\n    \n    while oheap:\n      current = heapq.heappop(oheap)[1]\n      \n      if current == goal:\n        data = []\n        while current in came_from:\n          data.append(current)\n          current = came_from[current]\n        data.reverse()\n        return [action_to_index(grid, pos) for pos in data[1:]]  # Skip the starting position\n        \n      close_set.add(current)\n      for i, j in neighbors:\n        neighbor = current[0] + i, current[1] + j\n        tentative_g_score = gscore[current] + 1\n        if 0 <= neighbor[0] < grid.shape[0]:\n          if 0 <= neighbor[1] < grid.shape[1]:                        \n            pass\n          else:\n            continue\n        elif 0 <= neighbor[1] < grid.shape[1]:\n          continue\n        else:\n          continue\n        \n        if grid[neighbor] > 0 and neighbor in close_set:\n          continue\n        elif neighbor not in [i[1]for i in oheap]:\n          came_from[neighbor] = current\n          gscore[neighbor] = tentative_g_score\n          fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          heapq.heappush(oheap, (fscore[neighbor], neighbor))\n        elif tentative_g_score < gscore[neighbor]:\n          came_from[neighbor] = current\n          gscore[neighbor] = tentative_g_score\n          fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          \n    return []\n  \n  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n  \n  def action_to_index(grid, pos):\n    current_pos = env._current_state.pos\n    direction = env._current_state.dir\n    \n    # Define actions based on direction\n    actions = {\n        (0, -1): craft.DIR_DOWN,\n        (0, 1): craft.DIR_UP,\n        (-1, 0): craft.DIR_LEFT,\n        (1, 0): craft.DIR_RIGHT\n    }\n    \n    # Calculate relative position to current agent position\n    delta = (pos[0] - current_pos[0], pos[1] - current_pos[1])\n    \n    # Check if the direction is valid and return corresponding action index\n    for key in actions:\n        if delta == key:\n            # If the direction is directly facing the target, use 'USE'\n            if env._current_state.grid[pos] > 0 and env._current_state.next_to(grid[pos]):\n                return craft.USE_ACTION\n            else:\n                return actions[key]\n    \n    # Default to no action (shouldn't reach here with proper pathing)\n    return -1\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Check if there's a recipe for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Extract workshop key and required ingredients from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  # Check inventory to ensure all required ingredients are available\n  current_inventory = env._current_state.inventory\n  for ingredient, count in ingredients_required.items():\n    if current_inventory[ingredient] < count:\n      return []\n  \n  # Determine the workshop index based on the recipe's key\n  if workshop_key is None:\n    # If no specific workshop type required, use any available workshop\n    workshop_index = env.world.workshop_indices[0]\n  else:\n    # Otherwise, select the specified workshop type\n    workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n    \n    # Validate that the selected workshop index is valid and exists in the world\n    if workshop_index is None or workshop_index not in env.world.workshop_indices:\n      return []\n  \n  # Find all positions of the required workshop type on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops are found, return an empty action list\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Identify the closest workshop based on Manhattan distance from the agent's current position\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Generate actions to navigate the agent to the closest workshop using A* search for better efficiency\n  path_to_workshop = a_star_search(env._current_state.grid, tuple(env._current_state.pos), tuple(closest_workshop))\n  \n  return path_to_workshop", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T20:16:02.720306", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor].sum() > 0:  # Assuming any sum greater than 0 represents an obstacle\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - current[0], step[1] - current[1]) for step in path_to_workshop for current in path_to_workshop if current != step]\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T20:16:04.874226", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              # Check for obstacles\n              if np.any(grid[neighbor[0], neighbor[1]] == 1):\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  if not path_to_workshop:\n      return []\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - prev_step[0], step[1] - prev_step[1]) for prev_step, step in zip(path_to_workshop[:-1], path_to_workshop[1:])]\n  \n  # Add USE action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T20:17:45.011080", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n  \n  workshop_types_required = set()\n\n  # Determine which workshops are needed based on the ingredients\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          if ingredient in cookbook.primitives or ingredient in cookbook.environment:\n              continue\n\n          # Find the workshop required for the intermediate item\n          for w in env.world.workshop_indices:\n              workshop_index = w\n              workshop_recipe = cookbook.recipes.get(workshop_index, None)\n              if workshop_recipe and any(ingredient in w_r.keys() for w_r in workshop_recipe.values()):\n                  workshop_types_required.add(workshop_index)\n\n  # Step 2: Navigate to the required workshops and craft items\n\n  actions = []\n  visited_workshops = set()\n  \n  def navigate_to(state, target_pos):\n      current_pos = state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      if relative_y > 0:\n          actions.extend([env.world.N_DOWN] * relative_y)\n      elif relative_y < 0:\n          actions.extend([env.world.N_UP] * abs(relative_y))\n      \n      if relative_x > 0:\n          actions.extend([env.world.N_RIGHT] * relative_x)\n      elif relative_x < 0:\n          actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  for workshop_type in workshop_types_required:\n      if workshop_type not in visited_workshops:\n          # Find a position next to the workshop\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n          dir = env._current_state.dir\n\n          # Navigate towards the nearest available workshop of the required type\n          workshop_positions = np.argwhere(grid[:, :, workshop_type] > 0)\n\n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop found for item '{item}'.\")\n\n          closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - pos[0]) ** 2 + (x[1] - pos[1]) ** 2)\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, tuple(closest_workshop_pos)))\n          visited_workshops.add(workshop_type)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T20:17:47.102305", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n\n  # Determine which workshops are needed based on the ingredients\n  workshop_indices_needed = []\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          if ingredient in cookbook.primitives or ingredient in cookbook.environment:\n              continue\n\n          # Find the workshop required for the intermediate item\n          for w in world.workshop_indices:\n              workshop_index = w\n              workshop_recipe = cookbook.recipes.get(workshop_index, None)\n              if workshop_recipe and any(ingredient == i for i in workshop_recipe.values()):\n                  workshop_indices_needed.append(workshop_index)\n\n  # Navigate to the required workshops and craft items\n\n  actions = []\n  visited_workshops = set()\n  \n  for workshop_index in workshop_indices_needed:\n      if workshop_index not in visited_workshops:\n          # Find a position next to the workshop\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n          dir = env._current_state.dir\n\n          # Navigate towards the nearest available workshop of the required type\n          workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop found for item '{item}'.\")\n\n          closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - pos[0]) ** 2 + (x[1] - pos[1]) ** 2)\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, tuple(closest_workshop_pos)))\n          visited_workshops.add(workshop_index)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(world.N_USE)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T20:19:16.133118", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.index(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Check if the recipe exists and get it\n  recipe = env.world.cookbook.recipes.get(index, {})\n  if not recipe:\n      print(f\"No recipe for item {item}.\")\n      return []\n\n  # Find the workshop(s) that can make this item (assuming there is only one such workshop)\n  workshop_indices = [idx for idx in env.world.workshop_indices \n                      if any(ingredient in recipe.keys() \n                           for ingredient in env.world.cookbook.primitives_for(index).keys())]\n  \n  # If no suitable workshops are found, return an empty list\n  if not workshop_indices:\n      print(f\"No suitable workshops found to craft {item}.\")\n      return []\n\n  # Get all positions of the workshops on the grid\n  workshop_positions = []\n  for workshop_index in workshop_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      workshop_positions.extend(positions)\n\n  # If no workshops are found, return an empty list\n  if not workshop_positions:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  # Move horizontally first (LEFT or RIGHT)\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  # Then move vertically (UP or DOWN)\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Ensure the agent is facing the workshop before using\n  current_direction = env._current_state.dir\n  target_direction = np.arctan2(delta_y, delta_x) * 180 / np.pi\n\n  if -45 <= target_direction < 45 or 315 <= target_direction < 360:\n      actions_to_workshop.append(env.action_specs()['RIGHT'])\n  elif 45 <= target_direction < 135:\n      actions_to_workshop.append(env.action_specs()['UP'])\n  elif 135 <= target_direction < 225:\n      actions_to_workshop.append(env.action_specs()['LEFT'])\n  elif 225 <= target_direction < 315:\n      actions_to_workshop.append(env.action_specs()['DOWN'])\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.5}}
