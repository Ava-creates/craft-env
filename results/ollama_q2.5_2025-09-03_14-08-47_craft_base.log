s, current_x, current_y)\n\n  # Determine the path to the chosen workshop\n  target_x, target_y = closest_workshop\n\n  # Move in the x-direction first (LEFT or RIGHT)\n  while current_x < target_x:\n      actions.append(3)  # RIGHT\n      current_x += 1\n  while current_x > target_x:\n      actions.append(2)  # LEFT\n      current_x -= 1\n\n  # Then move in the y-direction (UP or DOWN)\n  while current_y < target_y:\n      actions.append(1)  # UP\n      current_y += 1\n  while current_y > target_y:\n      actions.append(0)  # DOWN\n      current_y -= 1\n\n  # Finally, perform the USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:53:25.025333", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    delta_x = target_pos[1] - current_pos[1]\n    delta_y = target_pos[0] - current_pos[0]\n\n    actions = []\n    \n    # Move in the y-direction first\n    if delta_y > 0:\n        actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n    elif delta_y < 0:\n        actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n    # Then move in the x-direction\n    if delta_x > 0:\n        actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n    elif delta_x < 0:\n        actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n    \n    return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      distances = np.sqrt((workshop_positions[:, 0] - current_pos[0])**2 + (workshop_positions[:, 1] - current_pos[1])**2)\n      closest_index = np.argmin(distances)\n      return tuple(workshop_positions[closest_index])\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Check which workshop is required to craft this item\n    # For simplicity, let's assume there's only one type of workshop needed\n    workshop_index = next(iter(env.world.workshop_indices))\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n    # Get the closest workshop from available workshops\n    workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:53:26.912400", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    delta_x = target_pos[1] - current_pos[1]\n    delta_y = target_pos[0] - current_pos[0]\n\n    actions = []\n    \n    # Determine the direction to move based on the shortest path\n    if abs(delta_x) > abs(delta_y):\n        if delta_x > 0:\n            actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n        elif delta_x < 0:\n            actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n        # Then move in the y-direction\n        if delta_y > 0:\n            actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n        elif delta_y < 0:\n            actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n    else:\n        if delta_y > 0:\n            actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n        elif delta_y < 0:\n            actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n        # Then move in the x-direction\n        if delta_x > 0:\n            actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n        elif delta_x < 0:\n            actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n    \n    return actions\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Check which workshop is required to craft this item\n    # For simplicity, let's assume there's only one type of workshop needed\n    workshop_index = next(iter(env.world.workshop_indices))\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n    # Get a random position from the available workshops\n    workshop_pos = tuple(workshop_positions[0])\n\n    # Calculate relative direction and distance to the workshop\n    current_pos = env._current_state.pos\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:55:00.138819", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      \n      # Determine the direction to move\n      if delta_y > 0:\n          actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n      elif delta_y < 0:\n          actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n      if delta_x > 0:\n          actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n      elif delta_x < 0:\n          actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n      \n      return actions\n  \n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, pos)\n      \n      return closest_workshop\n\n  def check_inventory(env, recipe):\n      # Assuming the inventory is part of the current state and can be accessed as a dictionary\n      inventory = env._current_state.inventory\n      \n      for ingredient, amount in recipe.items():\n          if ingredient not in inventory or inventory[ingredient] < amount:\n              return False\n      return True\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Check if we have all ingredients in the inventory\n    if not check_inventory(env, recipe):\n        raise ValueError(f\"Missing ingredients to craft {item}\")\n\n    # Determine the required workshop(s) based on the recipe\n    # This is a placeholder; actual logic may vary depending on recipe structure\n    # For now, we'll assume that all recipes require one of the available workshops.\n    required_workshops = set(env.world.workshop_indices)\n    \n    # Find available workshops in the grid\n    available_workshops = {}\n    for workshop_index in env.world.workshop_indices:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    # Find the closest workshop\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:55:02.420354", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      \n      # Determine the direction to move\n      if delta_y > 0:\n          actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n      elif delta_y < 0:\n          actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n      if delta_x > 0:\n          actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n      elif delta_x < 0:\n          actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n      \n      return actions\n  \n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, pos)\n      \n      return closest_workshop\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Determine the required workshop(s) based on the recipe\n    # This is a placeholder; actual logic may vary depending on recipe structure\n    # For now, we'll assume that all recipes require one of the available workshops.\n    required_workshops = set(env.world.workshop_indices)\n    \n    # Find available workshops in the grid\n    available_workshops = {}\n    for workshop_index in env.world.workshop_indices:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    # Find the closest workshop\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:56:19.318184", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n\n  def find_workshop_for_ingredient(ingredient_index):\n      for w in env.world.workshop_indices:\n          workshop_recipe = cookbook.recipes.get(w, {})\n          if any(ingredient_index == int(key) for key in workshop_recipe.keys()):\n              return w\n      return None\n\n  # Step 1: Identify required workshops based on ingredients\n  required_workshops = []\n  for ingredient in recipe.keys():\n      if ingredient != \"_key\":\n          ingredient_index = cookbook.index[ingredient]\n          workshop_index = find_workshop_for_ingredient(ingredient_index)\n          if workshop_index is not None:\n              required_workshops.append(workshop_index)\n\n  # Step 2: Navigate to the required workshops and craft items\n  actions = []\n  visited_workshops = set()\n  \n  for workshop_type in required_workshops:\n      if workshop_type not in visited_workshops:\n          # Find a position next to the workshop\n          grid = env._current_state.grid\n          pos = env._current_state.pos\n\n          # Navigate towards the nearest available workshop of the required type\n          workshop_positions = np.argwhere(grid[:, :, workshop_type] > 0)\n\n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop found for item '{item}'.\")\n\n          closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - pos[0]) ** 2 + (x[1] - pos[1]) ** 2)\n\n          # Generate actions to move towards the closest workshop\n          actions.extend(navigate_to(env._current_state, tuple(closest_workshop_pos)))\n          visited_workshops.add(workshop_type)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T23:56:21.216683", "function_name": "craft", "function_body": "  def navigate_to(current_state: craft.CraftState, target_pos):\n    current_pos = current_state.pos\n    relative_x = target_pos[0] - current_pos[0]\n    relative_y = target_pos[1] - current_pos[1]\n\n    actions = []\n    if relative_y > 0:\n        actions.extend([env.world.N_DOWN] * relative_y)\n    elif relative_y < 0:\n        actions.extend([env.world.N_UP] * abs(relative_y))\n    \n    if relative_x > 0:\n        actions.extend([env.world.N_RIGHT] * relative_x)\n    elif relative_x < 0:\n        actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n    return actions\n\n  def find_workshops_for_item(item_index):\n    workshop_indices = set()\n    for workshop_index in env.world.workshop_indices:\n      recipe = env.world.cookbook.recipes.get(workshop_index, {})\n      if item_index in recipe.values():\n        workshop_indices.add(workshop_index)\n    return workshop_indices\n\n  actions = []\n  cookbook = env.world.cookbook\n  if item not in cookbook.index:\n    raise ValueError(f\"Item '{item}' is not recognized.\")\n\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index, None)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for '{item}'.\")\n\n  # Determine which workshops are needed based on the ingredients\n  workshop_indices_required = find_workshops_for_item(item_index)\n  visited_workshops = set()\n\n  for workshop_index in workshop_indices_required:\n    if workshop_index not in visited_workshops:\n      # Find a position next to the workshop\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n\n      # Navigate towards the nearest available workshop of the required type\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n        raise ValueError(f\"No workshop found for item '{item}'.\")\n\n      closest_workshop_pos = min(workshop_positions, key=lambda x: (x[0] - pos[0]) ** 2 + (x[1] - pos[1]) ** 2)\n\n      # Generate actions to move towards the closest workshop\n      actions.extend(navigate_to(env._current_state, tuple(closest_workshop_pos)))\n      visited_workshops.add(workshop_index)\n      \n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is mapped to 4\n\n  return actions", "island_id": 0, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:56:52.430094", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # If there's no recipe for the item, we can't craft it\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Find all workshops that can make this item\n  valid_workshops = [\n      w for i_w, w in enumerate(env.world.workshop_indices) \n      if i_w in env.world.cookbook.recipes[item_index]\n  ]\n\n  actions = []\n  \n  # If there are no valid workshops, we cannot craft the item\n  if not valid_workshops:\n    return []\n\n  # Move to the closest workshop and perform the USE action\n  workshop_index = min(valid_workshops, key=lambda w: distance_to(env._current_state.pos, env.world.grid, w))\n  \n  actions.extend(move_to(env, (workshop_index,)))\n  actions.append(craft.action.USE)\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T23:56:54.297983", "function_name": "craft", "function_body": "  return []", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T23:58:58.234415", "function_name": "craft", "function_body": "  # Step 1: Get the index for the desired item\n  item_index = env.world.cookbook.index.index(item)\n  if item_index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Step 2: Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if not recipe:\n      print(f\"No recipe found for item {item}.\")\n      return []\n\n  # Step 3: Determine which workshop(s) can craft this item\n  # Assuming each workshop has a unique set of ingredients it can use.\n  workshop_indices = []\n  for workshop_idx in env.world.workshop_indices:\n      primitives = env.world.cookbook.primitives_for(item_index)\n      if any(ingredient in recipe.keys() for ingredient in primitives.keys()):\n          workshop_indices.append(workshop_idx)\n\n  # Check if there are any suitable workshops\n  if not workshop_indices:\n      print(f\"No suitable workshops found to craft {item}.\")\n      return []\n\n  # Step 4: Find the closest workshop from the list of possible workshops\n  agent_pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx, closest_workshop_pos = None, None\n\n  for workshop_idx in workshop_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(positions) == 0: continue\n      \n      distances = np.linalg.norm(positions - agent_pos, axis=1)\n      min_distance_per_workshop = min(distances)\n\n      if min_distance_per_workshop < min_distance:\n          closest_workshop_idx = workshop_idx\n          closest_workshop_pos = positions[np.argmin(distances)]\n          min_distance = min_distance_per_workshop\n\n  # Step 5: If no workshops are found, return an empty list\n  if closest_workshop_pos is None:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Step 6: Calculate actions to move towards the closest workshop\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  actions_to_workshop = []\n  direction_map = {\n      'RIGHT': env.action_specs()['RIGHT'],\n      'LEFT': env.action_specs()['LEFT'],\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN']\n  }\n\n  if delta_x > 0:\n      actions_to_workshop.extend([direction_map['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([direction_map['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([direction_map['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([direction_map['DOWN']] * abs(delta_y))\n\n  # Step 7: Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:59:00.123082", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index.index(item)\n  if item_index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if not recipe:\n      print(f\"No recipe for item {item}.\")\n      return []\n\n  # Identify suitable workshops that can produce this item\n  workshop_indices = [idx for idx in env.world.workshop_indices \n                      if any(ingredient in recipe.keys() \n                           for ingredient in env.world.cookbook.primitives_for(item_index).keys())]\n  \n  if not workshop_indices:\n      print(f\"No suitable workshops found to craft {item}.\")\n      return []\n\n  # Locate the closest workshop among the suitable ones\n  agent_pos = np.array(env._current_state.pos)\n  closest_workshop_pos, min_distance = None, float('inf')\n  for workshop_index in workshop_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      if len(positions) > 0:\n          distances = np.linalg.norm(positions - agent_pos, axis=1)\n          closest_position = positions[np.argmin(distances)]\n          distance = min(distances)\n          if distance < min_distance:\n              closest_workshop_pos = closest_position\n              min_distance = distance\n\n  if closest_workshop_pos is None:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Calculate actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n  \n  # Determine the direction and calculate steps in x-direction\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  # Calculate steps in y-direction\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n  \n  # Align the agent's direction towards the workshop to ensure correct usage\n  current_direction = env._current_state.dir\n  target_direction = np.arctan2(delta_y, delta_x) * 180 / np.pi\n\n  if -45 <= target_direction < 45 or 315 <= target_direction < 360:\n      actions_to_workshop.append(env.action_specs()['RIGHT'])\n  elif 45 <= target_direction < 135:\n      actions_to_workshop.append(env.action_specs()['UP'])\n  elif 135 <= target_direction < 225:\n      actions_to_workshop.append(env.action_specs()['LEFT'])\n  elif 225 <= target_direction < 315:\n      actions_to_workshop.append(env.action_specs()['DOWN'])\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T00:01:18.654773", "function_name": "craft", "function_body": "  def get_workshop_positions(workshop_index):\n      workshop_positions = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n                  workshop_positions.append((x, y))\n      return workshop_positions\n\n  def get_closest_workshop(workshops, current_x, current_y):\n      closest_workshop = min(workshops, key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y))\n      return closest_workshop\n\n  item_index = env.world.cookbook.index[item]\n\n  # Initialize an empty list to store the actions needed to craft the item\n  actions = []\n\n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      print(\"No recipe found for the item.\")\n      return actions\n\n  # Identify which workshop should be used for crafting based on the first ingredient that is a workshop.\n  workshop_index = None\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient in env.world.workshop_indices:\n          workshop_index = ingredient\n          break\n\n  # If no specific workshop index was found, default to the first available workshop.\n  if workshop_index is None:\n      workshop_index = env.world.workshop_indices[0]\n\n  # Find all positions of the identified workshops in the grid\n  workshop_positions = get_workshop_positions(workshop_index)\n\n  # If no workshops were found, print a message and return the empty actions list\n  if not workshop_positions:\n      print(\"No workshops found in the grid.\")\n      return actions\n\n  # Calculate distances from the current position to each workshop and choose the closest one\n  current_x, current_y = env._current_state.pos\n  closest_workshop = get_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Determine the path to the chosen workshop using BFS\n  target_x, target_y = closest_workshop\n\n  queue = collections.deque([(current_x, current_y, [])])\n  visited = set()\n\n  while queue:\n      cx, cy, path = queue.popleft()\n\n      if (cx, cy) == (target_x, target_y):\n          actions.extend(path)\n          break\n\n      if (cx, cy) in visited:\n          continue\n      visited.add((cx, cy))\n\n      # Define possible moves: RIGHT, LEFT, UP, DOWN\n      for dx, dy, action in [(1, 0, 3), (-1, 0, 2), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the new position is within bounds and not a boundary\n          if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n              if np.argmax(env._current_state.grid[ny, nx]) != env.world.cookbook.index['BOUNDARY']:\n                  queue.append((nx, ny, path + [action]))\n\n  # Finally, perform the USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
