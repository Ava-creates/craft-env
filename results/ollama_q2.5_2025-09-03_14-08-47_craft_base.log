{"timestamp": "2025-09-03T16:16:55.283689", "function_name": "craft", "function_body": "  def move_towards(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([0] * abs(dy))  # DOWN\n\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine which workshop to go to based on the recipe's required ingredients\n  def determine_workshop(item_index):\n    recipes = env.world.cookbook.recipes\n    if item_index in recipes:\n      for ingredient in recipes[item_index]:\n        if ingredient != \"_key\":\n          return ingredient  # Simplified: Assume the first non-_key ingredient is the workshop index\n    return None\n\n  workshop_index = determine_workshop(item_index)\n  \n  if workshop_index is not None:\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_positions) > 0:\n      target_pos = tuple(workshop_positions[0])\n      \n      # Move to the workshop\n      actions_to_take = move_towards(env, target_pos)\n      \n      # Once at the workshop, perform the USE action (action index for USE is 4)\n      actions_to_take.append(4)  # Assuming USE action has an index of 4\n      \n      return actions_to_take\n  \n  return []", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:16:56.523867", "function_name": "craft", "function_body": "  def move_towards(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([0] * abs(dy))  # DOWN\n\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine which workshop to go to based on the recipe's required ingredients\n  def determine_workshop(item_index):\n    recipes = env.world.cookbook.recipes\n    if item_index in recipes:\n      for ingredient in recipes[item_index]:\n        if ingredient != \"_key\":\n          return ingredient  # Simplified: Assume the first non-_key ingredient is the workshop index\n    return None\n\n  workshop_index = determine_workshop(item_index)\n  \n  if workshop_index is not None:\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_positions) > 0:\n      target_pos = tuple(workshop_positions[0])\n      \n      # Move to the workshop\n      actions_to_take = move_towards(env, target_pos)\n      \n      # Once at the workshop, perform the USE action (action index for USE is 4)\n      actions_to_take.append(4)  # Assuming USE action has an index of 4\n      \n      return actions_to_take\n  \n  return []", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:19:35.259236", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def go_to_workshop(actions, x, y):\n      cx, cy = env._current_state.pos\n      dx = x - cx\n      dy = y - cy\n\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n\n  def find_nearest_workshop(i_workshop):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, i_workshop] == 1)\n      if len(positions) > 0:\n          # Sort by Manhattan distance to the current position\n          cx, cy = env._current_state.pos\n          distances = [abs(x - cx) + abs(y - cy) for x, y in positions]\n          nearest_pos = tuple(positions[np.argmin(distances)])\n          return nearest_pos\n      else:\n          return None\n\n  def collect(env, primitive):\n      actions = []\n      i_primitive = env.world.cookbook.index[primitive]\n      if i_primitive in env._current_state.inventory and env._current_state.inventory[i_primitive] > 0:\n          return actions  # No need to collect if already have\n      else:\n          # Implement logic to find and collect the primitive\n          positions = np.argwhere(env._current_state.grid[:, :, i_primitive] == 1)\n          if len(positions) > 0:\n              nearest_pos = tuple(positions[np.argmin([abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1]) for x, y in positions])])\n              go_to_workshop(actions, nearest_pos[0], nearest_pos[1])\n              actions.append(USE)\n          return actions\n\n  def craft_item(env, item):\n      i_item = env.world.cookbook.index[item]\n      if i_item in env.world.cookbook.recipes:\n          recipe = env.world.cookbook.recipes[i_item]\n          workshops_needed = []\n          primitives_required = {}\n\n          for ingredient, count in recipe.items():\n              if ingredient == \"_key\":\n                  workshops_needed.append(recipe[\"_key\"])\n              else:\n                  i_ingredient = env.world.cookbook.index[ingredient]\n                  if i_ingredient in env.world.cookbook.primitives:\n                      primitives_required[i_ingredient] = count\n\n          for primitive, count in primitives_required.items():\n              actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n          for workshop in workshops_needed:\n              i_workshop = env.world.cookbook.index[workshop]\n              nearest_pos = find_nearest_workshop(i_workshop)\n              if nearest_pos is not None:\n                  go_to_workshop(actions, nearest_pos[0], nearest_pos[1])\n                  actions.append(USE)\n\n  actions = []\n  craft_item(env, item)\n  return actions", "island_id": 4, "scores": {"": 0.0}}
