s, current_x, current_y)\n\n  # Determine the path to the chosen workshop using BFS for a more optimal path\n  target_x, target_y = closest_workshop\n\n  queue = collections.deque([(current_x, current_y, [])])\n  visited = set()\n  \n  while queue:\n      cx, cy, path = queue.popleft()\n      \n      if (cx, cy) == (target_x, target_y):\n          actions.extend(path)\n          break\n\n      if (cx, cy) in visited:\n          continue\n      visited.add((cx, cy))\n      \n      # Define possible moves: RIGHT, LEFT, UP, DOWN\n      for dx, dy, action in [(1, 0, 3), (-1, 0, 2), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = cx + dx, cy + dy\n          \n          # Check if the new position is within bounds and not a boundary\n          if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n              if np.argmax(env._current_state.grid[ny, nx]) != env.world.cookbook.index['BOUNDARY']:\n                  queue.append((nx, ny, path + [action]))\n\n  # Finally, perform the USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:59:42.792553", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.index(item)\n  \n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  recipe = env.world.cookbook.recipes[index]\n  \n  # Find a suitable workshop that can make this item\n  for workshop_index in env.world.workshop_indices:\n      if all(ingredient in env.world.cookbook.primitives_for(index).keys() or ingredient == \"_key\" for ingredient in recipe.keys()):\n          break\n  else:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  \n  if len(workshop_positions) == 0:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n  \n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos[1] - agent_pos[1], closest_workshop_pos[0] - agent_pos[0]\n\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:59:45.174795", "function_name": "craft", "function_body": "  # Get the index of the item in the cookbook\n  index = env.world.cookbook.index.get(item)\n\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n\n  # Determine the workshop that can make this item\n  workshop_index = None\n\n  # Iterate over all workshops to find a suitable one\n  for i in range(len(env.world.workshop_indices)):\n      if any(ingredient in recipe.keys() for ingredient in env.world.cookbook.primitives_for(index).keys()):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  if workshop_index is None:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n  if len(workshop_positions) == 0:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:01:32.895024", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Initialize an empty list to store the actions needed to craft the item\n  actions = []\n\n  # Determine the workshop required for crafting the item\n  # This is based on the assumption that different items require specific workshops,\n  # and these indices are determined by the first occurrence of any workshop in the recipe's ingredients.\n\n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Identify which workshop should be used for crafting based on the first ingredient that is a workshop.\n  workshop_index = None\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient in env.world.workshop_indices:\n          workshop_index = ingredient\n          break\n\n  # If no specific workshop index was found, default to the first available workshop.\n  if workshop_index is None:\n      workshop_index = env.world.workshop_indices[0]\n\n  # Find the position of the identified workshop in the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n\n  # If the workshop position was found, move to it and then craft the item\n  if workshop_pos:\n      # Calculate the direction needed to move towards the workshop\n      current_x, current_y = env._current_state.pos\n      target_x, target_y = workshop_pos\n\n      # Move in the x-direction first (LEFT or RIGHT)\n      while current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      while current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      # Then move in the y-direction (UP or DOWN)\n      while current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      while current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n      # Finally, perform the USE action to craft the item\n      actions.append(4)  # USE\n  else:\n      print(\"Workshop not found in the grid.\")\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T17:01:35.120523", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Initialize an empty list to store the actions needed to craft the item.\n  actions = []\n\n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Identify which workshop should be used for crafting based on the first ingredient that is a workshop.\n  workshop_index = None\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient in env.world.workshop_indices:\n          workshop_index = ingredient\n          break\n\n  # If no specific workshop index was found, default to the first available workshop.\n  if workshop_index is None:\n      workshop_index = env.world.workshop_indices[0]\n\n  # Find the position of the identified workshop in the grid.\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n\n  # If the workshop position was found, move to it and then craft the item.\n  if workshop_pos:\n      current_x, current_y = env._current_state.pos\n      target_x, target_y = workshop_pos\n\n      # Calculate the direction needed to move towards the workshop.\n      actions.extend(move_to(env, (target_x, target_y)))\n\n      # Finally, perform the USE action to craft the item.\n      actions.append(4)  # USE\n  else:\n      print(\"Workshop not found in the grid.\")\n\n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:04:24.894078", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] == 1:  # Assuming 1 represents an obstacle\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n\n  # Ensure no invalid directions are generated\n  valid_actions = [action for action in actions_to_move if action is not None]\n\n  # Use action at the end\n  actions_to_craft = valid_actions + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:04:26.845200", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] == 1:  # Assuming 1 represents an obstacle\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:05:44.802293", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(env._current_state.grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop if step != nearest_workshop_pos]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:05:46.673943", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop using BFS (breadth-first search) for simplicity\n  path_to_workshop = bfs(env._current_state.grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [env.world.N_ACTIONS if step == nearest_workshop_pos else direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:07:16.618265", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      current_pos = env._current_state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      if relative_y > 0:\n          actions.extend([env.world.N_DOWN] * relative_y)\n      elif relative_y < 0:\n          actions.extend([env.world.N_UP] * abs(relative_y))\n      \n      if relative_x > 0:\n          actions.extend([env.world.N_RIGHT] * relative_x)\n      elif relative_x < 0:\n          actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  def find_workshop_for_item(item_index):\n      for workshop_index in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(workshop_index)\n          if recipe and item_index in recipe.values():\n              return workshop_index\n      return None\n\n  def get_closest_workshop_position(target_workshop_index):\n      positions = np.argwhere(env._current_state.grid[:, :, target_workshop_index]).tolist()\n      current_pos = env._current_state.pos\n      \n      closest_pos = min(positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n      \n      return closest_pos\n\n  actions = []\n  \n  # Fetch the index for the desired item from the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index associated with this item (if any)\n  workshop_index = find_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      workshop_pos = get_closest_workshop_position(workshop_index)\n      \n      actions.extend(move_to_position(workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(env.world.N_USE)\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:07:18.758757", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      current_pos = env._current_state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      if relative_y > 0:\n          actions.extend([env.world.N_DOWN] * relative_y)\n      elif relative_y < 0:\n          actions.extend([env.world.N_UP] * abs(relative_y))\n      \n      if relative_x > 0:\n          actions.extend([env.world.N_RIGHT] * relative_x)\n      elif relative_x < 0:\n          actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  def find_workshop_for_item(item_index):\n      for workshop_index in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(workshop_index)\n          if recipe and item_index in recipe.values():\n              return workshop_index\n      return None\n\n  actions = []\n  \n  # Fetch the index for the desired item from the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index associated with this item (if any)\n  workshop_index = find_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index]).tolist()\n      \n      # Assuming there's at least one such position\n      for workshop_pos in workshop_pos_list:\n          actions.extend(move_to_position(workshop_pos))\n          \n          # Check if the item can be crafted here\n          env._current_state.pos = (workshop_pos[0], workshop_pos[1])\n          env._current_state.dir = 0  # Reset direction\n          env._current_state.inventory[item_index] += 1\n          _, new_state = env._current_state.step(env.world.N_USE)\n          \n          if item_index in new_state.inventory and new_state.inventory[item_index] > 0:\n              actions.append(env.world.N_USE)\n              break\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:09:27.637068", "function_name": "craft", "function_body": "  def get_path(start_pos, end_pos):\n    \"\"\"\n    Simple BFS implementation to find the shortest path between start and end positions on a grid.\n    \n    Args:\n        start_pos (tuple): Starting position in the grid.\n        end_pos (tuple): Target position in the grid.\n        \n    Returns:\n        list[int]: List of actions representing the shortest path from start_pos to end_pos.\n    \"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    action_indices = [2, 1, 3, 0]  # Action indices corresponding to the above directions\n    \n    grid_shape = env._current_state.grid.shape[:2]\n    visited = np.zeros(grid_shape, dtype=bool)\n    queue = collections.deque([(start_pos, [])])\n    \n    while queue:\n        pos, path = queue.popleft()\n        \n        if pos == end_pos:\n            return path\n        \n        if not visited[pos]:\n            visited[pos] = True\n            \n            for (dx, dy), action in zip(directions, action_indices):\n                new_x, new_y = pos[0] + dx, pos[1] + dy\n                \n                # Check boundaries and non-grabbable positions\n                if 0 <= new_x < grid_shape[0] and 0 <= new_y < grid_shape[1]:\n                    if env._current_state.grid[new_x, new_y].sum() == 0 or (new_x, new_y) in path:\n                        continue\n                    \n                    queue.append(((new_x, new_y), path + [action]))\n    \n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe. If not, return an empty list of actions.\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Extract the workshop index (key) and the ingredients required for crafting from the recipe.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  \n  # Validate if all ingredients are available in the current inventory. If any ingredient is missing,\n  # return an empty list of actions.\n  inventory = env._current_state.inventory\n  ingredients_needed = {k: v for k, v in recipe.items() if k != \"_key\"}\n  for ingredient, count in ingredients_needed.items():\n    if inventory[ingredient] < count:\n      return []\n\n  # If there's no specified workshop or it's not available in the world, return an empty list of actions.\n  if not workshop_key or workshop_key not in env.world.workshop_indices:\n    return []\n\n  # Fetch all positions where the required workshop type is present on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_key] > 0)\n  \n  # If no workshops of the required type are found, return an empty list of actions.\n  if len(workshop_positions) == 0:\n    return []\n\n  # Determine the closest workshop using Manhattan distance from the current agent's position.\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Generate actions to move the agent to the closest workshop.\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop))\n\n  # Combine the path actions with a USE action to craft the item at the workshop.\n  actions = path_to_workshop + [4]  # Assuming 'USE' is mapped to action index 4.\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:09:30.210994", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item using the cookbook.\n  item_index = env.world.cookbook.index[item]\n  \n  # Verify if the desired item has a recipe in the cookbook. If not, return an empty action list.\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Extract the workshop index and ingredient requirements from the item's recipe.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  # Check if all required ingredients are available in the current inventory. If not, return an empty action list.\n  inventory = env._current_state.inventory\n  for ingredient, count in ingredients_required.items():\n    if inventory[ingredient] < count:\n      return []\n\n  # Ensure that the specified workshop exists and is valid within the world's known workshops.\n  if not workshop_key or workshop_key not in env.world.workshop_indices:\n    return []\n  \n  # Find all positions of the required workshop type on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_key] > 0)\n  \n  # If no workshops are found, return an empty action list.\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Identify the closest workshop based on Manhattan distance from the agent's current position.\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Generate actions to navigate the agent to the closest workshop.\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop))\n  \n  # Append a USE action (assuming index 4) to craft the item at the workshop.\n  actions = path_to_workshop + [4]  # Assuming 'USE' is mapped to action index 4.\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:11:53.240939", "function_name": "craft", "function_body": "  def bfs(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"Breadth-First Search to find the shortest path from start to goal on a grid.\"\"\"\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] == 1:  # Assuming 1 represents an obstacle\n                  continue\n\n              if neighbor in came_from:\n                  continue\n\n              queue.append(neighbor)\n              came_from[neighbor] = current\n\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop using BFS (breadth-first search) for simplicity\n  path_to_workshop = bfs(env._current_state.grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [env.world.N_ACTIONS if step == nearest_workshop_pos else direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:11:55.612881", "function_name": "craft", "function_body": "  def bfs(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"Breadth-first search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = collections.deque([start])\n      came_from = {start: None}\n\n      while queue:\n          current = queue.popleft()\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          for dx, dy in neighbors:\n              neighbor = (current[0] + dx, current[1] + dy)\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] == 1:  # Assuming 1 represents an obstacle\n                  continue\n\n              if neighbor in came_from:\n                  continue\n\n              queue.append(neighbor)\n              came_from[neighbor] = current\n\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop using BFS (breadth-first search) for simplicity\n  path_to_workshop = bfs(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:13:15.443696", "function_name": "craft", "function_body": "  # Constants for directions\n  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def go_to_nearest_workshop(env, workshop_index):\n    pos = env._current_state.pos\n    min_distance = float('inf')\n    target_pos = None\n\n    for y in range(env.world.cookbook.grid.shape[0]):\n      for x in range(env.world.cookbook.grid.shape[1]):\n        if np.any(env.world.cookbook.grid[y, x] == workshop_index):\n          distance = abs(x - pos[0]) + abs(y - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            target_pos = (x, y)\n\n    if target_pos is None:\n      raise ValueError(f\"No workshop with index {workshop_index} found.\")\n\n    return path_to(env, target_pos)\n\n  def path_to(env, target_pos):\n    pos = env._current_state.pos\n    direction = env._current_state.dir\n\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n\n    # Turn to face the target x-coordinate\n    if dx > 0:\n      while direction != RIGHT:\n        direction = (direction + 1) % 4\n        actions.append(RIGHT)\n    elif dx < 0:\n      while direction != LEFT:\n        direction = (direction - 1) % 4\n        actions.append(LEFT)\n\n    # Move to the target x-coordinate\n    for _ in range(abs(dx)):\n      actions.append(FORWARD)\n\n    # Turn to face the target y-coordinate\n    if dy > 0:\n      while direction != DOWN:\n        direction = (direction + 1) % 4\n        actions.append(RIGHT)\n    elif dy < 0:\n      while direction != UP:\n        direction = (direction - 1) % 4\n        actions.append(LEFT)\n\n    # Move to the target y-coordinate\n    for _ in range(abs(dy)):\n      actions.append(FORWARD)\n\n    return actions\n\n  actions = []\n\n  i_item = env.world.cookbook.index[item]\n\n  if i_item not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe for {item} found.\")\n\n  workshop_key = env.world.cookbook.recipes[i_item].get(\"_key\")\n  ingredients = {k: v for k, v in env.world.cookbook.recipes[i_item].items() if k != \"_key\"}\n\n  # Handle workshops needed\n  if workshop_key:\n    i_workshop = env.world.cookbook.index[workshop_key]\n    actions.extend(go_to_nearest_workshop(env, i_workshop))\n    actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
