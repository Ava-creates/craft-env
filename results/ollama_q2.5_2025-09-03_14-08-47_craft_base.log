kshop_indices)\n\n    if closest_workshop_pos is None:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n    # Calculate actions to move to the workshop position\n    current_pos = env._current_state.pos\n    actions.extend(get_direction_to_target(current_pos, closest_workshop_pos))\n    \n    # Check if we are already at a workshop (in case of multiple workshops)\n    if not is_workshop_at_position(current_pos, env.world.workshop_indices, env._current_state.grid):\n      # Use the workshop to craft the item\n      actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
