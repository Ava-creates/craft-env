up\n\n  if dy > 0:\n      move_actions.extend([3] * abs(dy))  # Move right\n  elif dy < 0:\n      move_actions.extend([2] * abs(dy))  # Move left\n\n  actions = move_actions\n  \n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T04:42:53.866916", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      \n      # Determine the direction to move\n      if delta_y > 0:\n          actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n      elif delta_y < 0:\n          actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n      if delta_x > 0:\n          actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n      elif delta_x < 0:\n          actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n      \n      return actions\n\n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, tuple(pos))\n      \n      return closest_workshop\n\n  def get_required_workshops(recipe):\n      # Determine the required workshops based on recipe\n      required_workshops = set()\n      for ingredient in recipe.keys():\n          if ingredient in env.world.workshop_indices:\n              required_workshops.add(ingredient)\n      return required_workshops or env.world.workshop_indices\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Determine the required workshop(s) based on the recipe\n    required_workshops = get_required_workshops(recipe)\n    \n    # Find available workshops in the grid\n    available_workshops = {}\n    for workshop_index in required_workshops:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    if not available_workshops:\n      raise ValueError(f\"No required workshops found for item {item}\")\n\n    # Find the closest workshop from available required workshops\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:42:55.775839", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      \n      # Determine the direction to move\n      if delta_y > 0:\n          actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n      elif delta_y < 0:\n          actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n      if delta_x > 0:\n          actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n      elif delta_x < 0:\n          actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n      \n      return actions\n\n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, tuple(pos))\n      \n      return closest_workshop\n\n  def find_required_workshops(recipe):\n      # Determine the required workshops based on recipe ingredients\n      required_workshops = set()\n      for ingredient in recipe.keys():\n          if ingredient in env.world.workshop_indices:\n              required_workshops.add(ingredient)\n      return required_workshops or set(env.world.workshop_indices)\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Determine the required workshop(s) based on the recipe\n    required_workshops = find_required_workshops(recipe)\n    \n    # Find available workshops in the grid that are also required\n    available_workshops = {}\n    for workshop_index in required_workshops:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    if not available_workshops:\n      raise ValueError(f\"No required workshops found for item {item}\")\n\n    # Find the closest workshop from available required workshops\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:45:07.194554", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_indices):\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for workshop_index in workshop_indices:\n        workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n        for pos in workshop_positions:\n            distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_workshop_pos = tuple(pos)\n    \n    return closest_workshop_pos\n\n  def get_direction_to_target(current_dir, target_delta):\n      actions = []\n      \n      # Determine the required direction based on delta\n      if target_delta[0] > 0:  # Move DOWN\n          if current_dir != 'DOWN':\n              actions.append(3)  # Turn DOWN\n          actions.extend([3 for _ in range(abs(target_delta[0]))])\n      elif target_delta[0] < 0:  # Move UP\n          if current_dir != 'UP':\n              actions.append(2)  # Turn UP\n          actions.extend([2 for _ in range(abs(target_delta[0]))])\n\n      if target_delta[1] > 0:  # Move RIGHT\n          if current_dir != 'RIGHT':\n              actions.append(1)  # Turn RIGHT\n          actions.extend([1 for _ in range(abs(target_delta[1]))])\n      elif target_delta[1] < 0:  # Move LEFT\n          if current_dir != 'LEFT':\n              actions.append(0)  # Turn LEFT\n          actions.extend([0 for _ in range(abs(target_delta[1]))])\n\n      return actions\n\n  def get_direction_from_index(dir_index):\n    \"\"\"Converts direction index (0, 1, 2, 3, 4) to string representation.\"\"\"\n    return {0: 'LEFT', 1: 'RIGHT', 2: 'UP', 3: 'DOWN', 4: 'USE'}[dir_index]\n\n  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    closest_workshop_pos = find_closest_workshop(env._current_state.grid, env.world.workshop_indices)\n\n    if closest_workshop_pos is None:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n    # Calculate relative direction and distance to the workshop\n    current_pos = env._current_state.pos\n    delta_x = closest_workshop_pos[1] - current_pos[1]\n    delta_y = closest_workshop_pos[0] - current_pos[0]\n\n    target_delta = (delta_y, delta_x)\n\n    # Convert current direction index to string representation\n    current_dir_str = get_direction_from_index(env._current_state.dir)\n    \n    # Get actions to move towards the workshop\n    actions.extend(get_direction_to_target(current_dir_str, target_delta))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:45:09.122360", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_indices):\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for workshop_index in workshop_indices:\n        workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n        for pos in workshop_positions:\n            distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                closest_workshop_pos = tuple(pos)\n    \n    return closest_workshop_pos\n\n  def get_direction_to_target(current_dir, target_delta):\n      actions = []\n      \n      # Determine the required direction based on delta\n      if target_delta[0] > 0:  # Move DOWN\n          if current_dir != 'DOWN':\n              actions.append(3)  # Turn DOWN\n              current_dir = 'DOWN'\n          actions.extend([3 for _ in range(abs(target_delta[0]))])\n      elif target_delta[0] < 0:  # Move UP\n          if current_dir != 'UP':\n              actions.append(2)  # Turn UP\n              current_dir = 'UP'\n          actions.extend([2 for _ in range(abs(target_delta[0]))])\n\n      if target_delta[1] > 0:  # Move RIGHT\n          if current_dir != 'RIGHT':\n              actions.append(1)  # Turn RIGHT\n              current_dir = 'RIGHT'\n          actions.extend([1 for _ in range(abs(target_delta[1]))])\n      elif target_delta[1] < 0:  # Move LEFT\n          if current_dir != 'LEFT':\n              actions.append(0)  # Turn LEFT\n              current_dir = 'LEFT'\n          actions.extend([0 for _ in range(abs(target_delta[1]))])\n\n      return actions, current_dir\n\n  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    closest_workshop_pos = find_closest_workshop(env._current_state.grid, env.world.workshop_indices)\n\n    if closest_workshop_pos is None:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n    # Calculate relative direction and distance to the workshop\n    current_pos = env._current_state.pos\n    delta_x = closest_workshop_pos[1] - current_pos[1]\n    delta_y = closest_workshop_pos[0] - current_pos[0]\n\n    target_delta = (delta_y, delta_x)\n\n    # Get actions to move towards the workshop and update direction\n    actions_to_workshop, updated_direction = get_direction_to_target(env._current_state.dir, target_delta)\n    actions.extend(actions_to_workshop)\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:47:15.891145", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, workshop_indices):\n    pos = env._current_state.pos\n    nearest_distance = float('inf')\n    nearest_pos = None\n    \n    for idx in workshop_indices:\n      positions = np.argwhere(grid[:, :, idx] > 0)\n      for position in positions:\n        distance = abs(position[0] - pos[0]) + abs(position[1] - pos[1])\n        if distance < nearest_distance:\n          nearest_distance = distance\n          nearest_pos = tuple(position)\n    \n    return nearest_pos\n  \n  def move_to(pos, current_pos, current_dir):\n    dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n    actions = []\n    \n    if dx > 0:\n      actions.extend([0] * abs(dx))  # Move down\n    elif dx < 0:\n      actions.extend([1] * abs(dx))  # Move up\n    \n    if dy > 0:\n      actions.extend([3] * abs(dy))  # Move right\n    elif dy < 0:\n      actions.extend([2] * abs(dy))  # Move left\n    \n    return actions\n  \n  def orient_towards(pos, current_pos, current_dir):\n    \"\"\"Orient the agent towards the target position.\"\"\"\n    dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n    \n    if dx > 0 and (current_dir == 2 or current_dir == 3):  # Agent facing left/right\n      actions.extend([4])  # Rotate to face down\n    elif dx < 0 and (current_dir == 2 or current_dir == 3):  # Agent facing left/right\n      actions.extend([5])  # Rotate to face up\n    \n    if dy > 0 and (current_dir == 0 or current_dir == 1):  # Agent facing up/down\n      actions.extend([4])  # Rotate to face right\n    elif dy < 0 and (current_dir == 0 or current_dir == 1):  # Agent facing up/down\n      actions.extend([5])  # Rotate to face left\n    \n    return []\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  actions = []\n  \n  # Find the index for the desired item in the cookbook's index\n  item_index = index[item]\n  \n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n    \n  recipe = cookbook.recipes.get(item_index)\n  if recipe is None:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Determine which workshop to use based on the kind of item\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  nearest_workshop_pos = find_nearest_workshop(grid, workshop_indices)\n  \n  if nearest_workshop_pos is None:\n    raise ValueError(\"No workshop found on the grid.\")\n    \n  current_pos = env._current_state.pos\n  \n  # Calculate the actions needed to move to the nearest workshop\n  move_actions = move_to(nearest_workshop_pos, current_pos, env._current_state.dir)\n  \n  actions.extend(move_actions)\n\n  # Orient the agent towards the workshop (if necessary)\n  orientation_actions = orient_towards(nearest_workshop_pos, current_pos, env._current_state.dir)\n  \n  actions.extend(orientation_actions)\n  \n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T04:47:17.785306", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, workshop_indices):\n    pos = env._current_state.pos\n    nearest_distance = float('inf')\n    nearest_pos = None\n    \n    for idx in workshop_indices:\n      positions = np.argwhere(grid[:, :, idx] > 0)\n      for position in positions:\n        distance = abs(position[0] - pos[0]) + abs(position[1] - pos[1])\n        if distance < nearest_distance:\n          nearest_distance = distance\n          nearest_pos = tuple(position)\n    \n    return nearest_pos\n  \n  def move_to(pos, current_pos, current_dir):\n    dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n    actions = []\n    \n    # Determine the direction to face for movement\n    if dx > 0:\n      actions.extend([0] * abs(dx))  # Move down\n    elif dx < 0:\n      actions.extend([1] * abs(dx))  # Move up\n    if dy > 0:\n      actions.extend([3] * abs(dy))  # Move right\n    elif dy < 0:\n      actions.extend([2] * abs(dy))  # Move left\n    \n    return actions\n  \n  def orient_towards(target_pos, current_pos):\n    dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    if dx > 0:\n        return 0  # DOWN\n    elif dx < 0:\n        return 1  # UP\n    elif dy > 0:\n        return 3  # RIGHT\n    else:\n        return 2  # LEFT\n\n  def get_primitive_actions(primitive):\n      primitive_index = env.world.cookbook.index[primitive]\n      return [env.world.COLLECT_FUNC, primitive_index]\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  actions = []\n  \n  # Find the index for the desired item in the cookbook's index\n  item_index = index[item]\n  \n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n    \n  recipe = cookbook.recipes.get(item_index)\n  if recipe is None:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Determine which workshop to use based on the kind of item\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  nearest_workshop_pos = find_nearest_workshop(grid, workshop_indices)\n  \n  if nearest_workshop_pos is None:\n    raise ValueError(\"No workshop found on the grid.\")\n    \n  current_pos = env._current_state.pos\n  \n  # Calculate the actions needed to move to the nearest workshop\n  move_actions = move_to(nearest_workshop_pos, current_pos, env._current_state.dir)\n  \n  actions.extend(move_actions)\n\n  # Orient towards the nearest workshop (optional but can be useful)\n  orient_action = orient_towards(nearest_workshop_pos, current_pos)\n  if orient_action != env._current_state.dir:\n      actions.append(orient_action)\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 7, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T04:49:14.142002", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      delta_x = target_pos[1] - current_pos[1]\n      delta_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      \n      # Determine the direction to move\n      if delta_y > 0:\n          actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n      elif delta_y < 0:\n          actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n      if delta_x > 0:\n          actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n      elif delta_x < 0:\n          actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n      \n      return actions\n\n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, pos)\n      \n      return closest_workshop\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Determine the required workshop(s) based on the recipe\n    # This is a placeholder; actual logic may vary depending on recipe structure\n    required_workshops = set(env.world.workshop_indices)\n    \n    # Find available workshops in the grid\n    available_workshops = {}\n    for workshop_index in env.world.workshop_indices:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    # Find the closest workshop\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
