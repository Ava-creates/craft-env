ion_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T17:19:06.785635", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      current_pos = env._current_state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      if relative_y > 0:\n          actions.extend([env.world.N_DOWN] * relative_y)\n      elif relative_y < 0:\n          actions.extend([env.world.N_UP] * abs(relative_y))\n      \n      if relative_x > 0:\n          actions.extend([env.world.N_RIGHT] * relative_x)\n      elif relative_x < 0:\n          actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  def find_workshop_for_item(item_index):\n      for workshop_index in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(workshop_index)\n          if recipe and item_index in recipe.values():\n              return workshop_index\n      return None\n\n  def prioritize_workshops_by_distance(workshop_indices):\n      current_pos = env._current_state.pos\n      \n      distances = []\n      for idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, idx]).tolist()\n          \n          if not workshop_positions:\n              continue\n          \n          nearest_position = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n          distances.append((idx, nearest_position))\n      \n      # Sort workshops by their distance to the agent's position\n      distances.sort(key=lambda x: abs(x[1][0] - current_pos[0]) + abs(x[1][1] - current_pos[1]))\n      return [idx for idx, _ in distances]\n\n  actions = []\n  \n  # Fetch the index for the desired item from the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop indices associated with this item (if any)\n  workshop_indices = []\n  for workshop_index in env.world.workshop_indices:\n      recipe = env.world.cookbook.recipes.get(workshop_index)\n      if recipe and item_index in recipe.values():\n          workshop_indices.append(workshop_index)\n\n  if workshop_indices:\n      prioritized_workshops = prioritize_workshops_by_distance(workshop_indices)\n      \n      for workshop_index in prioritized_workshops:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index]).tolist()\n          \n          if not workshop_positions:\n              continue\n          \n          nearest_position = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          actions.extend(move_to_position(nearest_position))\n          \n          # Use the workshop to craft the item\n          actions.append(env.world.N_USE)\n          \n          break  # Assuming one successful crafting is enough\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:19:08.649015", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      current_pos = env._current_state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      if relative_y > 0:\n          actions.extend([env.world.N_DOWN] * relative_y)\n      elif relative_y < 0:\n          actions.extend([env.world.N_UP] * abs(relative_y))\n      \n      if relative_x > 0:\n          actions.extend([env.world.N_RIGHT] * relative_x)\n      elif relative_x < 0:\n          actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  def find_workshop_for_item(item_index):\n      for workshop_index in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(workshop_index)\n          if recipe and item_index in recipe.values():\n              return workshop_index\n      return None\n\n  actions = []\n  \n  # Fetch the index for the desired item from the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index associated with this item (if any)\n  workshop_index = find_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index]).tolist()\n      \n      # Assuming there's at least one such position\n      workshop_pos = workshop_pos_list[0]\n      actions.extend(move_to_position(workshop_pos))\n      \n      # Check if already next to the workshop and facing it correctly\n      current_dir = env._current_state.dir\n      pos_offset_x = [0, 0, -1, 1]  # UP, DOWN, LEFT, RIGHT\n      pos_offset_y = [-1, 1, 0, 0]\n      \n      next_to_workshop = False\n      for dir in range(4):\n          offset_x = pos_offset_x[dir]\n          offset_y = pos_offset_y[dir]\n          if (workshop_pos[1] == env._current_state.pos[1] + offset_x and \n              workshop_pos[0] == env._current_state.pos[0] + offset_y and\n              current_dir == dir):\n              next_to_workshop = True\n              break\n      \n      if not next_to_workshop:\n          actions.append(env.world.N_USE)  # Try to use the workshop, it might work even if not perfectly aligned\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:22:04.031092", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1:\n          return env.world.LEFT\n      elif dx == 1:\n          return env.world.RIGHT\n      elif dy == -1:\n          return env.world.DOWN\n      elif dy == 1:\n          return env.world.UP\n      else:\n          return None\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor].sum() > 0:\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:22:06.296466", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1:\n          return env.world.LEFT\n      elif dx == 1:\n          return env.world.RIGHT\n      elif dy == -1:\n          return env.world.DOWN\n      elif dy == 1:\n          return env.world.UP\n      else:\n          return None\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = current[0] + i, current[1] + j\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] == 1:\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:23:11.002122", "function_name": "craft", "function_body": "  def movement_to(target_pos: tuple):\n    current_pos = env._current_state.pos\n\n    # Calculate the difference in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    if dy > 0:\n        actions.extend([craft.DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.UP for _ in range(-dy)])\n\n    if dx > 0:\n        actions.extend([craft.RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.LEFT for _ in range(-dx)])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = set()\n\n  # Find all workshops required for crafting this item\n  current_recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  while \"_key\" in current_recipe:\n      key = current_recipe[\"_key\"]\n      workshop_indices.add(env.world.workshop_indices[key])\n      current_recipe = env.world.cookbook.recipes.get(current_recipe[key], {})\n\n  # Convert the set of workshops to a list and sort it\n  workshop_indices = sorted(workshop_indices)\n  actions = []\n\n  for workshop_index in workshop_indices:\n    # Find the position of the workshop on the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n    # Choose a random position from the available workshops\n    chosen_workshop_position = tuple(workshop_positions[0])\n\n    # Move to the chosen workshop\n    actions.extend(movement_to(chosen_workshop_position))\n\n    # Add the USE action to craft at the workshop\n    actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
