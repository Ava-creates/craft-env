{"timestamp": "2025-09-03T20:57:45.235293", "function_name": "craft", "function_body": "  def find_workshop_position(workshop_indices):\n      \"\"\"Finds the position of the closest workshop from the current agent's position.\"\"\"\n      current_x, current_y = env._current_state.pos\n      grid = env._current_state.grid\n      # Use BFS to find the shortest path to a workshop\n      queue = collections.deque([(current_x, current_y, [])])\n      visited = set()\n      while queue:\n          cx, cy, path = queue.popleft()\n          \n          if (cx, cy) in visited:\n              continue\n          visited.add((cx, cy))\n          \n          for dx, dy, action in [(1, 0, 3), (-1, 0, 2), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = cx + dx, cy + dy\n              \n              # Check if the new position is within bounds and not a boundary\n              if 0 <= nx < grid.shape[1] and 0 <= ny < grid.shape[0]:\n                  if np.argmax(grid[ny, nx]) in workshop_indices:\n                      return path + [action]\n                  if np.argmax(grid[ny, nx]) != env.world.cookbook.index['BOUNDARY']:\n                      queue.append((nx, ny, path + [action]))\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the workshop required for crafting the item\n  workshop_indices = env.world.workshop_indices\n\n  # Find the shortest path to a workshop\n  path_to_workshop = find_workshop_position(workshop_indices)\n\n  if path_to_workshop:\n      actions = path_to_workshop + [4]  # Append USE action at the end\n  else:\n      print(\"No workshops found in the grid.\")\n      actions = []\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
