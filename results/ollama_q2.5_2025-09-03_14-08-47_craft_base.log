s, current_x, current_y)\n\n  # Determine the path to the chosen workshop using BFS for more efficient pathfinding\n  target_x, target_y = closest_workshop\n\n  queue = collections.deque([(current_x, current_y, [])])\n  visited = set()\n  \n  while queue:\n      cx, cy, path = queue.popleft()\n      \n      if (cx, cy) == (target_x, target_y):\n          actions.extend(path)\n          break\n\n      if (cx, cy) in visited:\n          continue\n      visited.add((cx, cy))\n      \n      # Define possible moves: RIGHT, LEFT, UP, DOWN\n      for dx, dy, action in [(1, 0, 3), (-1, 0, 2), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = cx + dx, cy + dy\n          \n          # Check if the new position is within bounds and not a boundary\n          if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n              if np.argmax(env._current_state.grid[ny, nx]) != env.world.cookbook.index['BOUNDARY']:\n                  queue.append((nx, ny, path + [action]))\n\n  # Finally, perform the USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:38:15.589156", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  try:\n      item_index = env.world.cookbook.index[item]\n  except KeyError:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(env._current_state.grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [env.world.N_ACTIONS if step == nearest_workshop_pos else direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:38:16.886612", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook\n  try:\n    item_index = env.world.cookbook.index[item]\n  except KeyError:\n    print(f\"Item {item} not found in cookbook.\")\n    return []\n\n  # Determine which workshop(s) can produce this item\n  required_workshop_indices = []\n  for recipe_output, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          # The key here refers to the input that triggers this recipe at a specific workshop\n          required_workshop_indices.append(env.world.workshop_indices[recipe_output])\n\n  # If no workshops can produce the desired item, return an empty list\n  if not required_workshop_indices:\n    print(f\"No workshop found that can produce {item}.\")\n    return []\n\n  # For simplicity, we select the first available workshop to use for crafting\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find positions of all workshops of this type in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    print(f\"No workshops found on the grid for {item}.\")\n    return []\n\n  # Calculate distances from the current position to each workshop and choose the nearest one\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Determine path to the nearest workshop using A* algorithm\n  path_to_workshop = astar(env._current_state.grid, pos, nearest_workshop_pos)\n\n  if not path_to_workshop:\n    print(f\"Unable to find a path to the nearest workshop for {item}.\")\n    return []\n\n  # Generate actions needed to move along this path and then use the workshop\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end of the path\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:38:53.298089", "function_name": "craft", "function_body": "  # First get the index of the item from the cookbook index\n  item_index = env.world.cookbook.index[item]\n\n  # Get the corresponding workshop for this item (if any)\n  if item_index in env.world.workshop_indices:\n    workshop_index = env.world.workshop_indices[env.world.workshop_indices.index(item_index)]\n  else:\n    raise ValueError(\"No workshop found for crafting this item\")\n\n  # Find a position next to a workshop\n  positions = find_positions_next_to(env, workshop_index)\n  if not positions:\n    raise ValueError(\"No valid position found next to the workshop\")\n\n  # Move to a random valid position near the workshop\n  target_pos = positions[0]\n  actions_to_move = move_to_position(env._current_state.pos, target_pos, env._current_state.dir)\n\n  # Append the USE action to actually craft the item\n  actions_to_move.append(4)  # Assuming USE is represented by index 4\n\n  return actions_to_move", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:38:54.580005", "function_name": "craft", "function_body": "  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the index of the desired item using the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find a workshop that can craft the desired item\n  for recipe in env.world.cookbook.recipes.values():\n    if item_index in recipe:\n      # Determine which workshop to use\n      workshop_index = None\n      for idx in env.world.workshop_indices:\n        if idx in recipe:\n          workshop_index = idx\n          break\n\n      if workshop_index is not None:\n        # Find the position of the nearest workshop in the grid\n        pos = find_nearest(env, workshop_index)\n\n        if pos is not None:\n          # Calculate actions to move to the workshop\n          path_actions = calculate_path_to_position(env._current_state.pos, pos)\n          actions.extend(path_actions)\n\n          # Add action to use the workshop (USE action is usually 4)\n          actions.append(4)  # Assuming USE action index is 4\n\n          return actions\n\n  raise ValueError(f\"No suitable workshop found for crafting {item}.\")", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:41:20.190853", "function_name": "craft", "function_body": "  # Get the index of the item\n  index = env.world.cookbook.index.index(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Check if the agent has all required ingredients in inventory\n  recipe_primitives = env.world.cookbook.primitives_for(index).keys()\n  current_inventory = [env.world.cookbook.index.get(p) for p in env._current_state.features_dict['inventory'].split(',') if p]\n  missing_primitives = set(recipe_primitives) - set(current_inventory)\n  \n  if missing_primitives:\n      print(f\"Missing primitives {missing_primitives} to craft {item}.\")\n      return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n\n  # Find the workshop that can make this item (assuming there is only one such workshop)\n  workshop_index = None\n  for i in range(len(env.world.workshop_indices)):\n      if any(ingredient in recipe.keys() for ingredient in recipe_primitives):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  # If no suitable workshop is found, return an empty list\n  if workshop_index is None:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n  # If no workshops are found, return an empty list\n  if len(workshop_positions) == 0:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Ensure the agent is facing the workshop before using\n  current_direction = env._current_state.dir\n  target_angle = np.arctan2(delta_y, delta_x) * 180 / np.pi\n\n  # Map angles to directions\n  direction_map = {\n      'RIGHT': ((-45, 45), (315, 360)),\n      'UP': ((45, 135),),\n      'LEFT': ((135, 225),),\n      'DOWN': ((225, 315),)\n  }\n\n  for direction, angle_ranges in direction_map.items():\n      for angle_range in angle_ranges:\n          if (angle_range[0] <= target_angle < angle_range[1]) or \\\n             (angle_range[0] > angle_range[1] and (target_angle >= angle_range[0] or target_angle < angle_range[1])):\n              actions_to_workshop.append(env.action_specs()[direction])\n              break\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:41:21.422496", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.index(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n\n  # Find the workshop that can make this item (assuming there is only one such workshop)\n  workshop_index = None\n  for i in range(len(env.world.workshop_indices)):\n      if any(ingredient in recipe.keys() for ingredient in env.world.cookbook.primitives_for(index).keys()):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  # If no suitable workshop is found, return an empty list\n  if workshop_index is None:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n  # If no workshops are found, return an empty list\n  if len(workshop_positions) == 0:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  while delta_x != 0 or delta_y != 0:\n      if abs(delta_x) > abs(delta_y):\n          step_x = np.sign(delta_x)\n          if step_x > 0:\n              actions_to_workshop.append(env.action_specs()['RIGHT'])\n          else:\n              actions_to_workshop.append(env.action_specs()['LEFT'])\n          delta_x -= step_x\n      elif abs(delta_y) >= abs(delta_x):\n          step_y = np.sign(delta_y)\n          if step_y > 0:\n              actions_to_workshop.append(env.action_specs()['UP'])\n          else:\n              actions_to_workshop.append(env.action_specs()['DOWN'])\n          delta_y -= step_y\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:43:51.952504", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def go_to_workshop(x, y):\n    actions = []\n    cx, cy = env._current_state.pos\n    dx = x - cx\n    dy = y - cy\n\n    if dx > 0:\n        actions.extend([RIGHT] * abs(dx))\n    elif dx < 0:\n        actions.extend([LEFT] * abs(dx))\n\n    if dy > 0:\n        actions.extend([DOWN] * abs(dy))\n    elif dy < 0:\n        actions.extend([UP] * abs(dy))\n\n    return actions\n\n  def find_nearest_workshop(i_workshop):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, i_workshop] == 1)\n      if len(positions) > 0:\n          cx, cy = env._current_state.pos\n          distances = [abs(x - cx) + abs(y - cy) for x, y in positions]\n          nearest_pos = tuple(positions[np.argmin(distances)])\n          return nearest_pos\n      else:\n          return None\n\n  def collect(env, primitive):\n    actions = []\n    i_primitive = env.world.cookbook.index[primitive]\n    if i_primitive not in env._current_state.inventory or env._current_state.inventory[i_primitive] == 0:\n        positions = np.argwhere(env._current_state.grid[:, :, i_primitive] == 1)\n        if len(positions) > 0:\n            nearest_pos = tuple(positions[np.argmin([abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1]) for x, y in positions])])\n            actions.extend(go_to_workshop(nearest_pos[0], nearest_pos[1]))\n            actions.append(USE)\n    return actions\n\n  def go_to_nearest_workshop(env, i_workshop):\n      nearest_workshop = find_nearest_workshop(i_workshop)\n      if nearest_workshop is not None:\n          return go_to_workshop(nearest_workshop[0], nearest_workshop[1])\n      else:\n          raise ValueError(f\"No workshop of type {i_workshop} found on the grid.\")\n      \n  actions = []\n  i_item = env.world.cookbook.index[item]\n\n  if i_item in env.world.cookbook.recipes:\n      recipe = env.world.cookbook.recipes[i_item]\n      workshops_needed = []\n      primitives_required = {}\n\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              workshops_needed.append(recipe[\"_key\"])\n          else:\n              i_ingredient = env.world.cookbook.index[ingredient]\n              if i_ingredient in env.world.cookbook.primitives:\n                  primitives_required[i_ingredient] = count\n\n      for primitive, count in primitives_required.items():\n          actions.extend(collect(env, env.world.cookbook.index.get(primitive)))\n\n      for workshop in workshops_needed:\n          i_workshop = env.world.cookbook.index[workshop]\n          nearest_pos = find_nearest_workshop(i_workshop)\n          if nearest_pos is not None:\n              actions.extend(go_to_workshop(nearest_pos[0], nearest_pos[1]))\n              actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:43:53.190248", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def go_to(x, y):\n    actions = []\n    cx, cy = env._current_state.pos\n    dx = x - cx\n    dy = y - cy\n\n    if dx > 0:\n        actions.extend([RIGHT] * abs(dx))\n    elif dx < 0:\n        actions.extend([LEFT] * abs(dx))\n\n    if dy > 0:\n        actions.extend([DOWN] * abs(dy))\n    elif dy < 0:\n        actions.extend([UP] * abs(dy))\n\n    return actions\n\n  def find_nearest(i_kind):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, i_kind] == 1)\n      if len(positions) > 0:\n          cx, cy = env._current_state.pos\n          distances = [abs(x - cx) + abs(y - cy) for x, y in positions]\n          nearest_pos = tuple(positions[np.argmin(distances)])\n          return nearest_pos\n      else:\n          return None\n\n  def collect(env, primitive):\n    actions = []\n    i_primitive = env.world.cookbook.index[primitive]\n    if i_primitive not in env._current_state.inventory or env._current_state.inventory[i_primitive] == 0:\n        nearest_pos = find_nearest(i_primitive)\n        if nearest_pos is not None:\n            actions.extend(go_to(nearest_pos[0], nearest_pos[1]))\n            actions.append(USE)\n    return actions\n\n  def go_to_workshop(env, i_workshop):\n      nearest_pos = find_nearest(i_workshop)\n      if nearest_pos is not None:\n          return go_to(nearest_pos[0], nearest_pos[1])\n      else:\n          raise ValueError(f\"No workshop of type {i_workshop} found on the grid.\")\n\n  actions = []\n  cookbook = env.world.cookbook\n  i_item = cookbook.index[item]\n\n  if i_item in cookbook.recipes:\n      recipe = cookbook.recipes[i_item]\n      workshops_needed = []\n      primitives_required = {}\n\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              workshops_needed.append(recipe[\"_key\"])\n          else:\n              i_ingredient = cookbook.index[ingredient]\n              if i_ingredient in cookbook.primitives:\n                  primitives_required[i_ingredient] = count\n\n      for primitive, count in primitives_required.items():\n          actions.extend(collect(env, cookbook.index.get(primitive)))\n\n      for workshop in workshops_needed:\n          i_workshop = cookbook.index[workshop]\n          actions.extend(go_to_workshop(env, i_workshop))\n          actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:46:27.601324", "function_name": "craft", "function_body": "  # Ensure the required primitives are in the inventory\n  index = env.world.cookbook.index.index(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n\n  # Ensure we have all the required primitives in our inventory\n  primitives_needed = env.world.cookbook.primitives_for(index)\n  for primitive_index, count in primitives_needed.items():\n      if env._current_state.inventory[primitive_index] < count:\n          print(f\"Missing {count} of primitive {env.world.cookbook.index[primitive_index]}\")\n          return []\n\n  # Find the workshop that can make this item (assuming there is only one such workshop)\n  workshop_index = None\n  for i in range(len(env.world.workshop_indices)):\n      if any(ingredient in recipe.keys() for ingredient in primitives_needed.keys()):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  # If no suitable workshop is found, return an empty list\n  if workshop_index is None:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n  # If no workshops are found, return an empty list\n  if len(workshop_positions) == 0:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Ensure the agent is facing the workshop before using\n  current_direction = env._current_state.dir\n  target_direction = np.arctan2(delta_y, delta_x) * 180 / np.pi\n\n  if -45 <= target_direction < 45 or 315 <= target_direction < 360:\n      actions_to_workshop.append(env.action_specs()['RIGHT'])\n  elif 45 <= target_direction < 135:\n      actions_to_workshop.append(env.action_specs()['UP'])\n  elif 135 <= target_direction < 225:\n      actions_to_workshop.append(env.action_specs()['LEFT'])\n  elif 225 <= target_direction < 315:\n      actions_to_workshop.append(env.action_specs()['DOWN'])\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:46:28.849540", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  index = env.world.cookbook.index.index(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Check if the recipe exists and get it\n  recipe = env.world.cookbook.recipes.get(index, {})\n  if not recipe:\n      print(f\"No recipe for item {item}.\")\n      return []\n\n  # Find the workshop(s) that can make this item (assuming there is only one such workshop)\n  workshop_indices = [idx for idx in env.world.workshop_indices \n                      if any(ingredient in recipe.keys() \n                           for ingredient in env.world.cookbook.primitives_for(index).keys())]\n  \n  # If no suitable workshops are found, return an empty list\n  if not workshop_indices:\n      print(f\"No suitable workshops found to craft {item}.\")\n      return []\n\n  # Get all positions of the workshops on the grid\n  workshop_positions = []\n  for workshop_index in workshop_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      workshop_positions.extend(positions)\n\n  # If no workshops are found, return an empty list\n  if not workshop_positions:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  # Move horizontally first (LEFT or RIGHT)\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  # Then move vertically (UP or DOWN)\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Ensure the agent is facing the workshop before using\n  current_direction = env._current_state.dir\n  target_direction = np.arctan2(delta_y, delta_x) * 180 / np.pi\n\n  if -45 <= target_direction < 45 or 315 <= target_direction < 360:\n      actions_to_workshop.append(env.action_specs()['RIGHT'])\n  elif 45 <= target_direction < 135:\n      actions_to_workshop.append(env.action_specs()['UP'])\n  elif 135 <= target_direction < 225:\n      actions_to_workshop.append(env.action_specs()['LEFT'])\n  elif 225 <= target_direction < 315:\n      actions_to_workshop.append(env.action_specs()['DOWN'])\n\n  # Add the USE action to craft the item\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:47:53.520715", "function_name": "craft", "function_body": "  def move_towards_position(env, target_pos):\n    \"\"\"Helper function to generate actions to move towards a given position.\"\"\"\n    current_pos = env._current_state.pos\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    actions = []\n    # Move horizontally\n    if x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    # Move vertically\n    if y_diff > 0:\n      actions.extend([1] * abs(y_diff))  # DOWN\n    elif y_diff < 0:\n      actions.extend([0] * abs(y_diff))  # UP\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the workshop needed to craft this item.\n  workshop_indices = []\n  for output, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_indices.append(output)\n      break\n\n  if not workshop_indices:\n    return []\n\n  # Find the nearest workshop\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  for pos, kind in np.ndenumerate(env._current_state.grid):\n    if kind in env.world.workshop_indices and env._current_state.next_to(kind) and output == item_index:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      if distance < min_distance:\n        min_distance = distance\n        nearest_workshop_pos = pos\n\n  if nearest_workshop_pos is None:\n    return []\n\n  # Generate actions to move towards the workshop\n  actions = move_towards_position(env, nearest_workshop_pos)\n  # Add the USE action to craft the item (assuming 4 is the index for the USE action)\n  actions.append(4)\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:47:54.763428", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n        return next((k for k, v in env.world.cookbook.recipes.items() if item_index in v), None)\n    return None\n\n  def find_nearest_workshop(workshop_indices):\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n    for pos, kind in np.ndenumerate(env._current_state.grid):\n      if kind in workshop_indices:\n        distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n        if distance < min_distance:\n          min_distance = distance\n          nearest_workshop_pos = pos\n    return nearest_workshop_pos\n\n  def move_towards_position(env, target_pos):\n    current_pos = env._current_state.pos\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    actions = []\n    if x_diff > 0:\n      actions.extend([3] * abs(x_diff))  # RIGHT\n    elif x_diff < 0:\n      actions.extend([2] * abs(x_diff))  # LEFT\n    if y_diff > 0:\n      actions.extend([0] * abs(y_diff))  # DOWN\n    elif y_diff < 0:\n      actions.extend([1] * abs(y_diff))  # UP\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index = get_workshop_for_item(item_index)\n  \n  if workshop_index is None:\n    return []\n\n  nearest_workshop_pos = find_nearest_workshop([workshop_index])\n  if nearest_workshop_pos is None:\n    return []\n\n  actions = move_towards_position(env, nearest_workshop_pos) + [4]  # USE action\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:49:17.636133", "function_name": "craft", "function_body": "  # Constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  index_item = env.world.cookbook.index[item]\n\n  # Find the correct workshop to use\n  workshops = env.world.workshop_indices\n  required_workshop = None\n  for workshop in workshops:\n    if env._current_state.next_to(workshop):\n      required_workshop = workshop\n      break\n\n  if not required_workshop:\n    return []\n\n  actions = []\n  \n  # Move to the required workshop\n  while not env._current_state.grid[env._current_state.pos] == required_workshop:\n    pos_x, pos_y = env._current_state.pos\n    direction = env._current_state.dir\n    \n    if direction == UP:\n      if pos_y > 0 and env._current_state.grid[pos_x, pos_y - 1, required_workshop] == 1:\n        actions.append(USE)\n      else:\n        actions.append(DOWN)\n    elif direction == DOWN:\n      if pos_y < env._current_state.world.grid.shape[1] - 1 and env._current_state.grid[pos_x, pos_y + 1, required_workshop] == 1:\n        actions.append(USE)\n      else:\n        actions.append(UP)\n    elif direction == LEFT:\n      if pos_x > 0 and env._current_state.grid[pos_x - 1, pos_y, required_workshop] == 1:\n        actions.append(USE)\n      else:\n        actions.append(RIGHT)\n    elif direction == RIGHT:\n      if pos_x < env._current_state.world.grid.shape[0] - 1 and env._current_state.grid[pos_x + 1, pos_y, required_workshop] == 1:\n        actions.append(USE)\n      else:\n          actions.append(LEFT)\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:49:19.034335", "function_name": "craft", "function_body": "  # Initialize a list to store the actions\n  actions = []\n\n  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item is a primitive resource or requires crafting\n  if item_index in env.world.cookbook.primitives:\n    # If it's a primitive, we cannot craft it; return an empty action list\n    return []\n\n  # Find the workshop that can craft the desired item\n  for recipe_output, recipe_ingredients in env.world.cookbook.recipes.items():\n    if recipe_output == item_index:\n      # Assuming there is only one workshop that can craft this item (or we use the first one found)\n      workshop_indices = [workshop_index for workshop_index in env.world.workshop_indices if workshop_index in recipe_ingredients]\n      if not workshop_indices:\n        # If no workshop can craft this item, return an empty action list\n        return []\n\n      # Choose the first available workshop\n      workshop_index = workshop_indices[0]\n\n  # Find the position of the nearest workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if not workshop_positions.size:\n    # If no workshops are found, return an empty action list\n    return []\n\n  # Find the closest workshop to the current agent's position\n  agent_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  nearest_workshop_index = np.argmin(distances)\n  nearest_workshop_position = tuple(workshop_positions[nearest_workshop_index])\n\n  # Move the agent to the nearest workshop\n  while env._current_state.pos != nearest_workshop_position:\n    # Calculate the direction vector from the current position to the workshop position\n    direction_vector = (nearest_workshop_position[0] - agent_pos[0], nearest_workshop_position[1] - agent_pos[1])\n\n    # Determine the action based on the direction vector\n    if direction_vector == (1, 0):\n      actions.append(env.world.n_actions)  # RIGHT\n    elif direction_vector == (-1, 0):\n      actions.append(2)  # LEFT\n    elif direction_vector == (0, 1):\n      actions.append(env.world.n_actions + 1)  # UP\n    elif direction_vector == (0, -1):\n      actions.append(3)  # DOWN\n\n    # Update the agent's position for the next iteration\n    agent_pos = env._current_state.pos\n\n  # Perform the USE action to craft the item at the workshop\n  actions.append(env.world.n_actions + 2)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:50:12.807214", "function_name": "craft", "function_body": "  # Find the recipe for the given item\n  try:\n      item_index = env.world.cookbook.index[item]\n  except KeyError:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe available for crafting {item}\")\n\n  # Fetch ingredients and their counts required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  ingredient_indices_and_counts = [(ingredient, count) for ingredient, count in recipe.items() if ingredient != \"_key\"]\n\n  actions_to_craft_item = []\n\n  # Collect ingredients that are not already in inventory\n  inventory = env._current_state.inventory\n\n  for ingredient_index, required_count in ingredient_indices_and_counts:\n      ingredient_name = env.world.cookbook.index.get(ingredient_index)\n      \n      # Check if the ingredient is already available in the inventory in sufficient quantity\n      if inventory[ingredient_index] >= required_count:\n          continue\n      \n      additional_needed_count = required_count - inventory[ingredient_index]\n      \n      # If the ingredient has a recipe, we need to craft it\n      if ingredient_index in env.world.cookbook.recipes:\n          actions_to_craft_ingredient = craft_v2(env, ingredient_name)\n          actions_to_craft_item.extend(actions_to_craft_ingredient)\n\n      else:\n          # Collect the primitive ingredients directly from the environment\n          actions_to_collect_primitive = collect_v1(env, ingredient_name, additional_needed_count)\n          actions_to_craft_item.extend(actions_to_collect_primitive)\n\n  # Now that all ingredients are collected/crafted, proceed to craft the item itself\n  actions_to_craft_workshop = craft_v0(env, item)\n  actions_to_craft_item.extend(actions_to_craft_workshop)\n\n  return actions_to_craft_item", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:50:14.109496", "function_name": "craft", "function_body": "  try:\n      item_index = env.world.cookbook.index[item]\n  except KeyError:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(env._current_state.grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [env.world.N_ACTIONS if step == nearest_workshop_pos else direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:51:27.054087", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      current_pos = env._current_state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      if relative_y > 0:\n          actions.extend([env.world.N_DOWN] * relative_y)\n      elif relative_y < 0:\n          actions.extend([env.world.N_UP] * abs(relative_y))\n      \n      if relative_x > 0:\n          actions.extend([env.world.N_RIGHT] * relative_x)\n      elif relative_x < 0:\n          actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  def find_workshop_for_item(item_index):\n      # Find all workshops that can produce the item\n      potential_workshops = []\n      for workshop_index in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(workshop_index)\n          if recipe and item_index in recipe.values():\n              potential_workshops.append(workshop_index)\n      \n      # Prioritize the nearest workshop\n      min_distance = float('inf')\n      closest_workshop_index = None\n      for workshop_index in potential_workshops:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index]).tolist()\n          if not workshop_positions:\n              continue\n          \n          for pos in workshop_positions:\n              distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_index = workshop_index\n      \n      return closest_workshop_index\n\n  actions = []\n  \n  # Fetch the index for the desired item from the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the nearest workshop index associated with this item (if any)\n  workshop_index = find_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_index]).tolist()\n      \n      # Prioritize the closest position to move to\n      min_distance = float('inf')\n      closest_workshop_pos = None\n      for pos in workshop_pos_list:\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = pos\n      \n      actions.extend(move_to_position(closest_workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(env.world.N_USE)\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:51:28.338041", "function_name": "craft", "function_body": "  def move_to_position(target_pos):\n      current_pos = env._current_state.pos\n      relative_x = target_pos[1] - current_pos[1]\n      relative_y = target_pos[0] - current_pos[0]\n\n      actions = []\n      \n      # Calculate the shortest path (using Manhattan distance)\n      if abs(relative_x) > abs(relative_y):\n          if relative_x > 0:\n              actions.extend([env.world.N_RIGHT] * relative_x)\n          else:\n              actions.extend([env.world.N_LEFT] * abs(relative_x))\n          \n          if relative_y > 0:\n              actions.extend([env.world.N_DOWN] * relative_y)\n          else:\n              actions.extend([env.world.N_UP] * abs(relative_y))\n      else:\n          if relative_y > 0:\n              actions.extend([env.world.N_DOWN] * relative_y)\n          else:\n              actions.extend([env.world.N_UP] * abs(relative_y))\n          \n          if relative_x > 0:\n              actions.extend([env.world.N_RIGHT] * relative_x)\n          else:\n              actions.extend([env.world.N_LEFT] * abs(relative_x))\n\n      return actions\n\n  def find_workshop_for_item(item_index):\n      for workshop_index in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(workshop_index)\n          if recipe and item_index in recipe.values():\n              return workshop_index\n      return None\n\n  def get_workshop_positions(workshop_index):\n      return np.argwhere(env._current_state.grid[:, :, workshop_index]).tolist()\n\n  actions = []\n  \n  # Fetch the index for the desired item from the cookbook's index\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop index associated with this item (if any)\n  workshop_index = find_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      workshop_positions = get_workshop_positions(workshop_index)\n      \n      # Sort positions based on Manhattan distance to the current position\n      current_pos = env._current_state.pos\n      workshop_positions.sort(key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n      \n      # Move to the nearest workshop position\n      workshop_pos = workshop_positions[0]\n      actions.extend(move_to_position(workshop_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(env.world.N_USE)\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:53:36.420032", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              if grid[neighbor] == 1:  # Assuming 1 represents an obstacle\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:53:38.014053", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1:\n          return env.world.LEFT\n      elif dx == 1:\n          return env.world.RIGHT\n      elif dy == -1:\n          return env.world.DOWN\n      elif dy == 1:\n          return env.world.UP\n      else:\n          return None\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              # Check if the neighbor is passable (i.e., no obstacle)\n              if np.any(grid[neighbor] == 1):\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  if not path_to_workshop:\n      return []\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Filter out None actions (in case of invalid movements)\n  actions_to_move = list(filter(None, actions_to_move))\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:55:12.326005", "function_name": "craft", "function_body": "  def movement_to(target_pos: tuple):\n    current_pos = env._current_state.pos\n\n    # Calculate the difference in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    # Determine the direction to move first based on distance\n    if abs(dx) > abs(dy):\n        if dx > 0:\n            actions.extend([craft.RIGHT for _ in range(dx)])\n        elif dx < 0:\n            actions.extend([craft.LEFT for _ in range(-dx)])\n        if dy > 0:\n            actions.extend([craft.DOWN for _ in range(dy)])\n        elif dy < 0:\n            actions.extend([craft.UP for _ in range(-dy)])\n    else:\n        if dy > 0:\n            actions.extend([craft.DOWN for _ in range(dy)])\n        elif dy < 0:\n            actions.extend([craft.UP for _ in range(-dy)])\n        if dx > 0:\n            actions.extend([craft.RIGHT for _ in range(dx)])\n        elif dx < 0:\n            actions.extend([craft.LEFT for _ in range(-dx)])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = set()\n\n  # Find all workshops required for crafting this item\n  current_recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  while \"_key\" in current_recipe:\n      key = current_recipe[\"_key\"]\n      workshop_indices.add(env.world.workshop_indices[key])\n      current_recipe = env.world.cookbook.recipes.get(current_recipe[key], {})\n\n  # Convert the set of workshops to a list and sort it\n  workshop_indices = sorted(workshop_indices)\n  actions = []\n\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n      # Choose a random position from the available workshops\n      chosen_workshop_position = tuple(workshop_positions[0])\n\n      # Move to the chosen workshop\n      actions.extend(movement_to(chosen_workshop_position))\n\n      # Add the USE action to craft at the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:55:13.676264", "function_name": "craft", "function_body": "  def movement_to(target_pos: tuple):\n    current_pos = env._current_state.pos\n\n    # Calculate the difference in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    if dy > 0:\n        actions.extend([craft.DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.UP for _ in range(-dy)])\n\n    # Adjust direction to face the correct horizontal position\n    if dx > 0:\n        actions.append(craft.RIGHT)\n        actions.extend([craft.MOVE_FORWARD for _ in range(dx)])\n    elif dx < 0:\n        actions.append(craft.LEFT)\n        actions.extend([craft.MOVE_FORWARD for _ in range(-dx)])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = set()\n\n  # Find all workshops required for crafting this item\n  current_recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  while \"_key\" in current_recipe:\n      key = current_recipe[\"_key\"]\n      workshop_indices.add(env.world.workshop_indices[key])\n      current_recipe = env.world.cookbook.recipes.get(current_recipe[key], {})\n\n  # Convert the set of workshops to a list and sort it\n  workshop_indices = sorted(workshop_indices)\n  actions = []\n\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n      # Choose a random position from the available workshops\n      chosen_workshop_position = tuple(workshop_positions[0])\n\n      # Move to the chosen workshop\n      actions.extend(movement_to(chosen_workshop_position))\n\n      # Add the USE action to craft at the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:57:55.265535", "function_name": "craft", "function_body": "  def get_workshop_positions(workshop_index):\n      workshop_positions = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n                  workshop_positions.append((x, y))\n      return workshop_positions\n\n  def get_closest_workshop(workshops, current_x, current_y):\n      closest_workshop = min(workshops, key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y))\n      return closest_workshop\n\n  item_index = env.world.cookbook.index[item]\n\n  # Initialize an empty list to store the actions needed to craft the item\n  actions = []\n\n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      print(\"No recipe found for the item.\")\n      return actions\n\n  # Identify which workshop should be used for crafting based on the first ingredient that is a workshop.\n  workshop_index = None\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient in env.world.workshop_indices:\n          workshop_index = ingredient\n          break\n\n  # If no specific workshop index was found, default to the first available workshop.\n  if workshop_index is None:\n      workshop_index = env.world.workshop_indices[0]\n\n  # Find all positions of the identified workshops in the grid\n  workshop_positions = get_workshop_positions(workshop_index)\n\n  # If no workshops were found, print a message and return the empty actions list\n  if not workshop_positions:\n      print(\"No workshops found in the grid.\")\n      return actions\n\n  # Calculate distances from the current position to each workshop and choose the closest one\n  current_x, current_y = env._current_state.pos\n  closest_workshop = get_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Determine the path to the chosen workshop using BFS for a more optimal path\n  target_x, target_y = closest_workshop\n\n  queue = collections.deque([(current_x, current_y, [])])\n  visited = set()\n  \n  while queue:\n      cx, cy, path = queue.popleft()\n      \n      if (cx, cy) == (target_x, target_y):\n          actions.extend(path)\n          break\n\n      if (cx, cy) in visited:\n          continue\n      visited.add((cx, cy))\n      \n      # Define possible moves: RIGHT, LEFT, UP, DOWN\n      for dx, dy, action in [(1, 0, 3), (-1, 0, 2), (0, -1, 0), (0, 1, 1)]:\n          nx, ny = cx + dx, cy + dy\n          \n          # Check if the new position is within bounds and not a boundary\n          if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n              if np.argmax(env._current_state.grid[ny, nx]) != env.world.cookbook.index['BOUNDARY']:\n                  queue.append((nx, ny, path + [action]))\n\n  # Finally, perform the USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
