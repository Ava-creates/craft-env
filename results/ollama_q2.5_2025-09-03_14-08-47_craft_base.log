{"timestamp": "2025-09-04T05:58:27.110110", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, workshop_indices):\n    pos = env._current_state.pos\n    nearest_distance = float('inf')\n    nearest_pos = None\n    \n    for idx in workshop_indices:\n      positions = np.argwhere(grid[:, :, idx] > 0)\n      for position in positions:\n        distance = abs(position[0] - pos[0]) + abs(position[1] - pos[1])\n        if distance < nearest_distance:\n          nearest_distance = distance\n          nearest_pos = tuple(position)\n    \n    return nearest_workshop_pos\n  \n  def move_to(pos, current_pos):\n    dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n    actions = []\n    \n    # Determine the direction to face for movement\n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(0)  # Move down\n        dx -= 1\n      elif dx < 0:\n        actions.append(1)  # Move up\n        dx += 1\n      if dy > 0:\n        actions.append(3)  # Move right\n        dy -= 1\n      elif dy < 0:\n        actions.append(2)  # Move left\n        dy += 1\n    \n    return actions\n  \n  def orient_towards(target_pos, current_pos):\n    dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    if dx > 0:\n      return 0  # DOWN\n    elif dx < 0:\n      return 1  # UP\n    elif dy > 0:\n      return 3  # RIGHT\n    else:\n      return 2  # LEFT\n\n  def get_primitive_actions(primitive):\n    primitive_index = env.world.cookbook.index[primitive]\n    return [env.world.COLLECT_FUNC, primitive_index]\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  actions = []\n  \n  # Find the index for the desired item in the cookbook's index\n  item_index = index[item]\n  \n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n    \n  recipe = cookbook.recipes.get(item_index)\n  if recipe is None:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Determine which workshop to use based on the kind of item\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  nearest_workshop_pos = find_nearest_workshop(grid, workshop_indices)\n  \n  if nearest_workshop_pos is None:\n    raise ValueError(\"No workshop found on the grid.\")\n    \n  current_pos = env._current_state.pos\n  \n  # Calculate the actions needed to move to the nearest workshop\n  move_actions = move_to(nearest_workshop_pos, current_pos)\n  \n  actions.extend(move_actions)\n\n  # Orient towards the nearest workshop (optional but can be useful)\n  orient_action = orient_towards(nearest_workshop_pos, current_pos)\n  if orient_action != env._current_state.dir:\n      actions.append(orient_action)\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T05:58:29.019130", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, workshop_indices):\n    pos = env._current_state.pos\n    nearest_distance = float('inf')\n    nearest_pos = None\n    \n    for idx in workshop_indices:\n      positions = np.argwhere(grid[:, :, idx] > 0)\n      for position in positions:\n        distance = abs(position[0] - pos[0]) + abs(position[1] - pos[1])\n        if distance < nearest_distance:\n          nearest_distance = distance\n          nearest_pos = tuple(position)\n    \n    return nearest_workshop_pos\n  \n  def move_to(pos, current_pos):\n    dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n    actions = []\n    \n    # Determine the direction to face for movement\n    if dy > 0:\n      actions.extend([3] * abs(dy))  # Move right\n    elif dy < 0:\n      actions.extend([2] * abs(dy))  # Move left\n    if dx > 0:\n      actions.extend([0] * abs(dx))  # Move down\n    elif dx < 0:\n      actions.extend([1] * abs(dx))  # Move up\n    \n    return actions\n  \n  def orient_towards(target_pos, current_pos):\n    dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    if dx > 0:\n        return 0  # DOWN\n    elif dx < 0:\n        return 1  # UP\n    elif dy > 0:\n        return 3  # RIGHT\n    else:\n        return 2  # LEFT\n\n  def get_primitive_actions(primitive):\n      primitive_index = env.world.cookbook.index[primitive]\n      return [env.world.COLLECT_FUNC, primitive_index]\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  \n  actions = []\n  \n  # Find the index for the desired item in the cookbook's index\n  item_index = index[item]\n  \n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n    \n  recipe = cookbook.recipes.get(item_index)\n  if recipe is None:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Determine which workshop to use based on the kind of item\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  nearest_workshop_pos = find_nearest_workshop(grid, workshop_indices)\n  \n  if nearest_workshop_pos is None:\n    raise ValueError(\"No workshop found on the grid.\")\n    \n  current_pos = env._current_state.pos\n  \n  # Calculate the actions needed to move to the nearest workshop\n  move_actions = move_to(nearest_workshop_pos, current_pos)\n  \n  actions.extend(move_actions)\n\n  # Orient towards the nearest workshop (optional but can be useful)\n  orient_action = orient_towards(nearest_workshop_pos, current_pos)\n  if orient_action != env._current_state.dir:\n      actions.append(orient_action)\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # USE action\n  \n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T05:59:41.364049", "function_name": "craft", "function_body": "  def find_closest_workshop(workshops):\n    current_pos = env._current_state.pos\n    closest_distance = float('inf')\n    closest_position = None\n    \n    for workshop in workshops:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop] > 0)\n      if len(workshop_positions) == 0:\n        continue\n      \n      # Calculate the Manhattan distance to each workshop position\n      distances = [abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]) for pos in workshop_positions]\n      \n      # Find the minimum distance to this workshop type\n      min_distance = min(distances)\n      \n      if min_distance < closest_distance:\n        closest_distance = min_distance\n        closest_position = workshop_positions[np.argmin(distances)]\n    \n    return closest_position\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check which workshops are required to craft the item (if any)\n  workshop_indices_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n\n  if workshop_indices_needed:\n    target_position = find_closest_workshop(workshop_indices_needed)\n\n    if target_position is None:\n      raise ValueError(f\"No workshop found for {item}\")\n\n    # Move to the closest workshop\n    current_pos = env._current_state.pos\n    actions.extend(move_to(env, current_pos, tuple(target_position)))\n    \n    # Perform the USE action at the workshop\n    actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
