{"timestamp": "2025-09-04T00:32:14.535728", "function_name": "craft", "function_body": "  def move_to(pos, target):\n      x_diff = target[0] - pos[0]\n      y_diff = target[1] - pos[1]\n      \n      actions = []\n      if x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n      elif x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      \n      if y_diff < 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff > 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check which workshops are required to craft the item (if any)\n  workshop_indices_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n\n  if workshop_indices_needed:\n    # Choose the first available workshop\n    workshop_index = workshop_indices_needed[0]\n    \n    # Locate the positions of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for {item}\")\n\n    target_position = workshop_positions[0]\n    \n    # Move to the workshop\n    current_pos = env._current_state.pos\n    actions.extend(move_to(current_pos, target_position))\n    \n    # Perform the USE action at the workshop\n    actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T00:32:16.414010", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Check which workshops are required to craft the item (if any)\n  workshop_indices_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n\n  if workshop_indices_needed:\n    # Choose the first available workshop\n    workshop_index = workshop_indices_needed[0]\n    \n    # Locate the positions of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for {item}\")\n\n    target_position = workshop_positions[0]\n    \n    # Move to the workshop\n    current_pos = env._current_state.pos\n    actions.extend(move_to(env, current_pos, target_position))\n    \n    # Perform the USE action at the workshop\n    actions.append(4)  # Assuming 4 is the index for the USE action\n\n  # Collect required primitives if not already in inventory\n  primitives_needed = [env.world.cookbook.primitives.index[primitive] for primitive in env.world.cookbook.primitives_for(item_index)]\n  \n  for primitive_index in primitives_needed:\n    if env._current_state.inventory[primitive_index] == 0:\n      actions.extend(collect_primitive(env, primitive_index))\n\n  return actions", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-04T00:32:47.664175", "function_name": "craft", "function_body": "  # Determine the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe (if not, there's nothing to do)\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Find all workshops that can make this item\n  valid_workshops = [\n      i_w for i_w, w in enumerate(env.world.workshop_indices) \n      if i_w in env.world.cookbook.recipes[item_index]\n  ]\n\n  actions = []\n  \n  # Move to the first available workshop and perform the craft action\n  if valid_workshops:\n    workshop_index = valid_workshops[0]\n\n    # Ensure we are not already at the workshop by checking current position\n    workshop_pos = env._current_state.grid[:, :, workshop_index].nonzero()\n    if workshop_pos:\n      nearest_workshop = closest_grid_position(\n          env._current_state.pos, workshop_pos)\n      \n      # Move to the nearest workshop\n      actions.extend(move_to(env, nearest_workshop))\n    \n    # Perform the craft action (USE)\n    actions.append(craft.action.USE)\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
