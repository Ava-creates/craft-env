m\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n\n  return actions_to_workshop + actions_to_use", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:13:42.399407", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine the workshop type needed for crafting this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  # Extract the \"_key\" value which represents the workshop type required\n  workshop_type = recipe.get(\"_key\")\n  if not workshop_type:\n    raise ValueError(f\"No workshop type specified in recipe for {item}\")\n  \n  # Convert workshop type name to index\n  workshop_index = env.world.cookbook.index[workshop_type]\n  \n  # Find the position of the nearest workshop of the required type\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_type} workshops found in the grid\")\n  \n  closest_workshop_position = min(\n      workshop_positions, \n      key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n  \n  # Determine the actions needed to move to the closest workshop\n  actions_to_move_to_workshop = move_to_position(env, closest_workshop_position)\n  \n  # Add the USE action to start crafting at the workshop\n  return actions_to_move_to_workshop + [craft.USE]", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:13:43.642069", "function_name": "craft", "function_body": "  def find_workshop_index(item_index):\n    for workshop_indices in env.world.workshop_indices:\n      if workshop_indices in env.world.cookbook.recipes[item_index]:\n        return workshop_indices\n    return None\n\n  actions = []\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the nearest workshop that can craft this item.\n  workshop_index = find_workshop_index(item_index)\n  if workshop_index is None:\n    raise ValueError(f\"No workshop found to craft {item}\")\n    \n  # Move to the workshop\n  # Placeholder for movement logic to the workshop (to be implemented)\n\n  # Perform USE action at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:15:03.212517", "function_name": "craft", "function_body": "  def movement_to(target_pos: tuple):\n    current_pos = env._current_state.pos\n\n    # Calculate the difference in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    if dy > 0:\n        actions.extend([craft.DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.UP for _ in range(-dy)])\n\n    if dx > 0:\n        actions.extend([craft.RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.LEFT for _ in range(-dx)])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = set()\n\n  # Find all workshops required for crafting this item\n  current_recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  while \"_key\" in current_recipe:\n      key = current_recipe[\"_key\"]\n      workshop_indices.add(env.world.workshop_indices[key])\n      current_recipe = env.world.cookbook.recipes.get(current_recipe[key], {})\n\n  # Convert the set of workshops to a list and sort it\n  workshop_indices = sorted(workshop_indices)\n  actions = []\n\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n      # Choose a random position from the available workshops\n      chosen_workshop_position = tuple(workshop_positions[0])\n\n      # Move to the chosen workshop\n      actions.extend(movement_to(chosen_workshop_position))\n\n      # Add the USE action to craft at the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
