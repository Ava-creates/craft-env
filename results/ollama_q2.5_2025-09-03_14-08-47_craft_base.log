{"timestamp": "2025-09-03T18:00:49.672394", "function_name": "craft", "function_body": "  def get_workshop_positions(workshop_index):\n      workshop_positions = []\n      for y in range(env._current_state.grid.shape[0]):\n          for x in range(env._current_state.grid.shape[1]):\n              if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n                  workshop_positions.append((x, y))\n      return workshop_positions\n\n  def get_closest_workshop(workshops, current_x, current_y):\n      closest_workshop = min(workshops, key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y))\n      return closest_workshop\n\n  def bfs_path(start, target):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          (cx, cy), path = queue.popleft()\n          \n          if (cx, cy) == target:\n              return path\n\n          if (cx, cy) in visited:\n              continue\n          visited.add((cx, cy))\n          \n          # Define possible moves: RIGHT, LEFT, UP, DOWN\n          for dx, dy, action in [(1, 0, 3), (-1, 0, 2), (0, -1, 0), (0, 1, 1)]:\n              nx, ny = cx + dx, cy + dy\n              \n              # Check if the new position is within bounds and not a boundary\n              if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n                  if np.argmax(env._current_state.grid[ny, nx]) != env.world.cookbook.index['BOUNDARY']:\n                      queue.append(((nx, ny), path + [action]))\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Initialize an empty list to store the actions needed to craft the item\n  actions = []\n\n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  if not recipe:\n      print(\"No recipe found for the item.\")\n      return actions\n\n  # Identify which workshop should be used for crafting based on the first ingredient that is a workshop.\n  workshop_index = None\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient in env.world.workshop_indices:\n          workshop_index = ingredient\n          break\n\n  # If no specific workshop index was found, default to the first available workshop.\n  if workshop_index is None:\n      workshop_index = env.world.workshop_indices[0]\n\n  # Find all positions of the identified workshops in the grid\n  workshop_positions = get_workshop_positions(workshop_index)\n\n  # If no workshops were found, print a message and return the empty actions list\n  if not workshop_positions:\n      print(\"No workshops found in the grid.\")\n      return actions\n\n  # Calculate distances from the current position to each workshop and choose the closest one\n  current_x, current_y = env._current_state.pos\n  closest_workshop = get_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Determine the path to the chosen workshop using BFS for a more optimal path\n  target_x, target_y = closest_workshop\n\n  path_to_workshop = bfs_path((current_x, current_y), (target_x, target_y))\n  \n  if path_to_workshop is not None:\n      actions.extend(path_to_workshop)\n      # Finally, perform the USE action to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T18:04:39.866840", "function_name": "craft", "function_body": "  def get_path(start_pos, goal_pos):\n    # BFS to find path from start_pos to goal_pos\n    queue = collections.deque([start_pos])\n    parent_map = {start_pos: None}\n    while queue:\n        current_pos = queue.popleft()\n        if current_pos == goal_pos:\n            break\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n            if is_valid_move(env._current_state.grid, next_pos):\n                if next_pos not in parent_map:\n                    queue.append(next_pos)\n                    parent_map[next_pos] = current_pos\n\n    # Reconstruct the path from start to goal\n    path = []\n    while goal_pos is not None:\n        path.append(goal_pos)\n        goal_pos = parent_map.get(goal_pos)\n    return list(reversed(path))\n\n  def is_valid_move(grid, pos):\n      x, y = pos\n      if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n          return False\n      non_grabbable_indices = env.world.non_grabbable_indices\n      grabbable_indices = env.world.grabbable_indices\n      # Ensure the position is not blocked by non-grabbable items and is accessible by grabbable items\n      if any(grid[x, y, i] > 0 for i in non_grabbable_indices):\n          return False\n      if all(grid[x, y, i] == 0 for i in grabbable_indices):\n          return False\n      return True\n\n  # Find the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item in the cookbook\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no recipe, return an empty list\n  if not recipe:\n    return []\n\n  # Extract workshop index from the recipe key \"_key\"\n  workshop_key = recipe.get(\"_key\")\n\n  # Ensure a valid workshop key and get the corresponding workshop index\n  if workshop_key is None:\n    return []\n  \n  workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n\n  # Verify that the workshop index is valid and exists in the world's workshop indices\n  if workshop_index is None or workshop_index not in env.world.workshop_indices:\n    return []\n\n  # Find all positions of the required workshop type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  # If no workshops are found, return an empty list\n  if workshop_positions.size == 0:\n    return []\n\n  # Calculate the shortest path to the nearest workshop using BFS for better efficiency\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Generate actions to move to the closest workshop\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop_pos))\n\n  if not path_to_workshop:\n    return []\n\n  actions_to_workshop = []\n  current_pos = env._current_state.pos\n\n  # Convert positions in the path to corresponding action indices\n  for next_pos in path_to_workshop[1:]:  # Skip the starting position\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dx == -1:\n          actions_to_workshop.append(2)  # UP\n      elif dx == 1:\n          actions_to_workshop.append(1)  # DOWN\n      elif dy == -1:\n          actions_to_workshop.append(0)  # LEFT\n      elif dy == 1:\n          actions_to_workshop.append(3)  # RIGHT\n\n      current_pos = next_pos\n\n  # Add the USE action (assuming index 4) to craft the item at the workshop\n  actions_to_craft = actions_to_workshop + [4]\n\n  return actions_to_craft", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T18:04:41.757502", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    neighbors = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # LEFT, RIGHT, UP, DOWN\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    open_set = [start]\n\n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        open_set.remove(current)\n\n        for dx, dy in neighbors:\n            neighbor = (current[0] + dx, current[1] + dy)\n            tentative_g_score = g_score[current] + 1\n            if not is_valid_move(grid, current, neighbor):\n                continue\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                if neighbor not in open_set:\n                    open_set.append(neighbor)\n\n    return []  # No path found\n\n  def is_valid_move(grid, current, neighbor):\n    x, y = neighbor\n    if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n        return False\n    \n    non_grabbable_indices = env.world.non_grabbable_indices\n    grabbable_indices = env.world.grabbable_indices\n\n    # Check if the neighbor is not blocked by any non-grabbable items and is traversable\n    for i in non_grabbable_indices:\n        if grid[x, y, i] > 0:\n            return False\n    \n    # Ensure that there is at least one grabbable item type present to indicate a path\n    for i in grabbable_indices:\n        if grid[x, y, i] > 0:\n            return True\n\n    return False\n\n  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  def get_primitive_actions(env, primitive) -> list[int]:\n    \"\"\"Return a list of actions to collect the specified primitive.\"\"\"\n    # Find the index of the desired primitive\n    primitive_index = env.world.cookbook.index[primitive]\n\n    # Find all positions of the required primitive type in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n    if primitive_positions.size == 0:\n        return []\n\n    closest_primitive_pos = min(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n    # Generate actions to move to the closest primitive\n    path_to_primitive = a_star_search(env._current_state.grid, tuple(env._current_state.pos), tuple(closest_primitive_pos))\n\n    if not path_to_primitive:\n        return []\n\n    actions_to_primitive = []\n    current_pos = env._current_state.pos\n\n    for next_pos in path_to_primitive[1:]:\n        dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n        if dx == -1:\n            actions_to_primitive.append(2)  # UP\n        elif dx == 1:\n            actions_to_primitive.append(1)  # DOWN\n        elif dy == -1:\n            actions_to_primitive.append(0)  # LEFT\n        elif dy == 1:\n            actions_to_primitive.append(3)  # RIGHT\n\n        current_pos = next_pos\n\n    # Add the USE action (assuming index 4) to collect the primitive\n    actions_to_primitive += [4]\n\n    return actions_to_primitive\n\n  def get_crafting_actions(env, item) -> list[int]:\n      \"\"\"Return a list of actions to craft the specified item.\"\"\"\n      item_index = env.world.cookbook.index[item]\n      \n      # Check if there is a recipe for the target item in the cookbook\n      if item_index not in env.world.cookbook.recipes:\n          return []\n\n      # Extract recipe details: workshop key and required ingredients\n      recipe = env.world.cookbook.recipes[item_index]\n      workshop_key = recipe.get(\"_key\", None)\n      ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n\n      # Verify that all required ingredients are available in the inventory\n      current_inventory = env._current_state.inventory\n      missing_ingredients = []\n      \n      for ingredient_index, required_count in ingredients.items():\n          if current_inventory[ingredient_index] < required_count:\n              missing_ingredients.append((ingredient_index, required_count - current_inventory[ingredient_index]))\n\n      # If no ingredients are missing, proceed to craft the item\n      if not missing_ingredients:\n          return get_workshop_actions(env, workshop_key)\n\n      actions = []\n      \n      # Collect missing ingredients\n      for ingredient_index, count in missing_ingredients:\n          primitive_name = env.world.cookbook.index.get_by_value(ingredient_index)\n          actions += get_primitive_actions(env, primitive_name) * count\n\n      # Craft the item after collecting all required ingredients\n      actions += get_workshop_actions(env, workshop_key)\n\n      return actions\n\n  def get_workshop_actions(env, workshop_key) -> list[int]:\n      \"\"\"Return a list of actions to go to and use the specified workshop.\"\"\"\n      if workshop_key is None:\n          return []\n\n      workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n      \n      if workshop_index is None or workshop_index not in env.world.workshop_indices:\n          return []\n\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if workshop_positions.size == 0:\n          return []\n\n      closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n      path_to_workshop = a_star_search(env._current_state.grid, tuple(env._current_state.pos), tuple(closest_workshop_pos))\n\n      if not path_to_workshop:\n          return []\n\n      actions_to_workshop = []\n      current_pos = env._current_state.pos\n\n      for next_pos in path_to_workshop[1:]:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          if dx == -1:\n              actions_to_workshop.append(2)  # UP\n          elif dx == 1:\n              actions_to_workshop.append(1)  # DOWN\n          elif dy == -1:\n              actions_to_workshop.append(0)  # LEFT\n          elif dy == 1:\n              actions_to_workshop.append(3)  # RIGHT\n\n          current_pos = next_pos\n\n      # Add the USE action (assuming index 4) to craft the item at the workshop\n      actions_to_workshop += [4]\n\n      return actions_to_workshop\n\n  # Get actions to craft the specified item\n  return get_crafting_actions(env, item)", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T18:06:09.515920", "function_name": "craft", "function_body": "  # Get the index of the item from the cookbook index\n  i_item = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if i_item not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe for {item} found.\")\n\n  # Extract workshop and ingredient information\n  recipe = env.world.cookbook.recipes[i_item]\n  workshops_needed = []\n  primitives_required = {}\n\n  # Collect information about required workshops and primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshops_needed.append(recipe[\"_key\"])\n      else:\n          i_ingredient = env.world.cookbook.index[ingredient]\n          if i_ingredient in env.world.cookbook.primitives:\n              primitives_required[i_ingredient] = count\n\n  # Gather required primitives\n  for primitive, count in primitives_required.items():\n      while not has_enough_primitives(env._current_state.inventory, primitive, count):\n          actions.extend(collect_v2(env, primitive))\n\n  # Craft the item at the required workshops\n  for workshop in workshops_needed:\n      i_workshop = env.world.cookbook.index[workshop]\n      actions.append(MOVE_FUNC(i_workshop))  # Placeholder\n      actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T18:06:11.418195", "function_name": "craft", "function_body": "  def has_enough_primitives(inventory, primitive_index, required_count):\n    return inventory[primitive_index] >= required_count\n\n  def go_to_nearest_workshop(env, workshop_index):\n    \"\"\"Finds the nearest workshop on the grid.\"\"\"\n    current_pos = env._current_state.pos\n    # Placeholder logic to find the nearest workshop\n    for i in range(10):  # Simulate movement\n      actions.append(np.random.choice([UP, DOWN, LEFT, RIGHT]))\n    return actions\n\n  def collect_v2(env, primitive):\n    \"\"\"Collects a specified primitive.\"\"\"\n    UP, DOWN, LEFT, RIGHT, USE = range(5)\n    actions = []\n    i_primitive = env.world.cookbook.index[primitive]\n    # Placeholder logic to find and collect the primitive\n    for _ in range(10):  # Simulate movement and collection\n      actions.append(np.random.choice([UP, DOWN, LEFT, RIGHT]))\n      actions.append(USE)\n    return actions\n\n  actions = []\n  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  # Get the index of the item from the cookbook index\n  i_item = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if i_item not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe for {item} found.\")\n\n  # Extract workshop and ingredient information\n  recipe = env.world.cookbook.recipes[i_item]\n  workshops_needed = []\n  primitives_required = {}\n\n  # Collect information about required workshops and primitives\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshops_needed.append(recipe[\"_key\"])\n      else:\n          i_ingredient = env.world.cookbook.index[ingredient]\n          if i_ingredient in env.world.cookbook.primitives:\n              primitives_required[i_ingredient] = count\n\n  # Gather required primitives\n  for primitive, count in primitives_required.items():\n      while not has_enough_primitives(env._current_state.inventory, primitive, count):\n          actions.extend(collect_v2(env, primitive))\n\n  # Craft the item at the required workshops\n  for workshop in workshops_needed:\n      i_workshop = env.world.cookbook.index[workshop]\n      actions.extend(go_to_nearest_workshop(env, i_workshop))\n      actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T18:07:03.231189", "function_name": "craft", "function_body": "  def move_towards(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the direction to move in\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([0] * abs(dy))  # DOWN\n\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n\n    return actions\n\n  def find_nearest_workshop(env, workshop_indices):\n    current_pos = env._current_state.pos\n    nearest_distance = float('inf')\n    nearest_workshop_pos = None\n    \n    for index in workshop_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, index] > 0)\n      for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n        if distance < nearest_distance:\n          nearest_distance = distance\n          nearest_workshop_pos = tuple(pos)\n    \n    return nearest_workshop_pos\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine which workshop to go to based on the recipe's required ingredients\n  def determine_workshop(item_index):\n    recipes = env.world.cookbook.recipes\n    if item_index in recipes:\n      for ingredient in recipes[item_index]:\n        if ingredient != \"_key\" and ingredient not in env._current_state.inventory:\n          return ingredient  # Simplified: Assume the first non-_key ingredient is the workshop index\n    return None\n\n  workshop_index = determine_workshop(item_index)\n  \n  if workshop_index is not None:\n    nearest_workshop_pos = find_nearest_workshop(env, [workshop_index])\n    \n    if nearest_workshop_pos is not None:\n      # Move to the workshop\n      actions_to_take = move_towards(env, nearest_workshop_pos)\n      \n      # Once at the workshop, perform the USE action (action index for USE is 4)\n      actions_to_take.append(4)  # Assuming USE action has an index of 4\n      \n      return actions_to_take\n  \n  return []", "island_id": 3, "scores": {"": 0.0}}
