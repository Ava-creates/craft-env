{"timestamp": "2025-09-03T18:09:27.465175", "function_name": "craft", "function_body": "  def get_direction(start_pos, end_pos):\n    delta_x = end_pos[0] - start_pos[0]\n    delta_y = end_pos[1] - start_pos[1]\n\n    if abs(delta_x) > abs(delta_y):  # Move horizontally\n        return 'LEFT' if delta_x < 0 else 'RIGHT'\n    else:  # Move vertically\n        return 'UP' if delta_y < 0 else 'DOWN'\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Extract workshop key and required ingredients from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  # Check inventory for all required ingredients\n  current_inventory = env._current_state.inventory\n  for ingredient, count in ingredients_required.items():\n    if current_inventory[ingredient] < count:\n      return []\n  \n  # Find the appropriate workshop index based on the recipe's key\n  if workshop_key is None:\n    # If no specific workshop type is required, choose any available workshop\n    workshop_index = env.world.workshop_indices[0]\n  else:\n    # Otherwise, select the specified workshop type\n    workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n    \n    # Validate that the selected workshop index is valid and exists in the world\n    if workshop_index is None or workshop_index not in env.world.workshop_indices:\n      return []\n  \n  # Find all positions of the required workshop type on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops are found, return an empty action list\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Identify the closest workshop based on Manhattan distance from the agent's current position\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  actions_to_workshop = []\n  start_pos = tuple(env._current_state.pos)\n  end_pos = tuple(closest_workshop)\n\n  # Generate actions to navigate the agent to the closest workshop\n  while start_pos != end_pos:\n    direction = get_direction(start_pos, end_pos)\n    \n    if direction == 'UP':\n      action_index = 1\n    elif direction == 'DOWN':\n      action_index = 0\n    elif direction == 'LEFT':\n      action_index = 2\n    else: # RIGHT\n      action_index = 3\n\n    actions_to_workshop.append(action_index)\n\n    # Update the start position based on the chosen action (simplified movement logic)\n    if direction == 'UP':\n      start_pos = (start_pos[0], start_pos[1] - 1)\n    elif direction == 'DOWN':\n      start_pos = (start_pos[0], start_pos[1] + 1)\n    elif direction == 'LEFT':\n      start_pos = (start_pos[0] - 1, start_pos[1])\n    else: # RIGHT\n      start_pos = (start_pos[0] + 1, start_pos[1])\n\n  actions_to_workshop.append(4)  # Assuming 'USE' is mapped to action index 4.\n\n  return actions_to_workshop", "island_id": 9, "scores": {"": 0.0}}
