{"timestamp": "2025-09-03T15:27:17.444912", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index in the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine which workshop can be used to craft this item\n  workshop_type = None\n  for workshop, recipes in env.world.workshop_indices.items():\n      if any(item_index == recipe['ingredient_index'] or item_index == recipe['_key'] for recipe in env.world.cookbook.recipes.values()):\n          workshop_type = workshop\n          break\n\n  # Initialize actions list\n  actions = []\n\n  # Move to the nearest available workshop\n  if workshop_type:\n      workshop_position = None\n      min_distance = float('inf')\n      grid = env._current_state.grid\n      \n      # Find the position of the nearest workshop in the grid\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, workshop_type] > 0:\n                  distance = abs(env._current_state.pos[0] - x) + abs(env._current_state.pos[1] - y)\n                  if distance < min_distance:\n                      min_distance = distance\n                      workshop_position = (x, y)\n\n      # If a workshop is found, calculate the path to it and add actions to move there\n      if workshop_position:\n          current_x, current_y = env._current_state.pos\n          target_x, target_y = workshop_position\n\n          # Add movement actions to reach the workshop\n          while current_x < target_x:\n              actions.append(env.world.N_ACTIONS.DOWN)\n              current_x += 1\n          while current_x > target_x:\n              actions.append(env.world.N_ACTIONS.UP)\n              current_x -= 1\n          while current_y < target_y:\n              actions.append(env.world.N_ACTIONS.RIGHT)\n              current_y += 1\n          while current_y > target_y:\n              actions.append(env.world.N_ACTIONS.LEFT)\n              current_y -= 1\n\n          # Add USE action to craft the item at the workshop\n          actions.append(env.world.N_ACTIONS.USE)\n\n  return actions", "island_id": 7, "scores": {"": -1}}
