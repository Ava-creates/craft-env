rkshops = {}\n    for workshop_index in required_workshops:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    # If no workshops are available, raise an error\n    if not available_workshops:\n      raise ValueError(\"No available workshops to craft the item.\")\n\n    # Find the closest workshop\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T05:52:04.176772", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    delta_x = target_pos[1] - current_pos[1]\n    delta_y = target_pos[0] - current_pos[0]\n\n    actions = []\n    \n    # Determine the direction to move\n    if delta_y > 0:\n        actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n    elif delta_y < 0:\n        actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n\n    if delta_x > 0:\n        actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n    elif delta_x < 0:\n        actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n    \n    return actions\n  \n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, tuple(pos))\n      \n      return closest_workshop\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Determine the required workshop(s) based on the recipe\n    required_workshops = set()\n    for ingredient, amount in recipe.items():\n        if ingredient in env.world.workshop_indices:\n            required_workshops.add(ingredient)\n\n    # If no specific workshop is required, use any available workshop\n    if not required_workshops:\n        required_workshops.update(env.world.workshop_indices)\n    \n    # Find available workshops in the grid\n    available_workshops = {}\n    for workshop_index in required_workshops:\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    # If no workshops are available, raise an error\n    if not available_workshops:\n      raise ValueError(\"No available workshops to craft the item.\")\n\n    # Find the closest workshop\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T05:54:01.184834", "function_name": "craft", "function_body": "  def move_to(pos, target):\n      x_diff = target[0] - pos[0]\n      y_diff = target[1] - pos[1]\n      \n      actions = []\n      if x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n      elif x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      \n      if y_diff < 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff > 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def get_nearest_workshop(item_index):\n      recipe = env.world.cookbook.recipes.get(item_index)\n      \n      if not recipe:\n          raise ValueError(f\"No recipe found for {item}\")\n      \n      workshops_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n      \n      if not workshops_needed:\n          return None\n      \n      # Choose the first available workshop\n      workshop_index = workshops_needed[0]\n\n      # Find all positions of this workshop type in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for {item}\")\n      \n      return workshop_positions\n\n  def get_nearest_primitive(primitive_index):\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n      if len(primitive_positions) == 0:\n          return None\n      \n      return primitive_positions\n\n  item_index = env.world.cookbook.index[item]\n  \n  actions = []\n  \n  # First, collect all necessary primitives for the recipe\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n  \n  # Identify primitive ingredients required in the recipe\n  primitives_needed = [ingredient for ingredient in recipe.keys() if ingredient in env.world.grab_indices]\n  \n  for primitive in primitives_needed:\n      # Get all positions of this primitive type in the grid\n      primitive_positions = get_nearest_primitive(primitive)\n      \n      if primitive_positions is not None:\n          target_position = primitive_positions[0]  # Choose the first one for now\n\n          # Move to the primitive and collect it\n          current_pos = env._current_state.pos\n          actions.extend(move_to(current_pos, target_position))\n          \n          # Perform the COLLECT action (assuming COLLECT is index 5)\n          actions.append(5)\n\n  # Now, move to a workshop and craft the item\n  workshop_positions = get_nearest_workshop(item_index)\n  \n  if workshop_positions is not None:\n      target_position = workshop_positions[0]  # Choose the first one for now\n      \n      # Move to the workshop\n      current_pos = env._current_state.pos\n      actions.extend(move_to(current_pos, target_position))\n      \n      # Perform the USE action at the workshop (assuming USE is index 4)\n      actions.append(4)\n\n  return actions", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-04T05:54:03.050798", "function_name": "craft", "function_body": "  def move_to(pos, target):\n      x_diff = target[0] - pos[0]\n      y_diff = target[1] - pos[1]\n      \n      actions = []\n      if x_diff < 0:\n          actions.extend([2] * abs(x_diff))  # LEFT\n      elif x_diff > 0:\n          actions.extend([3] * abs(x_diff))  # RIGHT\n      \n      if y_diff < 0:\n          actions.extend([1] * abs(y_diff))  # UP\n      elif y_diff > 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      \n      return actions\n\n  def get_nearest_workshop(item_index):\n      recipe = env.world.cookbook.recipes.get(item_index)\n      \n      if not recipe:\n          raise ValueError(f\"No recipe found for {item}\")\n      \n      workshops_needed = [workshop for workshop in env.world.workshop_indices if recipe.get(workshop) is not None]\n      \n      if not workshops_needed:\n          return None\n      \n      # Choose the first available workshop\n      workshop_index = workshops_needed[0]\n\n      # Find all positions of this workshop type in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for {item}\")\n      \n      return workshop_positions\n\n  def find_closest_workshop(current_pos, workshop_positions):\n      distances = [np.linalg.norm(np.array(pos) - np.array(current_pos)) for pos in workshop_positions]\n      closest_index = np.argmin(distances)\n      return workshop_positions[closest_index]\n\n  item_index = env.world.cookbook.index[item]\n  \n  actions = []\n  \n  # Get the positions of all nearest workshops needed to craft the item\n  workshop_positions = get_nearest_workshop(item_index)\n  \n  if workshop_positions is not None:\n    closest_workshop_position = find_closest_workshop(env._current_state.pos, workshop_positions)\n    \n    # Move to the closest workshop\n    current_pos = env._current_state.pos\n    actions.extend(move_to(current_pos, closest_workshop_position))\n    \n    # Perform the USE action at the workshop\n    actions.append(4)  # Assuming 4 is the index for the USE action\n\n  return actions", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T05:56:06.769286", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    delta_x = target_pos[1] - current_pos[1]\n    delta_y = target_pos[0] - current_pos[0]\n\n    actions = []\n    \n    # Determine the direction to move based on the shortest path\n    if abs(delta_x) > abs(delta_y):\n        if delta_x > 0:\n            actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n        elif delta_x < 0:\n            actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n    else:\n        if delta_y > 0:\n            actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n        elif delta_y < 0:\n            actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n    \n    return actions\n\n  def find_closest_workshop(workshops, current_pos):\n      closest_workshop = None\n      min_distance = float('inf')\n      \n      for workshop_index, positions in workshops.items():\n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop = (workshop_index, tuple(pos))\n      \n      return closest_workshop\n\n  def get_required_workshops(recipe):\n    specific_workshop_key = \"_key\"\n    if specific_workshop_key in recipe:\n        workshop_indices = [env.world.cookbook.index[recipe[specific_workshop_key]]]\n        return {index: env.world.workshop_indices[index] for index in workshop_indices}\n    else:\n        return {index: env.world.workshop_indices[index] for index in env.world.workshop_indices}\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Determine the required workshop(s) based on the recipe\n    required_workshops = get_required_workshops(recipe)\n    \n    # Find available workshops in the grid\n    available_workshops = {}\n    for workshop_index, positions in required_workshops.items():\n        positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n        if len(positions) > 0:\n            available_workshops[workshop_index] = [tuple(pos) for pos in positions]\n\n    # Filter workshops to only include required ones\n    available_required_workshops = {k: v for k, v in available_workshops.items() if k in required_workshops}\n\n    if not available_required_workshops:\n      raise ValueError(f\"No required workshops found for item {item}\")\n\n    # Find the closest workshop from available required workshops\n    current_pos = env._current_state.pos\n    workshop_index, workshop_pos = find_closest_workshop(available_required_workshops, current_pos)\n\n    # Move to the workshop position\n    actions.extend(move_to_position(current_pos, workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-04T05:56:08.638649", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    delta_x = target_pos[1] - current_pos[1]\n    delta_y = target_pos[0] - current_pos[0]\n\n    actions = []\n    \n    # Determine the direction to move based on the shortest path\n    if abs(delta_x) > abs(delta_y):\n        if delta_x > 0:\n            actions.extend([1 for _ in range(abs(delta_x))])  # Move RIGHT\n        elif delta_x < 0:\n            actions.extend([0 for _ in range(abs(delta_x))])  # Move LEFT\n    else:\n        if delta_y > 0:\n            actions.extend([3 for _ in range(abs(delta_y))])  # Move DOWN\n        elif delta_y < 0:\n            actions.extend([2 for _ in range(abs(delta_y))])  # Move UP\n    \n    return actions\n\n  actions = []\n  \n  # Assuming we have the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item (assuming it exists)\n  if item_index in env.world.cookbook.recipes:\n    recipe = env.world.cookbook.recipes[item_index]\n\n    # Check which workshop is required to craft this item\n    # For simplicity, let's assume there's only one type of workshop needed\n    workshop_index = next(iter(env.world.workshop_indices))\n\n    # Find the position of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n    # Calculate distances to each workshop and select the closest one\n    current_pos = env._current_state.pos\n    min_distance = float('inf')\n    closest_workshop_pos = None\n\n    for pos in workshop_positions:\n        distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = tuple(pos)\n\n    # Move to the closest workshop position\n    actions.extend(move_to_position(current_pos, closest_workshop_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE action\n\n  else:\n      raise ValueError(f\"No recipe found for item {item}\")\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
