{"timestamp": "2025-09-03T17:35:20.307580", "function_name": "craft", "function_body": "  # Placeholder for the correct implementation.\n  item_index = env.world.cookbook.index[item]\n\n  actions = []\n  \n  # Find the nearest workshop that can be used to craft the item\n  workshop_indices = get_workshop_indices_for_item(env, item)\n  \n  if not workshop_indices:\n    return []  # No workshops found for this item\n\n  # Determine which workshop is closest to the agent's current position\n  closest_workshop_pos, _ = find_closest_workshop(env._current_state.grid, env._current_state.pos, workshop_indices)\n\n  if closest_workshop_pos is None:\n    return []  # No reachable workshops found\n  \n  # Generate actions to move towards the closest workshop\n  actions.extend(move_towards_position(env, closest_workshop_pos))\n\n  # Add the USE action to craft the item once at the workshop\n  actions.append(4)  # Assuming 4 is the index for the USE action.\n  \n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:38:41.826564", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              # Check for obstacles\n              if any(grid[neighbor, idx] == 1 for idx in env.world.cookbook.index.values()):\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:38:43.711836", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(\"Invalid direction\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              # Check for obstacles in the grid\n              if grid[neighbor, :].sum() > 0:\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  # Actions to move to the workshop and use it\n  actions_to_move = []\n  for step in path_to_workshop:\n      dx = step[0] - pos[0]\n      dy = step[1] - pos[1]\n      action = direction_to_action(dx, dy)\n      actions_to_move.append(action)\n\n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:40:18.302989", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Verify if the desired item has a recipe in the cookbook. If not, return an empty action list.\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Extract the workshop index and ingredient requirements from the item's recipe.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  # Check if all required ingredients are available in the current inventory. If not, return an empty action list.\n  inventory = env._current_state.inventory\n  for ingredient, count in ingredients_required.items():\n    if inventory[ingredient] < count:\n      return []\n\n  # Ensure that the specified workshop exists and is valid within the world's known workshops.\n  if not workshop_key or workshop_key not in env.world.workshop_indices:\n    return []\n  \n  # Find all positions of the required workshop type on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_key] > 0)\n  \n  # If no workshops are found, return an empty action list.\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Identify the closest workshop based on Manhattan distance from the agent's current position.\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Generate actions to navigate the agent to the closest workshop.\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop))\n  \n  # Append a USE action (assuming index 4) to craft the item at the workshop.\n  actions = path_to_workshop + [4]  # Assuming 'USE' is mapped to action index 4.\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:40:20.174151", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Extract the workshop index and ingredient requirements from the item's recipe.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  # Check if all required ingredients are available in the current inventory.\n  inventory = env._current_state.inventory\n  missing_ingredients = []\n  for ingredient, count in ingredients_required.items():\n    if inventory[ingredient] < count:\n      missing_ingredients.append(ingredient)\n      \n  if missing_ingredients:\n    print(f\"Missing ingredients: {missing_ingredients}\")\n    return []\n\n  # Ensure that the specified workshop exists and is valid within the world's known workshops.\n  if not workshop_key or workshop_key not in env.world.workshop_indices:\n    print(\"Invalid workshop key.\")\n    return []\n  \n  # Find all positions of the required workshop type on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_key] > 0)\n  \n  if len(workshop_positions) == 0:\n    print(\"No workshops found.\")\n    return []\n\n  # Identify the closest workshop based on Manhattan distance from the agent's current position.\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Generate actions to navigate the agent to the closest workshop.\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop))\n  \n  if not path_to_workshop:\n    print(\"No path found to the closest workshop.\")\n    return []\n      \n  # Append a USE action (assuming index 4) to craft the item at the workshop.\n  actions = path_to_workshop + [4]  # Assuming 'USE' is mapped to action index 4.\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:41:59.465534", "function_name": "craft", "function_body": "  def movement_to(target_pos: tuple):\n    current_pos = env._current_state.pos\n\n    # Calculate the difference in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    if dy > 0:\n        actions.extend([craft.DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.UP for _ in range(-dy)])\n\n    if dx > 0:\n        actions.extend([craft.RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.LEFT for _ in range(-dx)])\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Get the primitives required to craft this item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n\n  # Collect all primitives not already in inventory\n  actions_to_collect_primitives = []\n  for primitive, amount in primitives_needed.items():\n    if env._current_state.inventory[primitive] < amount:\n      actions_to_collect_primitives.extend(collect(env, env.world.cookbook.index.reverse()[primitive]))\n\n  actions.extend(actions_to_collect_primitives)\n\n  # Define a list of possible workshops\n  workshop_indices = set()\n\n  # Find all workshops required for crafting this item\n  current_recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  while \"_key\" in current_recipe:\n      key = current_recipe[\"_key\"]\n      workshop_indices.add(env.world.workshop_indices[key])\n      current_recipe = env.world.cookbook.recipes.get(current_recipe[key], {})\n\n  # Convert the set of workshops to a list and sort it\n  workshop_indices = sorted(workshop_indices)\n\n  # Move to each workshop, collect necessary items, and craft at the workshop\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n      # Choose a random position from the available workshops\n      chosen_workshop_position = tuple(workshop_positions[0])\n\n      # Move to the chosen workshop\n      actions.extend(movement_to(chosen_workshop_position))\n\n      # Add the USE action to craft at the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:42:01.382965", "function_name": "craft", "function_body": "  def movement_to(target_pos: tuple):\n    current_pos = env._current_state.pos\n\n    # Calculate the differences in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n\n    if dy > 0:\n        actions.extend([craft.DOWN for _ in range(dy)])\n    elif dy < 0:\n        actions.extend([craft.UP for _ in range(-dy)])\n\n    if dx > 0:\n        actions.extend([craft.RIGHT for _ in range(dx)])\n    elif dx < 0:\n        actions.extend([craft.LEFT for _ in range(-dx)])\n\n    return actions\n\n  def find_workshops_for_item(item_index):\n      current_recipe = env.world.cookbook.recipes.get(item_index, {})\n      workshop_indices = set()\n\n      while \"_key\" in current_recipe:\n          key = current_recipe[\"_key\"]\n          workshop_indices.add(env.world.workshop_indices[key])\n          current_recipe = env.world.cookbook.recipes.get(current_recipe[key], {})\n\n      return sorted(workshop_indices)\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = find_workshops_for_item(item_index)\n  actions = []\n\n  for workshop_index in workshop_indices:\n      # Find the position of the workshop on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop found for index {workshop_index}\")\n\n      # Choose a random position from the available workshops\n      chosen_workshop_position = tuple(workshop_positions[0])\n\n      # Move to the chosen workshop\n      actions.extend(movement_to(chosen_workshop_position))\n\n      # Add the USE action to craft at the workshop\n      actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:44:48.130495", "function_name": "craft", "function_body": "  # Get the item index from the name using the cookbook's index mapping\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if there is a recipe for the desired item in the cookbook\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  # If no recipe exists, return an empty list as we cannot craft this item\n  if not recipe:\n    return []\n\n  # Extract the workshop index from the recipe key \"_key\"\n  workshop_key = recipe.get(\"_key\", None)\n\n  # Determine workshop index based on key, default to first available if none provided\n  if workshop_key is not None:\n    workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n  else:\n    workshop_index = env.world.workshop_indices[0]\n\n  # Ensure that the workshop index is valid and exists in the world's workshop indices\n  if workshop_index is None or workshop_index not in env.world.workshop_indices:\n    return []\n\n  # Check if all required ingredients are available in the inventory\n  current_inventory = env._current_state.inventory\n  for ingredient, required_count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      if current_inventory[ingredient] < required_count:\n          return []\n\n  # Find all positions of the required workshop type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  # If no workshops are found, return an empty list\n  if workshop_positions.size == 0:\n    return []\n\n  # Calculate the shortest path to the nearest workshop using A* search algorithm for better efficiency\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  actions_to_workshop = a_star_search(env._current_state.grid, tuple(env._current_state.pos), tuple(closest_workshop_pos))\n\n  # Add the USE action (assuming index 4) to craft the item at the workshop\n  actions_to_craft = actions_to_workshop + [4]\n\n  return actions_to_craft", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:44:50.327198", "function_name": "craft", "function_body": "  def a_star_search(grid, start, goal):\n    neighbors = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # LEFT, RIGHT, UP, DOWN\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    open_set = [start]\n\n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n        if current == goal:\n            return reconstruct_path(came_from, current)\n        open_set.remove(current)\n\n        for dx, dy in neighbors:\n            neighbor = (current[0] + dx, current[1] + dy)\n            tentative_g_score = g_score[current] + 1\n            if not is_valid_move(grid, current, neighbor):\n                continue\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                if neighbor not in open_set:\n                    open_set.append(neighbor)\n\n    return []  # No path found\n\n  def is_valid_move(grid, current, neighbor):\n    x, y = neighbor\n    if x < 0 or x >= grid.shape[0] or y < 0 or y >= grid.shape[1]:\n        return False\n    non_grabbable_indices = env.world.non_grabbable_indices\n    grabbable_indices = env.world.grabbable_indices\n    return all(grid[x, y, i] == 0 for i in non_grabbable_indices) and any(grid[x, y, i] > 0 for i in grabbable_indices)\n\n  def heuristic(a, b):\n    return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return list(reversed(total_path))\n\n  # Find the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item in the cookbook\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  # If no recipe, return an empty list\n  if not recipe:\n    return []\n\n  # Extract workshop index from the recipe key \"_key\"\n  workshop_key = recipe.get(\"_key\")\n\n  # Ensure a valid workshop key and get the corresponding workshop index\n  if workshop_key is None:\n    return []\n  \n  workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n\n  # Verify that the workshop index is valid and exists in the world's workshop indices\n  if workshop_index is None or workshop_index not in env.world.workshop_indices:\n    return []\n\n  # Find all positions of the required workshop type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  # If no workshops are found, return an empty list\n  if workshop_positions.size == 0:\n    return []\n\n  # Calculate the shortest path to the nearest workshop using A* search algorithm for better efficiency\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Generate actions to move to the closest workshop\n  path_to_workshop = a_star_search(env._current_state.grid, tuple(env._current_state.pos), tuple(closest_workshop_pos))\n\n  if not path_to_workshop:\n    return []\n\n  actions_to_workshop = []\n  current_pos = env._current_state.pos\n\n  # Convert positions in the path to corresponding action indices\n  for next_pos in path_to_workshop[1:]:  # Skip the starting position\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dx == -1:\n          actions_to_workshop.append(2)  # UP\n      elif dx == 1:\n          actions_to_workshop.append(1)  # DOWN\n      elif dy == -1:\n          actions_to_workshop.append(0)  # LEFT\n      elif dy == 1:\n          actions_to_workshop.append(3)  # RIGHT\n\n      current_pos = next_pos\n\n  # Add the USE action (assuming index 4) to craft the item at the workshop\n  actions_to_craft = actions_to_workshop + [4]\n\n  return actions_to_craft", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:48:16.548314", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1:\n          return env.world.LEFT\n      elif dx == 1:\n          return env.world.RIGHT\n      elif dy == -1:\n          return env.world.DOWN\n      elif dy == 1:\n          return env.world.UP\n      else:\n          return None\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              # Skip if the cell is occupied\n              if any(grid[neighbor] == 1):\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  # Find the index of the item in the cookbook\n  try:\n      item_index = env.world.cookbook.index[item]\n  except KeyError:\n      raise ValueError(f\"Unknown item: {item}\")\n\n  # Determine which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe_key, recipe_value in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe_value and recipe_value[\"_key\"] == item_index:\n          required_workshop_indices.append(recipe_key)\n\n  if not required_workshop_indices:\n      return []\n\n  # Find the nearest workshop among those required\n  grid = env._current_state.grid\n  current_pos = env._current_state.pos\n  nearest_workshop_index, nearest_workshop_position = None, None\n\n  min_distance = float('inf')\n  for workshop_index in required_workshop_indices:\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n      if len(workshop_positions) > 0:\n          distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n          closest_workshop_position = tuple(workshop_positions[np.argmin(distances)])\n          distance_to_closest_workshop = distances.min()\n          \n          if distance_to_closest_workshop < min_distance:\n              min_distance = distance_to_closest_workshop\n              nearest_workshop_index = workshop_index\n              nearest_workshop_position = closest_workshop_position\n\n  if not nearest_workshop_position:\n      return []\n\n  # Calculate the path to the nearest workshop using A* algorithm\n  path_to_workshop = astar(grid, current_pos, nearest_workshop_position)\n\n  # Convert the path into actions\n  actions_to_move = []\n  for i in range(len(path_to_workshop) - 1):\n      dx, dy = path_to_workshop[i + 1][0] - path_to_workshop[i][0], path_to_workshop[i + 1][1] - path_to_workshop[i][1]\n      action = direction_to_action(dx, dy)\n      if action is not None:\n          actions_to_move.append(action)\n\n  # Add the USE action to craft the item\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:48:18.421084", "function_name": "craft", "function_body": "  def direction_to_action(dx: int, dy: int) -> int:\n      if dx == -1 and dy == 0:\n          return env.world.LEFT\n      elif dx == 1 and dy == 0:\n          return env.world.RIGHT\n      elif dx == 0 and dy == -1:\n          return env.world.DOWN\n      elif dx == 0 and dy == 1:\n          return env.world.UP\n      else:\n          raise ValueError(f\"Invalid direction: ({dx}, {dy})\")\n\n  def astar(grid: np.ndarray, start: tuple, goal: tuple) -> list[tuple]:\n      \"\"\"A* search algorithm to find the shortest path from start to goal on a grid.\"\"\"\n      neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + 1\n\n              if not (0 <= neighbor[0] < grid.shape[0]) or not (0 <= neighbor[1] < grid.shape[1]):\n                  continue\n\n              # Check if the cell is walkable\n              if np.all(grid[neighbor] == 0):\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              came_from[neighbor] = current\n              gscore[neighbor] = tentative_g_score\n              fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              heapq.heappush(oheap, (fscore[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a: tuple, b: tuple) -> int:\n      \"\"\"Heuristic function to estimate the cost from a to b.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting the item\n  required_workshop_indices = []\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          key = next(iter(recipe))\n          required_workshop_indices.append(env.world.workshop_indices[key])\n\n  # If no workshop is required, return an empty list\n  if not required_workshop_indices:\n      return []\n\n  # Get the index of the nearest workshop (for simplicity, we choose the first one)\n  target_workshop_index = required_workshop_indices[0]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      return []\n\n  # Choose the closest workshop to the current position\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the nearest workshop\n  path_to_workshop = astar(grid, pos, nearest_workshop_pos)\n\n  if not path_to_workshop:\n      return []\n\n  # Actions to move to the workshop and use it\n  actions_to_move = [direction_to_action(step[0] - pos[0], step[1] - pos[1]) for step in path_to_workshop]\n  \n  # Use action at the end\n  actions_to_craft = actions_to_move + [env.world.USE]\n\n  return actions_to_craft", "island_id": 8, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:51:28.706226", "function_name": "craft", "function_body": "  def has_enough_primitives(inventory, primitive_index, count):\n      return inventory[primitive_index] >= count\n\n  def path_to(env, target_pos):\n    pos = env._current_state.pos\n    direction = env._current_state.dir\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n\n    actions = []\n\n    # Turn to face the target x-coordinate\n    if dx > 0:\n      while direction != RIGHT:\n        direction = (direction + 1) % 4\n        actions.append(RIGHT)\n    elif dx < 0:\n      while direction != LEFT:\n        direction = (direction - 1) % 4\n        actions.append(LEFT)\n\n    # Move to the target x-coordinate\n    for _ in range(abs(dx)):\n      actions.append(FORWARD)\n\n    # Turn to face the target y-coordinate\n    if dy > 0:\n      while direction != DOWN:\n        direction = (direction + 1) % 4\n        actions.append(RIGHT)\n    elif dy < 0:\n      while direction != UP:\n        direction = (direction - 1) % 4\n        actions.append(LEFT)\n\n    # Move to the target y-coordinate\n    for _ in range(abs(dy)):\n      actions.append(FORWARD)\n\n    return actions\n\n  def go_to_nearest_workshop(env, workshop_index):\n    pos = env._current_state.pos\n    min_distance = float('inf')\n    target_pos = None\n\n    for y in range(env.world.cookbook.grid.shape[0]):\n      for x in range(env.world.cookbook.grid.shape[1]):\n        if np.any(env.world.cookbook.grid[y, x] == workshop_index):\n          distance = abs(x - pos[0]) + abs(y - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            target_pos = (x, y)\n\n    if target_pos is None:\n      raise ValueError(f\"No workshop with index {workshop_index} found.\")\n\n    return path_to(env, target_pos)\n\n  actions = []\n  cookbook = env.world.cookbook\n\n  # Get the index of the item from the cookbook index\n  i_item = cookbook.index[item]\n\n  # Check if there is 