{"timestamp": "2025-09-03T15:35:20.425488", "function_name": "craft", "function_body": "  # Determine the index of the target item using the cookbook's index mapping\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if there is a recipe for the target item in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    return []\n\n  # Extract recipe details: workshop key and required ingredients\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n\n  # Verify that all required ingredients are available in the inventory\n  current_inventory = env._current_state.inventory\n  for ingredient_index, required_count in ingredients.items():\n    if current_inventory[ingredient_index] < required_count:\n      return []\n\n  # Determine the workshop index based on the recipe's key (if provided)\n  if workshop_key is not None:\n    workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n    \n    # Validate that the determined workshop index is valid and exists in the world\n    if workshop_index is None or workshop_index not in env.world.workshop_indices:\n      return []\n  else:\n    # Fallback to any available workshop if no specific workshop type is required\n    workshop_index = env.world.workshop_indices[0]\n\n  # Find all positions of the specified workshop type in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops are found, return an empty list\n  if workshop_positions.size == 0:\n    return []\n\n  # Calculate the path to the nearest workshop using Manhattan distance\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Generate actions to move to the closest workshop\n  actions_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop_pos))\n\n  # Add the USE action (assuming index 4) to craft the item at the workshop\n  actions_to_craft = actions_to_workshop + [4]\n\n  return actions_to_craft", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T15:36:22.656245", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item from the cookbook index\n  i_item = env.world.cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if i_item in env.world.cookbook.recipes:\n      # Check for required workshops and ingredients\n      recipe = env.world.cookbook.recipes[i_item]\n      workshops_needed = []\n      primitives_required = {}\n\n      # Collect information about required workshops and primitives\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              workshops_needed.append(recipe[\"_key\"])\n          else:\n              i_ingredient = env.world.cookbook.index[ingredient]\n              if i_ingredient in env.world.cookbook.primitives:\n                  primitives_required[i_ingredient] = count\n\n      # Gather required primitives\n      for primitive, count in primitives_required.items():\n          while not has_enough_primitives(env._current_state.inventory, primitive, count):\n              actions.extend(collect(env, primitive))\n\n      # Craft the item at the required workshops\n      for workshop in workshops_needed:\n          i_workshop = env.world.cookbook.index[workshop]\n          actions.extend(go_to_nearest_workshop(env, i_workshop))\n          actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
