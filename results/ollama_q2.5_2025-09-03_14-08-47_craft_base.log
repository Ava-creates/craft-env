{"timestamp": "2025-09-03T21:41:59.155876", "function_name": "craft", "function_body": "  # Get the index of the desired item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe for the item exists\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe available for {item}\")\n    \n  # Retrieve the workshop type required from the recipes dictionary\n  workshop_type = env.world.cookbook.recipes[item_index][\"_key\"]\n  \n  # Get the index of the corresponding workshop type\n  if workshop_type == \"workshop0\":\n      workshop_index = env.world.workshop_indices[0]\n  elif workshop_type == \"workshop1\":\n      workshop_index = env.world.workshop_indices[1]\n  elif workshop_type == \"workshop2\":\n      workshop_index = env.world.workshop_indices[2]\n  else:\n      raise ValueError(f\"Unknown workshop type {workshop_type}\")\n\n  # Initialize actions list\n  actions = []\n  \n  # Find a position next to the workshop in the grid\n  grid = env._current_state.grid\n  for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n          if np.any(grid[i, j] == workshop_index):\n              # Define possible movements (UP, DOWN, LEFT, RIGHT) relative to the workshop position\n              potential_moves = [(i-1, j), (i+1, j), (i, j-1), (i, j+1)]\n              \n              for move in potential_moves:\n                  x, y = move\n                  # Check if the move is within grid bounds and not a boundary or obstacle\n                  if 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]:\n                      if not np.any(grid[x, y] == env.world.non_grabbable_indices):\n                          # If found a valid position next to the workshop, append the movement actions\n                          # Calculate direction needed to reach the move from current position\n                          current_pos = env._current_state.pos\n                          target_direction = get_direction(current_pos, (x, y))\n                          if target_direction is not None:\n                              actions.append(target_direction)\n                              actions.append(env.world.N_ACTIONS)  # USE action to interact with the workshop\n                              return actions\n  \n  raise ValueError(f\"No valid position found next to the workshop for {item}\")", "island_id": 3, "scores": {"": -1}}
