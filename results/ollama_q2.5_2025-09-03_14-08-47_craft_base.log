     if primitive_index is None:\n          raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n\n      # Find the nearest location of the primitive\n      min_distance = float('inf')\n      target_pos = None\n\n      for y in range(env.world.cookbook.grid.shape[0]):\n          for x in range(env.world.cookbook.grid.shape[1]):\n              if np.any(env.world.cookbook.grid[y, x] == primitive_index):\n                  distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n                  if distance < min_distance:\n                      min_distance = distance\n                      target_pos = (x, y)\n\n      if target_pos is None:\n          raise ValueError(f\"No location for primitive {primitive} found.\")\n\n      # Navigate to the nearest primitive and collect it\n      actions = path_to(env, target_pos)\n      actions.append(USE)\n      return actions\n\n  actions = []\n  cookbook = env.world.cookbook\n\n  # Get the index of the item from the cookbook index\n  i_item = cookbook.index[item]\n\n  # Check if there is a recipe for the item\n  if i_item in cookbook.recipes:\n      recipe = cookbook.recipes[i_item]\n      workshops_needed = []\n      primitives_required = {}\n\n      # Collect information about required workshops and primitives\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              workshops_needed.append(recipe[\"_key\"])\n          else:\n              i_ingredient = cookbook.index[ingredient]\n              if i_ingredient in cookbook.primitives:\n                  primitives_required[i_ingredient] = count\n\n      # Gather required primitives\n      for primitive, count in primitives_required.items():\n          while not has_enough_primitives(env._current_state.inventory, primitive, count):\n              actions.extend(collect_v2(env, cookbook.index.get(primitive)))\n\n      # Craft the item at the required workshops\n      for workshop in workshops_needed:\n          i_workshop = cookbook.index[workshop]\n          actions.extend(go_to_nearest_workshop(env, i_workshop))\n          actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:53:35.839190", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Verify if the desired item has a recipe in the cookbook. If not, return an empty action list.\n  if item_index not in env.world.cookbook.recipes:\n    print(f\"No recipe for {item} found.\")\n    return []\n\n  # Extract the workshop index and ingredient requirements from the item's recipe.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n\n  # Check if all required ingredients are available in the current inventory. If not, return an empty action list.\n  inventory = env._current_state.inventory\n  for ingredient, count in ingredients_required.items():\n    if inventory[ingredient] < count:\n      print(f\"Missing {count} of ingredient {env.world.cookbook.index.get(ingredient)}\")\n      return []\n\n  # Ensure that the specified workshop exists and is valid within the world's known workshops.\n  if not workshop_key or workshop_key not in env.world.workshop_indices:\n    print(f\"No valid workshop for item {item}.\")\n    return []\n\n  # Find all positions of the required workshop type on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_key] > 0)\n\n  # If no workshops are found, return an empty action list.\n  if len(workshop_positions) == 0:\n    print(f\"No {workshop_key} workshops found.\")\n    return []\n\n  # Identify the closest workshop based on Manhattan distance from the agent's current position.\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n\n  # Generate actions to navigate the agent to the closest workshop.\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop))\n\n  # Append a USE action (assuming index 4) to craft the item at the workshop.\n  actions = path_to_workshop + [4]  # Assuming 'USE' is mapped to action index 4.\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:53:38.082479", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Check if the recipe exists for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    return []\n  \n  # Extract workshop key and required ingredients from the recipe\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_key = recipe.get(\"_key\", None)\n  ingredients_required = {k: v for k, v in recipe.items() if k != \"_key\"}\n  \n  # Check inventory for all required ingredients\n  current_inventory = env._current_state.inventory\n  for ingredient, count in ingredients_required.items():\n    if current_inventory[ingredient] < count:\n      return []\n  \n  # Find the appropriate workshop index based on the recipe's key\n  if workshop_key is None:\n    # If no specific workshop type is required, choose any available workshop\n    workshop_index = env.world.workshop_indices[0]\n  else:\n    # Otherwise, select the specified workshop type\n    workshop_index = getattr(env.world, f\"{workshop_key}_index\", None)\n    \n    # Validate that the selected workshop index is valid and exists in the world\n    if workshop_index is None or workshop_index not in env.world.workshop_indices:\n      return []\n  \n  # Find all positions of the required workshop type on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops are found, return an empty action list\n  if len(workshop_positions) == 0:\n    return []\n  \n  # Identify the closest workshop based on Manhattan distance from the agent's current position\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Generate actions to navigate the agent to the closest workshop\n  path_to_workshop = get_path(env._current_state.pos, tuple(closest_workshop))\n  \n  # Append a USE action (assuming index 4) to craft the item at the workshop\n  actions = path_to_workshop + [4]  # Assuming 'USE' is mapped to action index 4.\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:55:08.391832", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop that can craft the item\n  for output_index, recipe in env.world.cookbook.recipes.items():\n    if \"_key\" not in recipe and output_index == item_idx:\n      for ingredient_index in recipe.keys():\n        if ingredient_index.startswith(\"WORKSHOP\"):\n          workshop_name = env.world.cookbook.index.get(ingredient_index)\n          break\n  \n  # Get the index of the workshop\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_idx] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop not found in the grid.\")\n  \n  # Calculate the shortest path to the workshop using BFS\n  def bfs_shortest_path(start, goal):\n    queue = collections.deque([start])\n    visited = set()\n    parent_map = {}\n    \n    while queue:\n      current_pos = queue.popleft()\n      \n      if current_pos == goal:\n        path = []\n        while current_pos in parent_map:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        return path[::-1]\n      \n      visited.add(current_pos)\n      \n      # Define possible movements (DOWN, UP, LEFT, RIGHT)\n      directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n      for dx, dy in directions:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          if (new_pos not in visited and \n              0 <= new_pos[0] < grid.shape[0] and\n              0 <= new_pos[1] < grid.shape[1] and\n              grid[new_pos][workshop_idx] == 0):\n              queue.append(new_pos)\n              parent_map[new_pos] = current_pos\n    \n    return None\n  \n  start_pos = env._current_state.pos\n  path_to_workshop = bfs_shortest_path(start_pos, tuple(workshop_positions[0]))\n  \n  if not path_to_workshop:\n    raise ValueError(\"Path to workshop not found.\")\n  \n  # Translate the path into actions (DOWN, UP, LEFT, RIGHT)\n  direction_map = {\n      (0, 1): 0,  # DOWN\n      (0, -1): 1,  # UP\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3   # RIGHT\n  }\n  \n  actions_to_workshop = []\n  current_pos = start_pos\n  \n  for next_pos in path_to_workshop:\n      direction = (next_pos[0] - current_pos[0], next_pos[1] - current_pos[1])\n      action = direction_map[direction]\n      actions_to_workshop.append(action)\n      current_pos = next_pos\n  \n  # Add the USE action to start crafting\n  actions_to_workshop.append(4)  # USE\n  \n  return actions_to_workshop", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:55:10.297517", "function_name": "craft", "function_body": "  # Find the workshop that can make this item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  output_index = index[item]\n  recipe = cookbook.recipes[output_index]\n\n  actions = []\n\n  for ingredient_index, count in recipe.items():\n    if ingredient_index == \"_key\":\n      continue\n\n    # Find the kind of item to collect\n    ingredient_name = index.get(ingredient_index)\n    # Collect required items from the environment\n    actions.extend(collect(env, ingredient_name))\n    \n  # Move to a workshop that can create this item\n  for workshop in env.world.workshop_indices:\n      if is_valid_workshop_for_recipe(workshop, recipe):\n          actions.append(MOVE_FUNC(workshop))  \n          break\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(USE_ACTION)\n\n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T17:57:00.427639", "function_name": "craft", "function_body": "  def move_towards_workshop(env, pos):\n    current_pos = env._current_state.pos\n    dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n    actions = []\n    while abs(dx) > 0 or abs(dy) > 0:\n      if dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      elif dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      if dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n      elif dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find all workshops that can be used to produce this item.\n  possible_workshops = []\n  for workshop, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          possible_workshops.append(workshop)\n\n  # If no suitable workshop found, return an empty list of actions.\n  if not possible_workshops:\n      return []\n\n  # Find the nearest workshop to the agent's current position.\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos in np.ndindex(env._current_state.grid.shape[:2]):\n      kind = env._current_state.grid[pos]\n      if kind in possible_workshops:\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = pos\n\n  # If no workshop position found, return an empty list of actions.\n  if closest_workshop_pos is None:\n      return []\n\n  # Move towards the nearest workshop and perform the USE action to craft the item.\n  actions = move_towards_workshop(env, closest_workshop_pos)\n  actions.append(4)  # Assuming 4 is the index for the USE action.\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:57:02.368686", "function_name": "craft", "function_body": "  def move_towards(env, target_pos):\n    current_pos = env._current_state.pos\n    dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions = []\n    while dx or dy:\n      if dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      elif dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      if dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n      elif dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the workshop needed to craft this item.\n  possible_workshops = []\n  for workshop, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          possible_workshops.append(workshop)\n\n  # If no suitable workshop found, return an empty list of actions.\n  if not possible_workshops:\n      return []\n\n  # Find the nearest workshop to the agent's current position.\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos, kind in np.ndenumerate(env._current_state.grid):\n      if kind in possible_workshops:\n          distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = pos\n\n  # If no workshop position found, return an empty list of actions.\n  if closest_workshop_pos is None:\n      return []\n\n  # Move towards the nearest workshop and perform the USE action to craft the item.\n  actions = move_towards(env, closest_workshop_pos)\n  actions.append(4)  # Assuming 4 is the index for the USE action.\n\n  return actions", "island_id": 5, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T17:58:42.328685", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.get(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n\n  # Find the workshop that can make this item (assuming there is only one such workshop)\n  workshop_index = None\n  for i in range(len(env.world.workshop_indices)):\n      if any(ingredient in recipe.keys() for ingredient in env.world.cookbook.primitives_for(index).keys()):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  # If no suitable workshop is found, return an empty list\n  if workshop_index is None:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n\n  # If no workshops are found, return an empty list\n  if len(workshop_positions) == 0:\n      print(f\"No workshops for {item} found on the grid.\")\n      return []\n\n  # Choose the closest workshop (assuming there might be multiple)\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Calculate the actions to move towards the closest workshop\n  actions_to_workshop = []\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n\n  # Add the USE action to craft the item\n  use_actio