{"timestamp": "2025-09-04T09:27:28.894168", "function_name": "craft", "function_body": "  # Get the index for the given item\n  index = env.world.cookbook.index.get(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Check if there's a recipe to craft this item\n  if index not in env.world.cookbook.recipes:\n      print(f\"No recipe for crafting {item}.\")\n      return []\n  \n  # Get primitives needed for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(index)\n\n  # Check if we have all required primitives in our inventory\n  inventory = env._current_state.inventory\n  for primitive, count in primitives_needed.items():\n      if inventory[primitive] < count:\n          print(f\"Not enough {env.world.cookbook.index.get(primitive)} to craft {item}.\")\n          return []\n\n  # Find the workshop that can make this item (assuming there is only one such workshop)\n  recipe = env.world.cookbook.recipes[index]\n  workshop_index = None\n  for i in range(len(env.world.workshop_indices)):\n      if all(ingredient in recipe.keys() or ingredient == \"_key\" for ingredient in primitives_needed.keys()):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  # If no suitable workshop is found, raise an error or return an empty list\n  if workshop_index is None:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  \n  # Calculate distances to each available workshop and choose the nearest one\n  agent_pos = env._current_state.pos\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos in workshop_positions:\n      distance = np.linalg.norm(pos - agent_pos, ord=1)  # Manhattan distance\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = pos\n  \n  # If no suitable workshops are found, return an empty list\n  if closest_workshop_pos is None:\n      print(\"No available workshops found.\")\n      return []\n\n  # Calculate the direction to move towards the nearest workshop\n  delta_x, delta_y = closest_workshop_pos - agent_pos\n  actions_to_workshop = []\n  \n  # Direction adjustments to move towards the workshop\n  while delta_x != 0 or delta_y != 0:\n      if delta_x > 0:\n          actions_to_workshop.append(env.action_specs()['RIGHT'])\n          delta_x -= 1\n      elif delta_x < 0:\n          actions_to_workshop.append(env.action_specs()['LEFT'])\n          delta_x += 1\n      \n      if delta_y > 0:\n          actions_to_workshop.append(env.action_specs()['UP'])\n          delta_y -= 1\n      elif delta_y < 0:\n          actions_to_workshop.append(env.action_specs()['DOWN'])\n          delta_y += 1\n  \n  # Step 3: Use action at the workshop\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n  \n  return actions_to_workshop + actions_to_use", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-04T09:27:32.999571", "function_name": "craft", "function_body": "  # Get index of the desired item\n  index = env.world.cookbook.index.index(item)\n  if index is None:\n      print(f\"Item {item} not found in the cookbook.\")\n      return []\n\n  # Get recipe and workshop information\n  recipe = env.world.cookbook.recipes[index]\n  \n  # Find the suitable workshop(s) that can make this item\n  # Assuming there's a mapping of workshops to items they can craft\n  workshop_indices = []\n  for i in range(len(env.world.workshop_indices)):\n      if index in env.world.cookbook.recipes.get(i, {}):\n          workshop_indices.append(env.world.workshop_indices[i])\n  \n  if not workshop_indices:\n      print(f\"No suitable workshop found to craft {item}\")\n      return []\n\n  # Choose the closest workshop\n  agent_pos = np.array(env._current_state.pos)\n  distances = []\n  for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n      if len(workshop_positions) > 0:\n          nearest_workshop_pos = workshop_positions[np.linalg.norm(agent_pos - workshop_positions, axis=1).argmin()]\n          distance = np.linalg.norm(agent_pos - nearest_workshop_pos)\n          distances.append((workshop_index, nearest_workshop_pos, distance))\n  \n  if not distances:\n      print(f\"No workshops found on the grid for {item}.\")\n      return []\n  \n  chosen_workshop_index, workshop_pos, _ = min(distances, key=lambda x: x[2])\n  \n  # Calculate the direction to move towards the chosen workshop\n  delta_x, delta_y = workshop_pos - agent_pos\n  actions_to_workshop = []\n\n  if delta_x > 0:\n      actions_to_workshop.extend([env.action_specs()['RIGHT']] * abs(delta_x))\n  elif delta_x < 0:\n      actions_to_workshop.extend([env.action_specs()['LEFT']] * abs(delta_x))\n\n  if delta_y > 0:\n      actions_to_workshop.extend([env.action_specs()['UP']] * abs(delta_y))\n  elif delta_y < 0:\n      actions_to_workshop.extend([env.action_specs()['DOWN']] * abs(delta_y))\n  \n  # Step 3: Use action at the workshop\n  use_action_index = env.action_specs()['USE']\n  actions_to_use = [use_action_index]\n  \n  return actions_to_workshop + actions_to_use", "island_id": 9, "scores": {"": -1}}
