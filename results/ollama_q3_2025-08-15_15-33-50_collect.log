{"timestamp": "2025-08-15T19:00:16.269382", "function_name": "collect", "function_body": "  # Get primitive index\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if we already have it in inventory\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n      \n  # Find all positions where this primitive exists in the grid\n  positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, primitive_index] > 0:\n              positions.append((i, j))\n  \n  # If the primitive is not found, return empty list\n  if not positions:\n      return []\n  \n  # Get current agent position\n  current_pos = env._current_state.pos\n  \n  # Find the closest position to collect the primitive\n  min_distance = float('inf')\n  target_pos = None\n  for pos in positions:\n      distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          target_pos = pos\n  \n  # If no valid position found, return empty list\n  if target_pos is None:\n      return []\n  \n  # Generate path from current position to target position\n  actions = []\n  current_x, current_y = current_pos\n  target_x, target_y = target_pos\n  \n  # Move towards the primitive\n  while (current_x, current_y) != target_pos:\n      if current_x < target_x:\n          actions.append(1)  # UP\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(0)  # DOWN\n          current_x -= 1\n      elif current_y < target_y:\n          actions.append(3)  # RIGHT\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(2)  # LEFT\n          current_y -= 1\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:00:18.336362", "function_name": "collect", "function_body": "  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if we already have it in inventory\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n      \n  # Get the list of grabbable indices (excluding environment entities)\n  grabbable_indices = env.world.grabbable_indices\n  \n  # Find all positions where this primitive exists in the grid\n  positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, primitive_index] > 0:\n              positions.append((i, j))\n  \n  # If the primitive is not found, return empty list\n  if not positions:\n      return []\n  \n  # Get current agent position\n  current_pos = env._current_state.pos\n  \n  # Find the closest position to collect the primitive\n  min_distance = float('inf')\n  target_pos = None\n  for pos in positions:\n      distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          target_pos = pos\n  \n  # If no valid position found, return empty list\n  if target_pos is None:\n      return []\n  \n  # Generate path from current position to target position\n  actions = []\n  current_x, current_y = current_pos\n  target_x, target_y = target_pos\n  \n  # Move towards the primitive\n  while (current_x, current_y) != target_pos:\n      if current_x < target_x:\n          actions.append(1)  # UP\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(0)  # DOWN\n          current_x -= 1\n      elif current_y < target_y:\n          actions.append(3)  # RIGHT\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(2)  # LEFT\n          current_y -= 1\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:00:43.514642", "function_name": "collect", "function_body": "  primitive_index = env.world.cookbook.index[primitive]\n  if env._current_state.inventory[primitive_index] > 0:\n    return []\n  \n  # Find all positions that contain the primitive\n  grid = env._current_state.grid\n  positions = np.where(grid[:,:,primitive_index] > 0)\n  if len(positions[0]) == 0:\n    # Primitive not found in grid, return empty list\n    return []\n  \n  # If agent is already at a position with the primitive, use it\n  pos = env._current_state.pos\n  if grid[pos[0], pos[1], primitive_index] > 0:\n    return [craft.USE]\n  \n  # BFS to find shortest path to any instance of the primitive\n  from collections import deque\n  queue = deque([(pos[0], pos[1], [])])\n  visited = set()\n  visited.add(pos)\n  \n  directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n  action_map = {\n      (0, 1): craft.RIGHT,\n      (0, -1): craft.LEFT,\n      (1, 0): craft.DOWN,\n      (-1, 0): craft.UP\n  }\n\n  while queue:\n    row, col, actions = queue.popleft()\n    \n    for dr, dc in directions:\n      new_row, new_col = row + dr, col + dc\n      \n      # Check bounds\n      if (new_row < 0 or new_row >= grid.shape[0] or \n          new_col < 0 or new_col >= grid.shape[1]):\n        continue\n        \n      # Skip visited cells\n      if (new_row, new_col) in visited:\n        continue\n        \n      # Skip non-walkable cells\n      cell_kind = np.argmax(grid[new_row, new_col, :])\n      if cell_kind in env.world.non_grabbable_indices:\n        continue\n        \n      # If found the primitive, return actions to reach it\n      if grid[new_row, new_col, primitive_index] > 0:\n        return actions + [action_map[(dr, dc)]]\n        \n      visited.add((new_row, new_col))\n      queue.append((new_row, new_col, actions + [action_map[(dr, dc)]]))\n\n  # No path found\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:00:45.513777", "function_name": "collect", "function_body": "  primitive_index = env.world.cookbook.index[primitive]\n  \n  # If already have it, nothing to do\n  if env._current_state.inventory[primitive_index] > 0:\n    return []\n  \n  grid = env._current_state.grid\n  positions = np.where(grid[:,:,primitive_index] > 0)\n  \n  # If primitive not found in grid, return empty list\n  if len(positions[0]) == 0:\n    return []\n  \n  # If agent is already at a position with the primitive, use it\n  pos = env._current_state.pos\n  if grid[pos[0], pos[1], primitive_index] > 0:\n    return [craft.USE]\n  \n  # BFS to find shortest path to any instance of the primitive\n  from collections import deque\n  queue = deque([(pos[0], pos[1], [])])\n  visited = set()\n  visited.add(pos)\n  \n  directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n  action_map = {\n      (0, 1): craft.RIGHT,\n      (0, -1): craft.LEFT,\n      (1, 0): craft.DOWN,\n      (-1, 0): craft.UP\n  }\n\n  while queue:\n    row, col, actions = queue.popleft()\n    \n    for dr, dc in directions:\n      new_row, new_col = row + dr, col + dc\n      \n      # Check bounds\n      if (new_row < 0 or new_row >= grid.shape[0] or \n          new_col < 0 or new_col >= grid.shape[1]):\n        continue\n        \n      # Skip visited cells\n      if (new_row, new_col) in visited:\n        continue\n        \n      # Skip non-walkable cells\n      cell_kind = np.argmax(grid[new_row, new_col, :])\n      if cell_kind in env.world.non_grabbable_indices:\n        continue\n        \n      # If found the primitive, return actions to reach it\n      if grid[new_row, new_col, primitive_index] > 0:\n        return actions + [action_map[(dr, dc)]]\n        \n      visited.add((new_row, new_col))\n      queue.append((new_row, new_col, actions + [action_map[(dr, dc)]]))\n\n  # No path found\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:01:11.290148", "function_name": "collect", "function_body": "  primitive_index = env.world.cookbook.index[primitive]\n  assert primitive_index is not None, f\"Primitive '{primitive}' not found in cookbook\"\n\n  # If we already have it, return empty list\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n\n  # Get the agent's current position\n  pos = env._current_state.pos\n\n  # Find all locations where this primitive is available\n  locations = []\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n              locations.append((x, y))\n\n  # If no locations found, return empty list (can't collect)\n  if not locations:\n      return []\n\n  # Use BFS to find the shortest path\n  from collections import deque\n\n  queue = deque([(pos[0], pos[1], [])])  # (x, y, actions_list)\n  visited = set()\n  visited.add(pos)\n\n  while queue:\n      x, y, actions = queue.popleft()\n\n      if (x, y) in locations:\n          return actions\n\n      # Check all 4 directions\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          nx, ny = x + dx, y + dy\n          \n          # Check bounds\n          if not (0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]):\n              continue\n\n          # Check if already visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check if we can move to this cell\n          cell_kind = np.argmax(env._current_state.grid[nx, ny])\n          if cell_kind != 0 and cell_kind != primitive_index:\n              # This cell is occupied by something else\n              # We need to see if we can use our inventory to pass through\n              continue\n\n          visited.add((nx, ny))\n          queue.append((nx, ny, actions + [env.action_specs()['DOWN' if dx == 1 else 'UP' if dx == -1 else 'RIGHT' if dy == 1 else 'LEFT']]))\n  \n  # If no path found, return empty list\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:01:13.264979", "function_name": "collect", "function_body": "  # Check if we already have the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  assert primitive_index is not None, f\"Primitive '{primitive}' not found in cookbook\"\n  \n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n\n  # Get all locations where this primitive exists\n  locations = []\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n              locations.append((x, y))\n\n  if not locations:\n      return []\n\n  # BFS to find shortest path\n  from collections import deque\n\n  queue = deque([(env._current_state.pos[0], env._current_state.pos[1], [])])\n  visited = set()\n  visited.add(env._current_state.pos)\n\n  while queue:\n      x, y, actions = queue.popleft()\n\n      if (x, y) in locations:\n          return actions\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          nx, ny = x + dx, y + dy\n          \n          # Check bounds\n          if not (0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]):\n              continue\n\n          # Check if already visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check cell occupancy\n          cell_kind = np.argmax(env._current_state.grid[nx, ny])\n          if cell_kind != 0 and cell_kind != primitive_index:\n              # Cell is occupied by something other than the target primitive\n              # Can we pass through using an item from inventory?\n              # For now, assume no passage possible unless it's the primitive itself or empty space.\n              continue\n\n          visited.add((nx, ny))\n          action = env.action_specs()['DOWN' if dx == 1 else 'UP' if dx == -1 else 'RIGHT' if dy == 1 else 'LEFT']\n          queue.append((nx, ny, actions + [action]))\n  \n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:01:35.356457", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Find the index of the primitive\n  primitive_index = cookbook.index[primitive]\n\n  # Check if we already have the primitive in inventory\n  if state.inventory[primitive_index] > 0:\n      return []\n\n  # Get all positions where this primitive exists\n  positions = np.where(state.grid[:, :, primitive_index] == 1)\n  \n  # If no such primitive found, return empty list\n  if len(positions[0]) == 0:\n      return []\n\n  target_pos = (positions[0][0], positions[1][0])\n\n  # Simple pathfinding using Manhattan distance\n  current_pos = state.pos\n  actions = []\n\n  while current_pos != target_pos:\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if abs(x_diff) > abs(y_diff):\n          if x_diff > 0:\n              actions.append(3)  # RIGHT\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          else:\n              actions.append(2)  # LEFT\n              current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n          if y_diff > 0:\n              actions.append(1)  # DOWN\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          else:\n              actions.append(0)  # UP\n              current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Add the action to collect the primitive\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 1.0}}
{"timestamp": "2025-08-15T19:01:37.363238", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Find the index of the primitive\n  primitive_index = cookbook.index[primitive]\n\n  # Check if we already have the primitive in inventory\n  if state.inventory[primitive_index] > 0:\n      return []\n\n  # Get all positions where this primitive exists\n  positions = np.where(state.grid[:, :, primitive_index] == 1)\n  \n  # If no such primitive found, return empty list\n  if len(positions[0]) == 0:\n      return []\n\n  target_pos = (positions[0][0], positions[1][0])\n\n  # Simple pathfinding using Manhattan distance\n  current_pos = state.pos\n  actions = []\n\n  while current_pos != target_pos:\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if abs(x_diff) > abs(y_diff):\n          if x_diff > 0:\n              actions.append(3)  # RIGHT\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          else:\n              actions.append(2)  # LEFT\n              current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n          if y_diff > 0:\n              actions.append(1)  # DOWN\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          else:\n              actions.append(0)  # UP\n              current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Add the action to collect the primitive\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 1.0}}
{"timestamp": "2025-08-15T19:02:01.231397", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  \n  # If we already have it, return empty list\n  if env._current_state.inventory[index] > 0:\n    return []\n  \n  # If the primitive is not in the environment, raise error\n  if index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} is not grabbable.\")\n    \n  # Get current state\n  state = env._current_state\n  \n  # Use BFS to find shortest path to collect primitive\n  queue = collections.deque([(state.pos, [])])\n  visited = set()\n  visited.add(state.pos)\n  \n  while queue:\n    pos, actions = queue.popleft()\n    \n    # Check if we are at the primitive location\n    if state.grid[pos[0], pos[1], index] > 0:\n      return actions\n    \n    # Get all possible moves (up, down, left, right)\n    for move in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      new_pos = (pos[0] + move[0], pos[1] + move[1])\n      \n      # Check if position is valid\n      if (new_pos[0] >= 0 and new_pos[0] < state.grid.shape[0] and \n          new_pos[1] >= 0 and new_pos[1] < state.grid.shape[1]):\n        \n        # Check if we have already visited this position or it's an obstacle\n        if new_pos not in visited and state.grid[new_pos[0], new_pos[1], 0] == 0:  # Assuming 0 is empty space\n          visited.add(new_pos)\n          \n          # If there's a primitive at the new position, add move action\n          if state.grid[new_pos[0], new_pos[1], index] > 0:\n            queue.append((new_pos, actions + [env.action_specs()[\"RIGHT\"]]))\n          else:\n            # Otherwise, just move\n            queue.append((new_pos, actions + [env.action_specs()[\"RIGHT\"]]))\n  \n  return []  # If no path found", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:02:03.192850", "function_name": "collect", "function_body": "  index = env.world.cookbook.index[primitive]\n  \n  # If we already have it, return empty list\n  if env._current_state.inventory[index] > 0:\n    return []\n  \n  # If the primitive is not in the environment, raise error\n  if index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} is not grabbable.\")\n    \n  # Get current state\n  state = env._current_state\n  \n  # Use BFS to find shortest path to collect primitive\n  queue = collections.deque([(state.pos, [])])\n  visited = set()\n  visited.add(state.pos)\n  \n  while queue:\n    pos, actions = queue.popleft()\n    \n    # Check if we are at the primitive location\n    if state.grid[pos[0], pos[1], index] > 0:\n      return actions\n    \n    # Get all possible moves (up, down, left, right)\n    for move in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n      new_pos = (pos[0] + move[0], pos[1] + move[1])\n      \n      # Check if position is valid\n      if (new_pos[0] >= 0 and new_pos[0] < state.grid.shape[0] and \n          new_pos[1] >= 0 and new_pos[1] < state.grid.shape[1]):\n        \n        # Check if we have already visited this position or it's an obstacle\n        if new_pos not in visited and state.grid[new_pos[0], new_pos[1], 0] == 0:  # Assuming 0 is empty space\n          visited.add(new_pos)\n          \n          # If there's a primitive at the new position, add move action\n          if state.grid[new_pos[0], new_pos[1], index] > 0:\n            queue.append((new_pos, actions + [env.action_specs()[\"RIGHT\"]]))\n          else:\n            # Otherwise, just move\n            queue.append((new_pos, actions + [env.action_specs()[\"RIGHT\"]]))\n  \n  return []  # If no path found", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:02:30.152532", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the primitive is already in inventory\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n\n  # Check if the primitive is available in the environment (not in non_grabbable_indices)\n  if primitive_index in env.world.non_grabbable_indices:\n      return []\n\n  # Find all locations where the primitive exists\n  primitive_locations = []\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If primitive is not found, try to make it using tools\n      # This is a simplified version - in reality you would need to check recipes\n      return []\n\n  # Simple pathfinding: move towards the first location\n  current_pos = env._current_state.pos\n  target_pos = primitive_locations[0]\n\n  actions = []\n  # Move towards the target position\n  while current_pos != target_pos:\n      x, y = current_pos\n      tx, ty = target_pos\n\n      if x < tx:\n          actions.append(1)  # UP\n          current_pos = (x + 1, y)\n      elif x > tx:\n          actions.append(0)  # DOWN\n          current_pos = (x - 1, y)\n      elif y < ty:\n          actions.append(3)  # RIGHT\n          current_pos = (x, y + 1)\n      elif y > ty:\n          actions.append(2)  # LEFT\n          current_pos = (x, y - 1)\n\n  # If at target position, try to collect the primitive\n  if current_pos == target_pos:\n      # Check if we can pick it up directly\n      if env._current_state.grid[current_pos[0], current_pos[1], primitive_index] > 0:\n          actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:02:32.165952", "function_name": "collect", "function_body": "  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the primitive is already in inventory\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n\n  # Check if the primitive is available in the environment (not in non_grabbable_indices)\n  if primitive_index in env.world.non_grabbable_indices:\n      return []\n\n  # Find all locations where the primitive exists\n  primitive_locations = []\n  for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # If primitive is not found, try to make it using tools\n      # This is a simplified version - in reality you would need to check recipes\n      return []\n\n  # Use A* pathfinding for better efficiency\n  def a_star_pathfind(start, goal):\n      # Simple implementation of A* - in practice you'd want a more robust version\n      actions = []\n      current_pos = start\n\n      while current_pos != goal:\n          x, y = current_pos\n          tx, ty = goal\n\n          if manhattan_distance((x, y), (tx, ty)) == 0:\n              break\n\n          # Prefer moving towards the target\n          if x < tx:\n              actions.append(1)  # UP\n              current_pos = (x + 1, y)\n          elif x > tx:\n              actions.append(0)  # DOWN\n              current_pos = (x - 1, y)\n          elif y < ty:\n              actions.append(3)  # RIGHT\n              current_pos = (x, y + 1)\n          elif y > ty:\n              actions.append(2)  # LEFT\n              current_pos = (x, y - 1)\n\n      return actions\n\n  # Find the closest location to the agent\n  closest_location = min(primitive_locations, key=lambda loc: manhattan_distance(env._current_state.pos, loc))\n  actions = a_star_pathfind(env._current_state.pos, closest_location)\n\n  # If at target position, try to collect the primitive\n  if env._current_state.grid[closest_location[0], closest_location[1], primitive_index] > 0:\n      actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-15T19:03:10.007175", "function_name": "collect", "function_body": "  primitive_index = env.world.cookbook.index[primitive]\n  \n  # If primitive is already in inventory, no actions needed\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n\n  pos = env._current_state.pos\n  grid = env._current_state.grid\n  width, height = grid.shape[:2]\n\n  # Check if the primitive is immediately adjacent and accessible\n  for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n          nx, ny = pos[0] + dx, pos[1] + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              if grid[nx, ny, primitive_index] > 0:\n                  # Move toward the primitive and collect it\n                  dir_map = {(0, -1): 2, (0, 1): 3, (-1, 0): 0, (1, 0): 1}  # UP, DOWN, LEFT, RIGHT\n                  direction = (dx, dy)\n                  if direction in dir_map:\n                      return [dir_map[direction], 4]  # Move and USE\n\n  # Use BFS to find the path to the primitive\n  visited = set()\n  queue = collections.deque([(pos, [])])\n  \n  while queue:\n      current_pos, path = queue.popleft()\n      \n      if current_pos in visited:\n          continue\n      visited.add(current_pos)\n      \n      # Check if we're at a cell with the primitive\n      if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n          actions = path[:]\n          dir_map = {(0, -1): 2, (0, 1): 3, (-1, 0): 0, (1, 0): 1}  # UP, DOWN, LEFT, RIGHT\n          \n          # Determine the direction to move from current position to primitive location\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  nx, ny = current_pos[0] + dx, current_pos[1] + dy\n                  if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                      if grid[nx, ny, primitive_index] > 0:\n                          # Add movement action\n                          direction = (dx, dy)\n                          if direction in dir_map:\n                              actions.append(dir_map[direction])\n                          actions.append(4)  # USE to collect\n                          return actions\n      \n      # Add neighbors to queue with proper actions\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n              # Check if the cell is walkable (not occupied by the primitive we're looking for)\n              if grid[new_pos[0], new_pos[1], primitive_index] == 0:\n                  # Determine direction from current to new position\n                  dir_map = {(0, -1): 2, (0, 1): 3, (-1, 0): 0, (1, 0): 1}  # UP, DOWN, LEFT, RIGHT\n                  direction = (dx, dy)\n                  if direction in dir_map:\n                      new_path = path + [dir_map[direction]]\n                      queue.append((new_pos, new_path))\n\n  return []  # No path found", "island_id": 1, "scores": {"3": 0.0}}
