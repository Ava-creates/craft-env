{"timestamp": "2025-08-15T15:37:29.386203", "function_name": "collect", "function_body": "  # Find the index for the primitive we want to collect\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Get current state and grid\n  state = env._current_state\n  grid = state.grid\n\n  # Find all positions where this primitive is present\n  positions = np.where(grid[:, :, primitive_index] > 0)\n  if len(positions[0]) == 0:\n      return []  # Primitive not found on grid\n\n  # Get agent's current position\n  agent_pos = state.pos\n\n  # Find closest position to the agent\n  min_dist = float('inf')\n  closest_pos = None\n  for i in range(len(positions[0])):\n      pos = (positions[0][i], positions[1][i])\n      dist = abs(pos[0] - agent_pos[0]) + abs(pos[1] - agent_pos[1])\n      if dist < min_dist:\n          min_dist = dist\n          closest_pos = pos\n\n  # Plan path to the primitive using BFS\n  from collections import deque\n  queue = deque([(agent_pos, [])])\n  visited = set()\n  visited.add(agent_pos)\n  \n  while queue:\n      current_pos, path = queue.popleft()\n      \n      if current_pos == closest_pos:\n          return path\n      \n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          if (new_pos not in visited and \n              0 <= new_pos[0] < grid.shape[0] and \n              0 <= new_pos[1] < grid.shape[1]):\n              \n              # Check if the cell is walkable or contains the primitive\n              cell_kind = np.argmax(grid[new_pos[0], new_pos[1], :])\n              if (cell_kind == primitive_index or \n                  cell_kind not in env.world.non_grabbable_indices):\n                  \n                  visited.add(new_pos)", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-15T15:37:47.619522", "function_name": "collect", "function_body": "  # Get the index for the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # If primitive is in inventory, return empty list\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n\n  # If the agent is already at a position where the primitive is present,\n  # just move to that location and collect it.\n  if env._current_state.next_to(primitive_index):\n      # Determine direction to move (this is a simplified version)\n      actions = []\n      pos = env._current_state.pos\n      grid = env._current_state.grid\n      width, height = grid.shape[:2]\n      \n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = pos[0] + dx, pos[1] + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if grid[nx, ny, primitive_index] > 0:\n                      # Determine direction from current position to primitive location\n                      dir_map = {(0, -1): 2, (0, 1): 3, (-1, 0): 0, (1, 0): 1}  # UP, DOWN, LEFT, RIGHT\n                      if dx == 0 and dy == -1:\n                          actions.append(2)  # Move LEFT\n                      elif dx == 0 and dy == 1:\n                          actions.append(3)  # Move RIGHT\n                      elif dx == -1 and dy == 0:\n                          actions.append(0)  # Move UP\n                      elif dx == 1 and dy == 0:\n                          actions.append(1)  # Move DOWN\n                      actions.append(4)  # USE to collect\n                      return actions\n\n  # Otherwise, use BFS or A* to find the path to the primitive\n  visited = set()\n  queue = collections.deque([(env._current_state.pos, [])])\n  \n  while queue:\n      current_pos, path = queue.popleft()\n      \n      if current_pos in visited:\n          continue\n      visited.add(current_pos)\n      \n      # Check if we're at a cell with the primitive\n      if env._current_state.grid[current_pos[0], current_pos[1], primitive_index] > 0:\n          # Return the path to get here plus the action to collect it\n          actions = path[:]\n          dir_map = {(0, -1): 2, (0, 1): 3, (-1, 0): 0, (1, 0): 1}  # UP, DOWN, LEFT, RIGHT\n          \n          # Determine the direction to move from current position to primitive location\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  nx, ny = current_pos[0] + dx, current_pos[1] + dy\n                  if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                      if env._current_state.grid[nx, ny, primitive_index] > 0:\n                          # Add movement action\n                          direction = (dx, dy)\n                          if direction in dir_map:\n                              actions.append(dir_map[direction])\n                          actions.append(4)  # USE to collect\n                          return actions\n      \n      # Add neighbors to queue\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n              # Check if the cell is walkable (not an obstacle or water unless we can cross it)\n              if env._current_state.grid[new_pos[0], new_pos[1], primitive_index] == 0:\n                  queue.append((new_pos, path + [0]))  # Placeholder for actual direction\n\n  return []  # No path found", "island_id": 1, "scores": {"3": 0.0}}
