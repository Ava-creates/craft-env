dx == 1:\n                  action = action_map['DOWN']\n              elif dx == -1:\n                  action = action_map['UP']\n              elif dy == 1:\n                  action = action_map['RIGHT']\n              else:  # dy == -1\n                  action = action_map['LEFT']\n              \n              queue.append((nx, ny, actions + [action]))\n          else:\n              # Check if we can use an item in inventory to pass through this cell\n              # This requires checking if any tool in inventory can allow passage\n              # For example: BRIDGE for WATER, PICKAXE for GEM, etc.\n              \n              # Simplified approach - just check if there's a bridge or similar item\n              # that could help us cross this obstacle\n              can_pass = False\n              \n              # Check inventory for tools that might allow passage\n              for item_idx in range(len(current_state.inventory)):\n                  if current_state.inventory[item_idx] > 0:\n                      # This is a simplified check - in practice, you'd have a mapping of items to their capabilities\n                      # For now, we'll assume certain items can help pass through obstacles\n                      # For example: BRIDGE for WATER, etc.\n                      \n                      # This would require more complex logic based on the actual game rules\n                      # For now, just skip these cases as they are not essential for basic collection\n                      pass  # Skip complex passage logic for now\n\n              if can_pass:\n                  visited.add((nx, ny))\n                  # Map dx, dy to action\n                  if dx == 1:\n                      action = action_map['DOWN']\n                  elif dx == -1:\n                      action = action_map['UP']\n                  elif dy == 1:\n                      action = action_map['RIGHT']\n                  else:  # dy == -1\n                    