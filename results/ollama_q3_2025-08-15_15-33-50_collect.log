{"timestamp": "2025-08-15T15:36:39.406027", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if we can directly collect it\n  if state.next_to(primitive_index):\n      return [craft.USE]  # Use action to pick up\n  \n  # Find a path using BFS to reach the primitive\n  queue = collections.deque([(state.pos, [])])\n  visited = set()\n  visited.add(state.pos)\n  \n  while queue:\n      current_pos, actions = queue.popleft()\n      \n      if state.grid[current_pos[0], current_pos[1], primitive_index] > 0:\n          return actions  # Found the primitive\n\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:  # UP, DOWN, RIGHT, LEFT\n          new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n          \n          if (new_pos not in visited and \n              0 <= new_pos[0] < state.grid.shape[0] and \n              0 <= new_pos[1] < state.grid.shape[1]):\n              \n              # Check if we can move to this cell\n              if state.grid[new_pos[0], new_pos[1], primitive_index] > 0:\n                  queue.append((new_pos, actions + [craft.DOWN if dx == 1 else craft.UP if dx == -1 else craft.RIGHT if dy == 1 else craft.LEFT]))\n                  visited.add(new_pos)\n  \n  return []  # No path found", "island_id": 0, "scores": {"3": -1}}
