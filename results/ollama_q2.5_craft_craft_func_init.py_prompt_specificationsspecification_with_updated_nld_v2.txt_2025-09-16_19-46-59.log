tate.inventory[primitive_index] += 1\n\n  def collect_primitive(env, primitive_index):\n    cookbook = env.world.cookbook\n    \n    if primitive_index in cookbook.primitives:\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0:\n            current_pos = env._current_state.pos\n\n            closest_position = min(\n                positions, \n                key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            )\n            \n            target_pos = tuple(closest_position)\n\n            actions_to_take = get_move_actions(target_pos)\n            actions_to_take.append(4)  # Collect the primitive\n            \n            return actions_to_take\n        else:\n            raise ValueError(f\"No {primitive_index} found in the grid.\")\n    else:\n        raise ValueError(f\"{primitive_index} is not a known primitive.\")\n\n  def craft_with_hierarchy(env, hierarchy):\n      actions_to_take = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          actions_to_take.extend(craft_with_hierarchy(env, sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          recipe = env.world.cookbook.recipes[hierarchy['item']].copy()\n          \n          if '_at' in recipe:\n              del recipe['_at']\n          \n          # Collect all required primitives\n          for primitive_index in hierarchy['prerequisites']:\n              actions_to_take.extend(collect_primitive(env, primitive_index))\n          \n          # Craft the item\n          actions_to_take.extend(craft_item(env, hierarchy['item']))\n          \n          # Update inventory\n          update_inventory(env, recipe)\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    actions_to_take = craft_with_hierarchy(env, recipe_hierarchy)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
