  \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": 11.299999}}
{"timestamp": "2025-09-19T03:16:14.458174", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive\n        \n        env._current_state.inventory[primitive_index] += count  # Simulate collection\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)  # Retry crafting\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": 11.299999}}
{"timestamp": "2025-09-19T03:24:38.464951", "function_name": "craft", "function_body": "  def get_index(name):\n    \"\"\"Get the index of an item by name.\"\"\"\n    return env.world.item_names.index(name)\n\n  def get_name(index):\n    \"\"\"Get the name of an item by index.\"\"\"\n    return env.world.item_names[index]\n\n  def get_index_from_dict(item_dict, key_name):\n    \"\"\"Convert dictionary keys from names to indices.\"\"\"\n    return {get_index(key): value for key, value in item_dict.items() if key in env.world.item_names}\n\n  def get_recipe(index):\n    \"\"\"Get the recipe of an item by index.\"\"\"\n    recipe = env.world.recipes.get(index)\n    if recipe:\n        return get_index_from_dict(recipe, 'name')\n    return {}\n\n  def get_all_primitives_for_item(item_index):\n      \"\"\"Recursively find all primitives required for an item.\"\"\"\n      recipe = get_recipe(item_index)\n      \n      if not recipe:\n          return set([item_index])\n      \n      primitives_needed = set()\n      \n      # Collect all primitives needed directly and recursively\n      for primitive_index in recipe.keys():\n          primitives_needed.update(get_all_primitives_for_item(primitive_index))\n      \n      return primitives_needed\n\n  def get_workshop(item_index):\n    \"\"\"Get the workshop required to craft an item by index.\"\"\"\n    recipe = env.world.recipes.get(item_index)\n    if recipe:\n        return recipe.get('workshop', None)\n    return None\n\n  def collect_primitives(env, recipe):\n    \"\"\"Collect all required primitives for a given recipe.\"\"\"\n    actions_to_take = []\n    \n    for primitive_index, count in recipe.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env.world.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env.agent.position\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env.agent.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_move_actions(target_pos):\n    \"\"\"Get move actions to reach a target position.\"\"\"\n    current_pos = env.agent.position\n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if target_pos[0] < current_pos[0]:\n        actions_to_take.extend([0] * (current_pos[0] - target_pos[0]))  # Move UP\n    elif target_pos[0] > current_pos[0]:\n        actions_to_take.extend([1] * (target_pos[0] - current_pos[0]))  # Move DOWN\n    \n    if target_pos[1] < current_pos[1]:\n        actions_to_take.extend([2] * (current_pos[1] - target_pos[1]))  # Move LEFT\n    elif target_pos[1] > current_pos[1]:\n        actions_to_take.extend([3] * (target_pos[1] - current_pos[1]))  # Move RIGHT\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    \"\"\"Find the closest workshop of a given type.\"\"\"\n    workshop_index = get_index(workshop_name)\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env.world.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env.agent.position\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def is_item_collected(item_index):\n      \"\"\"Check if all required primitives of an item are collected.\"\"\"\n      recipe = get_recipe(item_index)\n      \n      if not recipe:\n          return True\n      \n      # Check if all required primitives are in the inventory with sufficient count\n      return all(env.agent.inventory.get(primitive_index, 0) >= count for primitive_index, count in recipe.items())\n\n  def craft_item(env, item_index):\n    \"\"\"Craft an item at the closest workshop.\"\"\"\n    actions_to_take = []\n    \n    workshop_name = get_workshop(item_index)\n    if not workshop_name:\n        raise ValueError(f\"No workshop specified to craft {get_name(item_index)}.\")\n    \n    workshop_pos = find_closest_workshop(env, workshop_name)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = get_recipe(item_index)\n      \n      if not recipe:\n          return {'item': item_index, 'prerequisites': {}, 'sub_recipes': {}}\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env.agent.inventory or env.agent.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    for primitive_index in recipe:\n        # Add the primitive to the inventory\n        env.agent.inventory[primitive_index] = env.agent.inventory.get(primitive_index, 0) + 1\n\n  def craft_item_with_retry(env, item_index):\n    \"\"\"Craft an item with retry mechanism in case of failure.\"\"\"\n    actions_to_take = []\n    \n    workshop_name = get_workshop(item_index)\n    if not workshop_name:\n        raise ValueError(f\"No workshop specified to craft {get_name(item_index)}.\")\n    \n    workshop_pos = find_closest_workshop(env, workshop_name)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    # Check if the item was crafted successfully\n    if not is_item_collected(item_index):\n        # Retry once more\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def prioritize_items_by_workshop(items_to_craft):\n      \"\"\"Prioritize items by the number of primitives they require at each workshop.\"\"\"\n      prioritized_sequence = []\n      \n      while items_to_craft:\n          current_item_index = items_to_craft.pop(0)\n          workshop_name = get_workshop(current_item_index)\n          \n          # Calculate the total number of primitives required for the current item and its sub-items\n          all_primitives = get_all_primitives_for_item(current_item_index)\n          \n          # Add the current item to the prioritized sequence\n          prioritized_sequence.append({\n              'item': current_item_index,\n              'workshop': workshop_name,\n              'primitives_count': len(all_primitives)\n          })\n      \n      # Sort items by the number of primitives required at each workshop (descending order)\n      prioritized_sequence.sort(key=lambda x: x['primitives_count'], reverse=True)\n      \n      return [item_info['item'] for item_info in prioritized_sequence]\n\n  def collect_all_required_primitives(env, items_to_craft):\n    \"\"\"Collect all required primitives for the list of items.\"\"\"\n    actions_to_take = []\n    \n    # Create a dictionary to count required primitives across all items\n    required_primitives = collections.defaultdict(int)\n    \n    for item_index in items_to_craft:\n        recipe = get_recipe(item_index)\n        \n        if not recipe:\n            continue\n        \n        for primitive_index, count in recipe.items():\n            if primitive_index in env.agent.inventory and env.agent.inventory[primitive_index] >= count:\n                continue\n            required_primitives[primitive_index] += max(count - env.agent.inventory.get(primitive_index, 0), 0)\n    \n    # Collect all required primitives\n    for primitive_index, count in required_primitives.items():\n        actions_to_take.extend(collect_primitives(env, {primitive_index: count}))\n    \n    return actions_to_take\n\n  # Get the index for the desired item to be crafted\n  item_index = get_index(item)\n  \n  if not get_recipe(item_index):\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  # Get the recipe hierarchy and flatten it into a list of items to be crafted in order\n  recipe_hierarchy = get_recipe_hierarchy(item_index)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  # Prioritize items by the number of primitives they require at each workshop\n  prioritized_items_to_craft = prioritize_items_by_workshop(items_to_craft)\n\n  actions_to_take = []\n\n  # Collect all required primitives for the list of items\n  actions_to_take.extend(collect_all_required_primitives(env, prioritized_items_to_craft))\n\n  # Craft each item in the prioritized sequence\n  for current_item_index in prioritized_items_to_craft:\n      if is_item_collected(current_item_index):\n          continue\n      \n      actions_to_take.extend(craft_item_with_retry(env, current_item_index))\n      \n      # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n      recipe = get_recipe(current_item_index)\n      update_inventory(env, recipe)\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-19T03:24:39.462572", "function_name": "craft", "function_body": "  def get_all_primitives_for_item(item_index: int, cookbook):\n    \"\"\"Get all primitives required to craft an item recursively.\"\"\"\n    recipe = cookbook.recipes[item_index].copy()\n    \n    if '_at' in recipe:\n        del recipe['_at']\n    \n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    all_primitives = set(primitives_needed.keys())\n    \n    # Recursively find all sub-primitives\n    for primitive_index in list(primitives_needed.keys()):\n        if primitive_index in cookbook.recipes:\n            all_primitives.update(get_all_primitives_for_item(primitive_index, cookbook))\n    \n    return all_primitives\n\n  def prioritize_items_by_workshop(items_to_craft: list[int], cookbook):\n    \"\"\"Prioritize items by the number of primitives they require at each workshop.\"\"\"\n    prioritized_sequence = []\n    \n    while items_to_craft:\n        current_item = items_to_craft.pop(0)\n        workshop_name = cookbook.recipes[current_item]['_at']\n        \n        # Calculate the total number of primitives required for the current item and its sub-items\n        all_primitives = get_all_primitives_for_item(current_item, cookbook)\n        \n        # Add the current item to the prioritized sequence\n        prioritized_sequence.append({\n            'item': current_item,\n            'workshop': workshop_name,\n            'primitives_count': len(all_primitives)\n        })\n    \n    # Sort items by the number of primitives required at each workshop (descending order)\n    prioritized_sequence.sort(key=lambda x: x['primitives_count'], reverse=True)\n    \n    return [item_info['item'] for item_info in prioritized_sequence]\n\n  def get_recipe_hierarchy(item_index: int, cookbook):\n    \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n    recipe = cookbook.recipes[item_index].copy()\n    \n    if '_at' in recipe:\n        del recipe['_at']\n    \n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    sub_recipes = {}\n\n    # Find recipes for each primitive needed\n    for primitive_index in list(primitives_needed.keys()):\n        if primitive_index in cookbook.recipes:\n            sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n    \n    return {\n        'item': item_index,\n        'prerequisites': primitives_needed,\n        'sub_recipes': sub_recipes\n    }\n\n  def flatten_recipe_hierarchy(hierarchy):\n    \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n    flattened = []\n    \n    # Add all sub-recipes first\n    for sub_recipe in hierarchy['sub_recipes'].values():\n        flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n    \n    # Then add the current item if it's not already collected\n    if not is_item_collected(hierarchy['item']):\n        flattened.append(hierarchy['item'])\n    \n    return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory.setdefault(primitive_index, 0)\n        env._current_state.inventory[primitive_index] += 1\n\n  def is_item_collected(item_index: int):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def find_closest_workshop(env, item_index: int):\n    \"\"\"Find the closest workshop to craft an item.\"\"\"\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = (env._current_state.x, env._current_state.y)\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def craft_item(env, item_index: int):\n    \"\"\"Craft an item at the closest workshop.\"\"\"\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(env, workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_move_actions(env, target_pos):\n      \"\"\"Get move actions to reach a target position.\"\"\"\n      current_x, current_y = env._current_state.x, env._current_state.y\n      target_x, target_y = target_pos\n      \n      actions_to_take = []\n      \n      # Determine direction based on relative position and move accordingly\n      if target_x > current_x:\n          actions_to_take.extend([3] * (target_x - current_x))  # Move RIGHT\n      elif target_x < current_x:\n          actions_to_take.extend([2] * (current_x - target_x))  # Move LEFT\n      \n      if target_y > current_y:\n          actions_to_take.extend([1] * (target_y - current_y))  # Move DOWN\n      elif target_y < current_y:\n          actions_to_take.extend([0] * (current_y - target_y))  # Move UP\n      \n      return actions_to_take\n\n  def collect_primitive(env, primitive_index: int):\n    \"\"\"Collect a required primitive.\"\"\"\n    actions_to_take = []\n    \n    # Find positions of the required primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) > 0:\n        current_pos = (env._current_state.x, env._current_state.y)\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(env, target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory.setdefault(primitive_index, 0)\n        env._current_state.inventory[primitive_index] += 1\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    \"\"\"Collect all required primitives to craft an item.\"\"\"\n    actions_to_take = []\n    \n    for primitive_index, count in recipe.items():\n      if (not is_item_collected(primitive_index) or \n          env._current_state.inventory[primitive_index] < count):\n          # Collect the required number of primitives\n          for _ in range(count - (env._current_state.inventory.get(primitive_index, 0))):\n              actions_to_take.extend(collect_primitive(env, primitive_index))\n    \n    return actions_to_take\n\n  def craft_item_with_retry(env, item_index: int):\n    \"\"\"Craft an item with retry mechanism in case of failure.\"\"\"\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(env, workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    # Check if the item was crafted successfully\n    if not is_item_collected(item_index):\n        # Retry once more\n        actions_to_take.extend(get_move_actions(env, workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def get_items_to_craft(cookbook, initial_inventory, target_item_name):\n      \"\"\"Determine the sequence of items to craft based on the cookbook and initial inventory.\"\"\"\n      target_item_index = cookbook.index[target_item_name]\n      \n      # Start with the target item\n      items_to_craft = [target_item_index]\n      \n      # Track visited items to avoid cycles\n      visited_items = set()\n      \n      while items_to_craft:\n          current_item = items_to_craft.pop(0)\n          \n          if current_item not in visited_items:\n              visited_items.add(current_item)\n              \n              recipe = cookbook.recipes[current_item].copy()\n              \n              if '_at' in recipe:\n                  del recipe['_at']\n              \n              for primitive_index, count in recipe.items():\n                  if (primitive_index not in initial_inventory or \n                      initial_inventory[primitive_index] < count):\n                      # If the primitive is a sub-item (recipe exists), add it to the crafting list\n                      if primitive_index in cookbook.recipes:\n                          items_to_craft.append(primitive_index)\n      \n      return items_to_craft\n\n  def optimize_crafting_sequence(items_to_craft, cookbook):\n      \"\"\"Optimize the sequence of crafting items based on shared workshops.\"\"\"\n      workshop_map = collections.defaultdict(list)\n      \n      for item_index in items_to_craft:\n          workshop_name = cookbook.recipes[item_index]['_at']\n          workshop_map[workshop_name].append(item_index)\n      \n      optimized_sequence = []\n      \n      # Prioritize items by the number of primitives they require\n      for workshop_name, items in workshop_map.items():\n          prioritized_items = prioritize_items_by_workshop(items, cookbook)\n          optimized_sequence.extend(prioritized_items)\n      \n      return optimized_sequence\n\n  def main(env, target_item_name):\n    \"\"\"Main function to determine and execute crafting actions.\"\"\"\n    actions_to_take = []\n    \n    cookbook = env.world.cookbook\n    initial_inventory = {item_index: count for item_index, count in env._current_state.inventory.items()}\n    \n    # Determine the sequence of items to craft\n    items_to_craft = get_items_to_craft(cookbook, initial_inventory, target_item_name)\n    \n    # Optimize the crafting sequence based on shared workshops\n    optimized_sequence = optimize_crafting_sequence(items_to_craft, cookbook)\n    \n    # Flatten the recipe hierarchy into a list of items to be crafted in order\n    hierarchy = get_recipe_hierarchy(optimized_sequence[-1], cookbook)\n    flattened_items = flatten_recipe_hierarchy(hierarchy)\n    \n    for item_index in flattened_items:\n        recipe = cookbook.recipes[item_index].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        # Collect required primitives\n        actions_to_take.extend(collect_primitives(env, recipe))\n        \n        # Craft the item with retry mechanism\n        actions_to_take.extend(craft_item_with_retry(env, item_index))\n    \n    return actions_to_take\n\n  # Example usage\n  target_item_name = \"AdvancedTool\"\n  actions_to_take = main(self, target_item_name)\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-19T03:29:44.531257", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Sort positions by distance to current position\n        current_pos = env._current_state.pos\n        sorted_positions = sorted(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        for _ in range(count):\n          if not sorted_positions:\n              break  # No more primitives available to collect\n          \n          pos = sorted_positions.pop(0)\n          pos_tuple = tuple(pos)\n          \n          if pos_tuple not in visited_positions:\n              actions_to_take.extend(get_move_actions(pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] += 1\n              \n              visited_positions.add(pos_tuple)\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 7, "scores": {"3": 11.199999}}
