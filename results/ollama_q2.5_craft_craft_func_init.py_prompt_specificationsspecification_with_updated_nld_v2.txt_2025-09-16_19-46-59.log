{"timestamp": "2025-09-17T03:33:34.608726", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Determine direction and move accordingly\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def is_next_to_workshop(current_x, current_y, target_x, target_y):\n    return abs(current_x - target_x) <= 1 and abs(current_y - target_y) <= 1\n  \n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  if not is_next_to_workshop(current_x, current_y, target_x, target_y):\n    actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 3.9}}
{"timestamp": "2025-09-17T03:33:35.685348", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Determine direction and move accordingly\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def rotate_and_move(current_x, current_y, target_x, target_y):\n    actions = []\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n    \n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(rotate_and_move(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:34:51.940980", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Determine the sequence of moves based on direction differences\n      if tx > sx:\n          actions.extend([3] * (tx - sx))  # RIGHT\n      elif tx < sx:\n          actions.extend([2] * (sx - tx))  # LEFT\n      \n      if ty > sy:\n          actions.extend([1] * (ty - sy))  # UP\n      elif ty < sy:\n          actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  def move_to_target(target):\n    current_x, current_y = env._current_state.pos\n    path_actions = calculate_path((current_x, current_y), target)\n    for action in path_actions:\n        yield action\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to_target(closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:34:52.930260", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Determine the sequence of moves based on direction differences\n      if tx > sx:\n          actions.extend([3] * (tx - sx))  # RIGHT\n      elif tx < sx:\n          actions.extend([2] * (sx - tx))  # LEFT\n      \n      if ty > sy:\n          actions.extend([1] * (ty - sy))  # UP\n      elif ty < sy:\n          actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  def face_direction(direction):\n    \"\"\"Adjusts the agent's direction to the specified one.\"\"\"\n    current_dir = env._current_state.dir\n    target_dir = {\"UP\": 1, \"DOWN\": 0, \"LEFT\": 2, \"RIGHT\": 3}[direction]\n    \n    if target_dir == (current_dir + 1) % 4:\n        actions.append(5)  # TURN_RIGHT\n    elif target_dir == (current_dir - 1) % 4:\n        actions.append(6)  # TURN_LEFT\n    elif target_dir != current_dir:\n        actions.extend([5, 5])  # TURN_RIGHT twice to turn around\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def align_with_workshop():\n    \"\"\"Aligns the agent with the workshop direction before using it.\"\"\"\n    current_x, current_y = env._current_state.pos\n    tx, ty = closest_workshop_pos\n    \n    if tx > current_x:\n        face_direction(\"RIGHT\")\n    elif tx < current_x:\n        face_direction(\"LEFT\")\n    \n    if ty > current_y:\n        face_direction(\"UP\")\n    elif ty < current_y:\n        face_direction(\"DOWN\")\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Align with the workshop direction before using it\n  align_with_workshop()\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:35:57.182807", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if rel_x != 0:\n      direction = 3 if rel_x > 0 else 2\n      actions_to_take.extend([direction] * abs(rel_x))\n      \n    if rel_y != 0:\n      direction = 1 if rel_y > 0 else 0\n      actions_to_take.extend([direction] * abs(rel_y))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:35:58.296845", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_closest_workshop(workshop_index):\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          return tuple(closest_workshop)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Get the closest workshop position\n    target_workshop_pos = get_closest_workshop(workshop_index)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:37:38.820792", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T03:37:39.784798", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the closest available workshop\n  target_pos = min(workshop_positions, key=lambda pos: heuristic(current_pos, tuple(pos)))\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:38:45.910132", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      \n      if target_x > current_x:\n          actions.append(3)  # RIGHT\n      elif target_x < current_x:\n          actions.append(2)  # LEFT\n      \n      if target_y > current_y:\n          actions.append(1)  # UP\n      elif target_y < current_y:\n          actions.append(0)  # DOWN\n\n  def is_workshop_next_to(target_x, target_y):\n    for dx in range(-1, 2):\n        for dy in range(-1, 2):\n            if abs(dx) + abs(dy) == 1:  # Only consider adjacent positions\n                x = target_x + dx\n                y = target_y + dy\n                if env._current_state.grid[x, y, workshop_index] == 1:\n                    return True\n    return False\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Move towards the workshop until next to it\n  while not is_workshop_next_to(target_x, target_y):\n      move_towards(target_x, target_y)\n  \n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:38:46.966131", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def calculate_path(start, target):\n    \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n    sx, sy = start\n    tx, ty = target\n    \n    if tx > sx:\n        actions.extend([3] * (tx - sx))  # RIGHT\n    elif tx < sx:\n        actions.extend([2] * (sx - tx))  # LEFT\n    \n    if ty > sy:\n        actions.extend([1] * abs(ty - sy))  # UP\n    elif ty < sy:\n        actions.extend([0] * abs(sy - ty))  # DOWN\n\n  def is_workshop_next_to(current_x, current_y, workshop_positions):\n      for wx, wy in workshop_positions:\n          if abs(wx - current_x) + abs(wy - current_y) == 1:\n              return True\n      return False\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  if is_workshop_next_to(current_x, current_y, workshop_positions):\n      actions.append(4)  # USE\n  else:\n      calculate_path((current_x, current_y), closest_workshop_pos)\n      actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:40:11.043501", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    # Determine the direction to move first (horizontal or vertical)\n    if abs(rel_x) >= abs(rel_y):\n        # Move horizontally first\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))\n            \n        # Then move vertically\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        # Move vertically first\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))\n\n        # Then move horizontally\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))\n    \n    return actions_to_take\n\n  def get_closest_workshop(workshop_index):\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          return tuple(closest_workshop)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Get the closest workshop position\n    target_workshop_pos = get_closest_workshop(workshop_index)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:40:12.021363", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_closest_workshop(workshop_index):\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          return tuple(closest_workshop)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def collect_primitives(primitive_indices):\n    actions_to_take = []\n    current_inventory = env._current_state.inventory\n\n    for primitive_index in primitive_indices:\n        if not current_inventory[primitive_index]:\n            # Find all positions of the specified primitive in the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(primitive_positions) > 0:\n                closest_primitive = min(\n                    primitive_positions, \n                    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                )\n                \n                target_primitive_pos = tuple(closest_primitive)\n                \n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index]\n\n      # Extract the workshop from the recipe\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Collect all primitives required by the recipe\n      primitive_indices = [cookbook.index[ingredient] for ingredient in recipe if ingredient != '_at']\n      actions_to_take = collect_primitives(primitive_indices)\n\n      # Get the closest workshop position\n      target_workshop_pos = get_closest_workshop(workshop_index)\n      \n      # Calculate move actions to reach the closest workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:41:22.177988", "function_name": "craft", "function_body": "  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def astar(start, goal):\n      open_set = set()\n      closed_set = set()\n      g = {start: 0}\n      f = {start: heuristic(start, goal)}\n      came_from = {}\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=f.get)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dir_vec in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = tuple(np.array(current) + np.array(dir_vec))\n              \n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                      0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              tentative_g_score = g[current] + 1\n              \n              if neighbor in closed_set:\n                  continue\n                  \n              if neighbor not in open_set or tentative_g_score < g.get(neighbor, float('inf')):\n                  came_from[neighbor] = current\n                  g[neighbor] = tentative_g_score\n                  f[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  if neighbor not in open_set:\n                      open_set.add(neighbor)\n\n      return []\n\n  def actions_to_move(path):\n      actions = []\n      for i in range(len(path) - 1):\n          diff = np.array(path[i+1]) - np.array(path[i])\n          if np.all(diff == (0, 1)):\n              actions.append(3)  # RIGHT\n          elif np.all(diff == (1, 0)):\n              actions.append(1)  # UP\n          elif np.all(diff == (0, -1)):\n              actions.append(2)  # LEFT\n          elif np.all(diff == (-1, 0)):\n              actions.append(0)  # DOWN\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = tuple(env._current_state.pos)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  path_to_workshop = astar(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop = actions_to_move(path_to_workshop)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-17T03:41:23.262367", "function_name": "craft", "function_body": "  def get_next_actions_smart(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n\n      # Prioritize horizontal movement to reduce diagonal steps\n      if abs(dx) > abs(dy):\n          direction_x = 3 if dx > 0 else 2\n          actions.extend([direction_x] * abs(dx))  # RIGHT or LEFT\n\n          if dy != 0:\n              direction_y = 1 if dy > 0 else 0\n              actions.extend([direction_y] * abs(dy))  # UP or DOWN\n      else:\n          direction_y = 1 if dy > 0 else 0\n          actions.extend([direction_y] * abs(dy))  # UP or DOWN\n\n          if dx != 0:\n              direction_x = 3 if dx > 0 else 2\n              actions.extend([direction_x] * abs(dx))  # RIGHT or LEFT\n\n      return actions\n  \n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_actions_smart(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:43:07.000258", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T03:43:08.117166", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T03:44:11.300505", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_target(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Calculate steps needed for each direction\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      # Determine the sequence of movements based on relative directions\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def is_near_workshop(current_x, current_y, target_x, target_y):\n    return abs(target_x - current_x) <= 2 and abs(target_y - current_y) <= 2\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_target(current_x, current_y, target_x, target_y))\n\n  # Check if the agent is near enough to use the workshop without moving again\n  if not is_near_workshop(env._current_state.pos[0], env._current_state.pos[1], target_x, target_y):\n      actions.extend(move_to_target(env._current_state.pos[0], env._current_state.pos[1], target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 2.9}}
{"timestamp": "2025-09-17T03:44:12.420517", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_target(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_target(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:45:33.306379", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def calculate_path(start, target):\n    \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n    sx, sy = start\n    tx, ty = target\n    \n    if env._current_state.dir == 0:  # Facing UP\n        actions.extend([1] * (ty - sy))  # UP\n        actions.extend([3] * (tx - sx))  # RIGHT\n        actions.extend([2] * (sx - tx))  # LEFT\n        actions.extend([0] * (sy - ty))  # DOWN\n    \n    elif env._current_state.dir == 1:  # Facing DOWN\n        actions.extend([0] * (sy - ty))  # DOWN\n        actions.extend([3] * (tx - sx))  # RIGHT\n        actions.extend([2] * (sx - tx))  # LEFT\n        actions.extend([1] * (ty - sy))  # UP\n    \n    elif env._current_state.dir == 2:  # Facing LEFT\n        actions.extend([2] * (sx - tx))  # LEFT\n        actions.extend([0] * (sy - ty))  # DOWN\n        actions.extend([1] * (ty - sy))  # UP\n        actions.extend([3] * (tx - sx))  # RIGHT\n    \n    elif env._current_state.dir == 3:  # Facing RIGHT\n        actions.extend([3] * (tx - sx))  # RIGHT\n        actions.extend([0] * (sy - ty))  # DOWN\n        actions.extend([1] * (ty - sy))  # UP\n        actions.extend([2] * (sx - tx))  # LEFT\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  calculate_path((current_x, current_y), closest_workshop_pos)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:45:34.369089", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      # Calculate the sequence of moves based on direction differences\n      dx, dy = tx - sx, ty - sy\n      \n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          else:\n              actions.extend([2] * abs(dx))  # LEFT\n          \n          if dy > 0:\n              actions.extend([1] * abs(dy))  # UP\n          else:\n              actions.extend([0] * abs(dy))  # DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * abs(dy))  # UP\n          else:\n              actions.extend([0] * abs(dy))  # DOWN\n          \n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          else:\n              actions.extend([2] * abs(dx))  # LEFT\n\n  def is_workshop_next_to(current_x, current_y, workshop_positions):\n    for wx, wy in workshop_positions:\n        if abs(wx - current_x) + abs(wy - current_y) == 1:\n            return True\n    return False\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  if is_workshop_next_to(current_x, current_y, workshop_positions):\n    # If already next to a workshop, use the USE action\n    actions.append(4)  # USE\n  else:\n    closest_workshop_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n\n    # Calculate path to the workshop\n    calculate_path((current_x, current_y), closest_workshop_pos)\n\n    # Craft the item (use the USE action)\n    actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:46:29.490312", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Check if the agent is already at the workshop\n  if actions_to_reach_workshop:\n      actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
