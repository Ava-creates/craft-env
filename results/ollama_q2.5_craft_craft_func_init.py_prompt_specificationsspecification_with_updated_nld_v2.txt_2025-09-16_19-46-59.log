tive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def prioritize_primitives(primitives_needed):\n    # Define a priority list based on some criteria (e.g., availability, urgency)\n    priority_list = [\n      'WORKSHOP0', 'WORKSHOP1', 'WORKSHOP2', \n      'WOOD', 'IRON', 'GRASS', 'ROCK', \n      'GOLD', 'GEM', 'WATER', 'STONE'\n    ]\n    \n    cookbook = env.world.cookbook\n    priority_indices = {cookbook.index[name]: i for i, name in enumerate(priority_list)}\n    \n    # Sort primitives by their priority index\n    sorted_primitives = sorted(primitives_needed.items(), key=lambda x: priority_indices.get(x[0], len(priority_indices)))\n    \n    return dict(sorted_primitives)\n\n  def ensure_workshop_availability(env, workshop_index):\n    if np.any(env._current_state.grid[:, :, workshop_index] == 1):\n        return True\n    else:\n        return False\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Check if the workshop is available in the environment\n    if ensure_workshop_availability(env, workshop_index):\n        # Prioritize primitives based on some criteria\n        recipe = prioritize_primitives(recipe)\n\n        # Collect primitives required for crafting if not already in inventory\n        actions_to_take = collect_primitives(env, recipe)\n        \n        try:\n            target_workshop_pos = get_closest_workshop(env, workshop_index)\n            \n            # Calculate move actions to reach the closest workshop\n            actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n            # Use the USE action to craft the item at the workshop\n            actions_to_take.append(4)\n\n        except ValueError as e:\n            print(e)  # Log or handle the error appropriately\n            raise\n    else:\n        raise ValueError(\"No available workshops found for crafting the item.\")\n        \n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T14:34:05.240027", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move vertically first to avoid obstacles in the grid\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))\n            \n    # Then move horizontally\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          closest_primitive_pos = find_closest_position(env, primitive_positions)\n          \n          target_primitive_pos = tuple(closest_primitive_pos)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_closest_position(env, positions):\n    \"\"\"Find the closest available position in the grid.\"\"\"\n    current_pos = env._current_state.pos\n    closest_position = min(\n        positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    return closest_position\n\n  def find_closest_workshop(env, cookbook, workshop_name):\n      \"\"\"Find the closest available workshop position in the grid.\"\"\"\n      world = env.world\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          closest_workshop_pos = find_closest_position(env, workshop_positions)\n          target_workshop_pos = tuple(closest_workshop_pos)\n          return target_workshop_pos\n      else:\n          raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def find_closest_primitive(env, cookbook, primitive):\n      \"\"\"Find the closest available primitive position in the grid.\"\"\"\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          closest_primitive_pos = find_closest_position(env, primitive_positions)\n          target_primitive_pos = tuple(closest_primitive_pos)\n          return target_primitive_pos\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    target_workshop_pos = find_closest_workshop(env, cookbook, workshop_name)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": 4.6}}
{"timestamp": "2025-09-17T14:34:06.224174", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_closest_workshop(env, cookbook, workshop_name):\n    \"\"\"Find the closest available workshop position in the grid.\"\"\"\n    world = env.world\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def find_closest_primitive(env, cookbook, primitive):\n      \"\"\"Find the closest available primitive position in the grid.\"\"\"\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n          return target_primitive_pos\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_path(env, start, end):\n    \"\"\"Find the shortest path from start to end using Breadth-First Search (BFS).\"\"\"\n    from collections import deque\n    \n    # Define possible moves: UP, DOWN, LEFT, RIGHT\n    moves = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n    \n    grid_width, grid_height = env._current_state.grid.shape[0], env._current_state.grid.shape[1]\n    visited = set()\n    queue = deque([(start, [])])\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        \n        if (x, y) == end:\n            return path\n        \n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        \n        for dx, dy in moves:\n            nx, ny = x + dx, y + dy\n            \n            # Ensure the new position is within grid bounds and not an obstacle\n            if 0 <= nx < grid_width and 0 <= ny < grid_height and env._current_state.grid[nx, ny] == 1:\n                queue.append(((nx, ny), path + [(dx, dy)]))\n    \n    raise ValueError(f\"No path found from {start} to {end}.\")\n\n  def convert_path_to_actions(path):\n      \"\"\"Convert a list of (dx, dy) moves to corresponding action indices.\"\"\"\n      action_map = {(0, -1): 0, (0, 1): 1, (-1, 0): 2, (1, 0): 3}\n      actions = [action_map[move] for move in path]\n      return actions\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    target_workshop_pos = find_closest_workshop(env, cookbook, workshop_name)\n\n    # Calculate path actions to reach the closest workshop\n    current_pos = env._current_state.pos\n    path_to_workshop = find_path(env, current_pos, target_workshop_pos)\n    path_actions = convert_path_to_actions(path_to_workshop)\n    actions_to_take.extend(path_actions)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
