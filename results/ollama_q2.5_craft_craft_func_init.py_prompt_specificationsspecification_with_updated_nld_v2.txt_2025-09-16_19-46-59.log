workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 9, "scores": {"3": 11.299999}}
{"timestamp": "2025-09-19T02:45:05.722394", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    cookbook = env.world.cookbook\n    count_needed = cookbook.recipes[primitive_index].get(primitive_index, 1)\n    \n    if primitive_index in env._current_state.inventory and env._current_state.inventory[primitive_index] >= count_needed:\n        return []\n    \n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) == 0:\n        raise ValueError(f\"No available {cookbook.index_to_name[primitive_index]} to collect.\")\n    \n    current_pos = env._current_state.pos\n    closest_primitive = min(\n        primitive_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_primitive_pos = tuple(closest_primitive)\n    actions_to_take = get_move_actions(target_primitive_pos) + [4]  # Collect the primitive\n    \n    if primitive_index in env._current_state.inventory:\n        env._current_state.inventory[primitive_index] += count_needed\n    else:\n        env._current_state.inventory[primitive_index] = count_needed\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    actions_to_take = []\n    \n    for primitive_index in recipe.keys():\n        if primitive_index not in env.world.cookbook.recipes:\n            actions_to_take.extend(collect_primitive(env, primitive_index))\n        else:\n            sub_recipe = env.world.cookbook.recipes[primitive_index].copy()\n            \n            if '_at' in sub_recipe:\n                del sub_recipe['_at']\n            \n            actions_to_take.extend(collect_primitives(env, sub_recipe))\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def simulate_crafting(env, item_index):\n    actions_to_take = []\n    recipe_hierarchy = get_recipe_hierarchy(item_index, env.world.cookbook)\n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = env.world.cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      prerequisites = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      for primitive_index in list(prerequisites.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': prerequisites,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    return simulate_crafting(env, item_index)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-19T02:45:06.821513", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive\n        \n        env._current_state.inventory[primitive_index] += count  # Simulate collection\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def simulate_crafting(env, item_index):\n    \"\"\"Simulate crafting an item and update the inventory.\"\"\"\n    actions_to_take = []\n    recipe_hierarchy = get_recipe_hierarchy(item_index, env.world.cookbook)\n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = env.world.cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  def validate_recipe_availability(item_index, cookbook):\n      \"\"\"Validate if a recipe for the item is available.\"\"\"\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      \n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              validate_recipe_availability(primitive_index, cookbook)\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Validate that all required recipes are available\n  try:\n    validate_recipe_availability(item_index, cookbook)\n  except ValueError as e:\n      raise e\n  \n  return simulate_crafting(env, item_index)", "island_id": 8, "scores": {"3": 11.299999}}
{"timestamp": "2025-09-19T02:49:22.201031", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item_with_retry(env, item_index):\n    \"\"\"Craft an item with retry mechanism in case of failure.\"\"\"\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    # Check if the item was crafted successfully\n    if not is_item_collected(item_index):\n        # Retry once more\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def collect_and_craft_item(env, item_index):\n    \"\"\"Collect required primitives and craft the specified item.\"\"\"\n    cookbook = env.world.cookbook\n    \n    if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      actions_to_take = []\n      \n      # Collect all required primitives\n      actions_to_take.extend(collect_primitives(env, recipe))\n      \n      # Craft the item with retry mechanism\n      actions_to_take.extend(craft_item_with_retry(env, item_index))\n      \n      # Update inventory after crafting the item\n      update_inventory(env, recipe)\n    else:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        actions_to_take.extend(collect_and_craft_item(env, item_to_craft))\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 11.299999}}
{"timestamp": "2025-09-19T02:49:23.169797", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    cookbook = env.world.cookbook\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        actions_to_take = get_move_actions(tuple(closest_primitive))\n        actions_to_take.append(4)  # Use action to collect the primitive\n        \n        env._current_state.inventory[primitive_index] += 1\n        return actions_to_take\n    \n    raise ValueError(f\"No {cookbook.names[primitive_index]} found on the grid.\")\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive_index, 0) < count:\n            actions_to_take.extend(collect_primitive(env, primitive_index))\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    \n    raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        # Retry once more\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        actions_to_take.extend(collect_primitives(env, cookbook.recipes[item_to_craft]))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-19T02:55:38.782156", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n        \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n\n  def craft_item_with_retry(env, item_index):\n    \"\"\"Craft an item with retry mechanism in case of failure.\"\"\"\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    # Check if the item was crafted successfully\n    if not is_item_collected(item_index):\n        # Retry once more\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 7.1}}
{"timestamp": "2025-09-19T02:55:39.929752", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from that hasn't been visited yet\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: (abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]), pos.tobytes())\n        )\n        \n        while tuple(closest_primitive) in visited_positions:\n          # If the closest position has been visited, find the next closest\n          primitive_positions = np.delete(primitive_positions, np.where((primitive_positions == closest_primitive).all(axis=1)), axis=0)\n          \n          if len(primitive_positions) == 0:\n            break\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: (abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]), pos.tobytes())\n          )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n        \n        visited_positions.add(target_primitive_pos)\n\n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    \"\"\"Craft an item with retry mechanism in case of failure.\"\"\"\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    # Check if the item was crafted successfully\n    if not is_item_collected(item_index):\n        # Retry once more\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 11.299999}}
