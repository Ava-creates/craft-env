f len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n    \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n    if required_item_index not in cookbook.recipes:\n        # This is a primitive item\n        return collect(env, cookbook.index.get_key(required_item_index))\n\n    recipe = cookbook.recipes[required_item_index]\n    workshop_name = recipe['_at']\n    \n    # Check if the required ingredients are available or can be crafted\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at' and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n            handle_missing_primitives(env, cookbook, ingredient_index)\n    \n    # Craft the item at the specified workshop\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {cookbook.index.get_key(required_item_index)}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:16:35.429125", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions_to_take = []\n\n    # Move horizontally first\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n\n    # Then move vertically\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n\n    return actions_to_take\n\n  def get_closest_position(current_pos, positions):\n      \"\"\"Find the closest position from a list based on Manhattan distance.\"\"\"\n      return min(positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  def gather_required_items(env, cookbook, recipe):\n    actions = []\n    for required_item_index in recipe.keys():\n        if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n            # Determine the primitive(s) needed to make this item\n            primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n            for primitive in primitives_needed:\n                actions.extend(collect(env, cookbook.index.get_key(primitive)))\n    return actions\n\n  def collect(env, primitive_name):\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      primitive_index = cookbook.index[primitive_name]\n\n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n\n          # Choose the closest available position to collect the item at\n          target_primitive_pos = get_closest_position(current_pos, primitive_positions)\n          \n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive_name}.\")\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n      \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n      if required_item_index not in cookbook.recipes:\n          # This is a primitive item\n          return collect(env, cookbook.index.get_key(required_item_index))\n\n      recipe = cookbook.recipes[required_item_index]\n      workshop_name = recipe['_at']\n      \n      # Check if the required ingredients are available or can be crafted\n      for ingredient_index in recipe.keys():\n          if ingredient_index != '_at' and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n              handle_missing_primitives(env, cookbook, ingredient_index)\n      \n      # Craft the item at the specified workshop\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      # Find all positions of the specified workshop in the grid\n      workshop_index = cookbook.index[workshop_name]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          # Choose the closest available workshop position to craft the item at\n          target_workshop_pos = get_closest_position(current_pos, workshop_positions)\n          \n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {cookbook.index.get_key(required_item_index)}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        # Choose the closest available workshop position to craft the item at\n        target_workshop_pos = get_closest_position(current_pos, workshop_positions)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:17:36.642290", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      directions = []\n      if abs(dy) > abs(dx):  # Prioritize vertical movement first\n          if dy > 0:\n              directions.extend([1] * abs(dy))  # UP\n          elif dy < 0:\n              directions.extend([0] * abs(dy))  # DOWN\n      \n          if dx > 0:\n              directions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              directions.extend([2] * abs(dx))  # LEFT\n      else:  # Prioritize horizontal movement first\n          if dx > 0:\n              directions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              directions.extend([2] * abs(dx))  # LEFT\n      \n          if dy > 0:\n              directions.extend([1] * abs(dy))  # UP\n          elif dy < 0:\n              directions.extend([0] * abs(dy))  # DOWN\n      return directions\n\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:17:37.700099", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(move_to(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:19:19.058482", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe.pop('_at')\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find the closest workshop position to craft the item at\n    target_workshop_pos = find_workshop(env, workshop_name)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T06:19:20.160777", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe.pop('_at')\n    \n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T06:21:57.934348", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    # Then move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n      current_dir = env._current_state.dir\n      target_dir = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n      # Determine the direction needed to face the workshop.\n      if target_dir == (0, 1):\n          return [3] if current_dir != 3 else []     # Face RIGHT\n      elif target_dir == (0, -1):\n          return [2] if current_dir != 2 else []     # Face LEFT\n      elif target_dir == (1, 0):\n          return [0] if current_dir != 0 else []     # Face DOWN\n      elif target_dir == (-1, 0):\n          return [1] if current_dir != 1 else []     # Face UP\n\n      return []\n\n  def collect_primitive(env, primitive):\n    cookbook = env.world.cookbook\n    \n    primitive_index = cookbook.index[primitive]\n    \n    while env._current_state.inventory.get(primitive_index, 0) < primitives_needed[primitive]:\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0: \n            closest_position = min(\n                positions, \n                key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n            \n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(tuple(closest_position)))\n            \n            # Align with the target position before collecting.\n            actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n            \n            # Collect the primitive using USE action\n            actions_to_take.append(4)\n        else:\n            raise ValueError(f\"Primitives {primitive} not found on the grid.\")\n\n  def find_closest_workshop(env, workshop_index):\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found.\")\n\n  def find_all_primitives(env):\n    cookbook = env.world.cookbook\n    all_positions = {}\n\n    for primitive in primitives_needed.keys():\n        primitive_index = cookbook.index[primitive]\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0:\n            all_positions[primitive] = positions.tolist()\n        else:\n            raise ValueError(f\"No {primitive} found in the environment.\")\n\n    return all_positions\n\n  def calculate_heuristic(path, target):\n      # Heuristic: Manhattan distance\n      x1, y1 = path[-1]\n      x2, y2 = target\n      return abs(x1 - x2) + abs(y1 - y2)\n\n  def a_star_search(start_pos, end_pos, grid):\n      open_set = []\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: calculate_heuristic([start_pos], end_pos)}\n      heapq.heappush(open_set, (f_score[start_pos], start_pos))\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if current == end_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + 1\n\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:\n                      continue\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + calculate_heuristic([neighbor], end_pos)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return None\n\n  cookbook = env.world.cookbook\n  actions_to_take = []\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    # Find all positions of primitives needed on the grid\n    primitive_positions = find_all_primitives(env)\n\n    # Gather required primitives first.\n    for primitive in primitives_needed:\n        available_positions = primitive_positions[primitive]\n        \n        while env._current_state.inventory.get(cookbook.index[primitive], 0) < primitives_needed[primitive]:\n            if not available_positions:\n                raise ValueError(f\"Not enough {primitive} found on the grid.\")\n\n            closest_position = min(\n                available_positions, \n                key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n            \n            path = a_star_search(env._current_state.pos, tuple(closest_position), env._current_state.grid[:, :, cookbook.index[primitive]])\n            if not path:\n                raise ValueError(f\"Cannot reach the closest {primitive}.\")\n            \n            actions_to_take.extend([get_move_actions(p) for p in path])\n            \n            # Align with the target position before collecting.\n            actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n            \n            # Collect the primitive using USE action\n            actions_to_take.append(4)\n\n            available_positions.remove(closest_position)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    closest_workshop_pos = find_closest_workshop(env, workshop_index)\n    \n    path = a_star_search(env._current_state.pos, tuple(closest_workshop_pos), env._current_state.grid[:, :, workshop_index])\n    if not path:\n        raise ValueError(\"Cannot reach the closest workshop.\")\n    \n    actions_to_take.extend([get_move_actions(p) for p in path])\n    \n    # Align with the workshop before using it.\n    actions_to_take.extend(align_with_workshop(tuple(closest_workshop_pos)))\n    \n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:21:59.003642", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    # Then move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n      current_dir = env._current_state.dir\n      target_dir = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n      # Determine the direction needed to face the workshop.\n      if target_dir == (0, 1):\n          return [3] if current_dir != 3 else []     # Face RIGHT\n      elif target_dir == (0, -1):\n          return [2] if current_dir != 2 else []     # Face LEFT\n      elif target_dir == (1, 0):\n          return [0] if current_dir != 0 else []     # Face DOWN\n      elif target_dir == (-1, 0):\n          return [1] if current_dir != 1 else []     # Face UP\n\n      return []\n\n  def collect_primitive(env, primitive):\n    cookbook = env.world.cookbook\n    \n    primitive_index = cookbook.index[primitive]\n    \n    while env._current_state.inventory.get(primitive_index, 0) < primitives_needed[primitive]:\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0: \n            closest_position = min(\n                positions, \n                key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n            \n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(tuple(closest_position)))\n            \n            # Align with the target position before collecting.\n            actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n            \n            # Collect the primitive using USE action\n            actions_to_take.append(4)\n        else:\n            raise ValueError(f\"Primitives {primitive} not found on the grid.\")\n\n  def find_closest_workshop(env, workshop_index):\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found.\")\n\n  def gather_primitives(env):\n    cookbook = env.world.cookbook\n    \n    for primitive in primitives_needed:\n        collect_primitive(env, primitive)\n\n  cookbook = env.world.cookbook\n  actions_to_take = []\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    global primitives_needed\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    # Gather required primitives first.\n    gather_primitives(env)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    closest_workshop_pos = find_closest_workshop(env, workshop_index)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(closest_workshop_pos))\n    \n    # Align with the workshop before using it.\n    actions_to_take.extend(align_with_workshop(tuple(closest_workshop_pos)))\n    \n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:22:51.095041", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      directions = []\n      \n      if dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n      \n      if dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n\n      return directions\n\n  actions = []\n  \n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:22:52.164435", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      directions = []\n      \n      if dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n\n      return directions\n\n  actions = []\n  \n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Calculate relative movement\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:25:06.483148", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def if_workshop_in_inventory(env, workshop_name) -> bool:\n    \"\"\"Check if the specified workshop is in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    return env._current_state.inventory[workshop_index] > 0\n\n  def check_and_move_to_workshop(env, workshop_name):\n    try:\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # USE action to interact with the workshop\n        return actions_to_take\n    except ValueError as e:\n        print(e)\n        return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    # Check if the required workshop is already in inventory\n    if not if_workshop_in_inventory(env, workshop_name):\n        actions_to_take.extend(check_and_move_to_workshop(env, workshop_name))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T06:25:07.546270", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def if_workshop_in_inventory(env, workshop_name) -> bool:\n    \"\"\"Check if the specified workshop is in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    return env._current_state.inventory[workshop_index] > 0\n\n  def handle_no_workshops_found(item):\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        handle_no_workshops_found(item)\n        return actions_to_take  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T06:26:01.368571", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:26:02.523125", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def navigate_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      while (current_x != x) or (current_y != y):\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Navigate to the workshop\n  actions.extend(navigate_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:27:01.993925", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction of movement and add corresponding actions\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n            \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:27:03.132486", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Determine the direction of movement and add corresponding actions\n    if rel_y != 0:\n      vertical_move = 1 if rel_y > 0 else 0\n      actions_to_take.extend([vertical_move] * abs(rel_y))  # Move DOWN or UP\n\n    if rel_x != 0:\n      horizontal_move = 3 if rel_x > 0 else 2\n      actions_to_take.extend([horizontal_move] * abs(rel_x))  # Move RIGHT or LEFT\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:28:51.315515", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n        \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def update_inventory(env, recipe):\n      cookbook = env.world.cookbook\n      item_index = cookbook.index[item]\n      \n      if item_index in cookbook.recipes:\n          # Fetch the recipe details for the item\n          recipe = cookbook.recipes[item_index].copy()\n\n          # Update inventory based on crafted item\n          env._current_state.inventory[item_index] += 1\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe.pop('_at')\n    \n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    actions_to_take.extend(craft_item(env, workshop_index))\n    \n    # Update inventory after crafting (this step is just for simulation; actual update will be handled by the environment)\n    update_inventory(env, recipe)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:28:52.404489", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe.pop('_at')\n    \n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T06:30:42.360797", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n            \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        # Choose the closest available primitive position to collect it from.\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 5.0}}
