():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - env._current_state.inventory[i] for i, amount in recipe.items() if i != '_at' and env._current_state.inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      \n      # If the primitive is a component or another item that needs crafting\n      if cookbook.index[primitive_name] in cookbook.recipes:\n        # Recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, cookbook.index[primitive_name]))\n        \n      primitive_index = cookbook.index[primitive_name]\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        path_to_primitive = find_path(env, tuple(closest_primitive))\n        actions_to_take.extend(get_move_actions_from_path(path_to_primitive))\n\n        # Assuming USE is used for collecting as well.\n        actions_to_take.append(4)\n\n        env._current_state.inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {cookbook.reverse_index[item_index]}.\")\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      actions_to_take.extend(move_towards_workshop(workshop_positions))\n      \n      # Update inventory to reflect crafting\n      update_inventory(env, item_index)\n      return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 6.0}}
{"timestamp": "2025-09-17T18:00:36.155816", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(current_x, current_y, target_x, target_y):\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n      visited = set()\n\n      while (current_x != target_x) or (current_y != target_y):\n          min_distance = float('inf')\n          best_direction = None\n\n          for dx, dy in directions:\n              new_x, new_y = current_x + dx, current_y + dy\n              if 0 <= new_x < env._current_state.grid.shape[0] and \\\n                 0 <= new_y < env._current_state.grid.shape[1] and \\\n                 (new_x, new_y) not in visited:\n                  distance = abs(new_x - target_x) + abs(new_y - target_y)\n                  if distance < min_distance:\n                      min_distance = distance\n                      best_direction = (dx, dy)\n\n          if best_direction is None:\n              # If we are stuck, try to move in any direction that has not been visited\n              for dx, dy in directions:\n                  new_x, new_y = current_x + dx, current_y + dy\n                  if 0 <= new_x < env._current_state.grid.shape[0] and \\\n                     0 <= new_y < env._current_state.grid.shape[1] and \\\n                     (new_x, new_y) not in visited:\n                      best_direction = (dx, dy)\n                      break\n\n          if best_direction is None:\n              # If still stuck, return False to indicate failure\n              return False, []\n\n          dx, dy = best_direction\n          actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n          current_x += dx\n          current_y += dy\n          visited.add((current_x, current_y))\n          actions.append(4)  # USE\n\n      return True, []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  success, additional_actions = move_towards(current_x, current_y, target_x, target_y)\n  if not success:\n      raise ValueError(\"Failed to navigate to the workshop.\")\n\n  actions.extend(additional_actions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.9}}
{"timestamp": "2025-09-17T18:05:36.229449", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move_towards(target_x, target_y):\n    nonlocal current_x, current_y\n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n    while (current_x != target_x) or (current_y != target_y):\n        min_distance = float('inf')\n        best_direction = None\n        for dx, dy in directions:\n            new_x, new_y = current_x + dx, current_y + dy\n            if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n                # Check if the cell is not an obstacle\n                if not any(env._current_state.grid[new_x, new_y, obs_idx] == 1 for obs_idx in env.world.workshop_indices):\n                    distance = abs(new_x - target_x) + abs(new_y - target_y)\n                    if distance < min_distance:\n                        min_distance = distance\n                        best_direction = (dx, dy)\n\n        if best_direction is not None:\n            dx, dy = best_direction\n            actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n            current_x += dx\n            current_y += dy\n        else:\n            break\n\n        # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n        actions.append(4)  # USE\n\n  move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:07:23.176276", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_index):\n      \"\"\"Finds and returns the closest workshop position in the grid.\"\"\"\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          return min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n      else:\n          raise ValueError(\"No workshops found in the grid.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find the closest workshop position to craft the item at\n    try:\n        closest_workshop_pos = find_closest_workshop(env, workshop_index)\n        target_workshop_pos = tuple(closest_workshop_pos)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    except ValueError as e:\n        print(e)  # Print error message if no workshops are found\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T18:07:24.321545", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_index):\n      \"\"\"Finds and returns the closest workshop position in the grid.\"\"\"\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          return min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n      else:\n          raise ValueError(\"No workshops found in the grid.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        closest_workshop_pos = find_closest_workshop(env, workshop_index)\n        target_workshop_pos = tuple(closest_workshop_pos)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    except ValueError as e:\n        print(e)  # Print error message if no workshops are found\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T18:08:52.432456", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def get_shortest_path(start, goal):\n      \"\"\"Find the shortest path from start to goal using BFS.\"\"\"\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n          \n          x, y = current\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env._current_state.grid.shape[0] and\\\n                 0 <= ny < env._current_state.grid.shape[1] and\\\n                 (nx, ny) not in visited and\\\n                 np.sum(env._current_state.grid[nx, ny]) == 0:  # Ensure we don't move into an occupied cell\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = current\n      \n      path = []\n      while goal:\n          path.append(goal)\n          goal = parent[goal]\n      \n      return list(reversed(path))\n\n  def actions_from_path(start, path):\n      \"\"\"Generate the list of actions from a given path.\"\"\"\n      directions = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}\n      actions = []\n      \n      for i in range(len(path) - 1):\n          current = path[i]\n          next_pos = path[i + 1]\n          dx, dy = next_pos[0] - current[0], next_pos[1] - current[1]\n          action = directions[(dx, dy)]\n          actions.append(action)\n          actions.append(4)  # USE\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the shortest path to the workshop\n  path = get_shortest_path((current_x, current_y), tuple(closest_workshop_pos))\n  \n  if not path:\n      raise ValueError(\"No valid path to the workshop.\")\n\n  # Generate actions from the path\n  actions.extend(actions_from_path((current_x, current_y), path))\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:08:53.510216", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(current_x, current_y, target_x, target_y):\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n      visited = set()\n\n      while (current_x != target_x) or (current_y != target_y):\n          min_distance = float('inf')\n          best_direction = None\n\n          for dx, dy in directions:\n              new_x, new_y = current_x + dx, current_y + dy\n              if 0 <= new_x < env._current_state.grid.shape[0] and\\\n                 0 <= new_y < env._current_state.grid.shape[1] and\\\n                 (new_x, new_y) not in visited:\n                  distance = abs(new_x - target_x) + abs(new_y - target_y)\n                  if distance < min_distance:\n                      min_distance = distance\n                      best_direction = (dx, dy)\n\n          if best_direction is None:\n              # If we are stuck, try to move in any direction that has not been visited\n              for dx, dy in directions:\n                  new_x, new_y = current_x + dx, current_y + dy\n                  if 0 <= new_x < env._current_state.grid.shape[0] and\\\n                     0 <= new_y < env._current_state.grid.shape[1] and\\\n                     (new_x, new_y) not in visited:\n                      best_direction = (dx, dy)\n                      break\n\n          if best_direction is None:\n              # If still stuck, return False to indicate failure\n              return False, []\n\n          dx, dy = best_direction\n          actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n          current_x += dx\n          current_y += dy\n          visited.add((current_x, current_y))\n          actions.append(4)  # USE\n\n      return True, []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  success, additional_actions = move_towards(current_x, current_y, target_x, target_y)\n  if not success:\n      raise ValueError(\"Failed to navigate to the workshop.\")\n\n  actions.extend(additional_actions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.9}}
{"timestamp": "2025-09-17T18:10:38.723935", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # Recursively ensure inventory for this craftable item.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def craft_item(env, item_index):\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n\n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    return craft_item(env, item_index)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 6.0}}
{"timestamp": "2025-09-17T18:10:39.814455", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # Recursively ensure inventory for this craftable item.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def craft_item(env, item_index):\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n\n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    return craft_item(env, item_index)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 6.0}}
{"timestamp": "2025-09-17T18:17:02.673585", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n    nonlocal current_x, current_y\n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n    while (current_x != target_x) or (current_y != target_y):\n        min_distance = float('inf')\n        best_direction = None\n        for dx, dy in directions:\n            new_x, new_y = current_x + dx, current_y + dy\n            if 0 <= new_x < env._current_state.grid.shape[0] and\\\n               0 <= new_y < env._current_state.grid.shape[1]:\n                distance = abs(new_x - target_x) + abs(new_y - target_y)\n                # Check if the position is not an obstacle or workshop\n                if distance < min_distance and env._current_state.grid[new_x, new_y, :].sum() == 0:\n                    min_distance = distance\n                    best_direction = (dx, dy)\n\n        if best_direction is not None:\n            dx, dy = best_direction\n            actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n            current_x += dx\n            current_y += dy\n        else:\n            break\n\n        # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n        actions.append(4)  # USE\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:17:03.829981", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n    nonlocal current_x, current_y\n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n    visited = set()\n\n    while (current_x != target_x) or (current_y != target_y):\n        min_distance = float('inf')\n        best_direction = None\n\n        for dx, dy in directions:\n            new_x, new_y = current_x + dx, current_y + dy\n            if 0 <= new_x < env._current_state.grid.shape[0] and\\\n               0 <= new_y < env._current_state.grid.shape[1] and\\\n               (new_x, new_y) not in visited:\n                distance = abs(new_x - target_x) + abs(new_y - target_y)\n                if distance < min_distance:\n                    min_distance = distance\n                    best_direction = (dx, dy)\n\n        if best_direction is None:\n            # If we are stuck, try to move in any direction that has not been visited\n            for dx, dy in directions:\n                new_x, new_y = current_x + dx, current_y + dy\n                if 0 <= new_x < env._current_state.grid.shape[0] and\\\n                   0 <= new_y < env._current_state.grid.shape[1] and\\\n                   (new_x, new_y) not in visited:\n                    best_direction = (dx, dy)\n                    break\n\n        if best_direction is None:\n            # If still stuck, return False to indicate failure\n            return False, []\n\n        dx, dy = best_direction\n        actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n        current_x += dx\n        current_y += dy\n        visited.add((current_x, current_y))\n        actions.append(4)  # USE\n\n    return True, []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  success, additional_actions = move_towards(target_x, target_y)\n  if not success:\n      raise ValueError(\"Failed to navigate to the workshop.\")\n\n  actions.extend(additional_actions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.9}}
{"timestamp": "2025-09-17T18:19:23.422868", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")  ", "island_id": 2, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T18:19:24.389486", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_env_state(env, actions):\n      \"\"\"Simulate the environment state after performing a series of actions.\"\"\"\n      for action in actions:\n          _, env._current_state = env.step(action)\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # Gather required items before crafting\n    gather_actions = gather_required_items(env, cookbook, recipe)\n    actions_to_take.extend(gather_actions)\n\n    # Update environment state after gathering items\n    update_env_state(env, gather_actions)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    move_actions = get_move_actions(target_workshop_pos)\n    actions_to_take.extend(move_actions)\n\n    # Update environment state after moving to the workshop\n    update_env_state(env, move_actions)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")  ", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:21:45.793474", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      while inventory[primitive_index] < required_amount:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n          if len(primitive_positions) > 0:\n              closest_primitive = find_closest_item_of_type(env._current_state.grid, primitive_index)\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n              actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n              inventory[primitive_index] += 1\n          else:\n              raise ValueError(f\"No primitives found for {item}.\")\n      \n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def recursive_craft(env, item_index):\n    actions_to_take = []\n    \n    # Ensure all ingredients are collected\n    actions_to_take.extend(ensure_inventory(env, item_index))\n    \n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n\n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n        \n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def find_closest_item_of_type(grid, item_index):\n    current_pos = env._current_state.pos\n    positions = np.argwhere(grid[:, :, item_index] == 1)\n\n    if len(positions) > 0:\n      closest_position = min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      return tuple(closest_position)\n    \n    return None\n\n  def find_closest_workshop_of_type(grid, workshop_index):\n    current_pos = env._current_state.pos\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n    if len(positions) > 0:\n      closest_workshop = min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      return tuple(closest_workshop)\n    \n    return None\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = recursive_craft(env, item_index)\n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:21:46.857371", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def recursive_craft(env, item_index):\n    actions_to_take = []\n    \n    # Ensure all ingredients are collected\n    actions_to_take.extend(ensure_inventory(env, item_index))\n    \n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n\n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n        \n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def find_closest_item_of_type(grid, item_index):\n    current_pos = env._current_state.pos\n    positions = np.argwhere(grid[:, :, item_index] == 1)\n\n    if len(positions) > 0:\n      closest_position = min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      return tuple(closest_position)\n    \n    return None\n\n  def find_closest_workshop_of_type(grid, workshop_index):\n    current_pos = env._current_state.pos\n    positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n    if len(positions) > 0:\n      closest_workshop = min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      return tuple(closest_workshop)\n    \n    return None\n\n  def ensure_all_primitives(env):\n    actions_to_take = []\n    cookbook = env.world.cookbook\n    primitives_required = set(cookbook.primitives)\n\n    while primitives_required:\n      primitive_name = primitives_required.pop()\n      primitive_index = cookbook.index[primitive_name]\n      \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n      else:\n        raise ValueError(f\"No primitives found for {primitive_name}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_all_primitives(env)\n    actions_to_take.extend(recursive_craft(env, item_index))\n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 8, "scores": {"3": 6.0}}
{"timestamp": "2025-09-17T18:24:17.312504", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect_optimized(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect_optimized(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item with optimized path.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid and sort by distance\n      paths_to_primitive = find_all_paths_to_item(env, primitive_index)\n\n      if len(paths_to_primitive) > 0:\n          actions_to_take = []\n          for target_pos, _ in paths_to_primitive:\n              actions_to_take.extend(get_move_actions(tuple(target_pos)))\n              # Use the USE action to collect the item\n              actions_to_take.append(4)\n              \n              # Update inventory after collecting\n              env._current_state.inventory[primitive_index] += 1\n\n              # Check if we have collected enough of the primitive\n              cookbook = env.world.cookbook\n              required_item_index = cookbook.index[primitive]\n              current_amount = env._current_state.inventory[required_item_index]\n              if current_amount >= recipe.get(required_item_index, 0):\n                  break\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def find_all_paths_to_item(env, item_index):\n      grid = env._current_state.grid[:, :, item_index]\n      positions = np.argwhere(grid == 1)\n      current_pos = env._current_state.pos\n      paths = []\n      for pos in positions:\n          path_length = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          paths.append((pos, path_length))\n      return sorted(paths, key=lambda x: x[1])\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting (optimized path)\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")  ", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:24:18.295690", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect_optimized(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect_optimized(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item with optimized path.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid and sort by distance\n      paths_to_primitive = find_all_paths_to_item(env, primitive_index)\n\n      if len(paths_to_primitive) > 0:\n          actions_to_take = []\n          for target_pos, _ in paths_to_primitive:\n              actions_to_take.extend(get_move_actions(tuple(target_pos)))\n              # Use the USE action to collect the item\n              actions_to_take.append(4)\n              \n              # Update inventory after collecting\n              env._current_state.inventory[primitive_index] += 1\n\n              # Check if we have collected enough of the primitive\n              cookbook = env.world.cookbook\n              required_item_index = cookbook.index[primitive]\n              current_amount = env._current_state.inventory[required_item_index]\n              if current_amount >= recipe.get(required_item_index, 0):\n                  break\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_all_paths_to_item(env, item_index):\n      grid = env._current_state.grid[:, :, item_index]\n      positions = np.argwhere(grid == 1)\n      current_pos = env._current_state.pos\n      paths = []\n      for pos in positions:\n          path_length = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          paths.append((pos, path_length))\n      return sorted(paths, key=lambda x: x[1])\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              # Check if on top of a primitive or at a workshop\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting (optimized path)\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")  ", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:26:12.207866", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def move_and_use(env, target_positions):\n      current_pos = env._current_state.pos\n      rel_x, rel_y = target_positions[0][0] - current_pos[0], target_positions[0][1] - current_pos[1]\n      \n      actions_to_take = []\n      \n      # Determine direction based on relative position and move accordingly\n      if rel_x > 0:\n          actions_to_take.extend([3] * rel_x)  # Move RIGHT\n      elif rel_x < 0:\n          actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n          \n      if rel_y > 0:\n          actions_to_take.extend([1] * rel_y)  # Move DOWN\n      elif rel_y < 0:\n          actions_to_take.extend([0] * abs(rel_y))  # Move UP\n      \n      # Use the USE action at the target position\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_and_use(env, workshop_positions))\n        \n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T18:26:13.343522", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def move_and_use(env, target_positions):\n      current_pos = env._current_state.pos\n      rel_x, rel_y = target_positions[0][0] - current_pos[0], target_positions[0][1] - current_pos[1]\n      \n      actions_to_take = []\n      \n      # Determine direction based on relative position and move accordingly\n      if rel_x > 0:\n          actions_to_take.extend([3] * rel_x)  # Move RIGHT\n      elif rel_x < 0:\n          actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n          \n      if rel_y > 0:\n          actions_to_take.extend([1] * rel_y)  # Move DOWN\n      elif rel_y < 0:\n          actions_to_take.extend([0] * abs(rel_y))  # Move UP\n      \n      # Use the USE action at the target position\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def get_available_workshops(env):\n    cookbook = env.world.cookbook\n    workshops = {workshop: np.argwhere(env._current_state.grid[:, :, index] == 1) \n                 for workshop, index in cookbook.index.items() if 'workshop' in workshop}\n    \n    return workshops\n  \n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_and_use(env, workshop_positions))\n        \n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T18:28:49.849097", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect_optimized(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect_optimized(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item with optimized path.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid and sort by distance\n      paths_to_primitive = find_all_paths_to_item(env, primitive_index)\n\n      if len(paths_to_primitive) > 0:\n          actions_to_take = []\n          for target_pos, _ in paths_to_primitive:\n              actions_to_take.extend(get_move_actions(tuple(target_pos)))\n              # Use the USE action to collect the item\n              actions_to_take.append(4)\n              \n              # Update inventory after collecting\n              env._current_state.inventory[primitive_index] += 1\n\n              # Check if we have collected enough of the primitive\n              cookbook = env.world.cookbook\n              required_item_index = cookbook.index[primitive]\n              current_amount = env._current_state.inventory[required_item_index]\n              if current_amount >= recipe.get(required_item_index, 0):\n                  break\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_all_paths_to_item(env, item_index):\n      grid = env._current_state.grid[:, :, item_index]\n      positions = np.argwhere(grid == 1)\n      current_pos = env._current_state.pos\n      paths = []\n      for pos in positions:\n          path_length = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          paths.append((pos, path_length))\n      return sorted(paths, key=lambda x: x[1])\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              # Check if on top of a primitive or at a workshop\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting (optimized path)\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": -1}}
