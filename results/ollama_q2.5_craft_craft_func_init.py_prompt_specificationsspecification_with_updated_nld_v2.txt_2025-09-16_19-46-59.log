_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def craft_item(env, workshop_index):\n      target_workshop_pos = get_closest_workshop(env, workshop_index)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  def collect_and_craft_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    \n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    actions_to_take = []\n    \n    # Collect and craft primitives required for crafting if not already in inventory\n    actions_to_take.extend(collect_and_craft_primitives(env, recipe))\n    \n    try:\n        # Craft the item using the closest available workshop\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-18T02:35:47.609853", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def get_closest_target(env, target_index):\n    current_pos = env._current_state.pos\n    target_positions = np.argwhere(env._current_state.grid[:, :, target_index] == 1)\n\n    if len(target_positions) > 0:\n        closest_target = min(\n            target_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_target)\n    else:\n        raise ValueError(\"No targets found in the environment.\")\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    actions_to_take = []\n    \n    # Collect primitives required for crafting if not already in inventory\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    for primitive_index, count in primitives_needed.items():\n        while env._current_state.inventory[primitive_index] < count:\n            try:\n                target_primitive_pos = get_closest_target(env, primitive_index)\n                \n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n                \n                # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                env._current_state.inventory[primitive_index] += 1\n                \n            except ValueError as e:\n                print(e)  # Log or handle the error appropriately\n                raise\n\n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n      target_workshop_pos = get_closest_target(env, workshop_index)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  def collect_and_craft_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    \n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n        while env._current_state.inventory[primitive_index] < count:\n            try:\n                target_primitive_pos = get_closest_target(env, primitive_index)\n                \n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n                \n                # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                env._current_state.inventory[primitive_index] += 1\n                \n            except ValueError as e:\n                print(e)  # Log or handle the error appropriately\n                raise\n\n    return actions_to_take\n  \n  def handle_missing_workshop(env, recipe):\n      cookbook = env.world.cookbook\n      \n      # Find a workshop that can craft one of the required primitives\n      for primitive_index in recipe.keys():\n          if primitive_index not in cookbook.recipes:\n              continue\n\n          # Check all recipes to find which workshops can craft this primitive\n          workshops = []\n          for item, details in cookbook.recipes.items():\n              if '_at' in details and primitive_index in details:\n                  workshop_name = details['_at']\n                  workshop_index = cookbook.index[workshop_name]\n                  workshops.append(workshop_index)\n          \n          if workshops:\n              # Choose the closest workshop\n              closest_workshop = min(\n                  workshops, \n                  key=lambda w: abs(env._current_state.pos[0] - get_closest_target(env, w)[0]) + abs(env._current_state.pos[1] - get_closest_target(env, w)[1])\n              )\n              \n              # Collect the primitive from this workshop\n              actions_to_take = collect_and_craft_primitives(env, {primitive_index: 1})\n              return actions_to_take\n\n      raise ValueError(\"No available workshops to craft the required primitives.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    actions_to_take = []\n    \n    try:\n        # Collect and craft primitives required for crafting if not already in inventory\n        actions_to_take.extend(collect_and_craft_primitives(env, recipe))\n        \n        # Craft the item using the closest available workshop\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        \n        try:\n            # If no primitives are found, attempt to craft them from workshops\n            actions_to_take.extend(handle_missing_workshop(env, recipe))\n            \n            # Craft the item using the closest available workshop after collecting primitives\n            actions_to_take.extend(craft_item(env, workshop_index))\n\n        except ValueError as e2:\n            print(e2)  # Log or handle the error appropriately\n            raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-18T02:38:07.193277", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def craft_at_workshop(env, workshop_index):\n    target_workshop_pos = find_closest_workshop(env, cookbook.reverse_index[workshop_index])\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  def update_inventory_from_grid(env):\n    cookbook = env.world.cookbook\n    current_state = env._current_state\n    \n    for primitive_name, index in cookbook.index.items():\n        count_in_grid = np.sum(current_state.grid[:, :, index])\n        if count_in_grid > 0:\n            current_state.inventory[index] += count_in_grid\n\n  def collect_primitives_from_all_positions(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      while len(primitive_positions) > 0 and env._current_state.inventory[primitive_index] < count:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n        # Re-evaluate positions after collecting one item to ensure we get all required items\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item in cookbook.index:\n      item_index = cookbook.index[item]\n      \n      # Check if there is a recipe available for this item\n      if item_index in cookbook.recipes:\n          # Fetch the recipe details for the item\n          recipe = cookbook.recipes[item_index].copy()\n\n          # Remove the '_at' key which indicates the workshop\n          workshop_name = recipe.pop('_at')\n          \n          # Collect primitives required for crafting from all available positions\n          actions_to_take = collect_primitives_from_all_positions(env, recipe)\n\n          # Craft item at the closest workshop\n          actions_to_take.extend(craft_at_workshop(env, cookbook.index[workshop_name]))\n\n      else:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n  else:\n    raise ValueError(f\"Item '{item}' not found in cookbook.\")\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
