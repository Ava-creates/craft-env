{"timestamp": "2025-09-17T10:17:23.117991", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions_to_take = []\n\n    # Move RIGHT or LEFT to align with the x-axis of the target position\n    if rel_x > 0:\n      actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n      actions_to_take.extend([2] * abs(rel_x))\n    \n    # Move DOWN or UP to reach the y-axis of the target position\n    if rel_y > 0:\n      actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n      actions_to_take.extend([0] * abs(rel_y))\n      \n    return actions_to_take\n\n  def rotate_and_move(target_direction):\n    current_direction = env._current_state.dir\n    # Mapping of direction names to indices\n    direction_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n    \n    target_index = direction_map[target_direction]\n    relative_direction = (target_index - current_direction) % 4\n    \n    if relative_direction == 1:\n      actions_to_take.append(5)  # RIGHT_TURN\n    elif relative_direction == 2:\n      actions_to_take.extend([5, 5])  # TWO_RIGHT_TURNS or HALF_TURN\n    elif relative_direction == 3:\n      actions_to_take.append(6)  # LEFT_TURN\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n\n      target_workshop_pos = tuple(closest_workshop)\n\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Assuming we need to face the workshop after reaching it, adjust direction if necessary\n      # Calculate the required facing direction based on the relative position of the workshop\n      rel_x, rel_y = target_workshop_pos[0] - current_pos[0], target_workshop_pos[1] - current_pos[1]\n      \n      if rel_x > 0:\n          required_direction = 'RIGHT'\n      elif rel_x < 0:\n          required_direction = 'LEFT'\n      elif rel_y > 0:\n          required_direction = 'UP'\n      elif rel_y < 0:\n          required_direction = 'DOWN'\n          \n      actions_to_take.extend(rotate_and_move(required_direction))\n      \n      actions_to_take.append(4)  # Craft the item at the workshop\n\n      return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T10:17:24.234069", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions_to_take = []\n\n    # Calculate the shortest path to avoid obstacles\n    grid = env._current_state.grid\n    height, width, _ = grid.shape\n\n    def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {start: None}\n\n      while queue:\n        current = queue.popleft()\n        if current == goal:\n          path = []\n          while current is not None:\n              path.append(current)\n              current = parent_map[current]\n          return path[::-1]\n\n        neighbors = [\n            (current[0] + 1, current[1]), \n            (current[0] - 1, current[1]),\n            (current[0], current[1] + 1), \n            (current[0], current[1] - 1)\n        ]\n\n        for neighbor in neighbors:\n          if (0 <= neighbor[0] < height and\n              0 <= neighbor[1] < width and\n              grid[neighbor[0], neighbor[1]].sum() == 0 and # Ensure the cell is free from obstacles\n              neighbor not in visited):\n            queue.append(neighbor)\n            visited.add(neighbor)\n            parent_map[neighbor] = current\n\n      return None\n\n    path = bfs(current_pos, target_pos)\n\n    if path:\n        for step in path[1:]:  # Skip the starting position\n          rel_x = step[0] - current_pos[0]\n          rel_y = step[1] - current_pos[1]\n\n          if rel_x > 0:\n              actions_to_take.append(3)\n          elif rel_x < 0:\n              actions_to_take.append(2)\n\n          if rel_y > 0:\n              actions_to_take.append(1)\n          elif rel_y < 0:\n              actions_to_take.append(0)\n\n          current_pos = step\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n\n      target_workshop_pos = tuple(closest_workshop)\n\n      actions_to_take = get_move_actions(target_workshop_pos)\n      actions_to_take.append(4)  # Craft the item at the workshop\n\n      return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-17T10:19:15.200331", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        if primitive_index in cookbook.recipes:\n          actions_to_take.extend(craft_v2(env, cookbook.index.inverse[primitive_index]))\n          continue\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Assuming USE is used for crafting as well.\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    actions_to_take.extend(craft_item(env, item_index))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {}}
{"timestamp": "2025-09-17T10:19:16.279074", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Check if the item can be crafted (i.e., it's not a primitive)\n      if primitive_index in cookbook.recipes:\n        actions_to_take.extend(craft_item(env, primitive_index))\n      else:\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the COLLECT action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      \n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the nearest workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")  ", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T10:21:06.032693", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item(env, workshop_index):\n    nonlocal actions_to_take\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T10:21:07.098928", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    nonlocal actions_to_take\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T10:22:18.760062", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move horizontally and vertically to reach the target position.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n    \n    return actions_to_take\n\n  def move_and_use(actions):\n      for action in actions:\n          if env._current_state.pos == target_workshop_pos and action == 4:\n              break\n          reward, done, observations = env.step(action)\n          total_reward += reward\n          if done:\n              raise ValueError(f\"Unexpected termination while moving to the workshop.\")\n          \n  def check_inventory(item_index):\n      return env._current_state.inventory[item_index] > 0\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find positions of the specified workshop on the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Check if all required items are in inventory\n        for ingredient_index, quantity in recipe.items():\n          if ingredient_index != '_at' and not check_inventory(ingredient_index):\n              raise ValueError(f\"Missing ingredient {cookbook.index[ingredient_index]} to craft {item}.\")\n        \n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Craft the item at the workshop\n\n        return actions_to_take\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T10:22:19.733056", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move horizontally and vertically to reach the target position.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n    \n    return actions_to_take\n\n  def has_item(item_index):\n      return env._current_state.next_observation['inventory'][item_index] > 0\n  \n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find positions of the specified workshop on the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Check if all required items are in the inventory\n        for ingredient_index in recipe:\n            if ingredient_index == '_at':\n                continue\n            if not has_item(ingredient_index):\n                raise ValueError(f\"Missing required item {cookbook.index[ingredient_index]} for crafting {item}.\")\n        \n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Craft the item at the workshop\n\n        return actions_to_take\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T10:24:11.383835", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n            \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        # Choose the closest available primitive position to collect it from.\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        # If primitives are not directly available, try to craft them from their recipes.\n        if primitive_name in cookbook.recipes:\n          actions_to_take.extend(craft_v2(env, primitive_name))\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 4, "scores": {}}
