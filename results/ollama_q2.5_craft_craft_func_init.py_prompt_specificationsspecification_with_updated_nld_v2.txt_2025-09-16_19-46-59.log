rimitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the COLLECT action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n      # Update inventory and missing items count.\n      inventory[primitive_index] += required_amount\n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {}}
{"timestamp": "2025-09-17T08:35:43.799633", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_missing_primitives():\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    item_index = cookbook.index[item]\n    recipe = cookbook.recipes[item_index]\n\n    missing_primitives = []\n    for key, value in recipe.items():\n        if key != '_at':\n            required_count = value\n            current_count = inventory[cookbook.index[key]]\n            if current_count < required_count:\n                missing_primitives.append((key, required_count - current_count))\n    return missing_primitives\n\n  actions_to_take = []\n\n  # Check for missing primitives and collect them first\n  missing_primitives = get_missing_primitives()\n  for primitive, count in missing_primitives:\n      for _ in range(count):\n          # Collect the primitive\n          actions_to_take.extend(collect(env, primitive))\n\n  # Craft the item after collecting all required primitives\n  actions_to_take.extend(craft_v1(env, item))\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:35:44.858126", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T08:36:49.441198", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def find_path(current_pos, target_pos):\n    from collections import deque\n      \n    queue = deque([current_pos])\n    visited = set()\n    parent = {current_pos: None}\n\n    while queue:\n        x, y = queue.popleft()\n\n        if (x, y) == target_pos:\n            break\n\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n\n            if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0: # Check if the cell is empty\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n\n    path = []\n    step = target_pos\n    while step:\n        path.append(step)\n        step = parent[step]\n    \n    return path[::-1]\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the path to the workshop\n  path = find_path((current_x, current_y), closest_workshop_pos)\n\n  for x, y in path:\n      dx = x - current_x\n      dy = y - current_y\n\n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = x, y\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:36:50.545272", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T08:38:55.584725", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in world.workshop_primitives:\n        # If it's a primitive that can be crafted in a workshop, find the nearest workshop for crafting.\n        workshops_for_primitive = world.workshops_per_primitive.get(primitive_name, [])\n        closest_workshop_pos = None\n        current_pos = env._current_state.pos\n\n        for workshop_pos in workshops_for_primitive:\n          if closest_workshop_pos is None or (\n              abs(workshop_pos[0] - current_pos[0]) + abs(workshop_pos[1] - current_pos[1]) <\n              abs(closest_workshop_pos[0] - current_pos[0]) + abs(closest_workshop_pos[1] - current_pos[1])\n          ):\n            closest_workshop_pos = workshop_pos\n\n        if closest_workshop_pos is not None:\n          # Calculate move actions to reach the closest workshop.\n          actions_to_take.extend(get_move_actions(closest_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop.\n          actions_to_take.append(4)\n\n      else:\n        # Otherwise, find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      \n      # Update inventory and missing items count.\n      inventory[primitive_index] += required_amount\n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:43:55.912890", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n            \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def get_next_step(current_pos, target_pos):\n    \"\"\"Get the next step to move towards the target position.\"\"\"\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    # Prioritize vertical movement\n    if rel_y > 0:\n        return (current_pos[0], current_pos[1] + 1), 1  # Move DOWN\n    elif rel_y < 0:\n        return (current_pos[0], current_pos[1] - 1), 0  # Move UP\n    \n    # Then prioritize horizontal movement\n    if rel_x > 0:\n        return (current_pos[0] + 1, current_pos[1]), 3  # Move RIGHT\n    elif rel_x < 0:\n        return (current_pos[0] - 1, current_pos[1]), 2  # Move LEFT\n    \n    return current_pos, None\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        while current_pos != target_primitive_pos:\n          next_pos, action = get_next_step(current_pos, target_primitive_pos)\n          actions_to_take.append(action)\n          current_pos = next_pos\n\n        # Use the USE action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        while current_pos != target_workshop_pos:\n          next_pos, action = get_next_step(current_pos, target_workshop_pos)\n          actions_to_take.append(action)\n          current_pos = next_pos\n\n        actions_to_take.append(4)  # Use the USE action to craft the item.\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:45:13.151526", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move first (horizontally or vertically)\n    if abs(rel_x) >= abs(rel_y):\n        # Move horizontally first\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        else:\n            actions_to_take.extend([2] * -rel_x)  # LEFT\n        \n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        else:\n            actions_to_take.extend([0] * -rel_y)  # UP\n    else:\n        # Move vertically first\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        else:\n            actions_to_take.extend([0] * -rel_y)  # UP\n        \n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        else:\n            actions_to_take.extend([2] * -rel_x)  # LEFT\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)  # USE\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T08:45:14.223242", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n    \n    # Calculate the necessary movements in each direction\n    rel_x = target_pos[0] - current_pos[0]\n    rel_y = target_pos[1] - current_pos[1]\n    \n    # Move horizontally first, then vertically\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T08:52:04.286748", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_primitives(env, cookbook, primitives):\n      \"\"\"Gather the required primitives for crafting.\"\"\"\n      collected = False\n      actions_to_take = []\n      \n      while not all(item in env._current_state.inventory for item in primitives):\n          # Find the closest primitive that is not yet collected\n          primitive = next(primitive for primitive in primitives if primitive not in env._current_state.inventory)\n          primitive_index = cookbook.index[primitive]\n          \n          # Find all positions of the specified primitive in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n          if len(primitive_positions) > 0:\n              current_pos = env._current_state.pos\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n          else:\n              raise ValueError(f\"No primitives found for {primitive}.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract required primitives and workshop from the recipe\n    required_primitives = [ingredient for ingredient in recipe.keys() if not isinstance(ingredient, str)]\n    workshop_name = recipe['_at']\n\n    # Gather the required primitives first\n    actions_to_take = gather_primitives(env, cookbook, required_primitives)\n\n    # Find all positions of the specified workshop in the grid\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:52:05.255885", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Prioritize moving vertically if possible to avoid obstacles\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n        \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    return actions_to_take\n\n  def has_required_primitives(env, recipe):\n      cookbook = env.world.cookbook\n      inventory = env._current_state.inventory\n\n      for primitive_name, required_amount in recipe.items():\n          if primitive_name == '_at':\n              continue  # Skip the workshop name\n          \n          primitive_index = cookbook.index[primitive_name]\n          if inventory[primitive_index] < required_amount:\n              return False\n      \n      return True\n\n  def collect_primitive(env, primitive):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired primitive\n    primitive_index = cookbook.index[primitive]\n\n    # Find all positions of the specified primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_positions) > 0:\n        # Choose the closest available primitive position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take = get_move_actions(target_primitive_pos)\n\n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No {primitive} found in the grid.\")\n\n  def craft_item(env, item):\n      cookbook = env.world.cookbook\n      world = env.world\n      \n      # Get the index for the desired item to be crafted\n      item_index = cookbook.index[item]\n      \n      # Check if there is a recipe available for this item\n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n\n          # Extract the workshop from the recipe\n          workshop_name = recipe['_at']\n          workshop_index = cookbook.index[workshop_name]\n\n          # Find all positions of the specified workshop in the grid\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n          if len(workshop_positions) > 0:\n              closest_workshop = min(\n                  workshop_positions, \n                  key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              )\n              \n              target_workshop_pos = tuple(closest_workshop)\n\n              # Calculate move actions to reach the closest workshop\n              actions_to_take = get_move_actions(target_workshop_pos)\n\n              # Use the USE action to craft the item at the workshop\n              actions_to_take.append(4)\n\n              return actions_to_take\n\n          else:\n              raise ValueError(f\"No workshops found for crafting {item}.\")\n      else:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  def get_all_primitive_collection_actions(env, recipe):\n    actions_to_take = []\n    for primitive_name, required_amount in recipe.items():\n        if primitive_name == '_at':\n            continue  # Skip the workshop name\n        \n        while env._current_state.inventory[env.world.cookbook.index[primitive_name]] < required_amount:\n            actions_to_take.extend(collect_primitive(env, primitive_name))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # First, collect all required primitives\n    actions_to_take.extend(get_all_primitive_collection_actions(env, recipe))\n\n    # Then, craft the item at the workshop\n    actions_to_take.extend(craft_item(env, item))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:54:11.964684", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n\n      # Attempt to find positions of the specified primitive.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        # If primitives are not directly available, attempt to craft them.\n        if primitive_index in cookbook.recipes:\n          actions_to_take.extend(craft_item(env, primitive_index))\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Craft the item.\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory, potentially by crafting them.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T08:54:13.022168", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def resolve_dependencies(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the item is not a primitive, try to craft it.\n      if primitive_name in cookbook.recipes:\n        actions_to_take.extend(resolve_dependencies(env, primitive_index))\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Resolve all dependencies (crafting non-primitive items).\n    actions_to_take = resolve_dependencies(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 5.0}}
{"timestamp": "2025-09-17T08:56:08.572548", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    world = env.world\n\n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        # Choose the closest available primitive position to collect it from.\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        # If no primitives are found, attempt to craft the primitive if possible.\n        if primitive_name in cookbook.recipes:\n          actions_to_take.extend(craft_item(env, primitive_index))\n        else:\n          raise ValueError(f\"No primitives or recipes found for {primitive_name}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T08:56:09.559871", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    actions_to_take = []\n\n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If it's a primitive, just collect it.\n      if primitive_index in cookbook.primitives:\n        actions_to_take.extend(collect_primitive(env, primitive_index))\n      else:\n        # Otherwise, craft the item recursively.\n        actions_to_take.extend(craft_v2(env, cookbook.index.get_by_value(primitive_index)))\n      \n      # Update inventory and missing items count.\n      inventory[primitive_index] += required_amount\n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    world = env.world\n    grid = env._current_state.grid\n    \n    # Find all positions of the specified primitive in the grid.\n    primitive_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n    if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take = get_move_actions(target_primitive_pos)\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n        return actions_to_take\n    else:\n      raise ValueError(f\"No primitives found for index {primitive_index}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T08:57:09.413697", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n      # Use USE action only when the agent has reached its target position\n      if (current_x == target_x) and (current_y == target_y):\n          actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T08:57:10.551329", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(current_x, current_y, target_x, target_y):\n      actions = []\n      path = collections.deque()\n\n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              path.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              path.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              path.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              path.append(0)  # DOWN\n              current_y -= 1\n\n      return actions, path\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions_to_reach_workshop, path = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(actions_to_reach_workshop)\n\n  while path:\n      action = path.popleft()\n      actions.append(action)\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.8999996}}
