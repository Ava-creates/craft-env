tive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe.keys():\n      if primitive_index not in env._current_state.inventory:\n        env._current_state.inventory[primitive_index] = 0\n\n  def collect_primitives_v2(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k in cookbook.index and (k not in env._current_state.inventory or env._current_state.inventory[k] < v)}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Ensure all primitives are in inventory with count 0 if not present\n    update_inventory(env, recipe)\n\n    actions_to_take = []\n\n    while not all(env._current_state.inventory[k] >= v for k, v in recipe.items()):\n      actions_to_take.extend(collect_primitives_v2(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T14:50:21.084400", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move in the x direction first to avoid obstacles in y direction\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, item_index):\n      \"\"\"Gather all required items for crafting the specified item.\"\"\"\n      actions = []\n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n          \n          # Gather each ingredient required by the recipe\n          for ingredient_index, required_count in recipe.items():\n              if ingredient_index != '_at':\n                  current_count = env._current_state.inventory[ingredient_index]\n                  missing_count = required_count - current_count\n                  \n                  if missing_count > 0:\n                      primitives_needed = get_primitives_for_item(cookbook, ingredient_index)\n                      \n                      # Collect each primitive needed for the ingredient\n                      for primitive in primitives_needed:\n                          actions.extend(collect(env, primitive))\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def check_inventory(env, required_items):\n    \"\"\"Check if the required items are available in inventory.\"\"\"\n    cookbook = env.world.cookbook\n    \n    for item_index in required_items:\n        required_count = recipe.get(item_index, 0)\n        current_count = env._current_state.inventory[item_index]\n        \n        if current_count < required_count:\n            return False\n    return True\n\n  def craft_at_workshop(env, workshop_name):\n      \"\"\"Returns a list of actions to move to and use the specified workshop.\"\"\"\n      cookbook = env.world.cookbook\n      \n      # Get the index for the desired workshop\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available position to use the workshop at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_workshop_pos)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract required items from the recipe\n    required_items = {ingredient_index: recipe[ingredient_index] for ingredient_index in recipe.keys() if ingredient_index != '_at'}\n\n    # Check if all required items are available in inventory\n    if not check_inventory(env, required_items):\n        actions_to_take = gather_required_items(env, cookbook, item_index)\n    else:\n        actions_to_take = []\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    # Craft at the specified workshop\n    craft_actions = craft_at_workshop(env, workshop_name)\n    actions_to_take.extend(craft_actions)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 9, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T14:55:21.154341", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move in the x direction first to avoid obstacles in y direction\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_count = recipe[required_item_index]\n              current_count = env._current_state.inventory[required_item_index]\n              \n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  while env._current_state.inventory[primitive] < required_count:\n                      actions.extend(collect(env, primitive))\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def check_inventory(env, required_items):\n    \"\"\"Check if the required items are available in inventory.\"\"\"\n    cookbook = env.world.cookbook\n    \n    for item_index in required_items:\n        required_count = recipe.get(item_index, 0)\n        current_count = env._current_state.inventory[item_index]\n        \n        if current_count < required_count:\n            return False\n    return True\n\n  def craft_item_at_workshop(env, workshop_name, required_items):\n      cookbook = env.world.cookbook\n      \n      # Extract the workshop from the recipe\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available workshop position to craft the item at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract required items from the recipe\n    required_items = {ingredient_index: recipe[ingredient_index] for ingredient_index in recipe.keys() if ingredient_index != '_at'}\n\n    # Extract the workshop name from the recipe\n    workshop_name = recipe['_at']\n\n    actions_to_take = []\n\n    # Gather required items before crafting\n    gather_actions = gather_required_items(env, cookbook, recipe)\n    actions_to_take.extend(gather_actions)\n\n    # Check inventory and craft if all required items are available\n    craft_actions = craft_item_at_workshop(env, workshop_name, required_items)\n    actions_to_take.extend(craft_actions)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T14:56:25.610860", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_target(current_x, current_y, target_x, target_y):\n      actions = []\n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n      return actions, current_x, current_y\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop\n  move_actions, current_x, current_y = move_to_target(current_x, current_y, target_x, target_y)\n  actions.extend(move_actions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T14:56:26.690956", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if abs(dx) > abs(dy):\n          move_action = 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:\n          move_action = 1 if dy > 0 else 0  # UP or DOWN\n\n      actions.append(move_action)\n      \n      # Update the agent's position after each move\n      if current_x < target_x:\n          current_x += 1\n      elif current_x > target_x:\n          current_x -= 1\n\n      if current_y < target_y:\n          current_y += 1\n      elif current_y > target_y:\n          current_y -= 1\n      \n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 0.90000004}}
{"timestamp": "2025-09-17T14:58:22.471411", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item(env, workshop_name):\n    nonlocal actions_to_take\n    \n    # Find the index of the desired workshop\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n\n    if target_workshop_pos:\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n  def update_inventory_with_crafting(env, recipe):\n    cookbook = env.world.cookbook\n    \n    # Simulate adding the crafted item to the inventory\n    for primitive_index in recipe:\n      if primitive_index not in env._current_state.inventory:\n          env._current_state.inventory[primitive_index] = 0\n      \n      env._current_state.inventory[primitive_index] += 1\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_name)\n\n    # Simulate adding the crafted item to the inventory\n    update_inventory_with_crafting(env, {item_index: 1})\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 6.4999995}}
{"timestamp": "2025-09-17T14:58:23.553757", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n        \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item(env, workshop_name):\n    nonlocal actions_to_take\n    \n    # Find the index of the desired workshop\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n\n    if target_workshop_pos:\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_name)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T15:00:36.761094", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T15:00:37.836560", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def move_to_closest_position(positions, current_pos):\n      \"\"\"Find the closest position from a list of positions.\"\"\"\n      return min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T15:02:48.820915", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_count = recipe[required_item_index]\n              current_count = env._current_state.inventory[required_item_index]\n              missing_count = required_count - current_count\n              \n              while missing_count > 0:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                      \n                  # Update the inventory count after collection\n                  current_count += env._current_state.inventory[required_item_index]\n                  missing_count -= (required_count - current_count)\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 9, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T15:02:49.922257", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    # Then move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def check_inventory(env, required_items):\n    \"\"\"Check if all required items are available in inventory.\"\"\"\n    cookbook = env.world.cookbook\n    \n    for item_index, required_count in required_items.items():\n        current_count = env._current_state.inventory[item_index]\n        \n        if current_count < required_count:\n            return False\n    return True\n\n  def craft_at_workshop(env, workshop_name):\n      \"\"\"Returns a list of actions to move to and use the specified workshop.\"\"\"\n      cookbook = env.world.cookbook\n      \n      # Get the index for the desired workshop\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available position to use the workshop at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_workshop_pos)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract required items from the recipe\n    required_items = {ingredient_index: recipe[ingredient_index] for ingredient_index in recipe.keys() if ingredient_index != '_at'}\n\n    # Check if all required items are available in inventory\n    if not check_inventory(env, required_items):\n        actions_to_take = gather_required_items(env, cookbook, recipe)\n    else:\n        actions_to_take = []\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    # Craft at the specified workshop\n    craft_actions = craft_at_workshop(env, workshop_name)\n    actions_to_take.extend(craft_actions)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 9, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T15:05:15.386281", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move in the x direction first to minimize obstacles on the y path\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    # Then move in the y direction\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              # Check if on top of a primitive or at a workshop\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Update inventory after gathering required items\n    update_inventory_after_actions(env, actions_to_take)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T15:05:16.493075", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Update inventory after gathering required items\n    update_inventory_after_actions(env, actions_to_take)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 6.9999995}}
