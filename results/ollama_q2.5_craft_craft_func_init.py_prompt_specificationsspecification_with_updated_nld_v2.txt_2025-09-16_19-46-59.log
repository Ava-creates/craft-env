tive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item_at_workshop(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(\"No workshops found for crafting.\")\n    \n    return actions_to_take\n\n  def ensure_correct_orientation(actions):\n    \"\"\"Ensure that the agent is facing the correct orientation before performing a USE action.\"\"\"\n    # Assuming the environment requires the agent to face the workshop or primitive\n    # Add necessary orientation changes here if needed (not implemented in this version)\n    return actions\n\n  def update_inventory(env, recipe):\n    \"\"\"Update the inventory based on the collected primitives.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += count\n        else:\n            env._current_state.inventory[primitive_index] = count\n\n  def check_inventory(env, item):\n    \"\"\"Check if the required primitives are already in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item]\n    \n    for primitive_index, count in recipe.ite