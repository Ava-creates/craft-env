tive_index] += 1\n        \n    return actions_to_take\n\n  def get_available_workshops(env):\n    cookbook = env.world.cookbook\n    workshops = {workshop: np.argwhere(env._current_state.grid[:, :, index] == 1) \n                 for workshop, index in cookbook.index.items() if 'workshop' in workshop}\n    \n    return workshops\n  \n  def move_and_use(env, target_positions):\n      current_pos = env._current_state.pos\n      \n      actions_to_take = []\n      \n      # Iterate over all required positions\n      for pos in target_positions:\n          rel_x, rel_y = pos[0] - current_pos[0], pos[1] - current_pos[1]\n          \n          # Determine direction based on relative position and move accordingly\n          if rel_x > 0:\n              actions_to_take.extend([3] * rel_x)  # Move RIGHT\n          elif rel_x < 0:\n              actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n              \n          if rel_y > 0:\n              actions_to_take.extend([1] * rel_y)  # Move DOWN\n          elif rel_y < 0:\n              actions_to_take.extend([0] * abs(rel_y))  # Move UP\n          \n          # Use the USE action at the target position\n          actions_to_take.append(4)\n          \n          # Update current position for next iteration\n          current_pos = pos\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe['_at']\n    del recipe['_at']\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_and_use(env, [tuple(pos) for pos in workshop_positions]))\n        \n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T21:22:11.932430", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_name):\n    current_pos = env._current_state.pos\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def prioritize_primitives(primitives_needed):\n    # Define a priority list based on some criteria (e.g., availability, urgency)\n    priority_list = [\n      'WORKSHOP0', 'WORKSHOP1', 'WORKSHOP2', \n      'WOOD', 'IRON', 'GRASS', 'ROCK', \n      'GOLD', 'GEM', 'WATER', 'STONE'\n    ]\n    \n    cookbook = env.world.cookbook\n    priority_indices = {cookbook.index[name]: i for i, name in enumerate(priority_list)}\n    \n    # Sort primitives by their priority index\n    sorted_primitives = sorted(primitives_needed.items(), key=lambda x: priority_indices.get(x[0], len(priority_indices)))\n    \n    return dict(sorted_primitives)\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    missing_primitives = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    return missing_primitives\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    \n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Check inventory and prioritize primitives if needed\n    missing_primitives = check_inventory(env, recipe)\n    if missing_primitives:\n      # Prioritize primitives based on some criteria\n      recipe = prioritize_primitives(missing_primitives)\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_name)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T21:22:12.894972", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_name):\n    current_pos = env._current_state.pos\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def prioritize_primitives(primitives_needed):\n    # Define a priority list based on some criteria (e.g., availability, urgency)\n    priority_list = [\n      'WORKSHOP0', 'WORKSHOP1', 'WORKSHOP2', \n      'WOOD', 'IRON', 'GRASS', 'ROCK', \n      'GOLD', 'GEM', 'WATER', 'STONE'\n    ]\n    \n    cookbook = env.world.cookbook\n    priority_indices = {cookbook.index[name]: i for i, name in enumerate(priority_list)}\n    \n    # Sort primitives by their priority index\n    sorted_primitives = sorted(primitives_needed.items(), key=lambda x: priority_indices.get(x[0], len(priority_indices)))\n    \n    return dict(sorted_primitives)\n\n  def check_recipe_availability(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) < count:\n        return False\n    return True\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    \n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Check if all required primitives are available in the environment\n    if not check_recipe_availability(env, recipe):\n      raise ValueError(f\"Not enough resources to craft {item}.\")\n  \n    # Prioritize primitives based on some criteria\n    recipe = prioritize_primitives(recipe)\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_name)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-17T21:24:03.776329", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_index):\n      \"\"\"Finds and returns the closest workshop position in the grid.\"\"\"\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          return min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n      else:\n          raise ValueError(\"No workshops found in the grid.\")\n\n  def update_inventory(env, recipe):\n    \"\"\"Updates the agent's inventory based on the crafted item.\"\"\"\n    cookbook = env.world.cookbook\n    item_index = cookbook.index[item]\n    # Update the inventory with the newly crafted item (assuming a count of 1 for now)\n    env._current_state.inventory[item_index] += 1\n\n  def check_recipe_availability(env, item):\n      \"\"\"Checks if the recipe for the desired item is available in the cookbook.\"\"\"\n      cookbook = env.world.cookbook\n      item_index = cookbook.index[item]\n      return item_index in cookbook.recipes\n  \n  cookbook = env.world.cookbook\n\n  # Check if there is a recipe available for this item\n  if check_recipe_availability(env, item):\n    # Fetch the recipe details for the item\n    item_index = cookbook.index[item]\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        # Find the closest workshop position to craft the item at\n        closest_workshop_pos = find_closest_workshop(env, workshop_index)\n        target_workshop_pos = tuple(closest_workshop_pos)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        # Update inventory with the crafted item\n        update_inventory(env, recipe)\n    except ValueError as e:\n        print(e)  # Print error message if no workshops are found\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": 6.4999995}}
