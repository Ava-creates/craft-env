{"timestamp": "2025-09-17T10:55:14.632313", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_directional_actions(target_dir):\n      \"\"\"Get the necessary turn actions to face a specific direction.\"\"\"\n      current_dir = env._current_state.dir\n      \n      if current_dir == target_dir:\n          return []\n\n      # Define the turning sequence for each direction\n      turn_sequences = {\n          (0, 1): [4],        # UP -> DOWN\n          (0, 2): [4, 4],     # UP -> LEFT\n          (0, 3): [4, 4, 4],  # UP -> RIGHT\n          (1, 0): [],         # DOWN -> UP\n          (1, 2): [4],        # DOWN -> LEFT\n          (1, 3): [4, 4],     # DOWN -> RIGHT\n          (2, 0): [4],        # LEFT -> UP\n          (2, 1): [4, 4],     # LEFT -> DOWN\n          (2, 3): [4],        # LEFT -> RIGHT\n          (3, 0): [4, 4],     # RIGHT -> UP\n          (3, 1): [4, 4, 4],  # RIGHT -> DOWN\n          (3, 2): [4]         # RIGHT -> LEFT\n      }\n      \n      return turn_sequences[(current_dir, target_dir)]\n\n  def get_required_primitives(recipe):\n    \"\"\"Extract the required primitives from a recipe.\"\"\"\n    required_primitives = []\n    for primitive_name, count in recipe.items():\n        if primitive_name not in ['_at']:\n            required_primitives.extend([primitive_name] * count)\n    return required_primitives\n\n  cookbook = env.world.cookbook\n  world = env.world\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      required_primitives = get_required_primitives(recipe)\n\n      actions_to_take = []\n\n      # Collect all required primitives before crafting\n      for primitive in required_primitives:\n          if env._current_state.grid[:, :, cookbook.index[primitive]].sum() == 0:\n              raise ValueError(f\"No available {primitive} to collect.\")\n          \n          # Find positions of the primitive in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, cookbook.index[primitive]] == 1)\n\n          if len(primitive_positions) > 0:\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n              # Determine the direction to face based on the position of the primitive relative to the agent\n              current_x, current_y = env._current_state.pos\n              target_x, target_y = target_primitive_pos\n\n              if target_x > current_x:\n                  target_dir = 3  # RIGHT\n              elif target_x < current_x:\n                  target_dir = 2  # LEFT\n              else:\n                  if target_y > current_y:\n                      target_dir = 1  # DOWN\n                  else:\n                      target_dir = 0  # UP\n\n              # Add actions to face the correct direction\n              actions_to_take.extend(get_directional_actions(target_dir))\n\n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n\n      # Now that all primitives are collected, proceed to craft the item at a workshop\n      if env._current_state.grid[:, :, workshop_index].sum() == 0:\n          raise ValueError(f\"No available {workshop_name} to craft.\")\n\n      # Find positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Determine the direction to face based on the position of the workshop relative to the agent\n          current_x, current_y = env._current_state.pos\n          target_x, target_y = target_workshop_pos\n\n          if target_x > current_x:\n              target_dir = 3  # RIGHT\n          elif target_x < current_x:\n              target_dir = 2  # LEFT\n          else:\n              if target_y > current_y:\n                  target_dir = 1  # DOWN\n              else:\n                  target_dir = 0  # UP\n\n          # Add actions to face the correct direction\n          actions_to_take.extend(get_directional_actions(target_dir))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n      return actions_to_take\n\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T10:55:15.592958", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_directional_actions(target_dir):\n      \"\"\"Get the necessary turn actions to face a specific direction.\"\"\"\n      current_dir = env._current_state.dir\n      \n      if current_dir == target_dir:\n          return []\n\n      # Define the turning sequence for each direction\n      turn_sequences = {\n          (0, 1): [4],        # UP -> DOWN\n          (0, 2): [4, 4],     # UP -> LEFT\n          (0, 3): [4, 4, 4],  # UP -> RIGHT\n          (1, 0): [],         # DOWN -> UP\n          (1, 2): [4],        # DOWN -> LEFT\n          (1, 3): [4, 4],     # DOWN -> RIGHT\n          (2, 0): [4],        # LEFT -> UP\n          (2, 1): [4, 4],     # LEFT -> DOWN\n          (2, 3): [4],        # LEFT -> RIGHT\n          (3, 0): [4, 4],     # RIGHT -> UP\n          (3, 1): [4, 4, 4],  # RIGHT -> DOWN\n          (3, 2): [4]         # RIGHT -> LEFT\n      }\n      \n      return turn_sequences[(current_dir, target_dir)]\n\n  def gather_primitives(env, recipe):\n    actions_to_take = []\n    \n    # Check for primitives needed in the inventory and collect them if necessary\n    current_inventory = env._current_state.inventory\n    \n    # Filter out already available items\n    missing_items = {item: count for item, count in recipe.items() if item != '_at' and count > current_inventory.get(item, 0)}\n    \n    for primitive, required_count in missing_items.items():\n        primitive_index = cookbook.index[primitive]\n        \n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n            current_pos = env._current_state.pos\n\n            closest_primitive = min(\n                primitive_positions, \n                key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            )\n            \n            target_primitive_pos = tuple(closest_primitive)\n\n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n            # Collect the primitive (Assuming it requires a USE action)\n            actions_to_take.append(4)\n            \n            # Update inventory count for the collected item\n            if primitive in current_inventory:\n                current_inventory[primitive] += 1\n            else:\n                current_inventory[primitive] = 1\n            \n        else:\n            raise ValueError(f\"No {primitive} found.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Gather all required primitives\n          actions_to_take = gather_primitives(env, recipe)\n          \n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n          \n          # Determine the direction to face based on the position of the workshop relative to the agent\n          current_x, current_y = current_pos\n          target_x, target_y = target_workshop_pos\n\n          if target_x > current_x:\n              target_dir = 3  # RIGHT\n          elif target_x < current_x:\n              target_dir = 2  # LEFT\n          else:\n              if target_y > current_y:\n                  target_dir = 1  # DOWN\n              else:\n                  target_dir = 0  # UP\n\n          # Add actions to face the correct direction\n          actions_to_take.extend(get_directional_actions(target_dir))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T10:57:27.549646", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is not in inventory and has a recipe, attempt to craft it.\n      if primitive_index in cookbook.recipes:\n        actions_to_take.extend(craft_item(env, primitive_index))\n      else:\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  \n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the closest workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n    \n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 5.0}}
{"timestamp": "2025-09-17T10:57:28.605601", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is not in inventory and has a recipe, attempt to craft it.\n      if primitive_index in cookbook.recipes:\n        actions_to_take.extend(craft_item(env, primitive_index))\n      else:\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  \n  def collect_item(env, item_name):\n    cookbook = env.world.cookbook\n    world = env.world\n    \n    # Get the index for the desired primitive.\n    item_index = cookbook.index[item_name]\n    \n    # Find all positions of the specified primitive in the grid.\n    item_positions = np.argwhere(env._current_state.grid[:, :, item_index] == 1)\n\n    if len(item_positions) > 0:\n        # Choose the closest available position to collect it from.\n        current_pos = env._current_state.pos\n\n        closest_item = min(\n            item_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_item_pos = tuple(closest_item)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take = get_move_actions(target_item_pos)\n\n        # Use the USE action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No {item_name} found.\")\n  \n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the closest workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n    \n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 5.2}}
