he grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the nearest workshop\n  target_pos = min(workshop_positions, key=lambda pos: heuristic(current_pos, tuple(pos)))\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:08:38.298978", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n\n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def gather_primitives(primitive_indices):\n    actions_to_take = []\n    \n    for primitive_index in primitive_indices:\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        closest_primitive_pos = min(\n          primitive_positions, \n          key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        actions_to_take.extend(get_move_actions(tuple(closest_primitive_pos)))\n        \n        # Align with the primitive before collecting it.\n        actions_to_take.extend(align_with_workshop(tuple(closest_primitive_pos)))\n        \n        # Collect the primitive\n        actions_to_take.append(4)\n      \n      else:\n        raise ValueError(f\"No primitives found for {primitive_index}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Extract the required primitives from the recipe\n      primitive_names = [key for key in recipe if key not in ['_at']]\n      primitive_indices = [cookbook.index[name] for name in primitive_names]\n\n      # Gather all required primitives before crafting\n      actions_to_take = gather_primitives(primitive_indices)\n      \n      # Move to and align with the workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n      actions_to_take.extend(align_with_workshop(target_workshop_pos))\n\n      # Craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T03:08:39.282143", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n    \n    # Calculate move actions based on relative position.\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the target direction based on relative position.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def pick_up_item(item_index):\n    item_positions = np.argwhere(env._current_state.grid[:, :, item_index] == 1)\n    \n    actions_to_take = []\n    for pos in item_positions:\n        pos_tuple = tuple(pos)\n        \n        # Move to the item position\n        actions_to_take.extend(get_move_actions(pos_tuple))\n        \n        # Align with the item before picking it up.\n        actions_to_take.extend(align_with_workshop(pos_tuple))\n        \n        # Use action to pick up the item\n        actions_to_take.append(4)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract required ingredients from the recipe.\n    required_items = {key: value for key, value in recipe.items() if key not in ['_at', '_produces']}\n\n    actions_to_take = []\n\n    # Collect all required items before crafting.\n    for ingredient_name, quantity in required_items.items():\n        ingredient_index = cookbook.index[ingredient_name]\n        \n        # Check if the agent already has enough of this item.\n        current_inventory = env._current_state.inventory\n        \n        # Assuming `inventory` is a dictionary with item indices as keys and quantities as values.\n        if current_inventory.get(ingredient_index, 0) < quantity:\n            actions_to_take.extend(pick_up_item(ingredient_index))\n        \n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:09:37.274846", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(target_x, target_y):\n    actions = []\n    current_x, current_y = env._current_state.pos\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      elif dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      \n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      elif dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n    \n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(move_to(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:09:38.392992", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    while dx != 0 or dy != 0:\n      if abs(dx) >= abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n          dx -= 1\n        elif dx < 0:\n          actions.append(2)  # LEFT\n          dx += 1\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n          dy -= 1\n        elif dy < 0:\n          actions.append(0)  # DOWN\n          dy += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:10:30.378045", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n    \n    directions = []\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    return directions\n\n  actions = []\n\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n  \n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:10:31.438182", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n    \n    directions = []\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n\n    return directions\n\n  actions = []\n\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n  \n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:11:50.179441", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def calculate_path(start, target):\n    \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n    sx, sy = start\n    tx, ty = target\n    \n    if tx > sx:\n        actions.extend([3] * (tx - sx))  # RIGHT\n    elif tx < sx:\n        actions.extend([2] * abs(sx - tx))  # LEFT\n    \n    if ty > sy:\n        actions.extend([1] * (ty - sy))  # UP\n    elif ty < sy:\n        actions.extend([0] * abs(sy - ty))  # DOWN\n\n  def rotate_towards(dx, dy):\n      \"\"\"Rotate the agent towards the direction of movement.\"\"\"\n      current_dir = env._current_state.dir\n      desired_dir = None\n      \n      if dx > 0:\n          desired_dir = 3  # RIGHT\n      elif dx < 0:\n          desired_dir = 2  # LEFT\n      elif dy > 0:\n          desired_dir = 1  # UP\n      elif dy < 0:\n          desired_dir = 0  # DOWN\n      \n      if desired_dir is not None and current_dir != desired_dir:\n          # Calculate the difference in direction and adjust accordingly\n          diff = (desired_dir - current_dir) % 4\n          if diff == 1 or diff == 3:\n              actions.append((current_dir + 1) % 4)\n          elif diff == 2:\n              actions.extend([(current_dir + 1) % 4, (current_dir + 2) % 4])\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  tx, ty = closest_workshop_pos\n  sx, sy = current_x, current_y\n\n  dx, dy = tx - sx, ty - sy\n  \n  # Rotate towards the direction of movement if necessary\n  rotate_towards(dx, dy)\n\n  # Calculate path to the workshop\n  calculate_path((sx, sy), (tx, ty))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:11:51.241069", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n    \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n    sx, sy = start\n    tx, ty = target\n    \n    actions = []\n    \n    # Move horizontally first if the difference is larger or equal\n    if abs(tx - sx) >= abs(ty - sy):\n        if tx > sx:\n            actions.extend([3] * (tx - sx))  # RIGHT\n        elif tx < sx:\n            actions.extend([2] * (sx - tx))  # LEFT\n        \n        if ty > sy:\n            actions.extend([1] * (ty - sy))  # UP\n        elif ty < sy:\n            actions.extend([0] * (sy - ty))  # DOWN\n    else:\n        if ty > sy:\n            actions.extend([1] * (ty - sy))  # UP\n        elif ty < sy:\n            actions.extend([0] * (sy - ty))  # DOWN\n        \n        if tx > sx:\n            actions.extend([3] * (tx - sx))  # RIGHT\n        elif tx < sx:\n            actions.extend([2] * (sx - tx))  # LEFT\n    \n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:13:07.086055", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Determine the sequence of moves based on direction differences\n      if tx > sx:\n          actions.extend([3] * (tx - sx))  # RIGHT\n      elif tx < sx:\n          actions.extend([2] * (sx - tx))  # LEFT\n      \n      if ty > sy:\n          actions.extend([1] * (ty - sy))  # UP\n      elif ty < sy:\n          actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:13:08.077139", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a path from start to target using A* algorithm.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      open_list = []\n      closed_set = set()\n      g_costs = {}\n      f_costs = {}\n      came_from = {}\n\n      # Initialize the starting point\n      open_list.append((0, (sx, sy)))\n      g_costs[(sx, sy)] = 0\n      f_costs[(sx, sy)] = abs(tx - sx) + abs(ty - sy)\n\n      while open_list:\n          _, current = min(open_list, key=lambda x: x[0])\n          open_list.remove(min(open_list, key=lambda x: x[0]))\n\n          if current == (tx, ty):\n              # Reconstruct path\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1] + [current]\n\n          closed_set.add(current)\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if neighbor not in closed_set and env._current_state.grid[neighbor[0], neighbor[1]].sum() == 0:\n                  tentative_g_cost = g_costs[current] + 1\n                  if neighbor not in g_costs or tentative_g_cost < g_costs[neighbor]:\n                      came_from[neighbor] = current\n                      g_costs[neighbor] = tentative_g_cost\n                      f_costs[neighbor] = tentative_g_cost + abs(tx - neighbor[0]) + abs(ty - neighbor[1])\n                      open_list.append((f_costs[neighbor], neighbor))\n\n      return []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  path = calculate_path((current_x, current_y), closest_workshop_pos)\n\n  if not path:\n      raise ValueError(\"No valid path found to the workshop.\")\n\n  for px, py in path[1:]:  # Skip the first position as it's the starting point\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      current_x, current_y = px, py\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:14:19.775775", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def rotate_to_direction(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    current_dir = env._current_state.dir\n    \n    # Calculate the direction to move\n    if dx > 0:\n        target_dir = 3  # RIGHT\n    elif dx < 0:\n        target_dir = 2  # LEFT\n    elif dy > 0:\n        target_dir = 1  # UP\n    else:\n        target_dir = 0  # DOWN\n    \n    # Calculate the difference in direction\n    dir_diff = (target_dir - current_dir) % 4\n    \n    if dir_diff == 1:\n        actions.append(5)  # RIGHT TURN\n    elif dir_diff == 2:\n        actions.extend([5, 5])  # RIGHT TURN TWICE\n    elif dir_diff == 3:\n        actions.append(6)  # LEFT TURN\n\n  rotate_to_direction(target_x, target_y)\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:14:20.832122", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Check if the agent is already in front of the workshop\n  if dx == 0 and dy == 0:\n      pass  # No need to move further\n  else:\n      # Align the agent's direction towards the workshop\n      if dx > 0:  # Target is to the right\n          actions.append(3)  # RIGHT\n      elif dx < 0:  # Target is to the left\n          actions.append(2)  # LEFT\n      \n      if dy > 0:  # Target is above\n          actions.append(1)  # UP\n      elif dy < 0:  # Target is below\n          actions.append(0)  # DOWN\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T03:15:20.202566", "function_name": "craft", "function_body": "  def navigate_to(target_pos):\n      current_pos = np.array(env._current_state.pos)\n      target_pos = np.array(target_pos)\n\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = navigate_to(target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:15:21.326748", "function_name": "craft", "function_body": "  def navigate_towards(target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      direction = env._current_state.dir\n      \n      # Adjust x-coordinate\n      if target_x > current_x:\n          if direction != 3: actions.append(3)  # RIGHT\n          while current_x < target_x:\n              actions.append(4)\n              current_x += 1\n      elif target_x < current_x:\n          if direction != 2: actions.append(2)  # LEFT\n          while current_x > target_x:\n              actions.append(4)\n              current_x -= 1\n      \n      # Adjust y-coordinate\n      if target_y > current_y:\n          if direction != 1: actions.append(1)  # UP\n          while current_y < target_y:\n              actions.append(4)\n              current_y += 1\n      elif target_y < current_y:\n          if direction != 0: actions.append(0)  # DOWN\n          while current_y > target_y:\n              actions.append(4)\n              current_y -= 1\n      \n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = navigate_towards(target_workshop_pos[0], target_workshop_pos[1])\n  \n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.7}}
{"timestamp": "2025-09-17T03:16:16.204155", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while current_x != x or current_y != y:\n          # Determine the next step\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          elif current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:16:17.281826", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while current_x != x or current_y != y:\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:17:58.344960", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first (left or right)\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n    \n    # Then move vertically (up or down)\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n    \n    return actions_to_take\n\n  def get_turn_action(target_dir):\n      current_dir = env._current_state.dir\n      \n      # Define direction vectors\n      directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n      \n      current_idx = directions.index((0, 1)) if current_dir == 3 else \\\n                    directions.index((1, 0)) if current_dir == 2 else \\\n                    directions.index((0, -1)) if current_dir == 1 else \\\n                    directions.index((-1, 0))\n      \n      target_idx = directions.index(target_dir)\n      \n      # Calculate the difference in indices\n      diff = (target_idx - current_idx) % 4\n      \n      turn_actions = []\n      if diff == 1:\n          turn_actions.append(2)  # RIGHT TURN\n      elif diff == 2:\n          turn_actions.extend([2, 2])  # TWO RIGHT TURNS or ONE LEFT TURN\n      elif diff == 3:\n          turn_actions.append(3)  # LEFT TURN\n      \n      return turn_actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Calculate turn action to face the workshop correctly\n        current_dir = env._current_state.dir\n        # Assuming the agent needs to be in front of the workshop to use it.\n        target_dir = (closest_workshop[0] - current_pos[0], closest_workshop[1] - current_pos[1])\n        \n        if target_dir == (0, 1):\n            target_dir = (0, 1)  # UP\n        elif target_dir == (0, -1):\n            target_dir = (0, -1)  # DOWN\n        elif target_dir == (1, 0):\n            target_dir = (1, 0)  # RIGHT\n        elif target_dir == (-1, 0):\n            target_dir = (-1, 0)  # LEFT\n\n        turn_actions = get_turn_action(target_dir)\n        actions_to_take.extend(turn_actions)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:17:59.460412", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_turn_action(target_dir):\n    current_dir = env._current_state.dir\n    if target_dir == (0, 1) and current_dir != 3: \n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 3:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 1:\n        return [(current_dir + 3) % 4]\n    else:\n        return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Turn to face the workshop if necessary. Here, we assume that the agent needs to be in front of the workshop to use it.\n        target_dir = (closest_workshop[0] - current_pos[0], closest_workshop[1] - current_pos[1])\n        \n        # Convert target direction into action\n        actions_to_take.extend(get_turn_action(target_dir))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:19:02.949466", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Determine the sequence of moves based on direction differences\n      if tx > sx:\n          actions.extend([3] * (tx - sx))  # RIGHT\n      elif tx < sx:\n          actions.extend([2] * (sx - tx))  # LEFT\n      \n      if ty > sy:\n          actions.extend([1] * (ty - sy))  # UP\n      elif ty < sy:\n          actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  def is_workshop_next_to(current_x, current_y, workshop_positions):\n    for wx, wy in workshop_positions:\n        if abs(wx - current_x) + abs(wy - current_y) == 1:\n            return True\n    return False\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  if is_workshop_next_to(current_x, current_y, workshop_positions):\n    # If already next to a workshop, use the USE action\n    actions.append(4)  # USE\n  else:\n    closest_workshop_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n\n    # Calculate path to the workshop\n    actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n    # Craft the item (use the USE action)\n    actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:19:04.071941", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(positions) > 0:\n      return positions\n    else:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  def calculate_path(start, target):\n    \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n    sx, sy = start\n    tx, ty = target\n    \n    actions = []\n    \n    # Determine the sequence of moves based on direction differences\n    if tx > sx:\n        actions.extend([3] * (tx - sx))  # RIGHT\n    elif tx < sx:\n        actions.extend([2] * (sx - tx))  # LEFT\n    \n    if ty > sy:\n        actions.extend([1] * (ty - sy))  # UP\n    elif ty < sy:\n        actions.extend([0] * (sy - ty))  # DOWN\n    \n    return actions\n\n  def move_to_workshop(start, workshop_positions):\n      \"\"\"Find the closest workshop and calculate path to it.\"\"\"\n      closest_workshop_pos = min(\n          workshop_positions,\n          key=lambda pos: abs(pos[0] - start[0]) + abs(pos[1] - start[1])\n      )\n      \n      # Calculate path to the workshop\n      return calculate_path(start, closest_workshop_pos)\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n\n  current_x, current_y = env._current_state.pos\n\n  # Move to the closest workshop\n  actions.extend(move_to_workshop((current_x, current_y), workshop_positions))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:20:45.135235", "function_name": "craft", "function_body": "  def get_direction(current_dir, target_dir):\n      if current_dir == 'UP':\n          if target_dir == 'DOWN':\n              return [0]  # Turn around\n          elif target_dir == 'LEFT':\n              return [3]  # Turn left\n          elif target_dir == 'RIGHT':\n              return [2]  # Turn right\n      elif current_dir == 'DOWN':\n          if target_dir == 'UP':\n              return [1]\n          elif target_dir == 'LEFT':\n              return [2]\n          elif target_dir == 'RIGHT':\n              return [3]\n      elif current_dir == 'LEFT':\n          if target_dir == 'UP':\n              return [2]\n          elif target_dir == 'DOWN':\n              return [3]\n          elif target_dir == 'RIGHT':\n              return [0]  # Turn around\n      elif current_dir == 'RIGHT':\n          if target_dir == 'UP':\n              return [3]\n          elif target_dir == 'DOWN':\n              return [2]\n          elif target_dir == 'LEFT':\n              return [0]\n\n      return []\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    dir_map = {'UP': (0, -1), 'DOWN': (0, 1), 'LEFT': (-1, 0), 'RIGHT': (1, 0)}\n    opposite_dir_map = {v: k for k, v in dir_map.items()}\n    \n    current_dir = 'UP'  # Starting direction\n    while current_pos != target_pos:\n        dx = target_pos[0] - current_pos[0]\n        dy = target_pos[1] - current_pos[1]\n\n        if dx > 0 and abs(dx) >= abs(dy):\n            target_dir = 'RIGHT'\n        elif dx < 0 and abs(dx) >= abs(dy):\n            target_dir = 'LEFT'\n        elif dy > 0:\n            target_dir = 'DOWN'\n        else:\n            target_dir = 'UP'\n\n        turn_actions = get_direction(current_dir, target_dir)\n        actions.extend(turn_actions)\n\n        # Move forward\n        move_action = dir_map[target_dir]\n        current_pos = (current_pos[0] + move_action[0], current_pos[1] + move_action[1])\n        actions.append(4)  # Assuming MOVE action is represented by index 4\n\n        current_dir = target_dir\n    \n    return actions[:-1]  # Exclude the last unnecessary move forward\n\n  def get_closest_workshop(workshop_positions, current_pos):\n    closest_distance = float('inf')\n    closest_position = None\n    for pos in workshop_positions:\n        distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        if distance < closest_distance:\n            closest_distance = distance\n            closest_position = tuple(pos)\n    return closest_position\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the closest one here)\n  target_pos = get_closest_workshop(workshop_positions, env._current_state.pos)\n  current_pos = env._current_state.pos\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 0.099999994}}
{"timestamp": "2025-09-17T03:20:46.264770", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n        return 'DOWN'\n    elif dx < 0:\n        return 'UP'\n    else:\n        if dy > 0:\n            return 'RIGHT'\n        elif dy < 0:\n            return 'LEFT'\n    return None\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n    \n    while current_pos != target_pos:\n        direction = get_direction(current_pos, target_pos)\n        \n        if direction is not None:\n            actions.append(dir_map[direction])\n            # Simulate the move to update current_pos\n            if direction == 'DOWN':\n                current_pos = (current_pos[0] + 1, current_pos[1])\n            elif direction == 'UP':\n                current_pos = (current_pos[0] - 1, current_pos[1])\n            elif direction == 'RIGHT':\n                current_pos = (current_pos[0], current_pos[1] + 1)\n            elif direction == 'LEFT':\n                current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  def get_closest_workshop(workshop_positions, current_pos):\n    closest_distance = float('inf')\n    closest_position = None\n    for pos in workshop_positions:\n        distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        if distance < closest_distance:\n            closest_distance = distance\n            closest_position = tuple(pos)\n    return closest_position\n\n  def orient_towards_target(current_dir, target_direction):\n    dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n    turn_actions = []\n    \n    if current_dir != target_direction:\n        if (current_dir == 'UP' and target_direction == 'RIGHT') or \\\n           (current_dir == 'DOWN' and target_direction == 'LEFT') or \\\n           (current_dir == 'LEFT' and target_direction == 'UP') or \\\n           (current_dir == 'RIGHT' and target_direction == 'DOWN'):\n            turn_actions.append(2)  # LEFT\n        elif (current_dir == 'UP' and target_direction == 'LEFT') or \\\n             (current_dir == 'DOWN' and target_direction == 'RIGHT') or \\\n             (current_dir == 'LEFT' and target_direction == 'DOWN') or \\\n             (current_dir == 'RIGHT' and target_direction == 'UP'):\n            turn_actions.append(3)  # RIGHT\n        else:\n            turn_actions.extend([2, 2])  # LEFT, LEFT\n    \n    return turn_actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the closest one here)\n  target_pos = get_closest_workshop(workshop_positions, env._current_state.pos)\n  current_pos = env._current_state.pos\n  current_dir = 'UP'  # Assuming initial direction is UP\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T03:21:57.967929", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      # Calculate the direction to move based on remaining distance\n      dx = x - current_x\n      dy = y - current_y\n      \n      while dx != 0 or dy != 0:\n          if abs(dx) > abs(dy):\n              step_x = np.sign(dx)\n              step_y = 0\n          else:\n              step_x = 0\n              step_y = np.sign(dy)\n\n          dx -= step_x\n          dy -= step_y\n\n          # Convert the direction to the corresponding action index\n          if step_x == -1:\n              actions.append(2)  # LEFT\n          elif step_x == 1:\n              actions.append(3)  # RIGHT\n          elif step_y == -1:\n              actions.append(0)  # DOWN\n          elif step_y == 1:\n              actions.append(1)  # UP\n\n      return actions\n\n  def face_towards(x, y):\n    actions = []\n    current_x, current_y = env._current_state.pos\n    target_dir = np.arctan2(y - current_y, x - current_x)\n    current_dir = {0: np.pi/2, 1: 0, 2: np.pi, 3: -np.pi/2}[env._current_state.dir]\n    \n    # Calculate the angle difference\n    angle_diff = target_dir - current_dir\n    \n    # Adjust angle to be within [-pi, pi]\n    if angle_diff > np.pi:\n        angle_diff -= 2 * np.pi\n    elif angle_diff < -np.pi:\n        angle_diff += 2 * np.pi\n    \n    # Determine the direction to turn based on the angle difference\n    if angle_diff > 0:\n        actions.append(5)  # TURN_RIGHT\n    elif angle_diff < 0:\n        actions.append(6)  # TURN_LEFT\n\n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Face towards the workshop (optional, if needed)\n  # actions.extend(face_towards(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:21:59.035336", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while x != current_x or y != current_y:\n          dx = x - current_x\n          dy = y - current_y\n\n          # Determine the direction to move based on remaining distance\n          if abs(dx) > abs(dy):\n              step_x = np.sign(dx)\n              actions.append(2 + int(step_x == 1))  # LEFT or RIGHT\n              current_x += step_x\n          else:\n              step_y = np.sign(dy)\n              actions.append(0 + int(step_y == 1))  # DOWN or UP\n              current_y += step_y\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
