(use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T07:09:38.121966", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n    actions = []\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Determine the direction to move based on the shortest path (Manhattan distance)\n    if abs(dx) > abs(dy):\n        # Move horizontally first\n        if dx > 0:\n            actions.extend([3] * abs(dx))  # RIGHT\n        elif dx < 0:\n            actions.extend([2] * abs(dx))  # LEFT\n        # Then move vertically\n        if dy > 0:\n            actions.extend([1] * abs(dy))  # UP\n        elif dy < 0:\n            actions.extend([0] * abs(dy))  # DOWN\n    else:\n        # Move vertically first\n        if dy > 0:\n            actions.extend([1] * abs(dy))  # UP\n        elif dy < 0:\n            actions.extend([0] * abs(dy))  # DOWN\n        # Then move horizontally\n        if dx > 0:\n            actions.extend([3] * abs(dx))  # RIGHT\n        elif dx < 0:\n            actions.extend([2] * abs(dx))  # LEFT\n\n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T07:11:16.965757", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n\n    return actions_to_take\n  \n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it from the copy\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n    \n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 4.6}}
{"timestamp": "2025-09-17T07:11:18.075796", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T07:12:37.735519", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def find_closest_workshop(workshop_positions, current_x, current_y):\n    closest_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n    return closest_pos\n\n  def is_next_to_position(current_x, current_y, target_x, target_y):\n    # Check if the agent is next to the target position\n    return (abs(current_x - target_x) <= 1 and abs(current_y - target_y) <= 1)\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = find_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Check if the agent is next to the workshop before crafting\n  if not is_next_to_position(current_x, current_y, target_x, target_y):\n      raise ValueError(\"Agent is not next to the workshop after moving.\")\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-17T07:12:38.859030", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def find_closest_workshop(workshop_positions, current_x, current_y):\n    closest_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n    return closest_pos\n\n  def rotate_towards_target(current_dir, target_x, target_y, current_x, current_y):\n      actions = []\n      \n      if target_x > current_x:\n          target_direction = 3  # RIGHT\n      elif target_x < current_x:\n          target_direction = 2  # LEFT\n      elif target_y > current_y:\n          target_direction = 1  # UP\n      else:  # target_y < current_y\n          target_direction = 0  # DOWN\n      \n      if current_dir != target_direction:\n          while current_dir != target_direction:\n              actions.append((current_dir + 1) % 4)  # Rotate clockwise\n              current_dir = (current_dir + 1) % 4\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  closest_workshop_pos = find_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Rotate towards the target position if needed\n  actions.extend(rotate_towards_target(current_dir, target_x, target_y, current_x, current_y))\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:13:33.537316", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    directions = []\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:13:34.639740", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    directions = []\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:14:53.763693", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      # Determine the direction to face for moving towards the workshop\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n  \n  def turn_towards(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    direction_mapping = {\n        (1, 0): 3,  # RIGHT\n        (-1, 0): 2,  # LEFT\n        (0, 1): 1,   # UP\n        (0, -1): 0   # DOWN\n    }\n    \n    target_direction = direction_mapping.get((dx, dy))\n    \n    if target_direction is None:\n      return []\n    \n    current_direction = env._current_state.dir\n    \n    turns = {\n        (0, 3): [2],  # FROM DOWN TO RIGHT\n        (0, 1): [2, 2],  # FROM DOWN TO UP\n        (0, 2): [3],  # FROM DOWN TO LEFT\n        (1, 3): [],  # FROM UP TO RIGHT\n        (1, 2): [2],  # FROM UP TO LEFT\n        (1, 0): [2, 2],  # FROM UP TO DOWN\n        (2, 0): [2],  # FROM LEFT TO DOWN\n        (2, 3): [3],  # FROM LEFT TO RIGHT\n        (2, 1): [2, 2],  # FROM LEFT TO UP\n        (3, 1): [],  # FROM RIGHT TO UP\n        (3, 0): [2],  # FROM RIGHT TO DOWN\n        (3, 2): [3]   # FROM RIGHT TO LEFT\n    }\n    \n    return turns.get((current_direction, target_direction), [])\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Turn towards the workshop\n  actions.extend(turn_towards(target_x, target_y))\n  \n  # Move towards the workshop\n  actions.extend(move_towards(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:14:54.816780", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      # Determine direction to face for moving towards the workshop\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          while current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n      elif dx < 0:\n          while current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n      \n      if dy > 0:\n          while current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n      elif dy < 0:\n          while current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n      return actions\n  \n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Move towards the workshop\n  actions.extend(move_towards(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.8999996}}
