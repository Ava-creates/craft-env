= np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T22:06:25.294087", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item {item}\")\n\n  # Determine which workshop is required\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  # We assume we have all the ingredients needed, so let's just go to the first available workshop.\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the workshop\n  actions_to_move = get_path(env._current_state.pos, target_workshop_pos, env._current_state.dir)\n\n  # Add the USE action to perform crafting at the workshop\n  actions_to_craft = [craft.USE]\n\n  return actions_to_move + actions_to_craft", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:06:26.266348", "function_name": "craft", "function_body": "  # Fetch the recipe for the target item\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  # Retrieve the workshop where the item should be crafted\n  recipe = cookbook.recipes[goal_index]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Get the agent's current position and direction\n  state = env._current_state\n  pos_x, pos_y = state.pos\n  current_dir = state.dir\n\n  # Find the closest workshop of the required type\n  grid = state.grid\n  target_workshops = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if target_workshops.size == 0:\n    raise ValueError(f\"No {workshop_name} found in the environment.\")\n    \n  min_distance = float('inf')\n  closest_workshop = None\n  \n  for w_x, w_y in target_workshops:\n      distance = abs(w_x - pos_x) + abs(w_y - pos_y)\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop = (w_x, w_y)\n\n  # Calculate the path to the closest workshop\n  actions_to_reach_workshop = []\n  \n  while closest_workshop != state.pos:\n      dx = closest_workshop[0] - pos_x\n      dy = closest_workshop[1] - pos_y\n      \n      if abs(dx) >= abs(dy):\n          move_dir = UP if dx > 0 else DOWN\n      else:\n          move_dir = RIGHT if dy > 0 else LEFT\n      \n      actions_to_reach_workshop.append(move_dir)\n      \n      # Simulate the movement to get the new position and direction\n      _, state = state.step(move_dir)\n      pos_x, pos_y = state.pos\n\n  # Once at the workshop, use it to craft the item\n  actions_to_craft_item = [USE]\n  \n  return actions_to_reach_workshop + actions_to_craft_item", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:07:20.622062", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Extract the workshop where the crafting must be performed from the recipe\n  workshop_name = recipe[\"_at\"]\n  \n  # Get the index of the workshop in the world's workshop_indices list\n  workshop_index = next(i for i, w in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(w) == workshop_name)\n  \n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if env._current_state.grid[y, x, workshop_index] == 1:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos is not None:\n      break\n  \n  # If the workshop is found, move to it\n  if workshop_pos is not None:\n    agent_x, agent_y = env._current_state.pos\n    target_x, target_y = workshop_pos\n    \n    # Calculate the direction needed to move towards the workshop\n    dx, dy = target_x - agent_x, target_y - agent_y\n    \n    # Move horizontally first\n    if dx > 0:\n      actions.extend([craft.LEFT] * abs(dx))\n    elif dx < 0:\n      actions.extend([craft.RIGHT] * abs(dx))\n    \n    # Then move vertically\n    if dy > 0:\n      actions.extend([craft.DOWN] * abs(dy))\n    elif dy < 0:\n      actions.extend([craft.UP] * abs(dy))\n  \n  # Once at the workshop, use the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:07:21.602676", "function_name": "craft", "function_body": "  # Determine the workshop needed to craft the item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  if item not in index:\n    raise ValueError(f\"Item {item} not found in cookbook.\")\n\n  goal_index = index[item]\n  recipe = cookbook.recipes.get(goal_index)\n\n  if \"_at\" not in recipe:\n    raise ValueError(f\"No workshop specified for crafting item {item}.\")\n\n  workshop_name = recipe[\"_at\"]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine the correct workshop index\n  for idx, name in enumerate(workshop_indices):\n    if name == workshop_name:\n      workshop_index = idx\n      break\n  else:\n    raise ValueError(f\"Workshop {workshop_name} not found in environment.\")\n\n  # Get the position of the first available workshop\n  grid = env._current_state.grid[:, :, workshop_index]\n  positions = np.argwhere(grid > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of workshop {workshop_name} found on the grid.\")\n\n  target_pos = tuple(positions[0])  # Choose the first available workshop\n\n  # Determine actions to move to the workshop\n  current_pos = env._current_state.pos\n  actions_to_workshop = []\n  \n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0 and (env._current_state.dir == craft.RIGHT):\n          actions_to_workshop.append(craft.USE)\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif dx < 0 and (env._current_state.dir == craft.LEFT):\n          actions_to_workshop.append(craft.USE)\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif dy > 0 and (env._current_state.dir == craft.DOWN):\n          actions_to_workshop.append(craft.USE)\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif dy < 0 and (env._current_state.dir == craft.UP):\n          actions_to_workshop.append(craft.USE)\n          current_pos = (current_pos[0], current_pos[1] - 1)\n      else:\n          if dx > 0:\n              actions_to_workshop.append(craft.RIGHT)\n          elif dx < 0:\n              actions_to_workshop.append(craft.LEFT)\n          elif dy > 0:\n              actions_to_workshop.append(craft.DOWN)\n          elif dy < 0:\n              actions_to_workshop.append(craft.UP)\n\n  # Add the USE action to craft the item\n  actions_to_workshop.append(craft.USE)\n\n  return actions_to_workshop", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:07:52.351287", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Find the workshop specified in the recipe\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # List to store actions\n  actions = []\n\n  # Move to the workshop (assuming we are already at a position where we can move towards it)\n  # For simplicity, let's assume we know the coordinates of the workshop (this would normally be determined dynamically)\n  # Here, we just generate random movement actions for demonstration purposes\n\n  # Placeholder function to find the path to the workshop\n  def find_path_to_workshop():\n    # This should implement an actual pathfinding algorithm like A*\n    # For now, let's assume a hardcoded path (UP, RIGHT, RIGHT)\n    return [env.action_specs()[\"UP\"], env.action_specs()[\"RIGHT\"], env.action_specs()[\"RIGHT\"]]\n\n  path_to_workshop = find_path_to_workshop()\n  actions.extend(path_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:07:53.320575", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  workshop_index = cookbook.recipes[cookbook.index[item]][\"_key\"]\n  actions = []\n\n  # Move to the nearest workshop that can craft the required item.\n  target_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop in env.world.workshop_indices:\n    if env.world.cookbook.get(workshop) == cookbook.get(workshop_index):\n      x, y = env._current_state.pos\n      wx, wy = workshop // env.world.scenario.grid.shape[1], workshop % env.world.scenario.grid.shape[1]\n      distance = abs(x - wx) + abs(y - wy)\n      if distance < min_distance:\n        min_distance = distance\n        target_workshop_pos = (wx, wy)\n\n  # If no valid workshop is found, raise an error.\n  if target_workshop_pos is None:\n    raise ValueError(f\"No valid workshop found for item: {item}\")\n\n  # Navigate to the nearest workshop.\n  actions.extend(navigate_to(env._current_state.pos, target_workshop_pos))\n\n  # Perform the use action to craft the item at the workshop.\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming N_ACTIONS is the index of the USE action.\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:08:46.719419", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_name):\n    # This function should implement a search for the nearest workshop using A* or another pathfinding algorithm\n    # For now, let's assume it returns a hardcoded path (UP, RIGHT, RIGHT)\n    return [env.action_specs()[\"UP\"], env.action_specs()[\"RIGHT\"], env.action_specs()[\"RIGHT\"]]\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n\n  actions = []\n  path_to_workshop = find_nearest_workshop(workshop_name)\n  actions.extend(path_to_workshop)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:08:47.697990", "function_name": "craft", "function_body": "  item_idx = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Find the workshop specified in the recipe\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Placeholder function to find the path to the workshop using A* algorithm\n  def a_star_search(start, goal):\n    width, height = env._current_state.grid.shape[:2]\n    start_node = (start[0], start[1])\n    goal_node = (goal[0], goal[1])\n\n    open_set = collections.PriorityQueue()\n    came_from = {}\n    g_score = {start_node: 0}\n    f_score = {start_node: heuristic(start_node, goal_node)}\n\n    open_set.put((f_score[start_node], start_node))\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal_node:\n        return reconstruct_path(came_from, current)\n\n      for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          neighbor = (current[0] + direction[0], current[1] + direction[1])\n          \n          if not (0 <= neighbor[0] < width and 0 <= neighbor[1] < height):\n              continue\n\n          tentative_g_score = g_score[current] + 1\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal_node)\n              open_set.put((f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  # Find the coordinates of the workshop\n  goal_position = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[y, x, workshop_idx] == 1:\n            goal_position = (x, y)\n            break\n    if goal_position:\n      break\n\n  if not goal_position:\n    raise ValueError(f\"Workshop {workshop_name} not found on the grid.\")\n\n  # Find path to the workshop using A* algorithm\n  start_position = env._current_state.pos\n  path_to_workshop = a_star_search(start_position, goal_position)\n\n  # Convert path to actions\n  direction_map = {\n      (0, 1): env.action_specs()[\"RIGHT\"],\n      (1, 0): env.action_specs()[\"DOWN\"],\n      (0, -1): env.action_specs()[\"LEFT\"],\n      (-1, 0): env.action_specs()[\"UP\"]\n  }\n\n  for i in range(1, len(path_to_workshop)):\n    direction = (path_to_workshop[i][0] - path_to_workshop[i-1][0], path_to_workshop[i][1] - path_to_workshop[i-1][1])\n    if direction in direction_map:\n      actions.append(direction_map[direction])\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:09:23.308017", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.index(item)\n  \n  # Find the required workshop for crafting the item\n  recipe = env.world.cookbook.recipes[index]\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index.index(workshop_name)\n\n  actions_to_workshop = find_path_to_closest(env, workshop_index)\n  \n  # Add the USE action to craft the item at the workshop\n  actions_to_craft = [env.N_ACTIONS - 1]  \n\n  return actions_to_workshop + actions_to_craft", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:09:24.291532", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert the item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item which includes the workshop it needs to be crafted at\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Extract the workshop index from the recipe. The \"_at\" key indicates the workshop.\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the positions of all workshops in the environment\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No workshop found for the specified item.\")\n  \n  # Choose the closest workshop\n  agent_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n  \n  # Calculate the relative direction to move towards the workshop\n  x_diff = closest_workshop_pos[0] - agent_pos[0]\n  y_diff = closest_workshop_pos[1] - agent_pos[1]\n  \n  if x_diff < 0:\n    actions.append(env.world.cookbook.index[\"LEFT\"])\n  elif x_diff > 0:\n    actions.append(env.world.cookbook.index[\"RIGHT\"])\n    \n  if y_diff < 0:\n    actions.append(env.world.cookbook.index[\"UP\"])\n  elif y_diff > 0:\n    actions.append(env.world.cookbook.index[\"DOWN\"])\n  \n  # Move towards the workshop\n  for _ in range(abs(x_diff)):\n    actions.append(env.world.cookbook.index[\"LEFT\" if x_diff < 0 else \"RIGHT\"])\n    \n  for _ in range(abs(y_diff)):\n    actions.append(env.world.cookbook.index[\"UP\" if y_diff < 0 else \"DOWN\"])\n  \n  # Use action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:10:02.853942", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the indices of all workshops in the scenario\n  workshop_indices = env.scenario.world.workshop_indices\n\n  # Find the position of the correct workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = []\n  for idx, workshop_idx in enumerate(workshop_indices):\n      positions = np.argwhere(grid[:, :, workshop_idx] > 0)\n      if len(positions) > 0:\n          workshop_positions.append((idx, positions[0]))\n\n  # Filter to find the correct workshop position\n  correct_workshop_position = None\n  for idx, pos in workshop_positions:\n      if workshop_indices[idx] == workshop_index:\n          correct_workshop_position = tuple(pos)\n          break\n\n  if correct_workshop_position is None:\n      raise ValueError(\"Workshop not found in the grid\")\n\n  # Get the current position of the agent\n  current_pos = env._current_state.pos\n\n  # Calculate the path to the workshop (using a simple heuristic for demonstration)\n  actions_to_workshop = move_to(env, correct_workshop_position)\n\n  # Add the USE action to craft the item\n  actions_to_workshop.append(craft.CRAFT_FUNC(craft.parse_fexp(f\"{item}[1]\")[0]))\n\n  return actions_to_workshop", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:10:03.829189", "function_name": "craft", "function_body": "  actions = []\n\n  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine which workshop is needed (from the \"_at\" field)\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n  \n  # Find the position of the workshop\n  current_pos = env._current_state.pos\n  grid = env._current_state.grid\n\n  target_workshop_pos = None\n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if np.any(grid[x, y] == workshop_index):\n              target_workshop_pos = (x, y)\n              break\n      if target_workshop_pos:\n          break\n\n  # Calculate the direction to move towards the workshop\n  if target_workshop_pos:\n      dx = target_workshop_pos[0] - current_pos[0]\n      dy = target_workshop_pos[1] - current_pos[1]\n\n      # Convert direction differences to actions (UP, DOWN, LEFT, RIGHT)\n      directions = []\n      if dy < 0:\n          directions.extend([env.world.UP]*abs(dy))\n      elif dy > 0:\n          directions.extend([env.world.DOWN]*abs(dy))\n      if dx < 0:\n          directions.extend([env.world.LEFT]*abs(dx))\n      elif dx > 0:\n          directions.extend([env.world.RIGHT]*abs(dx))\n\n      # Move to the workshop\n      actions.extend(directions)\n      \n      # Craft the item (USE action at the workshop)\n      actions.append(env.world.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:11:20.495715", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def collect_primitives(env, primitives):\n    actions = []\n    for primitive in primitives:\n      primitive_index = env.world.cookbook.index[primitive]\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        actions.extend(get_move_actions(tuple(closest_primitive)))\n        actions.append(4)  # Collect the primitive\n    return actions\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives from the recipe\n    primitives = [key for key, value in recipe.items() if key != '_at' and value > 0]\n    \n    # Collect all required primitives\n    actions_to_take = collect_primitives(env, primitives)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 5, "scores": {"3": 3.8000002}}
{"timestamp": "2025-09-16T22:11:21.557650", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Adjust direction based on relative position to avoid unnecessary turns\n    if rel_y < 0:\n        # Move UP first if needed\n        actions_to_take.extend([0] * abs(rel_y))\n    elif rel_y > 0:\n        # Move DOWN first if needed\n        actions_to_take.extend([1] * rel_y)\n    \n    if rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n    elif rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T22:12:39.027363", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def craft_recursively(item_index, required_actions):\n      cookbook = env.world.cookbook\n      \n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n          workshop_name = recipe['_at']\n          workshop_index = cookbook.index[workshop_name]\n\n          # Collect all items required for the recipe\n          for ingredient, quantity in recipe.items():\n              if ingredient == '_at':\n                  continue\n\n              ingredient_index = cookbook.index[ingredient]\n              ingredient_count_in_inventory = env._current_state.inventory[ingredient_index]\n\n              if ingredient_count_in_inventory < quantity:\n                  required_actions.extend(craft_recursively(ingredient_index, []))\n\n          # Find the closest workshop for crafting\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n          current_pos = env._current_state.pos\n\n          if len(workshop_positions) > 0:\n              closest_workshop = min(\n                  workshop_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_workshop_pos = tuple(closest_workshop)\n\n              # Calculate move actions to reach the closest workshop\n              required_actions.extend(get_move_actions(target_workshop_pos))\n\n              # Use the USE action to craft the item at the workshop\n              required_actions.append(4)\n          else:\n              raise ValueError(f\"No workshops found for crafting {item}.\")\n      elif item_index not in env.world.cookbook.index:\n          raise ValueError(f\"Unknown item or primitive: {item}\")\n      return required_actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Craft the item recursively\n  actions_to_take = craft_recursively(item_index, [])\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:12:40.103482", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions_to_take = []\n\n    # Adjust for movement direction based on current facing direction\n    if rel_y > 0 and env._current_state.dir == 0:\n        actions_to_take.append(4)  # Turn around since we are facing UP\n    elif rel_y < 0 and env._current_state.dir == 1:\n        actions_to_take.append(4)  # Turn around since we are facing DOWN\n    elif rel_x > 0 and env._current_state.dir == 2:\n        actions_to_take.append(4)  # Turn around since we are facing LEFT\n    elif rel_x < 0 and env._current_state.dir == 3:\n        actions_to_take.append(4)  # Turn around since we are facing RIGHT\n\n    if rel_y > 0:  # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:  # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    if rel_x > 0:  # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:  # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T22:13:45.404279", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 'DOWN' if dx > 0 else 'UP'\n      else:\n          return 'RIGHT' if dy > 0 else 'LEFT'\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:13:46.512519", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 'DOWN' if dx > 0 else 'UP'\n      else:\n          return 'RIGHT' if dy > 0 else 'LEFT'\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:14:31.405852", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the target item\n  target_item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[target_item_index]\n  \n  # Extract the workshop name from the recipe\n  workshop_name = recipe[\"_at\"]\n  \n  # Get the index for the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Locate the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop for item {item} found.\")\n  \n  # Choose the first available workshop position\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Move to the workshop position\n  current_pos = env._current_state.pos\n  while current_pos != target_workshop_pos:\n    # Determine the direction needed to move towards the target workshop\n    delta_x, delta_y = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n    \n    if delta_y > 0:\n      actions.append(1)  # Move UP\n    elif delta_y < 0:\n      actions.append(0)  # Move DOWN\n    elif delta_x > 0:\n      actions.append(3)  # Move RIGHT\n    elif delta_x < 0:\n      actions.append(2)  # Move LEFT\n    \n    # Apply the action and update current position\n    reward, done, observations = env.step(actions[-1], num_steps=1)\n    current_pos = env._current_state.pos\n    \n    if done:\n      break\n  \n  # Use action to craft the item at the workshop\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:14:32.377096", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  # Determine the required workshop from the recipe\n  workshop_name = recipe.pop('_key')\n  \n  # Get the index of the workshop from the cookbook's index\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all workshop positions in the grid that match the required workshop type\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop of type {workshop_name} found on the map.\")\n  \n  # Select the first available workshop (for simplicity, we can later implement a better selection strategy)\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Calculate the path to the selected workshop\n  actions_to_reach_workshop = find_path_to(env._current_state.grid, env._current_state.pos, target_workshop_position)\n\n  # Add the action to use the workshop once we reach it (USE action)\n  actions_to_use_workshop = [craft.USE]\n  \n  # Combine all actions into a single list\n  return actions_to_reach_workshop + actions_to_use_workshop", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:16:00.700614", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_name):\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    for i in range(len(env.world.workshop_indices)):\n      if env.world.workshop_indices[i] == workshop_idx:\n        target_pos = (i // env.world.grid.shape[1], i % env.world.grid.shape[1])\n        break\n    else:\n      raise ValueError(f\"No valid position found for workshop: {workshop_name}\")\n\n    current_pos = env._current_state.pos\n    path = astar(env._current_state.grid, current_pos, target_pos)\n    actions = [direction_to_action(env, direction) for direction in path]\n    return actions\n\n  def astar(grid, start, goal):\n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n      _, current = heapq.heappop(open_set)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(came_from[current])\n          current = came_from[current]\n        path.reverse()\n        return path\n\n      for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + direction[0], current[1] + direction[1])\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    return []\n\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def direction_to_action(env, direction):\n    current_pos = env._current_state.pos\n    target_pos = tuple(np.array(current_pos) + np.array(direction))\n    if target_pos == (current_pos[0] - 1, current_pos[1]):\n      return env.action_specs()[\"UP\"]\n    elif target_pos == (current_pos[0] + 1, current_pos[1]):\n      return env.action_specs()[\"DOWN\"]\n    elif target_pos == (current_pos[0], current_pos[1] - 1):\n      return env.action_specs()[\"LEFT\"]\n    elif target_pos == (current_pos[0], current_pos[1] + 1):\n      return env.action_specs()[\"RIGHT\"]\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n\n  actions = []\n  path_to_workshop = find_nearest_workshop(workshop_name)\n  actions.extend(path_to_workshop)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:16:01.811604", "function_name": "craft", "function_body": "  def astar_pathfinding(grid, start_pos, goal_idx):\n    from queue import PriorityQueue\n    import numpy as np\n\n    # Define the possible moves (UP, RIGHT, DOWN, LEFT)\n    directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n    # Convert the start position to a tuple of indices\n    start = (start_pos[0], start_pos[1])\n\n    # Priority queue for A* algorithm\n    open_set = PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n\n    # Cost from start to each node\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        current_f, current = open_set.get()\n\n        if grid[current[0], current[1]].argmax() == goal_idx:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            return path[::-1]\n\n        for direction in directions:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                tentative_g_score = g_score[current] + 1\n\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, goal_idx)\n                    open_set.put((f_score, neighbor))\n\n    return None\n\n  def heuristic(position, goal_idx):\n    # Heuristic function for A* (Manhattan distance to the nearest cell of type goal_idx)\n    min_distance = float('inf')\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x, goal_idx] == 1:\n                min_distance = min(min_distance, abs(position[0] - y) + abs(position[1] - x))\n    return min_distance\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  goal_idx = env.world.cookbook.index[workshop_name]\n\n  # Convert direction names to action indices\n  direction_to_action = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"]\n  }\n\n  # Get the current grid and position\n  grid = env._current_state.grid\n  start_pos = env._current_state.pos\n\n  # Find the path to the nearest workshop\n  path_to_workshop = astar_pathfinding(grid, start_pos, goal_idx)\n\n  if not path_to_workshop:\n    raise ValueError(f\"No path found to workshop: {workshop_name}\")\n\n  # Convert the path of coordinates to a list of actions\n  actions = []\n  current_pos = start_pos\n  for next_pos in path_to_workshop:\n      dy, dx = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy == -1:  # Move up\n          actions.append(direction_to_action[\"UP\"])\n      elif dx == 1:  # Move right\n          actions.append(direction_to_action[\"RIGHT\"])\n      elif dy == 1:  # Move down\n          actions.append(direction_to_action[\"DOWN\"])\n      elif dx == -1:  # Move left\n          actions.append(direction_to_action[\"LEFT\"])\n      current_pos = next_pos\n\n  # Add the USE action to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:17:42.660090", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T22:17:43.727243", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T22:18:48.023862", "function_name": "craft", "function_body": "  actions = []\n  # Get the index of the target item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the workshop location for crafting this item\n  workshop_name = env.world.cookbook.recipes[item_index][\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  def find_nearest_workshop(grid, pos):\n    distances = {}\n    for y in range(grid.shape[0]):\n      for x in range(grid.shape[1]):\n        if np.any(grid[y, x] == workshop_index):\n          distance = abs(y - pos[0]) + abs(x - pos[1])\n          distances[(y, x)] = distance\n    if not distances:\n      return None\n    nearest_workshop_pos = min(distances, key=distances.get)\n    return nearest_workshop_pos\n\n  # Get the current state of the environment\n  state = env._current_state\n  \n  # Find the nearest workshop position\n  nearest_workshop_pos = find_nearest_workshop(state.grid, state.pos)\n  if not nearest_workshop_pos:\n      raise ValueError(\"No workshop found for item\")\n\n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs_shortest_path(grid, start, goal):\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      if current == goal:\n        break\n      neighbors = [(current[0] + dy, current[1] + dx) for dy, dx in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n      for neighbor in neighbors:\n        if (0 <= neighbor[0] < grid.shape[0]) and (0 <= neighbor[1] < grid.shape[1]):\n          if not any(grid[neighbor[0], neighbor[1]] & env.world.non_grabbable_indices):\n            if neighbor not in visited:\n              queue.append(neighbor)\n              visited.add(neighbor)\n              parent[neighbor] = current\n    \n    path = []\n    while goal is not None:\n      path.append(goal)\n      goal = parent[goal]\n    return path[::-1]\n\n  # Find the shortest path to the workshop\n  path_to_workshop = bfs_shortest_path(state.grid, state.pos, nearest_workshop_pos)\n  \n  # Generate actions to move along the path\n  directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # LEFT, RIGHT, UP, DOWN\n  dir_names = ['LEFT', 'RIGHT', 'UP', 'DOWN']\n  action_map = {'LEFT': env.world.cookbook.index[\"LEFT\"],\n                'RIGHT': env.world.cookbook.index[\"RIGHT\"],\n                'UP': env.world.cookbook.index[\"UP\"],\n                'DOWN': env.world.cookbook.index[\"DOWN\"]}\n  \n  for i in range(1, len(path_to_workshop)):\n    start = path_to_workshop[i - 1]\n    end = path_to_workshop[i]\n    dx = end[1] - start[1]\n    dy = end[0] - start[0]\n    move_dir = None\n    for j in range(len(directions)):\n      if (dy, dx) == directions[j]:\n        move_dir = dir_names[j]\n        break\n    if move_dir:\n      actions.append(action_map[move_dir])\n  \n  # Add the USE action to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:18:48.990392", "function_name": "craft", "function_body": "  def move_to(x, y):\n    dx = x - env._current_state.pos[0]\n    dy = y - env._current_state.pos[1]\n\n    actions = []\n    if dx > 0:\n      actions.extend([env.action_specs()[\"RIGHT\"]] * abs(dx))\n    elif dx < 0:\n      actions.extend([env.action_specs()[\"LEFT\"]] * abs(dx))\n\n    if dy > 0:\n      actions.extend([env.action_specs()[\"DOWN\"]] * abs(dy))\n    elif dy < 0:\n      actions.extend([env.action_specs()[\"UP\"]] * abs(dy))\n\n    return actions\n\n  def find_workshop(item_index):\n    # Retrieve the recipe for the item\n    recipe = env.world.cookbook.recipes[item_index]\n    \n    # The workshop is specified by \"_at\" key in the recipe\n    workshop_name = recipe[\"_key\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    # Find the position of the workshop on the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    if len(positions) == 0:\n      raise ValueError(f\"Workshop for {item} not found in the environment.\")\n      \n    return tuple(positions[0])\n\n  item_index = env.world.cookbook.index[item]\n  workshop_pos = find_workshop(item_index)\n\n  actions = move_to(workshop_pos[1], workshop_pos[0]) + [env.action_specs()[\"USE\"]]\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:19:58.355534", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the shortest path using Manhattan distance heuristics\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T22:19:59.516335", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T22:21:42.790134", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if not any(grid[neighbor][i] for i in env.world.cookbook.grab_all_index):\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  closest_workshop = min(workshop_positions, key=lambda pos: heuristic(env._current_state.pos, tuple(pos)))\n  target_pos = tuple(closest_workshop)\n\n  current_pos = env._current_state.pos\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:21:43.775444", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop and ingredients\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n  ingredients = [index[ingredient] for ingredient in recipe.keys() if ingredient != \"_at\"]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Collect ingredients if not already in inventory\n  inventory = env._current_state.inventory\n  actions_to_collect_ingredients = []\n  \n  for ingredient_index in ingredients:\n      if ingredient_index not in inventory or inventory[ingredient_index] == 0:\n          primitive_name = index.get(ingredient_index)\n          if primitive_name is None:\n              raise ValueError(f\"Unknown ingredient index: {ingredient_index}\")\n          \n          actions_to_collect_ingredients.extend(collect(env, primitive_name))\n  \n  actions.extend(actions_to_collect_ingredients)\n\n  # Calculate the path to the target workshop using A* algorithm\n  path_to_workshop = a_star(current_pos, target_workshop_pos)\n\n  if not path_to_workshop:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  for i in range(len(path_to_workshop) - 1):\n      next_pos = path_to_workshop[i + 1]\n      delta_x = next_pos[0] - path_to_workshop[i][0]\n      delta_y = next_pos[1] - path_to_workshop[i][1]\n\n      if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif delta_x > 0:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n      else:\n          actions.append(env.action_specs()[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:22:50.074690", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n      return 'DOWN' if dx > 0 else 'UP'\n    else:\n      return 'RIGHT' if dy > 0 else 'LEFT'\n\n  def move_to(env, target_pos):\n    actions = []\n    dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n    current_pos = env._current_state.pos\n\n    while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      if direction is not None:\n        actions.append(dir_map[direction])\n        # Simulate the move to update current_pos\n        if direction == 'DOWN':\n          current_pos = (current_pos[0] + 1, current_pos[1])\n        elif direction == 'UP':\n          current_pos = (current_pos[0] - 1, current_pos[1])\n        elif direction == 'RIGHT':\n          current_pos = (current_pos[0], current_pos[1] + 1)\n        elif direction == 'LEFT':\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  \n  # Calculate actions needed to move to the target position\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:22:51.199132", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T22:24:39.051874", "function_name": "craft", "function_body": "  def astar_pathfinding(grid, start_pos, goal_idx):\n    from queue import PriorityQueue\n\n    # Define the possible moves (UP, RIGHT, DOWN, LEFT)\n    directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n    # Convert the start position to a tuple of indices\n    start = (start_pos[0], start_pos[1])\n\n    # Priority queue for A* algorithm\n    open_set = PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n\n    # Cost from start to each node\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        current_f, current = open_set.get()\n\n        if grid[current[0], current[1]].argmax() == goal_idx:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            return path[::-1]\n\n        for direction in directions:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                tentative_g_score = g_score[current] + 1\n\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, goal_idx)\n                    open_set.put((f_score, neighbor))\n\n    return None\n\n  def heuristic(position, grid, goal_idx):\n    # Heuristic function for A* (Manhattan distance to the nearest cell of type goal_idx)\n    min_distance = float('inf')\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x, goal_idx] == 1:\n                min_distance = min(min_distance, abs(position[0] - y) + abs(position[1] - x))\n    return min_distance\n\n  # Get the item index and recipe\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  goal_idx = env.world.cookbook.index[workshop_name]\n\n  # Convert direction names to action indices\n  direction_to_action = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"]\n  }\n\n  # Get the current grid and position\n  grid = env._current_state.grid\n  start_pos = env._current_state.pos\n\n  # Find the path to the nearest workshop\n  path_to_workshop = astar_pathfinding(grid, start_pos, goal_idx)\n\n  if not path_to_workshop:\n    raise ValueError(f\"No path found to workshop: {workshop_name}\")\n\n  # Convert the path of coordinates to a list of actions\n  actions = []\n  current_pos = start_pos\n  for next_pos in path_to_workshop:\n      dy, dx = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy == -1:  # Move up\n          actions.append(direction_to_action[\"UP\"])\n      elif dx == 1:  # Move right\n          actions.append(direction_to_action[\"RIGHT\"])\n      elif dy == 1:  # Move down\n          actions.append(direction_to_action[\"DOWN\"])\n      elif dx == -1:  # Move left\n          actions.append(direction_to_action[\"LEFT\"])\n      current_pos = next_pos\n\n  # Add the USE action to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:24:40.146292", "function_name": "craft", "function_body": "  def astar_pathfinding(grid, start_pos, goal_idx):\n    from queue import PriorityQueue\n\n    # Define the possible moves (UP, RIGHT, DOWN, LEFT)\n    directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]\n\n    # Convert the start position to a tuple of indices\n    start = (start_pos[0], start_pos[1])\n\n    # Priority queue for A* algorithm\n    open_set = PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n\n    # Cost from start to each node\n    g_score = {start: 0}\n\n    while not open_set.empty():\n        current_f, current = open_set.get()\n\n        if grid[current[0], current[1]].argmax() == goal_idx:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            return path[::-1]\n\n        for direction in directions:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n\n            if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                tentative_g_score = g_score[current] + 1\n\n                if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                    came_from[neighbor] = current\n                    g_score[neighbor] = tentative_g_score\n                    f_score = tentative_g_score + heuristic(neighbor, grid, goal_idx)\n                    open_set.put((f_score, neighbor))\n\n    return None\n\n  def heuristic(position, grid, goal_idx):\n    # Heuristic function for A* (Manhattan distance to the nearest cell of type goal_idx)\n    min_distance = float('inf')\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x].argmax() == goal_idx:\n                min_distance = min(min_distance, abs(position[0] - y) + abs(position[1] - x))\n    return min_distance\n\n  def find_workshop_position(grid, workshop_idx):\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x].argmax() == workshop_idx:\n                return (y, x)\n    raise ValueError(\"Workshop not found on the grid.\")\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  goal_idx = env.world.cookbook.index[workshop_name]\n\n  # Convert direction names to action indices\n  direction_to_action = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"]\n  }\n\n  # Get the current grid and position\n  grid = env._current_state.grid\n  start_pos = env._current_state.pos\n\n  # Find the nearest workshop position directly using the heuristic\n  nearest_workshop_position = find_workshop_position(grid, goal_idx)\n\n  # Find the path to the nearest workshop\n  path_to_workshop = astar_pathfinding(grid, start_pos, goal_idx)\n\n  if not path_to_workshop:\n    raise ValueError(f\"No path found to workshop: {workshop_name}\")\n\n  # Convert the path of coordinates to a list of actions\n  actions = []\n  current_pos = start_pos\n  for next_pos in path_to_workshop:\n      dy, dx = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy == -1:  # Move up\n          actions.append(direction_to_action[\"UP\"])\n      elif dx == 1:  # Move right\n          actions.append(direction_to_action[\"RIGHT\"])\n      elif dy == 1:  # Move down\n          actions.append(direction_to_action[\"DOWN\"])\n      elif dx == -1:  # Move left\n          actions.append(direction_to_action[\"LEFT\"])\n      current_pos = next_pos\n\n  # Add the USE action to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:25:24.615084", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop required for crafting this item from the recipe\n  recipe = env._current_state.world.cookbook.recipes[item_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  target_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[y, x, :] == workshop_idx):\n              target_pos = (x, y)\n              break\n      if target_pos is not None:\n          break\n\n  # Calculate the actions needed to move from current position to the workshop\n  actions_to_workshop = []\n  current_x, current_y = env._current_state.pos\n  while current_x != target_pos[0] or current_y != target_pos[1]:\n      if current_x < target_pos[0]:\n          actions_to_workshop.append(craft.RIGHT)\n          current_x += 1\n      elif current_x > target_pos[0]:\n          actions_to_workshop.append(craft.LEFT)\n          current_x -= 1\n      elif current_y < target_pos[1]:\n          actions_to_workshop.append(craft.DOWN)\n          current_y += 1\n      else:\n          actions_to_workshop.append(craft.UP)\n          current_y -= 1\n\n  # After reaching the workshop, perform the USE action to craft the item\n  actions_to_workshop.append(craft.USE)\n\n  return actions_to_workshop", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:25:25.677751", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop name from the recipe\n  workshop_name = recipe.pop('_at')\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:,:,workshop_index] == 1)\n  \n  if not workshop_positions.size:\n    raise ValueError(f\"No {workshop_name} found on the map.\")\n  \n  # Assuming we will go to the first one we find, but a better strategy could be implemented\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the difference in position from the agent's current position to the workshop\n  diff_x = target_workshop_pos[1] - env._current_state.pos[1]\n  diff_y = target_workshop_pos[0] - env._current_state.pos[0]\n\n  # Move horizontally towards the workshop\n  if diff_x > 0:\n    actions.extend([2]*diff_x)  # LEFT\n  elif diff_x < 0:\n    actions.extend([3]*abs(diff_x))  # RIGHT\n\n  # Move vertically towards the workshop\n  if diff_y > 0:\n    actions.extend([1]*diff_y)  # UP\n  elif diff_y < 0:\n    actions.extend([0]*abs(diff_y))  # DOWN\n  \n  # Perform the USE action to craft the item\n  actions.append(4)\n  \n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:26:29.954712", "function_name": "craft", "function_body": "  # Get the index of the target item\n  target_item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[target_item_index]\n\n  # Find the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Get the agent's current position and direction\n  pos = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find the positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  # Determine the closest workshop to the agent's current position\n  distances = [np.linalg.norm(np.array(pos) - wp, ord=2) for wp in workshop_positions]\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the direction vector from the agent to the closest workshop\n  direction_vector = (closest_workshop_pos[0] - pos[0], closest_workshop_pos[1] - pos[1])\n\n  # Determine the sequence of actions needed to move towards the closest workshop\n  actions = []\n  while direction_vector != (0, 0):\n    if direction_vector[0] < 0:\n      actions.append(env.world.N_ACTIONS[\"UP\"])\n      direction_vector = (direction_vector[0] + 1, direction_vector[1])\n    elif direction_vector[0] > 0:\n      actions.append(env.world.N_ACTIONS[\"DOWN\"])\n      direction_vector = (direction_vector[0] - 1, direction_vector[1])\n    if direction_vector[1] < 0:\n      actions.append(env.world.N_ACTIONS[\"LEFT\"])\n      direction_vector = (direction_vector[0], direction_vector[1] + 1)\n    elif direction_vector[1] > 0:\n      actions.append(env.world.N_ACTIONS[\"RIGHT\"])\n      direction_vector = (direction_vector[0], direction_vector[1] - 1)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(env.world.N_ACTIONS[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:26:31.023312", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item\n  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny, i_item] == 0:\n                      queue.append((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:27:17.979926", "function_name": "craft", "function_body": "  def get_next_action_bfs(start, goal, grid):\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      action_map = {(0, 1): 3, (0, -1): 2, (1, 0): 1, (-1, 0): 0}\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if (x, y) == goal:\n              return path\n\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny].sum() == 0 and (nx, ny) not in visited:\n                  queue.append(((nx, ny), path + [action_map[(dx, dy)]]))\n                  visited.add((nx, ny))\n\n      return []\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action_bfs(current_pos, target_workshop_pos, env._current_state.grid)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:27:19.043872", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T22:28:44.402377", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  def get_required_primitives(item, cookbook):\n      required_items = []\n      if item in cookbook.recipes:\n          recipe = cookbook.recipes[item]\n          for key, value in recipe.items():\n              if key != '_at' and value > 0:\n                  required_items.append(key)\n      return required_items\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Step 1: Collect all required primitives that are not already in the inventory\n  current_inventory = env._current_state.inventory\n  required_primitives = get_required_primitives(item, cookbook)\n\n  actions_to_collect = []\n  for primitive_name in required_primitives:\n      if primitive_name != '_at' and current_inventory[cookbook.index[primitive_name]] == 0:\n          # Find positions of the primitive in the grid\n          primitive_index = cookbook.index[primitive_name]\n          grid = env._current_state.grid\n          primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"No {primitive_name} found in the environment\")\n          \n          # Choose the closest position to collect from\n          current_pos = env._current_state.pos\n          closest_primitive_pos = min(primitive_positions, key=lambda x: abs(x[0] - current_pos[0]) + abs(x[1] - current_pos[1]))\n          \n          actions_to_collect.extend(move_to_position(current_pos, tuple(closest_primitive_pos)))\n          actions_to_collect.append(4)  # Collect action\n          \n          # Update the current position after collecting\n          env._current_state.pos = tuple(closest_primitive_pos)\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  recipe = cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n\n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_collect + actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T22:28:45.547385", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 'DOWN' if dx > 0 else 'UP'\n      elif abs(dx) < abs(dy):\n          return 'RIGHT' if dy > 0 else 'LEFT'\n      else:\n          # Equal distance, decide randomly or based on another strategy\n          return 'DOWN' if dx > 0 else ('UP' if dx < 0 else ('RIGHT' if dy > 0 else 'LEFT'))\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:29:21.780571", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n  recipe = cookbook.recipes[index[item]]\n  workshop_name = recipe[\"_key\"]\n  workshop_index = index[workshop_name]\n\n  # Find the nearest workshop with the required name\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  workshop_indices = [i for i in range(len(grid)) if np.any(grid[i] == workshop_index)]\n\n  min_distance = float('inf')\n  closest_workshop = None\n  for w_pos in workshop_indices:\n      distance = abs(w_pos[0] - pos[0]) + abs(w_pos[1] - pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop = w_pos\n\n  actions = []\n  # Move to the nearest workshop\n  while env._current_state.pos != closest_workshop:\n      current_x, current_y = env._current_state.pos\n      target_x, target_y = closest_workshop\n\n      if target_x > current_x:\n          actions.append(craft.RIGHT)\n      elif target_x < current_x:\n          actions.append(craft.LEFT)\n\n      if target_y > current_y:\n          actions.append(craft.DOWN)\n      elif target_y < current_y:\n          actions.append(craft.UP)\n\n  # Use the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:29:22.768326", "function_name": "craft", "function_body": "  # Get the cookbook and index\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  \n  # Find the recipe for the desired item\n  item_index = index[item]\n  if item_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  recipe = cookbook.recipes[item_index]\n  \n  # Extract the workshop where the item should be crafted\n  workshop_name = recipe['_at']\n  workshop_index = index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  if len(positions) == 0:\n    raise ValueError(f\"No {workshop_name} found in the environment\")\n    \n  nearest_workshop_pos = min(positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  # Generate actions to move to the workshop\n  current_pos = env._current_state.pos\n  actions_to_move = pathfinding(current_pos, nearest_workshop_pos, grid)\n  \n  # Add USE action to perform crafting\n  actions_to_craft = [craft.USE]\n  \n  return actions_to_move + actions_to_craft", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:31:03.218009", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  def collect_primitives(primitives):\n    action_list = []\n    for primitive in primitives:\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      if primitive_index in cookbook.recipes:\n        raise ValueError(f\"{primitive} is not a primitive, it can be crafted.\")\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          action_list.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the primitive\n          action_list.append(4)\n      else:\n          raise ValueError(f\"No primitives found for {primitive}.\")\n    return action_list\n\n  def get_required_primitives(item_index):\n    recipe = cookbook.recipes[item_index]\n    required_primitives = []\n    for ingredient, count in recipe.items():\n        if ingredient != '_at':\n            primitive_name = cookbook.index[ingredient]\n            required_primitives.append(primitive_name)\n    return required_primitives\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the required primitives to craft the item\n    primitives = get_required_primitives(item_index)\n\n    # Collect all required primitives\n    actions_to_take = collect_primitives(primitives)\n\n    # Get the workshop index and positions\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n      # Choose the closest available workshop position to craft the item at\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 5, "scores": {"3": 3.8000002}}
{"timestamp": "2025-09-16T22:31:04.267319", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_ingredients(env, recipe):\n    actions = []\n    inventory = env._current_state.inventory\n    cookbook = env.world.cookbook\n\n    for ingredient, quantity in recipe.items():\n      if ingredient == '_at':  # Skip the workshop information\n        continue\n      \n      ingredient_index = cookbook.index[ingredient]\n      \n      # Check how many of this ingredient we need and have in inventory\n      needed_quantity = quantity\n      current_quantity = inventory[ingredient_index]\n      \n      if current_quantity < needed_quantity:\n        needed_more = needed_quantity - current_quantity\n\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n\n        while needed_more > 0 and len(primitive_positions) > 0:\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the primitive\n          actions.append(4)\n          \n          needed_more -= 1\n\n    return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather all required ingredients first\n    actions_to_take = gather_ingredients(env, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:31:46.668806", "function_name": "craft", "function_body": "  # Retrieve the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item which includes the workshop where it should be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Extract the workshop index from the recipe\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops in the grid\n  workshops_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # If no workshops are found, raise an error\n  if len(workshops_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Get the current position of the agent\n  current_pos = env._current_state.pos\n\n  # Calculate distances to all workshops and find the nearest one\n  distances = np.linalg.norm(current_pos - workshops_positions, axis=1)\n  nearest_workshop_index = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshops_positions[nearest_workshop_index])\n  \n  # Generate actions to move the agent to the nearest workshop\n  actions_to_workshop = generate_move_actions(env._current_state.pos, nearest_workshop_pos, env._current_state.dir)\n\n  # Add the USE action to craft the item at the workshop\n  use_action = craft.USE\n\n  return actions_to_workshop + [use_action]", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:31:47.749261", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item from the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe details for the item to know which workshop is required.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the required workshop.\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  actions = []\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop for the item not found in the environment.\")\n\n  # We'll just take the first available position of the workshop.\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Calculate the direction needed to move towards the target position.\n  delta_x, delta_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n  \n  while not (delta_x == 0 and delta_y == 0):\n    if delta_x < 0:\n      actions.append(env.action_specs()[\"LEFT\"])\n      delta_x += 1\n    elif delta_x > 0:\n      actions.append(env.action_specs()[\"RIGHT\"])\n      delta_x -= 1\n    elif delta_y < 0:\n      actions.append(env.action_specs()[\"DOWN\"])\n      delta_y += 1\n    elif delta_y > 0:\n      actions.append(env.action_specs()[\"UP\"])\n      delta_y -= 1\n  \n  # Once at the target position, perform the USE action to craft the item.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:32:46.742269", "function_name": "craft", "function_body": "  def get_directional_action(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      elif dy < 0:\n          return 0  # DOWN\n\n  def get_path_to_workshop(current_pos, target_workshop_pos):\n      path = []\n      current_x, current_y = current_pos\n      target_x, target_y = target_workshop_pos\n\n      while current_x != target_x or current_y != target_y:\n          dx = target_x - current_x\n          dy = target_y - current_y\n\n          if abs(dx) > abs(dy):\n              action = get_directional_action(dx, 0)\n              current_x += (1 if action == 3 else -1) if dx != 0 else 0\n          else:\n              action = get_directional_action(0, dy)\n              current_y += (1 if action == 1 else -1) if dy != 0 else 0\n\n          path.append(action)\n\n      return path\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  path_to_workshop = get_path_to_workshop(current_pos, target_workshop_pos)\n\n  actions = path_to_workshop + [4]  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T22:32:47.805123", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      \"\"\"Find the closest workshop to the current position.\"\"\"\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Get the workshop name and index from the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Determine the closest workshop to move towards\n  current_pos = env._current_state.pos\n  target_workshop_pos = find_closest_workshop(workshop_positions, current_pos)\n\n  # Generate actions to move towards the workshop\n  actions_to_reach_workshop = move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n\n  # Add USE action to craft the item at the workshop\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T22:33:51.959396", "function_name": "craft", "function_body": "  # Step 1: Find the workshop index required for crafting the item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe[\"_key\"]\n  workshop_indices = [idx for idx, name in enumerate(cookbook.kinds) if \"workshop\" in name]\n\n  # Find the index of the required workshop\n  required_workshop_index = None\n  for idx in workshop_indices:\n      kind_name = cookbook.index.get(idx)\n      if kind_name and workshop_name in kind_name:\n          required_workshop_index = idx\n          break\n\n  if required_workshop_index is None:\n      raise ValueError(f\"No matching workshop found for {item}\")\n\n  # Step 2: Move to the nearest instance of the required workshop in the environment grid\n  actions_to_take = []\n  current_pos = env._current_state.pos\n  direction = env._current_state.dir\n\n  # Implement a simple pathfinding algorithm (e.g., BFS) to find the shortest path to the workshop\n  def bfs_find_workshop(grid, start, target):\n      from collections import deque\n      queue = deque([(start, [])])\n      visited = set()\n      while queue:\n          (x, y), path = queue.popleft()\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          if grid[x, y, target] == 1:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  # Find the shortest path to any workshop of the required type\n  target_workshop_positions = []\n  for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n          if grid[i, j, required_workshop_index] == 1:\n              target_workshop_positions.append((i, j))\n\n  shortest_path = None\n  for pos in target_workshop_positions:\n      path = bfs_find_workshop(env._current_state.grid, current_pos, required_workshop_index)\n      if not shortest_path or len(path) < len(shortest_path):\n          shortest_path = path\n\n  if shortest_path is None:\n      raise ValueError(f\"No path found to the {item} workshop\")\n\n  # Convert path to actions\n  action_map = {(-1, 0): craft.MOVE_FUNC(craft.DOWN), (1, 0): craft.MOVE_FUNC(craft.UP),\n                (0, -1): craft.MOVE_FUNC(craft.LEFT), (0, 1): craft.MOVE_FUNC(craft.RIGHT)}\n  for dx, dy in shortest_path:\n      actions_to_take.append(action_map[(dx, dy)])\n\n  # Step 3: Craft the item at the workshop\n  actions_to_take.append(craft.USE_FUNC())\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:33:52.926606", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n  # Find the workshop required for crafting the item\n  item_index = index[item]\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n    raise ValueError(f\"Workshop not specified in recipe for {item}\")\n\n  workshop_index = index[workshop_name]\n  \n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  grid = env._current_state.grid\n  for y, row in enumerate(grid):\n      for x, kind_vec in enumerate(row):\n          if np.argmax(kind_vec) == workshop_index:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n\n  if workshop_pos is None:\n    raise ValueError(f\"Workshop {workshop_name} not found in the grid\")\n\n  # Calculate the relative direction to the workshop\n  agent_pos = env._current_state.pos\n  x_diff, y_diff = workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1]\n  \n  actions = []\n  \n  # Move towards the workshop\n  while x_diff != 0 or y_diff != 0:\n      if x_diff < 0:\n          actions.append(env.world.N_ACTIONS.LEFT)\n          x_diff += 1\n      elif x_diff > 0:\n          actions.append(env.world.N_ACTIONS.RIGHT)\n          x_diff -= 1\n      elif y_diff < 0:\n          actions.append(env.world.N_ACTIONS.UP)\n          y_diff += 1\n      elif y_diff > 0:\n          actions.append(env.world.N_ACTIONS.DOWN)\n          y_diff -= 1\n  \n  # Craft the item at the workshop\n  actions.append(env.world.N_ACTIONS.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:35:06.839212", "function_name": "craft", "function_body": "  def get_next_move(current_pos, target_pos):\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n\n    if abs(delta_x) > abs(delta_y):\n        return RIGHT if delta_x > 0 else LEFT\n    else:\n        return DOWN if delta_y > 0 else UP\n\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshops found for {item}.\")\n  \n  target_workshop_position = tuple(workshop_positions[0])\n  \n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n\n  actions = []\n  \n  while current_pos != target_workshop_position:\n      next_move = get_next_move(current_pos, target_workshop_position)\n      if next_move == RIGHT and current_dir != RIGHT:\n          actions.append(RIGHT)\n          current_dir = RIGHT\n      elif next_move == LEFT and current_dir != LEFT:\n          actions.append(LEFT)\n          current_dir = LEFT\n      elif next_move == DOWN and current_dir != DOWN:\n          actions.append(DOWN)\n          current_dir = DOWN\n      elif next_move == UP and current_dir != UP:\n          actions.append(UP)\n          current_dir = UP\n      \n      # Move in the correct direction\n      if (next_move == RIGHT and current_pos[0] < target_workshop_position[0]) or\\\n         (next_move == LEFT and current_pos[0] > target_workshop_position[0]):\n          actions.append(RIGHT if next_move == RIGHT else LEFT)\n          current_pos = (current_pos[0] + 1, current_pos[1]) if next_move == RIGHT else (current_pos[0] - 1, current_pos[1])\n      elif (next_move == DOWN and current_pos[1] < target_workshop_position[1]) or\\\n           (next_move == UP and current_pos[1] > target_workshop_position[1]):\n          actions.append(DOWN if next_move == DOWN else UP)\n          current_pos = (current_pos[0], current_pos[1] + 1) if next_move == DOWN else (current_pos[0], current_pos[1] - 1)\n\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
