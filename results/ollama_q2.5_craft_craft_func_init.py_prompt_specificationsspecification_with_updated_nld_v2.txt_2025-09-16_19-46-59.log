       primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Update inventory after gathering required items\n    update_inventory_after_actions(env, actions_to_take)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T15:07:45.412935", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n            \n    # Then move vertically\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      if not has_primitive_in_inventory(env._current_state, primitive):\n                          actions.extend(collect(env, primitive))\n                      \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def has_primitive_in_inventory(state, primitive):\n      \"\"\"Check if the agent has the required primitive in its inventory.\"\"\"\n      cookbook = env.world.cookbook\n      primitive_index = cookbook.index[primitive]\n      return state.inventory[primitive_index] > 0\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Update inventory after gathering required items\n    update_inventory_after_actions(env, actions_to_take)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:09:27.725510", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def find_workshop(item):\n      goal_index = env.world.cookbook.index[item]\n      workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find the position of the workshop in the grid\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      return positions\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:  # Assuming 0 is walkable\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = find_workshop(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0])  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n\n  actions.append(4)  # Craft the item (USE)\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T15:09:28.851909", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def find_workshop(item):\n      goal_index = env.world.cookbook.index[item]\n      workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find the position of the workshop in the grid\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      return positions\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid, obstacles):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if (0 <= neighbor[0] < grid.shape[0] and \n                  0 <= neighbor[1] < grid.shape[1] and\n                  neighbor not in obstacles):\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = find_workshop(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  obstacles = set()\n  for i in range(1, env._current_state.grid.shape[2]):\n      obstacle_positions = np.argwhere(env._current_state.grid[:, :, i] == 1)\n      obstacles.update(map(tuple, obstacle_positions))\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0], obstacles)  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n      actions.append(4)  # USE (to avoid getting stuck)\n\n  actions.append(4)  # Craft the item\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-17T15:11:17.393782", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n        \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def craft_item(env, workshop_index):\n    target_workshop_pos = get_closest_workshop(env, workshop_index)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T15:11:18.454715", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_indices):\n    current_pos = env._current_state.pos\n    closest_workshop_info = None\n    closest_distance = float('inf')\n\n    for workshop_index in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n        for pos in workshop_positions:\n          distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          if distance < closest_distance:\n            closest_distance = distance\n            closest_workshop_info = (workshop_index, tuple(pos))\n    \n    if closest_workshop_info is not None:\n      return closest_workshop_info\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshops from the original recipe (assuming '_at' can be a list)\n    workshop_names = recipe['_at']\n    workshop_indices = [cookbook.index[name] for name in workshop_names]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        target_workshop_index, target_workshop_pos = get_closest_workshop(env, workshop_indices)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 4.0}}
{"timestamp": "2025-09-17T15:12:17.188021", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n\n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop\n  actions.extend(move_to(target_x, target_y))\n\n  # Final USE to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T15:12:18.261853", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while (current_x != x) or (current_y != y):\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n          \n          # Use USE action once we reach the next cell in the direction we're moving\n          actions.append(4)  # USE\n\n      return actions\n  \n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(move_towards(target_x, target_y))\n  \n  # Final USE to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.8999996}}
{"timestamp": "2025-09-17T15:13:10.612097", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T15:13:11.676434", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T15:15:12.056232", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def craft_item(env, workshop_name):\n    nonlocal actions_to_take\n    \n    # Find the index of the desired workshop\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n\n    if target_workshop_pos:\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    \n    return workshop_index\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    actions_to_take = []\n    \n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = craft_item(env, workshop_name)\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.8999996}}
{"timestamp": "2025-09-17T15:15:13.034538", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    missing_primitives = []\n    \n    for primitive_index, count in recipe.items():\n      if primitive_index not in env._current_state.inventory or env._current_state.inventory[primitive_index] < count:\n        missing_primitives.append(cookbook.index.get_primitive_name(primitive_index))\n    \n    return missing_primitives\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    actions_to_take = []\n    \n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Check if all required primitives are in inventory\n    missing_primitives = check_inventory(env, recipe)\n    \n    if missing_primitives:\n      raise ValueError(f\"Missing primitives for crafting {item}: {', '.join(missing_primitives)}\")\n\n    # Collect primitives required for crafting (already collected as per the assumption)\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:16:48.195264", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:  # Assuming 0 is walkable\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  def find_nearest_workshop(current_pos, workshop_positions):\n      return min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = find_nearest_workshop((current_x, current_y), workshop_positions)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0])  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n      actions.append(4)  # USE (to avoid getting stuck)\n\n  actions.append(4)  # Craft the item\n\n  return actions", "island_id": 8, "scores": {"3": 5.9}}
{"timestamp": "2025-09-17T15:16:49.254273", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop using A* pathfinding for better efficiency\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:  # Assuming 0 is walkable\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0])  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n\n  actions.append(4)  # Craft the item (use the USE action)\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T15:18:58.930239", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def craft(env, item_index, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    actions_to_take = []\n\n    # Gather required items before crafting\n    actions_to_take.extend(gather_required_items(env, cookbook, cookbook.recipes[item_index]))\n\n    # Craft the item at the appropriate workshop\n    actions_to_take.extend(craft(env, item_index, cookbook.recipes[item_index]['_at']))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T15:18:59.901620", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def check_inventory_and_gather(env, cookbook, recipe):\n    actions = []\n    required_items = {key: value for key, value in recipe.items() if key != '_at'}\n    missing_items = {item: count for item, count in required_items.items() if env._current_state.inventory[item] < count}\n\n    while missing_items:\n        for item_index, required_count in missing_items.items():\n            # Determine the primitive(s) needed to make this item\n            primitives_needed = get_primitives_for_item(cookbook, item_index)\n            for primitive in primitives_needed:\n                actions.extend(collect(env, cookbook.index.get_name(primitive)))\n        \n        # Recalculate missing items after attempting to gather them\n        missing_items = {item: count for item, count in required_items.items() if env._current_state.inventory[item] < count}\n\n    return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = check_inventory_and_gather(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:20:27.190399", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start_x, start_y, target_x, target_y):\n      actions = []\n      path = collections.deque()\n\n      while (start_x != target_x) or (start_y != target_y):\n          if start_x < target_x:\n              path.append(3)  # RIGHT\n              start_x += 1\n          elif start_x > target_x:\n              path.append(2)  # LEFT\n              start_x -= 1\n\n          if start_y < target_y:\n              path.append(1)  # UP\n              start_y += 1\n          elif start_y > target_y:\n              path.append(0)  # DOWN\n              start_y -= 1\n\n      return actions, path\n\n  def is_item_in_inventory(item):\n    item_index = env.world.cookbook.index[item]\n    return env._current_state.inventory[item_index] > 0\n\n  def collect_primitives(env, primitives):\n      \"\"\"Collect all required primitives.\"\"\"\n      actions = []\n      for primitive in primitives:\n          if not is_item_in_inventory(primitive):\n              positions = np.argwhere(env._current_state.grid[:, :, env.world.cookbook.index[primitive]] == 1)\n              closest_primitive_pos = min(\n                  positions,\n                  key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              )\n              actions.extend(calculate_path(env._current_state.pos[0], env._current_state.pos[1], closest_primitive_pos[0], closest_primitive_pos[1])[0])\n              actions.append(4)  # USE to collect the primitive\n      return actions\n\n  def get_required_primitives(item):\n    goal_index = env.world.cookbook.index[item]\n    recipe = env.world.cookbook.recipes[goal_index]\n    required_primitives = [key for key in recipe if key != \"_at\"]\n    return required_primitives\n\n  actions = []\n  \n  # Check and collect all required primitives\n  required_primitives = get_required_primitives(item)\n  actions.extend(collect_primitives(env, required_primitives))\n\n  if is_item_in_inventory(item):\n      print(f\"{item} already in inventory.\")\n      return []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  actions_to_reach_workshop, path = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(actions_to_reach_workshop)\n\n  # Move to the workshop\n  while path:\n      action = path.popleft()\n      actions.append(action)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:20:28.156161", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start_x, start_y, target_x, target_y):\n      actions = []\n      path = collections.deque()\n\n      while (start_x != target_x) or (start_y != target_y):\n          if start_x < target_x:\n              path.append(3)  # RIGHT\n              start_x += 1\n          elif start_x > target_x:\n              path.append(2)  # LEFT\n              start_x -= 1\n\n          if start_y < target_y:\n              path.append(1)  # UP\n              start_y += 1\n          elif start_y > target_y:\n              path.append(0)  # DOWN\n              start_y -= 1\n\n      return actions, path\n\n  def is_item_in_inventory(item):\n    item_index = env.world.cookbook.index[item]\n    return env._current_state.inventory[item_index] > 0\n\n  def get_required_primitives(item):\n    goal_index = env.world.cookbook.index[item]\n    return {env.world.cookbook.index[p]: q for p, q in env.world.cookbook.recipes[goal_index].items() if isinstance(p, str)}\n\n  actions = []\n\n  # Check if the item is already in inventory\n  if is_item_in_inventory(item):\n      print(f\"{item} already in inventory.\")\n      return []\n  \n  required_primitives = get_required_primitives(item)\n\n  for primitive, quantity in required_primitives.items():\n    while env._current_state.inventory[primitive] < quantity:\n      actions.extend(collect(env, primitive))\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  actions_to_reach_workshop, path = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(actions_to_reach_workshop)\n\n  # Move to the workshop\n  while path:\n      action = path.popleft()\n      actions.append(action)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:22:20.090099", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory.copy()\n    \n    actions_to_take = []\n    \n    if inventory[item_index] > 0:\n      return []\n\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n\n      # Attempt to find positions of the specified primitive.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive.\n\n        inventory[primitive_index] += required_amount\n      else:\n        # If primitives are not directly available, attempt to craft them.\n        if primitive_index in cookbook.recipes:\n          sub_actions = craft_item(env, primitive_index)\n          actions_to_take.extend(sub_actions)\n\n          # Update inventory based on the crafted items (assuming each USE action crafts one unit of the item).\n          crafted_items = collections.defaultdict(int)\n          for i, amount in recipe.items():\n            if i != '_at':\n              crafted_items[i] += sub_actions.count(4) * amount\n\n          inventory.update(crafted_items)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      \n      # Update missing items\n      missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Craft the item.\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory, potentially by crafting them.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 4.6}}
