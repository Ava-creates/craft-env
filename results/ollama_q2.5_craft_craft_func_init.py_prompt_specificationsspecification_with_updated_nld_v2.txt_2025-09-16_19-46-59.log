(current_pos[0], current_pos[1] + 1)\n      elif (next_move == UP and current_pos[1] > target_workshop_position[1]):\n          actions.append(UP)\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:36:18.675872", "function_name": "craft", "function_body": "  def move_towards(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Determine the direction to turn first if needed\n      if delta_x != 0:\n          target_direction = RIGHT if delta_x > 0 else LEFT\n      elif delta_y != 0:\n          target_direction = DOWN if delta_y > 0 else UP\n\n      # Turn towards the correct direction first\n      current_dir = env._current_state.dir\n      if target_direction == UP and current_dir not in [UP, DOWN]:\n          actions.append(UP)\n      elif target_direction == DOWN and current_dir not in [UP, DOWN]:\n          actions.append(DOWN)\n      elif target_direction == LEFT and current_dir != LEFT:\n          actions.append(LEFT)\n      elif target_direction == RIGHT and current_dir != RIGHT:\n          actions.append(RIGHT)\n\n      # Move horizontally\n      if delta_x > 0:\n          actions.extend([RIGHT]*delta_x)  # move right\n      elif delta_x < 0:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      # Move vertically\n      if delta_y > 0:\n          actions.extend([DOWN]*delta_y)  # move down\n      elif delta_y < 0:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(move_towards(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:41:19.806534", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n      delta_x = target_pos[0] - env._current_state.pos[0]\n      delta_y = target_pos[1] - env._current_state.pos[1]\n\n      actions = []\n      \n      # Adjust direction and move horizontally\n      if delta_x > 0:\n          while env._current_state.dir != RIGHT:\n              actions.append(RIGHT)\n          actions.extend([RIGHT]*delta_x)  # Move right\n      elif delta_x < 0:\n          while env._current_state.dir != LEFT:\n              actions.append(LEFT)\n          actions.extend([LEFT]*abs(delta_x))   # Move left\n      \n      # Adjust direction and move vertically\n      if delta_y > 0:\n          while env._current_state.dir != DOWN:\n              actions.append(DOWN)\n          actions.extend([DOWN]*delta_y)  # Move down\n      elif delta_y < 0:\n          while env._current_state.dir != UP:\n              actions.append(UP)\n          actions.extend([UP]*abs(delta_y))    # Move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshops found for item: {item}\")\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(move_towards(target_workshop_position))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:42:31.382538", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_towards(env, current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              action = dir_map[direction]\n              actions.append(action)\n              \n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions = move_towards(env, current_pos, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T22:42:32.499226", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_towards(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions = move_towards(current_pos, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T22:43:40.364672", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Determine direction to move in the x-axis\n      if delta_x > 0:\n          actions.extend([RIGHT]*delta_x)  # move right\n      else:\n          actions.extend([LEFT]*-delta_x)   # move left\n      \n      # Determine direction to move in the y-axis\n      if delta_y < 0:\n          actions.append(UP)  # change direction to up\n      elif delta_y > 0:\n          actions.append(DOWN)  # change direction to down\n\n      # Move along the y-axis after aligning with x-axis\n      if delta_y > 0:\n          actions.extend([DOWN]*delta_y)  # move down\n      else:\n          actions.extend([UP]*-delta_y)    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:43:41.488815", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos, current_pos, current_dir):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Adjust direction if needed\n      if delta_y < 0 and current_dir != UP:\n          actions.append(UP)\n      elif delta_y > 0 and current_dir != DOWN:\n          actions.append(DOWN)\n      \n      # Move horizontally\n      if delta_x > 0:\n          actions.extend([RIGHT]*abs(delta_x))  # move right\n      else:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      # Adjust direction if needed (again for vertical movement)\n      if delta_y < 0 and current_dir != UP:\n          actions.append(UP)\n      elif delta_y > 0 and current_dir != DOWN:\n          actions.append(DOWN)\n      \n      # Move vertically\n      if delta_y > 0:\n          actions.extend([DOWN]*abs(delta_y))  # move down\n      else:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(target_workshop_position, current_pos, current_dir))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:44:45.243058", "function_name": "craft", "function_body": "  # Get the index for the goal item\n  i_goal = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe details from the cookbook\n  recipe_details = env.world.cookbook.recipes[i_goal]\n\n  # Extract the required workshop for crafting from the recipe\n  workshop_name = recipe_details[\"_at\"]\n  i_workshop = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  def find_nearest_workshop(i_workshop):\n    pos, dir = env._current_state.pos, env._current_state.dir\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # RIGHT, LEFT, DOWN, UP\n\n    min_distance = float('inf')\n    nearest_workshop_pos = None\n\n    for x in range(env.world.scenario.init_grid.shape[0]):\n      for y in range(env.world.scenario.init_grid.shape[1]):\n        if env._current_state.grid[x, y, i_workshop] > 0:\n          distance = abs(x - pos[0]) + abs(y - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            nearest_workshop_pos = (x, y)\n\n    return nearest_workshop_pos\n\n  nearest_workshop_pos = find_nearest_workshop(i_workshop)\n  \n  # Function to generate a path to the workshop using Breadth-First Search (BFS)\n  def bfs_shortest_path(start, goal):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos == goal:\n        return path\n\n      x, y = current_pos\n      for dx, dy in directions:\n        new_x, new_y = x + dx, y + dy\n        if (0 <= new_x < env.world.scenario.init_grid.shape[0] and \n            0 <= new_y < env.world.scenario.init_grid.shape[1] and \n            env._current_state.grid[new_x, new_y].sum() == 0 and \n            (new_x, new_y) not in visited):\n          queue.append(((new_x, new_y), path + [(dx, dy)]))\n          visited.add((new_x, new_y))\n\n    return None\n\n  # Find the shortest path to the workshop\n  path_to_workshop = bfs_shortest_path(env._current_state.pos, nearest_workshop_pos)\n  \n  # Convert the path into a list of actions (UP, DOWN, LEFT, RIGHT, USE)\n  def path_to_actions(path):\n    action_sequence = []\n    for dx, dy in path:\n      if dx == 0 and dy == 1:\n        action_sequence.append(env.world.N_ACTIONS.RIGHT)  # MOVE_FUNC RIGHT\n      elif dx == 0 and dy == -1:\n        action_sequence.append(env.world.N_ACTIONS.LEFT)   # MOVE_FUNC LEFT\n      elif dx == 1 and dy == 0:\n        action_sequence.append(env.world.N_ACTIONS.DOWN)   # MOVE_FUNC DOWN\n      elif dx == -1 and dy == 0:\n        action_sequence.append(env.world.N_ACTIONS.UP)     # MOVE_FUNC UP\n\n    action_sequence.append(env.world.N_ACTIONS.USE)  # USE to craft the item at the workshop\n    return action_sequence\n  \n  actions = path_to_actions(path_to_workshop)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:44:46.210097", "function_name": "craft", "function_body": "  # Retrieve the workshop index for the given item from the cookbook\n  i_item = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[i_item]\n\n  # Get the workshop name from the \"_key\" field in the recipe\n  workshop_name = recipe[\"_key\"]\n  i_workshop = env.world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # Find the position of the specified workshop\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, i_workshop] == 1:\n              workshop_pos = (x, y)\n              break\n\n  # Calculate the relative direction to move towards the workshop\n  current_pos = env._current_state.pos\n  delta_x = workshop_pos[0] - current_pos[0]\n  delta_y = workshop_pos[1] - current_pos[1]\n\n  # Move in the x-direction first\n  if delta_x > 0:\n      actions.extend([env.world.N_RIGHT for _ in range(delta_x)])\n  elif delta_x < 0:\n      actions.extend([env.world.N_LEFT for _ in range(-delta_x)])\n\n  # Then move in the y-direction\n  if delta_y > 0:\n      actions.extend([env.world.N_DOWN for _ in range(delta_y)])\n  elif delta_y < 0:\n      actions.extend([env.world.N_UP for _ in range(-delta_y)])\n\n  # Finally, perform the USE action to craft the item at the workshop\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:45:37.649877", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe details for the item to know which workshop is required.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the required workshop.\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  actions = []\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop for the item not found in the environment.\")\n\n  # We'll just take the first available position of the workshop.\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Calculate the direction needed to move towards the target position using Manhattan distance pathfinding.\n  while current_pos != target_pos:\n    delta_x, delta_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n    \n    if abs(delta_x) >= abs(delta_y):\n      if delta_x < 0:\n        actions.append(env.action_specs()[\"LEFT\"])\n        current_pos = (current_pos[0], current_pos[1] - 1)\n      else:\n        actions.append(env.action_specs()[\"RIGHT\"])\n        current_pos = (current_pos[0], current_pos[1] + 1)\n    else:\n      if delta_y < 0:\n        actions.append(env.action_specs()[\"DOWN\"])\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n        actions.append(env.action_specs()[\"UP\"])\n        current_pos = (current_pos[0] + 1, current_pos[1])\n  \n  # Once at the target position, perform the USE action to craft the item.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:45:38.722797", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe details for the item to know which workshop is required.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the required workshop.\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  actions = []\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop for the item not found in the environment.\")\n\n  # We'll just take the first available position of the workshop.\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Calculate the direction needed to move towards the target position.\n  delta_x, delta_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n  \n  while not (delta_x == 0 and delta_y == 0):\n    if abs(delta_x) > abs(delta_y):  # Prioritize horizontal movement\n      if delta_x < 0:\n        actions.append(env.action_specs()[\"LEFT\"])\n        delta_x += 1\n      else:\n        actions.append(env.action_specs()[\"RIGHT\"])\n        delta_x -= 1\n    else:  # Prioritize vertical movement\n      if delta_y < 0:\n        actions.append(env.action_specs()[\"DOWN\"])\n        delta_y += 1\n      else:\n        actions.append(env.action_specs()[\"UP\"])\n        delta_y -= 1\n  \n  # Once at the target position, perform the USE action to craft the item.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:46:52.197750", "function_name": "craft", "function_body": "  def get_shortest_path(target_pos, start_pos):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n      \n      while queue:\n          pos = queue.popleft()\n          \n          if pos == target_pos:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (pos[0] + dx, pos[1] + dy)\n              if neighbor not in visited and env._current_state.grid[neighbor] == 0:\n                  queue.append(neighbor)\n                  visited.add(neighbor)\n                  parent[neighbor] = pos\n      return []\n\n  def get_directions_to_target(path):\n      actions = []\n      current_dir = env._current_state.dir\n      \n      for i in range(len(path) - 1):\n          dx, dy = path[i+1][0] - path[i][0], path[i+1][1] - path[i][1]\n          \n          if dx == 1:  # move right\n              actions.extend([RIGHT]*abs(dx))\n              current_dir = RIGHT\n          elif dx == -1:  # move left\n              actions.extend([LEFT]*abs(dx))\n              current_dir = LEFT\n          elif dy == 1:  # move down\n              actions.extend([DOWN]*abs(dy))\n              current_dir = DOWN\n          elif dy == -1:  # move up\n              actions.extend([UP]*abs(dy))\n              current_dir = UP\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshops found for {item}.\")\n  \n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position\n  start_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Calculate the shortest path to the target workshop\n  path = get_shortest_path(target_workshop_position, start_pos)\n  \n  if not path:\n      raise ValueError(f\"No path found from {start_pos} to {target_workshop_position}.\")\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(path))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:46:53.267654", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if delta_x > 0:\n          actions.extend([RIGHT]*abs(delta_x))  # move right\n      elif delta_x < 0:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      if delta_y > 0:\n          actions.extend([DOWN]*abs(delta_y))  # move down\n      elif delta_y < 0:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshops found for {item}.\")\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:47:54.297974", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(\"No workshops found for specified item.\")\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate relative positions and determine movement actions needed to reach the target workshop\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n  \n  def move_to(x, y):\n      nonlocal actions\n      if x > 0:\n          actions.extend([RIGHT]*x)  # move right\n      elif x < 0:\n          actions.extend([LEFT]*-x)   # move left\n      \n      if y < 0:\n          actions.append(UP)  # change direction to up\n      elif y > 0:\n          actions.append(DOWN)  # change direction to down\n\n      if y > 0:\n          actions.extend([DOWN]*y)  # move down\n      else:\n          actions.extend([UP]*-y)    # move up\n  \n  move_to(delta_x, delta_y)\n  \n  # Perform the use action once at the workshop position\n  actions.append(USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:47:55.475379", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n\n  # Create a list to store the actions\n  actions = []\n\n  # Calculate relative positions and determine movement actions needed to reach the target workshop\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n\n  # Determine the sequence of directions needed to move from current position to target workshop position\n  if delta_x > 0:\n      actions.extend([RIGHT]*delta_x)  # move right\n  elif delta_x < 0:\n      actions.extend([LEFT]*abs(delta_x))   # move left\n\n  if delta_y < 0:\n      actions.append(UP)  # change direction to up\n  elif delta_y > 0:\n      actions.append(DOWN)  # change direction to down\n\n  if delta_y > 0:\n      actions.extend([DOWN]*delta_y)  # move down\n  elif delta_y < 0:\n      actions.extend([UP]*abs(delta_y))    # move up\n  \n  # Use the workshop action at the target position\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T22:49:30.454281", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      queue.append((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:49:31.408022", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using A* search algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = current[0] + dx, current[1] + dy\n              neighbor = (nx, ny)\n              \n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  tentative_g_score = g_score[current] + heuristic(current, neighbor)\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return None\n  \n  path_to_workshop = a_star(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:50:29.668565", "function_name": "craft", "function_body": "  def get_moves(current_pos, target_pos):\n    delta_x, delta_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n    actions = []\n    \n    while not (delta_x == 0 and delta_y == 0):\n      if abs(delta_x) > abs(delta_y):  # Prioritize horizontal movement\n        if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n          delta_x += 1\n        else:\n          actions.append(env.action_specs()[\"RIGHT\"])\n          delta_x -= 1\n      else:  # Prioritize vertical movement\n        if delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n          delta_y += 1\n        else:\n          actions.append(env.action_specs()[\"UP\"])\n          delta_y -= 1\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe details for the item to know which workshop is required.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the required workshop.\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  actions = []\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop for the item not found in the environment.\")\n\n  # We'll just take the first available position of the workshop.\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Get the sequence of actions to move to the target position.\n  actions.extend(get_moves(current_pos, target_pos))\n\n  # Once at the target position, perform the USE action to craft the item.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:50:30.732707", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos):\n    current_pos = env._current_state.pos\n    delta_x, delta_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n    \n    directions = []\n    while not (delta_x == 0 and delta_y == 0):\n      if abs(delta_x) > abs(delta_y):  # Prioritize horizontal movement\n        if delta_x < 0:\n          directions.append(env.action_specs()[\"LEFT\"])\n          delta_x += 1\n        else:\n          directions.append(env.action_specs()[\"RIGHT\"])\n          delta_x -= 1\n      else:  # Prioritize vertical movement\n        if delta_y < 0:\n          directions.append(env.action_specs()[\"DOWN\"])\n          delta_y += 1\n        else:\n          directions.append(env.action_specs()[\"UP\"])\n          delta_y -= 1\n    return directions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe details for the item to know which workshop is required.\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the required workshop.\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  actions = []\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"Workshop for the item not found in the environment.\")\n\n  # We'll just take the first available position of the workshop.\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate directions to move towards the target position.\n  actions.extend(get_directions_to_target(target_pos))\n  \n  # Once at the target position, perform the USE action to craft the item.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 4, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T22:52:08.707531", "function_name": "craft", "function_body": "  # Helper functions\n  def find_workshop(workshops: list[tuple], goal_index: int):\n    \"\"\"\n    Finds the nearest workshop index where the specified item can be crafted.\n\n    Args:\n        workshops (list[tuple]): List of tuples containing (workshop_type, position).\n        goal_index (int): The index of the desired output item in the cookbook's index.\n\n    Returns:\n        tuple: The position (x, y) of the nearest workshop.\n    \"\"\"\n    # Retrieve the target workshop type from the recipe\n    recipe = env.world.cookbook.recipes[goal_index]\n    target_workshop_type = recipe['_at']\n    \n    # Convert the target workshop type to an index using the cookbook's index\n    target_workshop_index = env.world.cookbook.index[target_workshop_type]\n\n    # Filter workshops by matching the target workshop type\n    filtered_workshops = [ws for ws in workshops if ws[0] == target_workshop_index]\n    \n    # Calculate distances to each filtered workshop and find the nearest one\n    agent_pos = env._current_state.pos\n    nearest_workshop = min(filtered_workshops, key=lambda ws: np.linalg.norm(np.array(ws[1]) - np.array(agent_pos)))\n    \n    return nearest_workshop\n\n  def move_to(x_target: int, y_target: int) -> list[int]:\n      \"\"\"\n      Generates actions to move the agent from its current position to a target position (x_target, y_target).\n\n      Args:\n          x_target (int): The x-coordinate of the target position.\n          y_target (int): The y-coordinate of the target position.\n\n      Returns:\n          List[int]: A list of action indices representing the moves needed to reach the target position.\n      \"\"\"\n      actions = []\n      agent_pos_x, agent_pos_y = env._current_state.pos\n      \n      # Calculate differences in x and y coordinates\n      dx = x_target - agent_pos_x\n      dy = y_target - agent_pos_y\n      \n      # Move horizontally (LEFT or RIGHT)\n      if dx > 0:\n          actions.extend([env.world.N_ACTIONS.RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([env.world.N_ACTIONS.LEFT] * abs(dx))\n      \n      # Move vertically (UP or DOWN)\n      if dy > 0:\n          actions.extend([env.world.N_ACTIONS.DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([env.world.N_ACTIONS.UP] * abs(dy))\n      \n      return actions\n\n  def rotate_to_facing_direction(direction: int) -> list[int]:\n      \"\"\"\n      Generates actions to rotate the agent to face a specific direction.\n\n      Args:\n          direction (int): The target direction index (0: UP, 1: DOWN, 2: LEFT, 3: RIGHT).\n\n      Returns:\n          List[int]: A list of action indices representing the rotations needed.\n      \"\"\"\n      current_direction = env._current_state.dir\n      directions = ['UP', 'DOWN', 'LEFT', 'RIGHT']\n      \n      # Calculate the relative difference in direction and wrap around using modulo\n      diff = (directions.index(direction) - current_direction + 4) % 4\n      \n      if diff == 1:\n          actions = [env.world.N_ACTIONS.RIGHT]\n      elif diff == 2:\n          actions = [env.world.N_ACTIONS.RIGHT, env.world.N_ACTIONS.RIGHT]\n      elif diff == 3:\n          actions = [env.world.N_ACTIONS.LEFT]\n      else:\n          actions = []\n      \n      return actions\n\n  # Main logic\n  item_index = env.world.cookbook.index[item]\n  \n  # Assuming workshops are stored in a list of tuples (workshop_type, position)\n  # Extract workshop positions and types from the grid\n  workshops = [(env.grid[i][j].kind, (i, j)) for i in range(env.width) for j in range(env.height)\n               if env.world.cookbook.index[env.grid[i][j].name] in env.world.workshop_indices]\n  \n  # Find the nearest workshop that can craft the desired item\n  nearest_workshop = find_workshop(workshops, item_index)\n  \n  # Generate actions to move to the nearest workshop\n  actions_to_workshop = move_to(nearest_workshop[1][0], nearest_workshop[1][1])\n  \n  # Rotate to face the workshop (assuming facing the correct direction is required for crafting)\n  target_direction = 'UP'  # This should be dynamically determined based on workshop orientation or agent's goal\n  actions_to_face_workshop = rotate_to_facing_direction(target_direction)\n  \n  # Add USE action to craft the item at the workshop\n  use_action = [env.world.N_ACTIONS.USE]\n  \n  # Combine all actions\n  total_actions = actions_to_workshop + actions_to_face_workshop + use_action\n  \n  return total_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:52:09.670389", "function_name": "craft", "function_body": "  # Get the cookbook from the environment\n  cookbook = env.world.cookbook\n  \n  # Get the index for the target item\n  goal_idx = cookbook.index[item]\n  \n  # Fetch the recipe for the target item\n  recipe = cookbook.recipes[goal_idx]\n\n  # Identify the workshop where crafting should happen\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Function to find all positions of a specific kind in the grid\n  def find_all_positions(grid, kind):\n      positions = []\n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if np.argmax(grid[y, x]) == kind:\n                  positions.append((x, y))\n      return positions\n\n  # Get all positions of the workshop on the grid\n  workshop_positions = find_all_positions(env._current_state.grid, workshop_index)\n\n  # Function to convert direction strings to indices (UP: 0, RIGHT: 1, DOWN: 2, LEFT: 3)\n  def dir_to_index(direction):\n      return {\"UP\": 0, \"RIGHT\": 1, \"DOWN\": 2, \"LEFT\": 3}[direction]\n\n  # Function to determine the action needed to move from one position to another\n  def get_action_from_positions(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return dir_to_index(\"RIGHT\")\n      elif dx < 0:\n          return dir_to_index(\"LEFT\")\n      elif dy > 0:\n          return dir_to_index(\"DOWN\")\n      elif dy < 0:\n          return dir_to_index(\"UP\")\n      else:\n          return None\n\n  # Function to navigate the agent to a specific position\n  def navigate_to_position(current_pos, target_pos):\n      actions = []\n      while current_pos != target_pos:\n          action = get_action_from_positions(current_pos, target_pos)\n          if action is not None:\n              actions.append(action)\n              current_pos = (current_pos[0] + (1 if action == dir_to_index(\"RIGHT\") else -1 if action == dir_to_index(\"LEFT\") else 0),\n                             current_pos[1] + (1 if action == dir_to_index(\"DOWN\") else -1 if action == dir_to_index(\"UP\") else 0))\n      return actions\n\n  # Choose the closest workshop to navigate to\n  closest_workshop = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n  # Navigate to the closest workshop\n  actions = navigate_to_position(env._current_state.pos, closest_workshop)\n  \n  # Append the USE action to craft the item at the workshop\n  actions.append(dir_to_index(\"USE\"))\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:53:26.421589", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T22:53:27.393964", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  def get_required_items(cookbook, item):\n      recipe = cookbook.recipes[cookbook.index[item]]\n      required_items = []\n      for key, value in recipe.items():\n          if key != '_at' and isinstance(value, int) and value > 0:\n              required_items.append((key, value))\n      return required_items\n\n  def collect_primitives(env, primitives):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      for primitive, count in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          grid = env._current_state.grid\n          primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"No {primitive} found on the map\")\n          \n          for _ in range(count):\n              target_pos = tuple(primitive_positions[0])\n              current_pos = env._current_state.pos\n              \n              actions_to_primitive = move_to_position(current_pos, target_pos)\n              actions += actions_to_primitive + [4]  # Adding USE action to collect item\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  required_items = get_required_items(cookbook, item)\n\n  # Collect all required primitives if not already in inventory\n  inventory = env._current_state.inventory\n  missing_primitives = [(primitive, count - inventory[cookbook.index[primitive]]) for primitive, count in required_items if count > inventory[cookbook.index[primitive]]]\n  \n  collect_actions = []\n  if missing_primitives:\n      collect_actions = collect_primitives(env, missing_primitives)\n  \n  # Craft the item at the workshop\n  craft_actions = craft_v1(env, item)\n\n  return collect_actions + craft_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:55:08.147627", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-16T22:55:09.228871", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T22:56:39.931066", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.next_pos_valid((nx, ny)):\n                      queue.append((nx, ny))\n               