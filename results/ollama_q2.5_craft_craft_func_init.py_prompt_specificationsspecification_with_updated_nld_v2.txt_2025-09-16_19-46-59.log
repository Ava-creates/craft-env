\n                      ingredient_index = cookbook.index[ingredient]\n                      \n                      # If the primitive is needed more than once, increase its count\n                      if ingredient_index not in primitives_needed:\n                          primitives_needed[ingredient_index] = 0\n                          \n                      primitives_needed[ingredient_index] += quantity\n                      \n                      # Push to stack only if it's a recipe and we don't have enough in inventory\n                      if ingredient_index in cookbook.recipes and inventory.get(ingredient_index, 0) < quantity:\n                          stack.append(ingredient_index)\n          else:\n              primitives_needed[current_item] = 1\n      \n      return primitives_needed\n\n  def collect_primitives(primitives_needed):\n    actions_to_take = []\n    \n    for primitive_index, quantity in primitives_needed.items():\n        current_quantity = env._current_state.inventory.get(primitive_index, 0)\n        \n        if current_quantity < quantity:\n            cookbook = env.world.cookbook\n            primitive_name = cookbook.index[primitive_index]\n            \n            # Find the closest position of this primitive on the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            for _ in range(quantity - current_quantity):\n                if len(primitive_positions) > 0:\n                    closest_primitive_pos = min(\n                        primitive_positions, \n                        key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                    )\n                    \n                    target_primitive_pos = tuple(closest_primitive_pos)\n                    \n                    # Calculate move actions to reach the closest primitive\n                    actions_to_take.extend(get_move_actions(target_primitive_pos))\n                    \n                    # Use the USE action to collect the primitive\n                    actions_to_take.append(4)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the primitives needed for the item\n    primitives_needed = ensure_primitives(item_index)\n    \n    # Collect all primitives not currently in inventory\n    actions_to_take = collect_primitives(primitives_needed)\n\n    # Craft the item after ensuring all primitives are collected\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T05:45:30.197162", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move_and_turn(dx, dy):\n      # Determine the direction to face for moving towards the workshop\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  move_and_turn(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T05:45:31.362926", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Determine the direction to face for moving towards the workshop\n  if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n  elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n  \n  if dy > 0:\n      actions.extend([1] * abs(dy))  # UP\n  elif dy < 0:\n      actions.extend([0] * abs(dy))  # DOWN\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T05:47:35.782554", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_dir = env._current_state.dir\n    target_x, target_y = target_pos[0], target_pos[1]\n    current_x, current_y = env._current_state.pos[0], env._current_state.pos[1]\n\n    if target_x > current_x:\n        # Target is to the right\n        target_direction = 3\n    elif target_x < current_x:\n        # Target is to the left\n        target_direction = 2\n    else:\n        # Same x-coordinate, no horizontal movement needed\n        target_direction = None\n\n    if target_y > current_y:\n        # Target is below\n        target_direction = 1 if target_direction is None or target_direction == 3 else (target_direction + 1) % 4\n    elif target_y < current_y:\n        # Target is above\n        target_direction = 0 if target_direction is None or target_direction == 2 else (target_direction - 1) % 4\n\n    if target_direction is not None and target_direction != current_dir:\n        return [(current_direction + (target_direction - current_direction) % 4)]\n    \n    return []\n\n  def collect_primitives(env, recipe):\n    actions_to_take = []\n    cookbook = env.world.cookbook\n    \n    # Collect primitives required for the item\n    for primitive_name, quantity in recipe.items():\n        if primitive_name != '_at':\n            primitive_index = cookbook.index[primitive_name]\n            \n            # Check if we already have the required primitive in inventory\n            if not env._current_state.inventory.get(primitive_name, 0) >= quantity:\n                # Find all positions of the specified primitive in the grid\n                primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n                \n                if len(primitive_positions) > 0:\n                    for _ in range(quantity):\n                        closest_primitive = min(\n                            primitive_positions, \n                            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                        )\n                        \n                        target_primitive_pos = tuple(closest_primitive)\n                        \n                        # Calculate move actions to reach the closest primitive\n                        actions_to_take.extend(get_move_actions(target_primitive_pos))\n                        \n                        # Align with the target direction (not strictly necessary if collecting primitives directly)\n                        actions_to_take.extend(align_with_target(target_primitive_pos))\n                        \n                        # Collect the primitive using the COLLECT action\n                        actions_to_take.append(craft.COLLECT_FUNC(primitive_index))\n                        \n                        # Update the grid to reflect that we collected one unit of the primitive\n                        env._current_state.grid[target_primitive_pos] = 0\n                        \n                        # Update inventory in the environment state (assuming this is managed by the environment)\n                        if primitive_name in env._current_state.inventory:\n                            env._current_state.inventory[primitive_name] += 1\n                        else:\n                            env._current_state.inventory[primitive_name] = 1\n\n    return actions_to_take\n\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Collect primitives required for the item\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Align with the target direction (not strictly necessary if already facing it)\n        actions_to_take.extend(align_with_target(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(craft.CRAFT_FUNC(item_index))\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T05:47:36.849714", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_dir = env._current_state.dir\n    target_dir = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if target_dir == (0, 1) and current_dir != 3:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 2:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 0:\n        return [(current_dir + 3) % 4]\n\n    return []\n\n  def face_target_direction(target_pos):\n      current_dir = env._current_state.dir\n      target_x, target_y = target_pos\n      current_x, current_y = env._current_state.pos\n      \n      if target_x > current_x:\n          # Target is to the right\n          return [(2 + (3 - current_dir) % 4) % 4]\n      elif target_x < current_x:\n          # Target is to the left\n          return [(2 + (1 - current_dir) % 4) % 4]\n      elif target_y > current_y:\n          # Target is below\n          return [(2 + (0 - current_dir) % 4) % 4]\n      elif target_y < current_y:\n          # Target is above\n          return [(2 + (2 - current_dir) % 4) % 4]\n\n      return []\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Initialize the actions list\n        actions_to_take = []\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Align with the target direction\n        actions_to_take.extend(face_target_direction(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.0}}
