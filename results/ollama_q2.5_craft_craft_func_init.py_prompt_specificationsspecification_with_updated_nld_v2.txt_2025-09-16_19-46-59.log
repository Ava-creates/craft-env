tive_index] += 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] += 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Check if there is a recipe available for this item\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      # Collect all dependencies that are not in inventory\n      actions_to_take = collect_dependencies(env, dependencies)\n\n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def resolve_conflicts(env, actions):\n    \"\"\"Resolve any potential conflicts in the planned actions.\"\"\"\n    resolved_actions = []\n    current_pos = env._current_state.pos\n    \n    for action in actions:\n        if action == 0:  # Move UP\n            new_pos = (current_pos[0], current_pos[1] - 1)\n        elif action == 1:  # Move DOWN\n            new_pos = (current_pos[0], current_pos[1] + 1)\n        elif action == 2:  # Move LEFT\n            new_pos = (current_pos[0] - 1, current_pos[1])\n        elif action == 3:  # Move RIGHT\n            new_pos = (current_pos[0] + 1, current_pos[1])\n        elif action == 4:  # USE\n            new_pos = current_pos\n        \n        # Check if the move is valid and not into an obstacle\n        if env._current_state.grid[new_pos[0], new_pos[1]] != 0:\n            resolved_actions.append(action)\n            current_pos = new_pos\n    \n    return resolved_actions\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Plan and execute the crafting process\n  actions_to_take = plan_crafting(env, item_index)\n  \n  # Resolve any potential conflicts in the planned actions\n  resolved_actions = resolve_conflicts(env, actions_to_take)\n\n  return resolved_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-18T07:29:12.007033", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + count\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] = env._current_state.inventory.get(dependency, 0) + 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Check if there is a recipe available for this item\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      # Collect all dependencies that are not in inventory\n      actions_to_take = collect_dependencies(env, dependencies)\n\n      # Navigate and craft the item at the closest available workshop\n      actions_to_take.extend(navigate_and_craft(env, item_index))\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Plan and execute the crafting process\n  actions_to_take = plan_crafting(env, item_index)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-18T07:29:13.095150", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)      # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)      # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += count\n        else:\n            env._current_state.inventory[primitive_index] = count\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          if dependency in env._current_state.inventory:\n              env._current_state.inventory[dependency] += 1\n          else:\n              env._current_state.inventory[dependency] = 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Check if there is a recipe available for this item\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      # Collect all dependencies that are not in inventory\n      actions_to_take = collect_dependencies(env, dependencies)\n\n      # Navigate and craft the item at the closest available workshop\n      actions_to_take.extend(navigate_and_craft(env, item_index))\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Plan and execute the crafting process\n  actions_to_take = plan_crafting(env, item_index)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 6.7}}
{"timestamp": "2025-09-18T07:31:51.532363", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    if not primitive_positions.size:\n      raise ValueError(f\"No primitives of type {primitive_index} found in the grid.\")\n    \n    closest_primitive = min(\n        primitive_positions, \n        key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n    )\n    \n    actions_to_take = get_move_actions(tuple(closest_primitive))\n    actions_to_take.append(4)  # USE action to collect the primitive\n    \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      )\n      \n      actions_to_take = get_move_actions(tuple(closest_workshop))\n      actions_to_take.append(4)  # USE action to craft the item\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    dependencies = set()\n    \n    # Avoid circular references by keeping track of visited items\n    if item_index in visited:\n        return dependencies\n    visited.add(item_index)\n    \n    if item_index in cookbook.recipes:\n        recipe = cookbook.recipes[item_index].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n            # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n            if primitive_index in cookbook.recipes and primitive_index != item_index:\n                dependencies.update(get_recipe_dependencies(cookbook, primitive_index, visited))\n            else:\n                dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_all_primitives(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        actions_to_take.extend(collect_primitive(env, dependency))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Get all dependencies (primitives) required to craft the item\n    dependencies = get_recipe_dependencies(cookbook, item_index)\n    \n    # Collect all dependencies that are not in inventory\n    actions_to_take = collect_all_primitives(env, dependencies)\n\n    # Check if all primitives are available in inventory\n    if check_inventory(env, recipe):\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n        # Collect primitives required for crafting\n        actions_to_take.extend(collect_all_primitives(env, dependencies))\n\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
