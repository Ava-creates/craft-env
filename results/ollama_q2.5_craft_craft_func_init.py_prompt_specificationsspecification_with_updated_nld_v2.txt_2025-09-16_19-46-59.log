pecified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the nearest available workshop\n  target_pos = min(workshop_positions, key=lambda pos: heuristic(current_pos, tuple(pos)))\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos, grid, workshop_index)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:00:43.596037", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T02:00:44.684607", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Function to convert position difference to actions\n  def move_to_position(current_pos, next_pos):\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n\n    actions = []\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    if delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    elif delta_y > 0:\n        actions.append(action_map[\"UP\"])\n    return actions\n\n  # Move to each position in the best path\n  for i in range(len(best_path) - 1):\n      next_pos = best_path[i + 1]\n      actions.extend(move_to_position(best_path[i], next_pos))\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 3.2}}
{"timestamp": "2025-09-17T02:07:21.855184", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  dir_map = {0: (1, 0), 1: (-1, 0), 2: (0, -1), 3: (0, 1)}\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      nonlocal actions\n      while dx != 0 or dy != 0:\n          # Determine the direction to move\n          if dx > 0 and env._current_state.dir == 3:\n              actions.append(4)  # USE to move RIGHT\n              dx -= 1\n          elif dx < 0 and env._current_state.dir == 2:\n              actions.append(4)  # USE to move LEFT\n              dx += 1\n          elif dy > 0 and env._current_state.dir == 1:\n              actions.append(4)  # USE to move UP\n              dy -= 1\n          elif dy < 0 and env._current_state.dir == 0:\n              actions.append(4)  # USE to move DOWN\n              dy += 1\n          else:\n              # Turn towards the direction of movement\n              if dx > 0:\n                  target_dir = 3  # RIGHT\n              elif dx < 0:\n                  target_dir = 2  # LEFT\n              elif dy > 0:\n                  target_dir = 1  # UP\n              else:\n                  target_dir = 0  # DOWN\n\n              while env._current_state.dir != target_dir:\n                  if (target_dir - env._current_state.dir) % 4 == 1 or (env._current_state.dir - target_dir) % 4 == 3:\n                      actions.append(1)  # TURN LEFT\n                  else:\n                      actions.append(0)  # TURN RIGHT\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:07:22.931216", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def rotate(direction):\n      current_direction = env._current_state.dir\n      target_direction = direction\n\n      if current_direction == target_direction:\n          return\n\n      # Determine the number of rotations needed to face the correct direction\n      # RIGHT (3) -> UP (1): Turn left twice (0, 2)\n      # RIGHT (3) -> DOWN (0): Turn right once (4)\n      # LEFT (2) -> UP (1): Turn right once (4)\n      # LEFT (2) -> DOWN (0): Turn left twice (0, 2)\n      # UP (1) -> RIGHT (3): Turn right once (4)\n      # UP (1) -> LEFT (2): Turn left once (0)\n      # DOWN (0) -> RIGHT (3): Turn left once (0)\n      # DOWN (0) -> LEFT (2): Turn right once (4)\n\n      if current_direction == 3:  # RIGHT\n          if target_direction == 1:\n              actions.extend([0, 2])  # Turn left twice\n          elif target_direction == 0:\n              actions.append(4)  # Turn right once\n      elif current_direction == 2:  # LEFT\n          if target_direction == 1:\n              actions.append(4)  # Turn right once\n          elif target_direction == 0:\n              actions.extend([0, 2])  # Turn left twice\n      elif current_direction == 1:  # UP\n          if target_direction == 3:\n              actions.append(4)  # Turn right once\n          elif target_direction == 2:\n              actions.append(0)  # Turn left once\n      elif current_direction == 0:  # DOWN\n          if target_direction == 3:\n              actions.append(0)  # Turn left once\n          elif target_direction == 2:\n              actions.append(4)  # Turn right once\n\n  def move_towards(target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      \n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              rotate(3)  # RIGHT\n              actions.append(3)\n              current_x += 1\n          elif current_x > target_x:\n              rotate(2)  # LEFT\n              actions.append(2)\n              current_x -= 1\n          elif current_y < target_y:\n              rotate(1)  # UP\n              actions.append(1)\n              current_y += 1\n          elif current_y > target_y:\n              rotate(0)  # DOWN\n              actions.append(0)\n              current_y -= 1\n\n  move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 3.9}}
{"timestamp": "2025-09-17T02:08:28.088778", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n\n      if dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T02:08:29.156358", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  def is_next_to_workshop(current_pos, target_workshop_pos):\n      dx = abs(target_workshop_pos[0] - current_pos[0])\n      dy = abs(target_workshop_pos[1] - current_pos[1])\n      return dx <= 1 and dy <= 1\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = []\n  \n  if not is_next_to_workshop(current_pos, target_workshop_pos):\n      actions_to_reach_workshop.extend(get_next_action(current_pos, target_workshop_pos))\n      \n  actions_to_reach_workshop.append(4)  # USE\n  \n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 3.9}}
{"timestamp": "2025-09-17T02:09:52.310006", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def collect_primitives(primitive_names):\n      actions = []\n      for primitive in primitive_names:\n          primitive_index = env.world.cookbook.index[primitive]\n          if not env._current_state.inventory[primitive_index]:\n              # Find all positions of the specified primitive in the grid\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              )\n              target_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions.extend(get_move_actions(target_pos))\n\n              # Use the USE action to collect the primitive\n              actions.append(4)\n      return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Collect all required primitives\n        required_primitives = [key for key in recipe if key != '_at']\n        actions_to_take = collect_primitives(required_primitives)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:09:53.300001", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract ingredients and workshop from the recipe\n    required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != '_at'}\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Check inventory for all required ingredients\n    inventory = env._current_state.inventory\n    actions_to_take = []\n\n    missing_ingredients = []\n    for ingredient, required_count in required_ingredients.items():\n        if inventory[ingredient] < required_count:\n            missing_ingredients.append((ingredient, required_count - inventory[ingredient]))\n\n    if missing_ingredients:\n        raise ValueError(f\"Missing ingredients: {missing_ingredients}\")\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:10:53.500705", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Determine direction and move accordingly\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:10:54.561691", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def find_closest_workshop(workshop_positions, current_x, current_y):\n    return min(\n        workshop_positions,\n        key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = find_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:12:06.295838", "function_name": "craft", "function_body": "  def find_path(start, end, grid):\n      \"\"\"Find a path from start to end using BFS.\"\"\"\n      queue = collections.deque([start])\n      visited = set()\n      parent = {}\n\n      while queue:\n          x, y = queue.popleft()\n\n          if (x, y) == end:\n              break\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[nx, ny, :].sum() == 0 and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = (x, y)\n\n      path = []\n      if end in parent:\n          x, y = end\n          while (x, y) != start:\n              path.append((x, y))\n              x, y = parent[(x, y)]\n          path.reverse()\n      return path\n\n  def map_action(pos1, pos2):\n      \"\"\"Map the movement from pos1 to pos2 to an action.\"\"\"\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n\n      if dx == 1:\n          return 3  # RIGHT\n      elif dx == -1:\n          return 2  # LEFT\n      elif dy == 1:\n          return 1  # UP\n      elif dy == -1:\n          return 0  # DOWN\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = env._current_state.pos\n  distances = [np.linalg.norm(np.array(pos) - np.array(current_pos)) for pos in workshop_positions]\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  path_to_workshop = find_path(current_pos, target_workshop_pos, env._current_state.grid)\n  actions_to_reach_workshop = [map_action(path_to_workshop[i], path_to_workshop[i+1]) for i in range(len(path_to_workshop) - 1)]\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-09-17T02:12:07.358575", "function_name": "craft", "function_body": "  def get_next_actions_bfs(start, goal):\n      \"\"\"Get actions to reach a goal using BFS.\"\"\"\n      queue = collections.deque([(start, [])])\n      visited = set([tuple(start)])\n      \n      while queue:\n          (current_pos, path) = queue.popleft()\n          \n          if tuple(current_pos) == tuple(goal):\n              return path\n          \n          # Possible moves: DOWN, UP, LEFT, RIGHT\n          for action in range(4):  # Assuming actions are indexed as DOWN=0, UP=1, LEFT=2, RIGHT=3\n              dx, dy = [(0, -1), (0, 1), (-1, 0), (1, 0)][action]\n              next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              \n              if (next_pos[0] >= 0 and next_pos[0] < env._current_state.grid.shape[0] and\n                  next_pos[1] >= 0 and next_pos[1] < env._current_state.grid.shape[1]):\n                  \n                  if tuple(next_pos) not in visited:\n                      visited.add(tuple(next_pos))\n                      queue.append((next_pos, path + [action]))\n                      \n      return []\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop using BFS\n  current_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - np.array(current_pos), axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_actions_bfs(current_pos, target_workshop_pos)\n\n  if not actions_to_reach_workshop:\n      raise ValueError(\"No valid path to the workshop found.\")\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T02:13:55.558290", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  def determine_direction(current_pos, next_pos):\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          return action_map[\"LEFT\"]\n      elif delta_x > 0:\n          return action_map[\"RIGHT\"]\n      elif delta_y < 0:\n          return action_map[\"DOWN\"]\n      else:\n          return action_map[\"UP\"]\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    direction_action = determine_direction(current_pos, next_pos)\n    \n    if direction_action != action_map[env.world.cookbook.index.opposite[current_dir]]:\n      actions.append(direction_action)\n\n    current_pos = next_pos\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
