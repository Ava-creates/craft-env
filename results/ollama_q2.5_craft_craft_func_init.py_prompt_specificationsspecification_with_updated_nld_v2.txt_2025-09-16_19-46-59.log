tive_index] += 1\n        \n    return actions_to_take\n\n  def get_crafting_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n      else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  def find_and_collect_all_primitives(env, item_index):\n    cookbook = env.world.cookbook\n    actions_to_take = []\n    \n    # Get the full recipe including primitives and workshop information\n    recipe = cookbook.recipes[item_index].copy()\n    \n    # Remove '_at' from the recipe to focus only on primitives\n    del recipe['_at']\n    \n    # Collect all primitives needed for crafting the item\n    actions_to_take.extend(collect_primitives(env, recipe))\n    \n    return actions_to_take\n\n  def craft_item_at_workshop(env, workshop_pos):\n    actions_to_take = get_move_actions(workshop_pos)\n    actions_to_take.append(4)  # Use action to craft the item at the workshop\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Find and collect all primitives required for crafting the item\n    actions_to_take = find_and_collect_all_primitives(env, item_index)\n\n    # Get the closest workshop to craft the item at\n    target_workshop_pos = get_crafting_workshop(env, item_index)\n    \n    # Craft the item at the workshop\n    actions_to_take.extend(craft_item_at_workshop(env, target_workshop_pos))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 7.2}}
