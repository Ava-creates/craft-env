tive_index] += 1\n        \n    return actions_to_take\n\n  def ensure_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n\n    actions_to_take = []\n    while any(count > 0 for count in primitives_needed.values()):\n        for primitive_index, count in list(primitives_needed.items()):\n            # Check if the current inventory has enough of this item\n            if env._current_state.inventory[primitive_index] >= count:\n                del primitives_needed[primitive_index]\n                continue\n\n            # Calculate how many more are needed\n            additional_needed = count - env._current_state.inventory[primitive_index]\n\n            # Find positions of the required primitives in the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n            if len(primitive_positions) > 0:\n                # Choose the closest available position to collect from\n                current_pos = env._current_state.pos\n\n                closest_primitive = min(\n                    primitive_positions, \n                    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                )\n                \n                target_primitive_pos = tuple(closest_primitive)\n\n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n                \n                # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                env._current_state.inventory[primitive_index] += 1\n\n            else:\n                raise ValueError(f\"Not enough primitives available in the grid: {cookbook.index.inverse[primitive_index]}\")\n\n    return actions_to_take\n  \n  def craft_item(env, workshop_index):\n      target_workshop_pos = get_closest_workshop(env, workshop_index)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    try:\n        actions_to_take = ensure_inventory(env, recipe)\n        \n        # Now that we have ensured all required primitives are in inventory, proceed to craft the item\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T17:43:32.538250", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def get_directions(current_x, current_y, target_x, target_y):\n    directions = []\n    \n    if current_x < target_x:\n        directions.append(3)  # RIGHT\n    elif current_x > target_x:\n        directions.append(2)  # LEFT\n    \n    if current_y < target_y:\n        directions.append(1)  # UP\n    elif current_y > target_y:\n        directions.append(0)  # DOWN\n\n    return directions\n\n  def navigate_to(env, target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while (current_x != target_x) or (current_y != target_y):\n          directions = get_directions(current_x, current_y, target_x, target_y)\n          \n          for action in directions:\n              actions.append(action)\n              \n              # Update the agent's position after each move\n              if action == 3:  # RIGHT\n                  current_x += 1\n              elif action == 2:  # LEFT\n                  current_x -= 1\n              elif action == 1:  # UP\n                  current_y += 1\n              elif action == 0:  # DOWN\n                  current_y -= 1\n\n      return actions\n\n  def craft_item(env):\n    actions = [4]  # USE to start crafting the item\n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Navigate to the closest workshop\n  actions.extend(navigate_to(env, target_x, target_y))\n  \n  # Craft the item (use the USE action)\n  actions.extend(craft_item(env))\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T17:43:33.617604", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def get_directions(current_x, current_y, target_x, target_y):\n      if current_x < target_x:\n          yield 3  # RIGHT\n      elif current_x > target_x:\n          yield 2  # LEFT\n      \n      if current_y < target_y:\n          yield 1  # UP\n      elif current_y > target_y:\n          yield 0  # DOWN\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      directions = get_directions(current_x, current_y, target_x, target_y)\n      \n      for action in directions:\n          actions.append(action)\n          \n          # Update the agent's position after each move\n          if action == 3:  # RIGHT\n              current_x += 1\n          elif action == 2:  # LEFT\n              current_x -= 1\n          elif action == 1:  # UP\n              current_y += 1\n          elif action == 0:  # DOWN\n              current_y -= 1\n\n      actions.append(4)  # USE to ensure interaction with the grid at each step\n  \n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 5.8999996}}
{"timestamp": "2025-09-17T17:44:30.729272", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards_target(current_pos, target_pos):\n      actions = []\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions, (current_x, current_y)\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_pos = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n  )\n\n  # Move towards the workshop\n  movement_actions, _ = move_towards_target(current_pos, closest_workshop_pos)\n  actions.extend(movement_actions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T17:44:31.789205", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 5.8999996}}
{"timestamp": "2025-09-17T17:46:40.235322", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n        \n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n    \n    return actions_to_take\n\n  def collect_primitives(env):\n    cookbook = env.world.cookbook\n    primitives_required = set(cookbook.primitives)\n\n    actions_to_take = []\n\n    while primitives_required:\n      primitive_name = primitives_required.pop()\n      primitive_index = cookbook.index[primitive_name]\n      \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n      else:\n        raise ValueError(f\"No primitives found for {primitive_name}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    actions_to_take.extend(craft_item(env, item_index))\n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 8, "scores": {"3": 6.0}}
{"timestamp": "2025-09-17T17:46:41.240270", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # Recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n        \n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n    \n    return actions_to_take\n\n  def get_all_required_primitives(item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    required_primitives = set()\n\n    if '_at' in recipe:\n      del recipe['_at']\n\n    stack = list(recipe.keys())\n    while stack:\n        ingredient = stack.pop()\n        if ingredient not in cookbook.recipes:\n            required_primitives.add(ingredient)\n        else:\n            sub_recipe = cookbook.recipes[ingredient]\n            for sub_ingredient, _ in sub_recipe.items():\n                if sub_ingredient != '_at':\n                    stack.append(sub_ingredient)\n\n    return required_primitives\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n  required_primitives = get_all_required_primitives(item_index)\n  \n  actions_to_take = []\n\n  for primitive_name in required_primitives:\n    primitive_index = cookbook.index[primitive_name]\n    if env._current_state.inventory[primitive_index] == 0:\n      actions_to_take.extend(ensure_inventory(env, primitive_index))\n      \n  actions_to_take.extend(craft_item(env, item_index))\n\n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T17:48:39.926559", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_name):\n      cookbook = env.world.cookbook\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n          return target_workshop_pos\n      else:\n          raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def collect_and_move_to_workshop(env, recipe, workshop_name):\n    actions_to_take = []\n    \n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n    \n    # Get the closest available workshop position to craft the item at\n    target_workshop_pos = get_closest_workshop(env, workshop_name)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop and store it\n    workshop_name = recipe.pop('_at')\n\n    # Collect primitives required for crafting and move to the closest available workshop\n    actions_to_take = collect_and_move_to_workshop(env, recipe, workshop_name)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 9, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T17:48:40.896634", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_name):\n      cookbook = env.world.cookbook\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n          return target_workshop_pos\n      else:\n          raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def collect_and_move_to_workshop(env, recipe, workshop_name):\n    actions_to_take = []\n    \n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n    \n    # Get the closest available workshop position to craft the item at\n    target_workshop_pos = get_closest_workshop(env, workshop_name)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n    \n    return actions_to_take\n\n  def break_into_tasks(item_index):\n      cookbook = env.world.cookbook\n      \n      # List to store tasks (each task is a sequence of actions needed to craft one item)\n      tasks = []\n      \n      # Queue for breadth-first traversal\n      queue = collections.deque([(item_index, [])])\n      \n      while queue:\n          current_item_index, path = queue.popleft()\n          \n          if current_item_index not in cookbook.recipes:\n              raise ValueError(f\"No recipe available for crafting item index {current_item_index}.\")\n              \n          recipe = cookbook.recipes[current_item_index].copy()\n\n          # Remove the '_at' key which indicates the workshop and store it\n          workshop_name = recipe.pop('_at')\n          \n          # Collect primitives required for crafting and move to the closest available workshop\n          actions_to_take = collect_and_move_to_workshop(env, recipe, workshop_name)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n          tasks.append((actions_to_take, current_item_index))\n          \n          for primitive_index, count in recipe.items():\n              queue.append((primitive_index, path + [current_item_index]))\n      \n      return tasks\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Generate a list of tasks needed to craft the final item and all its dependencies\n  tasks = break_into_tasks(item_index)\n  \n  # Sort tasks by dependency order (final task first)\n  tasks.sort(key=lambda x: len(x[1]))\n  \n  actions_to_take = []\n  \n  for task_actions, _ in tasks:\n      actions_to_take.extend(task_actions)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T17:49:39.762629", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n\n          # Update the agent's position after each move\n          if current_x < target_x:\n              current_x += 1\n          elif current_x > target_x:\n              current_x -= 1\n\n          if current_y < target_y:\n              current_y += 1\n          elif current_y > target_y:\n              current_y -= 1\n\n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move towards the workshop\n  actions.extend(move_towards(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T17:49:40.832723", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n\n      # Update the agent's position after each move\n      if current_x < target_x:\n          current_x += 1\n      elif current_x > target_x:\n          current_x -= 1\n\n      if current_y < target_y:\n          current_y += 1\n      elif current_y > target_y:\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
