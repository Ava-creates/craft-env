orkshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)  # Assuming USE is used for crafting as well.\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 4, "scores": {}}
{"timestamp": "2025-09-17T09:56:06.664278", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in cookbook.recipes:\n        # Recursively craft the primitive.\n        actions_to_take.extend(craft_v2(env, primitive_name))\n      else:\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the COLLECT action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 4, "scores": {}}
{"timestamp": "2025-09-17T09:57:20.898417", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop using A* pathfinding for better efficiency\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:  # Assuming 0 is walkable\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0])  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n      actions.append(4)  # USE (to avoid getting stuck)\n\n  actions.append(4)  # Craft the item\n\n  return actions", "island_id": 8, "scores": {"3": 5.9}}
{"timestamp": "2025-09-17T09:57:22.016728", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          else:\n              actions.append(2)  # LEFT\n              current_x -= 1\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n              current_y += 1\n          else:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:58:35.865835", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start_x, start_y, target_x, target_y):\n      # A simple BFS to find the shortest path\n      queue = collections.deque([(start_x, start_y, [])])\n      visited = set()\n      directions = [(0, 1, 1), (1, 0, 3), (0, -1, 2), (-1, 0, 0)]  # UP, RIGHT, DOWN, LEFT\n\n      while queue:\n          x, y, path = queue.popleft()\n          \n          if (x, y) == (target_x, target_y):\n              return path\n          \n          for dx, dy, action in directions:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1] and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append((nx, ny, path + [action]))\n      return []\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  path_to_workshop = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(path_to_workshop)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 3.9}}
{"timestamp": "2025-09-17T09:58:36.846050", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a path from start to target using BFS.\"\"\"\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n      queue = collections.deque([(start[0], start[1], [])])\n      visited = set()\n      \n      while queue:\n          x, y, path = queue.popleft()\n          \n          if (x, y) == target:\n              return path\n\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              \n              # Check if the next position is within bounds and not blocked by an obstacle\n              if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                  actions = path[:]\n                  \n                  if dx == -1:\n                      actions.append(0)  # DOWN\n                  elif dx == 1:\n                      actions.append(1)  # UP\n                  elif dy == -1:\n                      actions.append(2)  # LEFT\n                  elif dy == 1:\n                      actions.append(3)  # RIGHT\n\n                  queue.append((nx, ny, actions))\n\n      return None\n\n  def convert_actions_to_use(actions):\n      \"\"\"Convert a list of movement actions to include USE actions.\"\"\"\n      result = []\n      for action in actions:\n          result.extend([action, 4])  # Move and then use\n      return result + [4]  # Final use to craft the item\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the path to the workshop\n  actions_to_reach_workshop = calculate_path((current_x, current_y), closest_workshop_pos)\n\n  if actions_to_reach_workshop is None:\n      raise ValueError(\"Path to the workshop not found.\")\n\n  # Convert movement actions to include USE actions\n  actions.extend(convert_actions_to_use(actions_to_reach_workshop))\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
