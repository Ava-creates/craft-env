tive_index] += 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] += 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Check if there is a recipe available for this item\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      # Collect all dependencies that are not in inventory\n      actions_to_take = collect_dependencies(env, dependencies)\n\n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Plan and execute the crafting process\n  actions_to_take = plan_crafting(env, item_index)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 8.3}}
{"timestamp": "2025-09-18T06:54:53.123115", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def craft_item_at_workshop(env, workshop_pos):\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n\n    # Find the closest available workshop position to craft the item at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n        \n    # Craft the item at the found workshop\n    actions_to_take.extend(craft_item_at_workshop(env, target_workshop_pos))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 7.2}}
{"timestamp": "2025-09-18T06:54:54.095973", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def check_crafting_conditions(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    # Check if all required primitives are available on the grid\n    for primitive_index, count in primitives_needed.items():\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) < count:\n        return False\n    \n    return True\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n\n    # Check if all required primitives are available on the grid\n    if not check_crafting_conditions(env, recipe):\n      raise ValueError(f\"Not enough required primitives found for crafting {item}.\")\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find the closest available workshop position to craft the item at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n        \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-18T06:56:46.815146", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n        \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_workshop_positions(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    return np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  def find_closest_position(current_pos, positions):\n      closest_pos = min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      return tuple(closest_pos)\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop and store it\n    workshop_name = recipe['_at']\n    del recipe['_at']\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = get_workshop_positions(env, workshop_name)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        # Choose the closest available workshop position to craft the item at\n        closest_workshop = find_closest_position(current_pos, workshop_positions)\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 1, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-18T06:56:47.799503", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    collected_count = collections.Counter()\n    \n    for primitive_index, count in primitives_needed.items():\n      remaining_count = count - (env._current_state.inventory.get(primitive_index, 0) if primitive_index in env._current_state.inventory else 0)\n      \n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        # Collect as many as needed to satisfy the recipe requirement\n        for _ in range(remaining_count):\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n          \n          # Remove collected primitive position from available positions\n          primitive_positions = np.delete(primitive_positions, np.where((primitive_positions == closest_primitive).all(axis=1)), axis=0)\n          \n          # Update current position for subsequent collections\n          current_pos = target_primitive_pos\n\n    return actions_to_take\n\n  def get_workshop_positions(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    return np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  def find_closest_position(current_pos, positions):\n      closest_pos = min(\n          positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      return tuple(closest_pos)\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop and store it\n    workshop_name = recipe['_at']\n    del recipe['_at']\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = get_workshop_positions(env, workshop_name)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        # Choose the closest available workshop position to craft the item at\n        closest_workshop = find_closest_position(current_pos, workshop_positions)\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-18T06:59:46.062564", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          if dependency in env._current_state.inventory:\n              env._current_state.inventory[dependency] += 1\n          else:\n              env._current_state.inventory[dependency] = 1\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Get all dependencies (primitives) required to craft the item\n    dependencies = get_recipe_dependencies(cookbook, item_index)\n    \n    # Collect all dependencies that are not in inventory\n    actions_to_take = collect_dependencies(env, dependencies)\n\n    # Check if all primitives are available in inventory\n    if check_inventory(env, recipe):\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n        # Collect primitives required for crafting\n        actions_to_take.extend(collect_primitives(env, recipe))\n\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": 6.7999997}}
