tive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_index)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T14:27:27.988183", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start_x, start_y, target_x, target_y):\n      path = []\n      while (start_x != target_x) or (start_y != target_y):\n          if start_x < target_x:\n              path.append(3)  # RIGHT\n              start_x += 1\n          elif start_x > target_x:\n              path.append(2)  # LEFT\n              start_x -= 1\n\n          if start_y < target_y:\n              path.append(1)  # UP\n              start_y += 1\n          elif start_y > target_y:\n              path.append(0)  # DOWN\n              start_y -= 1\n      return path\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  path_to_reach_workshop = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(path_to_reach_workshop)\n\n  for action in path_to_reach_workshop:\n      actions.append(action)\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T14:27:29.102601", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start_x, start_y, target_x, target_y):\n      actions = []\n      \n      while (start_x != target_x) or (start_y != target_y):\n          if start_x < target_x:\n              actions.append(3)  # RIGHT\n              start_x += 1\n          elif start_x > target_x:\n              actions.append(2)  # LEFT\n              start_x -= 1\n\n          if start_y < target_y:\n              actions.append(1)  # UP\n              start_y += 1\n          elif start_y > target_y:\n              actions.append(0)  # DOWN\n              start_y -= 1\n\n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(calculate_path(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action) when reaching the workshop\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T14:29:10.860627", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes.get(item_index)\n    if not recipe:\n        raise ValueError(f\"No recipe found for item with index {item_index}.\")\n    \n    missing_items = {\n        i: amount - inventory[i]\n        for i, amount in recipe.items()\n        if i != '_at' and inventory[i] < amount\n    }\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      \n      # Check if the primitive is a crafted item.\n      primitive_index = cookbook.index.get(primitive_name)\n      if not primitive_index:\n          raise ValueError(f\"No index found for {primitive_name} in cookbook.\")\n\n      # Find all positions of the specified primitive in the grid.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n          if primitive_index in cookbook.recipes:\n              actions_to_take.extend(craft_v2(env, primitive_name))\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n              actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n              inventory[primitive_index] += required_amount\n              missing_items.pop(primitive_name, None)\n          else:\n              raise ValueError(f\"No primitives found for {item} and it cannot be crafted.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index.get(item)\n\n  if not item_index:\n      raise ValueError(f\"No index found for {item} in cookbook.\")\n\n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        actions_to_take.append(4)  # Use action to craft the item at the workshop.\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T14:29:11.981887", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive can be crafted, recursively ensure it's in inventory.\n      if primitive_index in cookbook.recipes:\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n      \n      # Find positions of available primitives.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the USE action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T14:31:26.347305", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def prioritize_primitives(primitives_needed):\n    # Define a priority list based on some criteria (e.g., availability, urgency)\n    priority_list = [\n      'WORKSHOP0', 'WORKSHOP1', 'WORKSHOP2', \n      'WOOD', 'IRON', 'GRASS', 'ROCK', \n      'GOLD', 'GEM', 'WATER', 'STONE'\n    ]\n    \n    cookbook = env.world.cookbook\n    priority_indices = {cookbook.index[name]: i for i, name in enumerate(priority_list)}\n    \n    # Sort primitives by their priority index\n    sorted_primitives = sorted(primitives_needed.items(), key=lambda x: priority_indices.get(x[0], len(priority_indices)))\n    \n    return dict(sorted_primitives)\n\n  def handle_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    actions_to_take = []\n    for primitive_index, count in recipe.items():\n      if primitive_index not in env._current_state.inventory or env._current_state.inventory[primitive_index] < count:\n        raise ValueError(f\"Not enough {cookbook.index.reverse_lookup(primitive_index)} in inventory to craft the item.\")\n      \n      # If there are more than needed, adjust inventory\n      elif env._current_state.inventory[primitive_index] > count:\n        actions_to_take.append(4)  # Assume USE action can discard excess items (if applicable)\n        env._current_state.inventory[primitive_index] -= 1\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Prioritize primitives based on some criteria\n    recipe = prioritize_primitives(recipe)\n\n    # Handle inventory to ensure we have exactly what is needed and discard excess if possible\n    actions_to_take = handle_inventory(env, recipe)\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_index)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
