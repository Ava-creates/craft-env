ex] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_index)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T19:11:34.583548", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        actions_to_take.append(4)  # Use action to collect the primitive\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def craft_at_closest_workshop(env, workshop_index):\n    actions_to_take = []\n    \n    # Find the closest workshop position to craft at\n    target_workshop_pos = find_closest_workshop(env, workshop_index)\n    \n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n    \n    actions_to_take.append(4)  # Use action to craft the item\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index].copy()\n\n    workshop_name = recipe.pop('_at')\n    \n    actions_to_take = collect_primitives(env, recipe)\n    \n    actions_to_take.extend(craft_at_closest_workshop(env, workshop_name))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T19:11:35.645291", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def move_and_use(env, target_pos):\n    actions_to_take = get_move_actions(target_pos)\n    actions_to_take.append(4)  # USE action to collect or craft\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe.pop('_at')\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Find and move to the closest workshop position to craft at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n    actions_to_take.extend(move_and_use(env, target_workshop_pos))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T19:14:42.519076", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        path_to_primitive = find_path(env, tuple(closest_primitive))\n        actions_to_take.extend(get_move_actions_from_path(path_to_primitive))\n\n        # Assuming USE is used for collecting as well.\n        actions_to_take.append(4)\n\n        env._current_state.inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def find_path(env, target_pos):\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n\n    from collections import deque\n    \n    queue = deque([current_pos])\n    visited = set()\n    parent = {}\n    \n    while queue:\n      pos = queue.popleft()\n      if pos == target_pos:\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = pos[0] + dx, pos[1] + dy\n        if (new_x, new_y) not in visited and grid[new_x, new_y].sum() == 0:  # Assuming empty tiles sum to 0\n          queue.append((new_x, new_y))\n          visited.add((new_x, new_y))\n          parent[(new_x, new_y)] = pos\n    \n    path = []\n    while target_pos in parent:\n      path.append(target_pos)\n      target_pos = parent[target_pos]\n    \n    return list(reversed(path))\n\n  def get_move_actions_from_path(path):\n    actions_to_take = []\n    current_pos = env._current_state.pos\n\n    for next_pos in path:\n        rel_x, rel_y = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n\n        if rel_x > 0:\n            actions_to_take.append(3)  # Move RIGHT\n        elif rel_x < 0:\n            actions_to_take.append(2)  # Move LEFT\n                \n        if rel_y > 0:\n            actions_to_take.append(1)  # Move DOWN\n        elif rel_y < 0:\n            actions_to_take.append(0)  # Move UP\n\n        current_pos = next_pos\n\n    return actions_to_take\n\n  def is_workshop_reachable(env, workshop_positions):\n    for workshop in workshop_positions:\n      path = find_path(env, workshop)\n      if path:\n        return True\n    return False\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - env._current_state.inventory[i] for i, amount in recipe.items() if i != '_at' and env._current_state.inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      \n      # If the primitive is a component or another item that needs crafting\n      if cookbook.index[primitive_name] in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, cookbook.index[primitive_name]))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, cookbook.index[primitive_name]] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        path_to_primitive = find_path(env, tuple(closest_primitive))\n        actions_to_take.extend(get_move_actions_from_path(path_to_primitive))\n\n        # Assuming USE is used for collecting as well.\n        actions_to_take.append(4)\n\n        env._current_state.inventory[cookbook.index[primitive_name]] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0 and is_workshop_reachable(env, workshop_positions):\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      )\n      \n      path_to_workshop = find_path(env, tuple(closest_workshop))\n      actions_to_take.extend(get_move_actions_from_path(path_to_workshop))\n\n      # Assuming USE is used for crafting as well.\n      actions_to_take.append(4)\n\n      # Update inventory to reflect crafting\n      update_inventory(env, item_index)\n\n      return actions_to_take\n\n    else:\n        raise ValueError(f\"No reachable workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
