._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n        \n        break  # Collect only one instance of the primitive\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) == 0:\n        raise ValueError(f\"No workshops found for crafting {cookbook.reverse_index[item_index]}.\")\n    \n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    return tuple(closest_workshop)\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = env.world.cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        # Collect primitives required for the current item\n        for primitive_index, count in recipe.items():\n            for _ in range(count):\n                actions_to_take.extend(collect_primitive(env, primitive_index))\n        \n        # Craft the current item\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-19T21:58:10.021908", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        sorted_positions = sorted(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        for pos in sorted_positions:\n          pos_tuple = tuple(pos)\n          \n          actions_to_take.extend(get_move_actions(pos_tuple))\n          actions_to_take.append(4)  # Collect the primitive\n          env._current_state.inventory[primitive_index] += count\n\n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 10.199999}}
{"timestamp": "2025-09-19T21:58:11.032268", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    cookbook = env.world.cookbook\n    required_amount = cookbook.recipes[primitive_index].get(primitive_index, 1)\n    \n    if (env._current_state.inventory.get(primitive_index, 0) >= required_amount):\n        return []\n    \n    actions_to_take = []\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) > 0:\n      current_pos = env._current_state.pos\n\n      sorted_positions = sorted(\n          primitive_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      for pos in sorted_positions:\n        actions_to_take.extend(get_move_actions(tuple(pos)))\n        actions_to_take.append(4)  # Collect the primitive\n        env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n        \n        if env._current_state.inventory[primitive_index] >= required_amount:\n          break\n\n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = env.world.cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        # Collect primitives needed\n        for primitive_index, count in recipe.items():\n          actions_to_take.extend(collect_primitive(env, primitive_index))\n        \n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-19T22:00:37.992965", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Sort positions by distance to current position\n        current_pos = env._current_state.pos\n        sorted_positions = sorted(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        for pos in sorted_positions:\n          pos_tuple = tuple(pos)\n          \n          if pos_tuple not in visited_positions:\n              actions_to_take.extend(get_move_actions(pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] += 1\n              \n              visited_positions.add(pos_tuple)\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 11.599999}}
{"timestamp": "2025-09-19T22:00:38.958466", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Sort positions by distance to current position\n        current_pos = env._current_state.pos\n        sorted_positions = sorted(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        for pos in sorted_positions:\n          pos_tuple = tuple(pos)\n          \n          if pos_tuple not in visited_positions and env._current_state.inventory.get(primitive_index, 0) < count:\n              actions_to_take.extend(get_move_actions(pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n              \n              visited_positions.add(pos_tuple)\n\n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index, count_needed=1):\n      \"\"\"Check if the required amount of an item is in the inventory.\"\"\"\n      return env._current_state.inventory.get(item_index, 0) >= count_needed\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if not is_item_collected(k, v)}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-19T22:03:20.852615", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Sort positions by distance to current position\n        current_pos = env._current_state.pos\n        sorted_positions = sorted(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        for pos in sorted_positions:\n          pos_tuple = tuple(pos)\n          \n          if pos_tuple not in visited_positions:\n              actions_to_take.extend(get_move_actions(pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] += 1\n              \n              visited_positions.add(pos_tuple)\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  def optimize_actions(actions):\n      \"\"\"Optimize a sequence of actions to reduce redundant moves.\"\"\"\n      optimized = []\n      \n      i = 0\n      while i < len(actions) - 1:\n          current_action = actions[i]\n          next_action = actions[i + 1]\n          \n          # If two consecutive actions are opposite, they cancel each other out\n          if (current_action == 0 and next_action == 1) or\\\n             (current_action == 1 and next_action == 0) or\\\n             (current_action == 2 and next_action == 3) or\\\n             (current_action == 3 and next_action == 2):\n              i += 2\n          else:\n              optimized.append(current_action)\n              i += 1\n      \n      # Add the last action if not cancelled\n      if actions and len(actions) > 0:\n          optimized.append(actions[-1])\n      \n      return optimized\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  # Optimize the sequence of actions\n  optimized_actions = optimize_actions(actions_to_take)\n  \n  return optimized_actions", "island_id": 6, "scores": {"3": 11.599999}}
{"timestamp": "2025-09-19T22:03:21.858643", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    # Prioritize collecting primitives that are closest to the current position\n    current_pos = env._current_state.pos\n    \n    while primitives_needed:\n        # Find all positions of the required primitives in the grid\n        all_primitive_positions = []\n        for primitive_index, count in primitives_needed.items():\n            if count > 0:\n                primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n                all_primitive_positions.extend([(pos, primitive_index) for pos in primitive_positions])\n        \n        # Sort positions by distance to current position\n        sorted_positions = sorted(\n            all_primitive_positions, \n            key=lambda x: abs(x[0][0] - current_pos[0]) + abs(x[0][1] - current_pos[1])\n        )\n        \n        if not sorted_positions:\n            raise ValueError(\"Unable to find required primitives in the grid.\")\n        \n        # Collect the closest primitive\n        pos, primitive_index = sorted_positions[0]\n        pos_tuple = tuple(pos)\n        \n        if pos_tuple not in visited_positions:\n            actions_to_take.extend(get_move_actions(pos))\n            \n            # Use the USE action to collect the primitive\n            actions_to_take.append(4)\n            \n            # Update inventory and decrease the count of needed primitives\n            env._current_state.inventory[primitive_index] += 1\n            primitives_needed[primitive_index] -= 1\n            \n            visited_positions.add(pos_tuple)\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
