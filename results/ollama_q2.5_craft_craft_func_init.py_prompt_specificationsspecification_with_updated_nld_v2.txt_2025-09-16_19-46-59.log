1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:50:07.737742", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def gather_primitives(env, primitives):\n    actions_to_take = []\n    for primitive in primitives:\n      primitive_index = env.world.cookbook.index[primitive]\n      while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        \n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_position)))\n        \n        # Align with the target position before collecting.\n        actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n        \n        # Collect the primitive using USE action\n        actions_to_take.append(4)\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:51:52.117880", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-16T23:51:53.181495", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-16T23:57:41.896584", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move_to(target_x, target_y):\n      while env._current_state.pos != (target_x, target_y):\n          cx, cy = env._current_state.pos\n          dx = target_x - cx\n          dy = target_y - cy\n\n          if abs(dx) > abs(dy):\n              action = 3 if dx > 0 else 2  # RIGHT or LEFT\n          else:\n              action = 1 if dy > 0 else 0  # UP or DOWN\n          \n          actions.append(action)\n          env.step(action)\n\n  move_to(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:57:43.023371", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      while dx != 0 or dy != 0:\n          # Determine the direction to move based on remaining distance\n          if abs(dx) > abs(dy):\n              step_x = np.sign(dx)\n              step_y = 0\n          else:\n              step_x = 0\n              step_y = np.sign(dy)\n\n          dx -= step_x\n          dy -= step_y\n\n          # Convert the direction to the corresponding action index\n          if step_x == -1:\n              actions.append(2)  # LEFT\n          elif step_x == 1:\n              actions.append(3)  # RIGHT\n          elif step_y == -1:\n              actions.append(0)  # DOWN\n          elif step_y == 1:\n              actions.append(1)  # UP\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:58:50.671908", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Check if the agent is already next to a workshop\n  if env._current_state.next_to(workshop_index):\n      return [4]  # USE\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T23:58:51.727840", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Turn towards the workshop\n  target_dir = np.arctan2(target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0])\n  current_dir = env._current_state.dir * (np.pi / 2)  # Convert direction to radians\n\n  angle_diff = (target_dir - current_dir + np.pi) % (2 * np.pi) - np.pi\n  if angle_diff > 0:\n      actions_to_reach_workshop.extend([3] * int(np.ceil(angle_diff / (np.pi / 2))))  # RIGHT turns\n  elif angle_diff < 0:\n      actions_to_reach_workshop.extend([2] * int(np.ceil(-angle_diff / (np.pi / 2))))  # LEFT turns\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-09-17T00:00:05.053907", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              \n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n\n  # Ensure the agent is facing the correct direction before using\n  current_dir = env._current_state.dir\n  target_dir = get_direction(env._current_state.pos, target_pos)\n  \n  if target_dir:\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      actions.append(dir_map[target_dir])\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-17T00:00:06.162115", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  def find_closest_workshop(env, workshop_index):\n      grid = env._current_state.grid\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(workshop_positions) == 0:\n          raise ValueError(\"No workshops found in the environment.\")\n      \n      current_pos = np.array(env._current_state.pos)\n      closest_workshop = min(workshop_positions, key=lambda x: np.linalg.norm(np.array(x) - current_pos))\n      return tuple(closest_workshop)\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find the closest workshop position\n  target_pos = find_closest_workshop(env, workshop_index)\n  actions = move_to(env, target_pos)\n\n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
