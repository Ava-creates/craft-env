cipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 11.599999}}
{"timestamp": "2025-09-19T20:32:59.085492", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Sort positions by distance to current position\n        current_pos = env._current_state.pos\n        sorted_positions = sorted(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        for pos in sorted_positions:\n          pos_tuple = tuple(pos)\n          \n          if pos_tuple not in visited_positions:\n              actions_to_take.extend(get_move_actions(pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] += 1\n              \n              visited_positions.add(pos_tuple)\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  def check_availability_of_workshops(cookbook):\n      \"\"\"Check if all required workshops are available in the environment.\"\"\"\n      workshop_indices = set()\n      \n      for recipe in cookbook.recipes.values():\n          if '_at' in recipe:\n              workshop_name = recipe['_at']\n              if workshop_name in cookbook.index:\n                  workshop_indices.add(cookbook.index[workshop_name])\n              else:\n                  raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n      \n      return workshop_indices\n\n  def check_availability_of_primitives(primitives, cookbook):\n      \"\"\"Check if all required primitives are available in the environment.\"\"\"\n      primitive_names = set(cookbook.index.keys())\n      \n      for primitive in primitives:\n          if primitive not in primitive_names:\n              raise ValueError(f\"Primitive {primitive} not found in the environment.\")\n  \n  def validate_environment(cookbook, env):\n      \"\"\"Validate that all required items and workshops are available in the environment.\"\"\"\n      workshop_indices = check_availability_of_workshops(cookbook)\n      \n      # Check if workshops are present in the grid\n      for workshop_index in workshop_indices:\n          if np.sum(env._current_state.grid[:, :, workshop_index]) == 0:\n              raise ValueError(f\"No instances of workshop {workshop_index} found in the environment.\")\n      \n      primitives = set()\n      for recipe in cookbook.recipes.values():\n          primitives.update(recipe.keys())\n      \n      check_availability_of_primitives(primitives, cookbook)\n      \n      # Check if primitives are present in the grid\n      for primitive_name in primitives:\n          primitive_index = cookbook.index[primitive_name]\n          if np.sum(env._current_state.grid[:, :, primitive_index]) == 0:\n              raise ValueError(f\"No instances of {primitive_name} found in the environment.\")\n\n  def update_env_state_after_crafting(env, item_index):\n    \"\"\"Update the environment state after crafting an item.\"\"\"\n    cookbook = env.world.cookbook\n    if item_index not in env._current_state.inventory:\n        env._current_state.inventory[item_index] = 0\n    \n    # Increment the count of the crafted item in inventory\n    env._current_state.inventory[item_index] += 1\n\n  def check_goal_satisfied(env, goal_item):\n      \"\"\"Check if the goal item is collected.\"\"\"\n      cookbook = env.world.cookbook\n      goal_item_index = cookbook.index[goal_item]\n      \n      return goal_item_index in env._current_state.inventory and env._current_state.inventory[goal_item_index] > 0\n\n  def execute_recipe(env, recipe_hierarchy):\n    actions_to_take = []\n    \n    for sub_recipe in recipe_hierarchy['sub_recipes'].values():\n        actions_to_take.extend(execute_recipe(env, sub_recipe))\n    \n    item_index = recipe_hierarchy['item']\n    \n    if is_item_collected(item_index):\n        return actions_to_take\n    \n    # Collect primitives needed\n    actions_to_take.extend(collect_primitives(env, cookbook.recipes[item_index]))\n    \n    # Craft the item\n    actions_to_take.extend(craft_item(env, item_index))\n    \n    # Update environment state after crafting\n    update_env_state_after_crafting(env, item_index)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  # Validate the environment\n  validate_environment(cookbook, env)\n  \n  # Get the hierarchy of recipes needed to craft the item\n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n\n  # Execute the recipe hierarchy\n  actions_to_take = execute_recipe(env, recipe_hierarchy)\n\n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-19T20:35:22.052723", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    \n    # Collect each primitive required for the recipe\n    for primitive_index, count in primitives_needed.items():\n      while env._current_state.inventory[primitive_index] < count:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"No {cookbook.index.reverse[primitive_index]} found in the environment.\")\n          \n          # Sort positions by distance to current position\n          current_pos = env._current_state.pos\n          sorted_positions = sorted(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          for pos in sorted_positions:\n              pos_tuple = tuple(pos)\n              \n              # Move to the closest position of the primitive\n              actions_to_take.extend(get_move_actions(pos_tuple))\n              actions_to_take.append(4)  # Collect the primitive\n              env._current_state.inventory[primitive_index] += 1\n              break  # Only collect one at a time\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n      cookbook = env.world.cookbook\n      for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        # Collect all required primitives\n        actions_to_take.extend(collect_primitives(env, recipe))\n        \n        # Craft the item\n        actions_to_take.extend(craft_item(env, item_to_craft))\n        \n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": 11.199999}}
