= np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:53:28.572846", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  def find_item_path(start_pos, item_index):\n    \"\"\"Find the path to the nearest item of type `item_index`.\"\"\"\n    target_positions = np.argwhere(grid[:, :, item_index] == 1)\n    if len(target_positions) == 0:\n      raise ValueError(f\"No available {index.get_name(item_index)} in the grid\")\n\n    closest_target = min(target_positions, key=lambda pos: heuristic(start_pos, tuple(pos)))\n    return a_star(start_pos, tuple(closest_target))\n\n  def collect_primitives(env, item):\n    \"\"\"Collect all primitives required to craft `item`.\"\"\"\n    actions = []\n    cookbook = env.world.cookbook\n    index = cookbook.index\n    output_index = index[item]\n\n    if output_index is None:\n      raise ValueError(f\"Unknown item: {item}\")\n\n    recipe = cookbook.recipes[output_index]\n    start_pos = env._current_state.pos\n\n    for primitive, count in recipe.items():\n      if primitive == \"_at\":  # Skip the workshop key\n        continue\n\n      primitive_index = index.get(primitive)\n      if primitive_index is None:\n        raise ValueError(f\"Unknown primitive: {primitive}\")\n\n      path_to_primitive = find_item_path(start_pos, primitive_index)\n\n      for i in range(len(path_to_primitive) - 1):\n          next_pos = path_to_primitive[i + 1]\n          delta_x = next_pos[0] - path_to_primitive[i][0]\n          delta_y = next_pos[1] - path_to_primitive[i][1]\n\n          if delta_x < 0:\n              actions.append(action_map[\"LEFT\"])\n          elif delta_x > 0:\n              actions.append(action_map[\"RIGHT\"])\n          elif delta_y < 0:\n              actions.append(action_map[\"DOWN\"])\n          else:\n              actions.append(action_map[\"UP\"])\n\n      # Collect the primitive\n      actions.append(env.action_specs()[\"USE\"])\n\n      # Update start position for next iteration\n      start_pos = path_to_primitive[-1]\n\n    return actions\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Collect all primitives required to craft the item\n  actions.extend(collect_primitives(env, item))\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path_to_workshop = a_star(current_pos, target_pos)\n\n  if not path_to_workshop:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  # Convert the path into actions\n  for i in range(len(path_to_workshop) - 1):\n    next_pos = path_to_workshop[i + 1]\n    delta_x = next_pos[0] - path_to_workshop[i][0]\n    delta_y = next_pos[1] - path_to_workshop[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:54:06.548575", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Determine the workshop required from the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_indices = [index for index, name in enumerate(env.world.workshop_indices) if env.world.cookbook.index.get(name) == workshop_name]\n\n  if not workshop_indices:\n    raise ValueError(f\"No matching workshop found for {item} at {workshop_name}\")\n\n  # Assuming there is only one workshop of the required type\n  workshop_index = workshop_indices[0]\n\n  # Convert the workshop index to the grid position (assuming workshops are placed in a linear fashion)\n  width, height = env.world.scenario.init_grid.shape[:2]\n  workshop_pos = (workshop_index % width, workshop_index // width)\n\n  # Move to the workshop\n  actions.extend(move_to(env._current_state, workshop_pos))\n\n  # Craft the item at the workshop\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:54:07.520036", "function_name": "craft", "function_body": "  # Get index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Check which workshop is required to craft this item\n  workshop_name = recipe.pop('_at')\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get all workshops of that kind in the grid\n  workshops_indices = np.where(env._current_state.grid[:, :, workshop_index] == 1)\n\n  # If no workshops are found, raise an error\n  if len(workshops_indices[0]) == 0:\n    raise ValueError(f\"No {workshop_name} found in the grid.\")\n  \n  # Select the closest workshop\n  agent_pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop = None\n  for w_x, w_y in zip(*workshops_indices):\n    distance = np.linalg.norm(agent_pos - np.array([w_x, w_y]))\n    if distance < min_distance:\n      min_distance = distance\n      closest_workshop = (w_x, w_y)\n\n  # Calculate the path to the closest workshop\n  actions_to_reach_workshop = a_star_search(env._current_state.grid, agent_pos, np.array(closest_workshop))\n\n  # Action index for USE action\n  use_action_index = 4\n  \n  # Combine all actions\n  actions = [action_indices(action) for action in actions_to_reach_workshop] + [use_action_index]\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:00:37.575147", "function_name": "craft", "function_body": "  def get_shortest_path(start, target):\n      grid = env._current_state.grid\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      # BFS to find shortest path\n      queue = collections.deque([start])\n      parent = {start: None}\n      visited = set()\n      \n      while queue:\n          pos = queue.popleft()\n          \n          if pos == target:\n              break\n          \n          if pos in visited:\n              continue\n          \n          visited.add(pos)\n          \n          for direction in directions:\n              new_pos = (pos[0] + direction[0], pos[1] + direction[1])\n              \n              # Check bounds and passable cells\n              if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n                  if env._current_state.grid[new_pos].sum() == 0 or env.world.cookbook.index[\"BOUNDARY\"] not in [i for i, v in enumerate(env._current_state.grid[new_pos]) if v > 0]:\n                      queue.append(new_pos)\n                      parent[new_pos] = pos\n      \n      # Reconstruct path\n      path = []\n      while target:\n          path.append(target)\n          target = parent[target]\n      \n      return path[::-1]\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Calculate shortest path to the target workshop\n  path = get_shortest_path(current_pos, target_workshop_position)\n  \n  # Create a list to store the actions\n  actions = []\n  \n  for i in range(len(path) - 1):\n      next_pos = path[i + 1]\n      \n      delta_x = next_pos[0] - path[i][0]\n      delta_y = next_pos[1] - path[i][1]\n      \n      # Determine direction to move\n      if delta_x > 0:\n          actions.append(RIGHT)\n      elif delta_x < 0:\n          actions.append(LEFT)\n      elif delta_y > 0:\n          actions.append(DOWN)\n      else:  # delta_y < 0\n          actions.append(UP)\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:00:38.683471", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for item {item}.\")\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  def move_to_position(target_pos):\n      actions = []\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n      \n      # Calculate the absolute distances to move\n      abs_delta_x = abs(delta_x)\n      abs_delta_y = abs(delta_y)\n      \n      # Determine the most efficient path considering direction changes are costly\n      if abs_delta_x > abs_delta_y:\n          # Move along x-axis first\n          if delta_x < 0:\n              actions.extend([LEFT]*abs_delta_x)  # move left\n          else:\n              actions.extend([RIGHT]*abs_delta_x)  # move right\n          \n          # Adjust direction for movement in y direction after moving horizontally\n          if delta_y < 0:\n              actions.append(UP)  # change direction to up\n          elif delta_y > 0:\n              actions.append(DOWN)  # change direction to down\n          \n          # Move along y-axis\n          if delta_y < 0:\n              actions.extend([UP]*abs_delta_y)  # move up\n          else:\n              actions.extend([DOWN]*abs_delta_y)  # move down\n      \n      else:\n          # Move along y-axis first\n          if delta_y < 0:\n              actions.append(UP)  # change direction to up\n          elif delta_y > 0:\n              actions.append(DOWN)  # change direction to down\n          \n          # Move along y-axis\n          if delta_y < 0:\n              actions.extend([UP]*abs_delta_y)  # move up\n          else:\n              actions.extend([DOWN]*abs_delta_y)  # move down\n          \n          # Adjust direction for movement in x direction after moving vertically\n          if delta_x < 0:\n              actions.append(LEFT)  # change direction to left\n          elif delta_x > 0:\n              actions.append(RIGHT)  # change direction to right\n          \n          # Move along x-axis\n          if delta_x < 0:\n              actions.extend([LEFT]*abs_delta_x)  # move left\n          else:\n              actions.extend([RIGHT]*abs_delta_x)  # move right\n      \n      return actions\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions = move_to_position(target_workshop_position)\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T22:01:51.387627", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def calculate_path(current_pos, target_pos):\n      path = []\n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          if direction is not None:\n              path.append(direction)\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return path\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate path to the workshop\n  path = calculate_path(current_pos, target_pos)\n  actions = [dir_map[direction] for direction in path]\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
