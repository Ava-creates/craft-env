hile not check_inventory(env, recipe):\n        actions_to_take = collect_primitives(env, recipe)\n        \n        # Move back to the closest workshop after collecting primitives\n        target_workshop_pos = tuple(min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        ))\n        \n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n    \n    # Navigate to the closest workshop and craft the item\n    actions_to_take = navigate_and_craft(env, item_index, workshop_positions)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
