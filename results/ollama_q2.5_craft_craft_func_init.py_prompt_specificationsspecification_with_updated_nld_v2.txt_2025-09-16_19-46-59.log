\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:23:06.969090", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    # Calculate relative position\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    # Determine direction to move\n    if rel_x > 0:\n        actions_to_take.extend([3] * abs(rel_x))  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * abs(rel_y))  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def find_closest_workshop(world, grid, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find the closest available workshop position to craft the item at\n    target_workshop_pos = find_closest_workshop(world, env._current_state.grid, workshop_index)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:24:50.840199", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the shortest path using Manhattan distance heuristics\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n    \n    return actions_to_take\n\n  def check_inventory_for_recipe(recipe):\n    current_inventory = env._current_state.features_dict['inventory']\n    for ingredient, required_quantity in recipe.items():\n      if ingredient == '_at':\n          continue\n      available_quantity = sum(current_inventory[i] for i, item_index in enumerate(env.world.cookbook.index) if item_index == ingredient)\n      if available_quantity < required_quantity:\n          return False\n    return True\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Check if the inventory has all the required ingredients\n    if not check_inventory_for_recipe(recipe):\n      raise ValueError(f\"Inventory does not have enough ingredients for crafting {item}.\")\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:24:51.917671", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the shortest path using Manhattan distance heuristics\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n    \n    return actions_to_take\n\n  def ensure_primitives(item_index):\n      cookbook = env.world.cookbook\n      inventory = env._current_state.inventory\n      primitives_needed = {}\n      \n      # Depth-first search to find all primitives required for the item\n      stack = [item_index]\n      while stack:\n          current_item = stack.pop()\n          \n          if current_item in cookbook.recipes:\n              recipe = cookbook.recipes[current_item]\n              \n              for ingredient, quantity in recipe.items():\n                  if isinstance(ingredient, str) and ingredient not in ['_at']:\n                      ingredient_index = cookbook.index[ingredient]\n                      \n                      # If the primitive is needed more than once, increase its count\n                      if ingredient_index not in primitives_needed:\n                          primitives_needed[ingredient_index] = 0\n                          \n                      primitives_needed[ingredient_index] += quantity\n                      \n                      # Push to stack only if it's a recipe and we don't have enough in inventory\n                      if ingredient_index in cookbook.recipes and inventory.get(ingredient_index, 0) < quantity:\n                          stack.append(ingredient_index)\n          else:\n              primitives_needed[current_item] = 1\n      \n      return primitives_needed\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the primitives needed for the item\n    primitives_needed = ensure_primitives(item_index)\n    \n    # Collect all primitives not currently in inventory\n    actions_to_take = []\n    for primitive_index, quantity in primitives_needed.items():\n        current_quantity = env._current_state.inventory.get(primitive_index, 0)\n        \n        if current_quantity < quantity:\n            primitive_name = cookbook.index[primitive_index]\n            \n            # Find the closest position of this primitive on the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            for _ in range(quantity - current_quantity):\n                if len(primitive_positions) > 0:\n                    closest_primitive_pos = min(\n                        primitive_positions, \n                        key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                    )\n                    \n                    target_primitive_pos = tuple(closest_primitive_pos)\n                    \n                    # Calculate move actions to reach the closest primitive\n                    actions_to_take.extend(get_move_actions(target_primitive_pos))\n                    \n                    # Use the USE action to collect the primitive\n                    actions_to_take.append(4)\n\n    # Craft the item after ensuring all primitives are collected\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:26:04.820335", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    while current_pos != target_pos:\n      rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n        \n      if rel_y > 0:\n        # Move DOWN\n        actions_to_take.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif rel_y < 0:\n        # Move UP\n        actions_to_take.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:26:05.889250", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move in the direction that requires fewer steps first to optimize path\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T03:27:28.617231", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      \"\"\"Find the closest workshop to the current position.\"\"\"\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Get the workshop name and index from the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Determine the closest workshop to move towards\n  current_pos = env._current_state.pos\n  target_workshop_pos = find_closest_workshop(workshop_positions, current_pos)\n\n  # Generate actions to move towards the workshop\n  actions_to_reach_workshop = move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n\n  # Add USE action to craft the item at the workshop\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T03:27:29.773699", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      \"\"\"Find the closest workshop to the current position.\"\"\"\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  def orient_towards(target_x, target_y, current_x, current_y):\n      \"\"\"Determine the direction to face towards the target position.\"\"\"\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      if abs(dx) > abs(dy):  # More horizontal movement needed\n          if dx > 0:\n              return 3  # RIGHT\n          else:\n              return 2  # LEFT\n      else:  # More vertical movement needed or equal\n          if dy > 0:\n              return 1  # UP\n          else:\n              return 0  # DOWN\n\n  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Get the workshop name and index from the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Determine the closest workshop to move towards\n  current_pos = env._current_state.pos\n  target_workshop_pos = find_closest_workshop(workshop_positions, current_pos)\n\n  # Generate actions to move and orient towards the workshop\n  actions_to_reach_workshop = []\n  while tuple(current_pos) != target_workshop_pos:\n      orientation_action = orient_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n      if env._current_state.dir != orientation_action:\n          actions_to_reach_workshop.append(orientation_action)\n      else:\n          move_action = move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n          actions_to_reach_workshop.extend(move_action)\n\n      # Update current position\n      action_to_take = actions_to_reach_workshop[-1]\n      new_x, new_y = current_pos\n      if action_to_take == 3:  # RIGHT\n          new_x += 1\n      elif action_to_take == 2:  # LEFT\n          new_x -= 1\n      elif action_to_take == 1:  # UP\n          new_y += 1\n      elif action_to_take == 0:  # DOWN\n          new_y -= 1\n\n      current_pos = (new_x, new_y)\n\n  # Add USE action to craft the item at the workshop\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 3.7}}
{"timestamp": "2025-09-17T03:28:36.908258", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  def next_to(target_x, target_y, current_x, current_y):\n      \"\"\"Check if the target position is adjacent to the current position.\"\"\"\n      return abs(target_x - current_x) <= 1 and abs(target_y - current_y) <= 1\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = env._current_state.pos\n\n  while True:  # Continue until we are next to a workshop\n      target_workshop_pos = find_closest_workshop(workshop_positions, current_pos)\n      \n      if next_to(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1]):\n          break\n\n      actions_to_reach_workshop = move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n      for action in actions_to_reach_workshop:\n          reward, done, observations = env.step(action)\n          if done:\n              return []\n      \n      # Update the current position after each step\n      current_pos = (observations[\"features_dict\"][\"task\"][\"position\"][0],\n                     observations[\"features_dict\"][\"task\"][\"position\"][1])\n\n  actions_to_craft = [4]  # USE to craft the item\n\n  return actions_to_craft", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:28:38.034289", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n  \n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n\n  if not env._current_state.next_to(workshop_index):\n      # Add USE action only if the agent is not already next to the workshop\n      actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 3.9}}
{"timestamp": "2025-09-17T03:30:41.418205", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the closest workshop to the current position\n  target_pos = min(workshop_positions, key=lambda pos: heuristic(current_pos, tuple(pos)))\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T03:30:42.418427", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  def collect_primitives(env, primitives):\n      actions = []\n      for primitive in primitives:\n          # Find all positions of the primitive in the grid\n          grid = env._current_state.grid\n          index = env.world.cookbook.index\n          primitive_index = index[primitive]\n          if primitive_index is None:\n              raise ValueError(f\"Unknown primitive: {primitive}\")\n\n          primitive_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n          if len(primitive_positions) == 0:\n              raise ValueError(f\"No available primitives for {primitive}\")\n\n          current_pos = env._current_state.pos\n\n          # For simplicity, we pick the first available primitive\n          target_pos = tuple(primitive_positions[0])\n\n          # Calculate the path to the target position using A* algorithm\n          path = a_star(current_pos, target_pos)\n\n          if not path:\n              raise ValueError(f\"No valid path to {primitive}\")\n\n          # Convert the path into actions\n          action_map = {\n              \"UP\": env.action_specs()[\"UP\"],\n              \"DOWN\": env.action_specs()[\"DOWN\"],\n              \"LEFT\": env.action_specs()[\"LEFT\"],\n              \"RIGHT\": env.action_specs()[\"RIGHT\"]\n          }\n\n          current_dir = env._current_state.dir\n\n          for i in range(len(path) - 1):\n              next_pos = path[i + 1]\n              delta_x = next_pos[0] - path[i][0]\n              delta_y = next_pos[1] - path[i][1]\n\n              if delta_x < 0:\n                  actions.append(action_map[\"LEFT\"])\n              elif delta_x > 0:\n                  actions.append(action_map[\"RIGHT\"])\n              elif delta_y < 0:\n                  actions.append(action_map[\"DOWN\"])\n              else:\n                  actions.append(action_map[\"UP\"])\n\n          # Add action to collect the primitive\n          actions.append(env.action_specs()[\"USE\"])\n\n      return actions\n\n  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n\n  # Determine the required workshop and primitives\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n  primitives = [key for key in recipe if key not in [\"_at\", \"_in\"]]\n\n  # Collect all required primitives\n  actions.extend(collect_primitives(env, primitives))\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
