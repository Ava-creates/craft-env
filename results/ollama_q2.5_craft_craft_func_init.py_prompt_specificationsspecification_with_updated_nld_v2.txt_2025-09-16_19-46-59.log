tive_index] += 1\n        \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe['_at']\n    del recipe['_at']\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T18:37:50.143531", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move towards the workshop while avoiding obstacles using A* algorithm for better path finding\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def astar(start, goal):\n      open_set = set()\n      closed_set = set()\n      g = {start: 0}\n      f = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda k: f[k])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and \\\n                 0 <= neighbor[1] < env._current_state.grid.shape[1] and \\\n                 not np.any(env._current_state.grid[neighbor[0], neighbor[1], :] > 0):\n                  tentative_g = g[current] + heuristic(current, neighbor)\n                  if neighbor not in open_set or tentative_g < g.get(neighbor, float('inf')):\n                      came_from[neighbor] = current\n                      g[neighbor] = tentative_g\n                      f[neighbor] = tentative_g + heuristic(neighbor, goal)\n                      if neighbor not in open_set:\n                          open_set.add(neighbor)\n\n      return None  # No path found\n\n  path = astar((current_x, current_y), (target_x, target_y))\n  if path is None:\n      raise ValueError(\"No path to the workshop.\")\n\n  for x, y in path[1:]:\n      dx, dy = x - current_x, y - current_y\n      actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n      current_x, current_y = x, y\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T18:42:50.216486", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def is_valid_position(x, y):\n      return (0 <= x < env._current_state.grid.shape[0] and \n              0 <= y < env._current_state.grid.shape[1])\n\n  def move_towards(target_x, target_y):\n    nonlocal current_x, current_y\n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n    while (current_x != target_x) or (current_y != target_y):\n        min_distance = float('inf')\n        best_direction = None\n        for dx, dy in directions:\n            new_x, new_y = current_x + dx, current_y + dy\n            if is_valid_position(new_x, new_y) and env._current_state.grid[new_x, new_y].sum() == 0:  # Check if the cell is empty\n                distance = abs(new_x - target_x) + abs(new_y - target_y)\n                if distance < min_distance:\n                    min_distance = distance\n                    best_direction = (dx, dy)\n\n        if best_direction is not None:\n            dx, dy = best_direction\n            actions.append({(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}[(dx, dy)])\n            current_x += dx\n            current_y += dy\n        else:\n            break\n\n        # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n        actions.append(4)  # USE\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
