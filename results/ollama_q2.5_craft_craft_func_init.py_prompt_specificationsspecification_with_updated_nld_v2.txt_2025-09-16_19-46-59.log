_state.inventory:\n            env._current_state.inventory[primitive_index] += count  # Collect the required amount\n        else:\n            env._current_state.inventory[primitive_index] = count\n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Extract the workshop from the original recipe\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    visited = set()  # To avoid revisiting items and prevent infinite loops\n    \n    while queue:\n      current_item = queue.pop(0)\n      \n      if current_item in visited:\n        continue\n      \n      visited.add(current_item)\n      \n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        \n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          if dependency in env._current_state.inventory:\n              env._current_state.inventory[dependency] += 1  # Collect one unit\n          else:\n              env._current_state.inventory[dependency] = 1\n    return actions_to_take\n\n  def handle_complex_dependencies(env, dependencies):\n    actions_to_take = []\n    \n    # First, ensure all direct dependencies are collected\n    actions_to_take.extend(collect_dependencies(env, dependencies))\n    \n    # Then, check if the inventory meets the recipe requirements\n    cookbook = env.world.cookbook\n    \n    for item_index in list(dependencies):\n        if item_index not in cookbook.recipes:\n            continue\n        \n        recipe = cookbook.recipes[item_index].copy()\n        del recipe['_at']\n        \n        # Recursively handle complex dependencies\n        actions_to_take.extend(handle_complex_dependencies(env, get_recipe_dependencies(cookbook, item_index)))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Get all dependencies (primitives) required to craft the item\n    dependencies = get_recipe_dependencies(cookbook, item_index)\n    \n    # Handle complex dependencies\n    actions_to_take = handle_complex_dependencies(env, dependencies)\n\n    # Check if all primitives are available in inventory\n    if check_inventory(env, recipe):\n        actions_to_take.extend(navigate_and_craft(env, item_index))\n    else:\n        # Collect primitives required for crafting\n        actions_to_take.extend(collect_primitives(env, recipe))\n\n        # Navigate to the workshop and craft the item\n        actions_to_take.extend(navigate_and_craft(env, item_index))\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 6.7999997}}
{"timestamp": "2025-09-18T07:14:43.217345", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def craft_item_at_workshop(env, workshop_pos):\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def optimize_path(actions_to_take):\n      optimized_actions = []\n      current_direction = None\n      \n      for action in actions_to_take:\n          if action == 0: direction = 'UP'\n          elif action == 1: direction = 'DOWN'\n          elif action == 2: direction = 'LEFT'\n          elif action == 3: direction = 'RIGHT'\n          \n          # If current action is the same as the previous, just continue\n          if direction != current_direction:\n              optimized_actions.append(action)\n              current_direction = direction\n      \n      return optimized_actions\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n\n    # Find the closest available workshop position to craft the item at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n        \n    # Craft the item at the found workshop\n    actions_to_take.extend(craft_item_at_workshop(env, target_workshop_pos))\n\n    # Optimize the path of actions taken\n    actions_to_take = optimize_path(actions_to_take)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 0.49999994}}
{"timestamp": "2025-09-18T07:14:44.350060", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n        \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    \n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def craft_item_at_workshop(env, workshop_pos):\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n\n    # Find the closest available workshop position to craft the item at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n        \n    # Craft the item at the found workshop\n    actions_to_take.extend(craft_item_at_workshop(env, target_workshop_pos))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-18T07:18:06.138373", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Prioritize moving horizontally if needed\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    # Then move vertically if needed\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    dependencies = set()\n    \n    # Avoid circular references by keeping track of visited items\n    if item_index in visited:\n        return dependencies\n    visited.add(item_index)\n    \n    if item_index in cookbook.recipes:\n        recipe = cookbook.recipes[item_index].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n            # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n            if primitive_index in cookbook.recipes and primitive_index != item_index:\n                dependencies.update(get_recipe_dependencies(cookbook, primitive_index, visited))\n            else:\n                dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] += 1\n    return actions_to_take\n\n  def prioritize_primitives(primitives):\n      # Prioritize collecting wood, stone, and iron as they are often required in multiple recipes\n      priority_order = ['wood', 'stone', 'iron']\n      sorted_primitives = sorted(primitives, key=lambda x: (priority_order.index(x) if x in priority_order else len(priority_order), x))\n      return sorted_primitives\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Get all dependencies (primitives) required to craft the item\n    dependencies = get_recipe_dependencies(cookbook, item_index)\n    \n    # Prioritize certain primitives based on common usage\n    prioritized_primitives = prioritize_primitives(list(dependencies))\n    \n    # Collect all dependencies that are not in inventory\n    actions_to_take = []\n    for primitive in prioritized_primitives:\n        primitive_index = cookbook.index[primitive]\n        if (primitive_index not in env._current_state.inventory or \n            env._current_state.inventory[primitive_index] < recipe[primitive_index]):\n            # Find positions of the required primitives in the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(primitive_positions) > 0:\n                # Choose the closest available position to collect from\n                current_pos = env._current_state.pos\n\n                closest_primitive = min(\n                    primitive_positions, \n                    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                )\n                \n                target_primitive_pos = tuple(closest_primitive)\n\n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n                \n                # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                env._current_state.inventory[primitive_index] += 1\n\n    # Check if all primitives are available in inventory\n    if check_inventory(env, recipe):\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n        # Collect primitives required for crafting\n        actions_to_take.extend(collect_primitives(env, recipe))\n\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-18T07:18:07.267750", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Calculate Manhattan distance and plan moves accordingly\n    if abs(rel_x) > abs(rel_y):\n        # Move horizontally first if needed\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # Move RIGHT\n        else:\n            actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        # Then move vertically if needed\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # Move DOWN\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    else:\n        # Move vertically first if needed\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # Move DOWN\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))  # Move UP\n        # Then move horizontally if needed\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # Move RIGHT\n        else:\n            actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    dependencies = set()\n    \n    # Avoid circular references by keeping track of visited items\n    if item_index in visited:\n        return dependencies\n    visited.add(item_index)\n    \n    if item_index in cookbook.recipes:\n        recipe = cookbook.recipes[item_index].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n            # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n            if primitive_index in cookbook.recipes and primitive_index != item_index:\n                dependencies.update(get_recipe_dependencies(cookbook, primitive_index, visited))\n            else:\n                dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] += 1\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Get all dependencies (primitives) required to craft the item\n    dependencies = get_recipe_dependencies(cookbook, item_index)\n    \n    # Collect all dependencies that are not in inventory\n    actions_to_take = collect_dependencies(env, dependencies)\n\n    # Check if all primitives are available in inventory\n    if check_inventory(env, recipe):\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n        # Collect primitives required for crafting\n        actions_to_take.extend(collect_primitives(env, recipe))\n\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 7, "scores": {"3": 7.2}}
{"timestamp": "2025-09-18T07:20:43.121010", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if not is_item_collected(k)}\n\n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] = count\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if not is_item_collected(k)}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
