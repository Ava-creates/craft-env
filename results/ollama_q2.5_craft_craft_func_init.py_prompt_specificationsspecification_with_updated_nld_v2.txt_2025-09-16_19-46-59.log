he grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    # Determine the direction to move\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:16:15.988133", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n    actions = []\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if abs(dx) > abs(dy):\n        # Move horizontally first\n        if dx > 0:\n            actions.extend([3] * abs(dx))  # RIGHT\n        elif dx < 0:\n            actions.extend([2] * abs(dx))  # LEFT\n        # Then move vertically\n        if dy > 0:\n            actions.extend([1] * abs(dy))  # UP\n        elif dy < 0:\n            actions.extend([0] * abs(dy))  # DOWN\n    else:\n        # Move vertically first\n        if dy > 0:\n            actions.extend([1] * abs(dy))  # UP\n        elif dy < 0:\n            actions.extend([0] * abs(dy))  # DOWN\n        # Then move horizontally\n        if dx > 0:\n            actions.extend([3] * abs(dx))  # RIGHT\n        elif dx < 0:\n            actions.extend([2] * abs(dx))  # LEFT\n\n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move towards the workshop\n  actions.extend(move_towards(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:16:17.049739", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  target_directions = {1: \"UP\", 2: \"LEFT\", 3: \"RIGHT\", 0: \"DOWN\"}\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:18:12.648905", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    # Then move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n      current_dir = env._current_state.dir\n      target_dir = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n      # Determine the direction needed to face the workshop.\n      if target_dir == (0, 1):\n          return [3] if current_dir != 3 else []     # Face RIGHT\n      elif target_dir == (0, -1):\n          return [1] if current_dir != 1 else []     # Face LEFT\n      elif target_dir == (1, 0):\n          return [2] if current_dir != 2 else []     # Face UP\n      elif target_dir == (-1, 0):\n          return [0] if current_dir != 0 else []     # Face DOWN\n\n      return []\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    # Gather required primitives first.\n    actions_to_take = []\n    for primitive in primitives_needed:\n        primitive_index = cookbook.index[primitive]\n        \n        while env._current_state.inventory.get(primitive_index, 0) < primitives_needed[primitive]:\n            positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(positions) > 0: \n                closest_position = min(\n                    positions, \n                    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                )\n                \n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(tuple(closest_position)))\n                \n                # Align with the target position before collecting.\n                actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n                \n                # Collect the primitive using USE action\n                actions_to_take.append(4)\n            else:\n                raise ValueError(f\"Primitives {primitive} not found on the grid.\")\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(tuple(closest_workshop)))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:18:13.734812", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def gather_primitives(env, primitives):\n    actions_to_take = []\n    for primitive in primitives:\n      primitive_index = env.world.cookbook.index[primitive]\n      while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        \n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_position)))\n        \n        # Align with the target position before collecting.\n        actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n        \n        # Collect the primitive using USE action\n        actions_to_take.append(4)\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:19:53.972368", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def check_and_move_to_workshop(workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        return get_move_actions(target_workshop_pos) + align_with_workshop(target_workshop_pos)\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # Extract the workshop from the recipe and move to it.\n    workshop_name = recipe['_at']\n    actions_to_take.extend(check_and_move_to_workshop(workshop_name))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:19:55.047877", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def gather_primitives(primitive_list):\n    actions_to_take = []\n    \n    for primitive in primitive_list:\n      primitive_index = env.world.cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        # Choose a position to collect the primitive from\n        target_primitive_pos = tuple(primitive_positions[0])\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the item at the location\n        actions_to_take.append(4)\n      else:\n        raise ValueError(f\"No {primitive} found in the environment.\")\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Gather all required primitives\n        actions_to_take = gather_primitives(list(recipe.keys())[:-2])  # Exclude '_at' and the item itself\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 3.9}}
{"timestamp": "2025-09-17T01:21:40.347966", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:21:41.485965", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:22:43.789020", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def get_action_sequence_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          dx = target_x - current_x\n          dy = target_y - current_y\n          \n          if abs(dx) > abs(dy):  # Prioritize horizontal movement\n              if dx > 0:\n                  actions.append(3)  # RIGHT\n                  current_x += 1\n              else:\n                  actions.append(2)  # LEFT\n                  current_x -= 1\n          else:  # Prioritize vertical movement\n              if dy > 0:\n                  actions.append(1)  # UP\n                  current_y += 1\n              else:\n                  actions.append(0)  # DOWN\n                  current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(get_action_sequence_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:22:44.845004", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def get_action_sequence_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def get_closest_workshop(workshop_positions, current_x, current_y):\n    closest_workshop_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n    return closest_workshop_pos\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = get_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(get_action_sequence_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:23:55.278529", "function_name": "craft", "function_body": "  def bfs(grid, start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {start: None}\n\n      while queue:\n          current_pos = queue.popleft()\n\n          if current_pos == goal:\n              path = []\n              while current_pos is not None:\n                  path.append(current_pos)\n                  current_pos = parent_map[current_pos]\n              return list(reversed(path))\n\n          visited.add(current_pos)\n\n          x, y = current_pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (x + dx, y + dy)\n              if (0 <= neighbor[0] < grid.shape[0] and\n                  0 <= neighbor[1] < grid.shape[1] and\n                  neighbor not in visited and\n                  np.sum(grid[neighbor]) == 0):  # Check if the cell is empty\n                  queue.append(neighbor)\n                  parent_map[neighbor] = current_pos\n\n      return None\n\n  def get_next_actions(path):\n      actions = []\n      for i in range(len(path) - 1):\n          dx = path[i + 1][0] - path[i][0]\n          dy = path[i + 1][1] - path[i][1]\n\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n\n          if dy > 0:\n              actions.append(1)  # UP\n          elif dy < 0:\n              actions.append(0)  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  path_to_workshop = bfs(env._current_state.grid, current_pos, target_workshop_pos)\n\n  if path_to_workshop is None:\n      raise ValueError(\"No valid path to the workshop found.\")\n\n  actions_to_reach_workshop = get_next_actions(path_to_workshop)\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:23:56.294052", "function_name": "craft", "function_body": "  def get_next_actions_bfs(current_pos, target_positions):\n      from collections import deque\n      import numpy as np\n      \n      queue = deque([current_pos])\n      visited = set()\n      parent = {current_pos: None}\n\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      action_map = {(0, 1): 3, (0, -1): 2, (1, 0): 1, (-1, 0): 0}\n\n      while queue:\n          pos = queue.popleft()\n          if pos in target_positions:\n              path_actions = []\n              while parent[pos] is not None:\n                  move = tuple(np.array(pos) - np.array(parent[pos]))\n                  path_actions.append(action_map[move])\n                  pos = parent[pos]\n              return path_actions[::-1]\n\n          visited.add(pos)\n          for direction in directions:\n              new_pos = (pos[0] + direction[0], pos[1] + direction[1])\n\n              # Ensure the new position is within grid bounds\n              if not (0 <= new_pos[0] < env._current_state.grid.shape[0]) or \\\n                 not (0 <= new_pos[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              # Check if the cell is passable\n              if any(env._current_state.grid[new_pos, :] > 0):\n                  continue\n\n              if new_pos not in visited:\n                  queue.append(new_pos)\n                  parent[new_pos] = pos\n      \n      raise ValueError(\"No valid path found to any target position\")\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_positions = set(tuple(pos) for pos in workshop_positions)\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_actions_bfs(current_pos, target_workshop_positions)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:25:10.343906", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_missing_items(item_index):\n    recipe = env.world.cookbook.recipes[item_index]\n    missing_items = []\n    \n    for ingredient, required_amount in recipe.items():\n      if ingredient == '_at':\n          continue\n      ingredient_index = env.world.cookbook.index[ingredient]\n      \n      # Check if the required amount of this ingredient is already in the inventory\n      current_amount = env._current_state.inventory[ingredient_index]\n      if current_amount < required_amount:\n        missing_items.append((ingredient, required_amount - current_amount))\n    \n    return missing_items\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n      missing_items = get_missing_items(item_index)\n\n      actions_to_take = []\n      \n      # First, collect all missing items if any\n      for ingredient, amount_needed in missing_items:\n          actions_to_take.extend(collect_v2(env, ingredient, amount=amount_needed))\n\n      # Once all ingredients are collected, move to the closest workshop and craft the item\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n          actions_to_take.append(4)  # USE action to craft the item\n\n          return actions_to_take\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:25:11.425228", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    while current_pos != target_pos:\n      # Calculate the direction to move in\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        # Move horizontally first\n        action = 3 if dx > 0 else 2\n        actions_to_take.append(action)\n        current_pos = (current_pos[0] + (1 if dx > 0 else -1), current_pos[1])\n      elif dy != 0:\n        # Move vertically\n        action = 1 if dy > 0 else 0\n        actions_to_take.append(action)\n        current_pos = (current_pos[0], current_pos[1] + (1 if dy > 0 else -1))\n      \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:26:44.772387", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    while current_pos != target_pos:\n      # Calculate the direction to move in\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        # Move horizontally first\n        action = 3 if dx > 0 else 2\n        actions_to_take.append(action)\n        current_pos = (current_pos[0] + (1 if dx > 0 else -1), current_pos[1])\n      elif dy != 0:\n        # Move vertically\n        action = 1 if dy > 0 else 0\n        actions_to_take.append(action)\n        current_pos = (current_pos[0], current_pos[1] + (1 if dy > 0 else -1))\n      \n    return actions_to_take\n\n  def get_primitive_actions(primitive, amount):\n    cookbook = env.world.cookbook\n    primitive_index = cookbook.index[primitive]\n    actions_to_take = []\n\n    # Find all positions of the specified primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_positions) > 0:\n      while amount > 0 and len(primitive_positions) > 0:\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n\n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        amount -= 1\n        \n        # Recalculate positions after collecting one primitive\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if amount > 0:\n        raise ValueError(f\"Not enough {primitive} found in the environment.\")\n\n    else:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives and their required amounts from the recipe\n    primitives_needed = {k: v for k, v in recipe.items() if not k.startswith('_')}\n\n    actions_to_take = []\n\n    # Collect all required primitives\n    for primitive, amount in primitives_needed.items():\n      actions_to_take.extend(get_primitive_actions(primitive, amount))\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n    \n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:26:45.833501", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n    \n    while current_pos != target_pos:\n      # Calculate the direction to move in\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        # Move horizontally first\n        action = 3 if dx > 0 else 2\n        actions_to_take.append(action)\n        current_pos = (current_pos[0] + (1 if dx > 0 else -1), current_pos[1])\n      elif dy != 0:\n        # Move vertically\n        action = 1 if dy > 0 else 0\n        actions_to_take.append(action)\n        current_pos = (current_pos[0], current_pos[1] + (1 if dy > 0 else -1))\n      \n    return actions_to_take\n\n  def get_required_items(recipe):\n    required_items = []\n    for ingredient, count in recipe.items():\n      if ingredient != '_at':\n          required_items.append((ingredient, count))\n    return required_items\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    required_items = get_required_items(recipe)\n\n    # Check if all required items are in inventory\n    actions_to_take = []\n    for ingredient, count in required_items:\n      ingredient_index = cookbook.index[ingredient]\n      if np.sum(env._current_state.grid[:, :, ingredient_index]) < count:\n        raise ValueError(f\"Not enough {ingredient} to craft {item}.\")\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      # Choose the closest available workshop position to craft the item at\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:27:49.392628", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n  def rotate_and_move(dir_x, dir_y):\n      current_dir = env._current_state.dir\n      target_dir = np.argmax([dir_x == -1, dir_y == -1, dir_x == 1, dir_y == 1])\n      \n      while current_dir != target_dir:\n          if (target_dir - current_dir) % 4 in [1, 3]:\n              actions.append(5)  # TURN_RIGHT\n          else:\n              actions.append(6)  # TURN_LEFT\n          current_dir = (current_dir + 1) % 4\n      \n      move(dir_x, dir_y)\n\n  if dx > 0:\n      rotate_and_move(1, 0)\n  elif dx < 0:\n      rotate_and_move(-1, 0)\n  \n  if dy > 0:\n      rotate_and_move(0, 1)\n  elif dy < 0:\n      rotate_and_move(0, -1)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:27:50.531365", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      # Move in x direction first\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      # Then move in y direction\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:29:02.758762", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      \"\"\"Find the closest workshop to the current position.\"\"\"\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Get the workshop name and index from the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Determine the closest workshop to move towards\n  current_pos = env._current_state.pos\n  target_workshop_pos = find_closest_workshop(workshop_positions, current_pos)\n\n  # Generate actions to move towards the workshop\n  actions_to_reach_workshop = move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1])\n\n  # Add USE action to craft the item at the workshop\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:34:03.082025", "function_name": "craft", "function_body": "  def move_towards(target_x, target_y, current_x, current_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      \"\"\"Find the closest workshop to the current position.\"\"\"\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  def is_next_to_workshop(target_workshop, current_state):\n      \"\"\"Check if the agent is next to the workshop.\"\"\"\n      current_x, current_y = current_state.pos\n      workshop_x, workshop_y = target_workshop\n\n      # Check all 4 directions around the current position\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          if (current_x + dx == workshop_x) and (current_y + dy == workshop_y):\n              return True\n      return False\n\n  # Get the index of the item to craft\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Get the workshop name and index from the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Determine the closest workshop to move towards\n  current_pos = env._current_state.pos\n  target_workshop_pos = find_closest_workshop(workshop_positions, current_pos)\n\n  actions = []\n\n  while not is_next_to_workshop(target_workshop_pos, env._current_state):\n      actions.extend(move_towards(target_workshop_pos[0], target_workshop_pos[1], current_pos[0], current_pos[1]))\n      # Update current position after taking the move\n      current_pos = env._current_state.pos\n\n  # Add USE action to craft the item at the workshop\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:35:03.136993", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      directions = []\n      if dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n      return directions\n\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
