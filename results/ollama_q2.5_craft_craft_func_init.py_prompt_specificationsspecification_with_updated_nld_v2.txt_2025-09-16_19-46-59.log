he grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T00:16:19.647673", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n        return 'DOWN'\n    elif dx < 0:\n        return 'UP'\n    else:\n        if dy > 0:\n            return 'RIGHT'\n        elif dy < 0:\n            return 'LEFT'\n    return None\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n    \n    while current_pos != target_pos:\n        direction = get_direction(current_pos, target_pos)\n        \n        if direction is not None:\n            actions.append(dir_map[direction])\n            # Simulate the move to update current_pos\n            if direction == 'DOWN':\n                current_pos = (current_pos[0] + 1, current_pos[1])\n            elif direction == 'UP':\n                current_pos = (current_pos[0] - 1, current_pos[1])\n            elif direction == 'RIGHT':\n                current_pos = (current_pos[0], current_pos[1] + 1)\n            elif direction == 'LEFT':\n                current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T00:16:20.763567", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n        return 'DOWN'\n    elif dx < 0:\n        return 'UP'\n    else:\n        if dy > 0:\n            return 'RIGHT'\n        elif dy < 0:\n            return 'LEFT'\n    return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  actions = actions_to_workshop + [4]  # Adding USE action to craft item\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T00:17:23.228871", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n\n      if dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Ensure we are facing the correct direction before using the workshop\n  dx = target_workshop_pos[0] - current_pos[0]\n  dy = target_workshop_pos[1] - current_pos[1]\n\n  if dx > 0:\n      actions_to_reach_workshop.append(3)  # RIGHT\n  elif dx < 0:\n      actions_to_reach_workshop.append(2)  # LEFT\n\n  if dy > 0:\n      actions_to_reach_workshop.append(1)  # UP\n  elif dy < 0:\n      actions_to_reach_workshop.append(0)  # DOWN\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.7}}
{"timestamp": "2025-09-17T00:17:24.292818", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n  actions_to_reach_workshop.append(4)  # USE\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T00:18:36.990207", "function_name": "craft", "function_body": "  def heuristic(pos1, pos2):\n      \"\"\"Manhattan distance as a heuristic.\"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_next_actions(start_pos, target_pos):\n      # Breadth-first search to find the shortest path\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          current_pos, path = queue.popleft()\n\n          if current_pos == target_pos:\n              return path\n\n          for direction in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              next_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n              if (next_pos not in visited and\n                  0 <= next_pos[0] < env._current_state.grid.shape[0] and\n                  0 <= next_pos[1] < env._current_state.grid.shape[1]):\n                  # Check if the cell is not occupied by any non-walkable entity\n                  if np.sum(env._current_state.grid[next_pos]) == 0:\n                      visited.add(next_pos)\n                      new_path = path + [4 if direction == (0, 0) else \n                                         {(-1, 0): 0, (1, 0): 1, (0, -1): 2, (0, 1): 3}[direction]]\n                      queue.append((next_pos, new_path))\n\n      return []\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_actions(current_pos, target_workshop_pos)\n\n  if not actions_to_reach_workshop:\n      raise ValueError(f\"No path to {workshop_name} found.\")\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:18:37.966917", "function_name": "craft", "function_body": "  def bfs_shortest_path(start, goal, grid):\n      queue = collections.deque([start])\n      visited = set()\n      parent_map = {start: None}\n\n      while queue:\n          current_pos = queue.popleft()\n\n          if current_pos == goal:\n              path = []\n              while current_pos is not None:\n                  path.append(current_pos)\n                  current_pos = parent_map[current_pos]\n              return path[::-1]\n\n          visited.add(current_pos)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (0 <= neighbor_pos[0] < grid.shape[0] and\n                  0 <= neighbor_pos[1] < grid.shape[1] and\n                  grid[neighbor_pos] == 0 and\n                  neighbor_pos not in visited):\n                  queue.append(neighbor_pos)\n                  parent_map[neighbor_pos] = current_pos\n\n      return []\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  path_to_reach_workshop = bfs_shortest_path(current_pos, target_workshop_pos, np.sum(env._current_state.grid, axis=2))\n\n  if not path_to_reach_workshop:\n      raise ValueError(f\"No path found to reach the {workshop_name}.\")\n\n  actions_to_reach_workshop = []\n\n  for i in range(1, len(path_to_reach_workshop)):\n      current_pos = path_to_reach_workshop[i - 1]\n      next_pos = path_to_reach_workshop[i]\n\n      if next_pos[0] > current_pos[0]:\n          actions_to_reach_workshop.append(3)  # RIGHT\n      elif next_pos[0] < current_pos[0]:\n          actions_to_reach_workshop.append(2)  # LEFT\n\n      if next_pos[1] > current_pos[1]:\n          actions_to_reach_workshop.append(1)  # UP\n      elif next_pos[1] < current_pos[1]:\n          actions_to_reach_workshop.append(0)  # DOWN\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:19:56.557343", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 'DOWN' if dx > 0 else 'UP'\n      elif abs(dy) >= abs(dx):\n          return 'RIGHT' if dy > 0 else 'LEFT'\n\n      return None\n\n  def move_towards(current_pos, target_pos):\n      actions = []\n      direction = get_direction(current_pos, target_pos)\n      \n      while current_pos != target_pos and direction is not None:\n          actions.append(dir_map[direction])\n          \n          # Simulate the move to update current_pos\n          if direction == 'DOWN':\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif direction == 'UP':\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          elif direction == 'RIGHT':\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif direction == 'LEFT':\n              current_pos = (current_pos[0], current_pos[1] - 1)\n          \n          # Recalculate the direction for the next step\n          direction = get_direction(current_pos, target_pos)\n      \n      return actions\n\n  def find_closest_workshop(grid, workshop_index, current_pos):\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      closest_distance = float('inf')\n      closest_position = None\n      \n      for pos in positions:\n          distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          if distance < closest_distance:\n              closest_distance = distance\n              closest_position = tuple(pos)\n      \n      return closest_position\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find the closest workshop in the grid that matches the required workshop index\n  grid = env._current_state.grid\n  target_pos = find_closest_workshop(grid, workshop_index, env._current_state.pos)\n  \n  if not target_pos:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to the closest workshop\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate actions to move towards the target position\n  actions = move_towards(current_pos, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-17T00:19:57.522885", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 'DOWN' if dx > 0 else 'UP'\n      elif abs(dy) >= abs(dx):\n          return 'RIGHT' if dy > 0 else 'LEFT'\n\n      return None\n\n  def move_towards(current_pos, target_pos):\n      actions = []\n      direction = get_direction(current_pos, target_pos)\n      \n      while current_pos != target_pos and direction is not None:\n          actions.append(dir_map[direction])\n          \n          # Simulate the move to update current_pos\n          if direction == 'DOWN':\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif direction == 'UP':\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          elif direction == 'RIGHT':\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif direction == 'LEFT':\n              current_pos = (current_pos[0], current_pos[1] - 1)\n          \n          # Recalculate the direction for the next step\n          direction = get_direction(current_pos, target_pos)\n      \n      return actions\n\n  def calculate_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the closest available one here)\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate distances and choose the closest workshop\n  target_workshop_pos = min(workshop_positions, key=lambda pos: calculate_distance(current_pos, tuple(pos)))\n  \n  # Calculate actions to move towards the target position\n  actions = move_towards(current_pos, target_workshop_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:26:22.536626", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def ensure_has_primitives(primitive_indices, inventory):\n      missing_primitives = {i_kind: count for i_kind, count in primitive_indices.items() if inventory[i_kind] < count}\n      if not missing_primitives:\n          return []\n      \n      # Placeholder function to find and collect all missing primitives\n      actions_to_take = []\n      for i_kind, count_needed in missing_primitives.items():\n          while inventory[i_kind] < count_needed:\n              available_positions = np.argwhere(env._current_state.grid[:, :, i_kind] == 1)\n              if len(available_positions) > 0:\n                  closest_item_pos = min(\n                      available_positions, \n                      key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                  )\n                  \n                  # Calculate move actions to reach the closest item position\n                  actions_to_take.extend(get_move_actions(tuple(closest_item_pos)))\n                  \n                  # Collect the item at the specified position\n                  actions_to_take.append(4)\n              else:\n                  raise ValueError(f\"No {env.world.cookbook.index[i_kind]} available in the environment.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Ensure the agent has all required primitives in their inventory\n        primitive_indices = {i_kind: count for i_kind, count in recipe.items() if i_kind != '_at'}\n        actions_to_take = ensure_has_primitives(primitive_indices, env._current_state.inventory)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:26:23.529711", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Orient agent correctly if needed before using workshop\n        target_orientation = world.dirs[(closest_workshop - current_pos) % 4]\n        current_orientation = env._current_state.dir\n        if current_orientation != target_orientation:\n            rotate_action = (target_orientation - current_orientation + 4) % 4\n            actions_to_take.extend([rotate_action] * (1 if rotate_action < 2 else 3))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:28:07.635926", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T00:28:08.761431", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T00:29:55.081069", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def collect_primitive(env, primitive_name) -> list[int]:\n      actions_to_take = []\n      cookbook = env.world.cookbook\n      world = env.world\n      \n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in cookbook.recipes:\n          raise ValueError(f\"Primitive {primitive_name} should not have a recipe.\")\n          \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          for pos in primitive_positions:\n              target_pos = tuple(pos)\n              \n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(target_pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for {primitive_name}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract ingredients from the recipe (excluding '_at')\n    ingredients = {k: v for k, v in recipe.items() if k != '_at'}\n    \n    actions_to_take = []\n    \n    # Collect all required primitives before crafting\n    for primitive_name, quantity in ingredients.items():\n        if primitive_name not in cookbook.primitives:\n            raise ValueError(f\"Ingredient {primitive_name} is not a primitive.\")\n        \n        primitive_index = cookbook.index[primitive_name]\n        while np.sum(env._current_state.grid[:, :, primitive_index]) < quantity:\n            actions_to_take.extend(collect_primitive(env, primitive_name))\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:29:56.159234", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_x, target_y = workshop_pos\n    current_x, current_y = current_pos\n\n    if target_x > current_x:\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_x < current_x:\n        return [2] if current_dir != 2 else []     # Face LEFT\n    \n    if target_y > current_y:\n        return [1] if current_dir != 1 else []     # Face DOWN\n    elif target_y < current_y:\n        return [0] if current_dir != 0 else []     # Face UP\n\n    return []\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.7}}
{"timestamp": "2025-09-17T00:30:54.410419", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      elif dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      \n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      elif dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T00:30:55.497259", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.extend([3] * dx)  # RIGHT\n          else:\n              actions.extend([2] * (-dx))  # LEFT\n      \n          if dy > 0:\n              actions.extend([1] * dy)  # UP\n          else:\n              actions.extend([0] * (-dy))  # DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * dy)  # UP\n          else:\n              actions.extend([0] * (-dy))  # DOWN\n      \n          if dx > 0:\n              actions.extend([3] * dx)  # RIGHT\n          else:\n              actions.extend([2] * (-dx))  # LEFT\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T00:31:54.194477", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if dx != 0:\n          direction_x = 3 if dx > 0 else 2\n          actions.extend([direction_x] * abs(dx))  # RIGHT or LEFT\n\n      if dy != 0:\n          direction_y = 1 if dy > 0 else 0\n          actions.extend([direction_y] * abs(dy))  # UP or DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T00:31:55.279603", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Ensure the agent is facing the correct direction before using\n  if env._current_state.dir != 0 and target_workshop_pos[1] < current_pos[1]:  # DOWN\n      actions_to_reach_workshop.append(0)\n  elif env._current_state.dir != 1 and target_workshop_pos[1] > current_pos[1]:  # UP\n      actions_to_reach_workshop.append(1)\n  elif env._current_state.dir != 2 and target_workshop_pos[0] < current_pos[0]:  # LEFT\n      actions_to_reach_workshop.append(2)\n  elif env._current_state.dir != 3 and target_workshop_pos[0] > current_pos[0]:  # RIGHT\n      actions_to_reach_workshop.append(3)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 3.7}}
{"timestamp": "2025-09-17T00:33:41.251227", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i not in env.world.cookbook.index.values()):  # Assuming 0 indicates walkable, except items\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
