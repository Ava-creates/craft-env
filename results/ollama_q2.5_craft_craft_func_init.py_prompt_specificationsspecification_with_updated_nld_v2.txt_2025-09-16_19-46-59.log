{"timestamp": "2025-09-19T15:20:28.046701", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def get_primitives_to_collect(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {}\n      sub_recipes = {}\n\n      for primitive_index, count in recipe.items():\n          if primitive_index not in env._current_state.inventory or env._current_state.inventory[primitive_index] < count:\n              primitives_needed[primitive_index] = count\n              if primitive_index in cookbook.recipes:\n                  sub_recipes[primitive_index] = get_primitives_to_collect(primitive_index, cookbook)\n      \n      return {\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_primitives(primitives_dict):\n      flattened = collections.defaultdict(int)\n\n      for primitive_index, count in primitives_dict['prerequisites'].items():\n          flattened[primitive_index] += count\n      \n      for sub_recipe in primitives_dict['sub_recipes'].values():\n          for primitive_index, count in flatten_primitives(sub_recipe).items():\n              flattened[primitive_index] += count\n      \n      return flattened\n\n  def collect_primitives(env, primitives_needed):\n    cookbook = env.world.cookbook\n    actions_to_take = []\n    \n    for primitive_index, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive_index, 0) < count:\n            # Find all positions of the required primitives in the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(primitive_positions) > 0:\n                current_pos = env._current_state.pos\n\n                for pos in primitive_positions:\n                    pos_tuple = tuple(pos)\n                    \n                    # Move to the position of the primitive\n                    actions_to_take.extend(get_move_actions(pos))\n                    \n                    # Use the USE action to collect the primitive\n                    actions_to_take.append(4)\n                    \n                    # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                    env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n                    \n                    if env._current_state.inventory[primitive_index] >= count:\n                        break\n            else:\n                raise ValueError(f\"No primitives found for {cookbook.index[primitive_index]}.\")\n\n    return actions_to_take\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index].copy()\n    \n    if '_at' in recipe:\n        del recipe['_at']\n    \n    for primitive_index, count in recipe.items():\n        if primitive_index in cookbook.recipes:\n            update_inventory(env, primitive_index)\n        \n        env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) - count\n    \n    env._current_state.inventory[item_index] = env._current_state.inventory.get(item_index, 0) + 1\n\n  def craft_items_in_order(items_to_craft):\n    actions_to_take = []\n    \n    for item_to_craft in items_to_craft:\n        primitives_hierarchy = get_primitives_to_collect(item_to_craft, cookbook)\n        primitives_needed = flatten_primitives(primitives_hierarchy)\n\n        if not all(env._current_state.inventory.get(p, 0) >= count for p, count in primitives_needed.items()):\n            actions_to_take.extend(collect_primitives(env, primitives_needed))\n        \n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        update_inventory(env, item_to_craft)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  if item not in cookbook.index:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  item_index = cookbook.index[item]\n  \n  primitives_hierarchy = get_primitives_to_collect(item_index, cookbook)\n  items_to_craft = flatten_recipe_hierarchy(primitives_hierarchy)\n\n  actions_to_take = craft_items_in_order(items_to_craft)\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
