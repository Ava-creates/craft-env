        parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T23:02:10.855618", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n    \n    # Determine the shortest path using Manhattan distance heuristics\n    while target_pos[0] != current_pos[0] or target_pos[1] != current_pos[1]:\n      if target_pos[0] > current_pos[0]:\n          actions_to_take.append(3)  # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif target_pos[0] < current_pos[0]:\n          actions_to_take.append(2)  # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif target_pos[1] > current_pos[1]:\n          actions_to_take.append(1)  # DOWN\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif target_pos[1] < current_pos[1]:\n          actions_to_take.append(0)  # UP\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions_to_take\n\n  def get_required_primitives(item_index):\n    required_primitives = {}\n    \n    # Helper function to recursively find all primitives needed for an item\n    def recurse_recipe(index, count):\n      if index in cookbook.recipes:\n        recipe = cookbook.recipes[index]\n        for ingredient_name, quantity in recipe.items():\n          if ingredient_name != '_at':\n            ingredient_index = cookbook.index[ingredient_name]\n            if ingredient_index in required_primitives:\n              required_primitives[ingredient_index] += quantity * count\n            else:\n              required_primitives[ingredient_index] = quantity * count\n            recurse_recipe(ingredient_index, quantity)\n      elif index in cookbook.index:\n        # If it's a primitive\n        if index in required_primitives:\n          required_primitives[index] += count\n        else:\n          required_primitives[index] = count\n\n    recurse_recipe(item_index, 1)\n    \n    return required_primitives\n  \n  def collect_primitive(primitive_name):\n    actions_to_take = []\n    primitive_index = cookbook.index[primitive_name]\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_positions) > 0:\n        closest_primitive_pos = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_primitive_pos)))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No {primitive_name} found in the environment.\")\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Fetch all required primitives and their quantities\n  required_primitives = get_required_primitives(item_index)\n\n  actions_to_take = []\n  \n  # Collect all required primitives if not already in inventory\n  for primitive_index, quantity in required_primitives.items():\n    while env._current_state.inventory.get(primitive_index, 0) < quantity:\n      primitive_name = cookbook.index[primitive_index]\n      actions_to_take.extend(collect_primitive(primitive_name))\n  \n  # After collecting all primitives, proceed to craft the item\n  workshop_name = cookbook.recipes[item_index]['_at']\n  workshop_index = cookbook.index[workshop_name]\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) > 0:\n    closest_workshop_pos = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n    )\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(tuple(closest_workshop_pos)))\n    \n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n  else:\n    raise ValueError(f\"No workshops found for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:02:11.920467", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first if the distance is greater\n    if abs(rel_x) > abs(rel_y):\n        actions_to_take.extend([3] * rel_x if rel_x > 0 else [2] * abs(rel_x))\n    else:\n        actions_to_take.extend([1] * rel_y if rel_y > 0 else [0] * abs(rel_y))\n\n    # Then move vertically\n    if abs(rel_x) <= abs(rel_y):\n        actions_to_take.extend([3] * rel_x if rel_x > 0 else [2] * abs(rel_x))\n    else:\n        actions_to_take.extend([1] * rel_y if rel_y > 0 else [0] * abs(rel_y))\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:03:52.594455", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
