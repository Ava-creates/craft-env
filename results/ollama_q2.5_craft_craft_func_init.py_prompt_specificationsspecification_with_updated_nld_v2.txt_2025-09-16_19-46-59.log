# Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n        \n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    actions_to_take.extend(craft_item(env, item_index))\n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 8, "scores": {"3": 6.0}}
{"timestamp": "2025-09-17T19:20:21.663154", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def recursive_craft(env, item_index):\n    actions_to_take = []\n    \n    # Ensure all ingredients are collected\n    actions_to_take.extend(ensure_inventory(env, item_index))\n    \n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n\n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n        \n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def collect_primitive(env, primitive_name, required_amount):\n    cookbook = env.world.cookbook\n    primitive_index = cookbook.index[primitive_name]\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_pos