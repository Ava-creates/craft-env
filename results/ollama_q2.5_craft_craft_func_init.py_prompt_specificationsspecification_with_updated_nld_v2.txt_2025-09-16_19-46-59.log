 primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def if_workshop_in_inventory(env, workshop_name) -> bool:\n    \"\"\"Check if the specified workshop is in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    return env._current_state.inventory[workshop_index] > 0\n\n  # Helper function to check if an item can be crafted with the current inventory\n  def can_craft_with_inventory(env, recipe):\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              return False\n      return True\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # If all required items are already in inventory, directly proceed to crafting\n    if can_craft_with_inventory(env, recipe):\n        workshop_name = recipe['_at']\n        actions_to_take = find_and_use_workshop(env, workshop_name)\n    else:\n        # Gather required items before crafting\n        actions_to_take = gather_required_items(env, cookbook, recipe)\n\n        # After gathering all required items, proceed to craft the item\n        workshop_name = recipe['_at']\n        actions_to_take.extend(find_and_use_workshop(env, workshop_name))\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:35:34.027704", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n    directions = []\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:35:35.107966", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while current_x != target_x or current_y != target_y:\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if dx > 0:\n      actions.append(3)  # RIGHT\n      current_x += 1\n    elif dx < 0:\n      actions.append(2)  # LEFT\n      current_x -= 1\n    \n    if dy > 0:\n      actions.append(1)  # UP\n      current_y += 1\n    elif dy < 0:\n      actions.append(0)  # DOWN\n      current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:36:51.075310", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction of movement and add corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Check if the agent is already at the workshop position, if not add movement actions\n          if env._current_state.pos != target_workshop_pos:\n              actions_to_take.extend(get_move_actions(target_workshop_pos))\n              \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T06:36:52.046246", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction of movement and add corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(item_index, cookbook):\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index]\n      \n      needed_items = {cookbook.index[ingredient]: quantity for ingredient, quantity in recipe.items() if ingredient != '_at'}\n      \n      inventory = env._current_state.inventory\n      \n      actions_to_take = []\n      \n      # Check each item required by the recipe\n      for needed_item, quantity in needed_items.items():\n          available_quantity = inventory[needed_item]\n          \n          # If not enough items are available, craft them first\n          if available_quantity < quantity:\n              required_crafting_quantity = quantity - available_quantity\n\n              while required_crafting_quantity > 0:\n                  sub_actions = craft_v2(env, cookbook.index[needed_item].name)\n                  actions_to_take.extend(sub_actions)\n\n                  # Update inventory after crafting (assuming all crafted items are added to inventory immediately)\n                  inventory[needed_item] += required_crafting_quantity\n\n                  required_crafting_quantity -= required_crafting_quantity\n      \n      return actions_to_take\n  \n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Ensure the inventory has all necessary items for crafting\n  actions_to_take = ensure_inventory(item_index, cookbook)\n  \n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:37:46.398617", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move_to_target(x, y):\n      while x != target_x or y != target_y:\n          if x < target_x:\n              actions.append(3)  # RIGHT\n              x += 1\n          elif x > target_x:\n              actions.append(2)  # LEFT\n              x -= 1\n\n          if y < target_y:\n              actions.append(0)  # DOWN\n              y += 1\n          elif y > target_y:\n              actions.append(1)  # UP\n              y -= 1\n\n  move_to_target(current_x, current_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-17T06:37:47.459138", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    nonlocal actions\n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      elif dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      \n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      elif dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:43:47.167820", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n      \n      # Update the agent's position after moving\n      current_x += (3 - actions[-1]) % 4 - 2 if actions[-1] in [2, 3] else 0\n      current_y += (3 - actions[-1]) % 4 - 2 if actions[-1] in [0, 1] else 0\n\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:43:48.250667", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n      \n      # Add logic to avoid getting stuck in a corner or an obstacle\n      if env._current_state.next_to(env.world.cookbook.index[\"BOUNDARY\"]):\n        actions.append(np.random.choice([2, 3, 0, 1]))  # Randomly choose a direction to escape the boundary\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.0}}
{"timestamp": "2025-09-17T06:44:49.328661", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Calculate direction changes and moves\n      while dx != 0 or dy != 0:\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              dx -= 1\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              dx += 1\n      \n          if dy > 0:\n              actions.append(1)  # UP\n              dy -= 1\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              dy += 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:44:50.405543", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n          dx -= 1\n        else:\n          actions.append(2)  # LEFT\n          dx += 1\n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n          dy -= 1\n        else:\n          actions.append(0)  # DOWN\n          dy += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:46:01.477488", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n    \"\"\"Rotate the agent to face the target direction.\"\"\"\n    if (current_dir == 3 and target_dir == 1) or (current_dir == 2 and target_dir == 0):\n        return [1] * 2  # Turn left twice\n    elif (current_dir == 1 and target_dir == 3) or (current_dir == 0 and target_dir == 2):\n        return [0] * 2  # Turn right twice\n    else:\n        if current_dir < target_dir:\n            return [target_dir - current_dir] * 1  # Turn left\n        elif current_dir > target_dir:\n            return [4 + (target_dir - current_dir)] * 1  # Turn right\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:46:02.559531", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if abs(target_x - current_x) > abs(target_y - current_y):\n              if current_x < target_x:\n                  actions.append(3)  # RIGHT\n                  current_x += 1\n              elif current_x > target_x:\n                  actions.append(2)  # LEFT\n                  current_x -= 1\n          else:\n              if current_y < target_y:\n                  actions.append(1)  # UP\n                  current_y += 1\n              elif current_y > target_y:\n                  actions.append(0)  # DOWN\n                  current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:47:08.336791", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      directions = []\n      \n      if dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n\n      if dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n\n      return directions\n\n  def move(dx, dy):\n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n  \n  actions = []\n  \n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  current_x, current_y = env._current_state.pos\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T06:47:09.461391", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n      \n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n  def move_towards(x, y):\n      cx, cy = env._current_state.pos\n      while cx != x or cy != y:\n          dx = x - cx\n          dy = y - cy\n\n          if abs(dx) > abs(dy):\n              actions.append(3 if dx > 0 else 2)\n              cx += 1 if dx > 0 else -1\n          else:\n              actions.append(1 if dy > 0 else 0)\n              cy += 1 if dy > 0 else -1\n\n  move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T06:49:21.784082", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T06:49:22.768073", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def check_inventory_for_primitives(env, cookbook):\n      actions = []\n      for item_index in env._current_state.inventory.keys():\n          if env._current_state.inventory[item_index] == 0 and item_index not in cookbook.recipes:\n              # Collect the primitive\n              primitive_name = [k for k, v in cookbook.index.items() if v == item_index][0]\n              actions.extend(collect(env, primitive_name))\n      return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Ensure all primitives are collected even if not directly needed for the recipe\n    actions_to_take.extend(check_inventory_for_primitives(env, cookbook))\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    except ValueError as e:\n        return actions_to_take  # If no workshops found, just return collected items\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T06:51:09.354368", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    workshop_name = recipe.pop('_at')\n    \n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    actions_to_take.extend(craft_item(env, workshop_index))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
