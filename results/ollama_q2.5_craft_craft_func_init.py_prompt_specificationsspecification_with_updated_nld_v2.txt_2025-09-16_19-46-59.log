he grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the nearest available workshop\n  target_pos = min(workshop_positions, key=lambda pos: heuristic(pos, current_pos))\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, tuple(target_pos))\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T02:19:39.648104", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid, workshop_index):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos, grid, workshop_index)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T02:20:41.537361", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Move horizontally first if the horizontal difference is greater\n      if abs(tx - sx) > abs(ty - sy):\n          if tx > sx:\n              actions.extend([3] * (tx - sx))  # RIGHT\n          elif tx < sx:\n              actions.extend([2] * (sx - tx))  # LEFT\n          \n          # Then move vertically\n          if ty > sy:\n              actions.extend([1] * (ty - sy))  # UP\n          elif ty < sy:\n              actions.extend([0] * (sy - ty))  # DOWN\n      \n      else:\n          # Move vertically first if the vertical difference is greater or equal\n          if ty > sy:\n              actions.extend([1] * (ty - sy))  # UP\n          elif ty < sy:\n              actions.extend([0] * (sy - ty))  # DOWN\n          \n          # Then move horizontally\n          if tx > sx:\n              actions.extend([3] * (tx - sx))  # RIGHT\n          elif tx < sx:\n              actions.extend([2] * (sx - tx))  # LEFT\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T02:20:42.639033", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Function to move in a specific direction and handle direction changes\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:22:25.330412", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T02:22:26.410964", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T02:23:31.673028", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      \"\"\"Move the agent to a specific location.\"\"\"\n      # Calculate the number of steps needed in each direction\n      steps_right_or_left = abs(dx)\n      steps_up_or_down = abs(dy)\n\n      if dx > 0:\n          actions.extend([3] * steps_right_or_left)  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_right_or_left)  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * steps_up_or_down)  # UP\n      elif dy < 0:\n          actions.extend([0] * steps_up_or_down)  # DOWN\n\n  move(dx, dy)\n\n  # Check the current direction and align it with the workshop's direction\n  target_direction = np.arctan2(dy, dx)\n  current_direction = env._current_state.dir\n  angle_diff = target_direction - (current_direction * np.pi / 2)\n\n  if angle_diff > np.pi:\n      angle_diff -= 2 * np.pi\n  elif angle_diff < -np.pi:\n      angle_diff += 2 * np.pi\n\n  def rotate_to_target():\n      \"\"\"Rotate the agent to face the workshop.\"\"\"\n      # Calculate the number of rotations needed\n      rotations = int(np.round(angle_diff / (np.pi / 2)))\n      if rotations > 0:\n          actions.extend([3] * rotations)  # RIGHT\n      elif rotations < 0:\n          actions.extend([2] * abs(rotations))  # LEFT\n\n  rotate_to_target()\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 2.2}}
{"timestamp": "2025-09-17T02:23:32.729919", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:24:40.618941", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  \n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move horizontally first\n  if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n  elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n  \n  # Then move vertically\n  if dy > 0:\n      actions.extend([1] * abs(dy))  # UP\n  elif dy < 0:\n      actions.extend([0] * abs(dy))  # DOWN\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:24:41.606312", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  target_directions = []\n\n  for pos in workshop_positions:\n    target_x, target_y = pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    # Calculate Manhattan distance to compare distances of workshops\n    manhattan_distance = abs(dx) + abs(dy)\n    \n    # Check if this is the closest workshop so far\n    if not target_directions or manhattan_distance < len(target_directions):\n      target_directions.clear()\n      \n      # Optimize direction based on current facing direction (env._current_state.dir)\n      current_dir = env._current_state.dir\n      \n      # Define direction mapping: DOWN, UP, LEFT, RIGHT -> 0, 1, 2, 3\n      dir_mapping = {0: \"DOWN\", 1: \"UP\", 2: \"LEFT\", 3: \"RIGHT\"}\n      \n      if dx > 0:\n        if current_dir == 3:\n          target_directions.extend([3] * abs(dx))  # RIGHT (same direction)\n        else:\n          target_directions.append((3 - current_dir) % 4 + 2)  # Turn to RIGHT\n          target_directions.extend([3] * abs(dx))\n      elif dx < 0:\n        if current_dir == 2:\n          target_directions.extend([2] * abs(dx))  # LEFT (same direction)\n        else:\n          target_directions.append((2 - current_dir) % 4 + 2)  # Turn to LEFT\n          target_directions.extend([2] * abs(dx))\n      \n      if dy > 0:\n        if current_dir == 1:\n          target_directions.extend([1] * abs(dy))  # UP (same direction)\n        else:\n          target_directions.append((1 - current_dir) % 4 + 2)  # Turn to UP\n          target_directions.extend([1] * abs(dy))\n      elif dy < 0:\n        if current_dir == 0:\n          target_directions.extend([0] * abs(dy))  # DOWN (same direction)\n        else:\n          target_directions.append((0 - current_dir) % 4 + 2)  # Turn to DOWN\n          target_directions.extend([0] * abs(dy))\n\n  # Move to the closest workshop\n  actions.extend(target_directions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:26:43.901010", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_x, target_y = workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    if target_x < 0:\n        actions_to_take.extend([2] * abs(target_x))  # Move LEFT\n    elif target_x > 0:\n        actions_to_take.extend([3] * target_x)       # Move RIGHT\n\n    if target_y < 0:\n        actions_to_take.extend([0] * abs(target_y))  # Move UP\n    elif target_y > 0:\n        actions_to_take.extend([1] * target_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def check_and_move_to_workshop(workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        return get_move_actions(target_workshop_pos) + align_with_workshop(target_workshop_pos)\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def gather_primitives(env, primitives):\n    actions_to_take = []\n    cookbook = env.world.cookbook\n\n    for primitive, required_amount in primitives.items():\n      primitive_index = cookbook.index[primitive]\n      while env._current_state.inventory.get(primitive_index, 0) < required_amount:  # Check if the required amount of primitive is in inventory\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        \n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_position)))\n        \n        # Collect the primitive using USE action\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take.extend(gather_primitives(env, primitives_needed))\n    \n    # Extract the workshop from the recipe and move to it.\n    workshop_name = recipe['_at']\n    actions_to_take.extend(check_and_move_to_workshop(workshop_name))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T02:26:44.893763", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_x, target_y = workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if target_x > 0:\n        if current_dir != 3:  # RIGHT\n            actions_to_take.extend([3] * (3 - current_dir) % 4)\n        actions_to_take.append(4)\n    elif target_x < 0:\n        if current_dir != 1:  # LEFT\n            actions_to_take.extend([3] * (1 - current_dir) % 4)\n        actions_to_take.append(4)\n    \n    if target_y > 0:\n        if current_dir != 2:  # UP\n            actions_to_take.extend([3] * (2 - current_dir) % 4)\n        actions_to_take.append(4)\n    elif target_y < 0:\n        if current_dir != 0:  # DOWN\n            actions_to_take.extend([3] * (0 - current_dir) % 4)\n        actions_to_take.append(4)\n\n    return actions_to_take\n\n  def check_and_move_to_workshop(workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        return get_move_actions(target_workshop_pos) + align_with_workshop(target_workshop_pos)\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def gather_primitives(env, primitives):\n    actions_to_take = []\n    cookbook = env.world.cookbook\n\n    for primitive in primitives:\n      primitive_index = cookbook.index[primitive]\n      \n      # Check if the required amount of primitives is already in inventory\n      if env._current_state.inventory.get(primitive_index, 0) >= primitives[primitive]:\n        continue\n      \n      while env._current_state.inventory.get(primitive_index, 0) < primitives[primitive]:  # Check if the primitive is in inventory\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0:\n            closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n            \n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(tuple(closest_position)))\n            \n            # Collect the primitive using USE action\n            actions_to_take.append(4)\n        else:\n          raise ValueError(f\"No more {primitive} found in the grid.\")\n      \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # Extract primitives needed from the recipe along with their quantities\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take.extend(gather_primitives(env, primitives_needed))\n\n    # Extract the workshop from the recipe and move to it.\n    workshop_name = recipe['_at']\n    actions_to_take.extend(check_and_move_to_workshop(workshop_name))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:32:40.440842", "function_name": "craft", "function_body": "  def get_directions(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n\n      # Determine primary direction based on larger difference\n      if abs(dx) > abs(dy):\n          if dx < 0:\n              actions.append(2)  # LEFT\n          else:\n              actions.append(3)  # RIGHT\n      else:\n          if dy < 0:\n              actions.append(0)  # DOWN\n          else:\n              actions.append(1)  # UP\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_directions(current_pos, target_workshop_pos)\n\n  # Move to the exact position if necessary\n  while tuple(env._current_state.pos) != target_workshop_pos:\n      action = actions_to_reach_workshop.pop(0)\n      env.step(action)\n      current_pos = np.array(env._current_state.pos)\n      additional_actions = get_directions(current_pos, target_workshop_pos)\n      actions_to_reach_workshop.extend(additional_actions)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:32:41.566337", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, workshop_index, current_pos):\n      workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(workshop_positions) == 0:\n          raise ValueError(\"No workshops found in the environment.\")\n      \n      distances = np.linalg.norm(workshop_positions - np.array(current_pos), axis=1)\n      closest_workshop = tuple(workshop_positions[np.argmin(distances)])\n      return closest_workshop\n\n  def get_actions_to_reach(target, current):\n      actions = []\n      dx = target[0] - current[0]\n      dy = target[1] - current[1]\n\n      if dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n\n      if dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  current_pos = env._current_state.pos\n  closest_workshop = find_closest_workshop(env._current_state.grid, workshop_index, current_pos)\n\n  actions_to_reach_workshop = get_actions_to_reach(closest_workshop, current_pos)\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:33:54.529122", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Orient agent towards the workshop (if necessary)\n  current_x, current_y = env._current_state.pos\n  target_x, target_y = closest_workshop_pos\n  \n  if target_x > current_x:\n      actions.append(3)  # RIGHT\n  elif target_x < current_x:\n      actions.append(2)  # LEFT\n  \n  if target_y > current_y:\n      actions.append(1)  # UP\n  elif target_y < current_y:\n      actions.append(0)  # DOWN\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T02:33:55.592368", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      # Calculate direction to move first based on Manhattan distance\n      if abs(x - current_x) > abs(y - current_y):\n          dx = x - current_x\n          dy = 0\n          \n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              actions.extend([2] * abs(dx))  # LEFT\n\n          current_x += dx  # Update current position\n      \n      else:\n          dy = y - current_y\n          dx = 0\n          \n          if dy > 0:\n              actions.extend([1] * abs(dy))  # UP\n          elif dy < 0:\n              actions.extend([0] * abs(dy))  # DOWN\n\n          current_y += dy  # Update current position\n\n      # Move in the remaining direction\n      dx = x - current_x\n      dy = y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T02:35:19.816768", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine direction to move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    # Then determine direction to move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def get_recipe_items_and_workshop(item_index, cookbook):\n      recipe = cookbook.recipes[item_index]\n      items_needed = {cookbook.index[ingredient]: count for ingredient, count in recipe.items() if ingredient != '_at'}\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n      return items_needed, workshop_index\n\n  def gather_items(env, items_needed):\n    actions_to_take = []\n    cookbook = env.world.cookbook\n    current_state = env._current_state\n    grid = current_state.grid\n    \n    for item_index, count in items_needed.items():\n        item_name = cookbook.index[item_index]\n        if current_state.inventory[item_index] < count:\n            # Find all positions of the item to be collected\n            item_positions = np.argwhere(grid[:, :, item_index] == 1)\n            \n            if len(item_positions) > 0:\n                for _ in range(count - current_state.inventory[item_index]):\n                    closest_item = min(\n                        item_positions, \n                        key=lambda pos: abs(pos[0] - current_state.pos[0]) + abs(pos[1] - current_state.pos[1])\n                    )\n                    \n                    target_item_pos = tuple(closest_item)\n\n                    # Calculate move actions to reach the closest item position\n                    actions_to_take.extend(get_move_actions(target_item_pos))\n\n                    # Use the USE action to collect the item\n                    actions_to_take.append(4)\n            else:\n                raise ValueError(f\"No items found for collecting {item_name}.\")\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    items_needed, workshop_index = get_recipe_items_and_workshop(item_index, cookbook)\n\n    actions_to_take = gather_items(env, items_needed)\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:35:20.915994", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move in the y-direction first to avoid unnecessary moves in x-direction\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T02:36:10.096404", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:36:11.235909", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      directions = []\n      \n      if dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      \n      if dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      \n      return directions\n\n  dx = target_x - current_x\n  dy = target_y - current_y\n  \n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:38:11.991680", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    # Then move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n      current_dir = env._current_state.dir\n      target_x, target_y = workshop_pos[0], workshop_pos[1]\n      current_x, current_y = env._current_state.pos\n      \n      if target_x > current_x:\n          # Move RIGHT (3)\n          return [3] if current_dir != 3 else []\n      elif target_x < current_x:\n          # Move LEFT (2)\n          return [2] if current_dir != 2 else []\n      \n      if target_y > current_y:\n          # Move DOWN (1)\n          return [1] if current_dir != 1 else []\n      elif target_y < current_y:\n          # Move UP (0)\n          return [0] if current_dir != 0 else []\n\n      return []\n\n  def collect_primitives(primitive, required_amount):\n    actions_to_take = []\n    \n    cookbook = env.world.cookbook\n    primitive_index = cookbook.index[primitive]\n    \n    while env._current_state.inventory.get(primitive_index, 0) < required_amount:\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0: \n            closest_position = min(\n                positions, \n                key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n            \n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(tuple(closest_position)))\n            \n            # Align with the target position before collecting.\n            actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n            \n            # Collect the primitive using USE action\n            actions_to_take.append(4)\n        else:\n            raise ValueError(f\"Primitives {primitive} not found on the grid.\")\n    \n    return actions_to_take\n\n  def craft_at_workshop(workshop_name):\n      cookbook = env.world.cookbook\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available workshop position to craft the item at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n          \n          # Align with the workshop before using it.\n          actions_to_take.extend(align_with_workshop(tuple(closest_workshop)))\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    actions_to_take = []\n    \n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    # Gather required primitives first.\n    for primitive, amount in primitives_needed.items():\n        actions_to_take.extend(collect_primitives(primitive, amount))\n\n    # Extract the workshop where to craft from the recipe\n    workshop_name = recipe['_at']\n\n    # Craft at the nearest available workshop\n    craft_at_workshop(workshop_name)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.7}}
{"timestamp": "2025-09-17T02:38:13.108029", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Move horizontally first\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    # Then move vertically\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n      current_dir = env._current_state.dir\n      target_dir = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n      # Determine the direction needed to face the workshop.\n      if target_dir == (0, 1):\n          return [3] if current_dir != 3 else []     # Face RIGHT\n      elif target_dir == (0, -1):\n          return [2] if current_dir != 2 else []     # Face LEFT\n      elif target_dir == (1, 0):\n          return [0] if current_dir != 0 else []     # Face DOWN\n      elif target_dir == (-1, 0):\n          return [1] if current_dir != 1 else []     # Face UP\n\n      return []\n\n  def collect_primitive(env, primitive):\n    cookbook = env.world.cookbook\n    \n    primitive_index = cookbook.index[primitive]\n    \n    while env._current_state.inventory.get(primitive_index, 0) < primitives_needed[primitive]:\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(positions) > 0: \n            closest_position = min(\n                positions, \n                key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n            \n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(tuple(closest_position)))\n            \n            # Align with the target position before collecting.\n            actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n            \n            # Collect the primitive using USE action\n            actions_to_take.append(4)\n        else:\n            raise ValueError(f\"Primitives {primitive} not found on the grid.\")\n\n  def find_closest_workshop(env, workshop_index):\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found.\")\n\n  cookbook = env.world.cookbook\n  actions_to_take = []\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    # Gather required primitives first.\n    for primitive in primitives_needed:\n        collect_primitive(env, primitive)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    closest_workshop_pos = find_closest_workshop(env, workshop_index)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(closest_workshop_pos))\n    \n    # Align with the workshop before using it.\n    actions_to_take.extend(align_with_workshop(tuple(closest_workshop_pos)))\n    \n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:39:09.075602", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Ensure the agent is facing the correct direction before using\n  final_actions = []\n\n  # Calculate direction to face\n  dx = target_workshop_pos[0] - current_pos[0]\n  dy = target_workshop_pos[1] - current_pos[1]\n\n  if dx > 0:\n      final_actions.append(3)  # RIGHT\n  elif dx < 0:\n      final_actions.append(2)  # LEFT\n\n  if dy > 0:\n      final_actions.append(1)  # UP\n  elif dy < 0:\n      final_actions.append(0)  # DOWN\n\n  # Now move towards the workshop\n  final_actions.extend(actions_to_reach_workshop)\n\n  final_actions.append(4)  # USE\n\n  return final_actions", "island_id": 1, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T02:39:10.147199", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Prioritize horizontal movement to reduce diagonal steps\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:40:34.738842", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Calculate direction changes and moves\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:40:35.857355", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if env._current_state.dir == 0:  # Facing DOWN\n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              actions.extend([2] * abs(dx))  # LEFT\n          \n          if dy > 0:\n              actions.append(1)  # UP\n              env._current_state.dir = 1\n              actions.extend([1] * (abs(dy) - 1))\n          elif dy < 0:\n              actions.extend([0] * abs(dy))  # DOWN\n      \n      elif env._current_state.dir == 1:  # Facing UP\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              env._current_state.dir = 3\n              actions.extend([3] * (abs(dx) - 1))\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              env._current_state.dir = 2\n              actions.extend([2] * (abs(dx) - 1))\n          \n          if dy > 0:\n              actions.extend([1] * abs(dy))  # UP\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              env._current_state.dir = 0\n              actions.extend([0] * (abs(dy) - 1))\n      \n      elif env._current_state.dir == 2:  # Facing LEFT\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              env._current_state.dir = 3\n              actions.extend([3] * (abs(dx) - 1))\n          elif dx < 0:\n              actions.extend([2] * abs(dx))  # LEFT\n          \n          if dy > 0:\n              actions.append(1)  # UP\n              env._current_state.dir = 1\n              actions.extend([1] * (abs(dy) - 1))\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              env._current_state.dir = 0\n              actions.extend([0] * (abs(dy) - 1))\n      \n      elif env._current_state.dir == 3:  # Facing RIGHT\n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              env._current_state.dir = 2\n              actions.extend([2] * (abs(dx) - 1))\n          \n          if dy > 0:\n              actions.append(1)  # UP\n              env._current_state.dir = 1\n              actions.extend([1] * (abs(dy) - 1))\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              env._current_state.dir = 0\n              actions.extend([0] * (abs(dy) - 1))\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:41:50.999628", "function_name": "craft", "function_body": "  def move_towards(current_pos, target_pos):\n      actions = []\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              \n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n          \n          # Recalculate the direction for the next step\n          direction = get_direction(current_pos, target_pos)\n      \n      return actions\n\n  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n\n  # Calculate actions to move towards the target position\n  actions = move_towards(current_pos, target_pos)\n\n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T02:41:52.123167", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_towards(current_pos, current_dir, target_pos):\n      actions = []\n      direction = get_direction(current_pos, target_pos)\n      \n      while current_pos != target_pos and direction is not None:\n          if inverse_dir_map[current_dir] != direction:\n              actions.append(dir_map[direction])\n              current_dir = dir_map[direction]\n          else:\n              actions.append(4)  # Assuming USE action is represented by index 4\n          \n          # Simulate the move to update current_pos\n          if direction == 'DOWN':\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif direction == 'UP':\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          elif direction == 'RIGHT':\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif direction == 'LEFT':\n              current_pos = (current_pos[0], current_pos[1] - 1)\n          \n          # Recalculate the direction for the next step\n          direction = get_direction(current_pos, target_pos)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos, current_dir = env._current_state.pos, env._current_state.dir\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  inverse_dir_map = {v: k for k, v in dir_map.items()}\n  \n  # Calculate actions to move towards the target position\n  actions = move_towards(current_pos, current_dir, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-17T02:43:01.675399", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n    current_x, current_y = env._current_state.pos\n    \n    # Calculate differences\n    dx = x - current_x\n    dy = y - current_y\n    \n    directions = []\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n    \n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n\n    return directions\n\n  actions = []\n\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n  \n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T02:48:01.935600", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n    current_x, current_y = env._current_state.pos\n    dx = x - current_x\n    dy = y - current_y\n    \n    directions = []\n    \n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  def check_and_turn_if_needed(current_direction, target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dx == 0 and dy == 0:\n        return []\n    \n    direction_to_move = None\n    if dx > 0:\n        direction_to_move = 3  # RIGHT\n    elif dx < 0:\n        direction_to_move = 2  # LEFT\n    elif dy > 0:\n        direction_to_move = 1  # UP\n    else:  # dy < 0\n        direction_to_move = 0  # DOWN\n\n    if direction_to_move != current_direction:\n        actions.append(direction_to_move)\n        time.sleep(1)  # Allow some time for the environment to update\n    \n    return []\n\n  def is_next_to(x, y):\n      current_x, current_y = env._current_state.pos\n      nearby_cells = [\n          (current_x - 1, current_y), \n          (current_x + 1, current_y), \n          (current_x, current_y - 1), \n          (current_x, current_y + 1)\n      ]\n      return any(pos == (x, y) for pos in nearby_cells)\n\n  actions = []\n\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  while not is_next_to(closest_workshop_pos[0], closest_workshop_pos[1]):\n      actions.extend(check_and_turn_if_needed(env._current_state.dir, closest_workshop_pos[0], closest_workshop_pos[1]))\n      actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:49:40.261802", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_dir = env._current_state.dir\n    target_dir = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if target_dir == (0, 1) and current_dir != 3:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 2:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 0:\n        return [(current_dir + 3) % 4]\n\n    return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Initialize the actions list\n        actions_to_take = []\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Align with the target direction\n        actions_to_take.extend(align_with_target(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:49:41.384459", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n    \n    target_directions = {\n        (1, 0): 3,  # RIGHT\n        (-1, 0): 2,  # LEFT\n        (0, 1): 1,  # DOWN\n        (0, -1): 0   # UP\n    }\n    \n    rel_x = target_pos[0] - current_pos[0]\n    rel_y = target_pos[1] - current_pos[1]\n\n    if (rel_x, rel_y) in target_directions:\n        target_dir = target_directions[(rel_x, rel_y)]\n        \n        # Calculate the relative direction to turn\n        relative_turn = (target_dir - current_dir + 4) % 4\n        \n        if relative_turn == 0:\n            return []\n        elif relative_turn == 1:\n            return [3]  # Turn RIGHT\n        elif relative_turn == 2:\n            return [3, 3]  # Turn 180 degrees (RIGHT twice)\n        elif relative_turn == 3:\n            return [2]  # Turn LEFT\n\n    return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Initialize the actions list\n        actions_to_take = []\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Align with the target direction before using the workshop\n        actions_to_take.extend(align_with_target(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T02:51:21.963825", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  def align_direction(current_direction, final_direction):\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      actions = []\n      \n      if current_direction == 'UP':\n          if final_direction == 'LEFT':\n              actions.append(dir_map['LEFT'])\n          elif final_direction == 'RIGHT':\n              actions.append(dir_map['RIGHT'])\n      elif current_direction == 'DOWN':\n          if final_direction == 'LEFT':\n              actions.append(dir_map['LEFT'])\n          elif final_direction == 'RIGHT':\n              actions.append(dir_map['RIGHT'])\n      elif current_direction == 'LEFT':\n          if final_direction == 'UP':\n              actions.append(dir_map['UP'])\n          elif final_direction == 'DOWN':\n              actions.append(dir_map['DOWN'])\n      elif current_direction == 'RIGHT':\n          if final_direction == 'UP':\n              actions.append(dir_map['UP'])\n          elif final_direction == 'DOWN':\n              actions.append(dir_map['DOWN'])\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Align direction towards the target position if not already aligned\n  current_direction = env._current_state.dir\n  final_direction = get_direction(env._current_state.pos, target_pos)\n  actions.extend(align_direction(current_direction, final_direction))\n  \n  # Step 4: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T02:56:22.026949", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  def align_direction(env, target_pos):\n      actions = []\n      current_direction = env._current_state.dir\n      final_direction = get_direction(env._current_state.pos, target_pos)\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_direction != final_direction:\n          if current_direction == 'UP' and final_direction == 'LEFT':\n              actions.append(dir_map['LEFT'])\n              current_direction = 'LEFT'\n          elif current_direction == 'UP' and final_direction == 'RIGHT':\n              actions.append(dir_map['RIGHT'])\n              current_direction = 'RIGHT'\n          elif current_direction == 'DOWN' and final_direction == 'LEFT':\n              actions.append(dir_map['LEFT'])\n              current_direction = 'LEFT'\n          elif current_direction == 'DOWN' and final_direction == 'RIGHT':\n              actions.append(dir_map['RIGHT'])\n              current_direction = 'RIGHT'\n          elif current_direction == 'LEFT' and final_direction == 'UP':\n              actions.append(dir_map['UP'])\n              current_direction = 'UP'\n          elif current_direction == 'LEFT' and final_direction == 'DOWN':\n              actions.append(dir_map['DOWN'])\n              current_direction = 'DOWN'\n          elif current_direction == 'RIGHT' and final_direction == 'UP':\n              actions.append(dir_map['UP'])\n              current_direction = 'UP'\n          elif current_direction == 'RIGHT' and final_direction == 'DOWN':\n              actions.append(dir_map['DOWN'])\n              current_direction = 'DOWN'\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Align direction towards the target position if not already aligned\n  align_actions = align_direction(env, target_pos)\n  actions.extend(align_actions)\n  \n  # Step 4: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:57:39.651711", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def rotate_and_move(target_dir):\n    if (target_dir + 4) % 4 != current_dir:\n        actions.append((target_dir + 4) % 4)\n    actions.append(5)\n\n  def move(dx, dy):\n      # Determine the direction to move in\n      if dx > 0 and current_dir == 3:  # RIGHT\n          rotate_and_move(3)\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0 and current_dir == 2:  # LEFT\n          rotate_and_move(2)\n          actions.extend([2] * abs(dx))  # LEFT\n      else:\n          if dx > 0:\n              move(dx - 1, dy)  # Move towards RIGHT recursively\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              move(dx + 1, dy)  # Move towards LEFT recursively\n              actions.append(2)  # LEFT\n      \n      if dy > 0 and current_dir == 1:  # UP\n          rotate_and_move(1)\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0 and current_dir == 0:  # DOWN\n          rotate_and_move(0)\n          actions.extend([0] * abs(dy))  # DOWN\n      else:\n          if dy > 0:\n              move(dx, dy - 1)  # Move towards UP recursively\n              actions.append(1)  # UP\n          elif dy < 0:\n              move(dx, dy + 1)  # Move towards DOWN recursively\n              actions.append(0)  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T02:57:40.711572", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def move_with_orientation(x, y):\n    target_dir = None\n    current_x, current_y = env._current_state.pos\n    if x > current_x:\n        target_dir = 3  # RIGHT\n    elif x < current_x:\n        target_dir = 2  # LEFT\n    elif y > current_y:\n        target_dir = 1  # UP\n    else:\n        target_dir = 0  # DOWN\n    \n    if target_dir != env._current_state.dir:\n      actions.append(target_dir)\n    \n    move(x - current_x, y - current_y)\n\n  move_with_orientation(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.9}}
{"timestamp": "2025-09-17T02:58:48.582092", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  def get_workshop_positions(env, workshop_index):\n    grid = env._current_state.grid\n    return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  workshop_positions = get_workshop_positions(env, workshop_index)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T02:58:49.644956", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return 'DOWN' if dx > 0 else 'UP'\n      else:\n          return 'RIGHT' if dy > 0 else 'LEFT'\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-17T03:00:54.169394", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T03:00:55.143441", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  def collect_primitive(primitive):\n    \"\"\"Returns actions to collect the given primitive.\"\"\"\n    actions = []\n    primitive_index = env.world.cookbook.index[primitive]\n\n    # Find all positions of the specified primitive in the grid\n    grid = env._current_state.grid\n    primitive_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n    if len(primitive_positions) == 0:\n      raise ValueError(f\"No available {primitive} to collect\")\n\n    current_pos = env._current_state.pos\n\n    # For simplicity, we pick the first available primitive\n    target_pos = tuple(primitive_positions[0])\n\n    # Calculate the path to the target position using A* algorithm\n    path = a_star(current_pos, target_pos)\n\n    if not path:\n      raise ValueError(f\"No valid path to {primitive}\")\n\n    # Convert the path into actions\n    action_map = {\n        \"UP\": env.action_specs()[\"UP\"],\n        \"DOWN\": env.action_specs()[\"DOWN\"],\n        \"LEFT\": env.action_specs()[\"LEFT\"],\n        \"RIGHT\": env.action_specs()[\"RIGHT\"]\n    }\n\n    current_dir = env._current_state.dir\n\n    for i in range(len(path) - 1):\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - path[i][0]\n      delta_y = next_pos[1] - path[i][1]\n\n      if delta_x < 0:\n          actions.append(action_map[\"LEFT\"])\n      elif delta_x > 0:\n          actions.append(action_map[\"RIGHT\"])\n      elif delta_y < 0:\n          actions.append(action_map[\"DOWN\"])\n      else:\n          actions.append(action_map[\"UP\"])\n\n    # Add action to collect the primitive\n    actions.append(env.action_specs()[\"USE\"])\n\n    return actions\n\n  def collect_primitives(primitives):\n    \"\"\"Collect all primitives required for crafting.\"\"\"\n    all_actions = []\n    for primitive in primitives:\n      all_actions.extend(collect_primitive(primitive))\n    return all_actions\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required primitives and workshop\n  required_primitives = [primitive for primitive in recipe if primitive != \"_at\"]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Collect all required primitives\n  actions.extend(collect_primitives(required_primitives))\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
