ecipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n      else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  def find_and_collect_all_primitives(env, item_index):\n    cookbook = env.world.cookbook\n    actions_to_take = []\n    \n    # Get the full recipe including primitives and workshop information\n    recipe = cookbook.recipes[item_index].copy()\n    \n    # Remove '_at' from the recipe to focus only on primitives\n    del recipe['_at']\n    \n    # Collect all primitives needed for crafting the item\n    actions_to_take.extend(collect_primitives(env, recipe))\n    \n    return actions_to_take\n\n  def collect_and_craft(env, item):\n    cookbook = env.world.cookbook\n    \n    # Get the index for the desired item to be crafted\n    item_index = cookbook.index[item]\n    \n    # Check if there is a recipe available for this item\n    if item_index in cookbook.recipes:\n      # Find and collect all primitives required for crafting the item\n      actions_to_take = find_and_collect_all_primitives(env, item_index)\n\n      # Get the closest workshop to craft the item at\n      target_workshop_pos = get_crafting_workshop(env, item_index)\n      \n      # Calculate move actions to reach the closest workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n    \n    return actions_to_take\n\n  # Collect and craft the desired item\n  return collect_and_craft(env, item)", "island_id": 5, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T23:38:39.130665", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def move_and_use(env, target_positions):\n      current_pos = env._current_state.pos\n      \n      # Sort positions based on proximity to the current position\n      sorted_positions = sorted(\n          target_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      actions_to_take = []\n      for pos in sorted_positions:\n          rel_x, rel_y = pos[0] - current_pos[0], pos[1] - current_pos[1]\n          \n          # Determine direction based on relative position and move accordingly\n          if rel_x > 0:\n              actions_to_take.extend([3] * rel_x)  # Move RIGHT\n          elif rel_x < 0:\n              actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n              \n          if rel_y > 0:\n              actions_to_take.extend([1] * rel_y)  # Move DOWN\n          elif rel_y < 0:\n              actions_to_take.extend([0] * abs(rel_y))  # Move UP\n          \n          # Use the USE action at the target position\n          actions_to_take.append(4)\n          \n      return actions_to_take\n\n  def collect_and_move_to_workshop(env, recipe, workshop_name):\n    cookbook = env.world.cookbook\n    \n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find all positions of the specified workshop in the grid\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_and_use(env, workshop_positions))\n        \n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    \n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    actions_to_take = collect_and_move_to_workshop(env, recipe, workshop_name)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T23:38:40.086632", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def move_and_use(env, target_positions):\n      current_pos = env._current_state.pos\n      \n      # Sort positions based on proximity to the current position\n      sorted_positions = sorted(\n          target_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      actions_to_take = []\n      for pos in sorted_positions:\n          rel_x, rel_y = pos[0] - current_pos[0], pos[1] - current_pos[1]\n          \n          # Determine direction based on relative position and move accordingly\n          if rel_x > 0:\n              actions_to_take.extend([3] * rel_x)  # Move RIGHT\n          elif rel_x < 0:\n              actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n              \n          if rel_y > 0:\n              actions_to_take.extend([1] * rel_y)  # Move DOWN\n          elif rel_y < 0:\n              actions_to_take.extend([0] * abs(rel_y))  # Move UP\n          \n          # Use the USE action at the target position\n          actions_to_take.append(4)\n          \n      return actions_to_take\n\n  def get_recipe_items(env, item_index):\n    cookbook = env.world.cookbook\n    \n    if item_index in cookbook.recipes:\n        recipe = cookbook.recipes[item_index].copy()\n        \n        # Remove the '_at' key which indicates the workshop\n        del recipe['_at']\n        \n        return recipe.items(), cookbook.recipes[item_index]['_at']\n    \n    else:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  def check_inventory(env, required_items):\n      current_inventory = env._current_state.inventory\n      missing_items = [item for item, count in required_items if current_inventory.get(item, 0) < count]\n      \n      return missing_items\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Get recipe items and workshop name\n  required_items, workshop_name = get_recipe_items(env, item_index)\n\n  # Check if all required primitives are available in inventory\n  missing_items = check_inventory(env, required_items)\n  \n  actions_to_take = []\n  if missing_items:\n    raise ValueError(f\"Missing primitives: {missing_items}. Please collect these before attempting to craft the item.\")\n    \n  else:\n    # Collect primitives (if not already collected and counted above)\n    actions_to_take.extend(collect_primitives(env, cookbook.recipes[item_index]))\n\n    # Extract the workshop from the original recipe\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_and_use(env, workshop_positions))\n        \n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T23:45:41.657871", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item(env, workshop_index):\n    nonlocal actions_to_take\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_recipe_complete(env, recipe):\n    return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting if not already available in sufficient quantity\n    while not is_recipe_complete(env, recipe):\n        actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
