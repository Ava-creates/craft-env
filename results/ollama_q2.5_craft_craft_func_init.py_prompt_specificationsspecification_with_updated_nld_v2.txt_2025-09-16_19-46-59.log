ex] += 1\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    actions_to_take = []\n\n    # Collect primitives required for crafting\n    actions_to_take.extend(collect_primitives(env, recipe))\n\n    # Craft the item at the specified workshop\n    actions_to_take.extend(craft_item(env, workshop_index))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:02:50.302122", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_item_positions(item_index):\n      \"\"\"Get all positions of the specified item in the grid.\"\"\"\n      return np.argwhere(env._current_state.grid[:, :, item_index] == 1)\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Collect all required items and primitives from the recipe\n    required_items = {item_name: count for item_name, count in recipe.items() if item_name != '_at'}\n    \n    actions_to_take = []\n\n    # Collect each required item or primitive\n    for req_item_name, req_count in required_items.items():\n        req_item_index = cookbook.index[req_item_name]\n        item_positions = get_item_positions(req_item_index)\n\n        while env._current_state.inventory[req_item_index] < req_count and len(item_positions) > 0:\n            closest_item_pos = min(\n                item_positions, \n                key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n            \n            actions_to_take.extend(get_move_actions(tuple(closest_item_pos)))\n            actions_to_take.append(4)  # Collect the item\n            item_positions = get_item_positions(req_item_index)\n\n        if env._current_state.inventory[req_item_index] < req_count:\n            raise ValueError(f\"Not enough {req_item_name} to craft {item}.\")\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = get_item_positions(workshop_index)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        actions_to_take.extend(get_move_actions(tuple(closest_workshop)))\n        actions_to_take.append(4)  # Craft the item at the workshop\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:02:51.281467", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_required_items(recipe, inventory):\n      required_items = {k: v for k, v in recipe.items() if k != '_at'}\n      available_inventory = {i: c for i, c in enumerate(inventory) if c > 0}\n\n      additional_actions = []\n      for item_index, quantity_needed in required_items.items():\n          inventory_count = available_inventory.get(item_index, 0)\n          if inventory_count < quantity_needed:\n              # Calculate the number of items to collect\n              missing_quantity = quantity_needed - inventory_count\n\n              # Assuming we have a function `collect` that returns actions needed to collect an item\n              additional_actions.extend(collect(env, item_index) * missing_quantity)\n\n      return additional_actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract required items and their quantities from the recipe\n    required_items = {k: v for k, v in recipe.items() if k != '_at'}\n\n    # Collect additional items needed based on inventory\n    actions_to_take = get_required_items(recipe, env._current_state.inventory)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:04:49.058766", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_directional_actions(target_dir):\n      \"\"\"Get the necessary turn actions to face a specific direction.\"\"\"\n      current_dir = env._current_state.dir\n      \n      if current_dir == target_dir:\n          return []\n\n      # Define the turning sequence for each direction\n      turn_sequences = {\n          (0, 1): [4],        # UP -> DOWN\n          (0, 2): [4, 4],     # UP -> LEFT\n          (0, 3): [4, 4, 4],  # UP -> RIGHT\n          (1, 0): [],         # DOWN -> UP\n          (1, 2): [4],        # DOWN -> LEFT\n          (1, 3): [4, 4],     # DOWN -> RIGHT\n          (2, 0): [4],        # LEFT -> UP\n          (2, 1): [4, 4],     # LEFT -> DOWN\n          (2, 3): [4],        # LEFT -> RIGHT\n          (3, 0): [4, 4],     # RIGHT -> UP\n          (3, 1): [4, 4, 4],  # RIGHT -> DOWN\n          (3, 2): [4]         # RIGHT -> LEFT\n      }\n      \n      return turn_sequences[(current_dir, target_dir)]\n\n  def ensure_facing_correct_direction(target_workshop_pos):\n    \"\"\"Ensure the agent is facing the correct direction before using.\"\"\"\n    current_pos = env._current_state.pos\n    current_x, current_y = current_pos\n    target_x, target_y = target_workshop_pos\n    \n    if target_x > current_x:\n        target_dir = 3  # RIGHT\n    elif target_x < current_x:\n        target_dir = 2  # LEFT\n    else:\n        if target_y > current_y:\n            target_dir = 1  # DOWN\n        else:\n            target_dir = 0  # UP\n    \n    return get_directional_actions(target_dir)\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Determine the direction to face based on the position of the workshop relative to the agent\n        actions_to_take.extend(ensure_facing_correct_direction(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T09:04:50.030074", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_directional_actions(target_pos):\n      \"\"\"Get the necessary turn actions to face a specific position.\"\"\"\n      current_dir = env._current_state.dir\n      current_x, current_y = env._current_state.pos\n      target_x, target_y = target_pos\n      \n      if target_x > current_x:\n          if current_dir == 0:  # UP\n              return [4]  # RIGHT\n          elif current_dir == 1:  # DOWN\n              return [4, 4]  # LEFT\n          elif current_dir == 2:  # LEFT\n              return [4, 4, 4]  # RIGHT\n      elif target_x < current_x:\n          if current_dir == 0:  # UP\n              return [4, 4]  # LEFT\n          elif current_dir == 1:  # DOWN\n              return [4, 4, 4]  # RIGHT\n          elif current_dir == 3:  # RIGHT\n              return [4]  # LEFT\n      \n      if target_y > current_y:\n          if current_dir == 0:  # UP\n              return []  # DOWN\n          elif current_dir == 2:  # LEFT\n              return [4, 4]  # DOWN\n          elif current_dir == 3:  # RIGHT\n              return [4, 4]  # DOWN\n      elif target_y < current_y:\n          if current_dir == 1:  # DOWN\n              return []  # UP\n          elif current_dir == 2:  # LEFT\n              return [4]  # UP\n          elif current_dir == 3:  # RIGHT\n              return [4]  # UP\n      \n      return []\n\n  def ensure_required_items_in_inventory():\n    \"\"\"Ensure that all required items are in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    world = env.world\n\n    item_index = cookbook.index[item]\n    \n    if item_index not in cookbook.recipes:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n    \n    recipe = cookbook.recipes[item_index]\n\n    required_items = [cookbook.index[ingredient] for ingredient, _ in recipe.items() if ingredient != '_at']\n\n    current_inventory = env._current_state.inventory\n\n    # Check if all required items are in the inventory\n    missing_items = []\n    for item in required_items:\n        if item not in current_inventory or current_inventory[item] < 1:\n            missing_items.append(item)\n\n    if missing_items:\n        raise ValueError(f\"Missing items in inventory to craft {item}: {missing_items}\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Ensure all required items are in the inventory before crafting\n  ensure_required_items_in_inventory()\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Fetch the recipe details for the item\n  recipe = cookbook.recipes[item_index]\n\n  # Extract the workshop from the recipe\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) > 0:\n      # Choose the closest available workshop position to craft the item at\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Get directional actions to face the correct position before using\n      actions_to_take.extend(get_directional_actions(target_workshop_pos))\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:05:47.770743", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n      # Avoid using the USE action every time we move to prevent unnecessary interactions\n      if env._current_state.grid[current_x, current_y, workshop_index] == 1:\n          actions.append(4)  # USE\n          break\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:05:48.836212", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          else:\n              actions.append(2)  # LEFT\n              current_x -= 1\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n              current_y += 1\n          else:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 5.9}}
{"timestamp": "2025-09-17T09:06:54.735559", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions_to_take = []\n\n    # Calculate the direction to move based on relative position\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n\n      target_workshop_pos = tuple(closest_workshop)\n\n      actions_to_take = get_move_actions(target_workshop_pos)\n      actions_to_take.append(4)  # Craft the item at the workshop\n\n      return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:06:55.819752", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine the direction to move first (right/left or up/down) based on the shortest path heuristic\n    if abs(rel_x) > abs(rel_y):\n        # Move RIGHT or LEFT to align with the x-axis of the target position\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))\n        \n        # Then move DOWN or UP to reach the y-axis of the target position\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        # Move DOWN or UP to align with the y-axis of the target position\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))\n        \n        # Then move RIGHT or LEFT to reach the x-axis of the target position\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n\n      target_workshop_pos = tuple(closest_workshop)\n\n      actions_to_take = get_move_actions(target_workshop_pos)\n      actions_to_take.append(4)  # Craft the item at the workshop\n\n      return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:08:36.651194", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T09:08:37.790284", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def craft_item(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def collect_and_craft(env, item_index):\n    cookbook = env.world.cookbook\n\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Craft the item at the specified workshop\n    craft_item(env, workshop_index)\n    \n    return actions_to_take\n\n  actions_to_take = []\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Collect and craft the item using helper functions\n    actions_to_take.extend(collect_and_craft(env, item_index))\n    \n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.8999996}}
{"timestamp": "2025-09-17T09:11:13.197921", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_inventory = env._current_state.inventory[required_item_index]\n\n              if current_inventory < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      actions.extend(handle_missing_primitives(env, cookbook, primitive))\n      \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n    \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n    if required_item_index not in cookbook.recipes:\n        # This is a primitive item\n        return collect(env, cookbook.index.get_key(required_item_index))\n\n    recipe = cookbook.recipes[required_item_index]\n    workshop_name = recipe['_at']\n    \n    # Check if the required ingredients are available or can be crafted\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            required_amount = recipe[ingredient_index]\n            current_inventory = env._current_state.inventory[ingredient_index]\n\n            if current_inventory < required_amount:\n                handle_missing_primitives(env, cookbook, ingredient_index)\n    \n    # Craft the item at the specified workshop\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {required_item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index not in cookbook.recipes:\n      return collect(env, item)  # Collect the primitive directly\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:11:14.171079", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Handle missing primitives or craft them\n              actions.extend(handle_missing_primitives(env, cookbook, required_item_index))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n    \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n    if required_item_index not in cookbook.recipes:\n        # This is a primitive item\n        return collect(env, cookbook.index.get_key(required_item_index))\n\n    recipe = cookbook.recipes[required_item_index]\n    workshop_name = recipe['_at']\n    \n    # Check if the required ingredients are available or can be crafted\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at' and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n            handle_missing_primitives(env, cookbook, ingredient_index)\n    \n    # Craft the item at the specified workshop\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {required_item}.\")\n\n  def craft_item(env, item_index):\n      \"\"\"Craft an item using its index.\"\"\"\n      cookbook = env.world.cookbook\n\n      if item_index not in cookbook.recipes:\n          return collect(env, cookbook.index.get_key(item_index))  # Collect the primitive directly\n      \n      recipe = cookbook.recipes[item_index]\n\n      # Gather required items before crafting\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n      \n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available workshop position to craft the item at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      else:\n          raise ValueError(f\"No workshops found for crafting {required_item}.\")\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Craft the item using its index\n  actions_to_take = craft_item(env, item_index)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:13:12.914720", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_directional_actions(target_dir):\n      \"\"\"Get the necessary turn actions to face a specific direction.\"\"\"\n      current_dir = env._current_state.dir\n      \n      if current_dir == target_dir:\n          return []\n\n      # Define the turning sequence for each direction\n      turn_sequences = {\n          (0, 1): [4],        # UP -> DOWN\n          (0, 2): [4, 4],     # UP -> LEFT\n          (0, 3): [4, 4, 4],  # UP -> RIGHT\n          (1, 0): [],         # DOWN -> UP\n          (1, 2): [4],        # DOWN -> LEFT\n          (1, 3): [4, 4],     # DOWN -> RIGHT\n          (2, 0): [4],        # LEFT -> UP\n          (2, 1): [4, 4],     # LEFT -> DOWN\n          (2, 3): [4],        # LEFT -> RIGHT\n          (3, 0): [4, 4],     # RIGHT -> UP\n          (3, 1): [4, 4, 4],  # RIGHT -> DOWN\n          (3, 2): [4]         # RIGHT -> LEFT\n      }\n      \n      return turn_sequences[(current_dir, target_dir)]\n\n  def collect_primitives(primitive_name):\n    \"\"\"Collects the specified primitive item.\"\"\"\n    primitive_index = env.world.cookbook.index[primitive_name]\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    actions_to_take = []\n    \n    for pos in primitive_positions:\n        target_pos = tuple(pos)\n        \n        # Calculate move actions to reach the primitive\n        actions_to_take.extend(get_move_actions(target_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Optionally, move back to a neutral position if needed\n        \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n\n      # Collect all required primitives\n      actions_to_take = []\n      for ingredient, count in recipe.items():\n          if ingredient != '_at' and count > 0:  # Skip the '_at' key and ensure we only collect positive counts\n              primitive_name = ingredient\n              actions_to_take.extend(collect_primitives(primitive_name))\n\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n          \n          # Determine the direction to face based on the position of the workshop relative to the agent\n          current_x, current_y = current_pos\n          target_x, target_y = target_workshop_pos\n          \n          if target_x > current_x:\n              target_dir = 3  # RIGHT\n          elif target_x < current_x:\n              target_dir = 2  # LEFT\n          else:\n              if target_y > current_y:\n                  target_dir = 1  # DOWN\n              else:\n                  target_dir = 0  # UP\n\n          # Add actions to face the correct direction\n          actions_to_take.extend(get_directional_actions(target_dir))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:13:13.994553", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_directional_actions(target_dir):\n      \"\"\"Get the necessary turn actions to face a specific direction.\"\"\"\n      current_dir = env._current_state.dir\n      \n      if current_dir == target_dir:\n          return []\n\n      # Define the turning sequence for each direction\n      turn_sequences = {\n          (0, 1): [4],        # UP -> DOWN\n          (0, 2): [4, 4],     # UP -> LEFT\n          (0, 3): [4, 4, 4],  # UP -> RIGHT\n          (1, 0): [],         # DOWN -> UP\n          (1, 2): [4],        # DOWN -> LEFT\n          (1, 3): [4, 4],     # DOWN -> RIGHT\n          (2, 0): [4],        # LEFT -> UP\n          (2, 1): [4, 4],     # LEFT -> DOWN\n          (2, 3): [4],        # LEFT -> RIGHT\n          (3, 0): [4, 4],     # RIGHT -> UP\n          (3, 1): [4, 4, 4],  # RIGHT -> DOWN\n          (3, 2): [4]         # RIGHT -> LEFT\n      }\n      \n      return turn_sequences[(current_dir, target_dir)]\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Determine the direction to face based on the position of the workshop relative to the agent\n        current_x, current_y = current_pos\n        target_x, target_y = target_workshop_pos\n        \n        if target_x > current_x:\n            target_dir = 3  # RIGHT\n        elif target_x < current_x:\n            target_dir = 2  # LEFT\n        else:\n            if target_y > current_y:\n                target_dir = 1  # DOWN\n            else:\n                target_dir = 0  # UP\n\n        # Add actions to face the correct direction\n        actions_to_take.extend(get_directional_actions(target_dir))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T09:14:10.058339", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def navigate_to(x, y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n    \n    while (current_x != x) or (current_y != y):\n        dx = x - current_x\n        dy = y - current_y\n\n        if abs(dx) > abs(dy):\n            if dx > 0:\n                actions.append(3)  # RIGHT\n                current_x += 1\n            else:\n                actions.append(2)  # LEFT\n                current_x -= 1\n        else:\n            if dy > 0:\n                actions.append(1)  # UP\n                current_y += 1\n            else:\n                actions.append(0)  # DOWN\n                current_y -= 1\n\n    return actions\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Navigate to the closest workshop\n  actions = navigate_to(closest_workshop_pos[0], closest_workshop_pos[1])\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:14:11.167858", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop\n  while (current_x != target_x) or (current_y != target_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          else:\n              actions.append(2)  # LEFT\n              current_x -= 1\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n              current_y += 1\n          else:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:15:42.678198", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Prioritize moving in the direction with the largest relative distance\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n        \n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        \n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n\n    return actions_to_take\n\n  def get_required_primitives(item_index, cookbook):\n      required_primitives = []\n      \n      # Check if the item is in the recipes\n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n          \n          for primitive_name, count in recipe.items():\n              if primitive_name != '_at':\n                  primitive_index = cookbook.index[primitive_name]\n                  required_primitives.append((primitive_index, count))\n      \n      return required_primitives\n\n  def check_inventory(env_state, required_primitives):\n    inventory_counts = {i: (env_state.grid[:, :, i] == 1).sum() for i in env.world.cookbook.grab_all}\n    sufficient = True\n    for primitive_index, count in required_primitives:\n        if inventory_counts.get(primitive_index, 0) < count:\n            sufficient = False\n    return sufficient\n\n  def collect_primitive(env, primitive_index, count):\n      actions_to_take = []\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n\n          # Sort primitives by proximity to the current position\n          sorted_primitives = sorted(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          collected_count = 0\n          for pos in sorted_primitives:\n              if collected_count >= count:\n                  break\n\n              target_primitive_pos = tuple(pos)\n\n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              collected_count += 1\n      \n      return actions_to_take\n\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    required_primitives = get_required_primitives(item_index, cookbook)\n    \n    while not check_inventory(env._current_state, required_primitives):\n        # Collect all required primitives that are missing\n        for primitive_index, count in required_primitives:\n            collected_count = (env._current_state.grid[:, :, primitive_index] == 1).sum()\n            if collected_count < count:\n                actions_to_take.extend(collect_primitive(env, primitive_index, count - collected_count))\n        \n        # Ensure that the inventory is updated after collecting\n        env.step(4)  # This will use the collected items to update the inventory\n\n    # Once all required primitives are collected, craft the item\n    actions_to_take.extend(craft_v1(env, item))\n    \n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:15:43.752571", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Move in the direction with the largest relative distance first\n    if abs(rel_x) > abs(rel_y):\n        # Move horizontally\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n        \n        # Then move vertically\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n    else:\n        # Move vertically first\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        \n        # Then move horizontally\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:17:38.926593", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        # Choose the closest available primitive position to collect it from.\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    world = env.world\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the nearest workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 5.2}}
