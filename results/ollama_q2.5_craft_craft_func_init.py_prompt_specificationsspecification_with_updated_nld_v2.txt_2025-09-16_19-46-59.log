        )\n\n          for closest_primitive in sorted_primitives:\n              target_primitive_pos = tuple(closest_primitive)\n              \n              # Calculate move actions to reach the closest position\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n              # Use the USE action to collect the item\n              actions_to_take.append(4)\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n      \n      return actions_to_take\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n      return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    workshop_name = recipe['_at']\n    try:\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        actions_to_take.append(4)  # Craft the item\n    except ValueError as e:\n        print(f\"Warning: {e}\")\n        return actions_to_take\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:32:30.508320", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move first (horizontally or vertically)\n    if abs(rel_x) >= abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        else:\n            actions_to_take.extend([2] * -rel_x)  # LEFT\n        \n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        else:\n            actions_to_take.extend([0] * -rel_y)  # UP\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        else:\n            actions_to_take.extend([0] * -rel_y)  # UP\n        \n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        else:\n            actions_to_take.extend([2] * -rel_x)  # LEFT\n    \n    return actions_to_take\n\n  def get_path(start, end):\n    \"\"\"Simple BFS to find a path from start to end.\"\"\"\n    queue = collections.deque([(start, [])])\n    visited = set()\n    \n    while queue:\n        (x, y), path = queue.popleft()\n        \n        if (x, y) == end:\n            return path\n        \n        visited.add((x, y))\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n                if (nx, ny) not in visited and env._current_state.grid[nx, ny, 0] == 0:  # Assuming 0 is traversable\n                    queue.append(((nx, ny), path + [(dx, dy)]))\n    \n    return None\n\n  def actions_from_path(path):\n    \"\"\"Convert a list of (dx, dy) to action indices.\"\"\"\n    actions = []\n    for dx, dy in path:\n        if dx == -1 and dy == 0:\n            actions.append(2)  # LEFT\n        elif dx == 1 and dy == 0:\n            actions.append(3)  # RIGHT\n        elif dx == 0 and dy == -1:\n            actions.append(0)  # UP\n        elif dx == 0 and dy == 1:\n            actions.append(1)  # DOWN\n    return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Get the path to the closest workshop\n        path = get_path(current_pos, target_workshop_pos)\n        \n        if path is not None:\n            actions_to_take = actions_from_path(path) + [4]  # USE at the end\n            \n            return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T09:32:31.582053", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move first (horizontally or vertically)\n    if abs(rel_x) >= abs(rel_y):\n        # Move horizontally first\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        else:\n            actions_to_take.extend([2] * -rel_x)  # LEFT\n        \n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        else:\n            actions_to_take.extend([0] * -rel_y)  # UP\n    else:\n        # Move vertically first\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        else:\n            actions_to_take.extend([0] * -rel_y)  # UP\n        \n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        else:\n            actions_to_take.extend([2] * -rel_x)  # LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, primitives):\n      actions = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          \n          # Find all positions of the primitive in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n          \n          if len(primitive_positions) > 0:\n              # Choose the closest available primitive position to collect it from\n              current_pos = env._current_state.pos\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions.extend(get_move_actions(target_primitive_pos))\n\n              # Use the USE action to collect the primitive\n              actions.append(4)  # USE\n\n          else:\n              raise ValueError(f\"No primitives found for {primitive}.\")\n      return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Extract primitives from the recipe\n    primitive_names = [name for name in recipe if name != '_at']\n\n    # Collect all required primitives\n    actions_to_take = collect_primitives(env, primitive_names)\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)  # USE\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 2.6000001}}
{"timestamp": "2025-09-17T09:34:34.091812", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in cookbook.primitives:\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the COLLECT action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      else:\n        # If the item is not a primitive, craft it recursively.\n        actions_to_take.extend(craft_v2(env, cookbook.index.get_name(primitive_index)))\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    world = env.world\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the nearest workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:34:35.082226", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in cookbook.primitives:  # Check if it's a primitive\n        # Find all positions of the specified primitive in the grid.\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the COLLECT action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      else:  # If it's not a primitive, it must be another item that needs crafting\n        # Recursively ensure this item is crafted and added to inventory.\n        actions_to_take.extend(craft_v2(env, cookbook.index.get_name(primitive_index)))\n      \n      # Update inventory and missing items count.\n      inventory[primitive_index] += required_amount\n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)  # Assuming USE is used for crafting as well.\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory, either by collecting primitives or crafting other items.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the nearest workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:36:40.797803", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      \"\"\"Gather all required items for a given recipe.\"\"\"\n      actions = []\n      current_inventory = env._current_state.inventory\n      \n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              needed_amount = max(required_amount - current_inventory[required_item_index], 0)\n              \n              if needed_amount > 0:\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, cookbook.index.get_key(primitive), needed_amount))\n      \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive, amount=1) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified number of a primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      actions_to_take = []\n      \n      while amount > 0 and len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          # Update positions after collecting one item\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n          \n          amount -= 1\n      \n      if amount > 0:\n          raise ValueError(f\"Not enough primitives found for collecting {primitive}.\")\n      \n      return actions_to_take\n\n  def craft_item(env, cookbook, item_index):\n      \"\"\"Craft an item by gathering required items and using the appropriate workshop.\"\"\"\n      if item_index not in cookbook.recipes:\n          # This is a primitive item\n          return collect(env, cookbook.index.get_key(item_index))\n\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      \n      # Gather required items before crafting\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      # Find the closest available workshop position to craft the item at\n      workshop_index = cookbook.index[workshop_name]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Craft the item by gathering required items and using the appropriate workshop\n  actions_to_take = craft_item(env, cookbook, item_index)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:36:41.922980", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move vertically first (UP/DOWN)\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    # Then move horizontally (LEFT/RIGHT)\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      \"\"\"Gather all required items for a given recipe.\"\"\"\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_inventory = env._current_state.inventory[required_item_index]\n\n              if current_inventory < required_amount:\n                  additional_needed = required_amount - current_inventory\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n      \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def craft_item(env, cookbook, item_index):\n      \"\"\"Craft an item by gathering required items and using the appropriate workshop.\"\"\"\n      if item_index not in cookbook.recipes:\n          # This is a primitive item\n          return collect(env, cookbook.index.get_key(item_index))\n\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      \n      # Gather required items before crafting\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      # Find the closest available workshop position to craft the item at\n      workshop_index = cookbook.index[workshop_name]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Craft the item by gathering required items and using the appropriate workshop\n  actions_to_take = craft_item(env, cookbook, item_index)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": 4.6}}
{"timestamp": "2025-09-17T09:38:13.831896", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # If the relative y distance is greater than x, prioritize moving vertically first\n    if abs(rel_y) > abs(rel_x):\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n        \n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n    else:\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)\n        else:\n            actions_to_take.extend([2] * abs(rel_x))\n\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)\n        else:\n            actions_to_take.extend([0] * abs(rel_y))\n            \n    return actions_to_take\n\n  def ensure_inventory(env, item):\n    \"\"\"Ensure all ingredients for the specified item are in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired item to be crafted\n    item_index = cookbook.index[item]\n    \n    # Check if there is a recipe available for this item\n    if item_index not in cookbook.recipes:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n    \n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # Iterate through the recipe to gather all required ingredients\n    for ingredient, quantity in recipe.items():\n        if ingredient == '_at':\n            continue  # Skip the workshop information\n\n        ingredient_index = cookbook.index[ingredient]\n        \n        if np.sum(env._current_state.inventory[ingredient_index]) < quantity:\n            # Find all positions of the specified ingredient in the grid\n            ingredient_positions = np.argwhere(env._current_state.grid[:, :, ingredient_index] == 1)\n\n            if len(ingredient_positions) > 0:\n                current_pos = env._current_state.pos\n\n                closest_ingredient = min(\n                    ingredient_positions, \n                    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                )\n                \n                target_ingredient_pos = tuple(closest_ingredient)\n\n                # Calculate move actions to reach the closest ingredient position\n                actions_to_take.extend(get_move_actions(target_ingredient_pos))\n\n                # Use the COLLECT action to collect the item\n                actions_to_take.append(4)  # Assuming COLLECT_FUNC maps to index 4\n\n    return actions_to_take\n\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Ensure all ingredients are in the inventory\n  gather_actions = ensure_inventory(env, item)\n  \n  if len(gather_actions) > 0:\n      print(\"Gathering required ingredients...\")\n      for action in gather_actions:\n          reward, done, observations = env.step(action)\n          total_reward += reward\n          if done:\n              break\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  recipe = cookbook.recipes[item_index]\n\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  # Find all positions of the specified workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) > 0:\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      craft_actions = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      craft_actions.append(4)  # Assuming CRAFT_FUNC maps to index 4\n\n      return gather_actions + craft_actions\n\n  else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:38:14.911139", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Calculate actions for movement in the y direction first\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    # Then calculate actions for movement in the x direction\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T09:41:06.973625", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      \"\"\"Gather all required items for a given recipe.\"\"\"\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_inventory = env._current_state.inventory[required_item_index]\n\n              if current_inventory < required_amount:\n                  additional_needed = required_amount - current_inventory\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n      \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n    \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n    if required_item_index not in cookbook.recipes:\n        # This is a primitive item\n        return collect(env, cookbook.index.get_key(required_item_index))\n\n    recipe = cookbook.recipes[required_item_index]\n    workshop_name = recipe['_at']\n    \n    # Check if the required ingredients are available or can be crafted\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            required_amount = recipe[ingredient_index]\n            current_inventory = env._current_state.inventory[ingredient_index]\n\n            if current_inventory < required_amount:\n                additional_needed = required_amount - current_inventory\n                actions_to_take = []\n                \n                primitives_needed = get_primitives_for_item(cookbook, ingredient_index)\n                \n                for primitive in primitives_needed:\n                    actions_to_take.extend(collect(env, primitive))\n    \n    # Craft the item at the specified workshop\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    return actions_to_take\n\n  def craft_item_at_workshop(env, cookbook, item_index):\n      \"\"\"Craft an item at the closest available workshop.\"\"\"\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index]\n\n      # Gather required items before crafting\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      # Extract the workshop from the recipe\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available workshop position to craft the item at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def can_craft_with_inventory(env, recipe):\n    \"\"\"Check if all required items are available in inventory.\"\"\"\n    for required_item_index in recipe.keys():\n        if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n            return False\n    return True\n\n  def craft_recursively(env, cookbook, item_index):\n      \"\"\"Craft an item recursively by gathering all necessary ingredients.\"\"\"\n      if can_craft_with_inventory(env, cookbook.recipes[item_index]):\n          # If all required items are available in inventory, craft the item\n          actions_to_take = craft_item_at_workshop(env, cookbook, item_index)\n      else:\n          # Otherwise, gather the required items first\n          recipe = cookbook.recipes[item_index]\n          \n          for ingredient_index in recipe.keys():\n              if ingredient_index != '_at' and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n                  additional_needed = recipe[ingredient_index] - env._current_state.inventory[ingredient_index]\n                  \n                  primitives_needed = get_primitives_for_item(cookbook, ingredient_index)\n                  \n                  for primitive in primitives_needed:\n                      actions_to_take.extend(collect(env, cookbook.index.get_key(primitive)))\n          \n          # After gathering all required items, craft the item\n          actions_to_take.extend(craft_item_at_workshop(env, cookbook, item_index))\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Craft the item recursively by gathering all necessary ingredients\n  actions_to_take = craft_recursively(env, cookbook, item_index)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:41:07.970288", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      \"\"\"Gather all required items for a given recipe.\"\"\"\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_inventory = env._current_state.inventory[required_item_index]\n\n              if current_inventory < required_amount:\n                  additional_needed = required_amount - current_inventory\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  \n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n      \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def craft_item_at_workshop(env, cookbook, item_index):\n      \"\"\"Craft an item at the closest available workshop.\"\"\"\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index]\n\n      # Gather required items before crafting\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      # Extract the workshop from the recipe\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          # Choose the closest available workshop position to craft the item at\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n      return actions_to_take\n\n  def can_craft(env, cookbook, recipe):\n      \"\"\"Check if all required items are available in the inventory.\"\"\"\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_inventory = env._current_state.inventory[required_item_index]\n\n              if current_inventory < required_amount:\n                  return False\n      return True\n\n  def handle_missing_primitives(env, cookbook, item_index):\n      \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n      if item_index not in cookbook.recipes:\n          # This is a primitive item\n          return collect(env, cookbook.index.get_key(item_index))\n\n      recipe = cookbook.recipes[item_index]\n      \n      # Check if the required ingredients are available or can be crafted\n      for ingredient_index in recipe.keys():\n          if ingredient_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_inventory = env._current_state.inventory[ingredient_index]\n\n              if current_inventory < required_amount:\n                  additional_needed = required_amount - current_inventory\n\n                  primitives_needed = get_primitives_for_item(cookbook, ingredient_index)\n                  \n                  for primitive in primitives_needed:\n                      actions_to_take.extend(handle_missing_primitives(env, cookbook, primitive))\n\n      # Craft the item at the closest available workshop\n      actions_to_take = craft_item_at_workshop(env, cookbook, item_index)\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    actions_to_take = []\n\n    # If all required items are already in inventory, directly proceed to crafting\n    if can_craft(env, cookbook, recipe):\n        actions_to_take.extend(craft_item_at_workshop(env, cookbook, item_index))\n    else:\n        # Handle missing primitives before crafting\n        actions_to_take.extend(handle_missing_primitives(env, cookbook, item_index))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T09:43:50.572783", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    actions_to_take = []\n\n    # Determine the direction to move in and add corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_name in cookbook.recipes:  # If the item is not a primitive\n          actions_to_take.extend(resolve_dependencies(env, primitive_index))\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        # Choose the closest available primitive position to collect it from.\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def resolve_dependencies(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the item is not a primitive, try to craft it.\n      if primitive_name in cookbook.recipes:\n        actions_to_take.extend(resolve_dependencies(env, primitive_index))\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the COLLECT action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  if item in cookbook.index:\n      item_index = cookbook.index[item]\n      \n      # Check if there is a recipe available for this item.\n      if item_index in cookbook.recipes:\n        # Ensure all required items are in the inventory.\n        actions_to_take = resolve_dependencies(env, item_index)\n        \n        # Craft the item at the appropriate workshop.\n        actions_to_take.extend(craft_item(env, item_index))\n      else:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n  else:\n    raise ValueError(f\"Item {item} not found in the cookbook.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 5.2}}
