{"timestamp": "2025-09-17T11:01:41.442684", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n\n    # Determine the direction of movement and add corresponding actions\n    if abs(rel_y) > abs(rel_x):\n        # Prioritize moving vertically first\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # Move DOWN\n        else:\n            actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    else:\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # Move RIGHT\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n\n    # Then move horizontally\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # Move RIGHT\n        else:\n            actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # Move DOWN\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      workshop_name = recipe['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n\n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)  # Assuming USE is represented by action index 4\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 2.7}}
{"timestamp": "2025-09-17T11:03:40.582809", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n              if current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T11:03:41.542364", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, item_index):\n      \"\"\"Gathers all required items recursively.\"\"\"\n      if item_index in env._current_state.inventory and env._current_state.inventory[item_index] > 0:\n          return []\n\n      recipe = cookbook.recipes[item_index]\n      actions = []\n      for required_item_name, count in recipe.items():\n          if required_item_name == '_at':\n              continue\n          required_item_index = cookbook.index[required_item_name]\n          \n          # If the item is not available in inventory, gather it\n          if env._current_state.inventory[required_item_index] < count:\n              actions.extend(gather_required_items(env, cookbook, required_item_index))\n              actions.extend(collect(env, required_item_name, count))\n\n      return actions\n\n  def collect(env, primitive, required_count) -> list[int]:\n      \"\"\"Collects the specified number of primitives.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n      primitive_index = cookbook.index[primitive]\n\n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n\n          actions_to_take = []\n          collected_count = 0\n\n          while collected_count < required_count and len(primitive_positions) > 0:\n              # Choose the closest available position to collect the item at\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest position\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n              # Use the USE action to collect the item\n              actions_to_take.append(4)\n              collected_count += 1\n\n              # Update the grid and current state inventory\n              env._current_state.grid[target_primitive_pos[0], target_primitive_pos[1], primitive_index] = 0\n              env._current_state.inventory[primitive_index] += 1\n\n              # Remove the collected position from available positions\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    actions_to_take = gather_required_items(env, cookbook, item_index)\n\n    # Extract the workshop from the recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T11:04:45.817616", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def is_item_in_inventory(item):\n    item_index = env.world.cookbook.index[item]\n    return env._current_state.inventory[item_index] > 0\n\n  actions = []\n  \n  # Check if the item is already in inventory\n  if is_item_in_inventory(item):\n      print(f\"{item} already in inventory.\")\n      return []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions_to_reach_workshop = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(actions_to_reach_workshop)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T11:04:46.884086", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  path_actions = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(path_actions)\n\n  for _ in range(len(path_actions)):\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T11:06:31.041430", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n    \n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n    \n    # Find closest workshop position to craft the item at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T11:06:32.162902", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item_at_workshop(env, workshop_name):\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n    \n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n    \n    # Craft the item at the specified workshop\n    actions_to_take.extend(craft_item_at_workshop(env, workshop_name))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 7.2}}
{"timestamp": "2025-09-17T11:08:09.510125", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def a_star(start, goal, grid):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:  # Assuming 0 is walkable\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0])  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n      if env._current_state.grid[px, py] == env.world.cookbook.index[\"WORKSHOP0\"] or \\\n         env._current_state.grid[px, py] == env.world.cookbook.index[\"WORKSHOP1\"] or \\\n         env._current_state.grid[px, py] == env.world.cookbook.index[\"WORKSHOP2\"]:\n          actions.append(4)  # USE to interact with the workshop\n\n  actions.append(4)  # Craft the item at the workshop\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T11:08:10.635606", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop using A* pathfinding for better efficiency\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n      open_set = set()\n      closed_set = set()\n      g_cost = {start: 0}\n      f_cost = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda pos: f_cost[pos])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if grid[neighbor] == 0:  # Assuming 0 is walkable\n                      tentative_g_cost = g_cost[current] + 1\n\n                      if neighbor in closed_set:\n                          continue\n\n                      if neighbor not in open_set or tentative_g_cost < g_cost[neighbor]:\n                          came_from[neighbor] = current\n                          g_cost[neighbor] = tentative_g_cost\n                          f_cost[neighbor] = tentative_g_cost + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  path = a_star((current_x, current_y), (target_x, target_y), env._current_state.grid[:, :, 0])  # Assuming first layer is walkable\n\n  for px, py in path:\n      dx = px - current_x\n      dy = py - current_y\n\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      elif dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n      current_x, current_y = px, py\n\n  actions.append(4)  # Craft the item (use the USE action)\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T11:09:29.896227", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n    \n    # Calculate the necessary movements in each direction\n    rel_x = target_pos[0] - current_pos[0]\n    rel_y = target_pos[1] - current_pos[1]\n    \n    # Move horizontally first, then vertically\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, primitives):\n      actions = []\n      \n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          \n          if not env._current_state.grid[:, :, primitive_index].any():\n              raise ValueError(f\"No {primitive} found in the environment.\")\n          \n          positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n          closest_primitive_pos = min(\n              positions, \n              key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          )\n          \n          actions.extend(get_move_actions(tuple(closest_primitive_pos)))\n          actions.append(4)  # Collect the primitive\n          \n      return actions\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Gather all primitives needed to craft the item\n    required_primitives = [key for key, value in recipe.items() if key != '_at']\n\n    actions_to_take = []\n    actions_to_take.extend(collect_primitives(env, required_primitives))\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n        \n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 3.8000002}}
{"timestamp": "2025-09-17T11:09:30.958137", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n    \n    # Calculate the necessary movements in each direction\n    rel_x = target_pos[0] - current_pos[0]\n    rel_y = target_pos[1] - current_pos[1]\n    \n    # Use Manhattan distance to calculate move actions\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T11:12:04.724892", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n          if env._current_state.pos != target_primitive_pos:\n              actions_to_take.append(4)  # Collect only if at the correct position\n\n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def get_recipe_depth(cookbook, item_index):\n      if item_index not in cookbook.recipes or all(key == '_at' for key in cookbook.recipes[item_index]):\n          return 0\n      recipe = cookbook.recipes[item_index]\n      return max(1 + get_recipe_depth(cookbook, ingredient_index) for ingredient_index in recipe.keys() if ingredient_index != '_at')\n\n  def sort_items_by_complexity(env, cookbook, item):\n    \"\"\"Sort items by their crafting complexity to optimize the gathering process.\"\"\"\n    cookbook = env.world.cookbook\n    item_index = cookbook.index[item]\n    \n    # Calculate depth of each required item for the target item\n    recipe_depths = {}\n    def calculate_recipe_depth(item_index):\n        if item_index not in recipe_depths:\n            recipe_depths[item_index] = get_recipe_depth(cookbook, item_index)\n        return recipe_depths[item_index]\n\n    required_items = []\n    for ingredient_index in cookbook.recipes[item_index].keys():\n        if ingredient_index != '_at':\n            required_items.append((ingredient_index, calculate_recipe_depth(ingredient_index)))\n    \n    # Sort items by complexity (higher depth first)\n    required_items.sort(key=lambda x: x[1], reverse=True)\n\n    return [item for item, _ in required_items]\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  # Sort required items by complexity to optimize the gathering process\n  sorted_required_items = sort_items_by_complexity(env, cookbook, item)\n  actions_to_take = []\n\n  # Gather all required items before crafting\n  for required_item in sorted_required_items:\n      if env._current_state.inventory[required_item] < cookbook.recipes[item][required_item]:\n          actions_to_take.extend(gather_required_items(env, cookbook, cookbook.recipes[required_item]))\n\n  # Extract the workshop from the recipe\n  workshop_name = cookbook.recipes[item]['_at']\n\n  try:\n    target_workshop_pos = find_nearest_workshop(env, workshop_name)\n  except ValueError as e:\n    return actions_to_take + [4]  # If no workshops found, just return collected items\n\n  # Calculate move actions to reach the closest workshop\n  actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(4)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T11:12:05.806721", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def find_required_items(env, cookbook, item_index):\n      \"\"\"Recursively determine all the required items needed to craft an item.\"\"\"\n      if item_index not in cookbook.recipes:\n          # This is a primitive item\n          return {item_index: 1}\n      \n      recipe = cookbook.recipes[item_index]\n      required_items = {}\n      for ingredient_index, quantity in recipe.items():\n          if ingredient_index != '_at':\n              sub_required_items = find_required_items(env, cookbook, ingredient_index)\n              for sub_item, sub_quantity in sub_required_items.items():\n                  if sub_item not in required_items:\n                      required_items[sub_item] = 0\n                  required_items[sub_item] += quantity * recipe[ingredient_index]\n      return required_items\n\n  def gather_all_required_items(env, cookbook, item_index):\n      \"\"\"Gather all required items needed to craft an item.\"\"\"\n      actions = []\n      required_items = find_required_items(env, cookbook, item_index)\n\n      for required_item_index, quantity in required_items.items():\n          if env._current_state.inventory[required_item_index] < quantity:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n      return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  if item_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  recipe = cookbook.recipes[item_index]\n  \n  # Gather all required items before crafting\n  actions_to_take = gather_all_required_items(env, cookbook, item_index)\n\n  # Extract the workshop from the recipe\n  workshop_name = recipe['_at']\n\n  try:\n      target_workshop_pos = find_nearest_workshop(env, workshop_name)\n  except ValueError as e:\n      print(f\"Warning: {e}\")\n      return actions_to_take + [4]  # If no workshops found, just return collected items\n\n  # Calculate move actions to reach the closest workshop\n  actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(4)\n  \n  return actions_to_take", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T11:14:01.194625", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in cookbook.recipes:\n          # If the primitive can be crafted, recursively ensure its inventory.\n          actions_to_take.extend(ensure_inventory(env, primitive_index))\n          \n          # Recalculate positions after crafting\n          env._current_state.grid = env._current_state.features.get_features()\n      else:\n          # Find all positions of the specified primitive in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n          if len(primitive_positions) > 0:\n              # Choose the closest available primitive position to collect it from.\n              current_pos = env._current_state.pos\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive.\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n              # Use the COLLECT action to collect the primitive.\n              actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n              # Update inventory and missing items count.\n              inventory[primitive_index] += required_amount\n          else:\n              raise ValueError(f\"No primitives found for {item}.\")\n      \n      missing_items.pop(primitive_name, None)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 4, "scores": {"3": 5.2}}
