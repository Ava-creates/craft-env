{"timestamp": "2025-09-16T20:03:37.075279", "function_name": "craft", "function_body": "  actions = []\n\n  # Retrieve the index of the target item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops in the grid that match the required workshop index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshop found for {item}.\")\n\n  # Choose the nearest workshop position\n  current_pos = env._current_state.pos\n  distances = [abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]) for pos in workshop_positions]\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the necessary moves to reach the chosen workshop\n  current_pos = env._current_state.pos\n\n  while current_pos != target_workshop_pos:\n    if current_pos[0] < target_workshop_pos[0]:\n      actions.append(0)  # DOWN\n      current_pos = (current_pos[0] + 1, current_pos[1])\n    elif current_pos[0] > target_workshop_pos[0]:\n      actions.append(1)  # UP\n      current_pos = (current_pos[0] - 1, current_pos[1])\n\n    if current_pos[1] < target_workshop_pos[1]:\n      actions.append(3)  # RIGHT\n      current_pos = (current_pos[0], current_pos[1] + 1)\n    elif current_pos[1] > target_workshop_pos[1]:\n      actions.append(2)  # LEFT\n      current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Add the USE action to craft the item at the workshop\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T20:04:16.605388", "function_name": "craft", "function_body": "  # Step 1: Determine the workshop required for crafting the given item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  item_index = index[item]\n  \n  # Find which workshop is required to craft this item\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n  \n  required_workshop_name = recipe['_at']\n  required_workshop_index = index[required_workshop_name]\n\n  # Step 2: Find the position of the required workshop in the current grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, required_workshop_index] == 1)\n  if workshop_positions.size == 0:\n      raise ValueError(f\"No {required_workshop_name} found in the environment\")\n\n  # Choose any available workshop to go to (using the first one found)\n  target_pos = tuple(workshop_positions[0])\n\n  # Step 3: Move towards the chosen workshop\n  actions_to_move = move_towards(env, target_pos)\n\n  # Step 4: Add the USE action to use the workshop and craft the item\n  actions_to_craft = actions_to_move + [craft.USE]\n\n  return actions_to_craft", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:04:17.596673", "function_name": "craft", "function_body": "  # Get the index for the goal item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the workshop location required to craft the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions = []\n  \n  # Find the closest workshop to craft the item\n  closest_workshop_pos = None\n  min_distance = float('inf')\n  for pos in env._current_state.grid.nonzero()[0:2]:\n      if env._current_state.grid[pos] == workshop_index:\n          distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = pos\n  \n  if closest_workshop_pos is None:\n      return actions  # No workshop found, return empty action list\n\n  # Calculate the path to the closest workshop\n  target_x, target_y = closest_workshop_pos\n  current_x, current_y = env._current_state.pos\n  \n  while current_x != target_x or current_y != target_y:\n      if current_x < target_x:\n          actions.append(craft.RIGHT)\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(craft.LEFT)\n          current_x -= 1\n      \n      if current_y < target_y:\n          actions.append(craft.DOWN)\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(craft.UP)\n          current_y -= 1\n\n  # Once at the workshop, use the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:05:49.867705", "function_name": "craft", "function_body": "  # Step 1: Find the workshop associated with the recipe for the target item\n  world = env.world\n  cookbook_index = world.cookbook.index\n  \n  if item not in cookbook_index:\n    raise ValueError(f\"Item '{item}' is unknown.\")\n  \n  item_idx = cookbook_index[item]\n  \n  # Retrieve the recipe details including the required workshop\n  recipe_details = world.cookbook.recipes.get(item_idx)\n  \n  if \"_at\" not in recipe_details:\n    raise ValueError(f\"No workshop specified for crafting item '{item}'.\")\n  \n  workshop_name = recipe_details[\"_at\"]\n  workshop_index = cookbook_index[workshop_name]\n  \n  # Step 2: Determine the position of the workshop on the grid\n  workshop_pos = None\n  \n  # Check if the agent is already at a workshop and it matches the required one\n  current_grid_slice = env._current_state.grid[max(0, env._current_state.pos[0] - 1):min(env._current_state.pos[0] + 2, env._current_state.grid.shape[0]),\n                                               max(0, env._current_state.pos[1] - 1):min(env._current_state.pos[1] + 2, env._current_state.grid.shape[1])]\n  \n  if np.any(current_grid_slice[..., workshop_index]):\n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        if current_grid_slice[dx+1, dy+1, workshop_index]:\n          workshop_pos = (env._current_state.pos[0] + dx, env._current_state.pos[1] + dy)\n          break\n    if workshop_pos:\n      print(\"Agent is already near a matching workshop.\")\n  \n  # If the agent is not near the required workshop, find its position on the grid\n  if not workshop_pos:\n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if env._current_state.grid[x, y, workshop_index]:\n          workshop_pos = (x, y)\n          break\n  \n  if not workshop_pos:\n    raise ValueError(f\"No position found for required workshop '{workshop_name}' on the grid.\")\n  \n  # Step 3: Calculate actions to move the agent to the workshop\n  actions_to_workshop = []\n  \n  while env._current_state.pos != workshop_pos:\n    dx = workshop_pos[0] - env._current_state.pos[0]\n    dy = workshop_pos[1] - env._current_state.pos[1]\n    \n    # Determine direction to move based on position difference\n    if dx < 0 and not env._current_state.next_to(world.stone_index):\n      actions_to_workshop.append(env.world.DOWN)\n    elif dx > 0 and not env._current_state.next_to(world.stone_index):\n      actions_to_workshop.append(env.world.UP)\n    elif dy < 0 and not env._current_state.next_to(world.stone_index):\n      actions_to_workshop.append(env.world.RIGHT)\n    elif dy > 0 and not env._current_state.next_to(world.stone_index):\n      actions_to_workshop.append(env.world.LEFT)\n    \n    # Perform the move action\n    _, done, _ = env.step(actions_to_workshop[-1])\n    if done:\n      break\n  \n  print(f\"Actions to reach workshop: {actions_to_workshop}\")\n  \n  # Step 4: Craft the item at the workshop by using the USE action\n  actions_to_craft = [env.world.USE]\n  _, done, _ = env.step(actions_to_craft[-1])\n  if done:\n    return actions_to_workshop + actions_to_craft\n  \n  print(\"Crafting successful.\")\n  \n  # Return the list of all actions performed to reach and craft at the workshop\n  return actions_to_workshop + actions_to_craft", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:05:50.831784", "function_name": "craft", "function_body": "  # Initialize actions list\n  actions = []\n\n  # Get the recipe for the item\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Check if there's a recipe for the item, if not return empty action list\n  if goal_index not in cookbook.recipes:\n    return actions\n\n  # Retrieve the workshop index from the recipe\n  workshop_name = cookbook.recipes[goal_index][\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n\n  # Calculate actions to move to the nearest workshop\n  if nearest_workshop_pos is not None:\n    x_target, y_target = nearest_workshop_pos\n    current_x, current_y = env._current_state.pos\n    \n    dx = x_target - current_x\n    dy = y_target - current_y\n\n    # Move in the direction of x first\n    while dx != 0:\n      if dx > 0:\n        actions.append(env.world.N_ACTIONS + craft.RIGHT)  # RIGHT\n        dx -= 1\n      elif dx < 0:\n        actions.append(env.world.N_ACTIONS + craft.LEFT)  # LEFT\n        dx += 1\n\n    # Then move in the direction of y\n    while dy != 0:\n      if dy > 0:\n        actions.append(env.world.N_ACTIONS + craft.DOWN)  # DOWN\n        dy -= 1\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS + craft.UP)  # UP\n        dy += 1\n\n    # Finally, perform the USE action to craft the item at the workshop\n    actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:06:54.570528", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # The workshop where the item must be crafted is specified by \"_at\" key in the recipe.\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get all workshop indices of this type\n  workshop_indices = [i for i, idx in enumerate(env.world.workshop_indices) if idx == workshop_index]\n  \n  # Assume the first available workshop can be used (can be improved to find the closest one)\n  target_workshop_pos = None\n  for workshop_idx in workshop_indices:\n      grid_slice = env._current_state.grid[:, :, workshop_idx]\n      positions = np.argwhere(grid_slice > 0)\n      if len(positions) > 0:\n          target_workshop_pos = tuple(positions[0])\n          break\n\n  actions = []\n  \n  # If we found a position for the workshop, move to it\n  if target_workshop_pos is not None:\n      current_pos = env._current_state.pos\n      dx = target_workshop_pos[1] - current_pos[1]\n      dy = target_workshop_pos[0] - current_pos[0]\n\n      # Calculate actions needed to reach the workshop position (simplified version)\n      if dx < 0:\n          actions.extend([env.world.LEFT] * abs(dx))\n      elif dx > 0:\n          actions.extend([env.world.RIGHT] * abs(dx))\n      if dy < 0:\n          actions.extend([env.world.DOWN] * abs(dy))\n      elif dy > 0:\n          actions.extend([env.world.UP] * abs(dy))\n\n      # Add the USE action to craft the item\n      actions.append(env.world.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:06:55.529705", "function_name": "craft", "function_body": "  # Find the recipe for the item in the cookbook\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n    raise ValueError(f\"Workshop not specified in the recipe for item: {item}\")\n\n  # Find the index of the workshop\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.any():\n    raise ValueError(f\"No workshop found for item: {item}\")\n\n  # Select the first available workshop (you can add logic to choose the closest one)\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Calculate the direction and distance from current position to the target workshop\n  current_pos = env._current_state.pos\n  dx = target_workshop_position[1] - current_pos[1]\n  dy = target_workshop_position[0] - current_pos[0]\n\n  actions = []\n\n  # Move horizontally to align with the target workshop\n  if dx > 0:\n    actions.extend([env.world.DOWN] * abs(dy))\n    actions.extend([env.world.RIGHT] * abs(dx))\n  else:\n    actions.extend([env.world.UP] * abs(dy))\n    actions.extend([env.world.LEFT] * abs(dx))\n\n  # Move vertically to align with the target workshop\n  if dy > 0:\n    actions.extend([env.world.DOWN] * abs(dy))\n  else:\n    actions.extend([env.world.UP] * abs(dy))\n\n  # Use action at the workshop to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:07:41.275747", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the workshop index from the recipe\n  world = env.scenario.world\n  cookbook = world.cookbook\n  item_index = cookbook.index[item]\n  recipe = cookbook.recipes[item_index]\n\n  if '_key' in recipe:\n    workshop_index = recipe['_key']\n  else:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n\n  # Find the workshop on the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if workshop_positions.size == 0:\n    raise ValueError(f\"No available workshops to craft {item}\")\n\n  # Pick one of the workshops\n  target_pos = tuple(workshop_positions[0])\n\n  # Move towards the target position\n  current_pos = env._current_state.pos\n  actions.extend(moveto_v1(env, current_pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(env.world.n_actions - 1)  # Assuming USE action is last\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:07:42.242203", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop required for crafting the item\n  recipe = env.world.cookbook.recipes[item_idx]\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for y, row in enumerate(env._current_state.grid):\n    for x, cell in enumerate(row):\n      if np.argmax(cell) == workshop_idx:\n        workshop_pos = (x, y)\n        break\n  \n  if not workshop_pos:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Navigate to the workshop\n  current_x, current_y = env._current_state.pos\n  target_x, target_y = workshop_pos\n  \n  # Calculate the direction to move\n  dx = target_x - current_x\n  dy = target_y - current_y\n  \n  if dx > 0:\n    actions.append(env.world.N_ACTIONS['RIGHT'])\n  elif dx < 0:\n    actions.append(env.world.N_ACTIONS['LEFT'])\n  \n  if dy > 0:\n    actions.append(env.world.N_ACTIONS['DOWN'])\n  elif dy < 0:\n    actions.append(env.world.N_ACTIONS['UP'])\n\n  # Use action to craft the item\n  actions.append(env.world.N_ACTIONS['USE'])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:08:29.405357", "function_name": "craft", "function_body": "  # Find the workshop where this item needs to be crafted\n  cookbook = env.world.cookbook\n  i_item = cookbook.index[item]\n  recipe = cookbook.recipes[i_item]\n\n  # Extract the location of the correct workshop from the recipe\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all workshops in the grid and their positions\n  world_workshops = [(x, y) for x in range(env.world.scenario.grid.shape[0]) for y in range(env.world.scenario.grid.shape[1]) if env.world.scenario.grid[x, y, workshop_index] > 0]\n\n  # Find the closest workshop of the required type to the agent's current position\n  agent_position = env._current_state.pos\n  distances = [(np.linalg.norm(np.array(pos) - np.array(agent_position)), pos) for pos in world_workshops]\n  closest_workshop_position, _ = min(distances, key=lambda x: x[0])\n\n  # Calculate the actions needed to move to the closest workshop\n  actions_to_move = a_star_pathfinding(env._current_state.pos, closest_workshop_position, env.world.scenario.grid)\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_craft = [4]  # Assuming USE is represented by 4\n\n  return actions_to_move + actions_to_craft", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:08:30.390215", "function_name": "craft", "function_body": "  # Get the index of the item\n  item_idx = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Check if the item needs to be crafted in a specific workshop\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n    \n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found on the map.\")\n    \n    # Choose one of the workshops randomly (or use a strategy to choose the closest one)\n    workshop_pos = workshop_positions[0]\n    \n    # Calculate actions to move to the selected workshop\n    while env._current_state.pos != tuple(workshop_pos):\n      dx = workshop_pos[1] - env._current_state.pos[1]\n      dy = workshop_pos[0] - env._current_state.pos[0]\n\n      if dx > 0:\n        actions.append(env.world.N_ACTIONS.RIGHT)\n      elif dx < 0:\n        actions.append(env.world.N_ACTIONS.LEFT)\n\n      if dy > 0:\n        actions.append(env.world.N_ACTIONS.DOWN)\n      elif dy < 0:\n        actions.append(env.world.N_ACTIONS.UP)\n      \n      # Move the agent\n      _, _ = env._current_state.step(actions[-1])\n\n    # Craft the item at the workshop\n    actions.append(env.world.N_ACTIONS.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:10:08.196831", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop where the item should be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the agent's current position and direction\n  pos_x, pos_y = env._current_state.pos\n  dir = env._current_state.dir\n\n  # Find the positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Calculate Manhattan distance to each workshop and find the closest one\n  distances = [abs(x - pos_x) + abs(y - pos_y) for x, y in workshop_positions]\n  closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  # Move to the closest workshop\n  target_x, target_y = closest_workshop_pos\n\n  while pos_x != target_x or pos_y != target_y:\n    if pos_x < target_x:\n      actions.append(env.N_ACTIONS.DOWN)\n      pos_x += 1\n    elif pos_x > target_x:\n      actions.append(env.N_ACTIONS.UP)\n      pos_x -= 1\n    elif pos_y < target_y:\n      actions.append(env.N_ACTIONS.RIGHT)\n      pos_y += 1\n    elif pos_y > target_y:\n      actions.append(env.N_ACTIONS.LEFT)\n      pos_y -= 1\n\n  # Turn the agent to face the workshop if necessary (assuming facing up initially for simplicity)\n  if dir == 0:  # Facing up\n    if target_x < pos_x:\n      actions.append(env.N_ACTIONS.RIGHT)\n    elif target_x > pos_x:\n      actions.append(env.N_ACTIONS.LEFT)\n    elif target_y > pos_y:\n      pass\n    elif target_y < pos_y:\n      actions.append(env.N_ACTIONS.DOWN)\n\n  # Craft the item at the workshop\n  actions.append(env.N_ACTIONS.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:10:09.192479", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop where this item needs to be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Get the position of the nearest workshop from the agent's current position\n  min_distance = float('inf')\n  target_workshop_pos = None\n  \n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, workshop_index] == 1:\n              distance = abs(y - env._current_state.pos[0]) + abs(x - env._current_state.pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  target_workshop_pos = (y, x)\n\n  # Move to the nearest workshop using Manhattan Distance\n  while env._current_state.pos != target_workshop_pos:\n      dy = target_workshop_pos[0] - env._current_state.pos[0]\n      dx = target_workshop_pos[1] - env._current_state.pos[1]\n\n      if dx > 0 and env._current_state.dir == 2:  # Agent is facing left, needs to turn right\n          actions.append(3)  # RIGHT\n      elif dx < 0 and env._current_state.dir == 3:  # Agent is facing right, needs to turn left\n          actions.append(2)  # LEFT\n      elif dy > 0 and env._current_state.dir == 1:  # Agent is facing up, needs to turn down\n          actions.append(4)  # DOWN\n      elif dy < 0 and env._current_state.dir == 0:  # Agent is facing down, needs to turn up\n          actions.append(1)  # UP\n      \n      if dx > 0 and env._current_state.dir == 3:\n          actions.append(5)  # USE (move right)\n      elif dx < 0 and env._current_state.dir == 2:\n          actions.append(5)  # USE (move left)\n      elif dy > 0 and env._current_state.dir == 4:\n          actions.append(5)  # USE (move down)\n      elif dy < 0 and env._current_state.dir == 1:\n          actions.append(5)  # USE (move up)\n\n      if dx == 0 and env._current_state.dir == 3:  # Agent is facing right, move forward\n          actions.append(5)  # USE\n      elif dx == 0 and env._current_state.dir == 2:  # Agent is facing left, move forward\n          actions.append(5)  # USE\n      elif dy == 0 and env._current_state.dir == 4:  # Agent is facing down, move forward\n          actions.append(5)  # USE\n      elif dy == 0 and env._current_state.dir == 1:  # Agent is facing up, move forward\n          actions.append(5)  # USE\n\n      _, new_state = env._current_state.step(actions[-1])\n      env._current_state = new_state\n\n  # Perform the craft action (USE)\n  actions.append(5)  # USE\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:11:16.811728", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  if item_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Find the workshop required to craft this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if recipe is None:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  required_workshop = recipe[\"_at\"]\n  workshop_indices = [env.world.index[workshop] for workshop in env.world.workshop_indices]\n\n  target_workshop_index = None\n  for idx, workshop_name in enumerate(env.world.workshop_indices):\n    if workshop_name == required_workshop:\n      target_workshop_index = workshop_indices[idx]\n      break\n\n  if target_workshop_index is None:\n    raise ValueError(f\"Workshop {required_workshop} not found\")\n\n  # Find the position of all workshops in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No instance of {required_workshop} found on the grid\")\n\n  # Move to the first occurrence of the required workshop\n  target_position = tuple(workshop_positions[0])\n  \n  current_position = env._current_state.pos\n  \n  # Calculate moves to reach the target position\n  while current_position != target_position:\n    delta_x, delta_y = target_position[0] - current_position[0], target_position[1] - current_position[1]\n    \n    if delta_x < 0:  # Move left\n      actions.append(env.world.index[\"LEFT\"])\n    elif delta_x > 0:  # Move right\n      actions.append(env.world.index[\"RIGHT\"])\n    else:\n      if delta_y < 0:  # Move up\n        actions.append(env.world.index[\"UP\"])\n      elif delta_y > 0:  # Move down\n        actions.append(env.world.index[\"DOWN\"])\n\n    # Take a step to update the current position\n    _, env._current_state = env._current_state.step(actions[-1])\n    current_position = env._current_state.pos\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(env.world.index[\"USE\"])\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:11:17.774145", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item\n  i_item = env.world.cookbook.index[item]\n\n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Extract workshop information from the recipe\n  workshop_name = recipe[\"_at\"]\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Get all workshop positions in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[..., i_workshop] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No workshops found for the specified item.\")\n\n  # Choose the first available workshop position (can be improved)\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the relative direction to the target position\n  current_pos = env._current_state.pos\n  delta_x, delta_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n  # Determine the sequence of actions to move towards the target workshop\n  if delta_x < 0:\n    actions.extend([craft.LEFT for _ in range(-delta_x)])\n  elif delta_x > 0:\n    actions.extend([craft.RIGHT for _ in range(delta_x)])\n\n  if delta_y < 0:\n    actions.extend([craft.DOWN for _ in range(-delta_y)])\n  elif delta_y > 0:\n    actions.extend([craft.UP for _ in range(delta_y)])\n\n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:12:28.255500", "function_name": "craft", "function_body": "  # Find the index of the item\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Select the first available workshop (we can improve this to select the closest one)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Determine the current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the path to the workshop\n  actions_to_reach_workshop = []\n  while current_pos != target_workshop_pos:\n      dx = target_workshop_pos[0] - current_pos[0]\n      dy = target_workshop_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move along the x-axis\n          if dx > 0:\n              actions_to_reach_workshop.append(3)  # RIGHT\n          else:\n              actions_to_reach_workshop.append(2)  # LEFT\n      else:\n          # Move along the y-axis\n          if dy > 0:\n              actions_to_reach_workshop.append(1)  # UP\n          else:\n              actions_to_reach_workshop.append(0)  # DOWN\n\n      # Update the current position based on the last action taken (this is a simplification)\n      if dx != 0:\n          current_pos = (current_pos[0] + (1 if dx > 0 else -1), current_pos[1])\n      else:\n          current_pos = (current_pos[0], current_pos[1] + (1 if dy > 0 else -1))\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.90000004}}
{"timestamp": "2025-09-16T20:12:29.261598", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the required workshop for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item {item}\")\n  \n  workshop_name = recipe['_key']\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found in the environment\")\n  \n  # Choose the first available workshop position (we can improve this by choosing the nearest one)\n  target_pos = tuple(workshop_positions[0])\n  \n  # Move to the target position\n  while env._current_state.pos != target_pos:\n    direction_to_move = (\n      np.sign(target_pos[1] - env._current_state.pos[1]),  # vertical direction\n      np.sign(target_pos[0] - env._current_state.pos[0])   # horizontal direction\n    )\n    \n    if direction_to_move == (0, 1):\n      actions.append(craft.RIGHT)\n    elif direction_to_move == (0, -1):\n      actions.append(craft.LEFT)\n    elif direction_to_move == (1, 0):\n      actions.append(craft.DOWN)\n    elif direction_to_move == (-1, 0):\n      actions.append(craft.UP)\n    else:\n      break\n  \n  # Perform the craft action\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:13:34.083364", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Find the workshop where the item must be crafted\n  workshop_name = recipe['_key']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  pos = None\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[i, j] == workshop_index):\n              pos = (i, j)\n              break\n      if pos:\n          break\n  \n  # If no workshop is found, raise an error\n  if not pos:\n      raise ValueError(f\"No workshop found for crafting {item}.\")\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_pos = np.array(pos) - np.array(env._current_state.pos)\n\n  # Move to the workshop\n  while not (target_pos == np.array([0, 0])).all():\n      if target_pos[1] < 0:\n          actions.append(env.action_specs()['LEFT'])\n          target_pos[1] += 1\n      elif target_pos[1] > 0:\n          actions.append(env.action_specs()['RIGHT'])\n          target_pos[1] -= 1\n      elif target_pos[0] < 0:\n          actions.append(env.action_specs()['UP'])\n          target_pos[0] += 1\n      else:\n          actions.append(env.action_specs()['DOWN'])\n          target_pos[0] -= 1\n\n  # Craft the item at the workshop\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:13:35.044509", "function_name": "craft", "function_body": "  # Get the index for the desired item using the cookbook's index\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe details for the item from the recipes dict\n  recipe_details = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop name where the item should be crafted from the recipe details\n  workshop_name = recipe_details['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the positions of all workshops in the grid world that match the required workshop index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No suitable workshop found for crafting the item.\")\n\n  # Choose the first available workshop position (you could implement more sophisticated logic here to choose a specific workshop)\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Calculate the actions needed to move the agent from its current position to the target workshop\n  path_to_workshop = a_star(env._current_state.pos, target_workshop_pos, env._current_state.grid)\n  \n  if not path_to_workshop:\n    raise ValueError(\"No valid path found to the workshop.\")\n\n  # Convert path to actions (use cardinal directions for movement)\n  actions = []\n  current_dir = env._current_state.dir\n\n  def direction_to_action(dir_from, dir_to):\n      \"\"\"Converts change in direction to an action index.\"\"\"\n      delta_dir = (dir_to - dir_from) % 4\n      if delta_dir == 1:\n          return craft.RIGHT\n      elif delta_dir == 2:\n          return craft.DOWN\n      elif delta_dir == 3:\n          return craft.LEFT\n      else:\n          return None\n\n  for next_pos in path_to_workshop[1:]:\n      dx = next_pos[0] - env._current_state.pos[0]\n      dy = next_pos[1] - env._current_state.pos[1]\n      \n      if dx == 1:  # move down\n          target_dir = craft.DOWN\n      elif dx == -1:  # move up\n          target_dir = craft.UP\n      elif dy == 1:  # move right\n          target_dir = craft.RIGHT\n      else:  # dy == -1, move left\n          target_dir = craft.LEFT\n      \n      if current_dir != target_dir:\n          action = direction_to_action(current_dir, target_dir)\n          actions.append(action)\n          current_dir = target_dir\n      \n      actions.append(craft.USE)  # Move to the next position\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:14:25.931492", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n  recipe = cookbook.recipes[index[item]]\n  workshop_name = recipe[\"_at\"]\n\n  workshop_index = index[workshop_name]\n  workshop_indices = np.where(env._current_state.grid[:,:, workshop_index] > 0)[0]\n\n  # Assuming there is at least one of the required workshops in the environment\n  target_workshop_pos = (workshop_indices[0], workshop_indices[1])\n\n  actions_to_take = move_to(env, target_workshop_pos)\n  actions_to_take.append(craft.CRAFT_FUNC(item))\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:14:26.905794", "function_name": "craft", "function_body": "  actions = []\n  \n  # Find the index for the item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item to get the workshop name where it needs to be crafted\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n    \n  workshop_name = recipe[\"_key\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop\n  grid = env._current_state.grid\n  width, height, _ = grid.shape\n  \n  def bfs(start_pos):\n    queue = collections.deque([start_pos])\n    visited = set()\n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    \n    while queue:\n      x, y = queue.popleft()\n      \n      if grid[x, y, workshop_idx] > 0:\n        return x, y\n      \n      visited.add((x, y))\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited and grid[nx, ny].sum() == 0:\n          queue.append((nx, ny))\n          \n    return None\n\n  pos = env._current_state.pos\n  workshop_pos = bfs(pos)\n  \n  if not workshop_pos:\n    raise ValueError(\"No valid path to the nearest workshop found.\")\n    \n  # Calculate the direction towards the workshop\n  def get_direction(x1, y1, x2, y2):\n      dx = x2 - x1\n      dy = y2 - y1\n      if dx == 0 and dy > 0:\n          return craft.RIGHT\n      elif dx == 0 and dy < 0:\n          return craft.LEFT\n      elif dx > 0 and dy == 0:\n          return craft.DOWN\n      elif dx < 0 and dy == 0:\n          return craft.UP\n      else:\n          raise ValueError(\"Cannot determine a direct path.\")\n  \n  current_dir = env._current_state.dir\n  target_x, target_y = workshop_pos\n  \n  # Move towards the workshop\n  while pos != (target_x, target_y):\n      next_dir = get_direction(pos[0], pos[1], target_x, target_y)\n      \n      if next_dir == current_dir:\n          actions.append(craft.USE)\n      else:\n          actions.append(next_dir)\n      \n      # Update position based on movement\n      if next_dir == craft.UP:\n          pos = (pos[0] - 1, pos[1])\n      elif next_dir == craft.DOWN:\n          pos = (pos[0] + 1, pos[1])\n      elif next_dir == craft.LEFT:\n          pos = (pos[0], pos[1] - 1)\n      elif next_dir == craft.RIGHT:\n          pos = (pos[0], pos[1] + 1)\n      \n      current_dir = next_dir\n  \n  # Use the workshop to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:15:47.307800", "function_name": "craft", "function_body": "  # Convert item name to its corresponding index\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  pos = env._current_state.pos\n  grid = env._current_state.grid\n  \n  min_distance = float('inf')\n  target_workshop_pos = None\n\n  for i in range(grid.shape[0]):\n    for j in range(grid.shape[1]):\n      if np.any(grid[i, j, workshop_index] > 0):\n        distance = abs(i - pos[0]) + abs(j - pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          target_workshop_pos = (i, j)\n\n  if not target_workshop_pos:\n    raise ValueError(f\"No {workshop_name} found in the grid.\")\n\n  # Calculate path to the nearest workshop using a simple BFS algorithm\n  def bfs(grid, start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              break\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              x, y = current[0] + dx, current[1] + dy\n              if (x, y) not in visited and grid[x, y].sum() == 0:  # Check if the cell is empty\n                  queue.append((x, y))\n                  visited.add((x, y))\n                  parent[(x, y)] = current\n      \n      path = []\n      while goal in parent:\n          path.append(goal)\n          goal = parent[goal]\n      path.reverse()\n      return path\n\n  path_to_workshop = bfs(grid, pos, target_workshop_pos)\n\n  # Generate actions to move along the path\n  actions = []\n  directions = {'UP': 1, 'DOWN': 0, 'LEFT': 2, 'RIGHT': 3}\n  \n  current_direction = env._current_state.dir\n  \n  def direction_to_target(current_pos, target_pos):\n      if target_pos[0] < current_pos[0]:\n          return 'UP'\n      elif target_pos[0] > current_pos[0]:\n          return 'DOWN'\n      elif target_pos[1] < current_pos[1]:\n          return 'LEFT'\n      else:\n          return 'RIGHT'\n\n  for step in path_to_workshop:\n      direction_name = direction_to_target(pos, step)\n      \n      # Turn to the correct direction\n      while directions[current_direction] != directions[direction_name]:\n          if (current_direction + 1) % 4 == directions[direction_name]:\n              actions.append(directions['RIGHT'])\n              current_direction = (current_direction + 1) % 4\n          else:\n              actions.append(directions['LEFT'])\n              current_direction = (current_direction - 1) % 4\n      \n      # Move forward\n      actions.append(directions['DOWN'])  # Using DOWN as the move action index, adjust if necessary\n      pos = step\n\n  # Turn to the correct direction to face the workshop\n  direction_name = direction_to_target(pos, target_workshop_pos)\n  while directions[current_direction] != directions[direction_name]:\n      if (current_direction + 1) % 4 == directions[direction_name]:\n          actions.append(directions['RIGHT'])\n          current_direction = (current_direction + 1) % 4\n      else:\n          actions.append(directions['LEFT'])\n          current_direction = (current_direction - 1) % 4\n\n  # Use action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action index is 4, adjust if necessary\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:15:48.293809", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item to find out which workshop it needs\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop index from the recipe\n  workshop_name = recipe.get(\"_at\")\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if not workshop_positions.size:\n    raise ValueError(f\"No workshops found for item {item}\")\n\n  # Sort the workshops by distance to the agent's current position\n  distances = np.linalg.norm(workshop_positions - env._current_state.pos, axis=1)\n  nearest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n  actions_to_take = []\n\n  # Add move actions to reach the nearest workshop\n  while not (env._current_state.pos[0] == nearest_workshop_pos[0] and env._current_state.pos[1] == nearest_workshop_pos[1]):\n    if env._current_state.pos[0] < nearest_workshop_pos[0]:\n      actions_to_take.append(env.world.DOWN)\n    elif env._current_state.pos[0] > nearest_workshop_pos[0]:\n      actions_to_take.append(env.world.UP)\n    \n    if env._current_state.pos[1] < nearest_workshop_pos[1]:\n      actions_to_take.append(env.world.RIGHT)\n    elif env._current_state.pos[1] > nearest_workshop_pos[1]:\n      actions_to_take.append(env.world.LEFT)\n\n  # Add the use action to craft the item at the workshop\n  actions_to_take.append(env.world.USE)\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:16:34.268283", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the target item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe from the cookbook for the target item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  # Get the workshop where this item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Locate all workshops in the grid that match the required workshop index\n  workshop_positions = []\n  grid = env._current_state.grid\n  for y in range(grid.shape[0]):\n    for x in range(grid.shape[1]):\n      if grid[y, x, workshop_index] == 1:\n        workshop_positions.append((x, y))\n  \n  if not workshop_positions:\n    raise ValueError(f\"No {workshop_name} found on the map.\")\n  \n  # Choose one of the workshops (for now, we'll just pick the first one)\n  target_workshop_position = workshop_positions[0]\n  \n  # Calculate movement actions to reach the chosen workshop\n  current_pos = env._current_state.pos\n  \n  # Find path using a simple Manhattan distance heuristic\n  # Move vertically to align y-coordinate\n  if current_pos[1] < target_workshop_position[1]:\n    actions.extend([craft.UP for _ in range(target_workshop_position[1] - current_pos[1])])\n  elif current_pos[1] > target_workshop_position[1]:\n    actions.extend([craft.DOWN for _ in range(current_pos[1] - target_workshop_position[1])])\n  \n  # Move horizontally to align x-coordinate\n  if current_pos[0] < target_workshop_position[0]:\n    actions.extend([craft.RIGHT for _ in range(target_workshop_position[0] - current_pos[0])])\n  elif current_pos[0] > target_workshop_position[0]:\n    actions.extend([craft.LEFT for _ in range(current_pos[0] - target_workshop_position[0])])\n  \n  # Add the USE action to perform crafting at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:16:35.291111", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the item to get the required workshop\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"]\n\n  # Get the index of the workshop from the cookbook's index\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops in the current grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found on the grid.\")\n\n  # Get the position of the nearest workshop to the agent's current position\n  current_pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Generate a path to move to the nearest workshop\n  actions_to_workshop = pathfind(env, current_pos, nearest_workshop_pos)\n\n  # Add the action to use the workshop for crafting\n  actions_to_workshop.append(4)  # Assuming USE is mapped to index 4\n\n  return actions_to_workshop", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:17:57.127687", "function_name": "craft", "function_body": "  # Define constants for actions\n  UP = env.world.N_ACTIONS - 4\n  DOWN = env.world.N_ACTIONS - 3\n  LEFT = env.world.N_ACTIONS - 2\n  RIGHT = env.world.N_ACTIONS - 1\n  USE = env.world.N_ACTIONS - 5\n\n  def move_to(x, y):\n      actions = []\n      while env._current_state.pos[0] != x or env._current_state.pos[1] != y:\n          delta_x = x - env._current_state.pos[0]\n          delta_y = y - env._current_state.pos[1]\n\n          if delta_x < 0 and env._current_state.dir == LEFT:\n              actions.append(USE)\n          elif delta_x > 0 and env._current_state.dir == RIGHT:\n              actions.append(USE)\n          elif delta_y < 0 and env._current_state.dir == UP:\n              actions.append(USE)\n          elif delta_y > 0 and env._current_state.dir == DOWN:\n              actions.append(USE)\n\n          if delta_x < 0:\n              if env._current_state.dir != LEFT:\n                  actions.append(LEFT)\n              else:\n                  actions.append(DOWN)  # Move down to avoid obstacles\n          elif delta_x > 0:\n              if env._current_state.dir != RIGHT:\n                  actions.append(RIGHT)\n              else:\n                  actions.append(UP)  # Move up to avoid obstacles\n          elif delta_y < 0:\n              if env._current_state.dir != UP:\n                  actions.append(UP)\n              else:\n                  actions.append(RIGHT)  # Move right to avoid obstacles\n          elif delta_y > 0:\n              if env._current_state.dir != DOWN:\n                  actions.append(DOWN)\n              else:\n                  actions.append(LEFT)  # Move left to avoid obstacles\n\n      return actions\n\n\n  def get_workshop_position(item):\n      index = env.world.cookbook.index[item]\n      recipe = env.world.cookbook.recipes[index]\n\n      workshop_name = recipe['_key']\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      for x in range(env._current_state.grid.shape[0]):\n          for y in range(env._current_state.grid.shape[1]):\n              if env._current_state.grid[x, y, workshop_index] > 0:\n                  return (x, y)\n\n      raise ValueError(f\"Workshop {workshop_name} not found on the grid.\")\n\n  def orient_to_workshop(workshop_x, workshop_y):\n      actions = []\n      delta_x = workshop_x - env._current_state.pos[0]\n      delta_y = workshop_y - env._current_state.pos[1]\n\n      if delta_x < 0:\n          target_dir = LEFT\n      elif delta_x > 0:\n          target_dir = RIGHT\n      elif delta_y < 0:\n          target_dir = UP\n      else:\n          target_dir = DOWN\n\n      while env._current_state.dir != target_dir:\n          if (target_dir - env._current_state.dir) % 4 == 1 or (target_dir - env._current_state.dir) % 4 == -3:\n              actions.append(RIGHT)\n          elif (target_dir - env._current_state.dir) % 4 == 2 or (target_dir - env._current_state.dir) % 4 == -2:\n              actions.append(RIGHT)\n              actions.append(RIGHT)\n          else:\n              actions.append(LEFT)\n\n      return actions\n\n  # Get the workshop position for the item\n  workshop_position = get_workshop_position(item)\n\n  # Move to the workshop position\n  move_actions = move_to(workshop_position[0], workshop_position[1])\n\n  # Orient to face the workshop\n  orient_actions = orient_to_workshop(workshop_position[0], workshop_position[1])\n\n  # Craft the item at the workshop\n  craft_action = [USE]\n\n  return move_actions + orient_actions + craft_action", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:17:58.096244", "function_name": "craft", "function_body": "  index = env.world.cookbook.index\n  recipe = env.world.cookbook.recipes[index[item]]\n  workshop_index = recipe['_at']\n  \n  # Find the position of the nearest workshop with the required index\n  grid = env._current_state.grid\n  agent_pos = env._current_state.pos\n  directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n  queue = collections.deque([agent_pos])\n  visited = set()\n  workshop_position = None\n  \n  while queue:\n    current_pos = queue.popleft()\n    if grid[current_pos[0], current_pos[1], workshop_index] > 0:\n      workshop_position = current_pos\n      break\n    for direction in directions:\n      new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n      if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n        if new_pos not in visited:\n          queue.append(new_pos)\n          visited.add(new_pos)\n\n  if workshop_position is None:\n    raise ValueError(\"No workshop found for the specified item.\")\n\n  actions = []\n  \n  # Move towards the nearest workshop\n  while agent_pos != workshop_position:\n    direction = (workshop_position[0] - agent_pos[0], workshop_position[1] - agent_pos[1])\n    if direction[0] < 0:\n      actions.append(craft.LEFT)\n    elif direction[0] > 0:\n      actions.append(craft.RIGHT)\n    else:\n      if direction[1] < 0:\n        actions.append(craft.UP)\n      else:\n        actions.append(craft.DOWN)\n    \n    # Simulate moving to the next position\n    agent_pos = (agent_pos[0] + directions[actions[-1]-2][0], agent_pos[1] + directions[actions[-1]-2][1])\n\n  # Craft the item at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:18:47.074551", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop where the item must be crafted\n  recipe = env.world.cookbook.recipes[item_idx]\n  workshop_name = [k for k in recipe if k.startswith(\"_at\")][0]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Get the positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n\n  # Find the closest workshop among them\n  agent_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n  closest_workshop_idx = np.argmin(distances)\n  closest_workshop_pos = tuple(workshop_positions[closest_workshop_idx])\n\n  # Calculate the actions to move to the closest workshop\n  actions_to_move = []\n  while env._current_state.pos != closest_workshop_pos:\n    # Determine the direction to move\n    delta_x = closest_workshop_pos[0] - env._current_state.pos[0]\n    delta_y = closest_workshop_pos[1] - env._current_state.pos[1]\n\n    if delta_x > 0:\n      actions_to_move.append(env.world.cookbook.index[\"RIGHT\"])\n    elif delta_x < 0:\n      actions_to_move.append(env.world.cookbook.index[\"LEFT\"])\n    \n    if delta_y > 0:\n      actions_to_move.append(env.world.cookbook.index[\"DOWN\"])\n    elif delta_y < 0:\n      actions_to_move.append(env.world.cookbook.index[\"UP\"])\n\n    # Perform the move\n    env.step(actions_to_move[-1])\n\n  # Perform the USE action to craft the item\n  actions_to_move.append(env.world.cookbook.index[\"USE\"])\n\n  return actions_to_move", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:18:48.043724", "function_name": "craft", "function_body": "  # Get the recipe for the specified item\n  index = env.world.cookbook.index\n  i_goal = index[item]\n  \n  if i_goal not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe found for {item}\")\n      \n  recipe = env.world.cookbook.recipes[i_goal]\n\n  # Determine which workshop to use based on the recipe\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      raise ValueError(\"Recipe must specify a workshop\")\n\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the required workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, i_workshop]).tolist()\n  \n  if not workshop_positions:\n      raise ValueError(f\"No {workshop_name} found on the map\")\n\n  actions = []\n  # For simplicity, we will choose the first available workshop.\n  target_workshop_pos = workshop_positions[0]\n\n  # Calculate the relative position of the target workshop from the current position\n  current_x, current_y = env._current_state.pos\n  target_x, target_y = target_workshop_pos\n\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the target workshop\n  if dx > 0:\n      actions.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n  elif dx < 0:\n      actions.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n\n  if dy > 0:\n      actions.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n  elif dy < 0:\n      actions.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n\n  # Use the workshop to craft the item\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:20:03.526535", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Select the closest available workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Determine the path to the workshop using A* algorithm for optimal pathfinding\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  def astar(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = heapq.heappop(open_set)[1]\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + 1\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n              if env._current_state.grid[neighbor] == 0:\n                  continue\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  path_to_workshop = astar(current_pos, target_workshop_pos)\n\n  # Convert the path to actions\n  actions_to_reach_workshop = []\n  current_dir = env._current_state.dir\n\n  for i in range(len(path_to_workshop) - 1):\n      dx = path_to_workshop[i + 1][0] - path_to_workshop[i][0]\n      dy = path_to_workshop[i + 1][1] - path_to_workshop[i][1]\n\n      if dx == 1:\n          actions_to_reach_workshop.append(3)  # RIGHT\n      elif dx == -1:\n          actions_to_reach_workshop.append(2)  # LEFT\n      elif dy == 1:\n          actions_to_reach_workshop.append(1)  # UP\n      elif dy == -1:\n          actions_to_reach_workshop.append(0)  # DOWN\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:20:04.496731", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Select the closest available workshop\n  current_pos = env._current_state.pos\n  distances = [abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]) for pos in workshop_positions]\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the workshop\n  actions_to_reach_workshop = calculate_path(env, current_pos, target_workshop_pos)\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:20:53.572630", "function_name": "craft", "function_body": "  # Convert item name to its index\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Find the workshop location (workshop is specified as \"_at\" in the recipe)\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Locate all workshops in the world\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if workshop_positions.size == 0:\n    raise ValueError(f\"No workshop found for {workshop_name} to craft {item}\")\n\n  # Choose the closest workshop (heuristic: use the first one)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Function to generate actions to move to a target position\n  def move_to(target_pos):\n    actions = []\n    current_pos = env._current_state.pos\n    delta_x = target_pos[1] - current_pos[1]\n    delta_y = target_pos[0] - current_pos[0]\n\n    # Adjust direction based on the relative position of the target\n    if delta_x > 0:\n        actions.append(env.world.cookbook.index[\"RIGHT\"])\n    elif delta_x < 0:\n        actions.append(env.world.cookbook.index[\"LEFT\"])\n\n    if delta_y > 0:\n        actions.append(env.world.cookbook.index[\"DOWN\"])\n    elif delta_y < 0:\n        actions.append(env.world.cookbook.index[\"UP\"])\n\n    # Move to the target position\n    for _ in range(abs(delta_x)):\n        actions.append(env.world.cookbook.index[\"RIGHT\"] if delta_x > 0 else env.world.cookbook.index[\"LEFT\"])\n    for _ in range(abs(delta_y)):\n        actions.append(env.world.cookbook.index[\"DOWN\"] if delta_y > 0 else env.world.cookbook.index[\"UP\"])\n\n    return actions\n\n  # Generate actions to move to the workshop\n  actions = move_to(target_workshop_pos)\n\n  # Perform the use action at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:20:54.533565", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine which workshop to go to (from \"_at\" key in recipe)\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the specified workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) > 0:\n    # Choose one of the workshops (first one for now)\n    target_workshop_pos = tuple(workshop_positions[0])\n    \n    # Move to the target workshop\n    current_position = env._current_state.pos\n    while current_position != target_workshop_pos:\n        actions.extend(move_to(env, current_position, target_workshop_pos))\n        current_position = env._current_state.pos\n    \n    # Perform the CRAFT action at the workshop\n    use_action_index = 4  # Assuming USE is mapped to index 4\n    actions.append(use_action_index)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:21:34.064958", "function_name": "craft", "function_body": "  world = env.world\n  cookbook = world.cookbook\n\n  # Get the index of the desired output from the recipe\n  output_index = cookbook.index[item]\n  recipe = cookbook.recipes[output_index]\n\n  actions = []\n\n  # Find the workshop where this item must be crafted\n  workshop_name = recipe['_at']\n  workshop_index = world.workshop_indices[world.world.cookbook.index[workshop_name]]\n\n  # Get current position of agent\n  current_pos = env._current_state.pos\n\n  # Use a simple heuristic to move towards the closest workshop (manhattan distance)\n  target_workshop_pos = np.argwhere(workshop_index == env._current_state.grid[:, :, world.world.cookbook.index[workshop_name]])[0]\n\n  # Calculate the direction to move\n  while not np.array_equal(current_pos, target_workshop_pos):\n      dx, dy = target_workshop_pos - current_pos\n      \n      if dx < 0:\n          actions.append(env.action_specs()['LEFT'])\n      elif dx > 0:\n          actions.append(env.action_specs()['RIGHT'])\n      else:\n          if dy < 0:\n              actions.append(env.action_specs()['UP'])\n          elif dy > 0:\n              actions.append(env.action_specs()['DOWN'])\n      \n      current_pos = tuple(current_pos + np.array([dx, dy]) / max(abs(dx), abs(dy)))\n\n  # Once at the workshop, perform USE action to craft\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:21:35.091102", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the workshop index from the recipe\n  item_index = env.world.cookbook.index[item]\n  workshop_index = env.world.cookbook.recipes[item_index][\"_key\"]\n\n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n\n  # If the workshop is not found, return an empty list of actions\n  if workshop_pos is None:\n      return []\n\n  # Calculate the direction to move to reach the workshop\n  agent_x, agent_y = env._current_state.pos\n  workshop_x, workshop_y = workshop_pos\n\n  # Move horizontally towards the workshop\n  while agent_x < workshop_x:\n      actions.append(env.action_specs()['RIGHT'])\n      agent_x += 1\n  while agent_x > workshop_x:\n      actions.append(env.action_specs()['LEFT'])\n      agent_x -= 1\n\n  # Move vertically towards the workshop\n  while agent_y < workshop_y:\n      actions.append(env.action_specs()['DOWN'])\n      agent_y += 1\n  while agent_y > workshop_y:\n      actions.append(env.action_specs()['UP'])\n      agent_y -= 1\n\n  # Craft the item at the workshop\n  actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:22:23.451388", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the direction to move towards the target position\n  delta_x = target_pos[0] - current_pos[0]\n  delta_y = target_pos[1] - current_pos[1]\n\n  # Normalize direction\n  if abs(delta_x) > abs(delta_y):\n    # Move horizontally\n    if delta_x < 0:\n      actions.append(env.action_specs()[\"LEFT\"])\n    else:\n      actions.append(env.action_specs()[\"RIGHT\"])\n  else:\n    # Move vertically\n    if delta_y < 0:\n      actions.append(env.action_specs()[\"DOWN\"])\n    else:\n      actions.append(env.action_specs()[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 0.90000004}}
{"timestamp": "2025-09-16T20:22:24.429177", "function_name": "craft", "function_body": "  # Get the index of the target item\n  target_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item from cookbook\n  recipe = env.world.cookbook.recipes[target_index]\n  \n  # Extract the workshop where this item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  workshop_indices = env.world.workshop_indices\n  \n  # Find all positions of the correct workshop on the grid\n  valid_workshop_positions = []\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.argmax(env._current_state.grid[y, x]) == workshop_index:\n              valid_workshop_positions.append((x, y))\n  \n  # Find the nearest workshop position to the agent's current position\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  for pos in valid_workshop_positions:\n      distance = np.linalg.norm(np.array(pos) - np.array(env._current_state.pos))\n      if distance < min_distance:\n          min_distance = distance\n          nearest_workshop_pos = pos\n  \n  # Generate actions to move the agent to the nearest workshop position\n  x, y = env._current_state.pos\n  target_x, target_y = nearest_workshop_pos\n  actions = []\n  \n  while x != target_x or y != target_y:\n      if x < target_x:\n          actions.append(env.world.action_specs[\"RIGHT\"])\n          x += 1\n      elif x > target_x:\n          actions.append(env.world.action_specs[\"LEFT\"])\n          x -= 1\n      elif y < target_y:\n          actions.append(env.world.action_specs[\"DOWN\"])\n          y += 1\n      elif y > target_y:\n          actions.append(env.world.action_specs[\"UP\"])\n          y -= 1\n  \n  # Add the USE action to craft the item at the workshop\n  actions.append(env.world.action_specs[\"USE\"])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:23:08.061436", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n\n  # Get the recipe for the target item\n  if isinstance(item, str):\n    item_index = cookbook.index[item]\n  else:\n    raise ValueError(\"item should be a string representing the name of the item.\")\n\n  recipe = cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for item {item}.\")\n\n  # Find the workshop where the item needs to be crafted\n  workshop_name = recipe['_at']\n  if workshop_name in env.world.cookbook.index:\n    workshop_index = env.world.cookbook.index[workshop_name]\n  else:\n    raise ValueError(f\"Workshop {workshop_name} not found.\")\n\n  # Find the positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No workshop found on the grid.\")\n  \n  # Choose the closest workshop to the agent's current position\n  agent_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(agent_position - workshop_positions, axis=1)\n  closest_workshop_position = tuple(workshop_positions[np.argmin(distances_to_workshops)])\n\n  # Calculate actions to move towards the closest workshop\n  while env._current_state.pos != closest_workshop_position:\n    if env._current_state.pos[0] < closest_workshop_position[0]:\n      actions.append(env.world.N_ACTIONS + craft.ACTIONS['RIGHT'])\n    elif env._current_state.pos[0] > closest_workshop_position[0]:\n      actions.append(env.world.N_ACTIONS + craft.ACTIONS['LEFT'])\n    elif env._current_state.pos[1] < closest_workshop_position[1]:\n      actions.append(env.world.N_ACTIONS + craft.ACTIONS['DOWN'])\n    else:\n      actions.append(env.world.N_ACTIONS + craft.ACTIONS['UP'])\n\n  # Add the USE action to perform crafting\n  actions.append(craft.ACTIONS['USE'])\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:23:09.034633", "function_name": "craft", "function_body": "  # Get the current state of the environment\n  state = env._current_state\n\n  # Get the cookbook from the world\n  cookbook = env.world.cookbook\n\n  # Find the recipe for the desired item\n  output_index = cookbook.index[item]\n  recipe = cookbook.recipes[output_index]\n\n  # Get the workshop index specified in the recipe\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for {item}\")\n  \n  # Choose the closest workshop (this is a simple heuristic)\n  agent_position = np.array(state.pos)\n  distances = np.linalg.norm(agent_position - workshop_positions, axis=1)\n  nearest_workshop_position = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate actions to move to the nearest workshop\n  actions_to_workshop = calculate_movement_actions(env._current_state, nearest_workshop_position)\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_workshop.append(craft.USE)\n\n  return actions_to_workshop", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:23:54.021935", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  # Find the workshop associated with crafting this item from the recipe\n  workshop_name = [k for k, v in env.world.cookbook.recipes.items() if v.get(\"_key\") == \"_at\" and v[\"_at\"] == item][0]\n  i_workshop = env.world.cookbook.index[workshop_name]\n\n  # Find the location of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n    \n  # Choose the first available workshop (we can improve this by choosing the closest one)\n  target_pos = tuple(workshop_positions[0])\n\n  # Move to the position of the workshop\n  actions.extend(move_to_position(env._current_state, target_pos))\n\n  # Add the CRAFT action at the workshop\n  actions.append(craft.CRAFT_FUNC)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:23:55.019038", "function_name": "craft", "function_body": "  # Get the workshop and recipe for the desired item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  item_idx = index[item]\n  if item_idx is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  recipe = cookbook.recipes.get(item_idx, {})\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n    raise ValueError(f\"No workshop specified in the recipe for item: {item}\")\n\n  workshop_idx = index[workshop_name]\n  if workshop_idx is None:\n    raise ValueError(f\"Unknown workshop: {workshop_name}\")\n\n  # Find the nearest workshop of the required type\n  state = env._current_state\n  grid = state.grid\n  workshops = np.argwhere(grid[:, :, workshop_idx] == 1)\n  min_dist = float('inf')\n  closest_workshop = None\n\n  for workshop in workshops:\n    dist = abs(workshop[0] - state.pos[0]) + abs(workshop[1] - state.pos[1])\n    if dist < min_dist:\n      min_dist = dist\n      closest_workshop = (workshop[0], workshop[1])\n\n  if closest_workshop is None:\n    raise ValueError(f\"No reachable workshop of type {workshop_name} found.\")\n\n  # Navigate to the closest workshop\n  actions_to_take = []\n  target_pos = closest_workshop\n\n  while state.pos != target_pos:\n    dx, dy = target_pos[0] - state.pos[0], target_pos[1] - state.pos[1]\n    if abs(dx) > abs(dy):\n      if dx < 0:\n        actions_to_take.append(env.world.cookbook.index[\"LEFT\"])\n      else:\n        actions_to_take.append(env.world.cookbook.index[\"RIGHT\"])\n    elif dy < 0:\n      actions_to_take.append(env.world.cookbook.index[\"UP\"])\n    else:\n      actions_to_take.append(env.world.cookbook.index[\"DOWN\"])\n\n    # Step the environment with the chosen action\n    reward, done, observations = env.step(actions_to_take[-1])\n    state = env._current_state\n\n  # Use the workshop to craft the item\n  actions_to_take.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:25:30.192041", "function_name": "craft", "function_body": "  def find_workshop_index(item):\n    recipe = env.world.cookbook.recipes[env.world.cookbook.index[item]]\n    workshop_name = recipe[\"_at\"]\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    return workshop_idx\n\n  def navigate_to_position(target_pos, current_pos, direction) -> list[int]:\n      # Define movement directions\n      directions = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n      opposite_directions = {0: 1, 1: 0, 2: 3, 3: 2}\n\n      actions = []\n      current_pos = list(current_pos)\n      \n      # Calculate the difference in positions\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      # Move horizontally (east/west)\n      while delta_x != 0:\n          if delta_x > 0:  # Move east\n              target_direction = 3\n          else:            # Move west\n              target_direction = 2\n\n          # Change direction if needed\n          if direction != target_direction:\n              actions.append(target_direction)  # Turn to the target direction\n              direction = target_direction\n\n          actions.append(4)  # Use action (which in this context is move forward)\n          current_pos[0] += directions[target_direction][0]\n          delta_x += -1 * np.sign(delta_x)\n\n      # Move vertically (north/south)\n      while delta_y != 0:\n          if delta_y > 0:  # Move north\n              target_direction = 0\n          else:            # Move south\n              target_direction = 1\n\n          # Change direction if needed\n          if direction != target_direction:\n              actions.append(target_direction)  # Turn to the target direction\n              direction = target_direction\n\n          actions.append(4)  # Use action (which in this context is move forward)\n          current_pos[1] += directions[target_direction][1]\n          delta_y += -1 * np.sign(delta_y)\n\n      return actions, direction\n\n  def find_workshop_position(workshop_idx):\n    workshop_positions = [(x, y) for x in range(env.world.scenario.grid.shape[0]) \n                            for y in range(env.world.scenario.grid.shape[1])\n                            if env.world.scenario.grid[x, y, workshop_idx] > 0]\n    if workshop_positions:\n      return workshop_positions[0]\n    else:\n      raise ValueError(\"Workshop not found on the grid\")\n\n  # Find the index of the target item's workshop\n  workshop_idx = find_workshop_index(item)\n  \n  # Get the current position and direction of the agent\n  current_pos = env.world._current_state.pos\n  current_direction = env.world._current_state.dir\n\n  # Find the position of the workshop on the grid\n  workshop_position = find_workshop_position(workshop_idx)\n\n  # Navigate to the workshop position\n  actions, final_direction = navigate_to_position(workshop_position, current_pos, current_direction)\n  \n  # Add the USE action to perform crafting at the workshop\n  actions.append(4) \n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:25:31.172493", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index using the cookbook's index.\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item.\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  # Identify the required workshop from the recipe.\n  workshop_name = recipe.get(\"_key\", \"\")\n  workshop_index = None\n  \n  # Iterate through known workshops to find the correct one.\n  for idx in env.world.workshop_indices:\n    if env.world.cookbook.index.get(env.world.cookbook.get(idx, {}).get(\"name\", \"\"), \"\") == workshop_name:\n      workshop_index = idx\n      break\n  \n  if workshop_index is None:\n    raise ValueError(f\"No workshop found that matches the required workshop for {item}\")\n  \n  # Determine agent's current position.\n  current_pos = env._current_state.pos\n\n  # Helper function to calculate Manhattan distance between two points on a grid.\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  # Find the closest workshop of the required type using Manhattan distance.\n  closest_workshop_pos = None\n  min_distance = float('inf')\n  \n  for idx in env.world.workshop_indices:\n    if env.world.cookbook.index.get(env.world.cookbook.get(idx, {}).get(\"name\", \"\"), \"\") == workshop_name:\n      x, y = np.argwhere(env._current_state.grid[:, :, idx] > 0)[0]\n      distance = manhattan_distance(current_pos, (x, y))\n      if distance < min_distance:\n        min_distance = distance\n        closest_workshop_pos = (x, y)\n  \n  if closest_workshop_pos is None:\n    raise ValueError(\"No valid workshop position found on the grid.\")\n  \n  # Function to find path from current position to target using a simple BFS.\n  def bfs_path(start, goal):\n    queue = collections.deque([start])\n    came_from = {start: None}\n    \n    while queue:\n      current = queue.popleft()\n      \n      if current == goal:\n        break\n      \n      x, y = current\n      neighbors = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n      \n      for neighbor in neighbors:\n        nx, ny = neighbor\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if all(env._current_state.grid[nx, ny, block_idx] == 0 for block_idx in env.world.non_grabbable_indices):\n            if neighbor not in came_from:\n              queue.append(neighbor)\n              came_from[neighbor] = current\n    \n    path = []\n    while goal is not None:\n      path.append(goal)\n      goal = came_from[goal]\n    return path[::-1]\n\n  # Find the shortest path to the closest workshop.\n  path_to_workshop = bfs_path(current_pos, closest_workshop_pos)\n\n  # Convert the path into a series of actions (UP, DOWN, LEFT, RIGHT).\n  actions = []\n  directions = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  \n  for i in range(len(path_to_workshop) - 1):\n    current_x, current_y = path_to_workshop[i]\n    next_x, next_y = path_to_workshop[i + 1]\n    \n    if next_x == current_x - 1:\n      actions.append(directions['UP'])\n    elif next_x == current_x + 1:\n      actions.append(directions['DOWN'])\n    elif next_y == current_y - 1:\n      actions.append(directions['LEFT'])\n    elif next_y == current_y + 1:\n      actions.append(directions['RIGHT'])\n\n  # Once at the workshop, perform the USE action to craft the item.\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:26:51.745922", "function_name": "craft", "function_body": "  # Find the index of the desired item using the cookbook index\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the goal item from the cookbook recipes dictionary\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine which workshop is required to craft this item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Check if the agent has any of the required items in its inventory\n  required_items = {k: v for k, v in recipe.items() if k != \"_at\"}\n  actions = []\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  # Check if there is any workshop available\n  if len(workshop_positions) == 0:\n    raise ValueError(\"No workshop found for crafting.\")\n  \n  # Choose a workshop (in this case, we choose the first one)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Determine the direction and actions to move towards the workshop\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  directions = ['UP', 'DOWN', 'LEFT', 'RIGHT']\n  \n  # Simple BFS for pathfinding to the workshop\n  def bfs(start_pos, target_pos):\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    while queue:\n      (x, y), path = queue.popleft()\n      if (x, y) == target_pos:\n        return path\n      for dx, dy, d in [(-1, 0, 'UP'), (1, 0, 'DOWN'), (0, -1, 'LEFT'), (0, 1, 'RIGHT')]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1] \\\n           and (nx, ny) not in visited \\\n           and not np.any(env._current_state.grid[nx, ny, list(env.world.non_grabbable_indices)] == 1):\n          queue.append(((nx, ny), path + [d]))\n          visited.add((nx, ny))\n    return None\n\n  # Find the shortest path to the workshop\n  path_to_workshop = bfs(current_pos, target_workshop_pos)\n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to the workshop found.\")\n\n  # Convert directions to actions (assuming action indices for [UP, DOWN, LEFT, RIGHT] are 0, 1, 2, 3 respectively)\n  action_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  for direction in path_to_workshop:\n    actions.append(action_map[direction])\n\n  # Append the USE action to craft the item at the workshop\n  actions.append(4)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:26:52.756137", "function_name": "craft", "function_body": "  def find_workshop(item):\n    \"\"\"Finds the workshop index required to craft the specified item.\n\n    Args:\n        item (str): The name of the item to craft.\n    \n    Returns:\n        int: The index of the workshop where the item can be crafted.\n    \"\"\"\n    # Get the recipe for the item\n    cookbook = env.world.cookbook\n    goal_idx = cookbook.index[item]\n    if \"_at\" not in cookbook.recipes[goal_idx]:\n      raise ValueError(f\"No workshop specified for crafting {item}\")\n\n    workshop_name = cookbook.recipes[goal_idx][\"_at\"]\n    return cookbook.index[workshop_name]\n\n  def go_to_workshop(workshop_idx):\n    \"\"\"Generates actions to navigate the agent to a specific workshop.\n\n    Args:\n        workshop_idx (int): The index of the workshop to navigate to.\n    \n    Returns:\n        List[int]: A list of action indices to move the agent to the workshop.\n    \"\"\"\n    # Get the position of the workshop in the grid\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)[0]\n    current_pos = env._current_state.pos\n\n    actions = []\n    while not (current_pos[0] == workshop_pos[0] and current_pos[1] == workshop_pos[1]):\n      if current_pos[0] < workshop_pos[0]:\n        actions.append(env.world.N_ACTIONS + 2)  # DOWN\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif current_pos[0] > workshop_pos[0]:\n        actions.append(env.world.N_ACTIONS + 3)  # UP\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      \n      if current_pos[1] < workshop_pos[1]:\n        actions.append(env.world.N_ACTIONS + 4)  # RIGHT\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif current_pos[1] > workshop_pos[1]:\n        actions.append(env.world.N_ACTIONS + 5)  # LEFT\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions\n\n  def use_workshop():\n    \"\"\"Generates an action to use the workshop.\n\n    Returns:\n        List[int]: A list containing the USE action index.\n    \"\"\"\n    return [env.world.N_ACTIONS + 1]  # USE\n\n  # Find the required workshop for crafting the item\n  workshop_idx = find_workshop(item)\n  \n  # Generate actions to navigate to the workshop and use it\n  actions_to_take = go_to_workshop(workshop_idx) + use_workshop()\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:28:08.198657", "function_name": "craft", "function_body": "  # Extracting necessary information\n  cookbook = env.world.cookbook\n  world = env.world\n  state = env._current_state\n\n  # Get the index for the desired item from the cookbook's index\n  item_index = cookbook.index[item]\n  \n  # Retrieve the recipe for the specified item\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe[\"_at\"]\n  workshop_indices = world.workshop_indices\n  \n  # Determine which of the workshops is the correct one for this item.\n  correct_workshop_index = None\n  for idx in workshop_indices:\n      workshop_idx_name = cookbook.index.get(world.get(idx))\n      if workshop_idx_name == workshop_name:\n          correct_workshop_index = idx\n          break\n\n  if not correct_workshop_index:\n    raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n\n  # Find position of the correct workshop\n  grid = state.grid\n  x, y = np.where(grid[:, :, correct_workshop_index] == 1)\n  \n  if len(x) == 0 or len(y) == 0:\n    raise ValueError(f\"Workshop {workshop_name} not found on the grid.\")\n\n  # Get current position of agent and direction it's facing\n  start_x, start_y = state.pos\n  start_dir = state.dir\n\n  # Determine relative direction towards the workshop from the agent's position\n  target_x, target_y = x[0], y[0] # Assuming only one workshop of each kind for simplicity\n  delta_x, delta_y = target_x - start_x, target_y - start_y\n  \n  actions = []\n  \n  # Function to turn the agent towards a direction (0: up, 1: right, 2: down, 3: left)\n  def turn_to(direction):\n    nonlocal start_dir\n    if direction == 0 and start_dir == 1:\n        actions.extend([env.world.LEFT_TURN])\n    elif direction == 0 and start_dir == 2:\n        actions.extend([env.world.LEFT_TURN, env.world.LEFT_TURN])\n    elif direction == 0 and start_dir == 3:\n        actions.append(env.world.RIGHT_TURN)\n    \n    if direction == 1 and start_dir == 0:\n        actions.append(env.world.RIGHT_TURN)\n    elif direction == 1 and start_dir == 2:\n        actions.extend([env.world.LEFT_TURN])\n    elif direction == 1 and start_dir == 3:\n        actions.extend([env.world.LEFT_TURN, env.world.LEFT_TURN])\n\n    if direction == 2 and start_dir == 0:\n        actions.extend([env.world.LEFT_TURN, env.world.LEFT_TURN])\n    elif direction == 2 and start_dir == 1:\n        actions.append(env.world.LEFT_TURN)\n    elif direction == 2 and start_dir == 3:\n        actions.append(env.world.RIGHT_TURN)\n\n    if direction == 3 and start_dir == 0:\n        actions.extend([env.world.LEFT_TURN])\n    elif direction == 3 and start_dir == 1:\n        actions.extend([env.world.LEFT_TURN, env.world.LEFT_TURN])\n    elif direction == 3 and start_dir == 2:\n        actions.append(env.world.RIGHT_TURN)\n\n    # Update the agent's current direction\n    start_dir = direction\n\n  # Determine the direction towards the workshop\n  if delta_y < 0:   # Target is up\n      turn_to(0)\n      actions.extend([env.world.MOVE_UP] * abs(delta_y))\n  elif delta_x > 0: # Target is right\n      turn_to(1)\n      actions.extend([env.world.MOVE_RIGHT] * abs(delta_x))\n  elif delta_y > 0: # Target is down\n      turn_to(2)\n      actions.extend([env.world.MOVE_DOWN] * abs(delta_y))\n  elif delta_x < 0: # Target is left\n      turn_to(3)\n      actions.extend([env.world.MOVE_LEFT] * abs(delta_x))\n\n  # Once the agent reaches the workshop, perform the USE action to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:28:09.237259", "function_name": "craft", "function_body": "  # Retrieve the index of the target item\n  item_index = env.world.cookbook.index[item]\n\n  # Extract the recipe for the target item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Determine the workshop where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Get the agent's current position and direction\n  agent_pos = env._current_state.pos\n  agent_dir = env._current_state.dir\n\n  # Calculate the direction to move towards the workshop\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index])[0]\n  direction_to_workshop = get_direction(agent_pos, workshop_pos)\n\n  # Generate a list of actions to move towards the workshop\n  move_actions = []\n  while agent_pos != tuple(workshop_pos):\n    move_actions.append(directions[direction_to_workshop])\n    agent_pos = (agent_pos[0] + directions[direction_to_workshop][1],\n                 agent_pos[1] + directions[direction_to_workshop][0])\n\n  # Add the action to use the workshop for crafting\n  move_actions.append(4)  # USE action\n\n  return move_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:28:56.507733", "function_name": "craft", "function_body": "  # Fetch the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Get the required workshop from the recipe\n  workshop_name = recipe.pop(\"_key\")\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # Move to a cell next to the specified workshop\n  workshops = [pos for pos, value in np.ndenumerate(env._current_state.grid) if value[workshop_index] == 1]\n  \n  if not workshops:\n    raise ValueError(f\"No {workshop_name} found on the grid\")\n\n  target_workshop_pos = workshops[0]\n\n  # Calculate the direction to move towards the workshop\n  current_pos = env._current_state.pos\n\n  while current_pos != target_workshop_pos:\n      delta_x = target_workshop_pos[1] - current_pos[1]\n      delta_y = target_workshop_pos[0] - current_pos[0]\n\n      if delta_x > 0:\n          actions.append(env.world.N_ACTIONS[\"RIGHT\"])\n      elif delta_x < 0:\n          actions.append(env.world.N_ACTIONS[\"LEFT\"])\n\n      if delta_y > 0:\n          actions.append(env.world.N_ACTIONS[\"DOWN\"])\n      elif delta_y < 0:\n          actions.append(env.world.N_ACTIONS[\"UP\"])\n\n      # Update the current position based on the action\n      if delta_x != 0:\n          current_pos = (current_pos[0], current_pos[1] + np.sign(delta_x))\n      else:\n          current_pos = (current_pos[0] + np.sign(delta_y), current_pos[1])\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(env.world.N_ACTIONS[\"USE\"])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:28:57.487477", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item {item}\")\n\n  # Extract the workshop location from the recipe\n  workshop_name = recipe.pop(\"_at\", None)\n  if not workshop_name:\n    raise ValueError(f\"Workshop not specified in the recipe for item {item}\")\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if not workshop_positions.size:\n    raise ValueError(f\"Workshop {workshop_name} not found in the environment\")\n\n  # Select the first occurrence of the workshop (assuming only one for simplicity)\n  workshop_pos = tuple(workshop_positions[0])\n\n  # Get current agent position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the path to the workshop\n  path_to_workshop = compute_path(current_pos, workshop_pos)\n\n  actions = []\n  for pos in path_to_workshop:\n    move_action = move_towards(env, pos)\n    actions.extend(move_action)\n\n  # Once at the workshop, turn towards it and use the USE action\n  final_move_action = face_direction(env._current_state.pos, workshop_pos, current_dir)\n  actions.extend(final_move_action)\n\n  # Use the USE action to craft the item\n  actions.append(craft.CRAFT_FUNC[craft.USE])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:29:44.636511", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  recipe = cookbook.recipes[goal_index]\n  \n  # Get the workshop index from the recipe.\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of the specified workshop on the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop {workshop_name} found on the grid.\")\n\n  # Assuming the agent can move to any of these workshops. Let's choose the first one.\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Determine the relative direction from current position to the workshop.\n  current_pos = env._current_state.pos\n  dx = target_workshop_pos[1] - current_pos[1]\n  dy = target_workshop_pos[0] - current_pos[0]\n\n  actions = []\n\n  # Move in the x-direction first.\n  if dx > 0:\n    actions.extend([craft.MOVE_FUNC(craft.RIGHT)] * abs(dx))\n  elif dx < 0:\n    actions.extend([craft.MOVE_FUNC(craft.LEFT)] * abs(dx))\n\n  # Then move in the y-direction.\n  if dy > 0:\n    actions.extend([craft.MOVE_FUNC(craft.DOWN)] * abs(dy))\n  elif dy < 0:\n    actions.extend([craft.MOVE_FUNC(craft.UP)] * abs(dy))\n\n  # Finally, perform the USE action to craft at the workshop.\n  actions.append(craft.CRAFT_FUNC(item))\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:29:45.756053", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the first available workshop position to craft the item at\n        target_workshop_pos = tuple(workshop_positions[0])\n        \n        current_pos = env._current_state.pos\n        \n        # Calculate the relative direction from the agent's position to the target workshop position\n        rel_x, rel_y = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n        \n        actions_to_take = []\n\n        if rel_x > 0:\n            # Move RIGHT\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            # Move LEFT\n            actions_to_take.extend([2] * abs(rel_x))\n            \n        if rel_y > 0:\n            # Move DOWN\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            # Move UP\n            actions_to_take.extend([0] * abs(rel_y))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T20:35:39.773704", "function_name": "craft", "function_body": "  # Find the index for the target item\n  i_item = env.world.cookbook.index[item]\n  \n  # Get the workshop index from the recipe\n  recipe = env.world.cookbook.recipes[i_item]\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop with the matching index in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, i_workshop])\n  if len(positions) == 0:\n      raise ValueError(f\"No workshops for {item} found on the map.\")\n  \n  nearest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n  \n  # Generate actions to move to the nearest workshop\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n  target_pos = np.array(nearest_position)\n  \n  while not np.array_equal(current_pos, target_pos):\n      delta = target_pos - current_pos\n      \n      if abs(delta[0]) > abs(delta[1]):\n          move_action = env.world.cookbook.index['UP'] if delta[0] < 0 else env.world.cookbook.index['DOWN']\n      else:\n          move_action = env.world.cookbook.index['LEFT'] if delta[1] < 0 else env.world.cookbook.index['RIGHT']\n      \n      actions.append(move_action)\n      current_pos += np.array([move_action == env.world.cookbook.index['UP'], move_action == env.world.cookbook.index['DOWN'],\n                               move_action == env.world.cookbook.index['LEFT'], move_action == env.world.cookbook.index['RIGHT']]).nonzero()[0][0] - 1\n      \n      # Check for invalid actions (moving into obstacles)\n      if not env._current_state.next_to(i_workshop):\n          actions.append(env.world.cookbook.index['USE'])\n  \n  # Add the USE action to craft the item\n  actions.append(env.world.cookbook.index['USE'])\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:35:40.736597", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Find the workshop for the given item in recipes\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  if recipe is None:\n      raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.get(\"_at\", None)\n  if workshop_name is None:\n      raise ValueError(f\"Workshop not specified in the recipe for item: {item}\")\n  \n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  grid = env._current_state.grid\n  workshop_pos = np.argwhere(grid[:, :, workshop_index] == 1)\n  if len(workshop_pos) == 0:\n      raise ValueError(f\"Workshop not found on the grid: {workshop_name}\")\n\n  # Select the first occurrence of the workshop in the grid (assuming there's only one)\n  workshop_pos = tuple(workshop_pos[0])\n\n  # Add actions to move to the workshop\n  current_pos = env._current_state.pos\n\n  while current_pos != workshop_pos:\n      delta_x = workshop_pos[0] - current_pos[0]\n      delta_y = workshop_pos[1] - current_pos[1]\n\n      if delta_x > 0:\n          actions.append(env.world.N_ACTIONS)  # DOWN\n      elif delta_x < 0:\n          actions.append(env.world.N_ACTIONS + 1)  # UP\n      \n      if delta_y > 0:\n          actions.append(env.world.N_ACTIONS + 2)  # RIGHT\n      elif delta_y < 0:\n          actions.append(env.world.N_ACTIONS + 3)  # LEFT\n\n      # Move the agent one step towards the workshop\n      env._current_state, _ = env._current_state.step(actions[-1])\n      current_pos = env._current_state.pos\n\n  # Add action to use the workshop for crafting\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:36:41.549842", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Determine the workshop required by the recipe\n  workshop_name = recipe['_key']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found on the grid.\")\n\n  # Determine the nearest workshop to the current agent position\n  agent_pos = env._current_state.pos\n  distances = np.sum((workshop_positions - agent_pos) ** 2, axis=1)\n  nearest_workshop_index = np.argmin(distances)\n  nearest_workshop_position = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate the actions needed to move from current position to the nearest workshop\n  actions.extend(move_to_target(env._current_state.pos, nearest_workshop_position))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.ACTIONS['USE'])\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:36:42.518112", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the item to get the workshop it needs to be crafted at\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"]\n\n  # Get the index of the workshop from the environment's cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops in the grid\n  grid_with_workshops = np.where(env._current_state.grid[:, :, workshop_index] == 1)\n  workshop_positions = list(zip(grid_with_workshops[0], grid_with_workshops[1]))\n\n  # Placeholder for actions to take\n  actions_to_take = []\n\n  # Function to calculate Manhattan distance between two points on the grid\n  def manhattan_distance(pos1, pos2):\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  # Determine which workshop is closest to the agent's current position\n  closest_workshop = min(workshop_positions, key=lambda wp: manhattan_distance(env._current_state.pos, wp))\n\n  # Calculate actions required to move towards the closest workshop\n  while env._current_state.pos != closest_workshop:\n      current_pos = env._current_state.pos\n\n      # Determine possible moves and their respective distances to the target position\n      possible_moves = {\n          craft.DOWN: manhattan_distance((current_pos[0] + 1, current_pos[1]), closest_workshop),\n          craft.UP: manhattan_distance((current_pos[0] - 1, current_pos[1]), closest_workshop),\n          craft.LEFT: manhattan_distance((current_pos[0], current_pos[1] - 1), closest_workshop),\n          craft.RIGHT: manhattan_distance((current_pos[0], current_pos[1] + 1), closest_workshop)\n      }\n\n      # Choose the move that minimizes distance to the target\n      chosen_move = min(possible_moves, key=possible_moves.get)\n\n      # Append the chosen move to the list of actions\n      actions_to_take.append(chosen_move)\n\n      # Simulate the chosen move to update the current state (this is a placeholder; in actual implementation, this would be handled by the environment)\n      env._current_state = CraftState(\n          scenario=env.scenario,\n          grid=env._current_state.grid.copy(),\n          pos=(current_pos[0] + 1 if chosen_move == craft.DOWN else\n               current_pos[0] - 1 if chosen_move == craft.UP else\n               current_pos[0],\n               current_pos[1] + 1 if chosen_move == craft.RIGHT else\n               current_pos[1] - 1 if chosen_move == craft.LEFT else\n               current_pos[1]),\n          dir=env._current_state.dir,\n          inventory=env._current_state.inventory.copy()\n      )\n\n  # Once at the workshop, append the USE action to craft the item\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:37:19.200996", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  goal_index = index[item]\n  \n  # Check if the item has a recipe (crafted item)\n  if goal_index not in cookbook.recipes:\n    return actions\n\n  # Retrieve the workshop name from the recipe\n  workshop_name = cookbook.recipes[goal_index][\"_key\"]\n\n  # Get the index of the workshop\n  workshop_index = index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  world_grid = env._current_state.grid\n  positions = np.argwhere(world_grid[:, :, workshop_index] == 1)\n\n  if len(positions) == 0:\n    return actions\n\n  # Choose one of the workshops randomly (or the first one)\n  target_workshop_pos = tuple(positions[0])\n\n  # Move to the target workshop\n  current_pos = env._current_state.pos\n  delta_x = target_workshop_pos[0] - current_pos[0]\n  delta_y = target_workshop_pos[1] - current_pos[1]\n\n  if delta_x > 0:\n    actions.extend([craft.RIGHT] * abs(delta_x))\n  elif delta_x < 0:\n    actions.extend([craft.LEFT] * abs(delta_x))\n\n  if delta_y > 0:\n    actions.extend([craft.DOWN] * abs(delta_y))\n  elif delta_y < 0:\n    actions.extend([craft.UP] * abs(delta_y))\n\n  # Perform the use action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:37:20.187124", "function_name": "craft", "function_body": "  # Obtain the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe details from the cookbook for this item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Ensure there's a recipe for the item\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Extract the workshop index where crafting must occur\n  _key = \"_at\"\n  workshop_name = recipe.pop(_key, None)\n  if not workshop_name:\n    raise ValueError(\"Workshop name not specified in recipe.\")\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n  \n  # For simplicity, we'll pick the first occurrence of the workshop\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Generate path to the target workshop\n  actions_to_target_workshop = _generate_path(env._current_state.grid, env._current_state.pos, target_workshop_pos)\n  \n  # Action for using the crafting action at the workshop\n  USE_ACTION = 4\n  \n  # Combine all actions to reach and craft the item at the workshop\n  return actions_to_target_workshop + [USE_ACTION]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:38:47.717237", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the path to the target position using A* algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - path[i][0]\n      delta_y = next_pos[1] - path[i][1]\n\n      if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif delta_x > 0:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n      else:\n          actions.append(env.action_specs()[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T20:38:48.684616", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the direction to move towards the target position using A* algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start, goal):\n      frontier = collections.PriorityQueue()\n      frontier.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n      \n      while not frontier.empty():\n          current = frontier.get()[1]\n          \n          if current == goal:\n              break\n          \n          # Get valid neighbors (up, down, left, right)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              next_pos = (current[0] + dx, current[1] + dy)\n              \n              # Check if the position is within bounds and not blocked\n              if 0 <= next_pos[0] < grid.shape[0] and 0 <= next_pos[1] < grid.shape[1]:\n                  if np.sum(grid[next_pos]) == 0:  # Assuming empty cells are walkable\n                      new_cost = cost_so_far[current] + 1\n                      \n                      if next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]:\n                          cost_so_far[next_pos] = new_cost\n                          priority = new_cost + heuristic(goal, next_pos)\n                          frontier.put((priority, next_pos))\n                          came_from[next_pos] = current\n      \n      # Reconstruct the path\n      path = []\n      current = goal\n      while current != start:\n          path.append(current)\n          current = came_from[current]\n      path.reverse()\n      \n      return path\n\n  path_to_workshop = a_star_search(current_pos, target_pos)\n\n  for next_pos in path_to_workshop:\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      # Determine the direction to move\n      if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif delta_x > 0:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n      elif delta_y > 0:\n          actions.append(env.action_specs()[\"UP\"])\n\n      # Update the current position\n      current_pos = next_pos\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:39:47.754774", "function_name": "craft", "function_body": "  # Fetching the required recipe from cookbook\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  # Get the workshop specified in the recipe\n  workshop_name = env.world.cookbook.recipes[item_index][\"_key\"]\n  workshop_indices = [env.world.workshop_indices[i] for i, name in enumerate(index) if name.startswith(workshop_name)]\n  \n  if not workshop_indices:\n      raise ValueError(f\"No workshop found that matches {workshop_name}\")\n\n  # Assuming there's only one workshop with the specified name\n  workshop_index = workshop_indices[0]\n  \n  # Define actions to move towards the closest workshop\n  x, y = env._current_state.pos\n  target_x, target_y = np.unravel_index(workshop_index, env._current_state.grid.shape[:2])\n\n  # Use A* algorithm or a simple pathfinding method to get the path to the workshop\n  actions_to_workshop = pathfind(env._current_state.grid, (x, y), (target_x, target_y))\n  \n  # Add USE action to craft the item at the workshop\n  actions_to_craft = [4]  # Assuming USE is represented by index 4\n\n  return actions_to_workshop + actions_to_craft", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:39:48.810287", "function_name": "craft", "function_body": "  # Get the index for the target item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n  \n  # Determine which workshop is required to craft this item\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the list of workshops in the environment\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the correct workshop\n  for workshop_idx in workshop_indices:\n    if workshop_idx == workshop_index:\n      target_workshop_position = None\n      grid = env._current_state.grid\n      \n      # Search for the workshop's position on the grid\n      positions = np.argwhere(grid[:, :, workshop_idx] > 0)\n      \n      if len(positions) == 0:\n        raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n      \n      target_workshop_position = tuple(positions[0])\n      break\n  \n  # If no valid workshop position is found, raise an error\n  if target_workshop_position is None:\n    raise ValueError(\"No valid workshop position found for the given recipe.\")\n\n  # Calculate the necessary actions to move the agent to the target workshop\n  current_pos = env._current_state.pos\n  target_dir = None\n  \n  # Determine direction needed to face the target workshop\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n  \n  if delta_x == 0:\n    if delta_y > 0:\n      target_dir = 3  # DOWN\n    else:\n      target_dir = 1  # UP\n  elif delta_y == 0:\n    if delta_x > 0:\n      target_dir = 2  # RIGHT\n    else:\n      target_dir = 0  # LEFT\n  \n  actions_to_take = []\n  \n  # Add movement actions to reach the workshop position\n  while current_pos != target_workshop_position:\n    delta_x = target_workshop_position[0] - current_pos[0]\n    delta_y = target_workshop_position[1] - current_pos[1]\n    \n    if delta_x > 0:\n      actions_to_take.append(2)  # RIGHT\n    elif delta_x < 0:\n      actions_to_take.append(0)  # LEFT\n    \n    if delta_y > 0:\n      actions_to_take.append(3)  # DOWN\n    elif delta_y < 0:\n      actions_to_take.append(1)  # UP\n    \n    current_pos = (current_pos[0] + (1 if delta_x > 0 else -1 if delta_x < 0 else 0),\n                   current_pos[1] + (1 if delta_y > 0 else -1 if delta_y < 0 else 0))\n  \n  # Add action to face the correct direction\n  if target_dir is not None:\n    actions_to_take.append(target_dir)\n  \n  # Add USE action to craft the item at the workshop\n  actions_to_take.append(4)  # USE\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T20:40:27.538164", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  index = env.world.cookbook.index[item]\n  \n  # Access the recipe for the desired item\n  recipe = env.world.cookbook.recipes[index]\n\n  # Extract the workshop where the item should be crafted\n  workshop_name = recipe.pop('_at')\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # Find and move to the nearest workshop that matches the required workshop index\n  if not env._current_state.next_to(workshop_index):\n    # Find the position of the nearest workshop\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    distances = [np.linalg.norm(pos - np.array(env._current_state.pos)) for pos in positions]\n    \n    if not positions.any():\n      raise ValueError(f\"No available {workshop_name} found on the grid.\")\n      \n    nearest_workshop_pos = positions[np.argmin(distances)]\n\n    # Calculate relative direction to the nearest workshop\n    current_x, current_y = env._current_state.pos\n    workshop_x, workshop_y = nearest_workshop_pos\n    \n    while abs(workshop_x - current_x) > 0 or abs(workshop_y - current_y) > 0:\n        dx = workshop_x - current_x\n        dy = workshop_y - current_y\n        \n        if abs(dx) >= abs(dy):\n            direction = UP if dx < 0 else DOWN\n        else:\n            direction = LEFT if dy < 0 else RIGHT\n\n        actions.append(direction)\n        \n        # Update the agent's position based on the movement action\n        if direction == UP:\n            current_y -= 1\n        elif direction == DOWN:\n            current_y += 1\n        elif direction == LEFT:\n            current_x -= 1\n        elif direction == RIGHT:\n            current_x += 1\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:40:28.632681", "function_name": "craft", "function_body": "  # Step 1: Determine the workshop where we need to go to craft the item.\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[item_index]\n\n  if \"_at\" not in recipe:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Step 2: Find the position of the workshop in the grid.\n  workshop_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[y, x] == workshop_index):\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n\n  if not workshop_pos:\n    raise ValueError(f\"No workshop found for {item}\")\n\n  # Step 3: Navigate to the workshop.\n  actions_to_workshop = navigate(env._current_state.pos, workshop_pos, env._current_state.dir)\n\n  # Step 4: Craft the item by using the USE action at the workshop.\n  actions_to_craft = [craft.CRAFT_FUNC(craft.parse_fexp(f\"{item}[0]\")[0])]\n\n  return actions_to_workshop + actions_to_craft", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:40:59.082354", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop where the item must be crafted\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(positions) == 0:\n    raise ValueError(\"No available workshop found for the item.\")\n\n  # Assume we pick the first workshop found\n  target_pos = tuple(positions[0])\n  \n  # Calculate the relative position to move towards the target workshop\n  current_pos = env._current_state.pos\n  dx, dy = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n  \n  if dx > 0:\n    actions.extend([craft.RIGHT]*abs(dx))\n  elif dx < 0:\n    actions.extend([craft.LEFT]*abs(dx))\n\n  if dy > 0:\n    actions.extend([craft.DOWN]*abs(dy))\n  elif dy < 0:\n    actions.extend([craft.UP]*abs(dy))\n  \n  # Now the agent is at the workshop, perform the USE action to craft\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:41:00.063643", "function_name": "craft", "function_body": "  # Extract the index of the goal item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  # Identify the workshop where the item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found on the map.\")\n  \n  # Choose the first available workshop position (could be optimized)\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Move towards the chosen workshop\n  actions_to_move = move_to_position(env, target_workshop_pos)\n  \n  # Add the USE action to start crafting at the workshop\n  actions_to_craft = actions_to_move + [env.world.N_ACTIONS]  # Assuming N_ACTIONS is the index for USE\n  \n  return actions_to_craft", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:41:44.546952", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  i_item = env.world.cookbook.index[item]\n\n  # Find the workshop where the item needs to be crafted\n  recipe = env.world.cookbook.recipes[i_item]\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n\n  # Get positions of all workshops in the grid world\n  grid = env._current_state.grid[:, :, i_workshop]\n  workshop_positions = np.argwhere(grid > 0)\n\n  # Find the closest workshop position to the agent's current position\n  pos_agent = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - pos_agent, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate actions needed to move to the closest workshop position\n  x_diff = closest_workshop_pos[0] - pos_agent[0]\n  y_diff = closest_workshop_pos[1] - pos_agent[1]\n\n  actions = []\n  \n  if x_diff > 0:\n    actions.extend([env.world.DOWN for _ in range(x_diff)])\n  elif x_diff < 0:\n    actions.extend([env.world.UP for _ in range(-x_diff)])\n\n  if y_diff > 0:\n    actions.extend([env.world.RIGHT for _ in range(y_diff)])\n  elif y_diff < 0:\n    actions.extend([env.world.LEFT for _ in range(-y_diff)])\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:41:45.512060", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the goal item\n  goal_index = env.world.cookbook.index.index(item)\n  \n  # Fetch the recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  # Find the workshop specified in the recipe (e.g., \"_at\": \"WORKSHOP0\")\n  workshop_name = [k for k, v in recipe.items() if k.startswith('_at')][0].split(\"_\")[1]\n  workshop_index = env.world.cookbook.index.index(workshop_name)\n  \n  # Find the position of the closest workshop\n  grid = env._current_state.grid\n  \n  # Get positions of all workshops in the environment\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n      \n  current_pos = env._current_state.pos\n  \n  # Find the closest workshop to the current position\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  closest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate actions to move towards the closest workshop\n  while env._current_state.pos != closest_workshop_pos:\n      dx = closest_workshop_pos[0] - env._current_state.pos[0]\n      dy = closest_workshop_pos[1] - env._current_state.pos[1]\n\n      if dx > 0 and not env._current_state.next_to(env.world.stone_index):\n          actions.append(craft.RIGHT)\n      elif dx < 0 and not env._current_state.next_to(env.world.stone_index):\n          actions.append(craft.LEFT)\n      elif dy > 0 and not env._current_state.next_to(env.world.stone_index):\n          actions.append(craft.DOWN)\n      elif dy < 0 and not env._current_state.next_to(env.world.stone_index):\n          actions.append(craft.UP)\n\n      # Take a step to simulate the movement\n      _, _ = env._current_state.step(actions[-1])\n  \n  # Once at the workshop, perform the craft action (USE)\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:42:28.028808", "function_name": "craft", "function_body": "  def find_workshop_for_item(item_index):\n    # Find the workshop index for the specified item\n    recipe = env.world.cookbook.recipes[item_index]\n    workshop_name = recipe[\"_at\"]\n    return env.world.cookbook.index.get(workshop_name)\n\n  def navigate_to_workshop(workshop_index):\n    # Navigate to the nearest workshop in the grid\n    actions = []\n    agent_pos = env._current_state.pos\n\n    # Simple BFS for finding shortest path to a workshop\n    queue = collections.deque([(agent_pos, [])])\n    visited = set([agent_pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if env._current_state.grid[x, y, workshop_index] > 0:\n        actions.extend(path)\n        return actions\n\n      # Explore neighbors\n      for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [translate_direction(dx, dy)]))\n\n    return actions\n\n  def translate_direction(dx, dy):\n      # Translate direction from (dx, dy) to action index\n      if dx == 1: return 3  # RIGHT\n      elif dx == -1: return 2  # LEFT\n      elif dy == 1: return 0  # DOWN\n      elif dy == -1: return 1  # UP\n\n  def use_action():\n    # Perform the USE action to craft the item\n    return [4]\n\n  actions = []\n  \n  item_index = env.world.cookbook.index.get(item)\n  if item_index is not None:\n    workshop_index = find_workshop_for_item(item_index)\n    if workshop_index is not None:\n      actions.extend(navigate_to_workshop(workshop_index))\n      actions.extend(use_action())\n    \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:42:29.009796", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the required workshop for crafting this item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the position of the workshop in the grid\n  workshop_pos = None\n  for y, row in enumerate(env._current_state.grid):\n      for x, cell in enumerate(row):\n          if cell[workshop_index] > 0:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n  \n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  dx = workshop_pos[0] - agent_pos[0]\n  dy = workshop_pos[1] - agent_pos[1]\n  \n  # Move to the workshop position\n  if dx > 0:\n      actions.extend([craft.LEFT]*abs(dx))\n  elif dx < 0:\n      actions.extend([craft.RIGHT]*abs(dx))\n  if dy > 0:\n      actions.extend([craft.DOWN]*abs(dy))\n  elif dy < 0:\n      actions.extend([craft.UP]*abs(dy))\n  \n  # Perform the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:43:31.561892", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Select the closest workshop to the agent\n  current_pos = env._current_state.pos\n  distances = [np.linalg.norm(np.array(current_pos) - np.array(pos)) for pos in workshop_positions]\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate the path to the workshop using A* search algorithm\n  actions_to_reach_workshop = a_star_search(env, current_pos, target_workshop_pos)\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:43:32.541298", "function_name": "craft", "function_body": "  def calculate_path(start_pos, target_pos):\n      # Use BFS to find the shortest path\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          pos = queue.popleft()\n          if pos == target_workshop_pos:\n              break\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = (pos[0] + dx, pos[1] + dy)\n              if (new_pos not in visited and \n                  0 <= new_pos[0] < env._current_state.grid.shape[0] and\n                  0 <= new_pos[1] < env._current_state.grid.shape[1]):\n                  queue.append(new_pos)\n                  visited.add(new_pos)\n                  parent[new_pos] = pos\n\n      # Reconstruct the path\n      path = []\n      while target_workshop_pos:\n          path.append(target_workshop_pos)\n          target_workshop_pos = parent[target_workshop_pos]\n      return path[::-1]\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Select the closest available workshop\n  current_pos = env._current_state.pos\n  target_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Calculate the path to the workshop using BFS\n  path_to_workshop = calculate_path(current_pos, tuple(target_workshop_pos))\n\n  actions_to_reach_workshop = []\n  for i in range(1, len(path_to_workshop)):\n      dx = path_to_workshop[i][0] - path_to_workshop[i-1][0]\n      dy = path_to_workshop[i][1] - path_to_workshop[i-1][1]\n\n      if dx > 0:\n          actions_to_reach_workshop.append(3)  # RIGHT\n      elif dx < 0:\n          actions_to_reach_workshop.append(2)  # LEFT\n      elif dy > 0:\n          actions_to_reach_workshop.append(1)  # UP\n      elif dy < 0:\n          actions_to_reach_workshop.append(0)  # DOWN\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:44:43.467616", "function_name": "craft", "function_body": "  def bfs(start_pos, target_index):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n\n      while queue:\n          pos = queue.popleft()\n          if env._current_state.grid[pos] == target_index:\n              path = []\n              while pos is not None:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]\n\n          visited.add(pos)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = (pos[0] + dx, pos[1] + dy)\n              if 0 <= new_pos[0] < env._current_state.grid.shape[0] and \\\n                 0 <= new_pos[1] < env._current_state.grid.shape[1] and \\\n                 new_pos not in visited:\n                  parent[new_pos] = pos\n                  queue.append(new_pos)\n\n      return None\n\n  goal_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Select the closest available workshop\n  current_pos = env._current_state.pos\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Calculate the path to the workshop using BFS\n  path_to_workshop = bfs(current_pos, workshop_index)\n\n  if not path_to_workshop:\n      raise ValueError(\"No valid path to the workshop found.\")\n\n  actions_to_reach_workshop = []\n  for i in range(len(path_to_workshop) - 1):\n      dx = path_to_workshop[i + 1][0] - path_to_workshop[i][0]\n      dy = path_to_workshop[i + 1][1] - path_to_workshop[i][1]\n\n      if dx == 1:\n          actions_to_reach_workshop.append(3)  # RIGHT\n      elif dx == -1:\n          actions_to_reach_workshop.append(2)  # LEFT\n      elif dy == 1:\n          actions_to_reach_workshop.append(1)  # UP\n      elif dy == -1:\n          actions_to_reach_workshop.append(0)  # DOWN\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:44:44.595837", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  actions_to_reach_workshop = []\n\n  # Calculate the path to the workshop using a simple greedy approach\n  while current_pos != target_workshop_pos:\n      dx = target_workshop_pos[0] - current_pos[0]\n      dy = target_workshop_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move along the x-axis\n          action = 3 if dx > 0 else 2\n      else:\n          # Move along the y-axis\n          action = 1 if dy > 0 else 0\n\n      actions_to_reach_workshop.append(action)\n\n      # Update the current position based on the last action taken\n      if action == 3:  # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif action == 2:  # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif action == 1:  # UP\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      else:  # DOWN\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T20:45:54.221949", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  actions_to_reach_workshop = []\n\n  # Calculate the path to the workshop using a more sophisticated approach (BFS)\n  from collections import deque\n\n  directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n  visited = set()\n  queue = deque([(current_pos, [])])\n\n  while queue:\n      (x, y), path = queue.popleft()\n\n      if (x, y) == target_workshop_pos:\n          actions_to_reach_workshop.extend(path)\n          break\n\n      for dx, dy in directions:\n          new_x, new_y = x + dx, y + dy\n          if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n              if (new_x, new_y) not in visited:\n                  visited.add((new_x, new_y))\n                  action = [2, 3, 0, 1][directions.index((dx, dy))]\n                  queue.append(((new_x, new_y), path + [action]))\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T20:45:55.302260", "function_name": "craft", "function_body": "  def bfs(start_pos, target_index):\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # UP, DOWN, RIGHT, LEFT\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          current_pos, path = queue.popleft()\n          x, y = current_pos\n\n          if env._current_state.grid[x, y, target_index] > 0:\n              return path\n\n          for dx, dy in directions:\n              new_x, new_y = x + dx, y + dy\n              if (new_x >= 0 and new_x < env._current_state.grid.shape[0] and\n                  new_y >= 0 and new_y < env._current_state.grid.shape[1]):\n                  if (new_x, new_y) not in visited:\n                      visited.add((new_x, new_y))\n                      queue.append(((new_x, new_y), path + [directions.index((dx, dy))]))\n\n      return None\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  current_pos = env._current_state.pos\n  actions_to_reach_workshop = bfs(current_pos, workshop_index)\n\n  if actions_to_reach_workshop is None:\n      raise ValueError(f\"No path found to {workshop_name} in the environment.\")\n\n  # Convert direction indices to action indices\n  direction_to_action = [0, 1, 3, 2]  # UP, DOWN, RIGHT, LEFT\n  actions_to_take = [direction_to_action[d] for d in actions_to_reach_workshop]\n\n  # Add the USE action to craft the item\n  actions_to_take.append(4)  # USE\n\n  return actions_to_take", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T20:47:19.389690", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Get the required workshop index from the recipe\n  workshop_name = recipe.pop('_at')\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops in the grid\n  grid_with_workshops = np.any(env._current_state.grid[:, :, workshop_indices], axis=-1)\n  workshop_positions = [(x, y) for x in range(grid_with_workshops.shape[0]) \n                        for y in range(grid_with_workshops.shape[1]) if grid_with_workshops[x, y]]\n\n  # Filter to find the specific workshop we need\n  correct_workshop_position = None\n  for pos in workshop_positions:\n      if env._current_state.grid[pos][workshop_index] > 0:\n          correct_workshop_position = pos\n          break\n\n  if not correct_workshop_position:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  # Calculate actions to move towards the workshop\n  target_pos = np.array(correct_workshop_position)\n  current_pos = np.array(env._current_state.pos)\n\n  delta = target_pos - current_pos\n  actions = []\n\n  while not np.array_equal(current_pos, target_pos):\n      if delta[0] > 0:\n          actions.append(MOVE_FUNC(DOWN))\n          current_pos += np.array([1, 0])\n      elif delta[0] < 0:\n          actions.append(MOVE_FUNC(UP))\n          current_pos -= np.array([1, 0])\n      elif delta[1] > 0:\n          actions.append(MOVE_FUNC(RIGHT))\n          current_pos += np.array([0, 1])\n      elif delta[1] < 0:\n          actions.append(MOVE_FUNC(LEFT))\n          current_pos -= np.array([0, 1])\n\n  # Perform the USE action to craft the item\n  actions.append(USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:47:20.374709", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the required workshop for crafting this item\n  workshop_name = None\n  for recipe in env.world.cookbook.recipes.values():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_name = recipe[\"_at\"]\n          break\n  \n  if workshop_name is None:\n      raise ValueError(f\"No recipe found for {item}\")\n  \n  # Get the index of the required workshop from the cookbook\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the position of all workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop found for {item}\")\n  \n  # Choose one of the workshops (for simplicity, we choose the first one)\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Calculate the direction vector to move towards the workshop\n  current_pos = env._current_state.pos\n  direction_vector = (target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0])\n  \n  # Determine the sequence of actions to move towards the workshop\n  if direction_vector[0] > 0:\n      actions.extend([craft.ACTION_MAP[\"RIGHT\"]] * abs(direction_vector[0]))\n  elif direction_vector[0] < 0:\n      actions.extend([craft.ACTION_MAP[\"LEFT\"]] * abs(direction_vector[0]))\n  \n  if direction_vector[1] > 0:\n      actions.extend([craft.ACTION_MAP[\"DOWN\"]] * abs(direction_vector[1]))\n  elif direction_vector[1] < 0:\n      actions.extend([craft.ACTION_MAP[\"UP\"]] * abs(direction_vector[1]))\n  \n  # Finally, add the action to use the workshop\n  actions.append(craft.ACTION_MAP[\"USE\"])\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:48:42.807167", "function_name": "craft", "function_body": "  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the target workshop in the environment\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Choose the closest workshop to the current position\n  current_pos = env._current_state.pos\n  distances = [np.linalg.norm(np.array(pos) - np.array(current_pos)) for pos in workshop_positions]\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = []\n\n  # Calculate the path to the workshop using a simple greedy approach\n  while current_pos != target_workshop_pos:\n      dx = target_workshop_pos[0] - current_pos[0]\n      dy = target_workshop_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          # Move along the x-axis\n          action = 3 if dx > 0 else 2\n      else:\n          # Move along the y-axis\n          action = 1 if dy > 0 else 0\n\n      actions_to_reach_workshop.append(action)\n\n      # Update the current position based on the last action taken\n      if action == 3:  # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif action == 2:  # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif action == 1:  # UP\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      else:  # DOWN\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T20:48:43.861024", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return (3 if dx > 0 else 2)\n      else:\n          return (1 if dy > 0 else 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = []\n\n  while current_pos != target_workshop_pos:\n      next_action = get_next_action(current_pos, target_workshop_pos)\n      actions_to_reach_workshop.append(next_action)\n\n      if next_action == 3:   # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif next_action == 2: # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif next_action == 1: # UP\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      else:                  # DOWN\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T20:50:04.981246", "function_name": "craft", "function_body": "  # Get the index of the target item\n  target_item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[target_item_index]\n\n  # Extract the required workshop from the recipe\n  workshop_name = recipe[\"_key\"]\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the correct workshop index based on its name\n  workshop_index = [idx for idx, name in enumerate(workshop_names) if name == workshop_name][0]\n  \n  # Determine the position of the workshop in the grid\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_indices[workshop_index]])[0]\n  \n  # Calculate the path to reach the workshop (simple heuristic: move towards the workshop)\n  actions_to_workshop = []\n  current_pos = env._current_state.pos\n\n  while not np.array_equal(current_pos, workshop_pos):\n      if current_pos[0] < workshop_pos[0]:\n          actions_to_workshop.append(env.action_specs()[\"DOWN\"])\n      elif current_pos[0] > workshop_pos[0]:\n          actions_to_workshop.append(env.action_specs()[\"UP\"])\n      elif current_pos[1] < workshop_pos[1]:\n          actions_to_workshop.append(env.action_specs()[\"RIGHT\"])\n      else:\n          actions_to_workshop.append(env.action_specs()[\"LEFT\"])\n\n      # Simulate the action to update the current position (simplified)\n      next_action = actions_to_workshop[-1]\n      _, env._current_state = env._current_state.step(next_action)\n      current_pos = env._current_state.pos\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions_to_craft = [env.action_specs()[\"USE\"]]\n\n  return actions_to_workshop + actions_to_craft", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:50:06.012124", "function_name": "craft", "function_body": "  # Retrieve the cookbook from the environment's world\n  cookbook = env.world.cookbook\n\n  # Get the index of the item to be crafted\n  item_index = cookbook.index[item]\n\n  # Find the workshop where this item can be crafted\n  for output, recipe in cookbook.recipes.items():\n      if \"_at\" in recipe and recipe[\"_at\"] is not None:\n          workshop_name = recipe[\"_at\"]\n          break\n\n  # Get the index of the workshop from the environment's world\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the workshop on the grid\n  # Assuming there's only one workshop of this kind in the grid, \n  # we iterate over the grid to find its position.\n  workshop_position = None\n  for y in range(env._current_state.grid.shape[0]):\n      for x in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[y, x, workshop_index] > 0:\n              workshop_position = (x, y)\n              break\n      if workshop_position is not None:\n          break\n\n  # If the workshop position is not found, raise an error.\n  if workshop_position is None:\n      raise ValueError(\"Workshop for the item could not be found in the grid.\")\n\n  # Find the sequence of actions to move from the current agent's position to the workshop position\n  start_x, start_y = env._current_state.pos\n  target_x, target_y = workshop_position\n\n  path_actions = []\n  while (start_x, start_y) != (target_x, target_y):\n      if start_x < target_x:\n          path_actions.append(env.N_ACTIONS.RIGHT)\n          start_x += 1\n      elif start_x > target_x:\n          path_actions.append(env.N_ACTIONS.LEFT)\n          start_x -= 1\n      elif start_y < target_y:\n          path_actions.append(env.N_ACTIONS.DOWN)\n          start_y += 1\n      elif start_y > target_y:\n          path_actions.append(env.N_ACTIONS.UP)\n          start_y -= 1\n\n  # Add the USE action to perform the crafting at the workshop\n  path_actions.append(env.N_ACTIONS.USE)\n\n  return path_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:51:08.537121", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T20:51:09.615918", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          return (3 if dx > 0 else 2)\n      else:\n          return (1 if dy > 0 else 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = []\n\n  while current_pos != target_workshop_pos:\n      next_action = get_next_action(current_pos, target_workshop_pos)\n      actions_to_reach_workshop.append(next_action)\n\n      # Update current position based on action\n      if next_action == 3:   # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif next_action == 2: # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif next_action == 1: # UP\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      else:                  # DOWN\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T20:52:16.444847", "function_name": "craft", "function_body": "  # Get the index of the goal item from its name\n  goal_index = env.world.cookbook.index[item]\n\n  # Fetch the recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  # Extract the workshop where the item needs to be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if not workshop_positions.size:\n      raise ValueError(\"No valid workshop found for the item.\")\n      \n  # Calculate Manhattan distance to each workshop and choose the closest one\n  agent_position = np.array(env._current_state.pos)\n  distances = np.sum(np.abs(workshop_positions - agent_position), axis=1)\n  closest_workshop_idx = np.argmin(distances)\n  closest_workshop_pos = tuple(workshop_positions[closest_workshop_idx])\n  \n  # Calculate the direction to move towards the closest workshop\n  move_actions = []\n  while env._current_state.pos != closest_workshop_pos:\n      current_position = np.array(env._current_state.pos)\n      target_direction = closest_workshop_pos - current_position\n      \n      if target_direction[1] > 0:  # Move down\n          move_actions.append(craft.DOWN)\n      elif target_direction[1] < 0:  # Move up\n          move_actions.append(craft.UP)\n          \n      if target_direction[0] > 0:  # Move right\n          move_actions.append(craft.RIGHT)\n      elif target_direction[0] < 0:  # Move left\n          move_actions.append(craft.LEFT)\n\n  # Append the USE action to craft the item at the workshop\n  move_actions.append(craft.USE)\n\n  return move_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:52:17.458223", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Determine the workshop where the item needs to be crafted\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item {item}\")\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # Find and move to the workshop\n  pos, dir = env._current_state.pos, env._current_state.dir\n\n  # Get the grid representation of the environment\n  grid = env._current_state.grid\n\n  # Use BFS to find the shortest path to the workshop\n  queue = collections.deque([(pos, [])])\n  visited = set()\n  directions = {'UP': (-1, 0), 'DOWN': (1, 0), 'LEFT': (0, -1), 'RIGHT': (0, 1)}\n\n  while queue:\n    current_pos, path = queue.popleft()\n\n    if grid[current_pos] == workshop_index:\n      actions.extend(path)\n      break\n\n    if current_pos in visited:\n      continue\n    visited.add(current_pos)\n\n    for direction_name, move in directions.items():\n      next_pos = (current_pos[0] + move[0], current_pos[1] + move[1])\n\n      # Check if the next position is within bounds and not blocked\n      if 0 <= next_pos[0] < grid.shape[0] and 0 <= next_pos[1] < grid.shape[1]:\n        if grid[next_pos].sum() == 0:  # Assuming that a cell with no kind (all zeros) is walkable\n          new_path = path + [getattr(env.world, f\"N_{direction_name}\")]\n          queue.append((next_pos, new_path))\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(env.world.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:53:31.854463", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n\n      if dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T20:53:32.958129", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def find_closest_workshop(workshop_positions, current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(current_pos))\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = tuple(pos)\n      return closest_workshop\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = find_closest_workshop(workshop_positions, env._current_state.pos)\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n  actions_to_reach_workshop.append(4)  # USE\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T20:54:52.327364", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n                \n        # Calculate the relative direction from the agent's position to the target workshop position\n        rel_x, rel_y = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n        \n        actions_to_take = []\n\n        if rel_x > 0:\n            # Move RIGHT\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            # Move LEFT\n            actions_to_take.extend([2] * abs(rel_x))\n            \n        if rel_y > 0:\n            # Move DOWN\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            # Move UP\n            actions_to_take.extend([0] * abs(rel_y))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T20:54:53.340232", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the first available workshop position to craft the item at\n        target_workshop_pos = tuple(workshop_positions[0])\n        \n        current_pos = env._current_state.pos\n        \n        # Calculate the shortest path from the agent's position to the target workshop position using BFS\n        actions_to_take = bfs_shortest_path(env, current_pos, target_workshop_pos)\n        \n        if actions_to_take:\n            # Use the USE action to craft the item at the workshop\n            actions_to_take.append(4)\n\n            return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:56:33.055906", "function_name": "craft", "function_body": "  # Extracting necessary information from the environment\n  cookbook = env.world.cookbook\n  world_grid = env._current_state.grid\n  agent_pos = env._current_state.pos\n  agent_dir = env._current_state.dir\n\n  # Getting the index of the item to craft\n  item_index = cookbook.index[item]\n\n  # Extracting the recipe for the item\n  recipe = cookbook.recipes[item_index]\n  \n  # The workshop where the item should be crafted is stored in \"_at\" key\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Getting the list of workshops indices available in the grid\n  workshop_indices = env.world.workshop_indices\n\n  # Finding the closest workshop that matches the required one\n  def find_closest_workshop(grid, agent_pos, target_workshop_index):\n    \"\"\"Finds the closest workshop to the agent's current position.\"\"\"\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    \n    for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n        if grid[i, j, target_workshop_index] > 0:\n          distance = abs(i - agent_pos[0]) + abs(j - agent_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (i, j)\n    \n    return closest_workshop_pos\n  \n  # Find the position of the workshop to craft the item\n  target_workshop_pos = find_closest_workshop(world_grid, agent_pos, workshop_index)\n\n  if not target_workshop_pos:\n      raise ValueError(f\"No workshop found for {item}.\")\n\n  # Calculating actions to move to the closest workshop\n  def calculate_moves_to_target(agent_pos, target_pos):\n    \"\"\"Calculates a sequence of moves to reach the target position.\"\"\"\n    moves = []\n    \n    dx = target_pos[0] - agent_pos[0]\n    dy = target_pos[1] - agent_pos[1]\n\n    if dx < 0:\n      moves.extend([env.world.N_ACTIONS.DOWN] * abs(dx))\n    elif dx > 0:\n      moves.extend([env.world.N_ACTIONS.UP] * abs(dx))\n\n    if dy < 0:\n      moves.extend([env.world.N_ACTIONS.RIGHT] * abs(dy))\n    elif dy > 0:\n      moves.extend([env.world.N_ACTIONS.LEFT] * abs(dy))\n    \n    return moves\n\n  # Calculate the sequence of movements to reach the workshop\n  move_actions = calculate_moves_to_target(agent_pos, target_workshop_pos)\n\n  # Adding the action to use the workshop for crafting\n  craft_action = [env.world.N_ACTIONS.USE]\n\n  # Combining the actions and returning them\n  return move_actions + craft_action", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:56:34.054151", "function_name": "craft", "function_body": "  # Retrieve the required recipe for the item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  item_index = index(item)\n  \n  if not item_index:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Find the workshop where the item should be crafted\n  recipe = cookbook.recipes[item_index]\n  required_workshop_name = recipe.get(\"_at\")\n  if not required_workshop_name:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n  \n  required_workshop_index = index(required_workshop_name)\n  if not required_workshop_index:\n    raise ValueError(f\"Unknown workshop: {required_workshop_name}\")\n\n  # Get all positions of the required workshops in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, required_workshop_index] > 0)\n\n  if workshop_positions.size == 0:\n    raise ValueError(\"No available workshops for crafting the item\")\n\n  # Find the nearest workshop to the current agent position\n  agent_position = np.array(env._current_state.pos)\n  distances_to_workshops = np.linalg.norm(workshop_positions - agent_position, axis=1)\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_index])\n\n  # Calculate the sequence of actions to reach the nearest workshop\n  path_to_workshop = a_star_search(grid, env._current_state.pos, nearest_workshop_pos)\n\n  # Construct the list of actions to craft the item at the nearest workshop\n  actions = []\n  for move in path_to_workshop:\n      direction = get_direction(env._current_state.pos, move)\n      actions.append(direction)\n      env._current_state.pos = move\n\n  # Add the USE action to perform crafting once at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:57:47.561086", "function_name": "craft", "function_body": "  actions = []\n  \n  # Convert item name to index using the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Determine the workshop required to craft the item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the workshop in the grid\n  workshop_position = None\n  grid = env._current_state.grid\n  \n  for x in range(grid.shape[0]):\n    for y in range(grid.shape[1]):\n      if grid[x, y, workshop_index] > 0:\n        workshop_position = (x, y)\n        break\n    if workshop_position:\n      break\n\n  if not workshop_position:\n    raise ValueError(\"Workshop not found in the grid\")\n  \n  # Move to the workshop position\n  agent_x, agent_y = env._current_state.pos\n  \n  # Calculate direction deltas\n  delta_x = workshop_position[0] - agent_x\n  delta_y = workshop_position[1] - agent_y\n\n  # Determine movement directions based on deltas\n  if delta_x > 0:\n    actions.extend([craft.RIGHT] * abs(delta_x))\n  elif delta_x < 0:\n    actions.extend([craft.LEFT] * abs(delta_x))\n\n  if delta_y > 0:\n    actions.extend([craft.DOWN] * abs(delta_y))\n  elif delta_y < 0:\n    actions.extend([craft.UP] * abs(delta_y))\n  \n  # Craft the item at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:57:48.533015", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Find the required workshop for crafting this item\n  workshop_name = [key for key in recipe if key.startswith(\"_\")][0]\n  workshop_index = env.world.cookbook.index[workshop_name[1:]]\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  # Assume there's only one workshop of each type. Take the first available position.\n  workshop_pos = tuple(workshop_positions[0])\n\n  actions_to_take = []\n\n  # Move to the workshop position\n  current_pos = env._current_state.pos\n\n  while current_pos != workshop_pos:\n    dx, dy = workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1]\n    \n    if dx > 0:\n      actions_to_take.append(env.world.ACTIONS.index(\"DOWN\"))\n    elif dx < 0:\n      actions_to_take.append(env.world.ACTIONS.index(\"UP\"))\n\n    if dy > 0:\n      actions_to_take.append(env.world.ACTIONS.index(\"RIGHT\"))\n    elif dy < 0:\n      actions_to_take.append(env.world.ACTIONS.index(\"LEFT\"))\n\n    # Update current position after each move\n    current_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions_to_take.append(env.world.ACTIONS.index(\"USE\"))\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T20:59:05.667919", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item\n  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes[i_item]\n\n  # Extract the workshop name where the item should be crafted\n  workshop_name = recipe[\"_at\"]\n  \n  # Retrieve the index for the workshop\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Get the list of indices for all workshops in the environment\n  workshop_indices = env.world.workshop_indices\n\n  # Find the nearest workshop that matches the required workshop type\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n  \n  # Iterate over each cell in the grid to find the nearest matching workshop\n  for x in range(env._current_state.grid.shape[0]):\n    for y in range(env._current_state.grid.shape[1]):\n      if i_workshop in env._current_state.grid[x, y]:\n        distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          nearest_workshop_pos = (x, y)\n\n  actions = []\n\n  # Move to the nearest workshop\n  if nearest_workshop_pos is not None:\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = nearest_workshop_pos\n\n    # Calculate the direction to move in each step\n    while current_x != target_x or current_y != target_y:\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      if dx > 0 and env._current_state.next_to(env.world.cookbook.index[\"WORKSHOP\"]):\n        actions.append(craft.NEXT_TO_WORKSHOP_ACTION)\n      elif dx < 0 and env._current_state.next_to(env.world.cookbook.index[\"WORKSHOP\"]):\n        actions.append(craft.NEXT_TO_WORKSHOP_ACTION)\n      elif dy > 0:\n        actions.append(craft.DOWN)\n        current_y += 1\n      elif dy < 0:\n        actions.append(craft.UP)\n        current_y -= 1\n\n    # Add the action to perform the crafting after reaching the workshop\n    actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T20:59:06.628148", "function_name": "craft", "function_body": "  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n\n  # Check if the item exists in the cookbook\n  goal_idx = cookbook.index[item]\n  if goal_idx is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  actions = []\n\n  # Determine the workshop index specified in the recipe for crafting the target item\n  workshop_name = cookbook.recipes[goal_idx][\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find a position next to the correct workshop\n  grid = env._current_state.grid\n  height, width, _ = grid.shape\n\n  found_workshop = False\n  for x in range(width):\n    for y in range(height):\n      if grid[y, x, workshop_index] > 0:\n        target_pos = (x, y)\n        found_workshop = True\n        break\n    if found_workshop:\n      break\n\n  if not found_workshop:\n    raise ValueError(f\"Workshop {workshop_name} not found in the grid.\")\n\n  # Move to a position next to the workshop\n  current_pos = env._current_state.pos\n  actions.extend(moveto(env, target_pos))\n\n  # Perform the craft action (USE)\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:01:00.525987", "function_name": "craft", "function_body": "  # Get the index of the item we need to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop name from the recipe using _at key\n  workshop_name = recipe[\"_key\"]\n\n  # Get the index of the workshop from the environment's cookbook index\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of this workshop on the grid\n  workshops_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshops_positions) == 0:\n      raise ValueError(f\"No workshop found for item {item}.\")\n\n  # Choose the closest workshop (for simplicity, we choose the first one)\n  target_workshop_position = workshops_positions[0]\n\n  # Get current position and direction of the agent\n  agent_pos = env._current_state.pos\n  agent_dir = env._current_state.dir\n\n  # Calculate the relative direction to face the workshop from the agent's current position\n  delta_x = target_workshop_position[1] - agent_pos[1]\n  delta_y = target_workshop_position[0] - agent_pos[0]\n\n  actions = []\n\n  # First, turn the agent to face the correct direction to move towards the workshop\n  if delta_x > 0:\n      # Move right\n      if agent_dir != craft.RIGHT:\n          actions.append(craft.RIGHT_TURN)\n  elif delta_x < 0:\n      # Move left\n      if agent_dir != craft.LEFT:\n          actions.append(craft.LEFT_TURN)\n  else:\n      # No horizontal movement needed\n      pass\n\n  if delta_y > 0:\n      # Move down\n      if agent_dir != craft.DOWN:\n          if agent_dir == craft.RIGHT:\n              actions.append(craft.LEFT_TURN)\n          elif agent_dir == craft.LEFT:\n              actions.append(craft.RIGHT_TURN)\n  elif delta_y < 0:\n      # Move up\n      if agent_dir != craft.UP:\n          if agent_dir == craft.RIGHT:\n              actions.append(craft.RIGHT_TURN)\n          elif agent_dir == craft.LEFT:\n              actions.append(craft.LEFT_TURN)\n\n  # Now, move the agent towards the workshop\n  for _ in range(abs(delta_x) + abs(delta_y)):\n      actions.append(craft.FORWARD)\n\n  # Finally, perform the USE action to craft the item at the workshop\n  actions.append(craft.USE_ACTION)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:01:01.514593", "function_name": "craft", "function_body": "  # Get the current CraftState from the environment\n  current_state = env._current_state\n\n  # Retrieve the cookbook and index from the world\n  cookbook = current_state.world.cookbook\n  index = cookbook.index\n  \n  # Convert item name to index\n  item_index = index[item]\n  \n  # Find the workshop where the item should be crafted\n  recipe = cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = index[workshop_name]\n\n  # Function to move to a specific direction and perform an action\n  def move_and_use(direction, actions):\n    if direction == 'UP':\n      actions.append(env.world.N_ACTIONS['UP'])\n    elif direction == 'DOWN':\n      actions.append(env.world.N_ACTIONS['DOWN'])\n    elif direction == 'LEFT':\n      actions.append(env.world.N_ACTIONS['LEFT'])\n    elif direction == 'RIGHT':\n      actions.append(env.world.N_ACTIONS['RIGHT'])\n    \n    actions.append(env.world.N_ACTIONS['USE'])\n    return actions\n\n  # Find the workshop position on the grid\n  pos = current_state.pos\n  found_workshop = False\n  for x in range(current_state.grid.shape[0]):\n    for y in range(current_state.grid.shape[1]):\n      if np.argmax(current_state.grid[x, y]) == workshop_index:\n        target_pos = (x, y)\n        found_workshop = True\n        break\n    if found_workshop:\n        break\n\n  if not found_workshop:\n    raise ValueError(f\"Workshop for {item} not found on the grid.\")\n\n  # Calculate the path to the workshop using a simple BFS\n  def bfs(start_pos, target_pos):\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if current == target_pos:\n              break\n          \n          x, y = current\n          neighbors = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n          \n          for nx, ny in neighbors:\n              if 0 <= nx < current_state.grid.shape[0] and 0 <= ny < current_state.grid.shape[1]:\n                  if current_state.grid[nx, ny][workshop_index] == 0 and (nx, ny) not in visited:\n                      queue.append((nx, ny))\n                      visited.add((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      path = []\n      while target_pos is not None:\n          path.append(target_pos)\n          target_pos = parent[target_pos]\n      \n      return path[::-1]  # Return reversed path to start from the beginning\n\n  path_to_workshop = bfs(pos, target_pos)\n\n  actions = []\n\n  # Move along the path and use at the workshop\n  for (x, y) in path_to_workshop:\n    if x < pos[0]:\n      actions = move_and_use('UP', actions)\n    elif x > pos[0]:\n      actions = move_and_use('DOWN', actions)\n    elif y < pos[1]:\n      actions = move_and_use('LEFT', actions)\n    elif y > pos[1]:\n      actions = move_and_use('RIGHT', actions)\n    \n    # Update current position\n    pos = (x, y)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:03:07.196753", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the recipe for the target item\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Choose the closest workshop\n  target_pos = min(workshop_positions, key=lambda pos: heuristic(env._current_state.pos, tuple(pos)))\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      (0, -1): env.action_specs()[\"UP\"],\n      (0, 1): env.action_specs()[\"DOWN\"],\n      (-1, 0): env.action_specs()[\"LEFT\"],\n      (1, 0): env.action_specs()[\"RIGHT\"]\n  }\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n    \n    actions.append(action_map[(delta_x, delta_y)])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:03:08.290449", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Calculate the path to the target position using A* algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - path[i][0]\n      delta_y = next_pos[1] - path[i][1]\n\n      if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif delta_x > 0:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n      else:\n          actions.append(env.action_specs()[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:04:08.802268", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T21:04:09.923635", "function_name": "craft", "function_body": "  def get_next_actions(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_actions(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T21:05:14.508234", "function_name": "craft", "function_body": "  def move_to_workshop(workshop_idx):\n    # Find the position of all workshops\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n    \n    if len(workshop_positions) == 0:\n        raise ValueError(\"No workshops found for the given index.\")\n\n    target_pos = workshop_positions[0]\n\n    x, y = env._current_state.pos\n    tx, ty = target_pos\n    \n    actions = []\n    \n    # Calculate moves to reach the target position\n    while x != tx or y != ty:\n        if x < tx:\n            actions.append(env.world.N_ACTIONS + craft.RIGHT)\n            x += 1\n        elif x > tx:\n            actions.append(env.world.N_ACTIONS + craft.LEFT)\n            x -= 1\n        \n        if y < ty:\n            actions.append(env.world.N_ACTIONS + craft.DOWN)\n            y += 1\n        elif y > ty:\n            actions.append(env.world.N_ACTIONS + craft.UP)\n            y -= 1\n    \n    # Use the workshop action to start crafting\n    actions.append(craft.USE)\n    \n    return actions\n\n  item_idx = env.world.cookbook.index[item]\n  \n  if \"_key\" in env.world.cookbook.recipes[item_idx]:\n      recipe_workshop_key = env.world.cookbook.recipes[item_idx][\"_at\"]\n  else:\n      raise ValueError(\"Recipe for the given item does not specify a workshop.\")\n\n  workshop_idx = env.world.cookbook.index[recipe_workshop_key]\n  \n  return move_to_workshop(workshop_idx)", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:05:15.470488", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop for crafting the item\n  recipe = env.world.cookbook.recipes[item_index]\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions_to_take = []\n\n  # Helper function to add move actions based on direction difference\n  def add_move_actions(current_dir, target_dir):\n    if current_dir != target_dir:\n      # Calculate the difference in directions and convert it into appropriate action\n      dir_diff = (target_dir - current_dir) % 4\n      if dir_diff == 1 or dir_diff == -3:\n        actions_to_take.append(3)  # RIGHT\n      elif dir_diff == 2:\n        actions_to_take.append(0)  # DOWN\n      elif dir_diff == 3 or dir_diff == -1:\n        actions_to_take.append(2)  # LEFT\n      elif dir_diff == 0:\n        pass  # No change needed\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshops found for {item}.\")\n\n  # Assume we move towards the first available workshop\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the direction to face the workshop\n  current_pos = env._current_state.pos\n  dx, dy = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n  \n  if dx > 0:\n    target_dir = 3  # RIGHT\n  elif dx < 0:\n    target_dir = 2  # LEFT\n  else:\n    target_dir = env._current_state.dir  # Same x, use current direction\n  \n  if dy > 0:\n    target_dir = 1  # UP\n  elif dy < 0:\n    target_dir = 0  # DOWN\n\n  # Add actions to change direction and move towards the workshop\n  add_move_actions(env._current_state.dir, target_dir)\n\n  while current_pos != target_workshop_pos:\n    current_pos = env._current_state.pos\n    if dx > 0:\n      actions_to_take.append(3)  # RIGHT\n      dx -= 1\n    elif dx < 0:\n      actions_to_take.append(2)  # LEFT\n      dx += 1\n    else:\n      pass  # No x movement needed\n    \n    if dy > 0:\n      actions_to_take.append(1)  # UP\n      dy -= 1\n    elif dy < 0:\n      actions_to_take.append(0)  # DOWN\n      dy += 1\n\n  # Once at the workshop, use the USE action to craft the item\n  actions_to_take.append(4)  # USE\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:06:07.926761", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  recipe_index = env.world.cookbook.index[item]\n  \n  # Fetch the recipe details\n  recipe_details = env.world.cookbook.recipes[recipe_index]\n  \n  # Determine the workshop required to craft this item\n  required_workshop_name = recipe_details.pop('_key')\n  required_workshop_index = env.world.cookbook.index[required_workshop_name]\n\n  # Find the closest workshop of the required type\n  workshop_positions = [(x, y) for x in range(env._current_state.grid.shape[0]) \n                        for y in range(env._current_state.grid.shape[1])\n                        if np.any(env._current_state.grid[x, y] == required_workshop_index)]\n\n  # Calculate distances to each potential workshop\n  agent_position = env._current_state.pos\n  distances_to_workshops = [abs(agent_position[0] - wp[0]) + abs(agent_position[1] - wp[1]) for wp in workshop_positions]\n\n  # Find the nearest workshop\n  nearest_workshop_index = np.argmin(distances_to_workshops)\n  nearest_workshop_pos = workshop_positions[nearest_workshop_index]\n  \n  # Move to the nearest workshop\n  actions += move_to(env._current_state, nearest_workshop_pos)\n\n  # Craft the item at the workshop\n  actions.append(craft.CRAFT_FUNC.LPAR(item) + craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:06:08.897746", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Check if there is a \"_at\" key in the recipe to specify the workshop\n  workshop_name = recipe.get(\"_key\", None)\n  if workshop_name:\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the nearest workshop of the required type\n    grid_with_workshops = np.any(env._current_state.grid[:, :, workshop_index], axis=2)\n    workshop_positions = np.argwhere(grid_with_workshops)\n\n    if workshop_positions.size > 0:\n      agent_pos = np.array(env._current_state.pos)\n      \n      # Calculate distances from the agent to each workshop\n      distances = np.linalg.norm(agent_pos - workshop_positions, axis=1)\n      nearest_workshop_idx = np.argmin(distances)\n      nearest_workshop_pos = workshop_positions[nearest_workshop_idx]\n\n      # Compute actions to move the agent to the nearest workshop\n      target_dir = None\n      while not np.array_equal(agent_pos, nearest_workshop_pos):\n        delta = nearest_workshop_pos - agent_pos\n\n        if delta[0] > 0:\n          actions.append(env.world.N_ACTIONS - 1)  # RIGHT\n          target_dir = env.world.N_ACTIONS - 1\n        elif delta[0] < 0:\n          actions.append(env.world.N_ACTIONS - 2)  # LEFT\n          target_dir = env.world.N_ACTIONS - 2\n        elif delta[1] > 0:\n          actions.append(env.world.N_ACTIONS - 3)  # DOWN\n          target_dir = env.world.N_ACTIONS - 3\n        elif delta[1] < 0:\n          actions.append(env.world.N_ACTIONS - 4)  # UP\n          target_dir = env.world.N_ACTIONS - 4\n\n        agent_pos += np.array([delta[0] > 0, delta[1] > 0]) * (np.abs(delta) != 0)\n\n      # Set the direction to face the workshop\n      if target_dir is not None:\n        actions.append(target_dir)\n      \n      # Craft the item at the workshop by performing the USE action\n      actions.append(env.world.N_ACTIONS - 5)  # USE\n\n    else:\n      raise ValueError(\"No workshop of the required type found in the environment.\")\n\n  else:\n    raise ValueError(\"Recipe for the desired item does not specify a workshop.\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:07:22.217980", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Accessing the recipe details from the cookbook\n  recipe = env.world.cookbook.recipes[item_idx]\n  \n  # Extract workshop requirement and remove it from the recipe ingredients\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Move to a nearby cell that contains the required workshop (if not already there)\n  current_pos = env._current_state.pos\n\n  # Find all cells with the desired workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found in the grid.\")\n\n  # Choose the closest workshop to move towards\n  min_distance = float('inf')\n  closest_workshop_pos = None\n  for pos in workshop_positions:\n      distance = np.linalg.norm(np.array(current_pos) - np.array(pos))\n      if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = tuple(pos)\n\n  # Calculate the relative direction to move towards the closest workshop\n  # Assuming the agent can move in UP, DOWN, LEFT, RIGHT directions\n  dx = closest_workshop_pos[0] - current_pos[0]\n  dy = closest_workshop_pos[1] - current_pos[1]\n\n  while (dx != 0) or (dy != 0):\n      if dx > 0:\n          actions.append(craft.RIGHT)\n          dx -= 1\n      elif dx < 0:\n          actions.append(craft.LEFT)\n          dx += 1\n\n      if dy > 0:\n          actions.append(craft.DOWN)\n          dy -= 1\n      elif dy < 0:\n          actions.append(craft.UP)\n          dy += 1\n\n  # Once the agent is at the workshop, perform the USE action to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:07:23.188957", "function_name": "craft", "function_body": "  # Get the cookbook and required recipe\n  cookbook = env.world.cookbook\n\n  # Find the index for the target item\n  target_index = cookbook.index[item]\n\n  # Fetch the recipe for the target item\n  recipe = cookbook.recipes[target_index]\n\n  # Determine the workshop required to craft this item\n  workshop_name = list(recipe.keys())[list(recipe.values()).index('_at')]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Get the current position and direction of the agent\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Find positions of all workshops in the grid\n  workshop_positions = []\n  for y in range(env.world.scenario.init_grid.shape[0]):\n      for x in range(env.world.scenario.init_grid.shape[1]):\n          if np.any(env.world.scenario.init_grid[y, x] == workshop_index):\n              workshop_positions.append((x, y))\n\n  # Filter the workshops to only include the required one\n  target_workshop_position = None\n  for pos in workshop_positions:\n      if env._current_state.grid[pos[1], pos[0], workshop_index] > 0:\n          target_workshop_position = pos\n          break\n\n  if target_workshop_position is None:\n      raise ValueError(\"Target workshop not found\")\n\n  # Calculate the path to the required workshop\n  actions_to_reach_workshop = []\n  while current_pos != target_workshop_position:\n      delta_x = target_workshop_position[0] - current_pos[0]\n      delta_y = target_workshop_position[1] - current_pos[1]\n\n      if delta_x > 0 and env._current_state.grid[current_pos[1], current_pos[0] + 1, workshop_index] == 0:\n          actions_to_reach_workshop.append(env.world.n_actions) # RIGHT\n      elif delta_x < 0 and env._current_state.grid[current_pos[1], current_pos[0] - 1, workshop_index] == 0:\n          actions_to_reach_workshop.append((env.world.n_actions + 2) % 4) # LEFT\n      elif delta_y > 0 and env._current_state.grid[current_pos[1] + 1, current_pos[0], workshop_index] == 0:\n          actions_to_reach_workshop.append((env.world.n_actions + 3) % 4) # DOWN\n      elif delta_y < 0 and env._current_state.grid[current_pos[1] - 1, current_pos[0], workshop_index] == 0:\n          actions_to_reach_workshop.append(env.world.n_actions + 1) % 4 # UP\n\n      # Move the agent to the next position\n      action = actions_to_reach_workshop[-1]\n      if action == env.world.n_actions: # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif action == (env.world.n_actions + 2) % 4: # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif action == (env.world.n_actions + 3) % 4: # DOWN\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif action == env.world.n_actions + 1: # UP\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Append the USE action to craft the item at the workshop\n  actions_to_reach_workshop.append(env.world.n_actions + 4) # USE\n\n  return actions_to_reach_workshop", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:08:47.364924", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n                \n        # Calculate the relative direction from the agent's position to the target workshop position\n        rel_x, rel_y = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n        \n        actions_to_take = []\n\n        while (rel_x != 0) or (rel_y != 0):\n            # Move in the direction of the workshop\n            if rel_x > 0:\n                actions_to_take.append(3)\n                rel_x -= 1\n            elif rel_x < 0:\n                actions_to_take.append(2)\n                rel_x += 1\n\n            if rel_y > 0:\n                actions_to_take.append(1)\n                rel_y -= 1\n            elif rel_y < 0:\n                actions_to_take.append(0)\n                rel_y += 1\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T21:08:48.435412", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n                \n        # Calculate the relative direction from the agent's position to the target workshop position\n        rel_x, rel_y = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n        \n        actions_to_take = []\n\n        if rel_x > 0:\n            # Move RIGHT\n            actions_to_take.extend([3] * rel_x)\n        elif rel_x < 0:\n            # Move LEFT\n            actions_to_take.extend([2] * abs(rel_x))\n            \n        if rel_y > 0:\n            # Move DOWN\n            actions_to_take.extend([1] * rel_y)\n        elif rel_y < 0:\n            # Move UP\n            actions_to_take.extend([0] * abs(rel_y))\n\n        # Check if the agent is already facing the correct direction (assuming direction values: 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT)\n        current_dir = env._current_state.dir\n        target_dir = None\n\n        if rel_x > 0:\n            target_dir = 3  # RIGHT\n        elif rel_x < 0:\n            target_dir = 2  # LEFT\n        elif rel_y > 0:\n            target_dir = 1  # DOWN\n        else:\n            target_dir = 0  # UP\n        \n        if current_dir != target_dir:\n            # Calculate the number of turns needed to reach the target direction\n            turn_steps = (target_dir - current_dir) % 4\n            actions_to_take.extend([turn_steps] * abs(turn_steps))\n            \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T21:09:57.972644", "function_name": "craft", "function_body": "  # Fetching the cookbook and required recipe\n  cookbook = env.world.cookbook\n\n  # Getting the index for the target item\n  target_item_index = cookbook.index[item]\n\n  # Retrieving the recipe for the target item\n  recipe = cookbook.recipes[target_item_index]\n\n  # Extracting the workshop from the recipe\n  workshop_name = recipe.pop(\"_at\")\n\n  # Fetching the corresponding index of the workshop\n  workshop_index = cookbook.index[workshop_name]\n\n  actions = []\n\n  # Find a position next to the specified workshop\n  target_workshop_position = None\n  grid_shape = env._current_state.grid.shape[:2]\n  for y in range(grid_shape[0]):\n    for x in range(grid_shape[1]):\n      if env._current_state.grid[y, x, workshop_index] > 0:\n        # Check the 3x3 neighborhood to see if we can find a free space\n        for dy in [-1, 0, 1]:\n          for dx in [-1, 0, 1]:\n            ny, nx = y + dy, x + dx\n            if 0 <= ny < grid_shape[0] and 0 <= nx < grid_shape[1]:\n              if all(env._current_state.grid[ny, nx, non_grabbable_index] == 0 for non_grabbable_index in env.world.non_grabbable_indices):\n                target_workshop_position = (nx, ny)\n                break\n          if target_workshop_position:\n            break\n      if target_workshop_position:\n        break\n\n  # Calculate the steps to reach the target workshop position\n  start_pos = env._current_state.pos\n  path_to_workshop = astar(start_pos, target_workshop_position, grid_shape, env.world.non_grabbable_indices, env._current_state.grid)\n  \n  for step in path_to_workshop:\n    direction = calculate_direction(start_pos, step)\n    actions.append(direction)  # Add the direction action to the list\n    start_pos = step  # Update the starting position for the next step\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # Assuming 4 is the index of the USE action (craft)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:09:58.929016", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop that is required for crafting the item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshops found for item: {item}\")\n    \n  # Choose the closest workshop (we can use Manhattan distance to find the closest one)\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1, ord=1) # L1 norm is Manhattan distance\n  closest_workshop_position = workshop_positions[np.argmin(distances)]\n  \n  # Calculate actions to move towards the closest workshop\n  while not np.array_equal(env._current_state.pos, closest_workshop_position):\n    direction = env._current_state.dir\n    new_pos = np.array(env._current_state.pos)\n    \n    if current_pos[0] < closest_workshop_position[0]:\n      action = craft.RIGHT if direction == 3 else craft.DOWN\n    elif current_pos[0] > closest_workshop_position[0]:\n      action = craft.LEFT if direction == 2 else craft.UP\n    elif current_pos[1] < closest_workshop_position[1]:\n      action = craft.DOWN if direction == 0 else craft.RIGHT\n    else:\n      action = craft.LEFT if direction == 3 else craft.UP\n    \n    actions.append(action)\n    \n    # Execute the action to update the state (this is just for calculating the path, actual execution will be handled in the main loop)\n    reward, done, observations = env.step(action)\n    \n    current_pos[0] += 1 if action == craft.RIGHT and not env._current_state.next_to(env.world.water_index) else 0\n    current_pos[0] -= 1 if action == craft.LEFT and not env._current_state.next_to(env.world.water_index) else 0\n    current_pos[1] += 1 if action == craft.DOWN and not env._current_state.next_to(env.world.water_index) else 0\n    current_pos[1] -= 1 if action == craft.UP and not env._current_state.next_to(env.world.water_index) else 0\n    \n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:10:44.788254", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop where this item must be crafted\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found on the map.\")\n      \n  # Choose the first available workshop position (closest one can be calculated here if needed)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Get current agent's position\n  agent_position = env._current_state.pos\n\n  # Calculate the movement actions to move the agent to the chosen workshop\n  dx = target_workshop_pos[0] - agent_position[0]\n  dy = target_workshop_pos[1] - agent_position[1]\n\n  if dy < 0:\n      actions.extend([craft.DOWN] * abs(dy))\n  elif dy > 0:\n      actions.extend([craft.UP] * dy)\n\n  if dx < 0:\n      actions.extend([craft.RIGHT] * abs(dx))\n  elif dx > 0:\n      actions.extend([craft.LEFT] * dx)\n      \n  # Append the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:10:45.808851", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  goal_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  # Extract the workshop where the item must be crafted from the recipe\n  workshop_name = list(recipe.keys())[-1]  # Assuming \"_at\" is always last in the dict\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find positions of all workshops on the grid that match the required workshop index\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshop for {item} found on the map.\")\n  \n  # For simplicity, choose the first available workshop to craft the item\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Determine the direction to move towards the target workshop position from current agent's position\n  current_pos = env._current_state.pos\n  \n  # Calculate the relative position (dx, dy) between current and target positions\n  dx, dy = target_workshop_pos[1] - current_pos[1], target_workshop_pos[0] - current_pos[0]\n  \n  actions = []\n  \n  # Generate movements to face and reach the workshop\n  if dx > 0:\n      actions.extend([env.world.N_RIGHT] * abs(dx))\n  elif dx < 0:\n      actions.extend([env.world.N_LEFT] * abs(dx))\n  \n  if dy > 0:\n      actions.extend([env.world.N_DOWN] * abs(dy))\n  elif dy < 0:\n      actions.extend([env.world.N_UP] * abs(dy))\n  \n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(env.world.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:11:32.765448", "function_name": "craft", "function_body": "  # Get the index of the target item\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate relative positions and determine movement actions needed to reach the target workshop\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n  \n  # Move in x direction (delta_x)\n  if delta_x > 0:\n      actions.extend([RIGHT]*abs(delta_x))  # move right\n  else:\n      actions.extend([LEFT]*abs(delta_x))   # move left\n  \n  # Adjust direction for movement in y direction after moving horizontally\n  if delta_y < 0:\n      actions.append(UP)  # change direction to up\n  elif delta_y > 0:\n      actions.append(DOWN)  # change direction to down\n  \n  # Move in y direction (delta_y)\n  if delta_y > 0:\n      actions.extend([DOWN]*abs(delta_y))  # move down\n  else:\n      actions.extend([UP]*abs(delta_y))    # move up\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T21:11:33.787167", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the item\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop\n  grid = env._current_state.grid\n  workshops = np.argwhere(grid[:, :, workshop_index] == 1)\n  distances = [np.linalg.norm(np.array(env._current_state.pos) - np.array(workshop)) for workshop in workshops]\n  nearest_workshop = workshops[np.argmin(distances)]\n\n  # Calculate the direction to move towards the workshop\n  dx = nearest_workshop[0] - env._current_state.pos[0]\n  dy = nearest_workshop[1] - env._current_state.pos[1]\n\n  if dx > 0:\n    actions.append(env.world.N_ACTIONS.index('DOWN'))\n  elif dx < 0:\n    actions.append(env.world.N_ACTIONS.index('UP'))\n\n  if dy > 0:\n    actions.append(env.world.N_ACTIONS.index('RIGHT'))\n  elif dy < 0:\n    actions.append(env.world.N_ACTIONS.index('LEFT'))\n\n  # Once at the workshop, perform the USE action\n  actions.append(env.world.N_ACTIONS.index('USE'))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:12:39.691052", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  # Find the required workshop index from the recipe\n  workshop_index = env.world.cookbook.index[recipe[\"_at\"]]\n  \n  # Get all positions of the workshops in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item: {item}\")\n  \n  # Choose a nearby workshop (first one for simplicity, could be optimized)\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Calculate the difference in position\n  pos_diff_x = target_workshop_position[0] - env._current_state.pos[0]\n  pos_diff_y = target_workshop_position[1] - env._current_state.pos[1]\n  \n  # Move to the workshop\n  if pos_diff_x < 0:\n    actions.extend([env.world.N_ACTIONS.DOWN] * abs(pos_diff_x))\n  elif pos_diff_x > 0:\n    actions.extend([env.world.N_ACTIONS.UP] * pos_diff_x)\n  \n  if pos_diff_y < 0:\n    actions.extend([env.world.N_ACTIONS.LEFT] * abs(pos_diff_y))\n  elif pos_diff_y > 0:\n    actions.extend([env.world.N_ACTIONS.RIGHT] * pos_diff_y)\n  \n  # Craft the item at the workshop\n  actions.append(env.world.N_ACTIONS.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:12:40.653330", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Identify the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Find a position next to the workshop\n  current_pos = env._current_state.pos\n  target_workshop_positions = []\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      candidate_pos = (current_pos[0] + dx, current_pos[1] + dy)\n      if env._current_state.next_to(workshop_index):\n          target_workshop_positions.append(candidate_pos)\n\n  # If no valid position found, move around the workshop to find one\n  if not target_workshop_positions:\n      for dx in range(-3, 4):\n          for dy in range(-3, 4):\n              candidate_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              env._current_state.grid[candidate_pos]\n              if env._current_state.next_to(workshop_index):\n                  target_workshop_positions.append(candidate_pos)\n\n  # If still no valid position found, raise an error\n  if not target_workshop_positions:\n      raise ValueError(\"No valid position next to the workshop\")\n\n  # Choose a random valid position next to the workshop\n  target_pos = target_workshop_positions[0] # We can choose any or use some strategy here\n\n  # Calculate the actions needed to move from current position to target position\n  path_actions = calculate_path(env._current_state.pos, target_pos)\n\n  # Add the USE action to craft the item at the workshop\n  path_actions.append(craft.ACTION_USE)\n\n  return path_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:14:06.281805", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate relative positions and determine movement actions needed to reach the target workshop\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n  \n  if delta_x > 0:\n      actions.extend([RIGHT]*abs(delta_x))  # move right\n  else:\n      actions.extend([LEFT]*abs(delta_x))   # move left\n  \n  if delta_y < 0:\n      actions.append(UP)  # change direction to up\n  elif delta_y > 0:\n      actions.append(DOWN)  # change direction to down\n\n  if delta_y > 0:\n      actions.extend([DOWN]*abs(delta_y))  # move down\n  else:\n      actions.extend([UP]*abs(delta_y))    # move up\n  \n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T21:14:07.344842", "function_name": "craft", "function_body": "  def move_towards(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      if delta_x > 0:\n          actions.extend([RIGHT]*abs(delta_x))  # move right\n      else:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n\n      if delta_y < 0:\n          actions.append(UP)  # change direction to up\n      elif delta_y > 0:\n          actions.append(DOWN)  # change direction to down\n\n      if delta_y > 0:\n          actions.extend([DOWN]*abs(delta_y))  # move down\n      else:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(move_towards(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T21:16:35.244168", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  def get_workshop_positions(grid, workshop_index):\n    return np.argwhere(grid[:, :, workshop_index] == 1)\n\n  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  recipe = cookbook.recipes[output_index]\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n  grid = env._current_state.grid\n\n  workshop_positions = get_workshop_positions(grid, workshop_index)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  path = a_star(current_pos, target_pos, grid)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      (0, -1): env.action_specs()[\"DOWN\"],\n      (0, 1): env.action_specs()[\"UP\"],\n      (-1, 0): env.action_specs()[\"LEFT\"],\n      (1, 0): env.action_specs()[\"RIGHT\"]\n  }\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n    actions.append(action_map[(delta_x, delta_y)])\n\n  actions.append(env.action_specs()[\"USE\"])\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:16:36.333022", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  path = a_star(current_pos, target_pos, grid)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:17:33.163361", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n  \n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.workshop_indices[env.world.cookbook.index[workshop_name]]\n\n  # Actions to move towards the specified workshop\n  actions_to_workshop = move_towards(env, workshop_index)\n  \n  # Action to use the workshop for crafting\n  actions_to_craft = [craft.CRAFT_FUNC(workshop_name)]\n\n  return actions_to_workshop + actions_to_craft", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:17:34.217688", "function_name": "craft", "function_body": "  # Step 1: Determine the workshop where the item should be crafted\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          actions.append(dir_map['DOWN'])\n      elif dx < 0:\n          actions.append(dir_map['UP'])\n      else:\n          if dy > 0:\n              actions.append(dir_map['RIGHT'])\n          elif dy < 0:\n              actions.append(dir_map['LEFT'])\n      \n      # Simulate the move to update current_pos\n      new_dir = actions[-1]\n      if new_dir == dir_map['DOWN']:\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif new_dir == dir_map['UP']:\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif new_dir == dir_map['RIGHT']:\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif new_dir == dir_map['LEFT']:\n          current_pos = (current_pos[0], current_pos[1] - 1)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T21:19:14.384022", "function_name": "craft", "function_body": "  def move_towards(target_pos):\n      current_pos = env._current_state.pos\n      rel_x, rel_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n      \n      actions_to_take = []\n\n      if rel_x > 0:\n          # Move RIGHT\n          actions_to_take.extend([3] * rel_x)\n      elif rel_x < 0:\n          # Move LEFT\n          actions_to_take.extend([2] * abs(rel_x))\n          \n      if rel_y > 0:\n          # Move DOWN\n          actions_to_take.extend([1] * rel_y)\n      elif rel_y < 0:\n          # Move UP\n          actions_to_take.extend([0] * abs(rel_y))\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Move towards the target workshop position\n        actions_to_take = move_towards(target_workshop_pos)\n                \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T21:19:15.474722", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T21:21:40.233165", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the closest workshop\n  current_pos = env._current_state.pos\n  target_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n\n  # Calculate the path to the target position using A* algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - path[i][0]\n      delta_y = next_pos[1] - path[i][1]\n\n      if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif delta_x > 0:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n      else:\n          actions.append(env.action_specs()[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:21:41.211192", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  # Calculate the path to the target position using A* algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_values[current] + heuristic(current, neighbor)\n          if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n            came_from[neighbor] = current\n            g_values[neighbor] = tentative_g_score\n            f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n            if neighbor not in open_set:\n              open_set.add(neighbor)\n\n    return []\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n      next_pos = path[i + 1]\n      delta_x = next_pos[0] - path[i][0]\n      delta_y = next_pos[1] - path[i][1]\n\n      # Adjust the direction to face the next position\n      if delta_x < 0:\n          actions.append(env.action_specs()[\"LEFT\"])\n          current_dir = env.world.index[\"LEFT\"]\n      elif delta_x > 0:\n          actions.append(env.action_specs()[\"RIGHT\"])\n          current_dir = env.world.index[\"RIGHT\"]\n      elif delta_y < 0:\n          actions.append(env.action_specs()[\"DOWN\"])\n          current_dir = env.world.index[\"DOWN\"]\n      else:\n          actions.append(env.action_specs()[\"UP\"])\n          current_dir = env.world.index[\"UP\"]\n\n      # Move to the next position\n      actions.append(env.action_specs()[env.world.index.inverse[current_dir]])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:23:08.512730", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction is not None:\n          actions.append(dir_map[direction])\n          # Simulate the move to update current_pos\n          if direction == 'DOWN':\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif direction == 'UP':\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          elif direction == 'RIGHT':\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif direction == 'LEFT':\n              current_pos = (current_pos[0], current_pos[1] - 1)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T21:23:09.577161", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0 and abs(dx) >= abs(dy):\n          actions.append(dir_map['DOWN'])\n      elif dx < 0 and abs(dx) >= abs(dy):\n          actions.append(dir_map['UP'])\n      else:\n          if dy > 0:\n              actions.append(dir_map['RIGHT'])\n          elif dy < 0:\n              actions.append(dir_map['LEFT'])\n\n      # Simulate the move to update current_pos\n      new_dir = actions[-1]\n      if new_dir == dir_map['DOWN']:\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif new_dir == dir_map['UP']:\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif new_dir == dir_map['RIGHT']:\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif new_dir == dir_map['LEFT']:\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T21:25:16.110335", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n  \n  # Determine which workshop is required to craft this item\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the list of workshops in the environment\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the correct workshop\n  target_workshop_position = None\n  grid = env._current_state.grid\n      \n  # Search for the workshop's position on the grid\n  positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(positions) == 0:\n    raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n      \n  target_workshop_position = tuple(positions[0])\n    \n  # Calculate the necessary actions to move the agent to the target workshop\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Use A* algorithm for pathfinding to find the shortest path to the target position\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n  \n  def get_neighbors(pos):\n    neighbors = []\n    x, y = pos\n    if x > 0:\n      neighbors.append((x-1, y))\n    if x < grid.shape[0]-1:\n      neighbors.append((x+1, y))\n    if y > 0:\n      neighbors.append((x, y-1))\n    if y < grid.shape[1]-1:\n      neighbors.append((x, y+1))\n    return neighbors\n  \n  def a_star(start, goal):\n    open_set = []\n    collections.heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n    \n    while open_set:\n      current = collections.heapq.heappop(open_set)[1]\n      \n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        path.reverse()\n        return path\n      \n      for neighbor in get_neighbors(current):\n        tentative_g_score = g_score[current] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          collections.heapq.heappush(open_set, (f_score[neighbor], neighbor))\n    \n    return None\n  \n  path_to_workshop = a_star(current_pos, target_workshop_position)\n  \n  if not path_to_workshop:\n    raise ValueError(\"No valid path to the workshop found.\")\n  \n  actions_to_take = []\n  \n  # Convert the path into a list of movement actions\n  for next_pos in path_to_workshop[1:]:\n    delta_x = next_pos[0] - current_pos[0]\n    delta_y = next_pos[1] - current_pos[1]\n    \n    if delta_x > 0:\n      actions_to_take.append(2)  # RIGHT\n    elif delta_x < 0:\n      actions_to_take.append(0)  # LEFT\n    \n    if delta_y > 0:\n      actions_to_take.append(3)  # DOWN\n    elif delta_y < 0:\n      actions_to_take.append(1)  # UP\n    \n    current_pos = next_pos\n  \n  # Add action to face the correct direction (if needed)\n  final_delta_x = target_workshop_position[0] - current_pos[0]\n  final_delta_y = target_workshop_position[1] - current_pos[1]\n  \n  if final_delta_x == 0:\n    if final_delta_y > 0:\n      target_dir = 3  # DOWN\n    else:\n      target_dir = 1  # UP\n  elif final_delta_y == 0:\n    if final_delta_x > 0:\n      target_dir = 2  # RIGHT\n    else:\n      target_dir = 0  # LEFT\n  \n  if current_dir != target_dir and target_dir is not None:\n    actions_to_take.append(target_dir)\n  \n  # Add USE action to craft the item at the workshop\n  actions_to_take.append(4)  # USE\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:25:17.105237", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n  \n  # Determine which workshop is required to craft this item\n  workshop_name = recipe['_at']\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Get the list of workshops in the environment\n  workshop_indices = env.world.workshop_indices\n  \n  # Find the position of the correct workshop\n  target_workshop_position = None\n  grid = env._current_state.grid\n  \n  for workshop_idx in workshop_indices:\n    if workshop_idx == workshop_index:\n      positions = np.argwhere(grid[:, :, workshop_idx] > 0)\n      \n      if len(positions) == 0:\n        raise ValueError(f\"Workshop {workshop_name} not found in the environment.\")\n      \n      target_workshop_position = tuple(positions[0])\n      break\n  \n  # If no valid workshop position is found, raise an error\n  if target_workshop_position is None:\n    raise ValueError(\"No valid workshop position found for the given recipe.\")\n\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  # Calculate the necessary actions to move and face the target workshop\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n\n  actions_to_take = []\n\n  # Move towards the workshop position\n  while delta_x != 0 or delta_y != 0:\n    if abs(delta_x) > abs(delta_y):\n      move_x = np.sign(delta_x)\n      actions_to_take.append(move_x + 2 * (move_x < 0))  # RIGHT (2) or LEFT (0)\n    else:\n      move_y = np.sign(delta_y)\n      actions_to_take.append(1 - move_y + 2 * (move_y > 0))  # DOWN (3) or UP (1)\n\n    current_pos = (current_pos[0] + move_x, current_pos[1] + move_y)\n    delta_x = target_workshop_position[0] - current_pos[0]\n    delta_y = target_workshop_position[1] - current_pos[1]\n\n  # Determine the direction to face for crafting\n  if delta_x == 0:\n    target_dir = 3 if delta_y > 0 else 1  # DOWN or UP\n  elif delta_y == 0:\n    target_dir = 2 if delta_x > 0 else 0  # RIGHT or LEFT\n\n  # Add actions to rotate the agent to face the correct direction\n  while current_dir != target_dir:\n    # Calculate the difference in direction and determine turn action\n    dir_diff = (target_dir - current_dir) % 4\n    if dir_diff == 1:\n      actions_to_take.append(5)  # TURN_RIGHT\n    elif dir_diff == 2:\n      actions_to_take.extend([5, 5])  # TURN_RIGHT twice or TURN_AROUND\n    elif dir_diff == 3:\n      actions_to_take.append(6)  # TURN_LEFT\n\n    current_dir = (current_dir + dir_diff) % 4\n\n  # Add USE action to craft the item at the workshop\n  actions_to_take.append(4)  # USE\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:26:36.103196", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos, current_dir = env._current_state.pos, env._current_state.dir\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  inverse_dir_map = {v: k for k, v in dir_map.items()}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          new_dir = 'DOWN'\n      elif dx < 0:\n          new_dir = 'UP'\n      else:\n          if dy > 0:\n              new_dir = 'RIGHT'\n          elif dy < 0:\n              new_dir = 'LEFT'\n      \n      # Check if the current direction is not the new direction\n      if inverse_dir_map[current_dir] != new_dir:\n          actions.append(dir_map[new_dir])\n          current_dir = dir_map[new_dir]\n      else:\n          actions.append(4)  # Assuming USE action is represented by index 4\n      \n      # Simulate the move to update current_pos\n      if new_dir == 'DOWN':\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif new_dir == 'UP':\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif new_dir == 'RIGHT':\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif new_dir == 'LEFT':\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T21:26:37.180321", "function_name": "craft", "function_body": "  def bfs(start, goal):\n    queue = collections.deque([(start, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      if (x, y) == goal:\n        return path\n      \n      if (x, y) in visited:\n        continue\n      visited.add((x, y))\n      \n      for dx, dy, action in [(0, 1, 2), (0, -1, 3), (-1, 0, 0), (1, 0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append(((nx, ny), path + [action]))\n  \n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops using BFS (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  \n  actions = bfs(current_pos, target_pos)\n  \n  if actions is None:\n    raise ValueError(f\"No path found from {current_pos} to {target_pos}\")\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T21:27:55.687199", "function_name": "craft", "function_body": "  def move_towards(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Move horizontally\n      if delta_x > 0:\n          actions.extend([RIGHT]*delta_x)\n      elif delta_x < 0:\n          actions.extend([LEFT]*-delta_x)\n\n      # Change direction to vertical movement if needed\n      if delta_y > 0 and env._current_state.dir not in [UP, DOWN]:\n          actions.append(DOWN)\n      elif delta_y < 0 and env._current_state.dir not in [UP, DOWN]:\n          actions.append(UP)\n\n      # Move vertically\n      if delta_y > 0:\n          actions.extend([DOWN]*delta_y)\n      elif delta_y < 0:\n          actions.extend([UP]*-delta_y)\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(move_towards(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T21:27:56.743728", "function_name": "craft", "function_body": "  def move_towards(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Move along the x-axis\n      if delta_x > 0:\n          actions.extend([RIGHT]*delta_x)  # move right\n      elif delta_x < 0:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      # Align direction for y-axis movement\n      if delta_y > 0 and env._current_state.dir != DOWN:\n          actions.append(DOWN)  # change direction to down\n      elif delta_y < 0 and env._current_state.dir != UP:\n          actions.append(UP)  # change direction to up\n      \n      # Move along the y-axis\n      if delta_y > 0:\n          actions.extend([DOWN]*delta_y)  # move down\n      elif delta_y < 0:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(move_towards(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T21:29:56.987606", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:29:58.119047", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the closest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  # Calculate the path to the target position using A* algorithm\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  current_dir = env._current_state.dir\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:31:06.438183", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  def get_workshop_positions(workshop_index, grid):\n      \"\"\"Get all positions of the workshop in the grid.\"\"\"\n      return np.argwhere(grid[:, :, workshop_index] > 0)\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = get_workshop_positions(workshop_index, env._current_state.grid)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n  target_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T21:31:07.491958", "function_name": "craft", "function_body": "  def get_next_action(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found in the environment.\")\n\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  current_pos = env._current_state.pos\n\n  actions_to_reach_workshop = get_next_action(current_pos, target_workshop_pos)\n\n  # Check if we are already next to the workshop\n  if not env._current_state.next_to(workshop_index):\n      actions_to_reach_workshop.append(4)  # USE\n\n  return actions_to_reach_workshop", "island_id": 1, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:32:08.845347", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          actions.append(dir_map['DOWN'])\n      elif dx < 0:\n          actions.append(dir_map['UP'])\n      else:\n          if dy > 0:\n              actions.append(dir_map['RIGHT'])\n          elif dy < 0:\n              actions.append(dir_map['LEFT'])\n      \n      # Simulate the move to update current_pos\n      new_dir = actions[-1]\n      if new_dir == dir_map['DOWN']:\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif new_dir == dir_map['UP']:\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif new_dir == dir_map['RIGHT']:\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif new_dir == dir_map['LEFT']:\n          current_pos = (current_pos[0], current_pos[1] - 1)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T21:32:09.815518", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Choose the closest workshop to move to\n  current_pos = env._current_state.pos\n  target_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  \n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while tuple(current_pos) != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(dir_map['DOWN'])\n              current_pos[0] += 1\n          else:\n              actions.append(dir_map['UP'])\n              current_pos[0] -= 1\n      else:\n          if dy > 0:\n              actions.append(dir_map['RIGHT'])\n              current_pos[1] += 1\n          else:\n              actions.append(dir_map['LEFT'])\n              current_pos[1] -= 1\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:33:18.174255", "function_name": "craft", "function_body": "  def get_next_move(current_pos, target_pos):\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n\n    if abs(delta_x) > abs(delta_y):\n        return RIGHT if delta_x > 0 else LEFT\n    else:\n        return DOWN if delta_y > 0 else UP\n\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n\n  actions = []\n  \n  while current_pos != target_workshop_position:\n      next_move = get_next_move(current_pos, target_workshop_position)\n      if next_move == RIGHT and current_dir != RIGHT:\n          actions.append(RIGHT)\n          current_dir = RIGHT\n      elif next_move == LEFT and current_dir != LEFT:\n          actions.append(LEFT)\n          current_dir = LEFT\n      elif next_move == DOWN and current_dir != DOWN:\n          actions.append(DOWN)\n          current_dir = DOWN\n      elif next_move == UP and current_dir != UP:\n          actions.append(UP)\n          current_dir = UP\n      \n      # Move in the correct direction\n      if (next_move == RIGHT and current_pos[0] < target_workshop_position[0]) or \\\n         (next_move == LEFT and current_pos[0] > target_workshop_position[0]):\n          actions.append(RIGHT if next_move == RIGHT else LEFT)\n          current_pos = (current_pos[0] + 1, current_pos[1]) if next_move == RIGHT else (current_pos[0] - 1, current_pos[1])\n      elif (next_move == DOWN and current_pos[1] < target_workshop_position[1]) or \\\n           (next_move == UP and current_pos[1] > target_workshop_position[1]):\n          actions.append(DOWN if next_move == DOWN else UP)\n          current_pos = (current_pos[0], current_pos[1] + 1) if next_move == DOWN else (current_pos[0], current_pos[1] - 1)\n\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T21:33:19.304892", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos, current_pos, current_dir):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      if delta_x > 0:\n          actions.extend([RIGHT]*abs(delta_x))  # move right\n      else:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      if delta_y < 0:\n          actions.append(UP)  # change direction to up\n      elif delta_y > 0:\n          actions.append(DOWN)  # change direction to down\n\n      if delta_y > 0:\n          actions.extend([DOWN]*abs(delta_y))  # move down\n      else:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(target_workshop_position, current_pos, current_dir))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T21:34:20.222018", "function_name": "craft", "function_body": "  # Get the current state\n  state = env._current_state\n\n  # Get cookbook and index\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  \n  # Find the index of the target item\n  item_index = index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = cookbook.recipes.get(item_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for item: {item}\")\n  \n  # Extract the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  workshop_index = index[workshop_name]\n  \n  # Get the current position and direction of the agent\n  pos = state.pos\n  dir_ = state.dir\n  \n  # Find all positions of the required workshop in the grid\n  grid = state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshops found for item: {item}\")\n  \n  # Choose a nearby workshop position (for simplicity, choose the first one)\n  target_pos = tuple(workshop_positions[0])\n  \n  # Calculate the relative direction from current position to target position\n  delta_x = target_pos[0] - pos[0]\n  delta_y = target_pos[1] - pos[1]\n  \n  actions = []\n  \n  # Move in x-direction\n  if delta_x > 0:\n      actions.extend([craft.RIGHT for _ in range(delta_x)])\n  elif delta_x < 0:\n      actions.extend([craft.LEFT for _ in range(-delta_x)])\n  \n  # Move in y-direction\n  if delta_y > 0:\n      actions.extend([craft.DOWN for _ in range(delta_y)])\n  elif delta_y < 0:\n      actions.extend([craft.UP for _ in range(-delta_y)])\n  \n  # Finally, perform the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:34:21.232839", "function_name": "craft", "function_body": "  actions = []\n  world = env.world\n  scenario = env.scenario\n  current_state = env._current_state\n\n  # Get the index of the item to craft\n  i_item = world.cookbook.index[item]\n\n  # Find the workshop for crafting this item\n  recipe = world.cookbook.recipes[i_item]\n  workshop_name = recipe['_at']\n  i_workshop = world.world.workshop_indices[world.world.cookbook.index[workshop_name]]\n\n  # Get the position of the agent and the target workshop\n  pos_agent = current_state.pos\n\n  # Find the path to the nearest workshop (assuming BFS for simplicity)\n  grid = current_state.grid\n  width, height, _ = grid.shape\n  queue = collections.deque([(pos_agent[0], pos_agent[1], [])])\n  visited = set()\n  target_workshop_pos = None\n\n  while queue:\n    x, y, path = queue.popleft()\n    if (x, y) in visited:\n        continue\n    visited.add((x, y))\n    \n    # Check if we reached a workshop\n    if grid[x, y, i_workshop] > 0:\n        target_workshop_pos = (x, y)\n        actions.extend([env.world.index[collections.Counter(path).most_common(1)[0][0]]] * len(path))  # Assuming the most common direction in path is used to reach the workshop\n        break\n    \n    # Explore neighbors\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < width and 0 <= ny < height and grid[nx, ny, :].sum() == 0:  # Only move to empty cells\n            queue.append((nx, ny, path + [env.world.index[direction(dx, dy)]]))\n\n  # If no workshop found or already at the workshop\n  if target_workshop_pos is None or pos_agent == target_workshop_pos:\n      actions.append(env.world.index['USE'])\n  else:\n      # Move to the target workshop position\n      dx = target_workshop_pos[0] - pos_agent[0]\n      dy = target_workshop_pos[1] - pos_agent[1]\n\n      if dx < 0:\n          actions.extend([env.world.index['UP']] * abs(dx))\n      elif dx > 0:\n          actions.extend([env.world.index['DOWN']] * abs(dx))\n\n      if dy < 0:\n          actions.extend([env.world.index['LEFT']] * abs(dy))\n      elif dy > 0:\n          actions.extend([env.world.index['RIGHT']] * abs(dy))\n\n      # Use the workshop\n      actions.append(env.world.index['USE'])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:40:09.963121", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n\n  # Extract the workshop where the item must be crafted (the \"_at\" key in the recipe)\n  workshop_name = recipe.get(\"_key\", \"\").split(\" \")[-1]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if workshop_positions.size == 0:\n    raise ValueError(f\"No {workshop_name} found on the grid to craft {item}.\")\n\n  # Choose the first available workshop position (assuming there's at least one)\n  target_workshop_position = tuple(workshop_positions[0])\n\n  # Calculate the direction vector from the current agent position to the workshop\n  current_pos = env._current_state.pos\n  direction_vector = (\n      target_workshop_position[0] - current_pos[0],\n      target_workshop_position[1] - current_pos[1]\n  )\n\n  # Determine the sequence of actions required to move towards the workshop\n  while not (env._current_state.pos == target_workshop_position):\n    current_pos = env._current_state.pos\n\n    if direction_vector[1] > 0:\n      actions.append(3)  # RIGHT\n      direction_vector = (direction_vector[0], direction_vector[1] - 1)\n    elif direction_vector[1] < 0:\n      actions.append(2)  # LEFT\n      direction_vector = (direction_vector[0], direction_vector[1] + 1)\n\n    if direction_vector[0] > 0:\n      actions.append(1)  # UP\n      direction_vector = (direction_vector[0] - 1, direction_vector[1])\n    elif direction_vector[0] < 0:\n      actions.append(0)  # DOWN\n      direction_vector = (direction_vector[0] + 1, direction_vector[1])\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:40:10.941402", "function_name": "craft", "function_body": "  # Get the cookbook from the environment\n  cookbook = env.world.cookbook\n\n  # Get the index of the desired item\n  item_index = cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes[item_index]\n\n  # Find the workshop required to craft this item\n  workshop_name = recipe[\"_at\"]\n  workshop_index = cookbook.index[workshop_name]\n\n  # Check if the agent has all the ingredients in its inventory\n  inventory = env._current_state.inventory\n  for ingredient, count in recipe.items():\n    if ingredient == \"_at\":\n        continue\n    if inventory[ingredient] < count:\n      raise ValueError(f\"Missing ingredient {cookbook.index.get(ingredient)} to craft {item}\")\n\n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[..., workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No {workshop_name} found on the map.\")\n\n  # Assume the first occurrence of the workshop is the target\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the relative direction to move towards the workshop\n  current_pos = env._current_state.pos\n  dx, dy = target_workshop_pos[0] - current_pos[0], target_workshop_pos[1] - current_pos[1]\n\n  # Generate actions to move to the workshop\n  actions = []\n  if dx < 0:\n    actions.extend([env.world.N_ACTIONS[\"UP\"]]*abs(dx))\n  elif dx > 0:\n    actions.extend([env.world.N_ACTIONS[\"DOWN\"]]*dx)\n\n  if dy < 0:\n    actions.extend([env.world.N_ACTIONS[\"LEFT\"]]*abs(dy))\n  elif dy > 0:\n    actions.extend([env.world.N_ACTIONS[\"RIGHT\"]]*dy)\n\n  # Add the USE action to craft the item\n  actions.append(env.world.N_ACTIONS[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:42:02.080990", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the closest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos, grid)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:42:03.148392", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid, obstacles=[]):\n      open_set = set()\n      closed_set = set()\n      g_values = {start: 0}\n      f_values = {start: heuristic(start, goal)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=f_values.get)\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1] + [goal]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if (0 <= neighbor[0] < grid.shape[0] and \n                  0 <= neighbor[1] < grid.shape[1] and\n                  neighbor not in obstacles):\n                  # Ensure the neighbor is a walkable cell\n                  if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n                      tentative_g_score = g_values[current] + heuristic(current, neighbor)\n                      if (neighbor not in g_values or \n                          tentative_g_score < g_values[neighbor]):\n                          came_from[neighbor] = current\n                          g_values[neighbor] = tentative_g_score\n                          f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                          if neighbor not in open_set:\n                              open_set.add(neighbor)\n\n      return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the closest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  # Calculate the path to the target position using A* algorithm\n\n  obstacles = []\n  for obstacle in env.world.cookbook.index.ordered_values:\n    if obstacle not in ['WORKSHOP0', 'WORKSHOP1', 'WORKSHOP2']:\n      obstacle_index = index[obstacle]\n      obstacle_positions = np.argwhere(grid[:, :, obstacle_index] == 1)\n      obstacles.extend(map(tuple, obstacle_positions))\n\n  path = a_star(current_pos, target_pos, grid, obstacles)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:43:09.688033", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          actions.append(dir_map['DOWN'])\n      elif dx < 0:\n          actions.append(dir_map['UP'])\n      else:\n          if dy > 0:\n              actions.append(dir_map['RIGHT'])\n          elif dy < 0:\n              actions.append(dir_map['LEFT'])\n      \n      # Simulate the move to update current_pos\n      new_dir = actions[-1]\n      if new_dir == dir_map['DOWN']:\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif new_dir == dir_map['UP']:\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif new_dir == dir_map['RIGHT']:\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif new_dir == dir_map['LEFT']:\n          current_pos = (current_pos[0], current_pos[1] - 1)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T21:48:10.435782", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos, current_dir = env._current_state.pos, env._current_state.dir\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          new_dir = dir_map['DOWN'] if dx > 0 else dir_map['UP']\n      else:\n          new_dir = dir_map['RIGHT'] if dy > 0 else dir_map['LEFT']\n\n      # Rotate to the correct direction\n      while current_dir != new_dir:\n          actions.append((current_dir + 1) % 4 if (new_dir - current_dir) % 4 <= 2 else (current_dir - 1) % 4)\n          current_dir = (actions[-1] + current_dir) % 4\n\n      # Move forward\n      actions.append(new_dir)\n      current_pos = (current_pos[0] + (1 if new_dir == dir_map['DOWN'] else -1 if new_dir == dir_map['UP'] else 0),\n                     current_pos[1] + (1 if new_dir == dir_map['RIGHT'] else -1 if new_dir == dir_map['LEFT'] else 0))\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T21:50:03.339403", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # Calculate the path to the closest workshop using A* algorithm\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Convert the path into actions\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 3.9}}
{"timestamp": "2025-09-16T21:50:04.402189", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if grid[neighbor][0] == 0:  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  def get_direction(current_pos, next_pos):\n      delta_x = next_pos[0] - current_pos[0]\n      delta_y = next_pos[1] - current_pos[1]\n\n      if delta_x < 0:\n          return \"LEFT\"\n      elif delta_x > 0:\n          return \"RIGHT\"\n      elif delta_y < 0:\n          return \"DOWN\"\n      else:\n          return \"UP\"\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  # For simplicity, we pick the closest workshop\n  current_pos = env._current_state.pos\n  closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1]))\n  target_pos = tuple(closest_workshop)\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos, grid)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  action_map = env.action_specs()\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    direction = get_direction(current_pos, next_pos)\n    \n    # Turn the agent to face the correct direction\n    if direction == \"UP\":\n        while current_dir != action_map[\"UP\"]:\n            actions.append(action_map[\"UP\"])\n            current_dir = action_map[\"UP\"]\n    elif direction == \"DOWN\":\n        while current_dir != action_map[\"DOWN\"]:\n            actions.append(action_map[\"DOWN\"])\n            current_dir = action_map[\"DOWN\"]\n    elif direction == \"LEFT\":\n        while current_dir != action_map[\"LEFT\"]:\n            actions.append(action_map[\"LEFT\"])\n            current_dir = action_map[\"LEFT\"]\n    elif direction == \"RIGHT\":\n        while current_dir != action_map[\"RIGHT\"]:\n            actions.append(action_map[\"RIGHT\"])\n            current_dir = action_map[\"RIGHT\"]\n\n    # Move the agent to the next position\n    actions.append(action_map[direction])\n    current_pos = next_pos\n\n  # Add action to use the workshop for crafting\n  actions.append(action_map[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 0.9}}
{"timestamp": "2025-09-16T21:51:21.791153", "function_name": "craft", "function_body": "  def move_towards(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Determine the direction to move\n      if delta_x > 0:\n          actions.extend([RIGHT]*delta_x)  # move right\n      elif delta_x < 0:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      # Align direction for y-axis movement\n      if delta_y > 0 and env._current_state.dir != DOWN:\n          actions.append(DOWN)  # change direction to down\n      elif delta_y < 0 and env._current_state.dir != UP:\n          actions.append(UP)  # change direction to up\n      \n      # Move along the y-axis\n      if delta_y > 0:\n          actions.extend([DOWN]*delta_y)  # move down\n      elif delta_y < 0:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  def has_required_items(recipe, inventory):\n      required_items = {env.world.cookbook.index[i]: recipe[i] for i in recipe if i != \"_at\"}\n      for item_index, count in required_items.items():\n          if inventory[item_index] < count:\n              return False\n      return True\n\n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Get the item index from the name\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Check if all required items are in the inventory\n  if not has_required_items(recipe, env._current_state.inventory):\n      return []  # Return an empty list of actions if requirements aren't met\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if not workshop_positions.size:\n      return []  # Return an empty list if no such workshop is found\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(move_towards(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
