{"timestamp": "2025-09-18T13:53:32.729115", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        closest_primitive = None\n        \n        # Choose the closest available position to collect from, avoiding revisiting positions\n        for pos in primitive_positions:\n            pos_tuple = tuple(pos)\n            if pos_tuple not in visited_positions:\n                if closest_primitive is None or (abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])) <\\\n                   (abs(closest_primitive[0] - env._current_state.pos[0]) + abs(closest_primitive[1] - env._current_state.pos[1])):\n                    closest_primitive = pos_tuple\n        \n        if closest_primitive:\n            visited_positions.add(closest_primitive)\n            \n            target_primitive_pos = tuple(closest_primitive)\n\n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(target_primitive_pos))\n            \n            # Use the USE action to collect the primitive\n            actions_to_take.append(4)\n            \n            # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n            if primitive_index in env._current_state.inventory:\n                env._current_state.inventory[primitive_index] += count\n            else:\n                env._current_state.inventory[primitive_index] = count\n            \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index, count=1):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v * count for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def optimize_path(actions):\n    \"\"\"Optimize a sequence of actions by removing redundant moves.\"\"\"\n    if not actions:\n      return []\n    \n    optimized_actions = [actions[0]]\n    last_move = actions[0]\n    \n    for action in actions[1:]:\n        # Check if the current action is moving in the opposite direction of the last move\n        if (last_move == 2 and action == 3) or (last_move == 3 and action == 2):\n            optimized_actions.pop()\n        elif (last_move == 0 and action == 1) or (last_move == 1 and action == 0):\n            optimized_actions.pop()\n        else:\n            optimized_actions.append(action)\n        \n        last_move = action\n    \n    return optimized_actions\n\n  def merge_consecutive_moves(actions):\n      \"\"\"Merge consecutive move actions for optimization.\"\"\"\n      if not actions:\n          return []\n      \n      merged_actions = [actions[0]]\n      count = 1\n      \n      for action in actions[1:]:\n          if action == merged_actions[-1]:\n              count += 1\n          else:\n              merged_actions.extend([merged_actions[-1]] * (count - 1))\n              merged_actions.append(action)\n              count = 1\n      \n      # Add the last set of actions\n      merged_actions.extend([merged_actions[-1]] * (count - 1))\n      \n      return merged_actions\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  # Optimize and merge the sequence of actions\n  optimized_actions = optimize_path(actions_to_take)\n  merged_actions = merge_consecutive_moves(optimized_actions)\n  \n  return merged_actions", "island_id": 7, "scores": {"3": 11.199999}}
{"timestamp": "2025-09-18T13:53:33.876695", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    visited_positions = set()\n    \n    # Sort primitives by the number of instances needed\n    sorted_primitives = sorted(primitives_needed.keys(), key=lambda x: primitives_needed[x], reverse=True)\n    \n    for primitive_index in sorted_primitives:\n      count = primitives_needed[primitive_index]\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        closest_primitive = None\n        \n        # Choose the closest available position to collect from, avoiding revisiting positions\n        for pos in primitive_positions:\n            pos_tuple = tuple(pos)\n            if pos_tuple not in visited_positions:\n                if closest_primitive is None or (abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])) <\\\n                   (abs(closest_primitive[0] - env._current_state.pos[0]) + abs(closest_primitive[1] - env._current_state.pos[1])):\n                    closest_primitive = pos_tuple\n        \n        if closest_primitive:\n            visited_positions.add(closest_primitive)\n            \n            target_primitive_pos = tuple(closest_primitive)\n\n            # Calculate move actions to reach the closest primitive\n            actions_to_take.extend(get_move_actions(target_primitive_pos))\n            \n            # Use the USE action to collect the primitive\n            actions_to_take.append(4)\n            \n            # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n            if primitive_index in env._current_state.inventory:\n                env._current_state.inventory[primitive_index] += count\n            else:\n                env._current_state.inventory[primitive_index] = count\n            \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def optimize_path(actions):\n    \"\"\"Optimize a sequence of actions by removing redundant moves.\"\"\"\n    if not actions:\n      return []\n    \n    optimized_actions = [actions[0]]\n    last_move = actions[0]\n    \n    for action in actions[1:]:\n        # Check if the current action is moving in the opposite direction of the last move\n        if (last_move == 2 and action == 3) or (last_move == 3 and action == 2):\n            optimized_actions.pop()\n        elif (last_move == 0 and action == 1) or (last_move == 1 and action == 0):\n            optimized_actions.pop()\n        else:\n            optimized_actions.append(action)\n        \n        last_move = action\n    \n    return optimized_actions\n\n  def pathfinding(env, target_pos):\n    \"\"\"Pathfinding function to navigate the grid more efficiently.\"\"\"\n    import heapq\n    \n    start = env._current_state.pos\n    goal = target_pos\n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n    came_from = {}\n    cost_so_far = {start: 0}\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    \n    while open_set:\n        _, current = heapq.heappop(open_set)\n        \n        if current == goal:\n            break\n        \n        for direction in directions:\n            neighbor = (current[0] + direction[0], current[1] + direction[1])\n            \n            # Check if the neighbor is within grid bounds and not an obstacle\n            if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n               0 <= neighbor[1] < env._current_state.grid.shape[1] and\\\n               env._current_state.grid[neighbor[0], neighbor[1]] == 0:\n                new_cost = cost_so_far[current] + 1\n                \n                if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                    cost_so_far[neighbor] = new_cost\n                    priority = new_cost + abs(goal[0] - neighbor[0]) + abs(goal[1] - neighbor[1])\n                    heapq.heappush(open_set, (priority, neighbor))\n                    came_from[neighbor] = current\n    \n    # Reconstruct the path\n    if goal in came_from:\n        path = []\n        while goal != start:\n            path.append(goal)\n            goal = came_from[goal]\n        path.reverse()\n        \n        actions_to_take = []\n        last_pos = start\n        \n        for pos in path:\n            if pos[0] > last_pos[0]:\n                actions_to_take.extend([1] * (pos[0] - last_pos[0]))  # DOWN\n            elif pos[0] < last_pos[0]:\n                actions_to_take.extend([0] * (last_pos[0] - pos[0]))  # UP\n            \n            if pos[1] > last_pos[1]:\n                actions_to_take.extend([3] * (pos[1] - last_pos[1]))  # RIGHT\n            elif pos[1] < last_pos[1]:\n                actions_to_take.extend([2] * (last_pos[1] - pos[1]))  # LEFT\n            \n            last_pos = pos\n        \n        return actions_to_take\n    else:\n        raise ValueError(\"No path found to the target position.\")\n    \n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n      recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n      flattened_items = flatten_recipe_hierarchy(recipe_hierarchy)\n      \n      actions_to_take = []\n      \n      for item in flattened_items:\n          recipe = cookbook.recipes[item].copy()\n          \n          if '_at' in recipe:\n              del recipe['_at']\n          \n          actions_to_take.extend(collect_primitives(env, recipe))\n          actions_to_take.extend(craft_item(env, item))\n      \n      # Optimize the path\n      optimized_actions = optimize_path(actions_to_take)\n      \n      return optimized_actions\n  else:\n      raise ValueError(f\"Item {item} not found in cookbook.\")", "island_id": 7, "scores": {"3": 8.099999}}
{"timestamp": "2025-09-18T13:56:22.432728", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def check_and_avoid_collisions(actions_to_take):\n    \"\"\"Check for potential collisions and modify actions if necessary.\"\"\"\n    modified_actions = []\n    current_pos = env._current_state.pos\n    \n    for action in actions_to_take:\n        new_pos = list(current_pos)\n        \n        if action == 0:  # Move UP\n            new_pos[1] -= 1\n        elif action == 1:  # Move DOWN\n            new_pos[1] += 1\n        elif action == 2:  # Move LEFT\n            new_pos[0] -= 1\n        elif action == 3:  # Move RIGHT\n            new_pos[0] += 1\n        \n        # Check if the new position is valid (not a collision)\n        if env._current_state.grid[new_pos[0], new_pos[1]].sum() == 0:\n            modified_actions.append(action)\n            current_pos = tuple(new_pos)\n    \n    return modified_actions\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Check and avoid collisions\n        actions_to_take = check_and_avoid_collisions(actions_to_take)\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": 9.2}}
