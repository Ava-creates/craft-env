\n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] += 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index].copy()\n\n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      actions_to_take = []\n\n      if not check_inventory(env, recipe):\n          # Collect all dependencies that are not in inventory\n          actions_to_take.extend(collect_dependencies(env, dependencies))\n          \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item in cookbook.index:\n    item_index = cookbook.index[item]\n    return plan_crafting(env, item_index)\n  else:\n    raise ValueError(f\"Item {item} not found in cookbook.\")", "island_id": 1, "scores": {"3": 8.5}}
{"timestamp": "2025-09-18T09:59:12.949004", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] += 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Check if there is a recipe available for this item\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      # Collect all dependencies that are not in inventory\n      actions_to_take = collect_dependencies(env, dependencies)\n\n      actions_to_take.extend(navigate_and_craft(env, item_index))\n      \n      return actions_to_take\n\n  def is_item_in_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    if item_index in env._current_state.inventory and env._current_state.inventory[item_index] >= 1:\n        return True\n    return False\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n    raise ValueError(f\"Item {item} not found in cookbook.\")\n\n  item_index = cookbook.index[item]\n  \n  # If the item is already in inventory, no need to craft it again\n  if is_item_in_inventory(env, item_index):\n      return []\n\n  # Plan and execute the crafting process\n  actions_to_take = plan_crafting(env, item_index)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 8.3}}
{"timestamp": "2025-09-18T09:59:13.970130", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + count\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n          \n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          env._current_state.inventory[dependency] = env._current_state.inventory.get(dependency, 0) + 1\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Check if there is a recipe available for this item\n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n\n      recipe = cookbook.recipes[item_index].copy()\n      \n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      # Collect all dependencies that are not in inventory\n      actions_to_take = collect_dependencies(env, dependencies)\n\n      actions_to_take.extend(navigate_and_craft(env, item_index))\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item not in cookbook.index:\n    raise ValueError(f\"Item {item} not found in cookbook.\")\n\n  item_index = cookbook.index[item]\n  \n  # Plan and execute the crafting process\n  actions_to_take = plan_crafting(env, item_index)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-18T10:01:45.546644", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n        \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item'], env.world.cookbook):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft, cookbook):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 7.1}}
{"timestamp": "2025-09-18T10:01:46.680425", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 11.199999}}
{"timestamp": "2025-09-18T10:03:52.766960", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take = get_move_actions(target_primitive_pos)\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          return actions_to_take, True\n      \n      return [], False\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      workshop_name = recipe.pop('_at')\n      workshop_index = cookbook.index[workshop_name]\n      \n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if not len(workshop_positions):\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n          \n      actions_to_take = []\n      \n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    \n    dependencies = set()\n    queue = [item_index]\n    \n    while queue:\n      current_item = queue.pop(0)\n      \n      # Mark the current item as visited\n      visited.add(current_item)\n      \n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        \n        for primitive_index, count in recipe.items():\n          if (primitive_index not in visited and \n              primitive_index in cookbook.recipes and \n              primitive_index != current_item):\n            queue.append(primitive_index)\n          \n          dependencies.add(primitive_index)\n\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n      actions_to_take = []\n      \n      for dependency in sorted(dependencies):\n        # Check if the primitive is available in inventory\n        if (dependency not in env._current_state.inventory or \n            env._current_state.inventory[dependency] < 1):\n          sub_actions, success = collect_primitive(env, dependency)\n          \n          if success:\n              actions_to_take.extend(sub_actions)\n      \n      return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index].copy()\n\n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      actions_to_take = []\n\n      if not check_inventory(env, recipe):\n          # Collect all dependencies that are not in inventory\n          actions_to_take.extend(collect_dependencies(env, dependencies))\n          \n      actions_to_take.extend(navigate_and_craft(env, item_index))\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  return plan_crafting(env, item_index)", "island_id": 1, "scores": {"3": 6.3999996}}
{"timestamp": "2025-09-18T10:03:53.833683", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) > 0:\n      current_pos = env._current_state.pos\n      closest_primitive = min(\n          primitive_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_primitive_pos = tuple(closest_primitive)\n\n      # Calculate move actions to reach the closest primitive\n      actions_to_take = get_move_actions(target_primitive_pos)\n      \n      # Use the USE action to collect the primitive\n      actions_to_take.append(4)\n      \n      return actions_to_take, True\n    \n    return [], False\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    \n    dependencies = set()\n    queue = [item_index]\n    \n    while queue:\n      current_item = queue.pop(0)\n      \n      # Mark the current item as visited\n      visited.add(current_item)\n      \n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        \n        for primitive_index, count in recipe.items():\n          if (primitive_index not in visited and \n              primitive_index in cookbook.recipes and \n              primitive_index != current_item):\n            queue.append(primitive_index)\n          \n          dependencies.add(primitive_index)\n\n    return dependencies\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index].copy()\n\n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      actions_to_take = []\n\n      if not check_inventory(env, recipe):\n          for dependency in sorted(dependencies):\n              while True:\n                  sub_actions, success = collect_primitive(env, dependency)\n                  if success:\n                      actions_to_take.extend(sub_actions)\n                      break\n                  else:\n                      print(f\"Unable to find {dependency} in the grid.\")\n                      return []\n\n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take.extend(get_move_actions(target_workshop_pos))\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  return plan_crafting(env, item_index)", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-18T10:06:43.148018", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += 1\n        else:\n            env._current_state.inventory[primitive_index] = 1\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    \n    dependencies = set()\n    queue = [item_index]\n    \n    while queue:\n      current_item = queue.pop(0)\n      \n      # Mark the current item as visited\n      visited.add(current_item)\n      \n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        \n        for primitive_index, count in recipe.items():\n          if (primitive_index not in visited and \n              primitive_index in cookbook.recipes):\n            queue.append(primitive_index)\n          \n          dependencies.add(primitive_index)\n\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    \n    for dependency in sorted(dependencies):\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          if dependency in env._current_state.inventory:\n              env._current_state.inventory[dependency] += 1\n          else:\n              env._current_state.inventory[dependency] = 1\n\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index].copy()\n\n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      actions_to_take = []\n\n      if not check_inventory(env, recipe):\n          # Collect all dependencies that are not in inventory\n          actions_to_take.extend(collect_dependencies(env, dependencies))\n          \n      # Craft the final item\n      actions_to_take.extend(navigate_and_craft(env, item_index))\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item in cookbook.index:\n    item_index = cookbook.index[item]\n    return plan_crafting(env, item_index)\n  else:\n    raise ValueError(f\"Item {item} not found in cookbook.\")", "island_id": 1, "scores": {"3": 8.0}}
{"timestamp": "2025-09-18T10:06:44.263265", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] += count\n        else:\n            env._current_state.inventory[primitive_index] = count\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index):\n      cookbook = env.world.cookbook\n      \n      # Extract the workshop from the original recipe\n      workshop_name = cookbook.recipes[item_index]['_at']\n      workshop_index = cookbook.index[workshop_name]\n\n      # Find all positions of the specified workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n      if len(workshop_positions) > 0:\n          current_pos = env._current_state.pos\n\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_workshop_pos = tuple(closest_workshop)\n\n          # Calculate move actions to reach the closest workshop\n          actions_to_take = get_move_actions(target_workshop_pos)\n          \n          # Use the USE action to craft the item at the workshop\n          actions_to_take.append(4)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index, visited=None):\n    if visited is None:\n        visited = set()\n    \n    dependencies = set()\n    queue = [item_index]\n    \n    while queue:\n      current_item = queue.pop(0)\n      \n      # Mark the current item as visited\n      visited.add(current_item)\n      \n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        \n        for primitive_index, count in recipe.items():\n          if (primitive_index not in visited and \n              primitive_index in cookbook.recipes and \n              primitive_index != current_item):\n            queue.append(primitive_index)\n          \n          dependencies.add(primitive_index)\n\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    \n    for dependency in sorted(dependencies):\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        # Find positions of the required primitives in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, dependency] == 1)\n        \n        if len(primitive_positions) > 0:\n          # Choose the closest available position to collect from\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_take.append(4)\n          \n          # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n          if dependency in env._current_state.inventory:\n              env._current_state.inventory[dependency] += 1\n          else:\n              env._current_state.inventory[dependency] = 1\n\n    return actions_to_take\n\n  def plan_crafting(env, item_index):\n      cookbook = env.world.cookbook\n      \n      if item_index not in cookbook.recipes:\n          raise ValueError(f\"No recipe available for crafting {item}.\")\n      \n      # Fetch the recipe details for the item\n      recipe = cookbook.recipes[item_index].copy()\n\n      # Remove the '_at' key which indicates the workshop\n      del recipe['_at']\n      \n      # Get all dependencies (primitives) required to craft the item\n      dependencies = get_recipe_dependencies(cookbook, item_index)\n      \n      actions_to_take = []\n\n      if not check_inventory(env, recipe):\n          # Collect all dependencies that are not in inventory\n          actions_to_take.extend(collect_dependencies(env, dependencies))\n          \n      actions_to_take.extend(navigate_and_craft(env, item_index))\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  if item in cookbook.index:\n    item_index = cookbook.index[item]\n    return plan_crafting(env, item_index)\n  else:\n    raise ValueError(f\"Item {item} not found in cookbook.\")", "island_id": 1, "scores": {"3": 8.0}}
{"timestamp": "2025-09-18T10:09:11.871891", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine the direction to move first based on obstacle avoidance\n    if abs(rel_x) > abs(rel_y):\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # Move RIGHT\n        else:\n            actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # Move DOWN\n        else:\n            actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    else:\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # Move DOWN\n        else:\n            actions_to_take.extend([0] * abs(rel_y))  # Move UP\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # Move RIGHT\n        else:\n            actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def craft_item(env, item_index):\n    workshop_pos = find_closest_workshop(env, item_index)\n    \n    actions_to_take = get_move_actions(workshop_pos)\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def handle_complex_recipe(env, item_index):\n    actions_to_take = []\n    cookbook = env.world.cookbook\n    \n    if item_index not in cookbook.recipes:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n    \n    hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    items_to_craft = flatten_recipe_hierarchy(hierarchy)\n\n    # Collect and craft items according to the hierarchy\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        update_inventory(env, recipe)\n\n    return actions_to_take\n\n  def simulate_steps(actions):\n      for action in actions:\n          _, done, _ = env.step(action)\n          if done:\n              break\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  actions_to_take = handle_complex_recipe(env, item_index)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 10.199999}}
