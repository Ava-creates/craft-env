{"timestamp": "2025-09-17T01:36:03.729984", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Move horizontally first\n      if tx > sx:\n          actions.extend([3] * (tx - sx))  # RIGHT\n      elif tx < sx:\n          actions.extend([2] * (sx - tx))  # LEFT\n      \n      # Then move vertically\n      if ty > sy:\n          actions.extend([1] * (ty - sy))  # UP\n      elif ty < sy:\n          actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:36:04.793640", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def calculate_path(start, target):\n    \"\"\"Calculate a path from start to target using Manhattan distance.\"\"\"\n    sx, sy = start\n    tx, ty = target\n    \n    if tx > sx:\n        actions.extend([3] * (tx - sx))  # RIGHT\n    elif tx < sx:\n        actions.extend([2] * (sx - tx))  # LEFT\n    \n    if ty > sy:\n        actions.extend([1] * (ty - sy))  # UP\n    elif ty < sy:\n        actions.extend([0] * (sy - ty))  # DOWN\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  calculate_path((current_x, current_y), closest_workshop_pos)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:37:07.448670", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Determine direction and move accordingly\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def move_in_direction(dir, steps):\n    direction_map = {'UP': 1, 'DOWN': 0, 'LEFT': 2, 'RIGHT': 3}\n    return [direction_map[dir]] * steps\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_in_direction('RIGHT' if dx > 0 else 'LEFT', abs(dx)))\n  actions.extend(move_in_direction('UP' if dy > 0 else 'DOWN', abs(dy)))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:37:08.513899", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:39:14.463153", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:39:15.433799", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  def collect_primitives(primitive_indices):\n    actions = []\n    for primitive_index in primitive_indices:\n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) == 0:\n        raise ValueError(f\"No available primitives for {primitive_name}\")\n\n      current_pos = env._current_state.pos\n\n      # For simplicity, we pick the first available primitive\n      target_pos = tuple(primitive_positions[0])\n\n      # Calculate the path to the target position using A* algorithm\n      path = a_star(current_pos, target_pos)\n\n      if not path:\n        raise ValueError(f\"No valid path to primitive for {primitive_name}\")\n\n      # Convert the path into actions\n      action_map = {\n          \"UP\": env.action_specs()[\"UP\"],\n          \"DOWN\": env.action_specs()[\"DOWN\"],\n          \"LEFT\": env.action_specs()[\"LEFT\"],\n          \"RIGHT\": env.action_specs()[\"RIGHT\"]\n      }\n\n      current_dir = env._current_state.dir\n\n      for i in range(len(path) - 1):\n        next_pos = path[i + 1]\n        delta_x = next_pos[0] - path[i][0]\n        delta_y = next_pos[1] - path[i][1]\n\n        if delta_x < 0:\n            actions.append(action_map[\"LEFT\"])\n        elif delta_x > 0:\n            actions.append(action_map[\"RIGHT\"])\n        elif delta_y < 0:\n            actions.append(action_map[\"DOWN\"])\n        else:\n            actions.append(action_map[\"UP\"])\n\n      # Add action to pick up the primitive\n      actions.append(env.action_specs()[\"USE\"])\n\n    return actions\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Determine required primitives for the item\n  primitive_names = [key for key in recipe.keys() if key != \"_at\" and isinstance(recipe[key], int)]\n  primitive_indices = [index[primitive_name] for primitive_name in primitive_names]\n\n  # Collect all primitives required for crafting the item\n  actions.extend(collect_primitives(primitive_indices))\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:40:21.270977", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Move vertically first if the difference is larger\n      if abs(ty - sy) > abs(tx - sx):\n          if ty > sy:\n              actions.extend([1] * (ty - sy))  # UP\n          elif ty < sy:\n              actions.extend([0] * (sy - ty))  # DOWN\n      \n          if tx > sx:\n              actions.extend([3] * (tx - sx))  # RIGHT\n          elif tx < sx:\n              actions.extend([2] * (sx - tx))  # LEFT\n      else:\n          if tx > sx:\n              actions.extend([3] * (tx - sx))  # RIGHT\n          elif tx < sx:\n              actions.extend([2] * (sx - tx))  # LEFT\n      \n          if ty > sy:\n              actions.extend([1] * (ty - sy))  # UP\n          elif ty < sy:\n              actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:40:22.327762", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(start, target):\n      \"\"\"Calculate a simple path from start to target using Manhattan distance.\"\"\"\n      sx, sy = start\n      tx, ty = target\n      \n      actions = []\n      \n      # Move horizontally first if the vertical distance is greater\n      if abs(ty - sy) > abs(tx - sx):\n          if ty > sy:\n              actions.extend([1] * (ty - sy))  # UP\n          elif ty < sy:\n              actions.extend([0] * (sy - ty))  # DOWN\n      \n      # Move horizontally\n      if tx > sx:\n          actions.extend([3] * (tx - sx))  # RIGHT\n      elif tx < sx:\n          actions.extend([2] * (sx - tx))  # LEFT\n      \n      # Move vertically last\n      if abs(ty - sy) <= abs(tx - sx):\n          if ty > sy:\n              actions.extend([1] * (ty - sy))  # UP\n          elif ty < sy:\n              actions.extend([0] * (sy - ty))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate path to the workshop\n  actions.extend(calculate_path((current_x, current_y), closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:41:22.996620", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n    \n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T01:46:23.296321", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Function to calculate Manhattan distance and direction\n  def manhattan_distance_and_direction(current_x, current_y, target_x, target_y):\n      dx = target_x - current_x\n      dy = target_y - current_y\n      return abs(dx) + abs(dy), dx, dy\n\n  dist, dx, dy = manhattan_distance_and_direction(current_x, current_y, target_x, target_y)\n\n  while dist > 0:\n    if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n    elif dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      \n    if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n    elif dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n\n    dist, dx, dy = manhattan_distance_and_direction(current_x + (3 - actions[-1] if actions[-1] in [2, 3] else actions[-1] - 1),\n                                                   current_y + (1 - actions[-1] if actions[-1] in [0, 1] else actions[-1] - 3),\n                                                   target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:47:34.354238", "function_name": "craft", "function_body": "  def find_nearest_workshop(grid, current_pos, workshop_index):\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      distances = [np.linalg.norm(np.array(p) - np.array(current_pos)) for p in positions]\n      nearest_pos = tuple(positions[np.argmin(distances)])\n      return nearest_pos\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  target_pos = find_nearest_workshop(grid, env._current_state.pos, workshop_index)\n  \n  if not target_pos:\n      raise ValueError(f\"No workshop found for item {item}\")\n\n  # Step 2: Move to one of the workshops (choosing the nearest one here)\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  actions = []\n  while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n          direction = 'DOWN' if dx > 0 else 'UP'\n      else:\n          direction = 'RIGHT' if dy > 0 else 'LEFT'\n\n      actions.append(dir_map[direction])\n      \n      # Simulate the move to update current_pos\n      new_dir = actions[-1]\n      if new_dir == dir_map['DOWN']:\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif new_dir == dir_map['UP']:\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif new_dir == dir_map['RIGHT']:\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif new_dir == dir_map['LEFT']:\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-09-17T01:47:35.418867", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  # Calculate direction needed to move in each step towards the target position\n  actions = []\n  while current_pos != target_pos:\n      direction = get_direction(current_pos, target_pos)\n      \n      if direction is not None:\n          actions.append(dir_map[direction])\n          # Simulate the move to update current_pos\n          if direction == 'DOWN':\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif direction == 'UP':\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          elif direction == 'RIGHT':\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif direction == 'LEFT':\n              current_pos = (current_pos[0], current_pos[1] - 1)\n  \n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T01:49:08.479932", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Handle diagonal movement optimization\n    if abs(rel_x) > 0 and abs(rel_y) > 0:\n        diag_steps = min(abs(rel_x), abs(rel_y))\n        if rel_x > 0 and rel_y > 0:  # SE direction\n            actions_to_take.extend([1] * diag_steps)\n        elif rel_x < 0 and rel_y > 0:  # SW direction\n            actions_to_take.extend([0] * diag_steps)\n        elif rel_x > 0 and rel_y < 0:  # NE direction\n            actions_to_take.extend([3] * diag_steps)\n        elif rel_x < 0 and rel_y < 0:  # NW direction\n            actions_to_take.extend([2] * diag_steps)\n\n        # Update remaining steps\n        rel_x -= diag_steps * (1 if rel_x > 0 else -1)\n        rel_y -= diag_steps * (1 if rel_y > 0 else -1)\n\n    # Move horizontally or vertically to reach the target position\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n\n    return actions_to_take\n  \n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 0.90000004}}
{"timestamp": "2025-09-17T01:49:09.560595", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n            \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    return actions_to_take\n\n  def get_primitive_actions(env, primitive):\n    cookbook = env.world.cookbook\n    world = env.world\n    primitive_index = cookbook.index[primitive]\n    target_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(target_positions) > 0:\n        # Choose the closest available position of the primitive\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            target_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take = get_move_actions(target_primitive_pos)\n\n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No {primitive} found in the environment.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract all ingredients from the recipe (excluding '_at' which specifies workshop)\n    ingredients = {k: v for k, v in recipe.items() if k != '_at'}\n    \n    actions_to_take = []\n    \n    # Collect all required primitives first\n    for primitive, count in ingredients.items():\n      for _ in range(count):\n        primitive_actions = get_primitive_actions(env, primitive)\n        actions_to_take.extend(primitive_actions)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 2.6000001}}
{"timestamp": "2025-09-17T01:50:59.783916", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def align_with_workshop(current_pos, workshop_pos):\n      current_dir = env._current_state.dir\n      target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n      if target_dir == (0, 1):\n          if current_dir != 3:\n              return [(current_dir + 2) % 4]\n      elif target_dir == (0, -1):\n          if current_dir != 1:\n              return [(current_dir + 2) % 4]\n      elif target_dir == (1, 0):\n          if current_dir != 3:\n              return [(current_dir + 1) % 4]\n      elif target_dir == (-1, 0):\n          if current_dir != 1:\n              return [(current_dir + 3) % 4]\n      return []\n\n  def get_required_primitives(item_index, cookbook):\n    \"\"\"Recursively find all required primitives for crafting an item.\"\"\"\n    recipe = cookbook.recipes[item_index]\n    required_primitives = set()\n\n    # Check each ingredient in the recipe\n    for ingredient_name, count in recipe.items():\n        if ingredient_name.startswith('_'):\n            continue  # Skip special keys like '_at'\n        \n        ingredient_index = cookbook.index[ingredient_name]\n\n        # If the ingredient is a primitive, add it to the set of required primitives\n        if ingredient_index not in cookbook.recipes:\n            required_primitives.add(ingredient_index)\n        else:\n            # Otherwise, recursively find all primitives needed for this ingredient\n            required_primitives.update(get_required_primitives(ingredient_index, cookbook))\n    \n    return required_primitives\n\n  def get_actions_to_gather_primitive(primitive_index):\n      \"\"\"Generate actions to gather a primitive item from the grid.\"\"\"\n      current_state = env._current_state\n      primitive_positions = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) == 0:\n          raise ValueError(f\"No positions found for gathering {cookbook.index[primitive_index]}.\")\n\n      closest_primitive_pos = min(\n          primitive_positions, \n          key=lambda pos: abs(pos[0] - current_state.pos[0]) + abs(pos[1] - current_state.pos[1])\n      )\n\n      # Move to the position of the primitive\n      actions_to_take = get_move_actions(tuple(closest_primitive_pos))\n      \n      # Use the USE action to collect the primitive\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    required_primitives = get_required_primitives(item_index, cookbook)\n\n    actions_to_take = []\n    \n    # Gather all required primitives\n    for primitive_index in required_primitives:\n        actions_to_take.extend(get_actions_to_gather_primitive(primitive_index))\n    \n    # Craft the item using the closest available workshop\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        # Move to the workshop position\n        actions_to_take.extend(get_move_actions(tuple(closest_workshop)))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(current_pos, closest_workshop))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:51:00.919763", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def get_turn_action(current_dir, target_dir):\n      \"\"\"Calculate the turn action to face the target direction.\"\"\"\n      if current_dir == target_dir:\n          return []\n      elif (current_dir + 1) % 4 == target_dir:\n          return [3]  # Turn RIGHT\n      elif (current_dir - 1) % 4 == target_dir:\n          return [2]  # Turn LEFT\n      else:\n          return [3, 3]  # Turn around 180 degrees\n\n  def align_with_workshop(current_pos, workshop_pos):\n    current_dir = env._current_state.dir\n    target_dir = None\n    \n    rel_x = workshop_pos[0] - current_pos[0]\n    rel_y = workshop_pos[1] - current_pos[1]\n    \n    if rel_x > 0:\n        target_dir = 3  # RIGHT\n    elif rel_x < 0:\n        target_dir = 2  # LEFT\n    elif rel_y > 0:\n        target_dir = 1  # DOWN\n    elif rel_y < 0:\n        target_dir = 0  # UP\n    \n    return get_turn_action(current_dir, target_dir)\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(current_pos, target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.7}}
{"timestamp": "2025-09-17T01:52:47.475582", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Find the nearest workshop using A* algorithm\n  min_distance = float('inf')\n  nearest_workshop = None\n  for pos in workshop_positions:\n    distance = heuristic(current_pos, tuple(pos))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop = tuple(pos)\n\n  target_pos = nearest_workshop\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:52:48.545243", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Calculate direction changes needed to follow the path\n  def calculate_direction_changes(path):\n    directions = []\n    for i in range(len(path) - 1):\n        next_pos = path[i + 1]\n        delta_x = next_pos[0] - path[i][0]\n        delta_y = next_pos[1] - path[i][1]\n\n        if delta_x < 0:\n            directions.append(\"LEFT\")\n        elif delta_x > 0:\n            directions.append(\"RIGHT\")\n        elif delta_y < 0:\n            directions.append(\"DOWN\")\n        else:\n            directions.append(\"UP\")\n    return directions\n\n  directions = calculate_direction_changes(best_path)\n\n  # Convert direction changes to actions\n  for direction in directions:\n      actions.append(action_map[direction])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:54:33.936745", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  def get_required_primitives(item, cookbook):\n      required_items = []\n      if item in cookbook.recipes:\n          recipe = cookbook.recipes[item]\n          for key, value in recipe.items():\n              if key != '_at' and value > 0:\n                  required_items.append(key)\n      return required_items\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Step 1: Collect all required primitives that are not already in the inventory\n  current_inventory = env._current_state.inventory\n  required_primitives = get_required_primitives(item, cookbook)\n\n  actions_to_collect = []\n  for primitive_name in required_primitives:\n      if primitive_name != '_at' and current_inventory[cookbook.index[primitive_name]] == 0:\n          # Find positions of the primitive in the grid\n          primitive_index = cookbook.index[primitive_name]\n          grid = env._current_state.grid\n          primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"No {primitive_name} found in the environment\")\n          \n          # Choose the closest position to collect from\n          current_pos = env._current_state.pos\n          closest_primitive_pos = min(primitive_positions, key=lambda x: abs(x[0] - current_pos[0]) + abs(x[1] - current_pos[1]))\n          \n          actions_to_collect.extend(move_to_position(current_pos, tuple(closest_primitive_pos)))\n          actions_to_collect.append(4)  # Collect action\n          \n          # Update the current position after collecting\n          env._current_state.pos = tuple(closest_primitive_pos)\n\n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  recipe = cookbook.recipes[item_index]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n\n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  \n  # Step 3: Craft the item at the workshop\n  actions = actions_to_collect + actions_to_workshop + [4]  # Adding USE action to craft item\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-17T01:54:34.939263", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      actions = []\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  def get_required_primitives(item, cookbook):\n      required_items = []\n      if item in cookbook.recipes:\n          recipe = cookbook.recipes[item]\n          for key, value in recipe.items():\n              if key != '_at' and value > 0:\n                  required_items.append((key, value))\n      return required_items\n\n  def collect_primitives(env, primitives):\n      actions_to_collect = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      cookbook = env.world.cookbook\n      \n      for primitive_name, count in primitives:\n          if primitive_name != '_at' and env._current_state.inventory[cookbook.index[primitive_name]] < count:\n              # Find positions of the primitive in the grid\n              primitive_index = cookbook.index[primitive_name]\n              grid = env._current_state.grid\n              primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n              \n              if len(primitive_positions) == 0:\n                  raise ValueError(f\"No {primitive_name} found in the environment\")\n              \n              # Choose the closest position to collect from\n              closest_primitive_pos = min(primitive_positions, key=lambda x: abs(x[0] - current_pos[0]) + abs(x[1] - current_pos[1]))\n              \n              actions_to_collect.extend(move_to_position(current_pos, tuple(closest_primitive_pos)))\n              actions_to_collect.append(4)  # Collect action\n              \n              # Update the current position after collecting\n              current_pos = tuple(closest_primitive_pos)\n              env._current_state.pos = current_pos\n      return actions_to_collect\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Step 1: Collect all required primitives that are not already in sufficient quantity in the inventory\n  required_primitives = get_required_primitives(item, cookbook)\n\n  actions_to_collect = collect_primitives(env, required_primitives)\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  recipe = cookbook.recipes[item]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  target_pos = tuple(workshop_positions[0])\n  current_pos = env._current_state.pos\n\n  actions_to_workshop = move_to_position(current_pos, target_pos)\n  \n  # Step 3: Craft the item\n  actions_to_craft = [4]  # USE action to craft item\n\n  return actions_to_collect + actions_to_workshop + actions_to_craft", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:56:14.899191", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor]))):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-17T01:56:15.986664", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T01:57:12.656822", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      directions = []\n      \n      if dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n\n      return directions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:57:13.761546", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_target(current_x, current_y, target_x, target_y):\n      actions = []\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_target(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T01:58:56.608045", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid, workshop_index):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Pick the nearest workshop using A* heuristic\n  closest_workshop = min(workshop_positions, key=lambda wp: heuristic(current_pos, tuple(wp)))\n\n  target_pos = tuple(closest_workshop)\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos, grid, workshop_index)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
