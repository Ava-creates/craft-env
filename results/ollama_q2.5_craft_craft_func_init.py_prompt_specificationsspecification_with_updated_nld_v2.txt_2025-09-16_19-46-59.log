bs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:08:05.936211", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine direction to move horizontally first if needed\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))\n\n    # Then determine direction to move vertically\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def collect_primitives(env, primitives):\n      actions = []\n      current_state = env._current_state\n      cookbook = env.world.cookbook\n      \n      for primitive in primitives:\n          # Find the positions of the required primitive in the grid\n          primitive_index = cookbook.index[primitive]\n          primitive_positions = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n          \n          if len(primitive_positions) > 0:\n              # Choose the closest available primitive position to collect from\n              current_pos = current_state.pos\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions.extend(get_move_actions(target_primitive_pos))\n\n              # Use the USE action to collect the primitive\n              actions.append(4)\n          else:\n              raise ValueError(f\"No {primitive} found in the environment.\")\n      \n      return actions\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    required_primitives = [key for key in recipe if key != '_at']\n\n    # Collect all required primitives\n    actions_to_take = collect_primitives(env, required_primitives)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 3.8000002}}
{"timestamp": "2025-09-17T04:09:46.033943", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T04:09:47.023030", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def has_required_items(env, recipe):\n      cookbook = env.world.cookbook\n      inventory = env._current_state.inventory\n      for ingredient_index in recipe.keys():\n          if ingredient_index != '_at' and inventory[ingredient_index] < recipe[ingredient_index]:\n              return False\n      return True\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Check if the required items are available in inventory\n    if not has_required_items(env, recipe):\n        raise ValueError(f\"Missing required ingredients for crafting {item}.\")\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:10:43.067493", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      nonlocal actions\n      while dx != 0 or dy != 0:\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              dx -= 1\n          elif dx < 0:\n              actions.append(2)  # LEFT\n              dx += 1\n          elif dy > 0:\n              actions.append(1)  # UP\n              dy -= 1\n          elif dy < 0:\n              actions.append(0)  # DOWN\n              dy += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:10:44.028929", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  target_x, target_y = closest_workshop_pos\n\n  # Calculate the shortest path to the workshop using Manhattan distance\n  def calculate_path(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  actions.extend(calculate_path(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:11:57.130732", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_required_primitives(item_index):\n      primitives = collections.defaultdict(int)\n      required_items = {item_index: 1}\n\n      while required_items:\n          new_required_items = {}\n          for req_item, count in required_items.items():\n              if req_item in cookbook.primitives:\n                  primitives[req_item] += count\n              elif req_item in cookbook.recipes:\n                  recipe = cookbook.recipes[req_item]\n                  workshop_name = recipe.pop('_at')\n                  workshop_index = cookbook.index[workshop_name]\n\n                  for ingredient, amount in recipe.items():\n                      ingredient_index = cookbook.index[ingredient]\n                      new_required_items[ingredient_index] += count * amount\n          required_items = new_required_items\n\n      return primitives\n\n  def gather_primitives(env, primitives):\n    actions = []\n    for primitive, count in primitives.items():\n        while env._current_state.inventory[primitive] < count:\n            positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n            if len(positions) > 0:\n                closest_primitive_pos = min(\n                    positions,\n                    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                )\n                actions.extend(get_move_actions(tuple(closest_primitive_pos)))\n                actions.append(4)  # Collect action\n            else:\n                raise ValueError(f\"No {cookbook.index[primitive]} found to gather.\")\n    return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    primitives_needed = get_required_primitives(item_index)\n\n    # Gather all required primitives\n    actions_to_take = gather_primitives(env, primitives_needed)\n\n    # Craft the final item using craft_v0 function\n    actions_to_take.extend(craft_v0(env, item))\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:11:58.188008", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    # Prioritize vertical movement to avoid walls in the middle of horizontal movement\n\n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n            \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:12:44.143913", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:12:45.256678", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:13:42.214937", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while current_x != x or current_y != y:\n          # Determine the direction to move\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:13:43.293382", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while current_x != x or current_y != y:\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def face_direction(dir):\n    # Convert direction to action index\n    if dir == 'UP':\n        return 1\n    elif dir == 'DOWN':\n        return 0\n    elif dir == 'LEFT':\n        return 2\n    elif dir == 'RIGHT':\n        return 3\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the closest workshop\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Face the correct direction before using the USE action\n  target_x, target_y = closest_workshop_pos\n  current_x, current_y = env._current_state.pos\n\n  if target_y > current_y:\n      actions.append(face_direction('UP'))\n  elif target_y < current_y:\n      actions.append(face_direction('DOWN'))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:15:27.429364", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_primitives(env, primitives_needed):\n    actions_to_take = []\n    \n    for primitive in primitives_needed.keys():\n      primitive_index = env.world.cookbook.index[primitive]\n      required_amount = primitives_needed[primitive]\n\n      while env._current_state.inventory.get(primitive_index, 0) < required_amount:\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        # If no resources of this type are available in the grid, raise an error\n        if len(positions) == 0:\n          raise ValueError(f\"No {primitive} found in the environment.\")\n\n        closest_position = min(\n            positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_position)))\n        \n        # Collect the primitive using USE action\n        actions_to_take.append(4)\n      \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed)\n    \n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:15:28.575344", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_dir = env._current_state.dir\n    target_dir = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if target_dir == (0, 1) and current_dir != 3:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 2:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 0:\n        return [(current_dir + 3) % 4]\n\n    return []\n\n  def gather_primitives(env, primitives):\n    actions_to_take = []\n    for primitive in primitives:\n      primitive_index = env.world.cookbook.index[primitive]\n      while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n        positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n        \n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_position)))\n        \n        # Align with the target position before collecting.\n        actions_to_take.extend(align_with_target(tuple(closest_position)))\n        \n        # Collect the primitive using USE action\n        actions_to_take.append(4)\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Align with the target direction\n        actions_to_take.extend(align_with_target(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:16:23.971585", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move(dx, dy):\n    directions = []\n    \n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:16:25.034958", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n    actions = []\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n\n    return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:18:32.476351", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def if_workshop_in_inventory(env, workshop_name) -> bool:\n    \"\"\"Check if the specified workshop is in the inventory.\"\"\"\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    return env._current_state.inventory[workshop_index] > 0\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    # Check if the specified workshop is in the inventory\n    if if_workshop_in_inventory(env, workshop_name):\n        # If the workshop is in the inventory, use it directly\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n        # Find all positions of the specified workshop in the grid\n        workshop_index = cookbook.index[workshop_name]\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            # Choose the closest available workshop position to craft the item at\n            current_pos = env._current_state.pos\n\n            closest_workshop = min(\n                workshop_positions, \n                key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            )\n            \n            target_workshop_pos = tuple(closest_workshop)\n\n            # Calculate move actions to reach the closest workshop\n            actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n            # Use the USE action to craft the item at the workshop\n            actions_to_take.append(4)\n\n            return actions_to_take\n\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 5.7999997}}
{"timestamp": "2025-09-17T04:18:33.456066", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_primitives_for_item(cookbook, item_index, visited=None):\n    \"\"\"Recursively determine all the primitives needed to craft an item, avoiding infinite loops.\"\"\"\n    if visited is None:\n        visited = set()\n    \n    if item_index in visited:\n        raise ValueError(f\"Detected a circular dependency while crafting {item}.\")\n        \n    visited.add(item_index)\n    \n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index, visited))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def gather_required_items(env, cookbook, recipe):\n    actions = []\n    for required_item_index in recipe.keys():\n        if required_item_index != '_at':\n            count_needed = recipe[required_item_index]\n            current_count = env._current_state.inventory[required_item_index]\n            if current_count < count_needed:\n                # Determine the primitive(s) needed to make this item\n                primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                for primitive in primitives_needed:\n                    actions.extend(collect(env, cookbook.index.get_name(primitive)))\n    return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:19:32.851291", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      actions = []\n      while dx != 0 or dy != 0:\n          if abs(dx) > abs(dy):  # Prioritize moving in the x direction if distance is larger\n              if dx > 0:\n                  actions.append(3)  # RIGHT\n                  dx -= 1\n              else:\n                  actions.append(2)  # LEFT\n                  dx += 1\n          else:  # Otherwise, move in the y direction\n              if dy > 0:\n                  actions.append(1)  # UP\n                  dy -= 1\n              else:\n                  actions.append(0)  # DOWN\n                  dy += 1\n      return actions\n  \n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:24:33.432277", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move_to_target(target_x, target_y):\n    actions = []\n    while True:\n      current_x, current_y = env._current_state.pos\n      \n      if target_x == current_x and target_y == current_y:\n        break\n\n      # Calculate the number of steps needed in each direction\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      # Move in x direction first\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      \n      # Then move in y direction\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n\n    return actions\n\n  actions.extend(move_to_target(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:26:19.631408", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    # Calculate the relative position to move\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    # Determine the sequence of moves needed based on the direction\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n\n  def has_all_prerequisites(item_index, cookbook):\n    \"\"\"Check if all prerequisites for the given item are in the inventory.\"\"\"\n    recipe = cookbook.recipes[item_index]\n    required_items = {k: v for k, v in recipe.items() if k != '_at'}\n    \n    # Check if each required item is available in the inventory\n    for req_item, quantity in required_items.items():\n        if env._current_state.inventory[req_item] < quantity:\n            return False\n    \n    return True\n\n\n  def collect_prerequisites(env, cookbook):\n      \"\"\"Collect all prerequisites needed to craft an item.\"\"\"\n      actions = []\n\n      # Get the index for the desired item to be crafted\n      item_index = cookbook.index[item]\n      \n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n          required_items = {k: v for k, v in recipe.items() if k != '_at'}\n\n          for req_item_index, quantity in required_items.items():\n              # Determine the type of primitive (wood, stone, iron, etc.)\n              primitive_name = cookbook.index.get_by_value(req_item_index)\n              \n              # Collect the required quantity of the primitive\n              actions.extend(collect(env, primitive_name, quantity))\n      \n      return actions\n\n\n  def collect(env, primitive: str, quantity=1) -> list[int]:\n    \"\"\"Collects a specified quantity of a primitive.\"\"\"\n    actions = []\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired primitive to be collected\n    primitive_index = cookbook.index[primitive]\n\n    # Find all positions of the specified primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n    if len(primitive_positions) > 0:\n        for _ in range(quantity):\n            # Choose the closest available primitive position to collect it from\n            current_pos = env._current_state.pos\n\n            closest_primitive = min(\n                primitive_positions, \n                key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            )\n            \n            target_primitive_pos = tuple(closest_primitive)\n\n            # Calculate move actions to reach the closest primitive\n            actions.extend(get_move_actions(target_primitive_pos))\n\n            # Use the USE action to collect the primitive\n            actions.append(4)\n\n    else:\n        raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n    return actions\n\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Ensure all prerequisites are collected\n    actions_to_take = collect_prerequisites(env, cookbook)\n\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n    \n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:26:20.613258", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def collect_primitives(env, primitives):\n      actions_to_take = []\n      \n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          \n          if not env._current_state.next_primitive(primitive_index):  # Assuming a method next_primitive to find the next available primitive\n              continue\n\n          primitive_pos = env._current_state.get_primitive_position(primitive_index)  # Assuming a method get_primitive_position to find the position of the primitive\n\n          actions_to_take.extend(get_move_actions(tuple(primitive_pos)))\n          actions_to_take.append(4)  # Collect action\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  item_index = cookbook.index[item]\n\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  # Collect all required primitives if not in inventory\n  actions_to_take = []\n  if item_index in cookbook.recipes:\n    ingredients = [k for k, v in cookbook.recipes[item_index].items() if k != '_at']\n    \n    # Convert ingredient indices to their names\n    ingredient_names = [env.world.cookbook.index.get(i) for i in ingredients]\n  \n    actions_to_take.extend(collect_primitives(env, ingredient_names))\n\n  actions_to_take.extend(get_move_actions(target_workshop_pos))\n  actions_to_take.append(4)\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:27:22.092455", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          dx = target_x - current_x\n          dy = target_y - current_y\n          \n          if abs(dx) > abs(dy):  # Prioritize horizontal movement\n              if dx > 0:\n                  actions.append(3)  # RIGHT\n                  current_x += 1\n              else:\n                  actions.append(2)  # LEFT\n                  current_x -= 1\n          else:  # Prioritize vertical movement\n              if dy > 0:\n                  actions.append(1)  # UP\n                  current_y += 1\n              else:\n                  actions.append(0)  # DOWN\n                  current_y -= 1\n      \n      return actions\n\n  def craft_item():\n    \"\"\"Perform the USE action to craft the item.\"\"\"\n    return [4]  # USE\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.extend(craft_item())\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:27:23.179928", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move(dx, dy):\n      \"\"\"Move the agent to a specific location.\"\"\"\n      steps_right_or_left = abs(dx)\n      steps_up_or_down = abs(dy)\n\n      # Move horizontally first if it's farther\n      if dx > 0:\n          actions.extend([3] * steps_right_or_left)  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_right_or_left)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.extend([1] * steps_up_or_down)  # UP\n      elif dy < 0:\n          actions.extend([0] * steps_up_or_down)  # DOWN\n\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:28:27.338472", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      directions = []\n      \n      if dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      \n      if dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      \n      return directions\n\n  dx = target_x - current_x\n  dy = target_y - current_y\n  \n  actions.extend(move(dx, dy))\n\n  # Ensure the agent is facing the correct direction before using\n  if env._current_state.dir == 0 and dy > 0:\n    pass  # No change needed\n  elif env._current_state.dir == 1 and dy < 0:\n    pass  # No change needed\n  elif env._current_state.dir == 2 and dx > 0:\n    pass  # No change needed\n  elif env._current_state.dir == 3 and dx < 0:\n    pass  # No change needed\n  else:\n      if dx != 0:  # Change direction based on x-axis movement\n          actions.append(3 if dx > 0 else 2)\n      elif dy != 0:  # Change direction based on y-axis movement\n          actions.append(1 if dy > 0 else 0)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 3.7}}
{"timestamp": "2025-09-17T04:28:28.400655", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      directions = []\n      \n      if dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      \n      if dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n      elif dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      \n      return directions\n\n  dx = target_x - current_x\n  dy = target_y - current_y\n  \n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:29:29.345837", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    while dx != 0 or dy != 0:\n      if dx > 0:\n        actions.append(3)  # RIGHT\n        dx -= 1\n      elif dx < 0:\n        actions.append(2)  # LEFT\n        dx += 1\n      \n      if dy > 0:\n        actions.append(1)  # UP\n        dy -= 1\n      elif dy < 0:\n        actions.append(0)  # DOWN\n        dy += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:29:30.461983", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(3)  # RIGHT\n          dx -= 1\n        else:\n          actions.append(2)  # LEFT\n          dx += 1\n      \n        if dy > 0 and dx == 0:\n          actions.append(1)  # UP\n          dy -= 1\n        elif dy < 0 and dx == 0:\n          actions.append(0)  # DOWN\n          dy += 1\n      \n      else:\n        if dy > 0:\n          actions.append(1)  # UP\n          dy -= 1\n        else:\n          actions.append(0)  # DOWN\n          dy += 1\n      \n        if dx > 0 and dy == 0:\n          actions.append(3)  # RIGHT\n          dx -= 1\n        elif dx < 0 and dy == 0:\n          actions.append(2)  # LEFT\n          dx += 1\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:30:58.664567", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    while current_pos != target_pos:\n      rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.append(3)\n        current_pos = (current_pos[0] + 1, current_pos[1])\n      elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.append(2)\n        current_pos = (current_pos[0] - 1, current_pos[1])\n        \n      if rel_y > 0:\n        # Move DOWN\n        actions_to_take.append(1)\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif rel_y < 0:\n        # Move UP\n        actions_to_take.append(0)\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions_to_take\n\n  def get_closest_workshop(workshop_index):\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          return tuple(closest_workshop)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def pick_up_primitives(primitives):\n    actions_to_take = []\n    \n    # Collect all required primitives\n    for primitive in primitives:\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        # Find positions of the primitive on the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n        \n        if len(primitive_positions) > 0:\n            # Choose the closest position to pick up the primitive\n            current_pos = env._current_state.pos\n\n            closest_primitive = min(\n                primitive_positions, \n                key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n            )\n            \n            target_primitive_pos = tuple(closest_primitive)\n\n            # Calculate move actions to reach the primitive\n            actions_to_take.extend(get_move_actions(target_primitive_pos))\n            \n            # Use the USE action to collect the primitive\n            actions_to_take.append(4)\n        else:\n            raise ValueError(f\"No {primitive} found in the environment.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives from the recipe (assuming they are keys with values indicating quantity)\n    primitives = [key for key, value in recipe.items() if value > 0 and key != '_at']\n\n    # Pick up all required primitives\n    actions_to_take = pick_up_primitives(primitives)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Get the closest workshop position\n    target_workshop_pos = get_closest_workshop(workshop_index)\n    \n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:30:59.800140", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    while current_pos != target_pos:\n      rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      # Prioritize moving horizontally if the relative x distance is greater or equal to the vertical distance\n      if abs(rel_x) >= abs(rel_y):\n        if rel_x > 0:\n          actions_to_take.append(3)\n          current_pos = (current_pos[0] + 1, current_pos[1])\n        elif rel_x < 0:\n          actions_to_take.append(2)\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      else:\n        if rel_y > 0:\n          actions_to_take.append(1)\n          current_pos = (current_pos[0], current_pos[1] + 1)\n        elif rel_y < 0:\n          actions_to_take.append(0)\n          current_pos = (current_pos[0], current_pos[1] - 1)\n\n    return actions_to_take\n\n  def get_closest_workshop(workshop_index):\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          closest_workshop = min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n          )\n          return tuple(closest_workshop)\n      else:\n          raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Get the closest workshop position\n    target_workshop_pos = get_closest_workshop(workshop_index)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take = get_move_actions(target_workshop_pos)\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:31:57.511875", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_target(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_target(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:31:58.620530", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  \n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n      actions_to_take = []\n      \n      if dx > 0:\n          actions_to_take.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions_to_take.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions_to_take.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions_to_take.extend([0] * abs(dy))  # DOWN\n\n      return actions_to_take\n  \n  # Move to the workshop while considering direction changes\n  move_actions = move(dx, dy)\n  actions.extend(move_actions)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:34:01.994332", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def gather_primitive(primitive_index):\n    actions_to_take = []\n    \n    positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(positions) > 0:\n        closest_position = min(\n            positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(tuple(closest_position)))\n        \n        # Align with the target position before collecting.\n        actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n        \n        # Collect the primitive using USE action\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"Primitives not found on the grid.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    # Gather required primitives first.\n    actions_to_take = []\n    for primitive in primitives_needed:\n        primitive_index = cookbook.index[primitive]\n        \n        while env._current_state.inventory.get(primitive_index, 0) < primitives_needed[primitive]:\n            actions_to_take.extend(gather_primitive(primitive_index))\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(tuple(closest_workshop)))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:34:03.086414", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the shortest path using Manhattan distance and direction.\n    if abs(rel_x) > abs(rel_y):\n        # Move horizontally first\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))  # LEFT\n        \n        # Then move vertically\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))  # UP\n    else:\n        # Move vertically first\n        if rel_y > 0:\n            actions_to_take.extend([1] * rel_y)  # DOWN\n        elif rel_y < 0:\n            actions_to_take.extend([0] * abs(rel_y))  # UP\n        \n        # Then move horizontally\n        if rel_x > 0:\n            actions_to_take.extend([3] * rel_x)  # RIGHT\n        elif rel_x < 0:\n            actions_to_take.extend([2] * abs(rel_x))  # LEFT\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_dir = env._current_state.dir\n    target_dir = (workshop_pos[0] - env._current_state.pos[0], workshop_pos[1] - env._current_state.pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n\n    actions_to_take = []\n    for primitive in primitives_needed:\n        primitive_index = cookbook.index[primitive]\n        \n        while env._current_state.inventory.get(primitive_index, 0) < primitives_needed[primitive]:\n            positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(positions) > 0: \n                closest_position = min(\n                    positions, \n                    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n                )\n                \n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(tuple(closest_position)))\n                \n                # Align with the target position before collecting.\n                actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n                \n                # Collect the primitive using USE action\n                actions_to_take.append(4)\n            else:\n                raise ValueError(f\"Primitives {primitive} not found on the grid.\")\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(tuple(closest_workshop)))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:34:57.207244", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n    directions = []\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:34:58.325056", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      actions = []\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  # Move to the workshop\n  actions.extend(move_towards(*closest_workshop_pos))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T04:36:57.982417", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_dir = env._current_state.dir\n    target_dir = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if target_dir == (0, 1) and current_dir != 3:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 2:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 0:\n        return [(current_dir + 3) % 4]\n\n    return []\n\n  def gather_primitives(env, primitives):\n      actions_to_take = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n              positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n              closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              \n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(tuple(closest_position)))\n              \n              # Align with the target position before collecting.\n              actions_to_take.extend(align_with_target(tuple(closest_position)))\n              \n              # Collect the primitive using USE action\n              actions_to_take.append(4)\n      return actions_to_take\n\n  def check_and_move_to_workshop(workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        return get_move_actions(target_workshop_pos) + align_with_target(target_workshop_pos)\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def use_item_at_workshop():\n      actions_to_take = []\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    \n    # Move to the closest available workshop position to craft the item at\n    actions_to_take.extend(check_and_move_to_workshop(workshop_name))\n    \n    # Use the USE action to craft the item at the workshop\n    actions_to_take.extend(use_item_at_workshop())\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:36:59.105404", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_dir = env._current_state.dir\n    target_dir = (target_pos[0] - env._current_state.pos[0], target_pos[1] - env._current_state.pos[1])\n\n    if target_dir == (0, 1) and current_dir != 3:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 2:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 0:\n        return [(current_dir + 3) % 4]\n\n    return []\n\n  def gather_primitives(env, primitives):\n      actions_to_take = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n              positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n              closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              \n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(tuple(closest_position)))\n              \n              # Align with the target position before collecting.\n              actions_to_take.extend(align_with_target(tuple(closest_position)))\n              \n              # Collect the primitive using USE action\n              actions_to_take.append(4)\n      return actions_to_take\n\n  def check_and_move_to_workshop(workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        return get_move_actions(target_workshop_pos) + align_with_target(target_workshop_pos)\n    else:\n        raise ValueError(f\"No workshops found for {workshop_name}.\")\n\n  def craft_item_at_workshop():\n      return [4]  # USE action to craft item\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    \n    # Move to the closest available workshop position to craft the item at\n    actions_to_take.extend(check_and_move_to_workshop(workshop_name))\n    \n    # Craft the item at the workshop using USE action\n    actions_to_take.extend(craft_item_at_workshop())\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:37:56.561544", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to(x, y):\n      current_x, current_y = env._current_state.pos\n      dx = x - current_x\n      dy = y - current_y\n      \n      directions = []\n      \n      if dx > 0:\n          directions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          directions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          directions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          directions.extend([0] * abs(dy))  # DOWN\n\n      return directions\n\n  actions = []\n  \n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n\n  actions.extend(move_to(closest_workshop_pos[0], closest_workshop_pos[1]))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:37:57.660506", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def turn_to_face(dx, dy):\n      if dx > 0:\n          if current_dir != 3:  # RIGHT\n              actions.append((current_dir + 1) % 4)\n      elif dx < 0:\n          if current_dir != 2:  # LEFT\n              actions.append((current_dir - 1) % 4)\n      elif dy > 0:\n          if current_dir != 1:  # UP\n              actions.append(3 if current_dir == 0 else (current_dir + 1) % 4)\n      elif dy < 0:\n          if current_dir != 0:  # DOWN\n              actions.append(2 if current_dir == 3 else (current_dir - 1) % 4)\n\n  def move(dx, dy):\n      turn_to_face(dx, dy)\n      steps = abs(dx) + abs(dy)\n      actions.extend([4] * steps)  # Use action for moving\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -0.10000001}}
{"timestamp": "2025-09-17T04:39:22.500556", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move based on relative positions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def get_all_required_primitives(item):\n      \"\"\"Recursively gather all required primitives for crafting an item.\"\"\"\n      if item not in cookbook.recipes:\n          return [item]\n      \n      recipe = cookbook.recipes[item]\n      required_items = []\n      \n      # Collect all items required by this recipe\n      for key, value in recipe.items():\n          if key == '_at':\n              continue  # Skip the workshop specification\n          \n          required_count = value\n          \n          while required_count > 0:\n              # Recursively get primitives needed for each required item\n              required_items.extend(get_all_required_primitives(key))\n              required_count -= 1\n      \n      return required_items\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Collect all required primitives for crafting the item\n        all_required_primitives = get_all_required_primitives(item_index)\n        print(f\"Required primitives: {all_required_primitives}\")\n\n        actions_to_take = []\n\n        # Check and collect each required primitive if not already in inventory\n        for primitive in all_required_primitives:\n            if env._current_state.inventory[primitive] == 0:\n                # Find positions of the primitive in the grid\n                primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n\n                if len(primitive_positions) > 0:\n                    closest_primitive = min(\n                        primitive_positions, \n                        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                    )\n                    \n                    target_primitive_pos = tuple(closest_primitive)\n\n                    # Calculate move actions to reach the closest primitive\n                    actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n                    # Use the COLLECT action (assuming index 4 corresponds to USE)\n                    actions_to_take.append(4)\n\n        # Finally, calculate move actions to reach the workshop and craft the item\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        actions_to_take.append(4)  # Craft the item at the workshop\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-17T04:39:23.564487", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    recipe = cookbook.recipes[item_index]\n\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T04:41:30.287833", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def handle_missing_workshop(env, workshop_name) -> list[int]:\n    \"\"\"Handle the case when there's no specified workshop in the inventory or grid.\"\"\"\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Determine the primitive(s) needed to make the workshop\n    primitives_needed = get_primitives_for_item(cookbook, cookbook.index[workshop_name])\n    \n    actions_to_take = []\n    for primitive in primitives_needed:\n        actions_to_take.extend(collect(env, primitive))\n        \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    else:\n        # Handle the case when there's no specified workshop in the grid\n        actions_to_take.extend(handle_missing_workshop(env, workshop_name))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n    return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 5.7999997}}
