    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  def get_all_primitives_for_item(env, item_index):\n      cookbook = env.world.cookbook\n      all_primitives = set()\n\n      def collect_primitives(index):\n          if index in cookbook.recipes:\n              recipe = cookbook.recipes[index].copy()\n              del recipe['_at']\n              \n              for primitive_index in recipe:\n                  all_primitives.add(primitive_index)\n                  collect_primitives(primitive_index)\n\n      collect_primitives(item_index)\n      return list(all_primitives)\n\n  def prioritize_primitives(env, primitives):\n      current_pos = env._current_state.pos\n      positions = {}\n\n      for primitive in primitives:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] == 1)\n          \n          if len(primitive_positions) > 0:\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              positions[primitive] = (closest_primitive, abs(closest_primitive[0] - current_pos[0]) + abs(closest_primitive[1] - current_pos[1]))\n      \n      # Sort primitives by proximity\n      return sorted(positions.keys(), key=lambda x: positions[x][1])\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index in cookbook.recipes:\n    all_primitives = get_all_primitives_for_item(env, item_index)\n    prioritized_primitives = prioritize_primitives(env, all_primitives)\n\n    actions_to_take = []\n\n    for primitive_index in prioritized_primitives:\n        if is_item_collected(primitive_index):\n            continue\n        \n        recipe = cookbook.recipes[primitive_index].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, primitive_index))\n\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-18T19:13:39.862675", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        env._current_state.inventory[primitive_index] += 1\n\n  def craft_item_with_retry(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    if not is_item_collected(item_index):\n        actions_to_take.extend(get_move_actions(workshop_pos))\n        actions_to_take.append(4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        \n        if '_at' in recipe:\n            del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item_with_retry(env, item_to_craft))\n\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 9, "scores": {"3": 11.299999}}
{"timestamp": "2025-09-18T19:21:05.347604", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    cookbook = env.world.cookbook\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) == 0:\n        raise ValueError(f\"No primitives found for index {primitive_index}.\")\n    \n    # Choose the closest available position to collect from\n    current_pos = env._current_state.pos\n\n    closest_primitive = min(\n        primitive_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_primitive_pos = tuple(closest_primitive)\n\n    # Calculate move actions to reach the closest primitive\n    actions_to_take = get_move_actions(target_primitive_pos)\n    \n    # Use the USE action to collect the primitive\n    actions_to_take.append(4)\n    \n    # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n    env._current_state.inventory[primitive_index] += 1\n    \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) == 0:\n        raise ValueError(f\"No workshops found for item index {item_index}.\")\n\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    return tuple(closest_workshop)\n\n  def is_item_collected(env, item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(env, hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  def resolve_workshops_unavailability(item_index, cookbook):\n      \"\"\"Resolve unavailability of workshops by crafting missing primitives.\"\"\"\n      workshop_availability = check_workshops_availability(item_index, cookbook)\n      \n      if all(available for available in workshop_availability.values()):\n          return []\n      \n      actions_to_take = []\n      \n      for primitive_index, available in workshop_availability.items():\n          if not available:\n              if primitive_index in cookbook.recipes:\n                  # Recursively resolve unavailability of workshops for the primitive\n                  actions_to_take.extend(resolve_workshops_unavailability(primitive_index, cookbook))\n                  \n                  # Craft the primitive\n                  actions_to_take.extend(craft_item(env, primitive_index))\n      \n      return actions_to_take\n\n  def check_workshops_availability(item_index, cookbook):\n      \"\"\"Check if there are workshops available for all primitives needed.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      workshop_availability = {}\n      for primitive_index in list(recipe.keys()):\n          workshop_name = cookbook.recipes[primitive_index]['_at'] if primitive_index in cookbook.recipes else None\n          if workshop_name:\n              workshop_index = cookbook.index[workshop_name]\n              workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n              workshop_availability[primitive_index] = len(workshop_positions) > 0\n      \n      return workshop_availability\n\n  def get_all_primitives_needed(item_index, cookbook):\n    \"\"\"Recursively collect all primitives needed for an item.\"\"\"\n    recipe = cookbook.recipes[item_index].copy()\n    \n    if '_at' in recipe:\n        del recipe['_at']\n    \n    primitives_needed = set(recipe.keys())\n    \n    for primitive_index in list(primitives_needed):\n        if primitive_index in cookbook.recipes:\n            # Recursively collect all primitives needed for sub-recipes\n            primitives_needed.update(get_all_primitives_needed(primitive_index, cookbook))\n    \n    return primitives_needed\n\n  def prioritize_primitives(primitives_needed, cookbook):\n    \"\"\"Prioritize primitives based on their dependencies.\"\"\"\n    priority_order = []\n    visited = set()\n    \n    def dfs(primitive_index):\n        if primitive_index in visited:\n            return\n        visited.add(primitive_index)\n        \n        if primitive_index in cookbook.recipes:\n            # Recursively prioritize sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            \n            for sub_primitive_index in list(sub_recipe.keys()):\n                dfs(sub_primitive_index)\n        \n        priority_order.append(primitive_index)\n    \n    for primitive_index in primitives_needed:\n        dfs(primitive_index)\n    \n    return priority_order\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    all_primitives_needed = get_all_primitives_needed(item_index, cookbook)\n    priority_order = prioritize_primitives(all_primitives_needed, cookbook)\n\n    actions_to_take = []\n    \n    # Resolve any unavailability of workshops needed to craft the primitives\n    for primitive_index in priority_order:\n        if primitive_index not in cookbook.recipes or is_item_collected(env, primitive_index):\n            continue\n        \n        actions_to_take.extend(resolve_workshops_unavailability(primitive_index, cookbook))\n        \n        # Collect and craft the primitive\n        recipe = cookbook.recipes[primitive_index].copy()\n        del recipe['_at']\n        \n        for _ in range(recipe[primitive_index]):\n            actions_to_take.extend(collect_primitive(env, primitive_index))\n        \n        actions_to_take.extend(craft_item(env, primitive_index))\n\n        # Update inventory after crafting the primitive\n        update_inventory(env, recipe)\n    \n    # Finally, collect and craft the desired item\n    if not is_item_collected(env, item_index):\n        recipe = cookbook.recipes[item_index].copy()\n        del recipe['_at']\n        \n        for _ in range(recipe[primitive_index]):\n            actions_to_take.extend(collect_primitive(env, primitive_index))\n        \n        actions_to_take.extend(craft_item(env, item_index))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-18T19:21:06.325876", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        if primitive_index not in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] = 0\n        env._current_state.inventory[primitive_index] += count\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index, required_count=1):\n      if item_index not in env._current_state.inventory:\n          return False\n      return env._current_state.inventory[item_index] >= required_count\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item'], required_count=hierarchy['prerequisites'][hierarchy['item']] if hierarchy['item'] in hierarchy['prerequisites'] else 1):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index not in cookbook.recipes or is_item_collected(primitive_index):\n            continue\n        \n        # Update inventory recursively for sub-recipes\n        sub_recipe = cookbook.recipes[primitive_index].copy()\n        del sub_recipe['_at']\n        update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        if primitive_index not in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] = 0\n        env._current_state.inventory[primitive_index] += recipe[primitive_index]\n\n  def resolve_workshops_unavailability(item_index, cookbook):\n      \"\"\"Resolve unavailability of workshops by crafting missing primitives.\"\"\"\n      workshop_availability = check_workshops_availability(item_index, cookbook)\n      \n      if all(available for available in workshop_availability.values()):\n          return []\n      \n      actions_to_take = []\n      \n      for primitive_index, available in workshop_availability.items():\n          if not available:\n              if primitive_index in cookbook.recipes:\n                  # Recursively resolve unavailability of workshops for the primitive\n                  actions_to_take.extend(resolve_workshops_unavailability(primitive_index, cookbook))\n                  \n                  # Craft the primitive\n                  actions_to_take.extend(craft_item(env, primitive_index))\n      \n      return actions_to_take\n\n  def check_workshops_availability(item_index, cookbook):\n      \"\"\"Check if there are workshops available for all primitives needed.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      workshop_availability = {}\n      for primitive_index in list(recipe.keys()):\n          workshop_name = cookbook.recipes[primitive_index]['_at'] if primitive_index in cookbook.recipes else None\n          if workshop_name:\n              workshop_index = cookbook.index[workshop_name]\n              workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n              workshop_availability[primitive_index] = len(workshop_positions) > 0\n      \n      return workshop_availability\n\n  def get_all_primitives_needed(item_index, cookbook):\n    \"\"\"Recursively collect all primitives needed for an item.\"\"\"\n    recipe = cookbook.recipes[item_index].copy()\n    \n    if '_at' in recipe:\n        del recipe['_at']\n    \n    primitives_needed = set(recipe.keys())\n    \n    for primitive_index in list(primitives_needed):\n        if primitive_index in cookbook.recipes:\n            # Recursively collect all primitives needed for sub-recipes\n            primitives_needed.update(get_all_primitives_needed(primitive_index, cookbook))\n    \n    return primitives_needed\n\n  def prioritize_primitives(primitives_needed, cookbook):\n    \"\"\"Prioritize primitives based on their dependencies.\"\"\"\n    priority_order = []\n    visited = set()\n    \n    def dfs(primitive_index):\n        if primitive_index in visited:\n            return\n        visited.add(primitive_index)\n        \n        if primitive_index in cookbook.recipes:\n            # Recursively prioritize sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            \n            for sub_primitive_index in list(sub_recipe.keys()):\n                dfs(sub_primitive_index)\n        \n        priority_order.append(primitive_index)\n    \n    for primitive_index in primitives_needed:\n        dfs(primitive_index)\n    \n    return priority_order\n\n  def simulate_action_sequence(env, actions_to_take):\n      \"\"\"Simulate the action sequence to ensure all items are collected and crafted.\"\"\"\n      original_state = env._current_state.copy()\n      \n      for action in actions_to_take:\n          # Execute the action\n          if action == 0:  # Move UP\n              env.move_up()\n          elif action == 1:  # Move DOWN\n              env.move_down()\n          elif action == 2:  # Move LEFT\n              env.move_left()\n          elif action == 3:  # Move RIGHT\n              env.move_right()\n          elif action == 4:  # Use (collect or craft)\n              env.use()\n      \n      return env._current_state\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    all_primitives_needed = get_all_primitives_needed(item_index, cookbook)\n    priority_order = prioritize_primitives(all_primitives_needed, cookbook)\n\n    actions_to_take = []\n    \n    # Resolve any unavailability of workshops needed to craft the primitives\n    for primitive_index in priority_order:\n        if primitive_index not in cookbook.recipes or is_item_collected(primitive_index):\n            continue\n        \n        actions_to_take.extend(resolve_workshops_unavailability(primitive_index, cookbook))\n        \n        # Collect and craft the primitive\n        recipe = cookbook.recipes[primitive_index].copy()\n        del recipe['_at']\n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, primitive_index))\n    \n    # Finally, collect and craft the desired item\n    recipe = cookbook.recipes[item_index].copy()\n    del recipe['_at']\n    actions_to_take.extend(collect_primitives(env, recipe))\n    actions_to_take.extend(craft_item(env, item_index))\n    \n    # Simulate the action sequence to ensure all items are collected and crafted\n    final_state = simulate_action_sequence(env, actions_to_take)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe found for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
