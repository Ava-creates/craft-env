{"timestamp": "2025-09-16T22:02:49.812243", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  i_item = env.world.cookbook.index[item]\n  \n  # Fetch the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Extract the workshop where the item needs to be crafted\n  workshop_index = recipe.pop('_at')\n  i_workshop = env.world.workshop_indices[workshop_index]\n  \n  # Find all workshops on the grid and their positions\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, i_workshop] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for {item} at index {workshop_index}\")\n  \n  # Assume we go to the first workshop in the list (could be improved by choosing nearest one)\n  target_pos = tuple(workshop_positions[0])\n  \n  # Calculate relative direction and move towards the target workshop\n  current_pos = env._current_state.pos\n  delta_x, delta_y = target_pos[1] - current_pos[1], target_pos[0] - current_pos[0]\n  \n  if delta_x > 0:\n    actions.extend([2] * abs(delta_x))  # LEFT\n  elif delta_x < 0:\n    actions.extend([3] * abs(delta_x))  # RIGHT\n  \n  if delta_y > 0:\n    actions.extend([1] * abs(delta_y))  # UP\n  elif delta_y < 0:\n    actions.extend([0] * abs(delta_y))  # DOWN\n  \n  # Use the action to craft the item at the workshop\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T22:02:50.779709", "function_name": "craft", "function_body": "  # Get the index of the target item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find a position next to any of the workshops\n  target_pos = None\n  for y in range(env._current_state.grid.shape[0]):\n    for x in range(env._current_state.grid.shape[1]):\n      if np.any(env._current_state.grid[y, x, workshop_index] > 0):\n        neighbors = [(x+dx, y+dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n        for nx, ny in neighbors:\n          if 0 <= nx < env._current_state.grid.shape[1] and 0 <= ny < env._current_state.grid.shape[0]:\n            target_pos = (nx, ny)\n            break\n      if target_pos:\n        break\n    if target_pos:\n      break\n\n  if not target_pos:\n    raise ValueError(f\"No valid position found next to any workshop for {item}\")\n\n  # Move towards the target position\n  actions_to_take = []\n  current_pos = env._current_state.pos\n  while current_pos != target_pos:\n    dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    if dx > 0 and env._current_state.next_to(env.world.right_index):\n      actions_to_take.append(craft.RIGHT)\n    elif dx < 0 and env._current_state.next_to(env.world.left_index):\n      actions_to_take.append(craft.LEFT)\n    elif dy > 0 and env._current_state.next_to(env.world.down_index):\n      actions_to_take.append(craft.DOWN)\n    elif dy < 0 and env._current_state.next_to(env.world.up_index):\n      actions_to_take.append(craft.UP)\n\n    # Update the current position based on the last action taken\n    if dx > 0:\n      current_pos = (current_pos[0] + 1, current_pos[1])\n    elif dx < 0:\n      current_pos = (current_pos[0] - 1, current_pos[1])\n    elif dy > 0:\n      current_pos = (current_pos[0], current_pos[1] + 1)\n    elif dy < 0:\n      current_pos = (current_pos[0], current_pos[1] - 1)\n\n  # Craft the item at the workshop\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 7, "scores": {"3": -1}}
