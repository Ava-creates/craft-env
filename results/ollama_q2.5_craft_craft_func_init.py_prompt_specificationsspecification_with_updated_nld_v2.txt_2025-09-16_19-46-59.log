{"timestamp": "2025-09-17T07:17:47.501270", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n\n  # Determine the direction to face for moving towards the workshop\n  def move_and_turn(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  def move_towards(x, y):\n    dx = x - current_x\n    dy = y - current_y\n    \n    if dx != 0:\n        actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n        for _ in range(abs(dx)):\n            actions.append(4)  # USE (assuming USE is the action to move forward)\n    if dy != 0:\n        actions.append(1 if dy > 0 else 0)  # UP or DOWN\n        for _ in range(abs(dy)):\n            actions.append(4)  # USE (assuming USE is the action to move forward)\n\n  # Move towards the workshop\n  move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-09-17T07:17:48.562116", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:  # dy < 0\n          return 0  # DOWN\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Determine the direction to face for moving towards the workshop\n  if dx != 0:\n      direction = get_direction(dx, 0)\n      actions.append(direction)  # Change direction first if needed\n      actions.extend([direction] * abs(dx))  # Move in that direction\n  elif dy != 0:\n      direction = get_direction(0, dy)\n      actions.append(direction)  # Change direction first if needed\n      actions.extend([direction] * abs(dy))  # Move in that direction\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 0.7}}
{"timestamp": "2025-09-17T07:18:51.696874", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Determine direction and move accordingly\n      if target_x > current_x:\n          actions.extend([3] * (target_x - current_x))  # RIGHT\n      elif target_x < current_x:\n          actions.extend([2] * (current_x - target_x))  # LEFT\n      \n      if target_y > current_y:\n          actions.extend([1] * (target_y - current_y))  # UP\n      elif target_y < current_y:\n          actions.extend([0] * (current_y - target_y))  # DOWN\n      \n      return actions\n\n  def find_closest_workshop(workshop_positions, current_x, current_y):\n    closest_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n    return closest_pos\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = find_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:18:52.761032", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      while current_x != target_x or current_y != target_y:\n          # Determine direction and move accordingly\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n      \n      return actions\n\n  def find_closest_workshop(workshop_positions, current_x, current_y):\n    closest_pos = min(\n      workshop_positions,\n      key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n    )\n    return closest_pos\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = find_closest_workshop(workshop_positions, current_x, current_y)\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move_to_position(current_x, current_y, target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:20:42.443527", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # Find all positions of the specified primitive in the grid.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive.\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n        # Use the USE action to collect the primitive.\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T07:20:43.426098", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n            \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    # Check the recipe for the item to gather required primitives.\n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      # Collect or craft the first missing item (assuming primitives are directly available).\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      if primitive_index in cookbook.primitives:  # Check if it's a primitive.\n        # Find all positions of the specified primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n          # Choose the closest available primitive position to collect it from.\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the COLLECT action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      else:  # If it's not a primitive, attempt to craft it.\n        actions_to_take.extend(craft_item(env, primitive_index))\n        missing_items[primitive_name] = 0  # Assume the item has been crafted.\n    \n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n      current_pos = env._current_state.pos\n\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop.\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop.\n      actions_to_take.append(4)\n      return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T07:26:40.047634", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Function to move in a specific direction until the agent reaches the target coordinate\n  def move_to_target(target_x, target_y):\n      while env._current_state.pos[0] != target_x or env._current_state.pos[1] != target_y:\n          current_x, current_y = env._current_state.pos\n          if current_x < target_x:\n              actions.append(3)  # RIGHT\n          elif current_x > target_x:\n              actions.append(2)  # LEFT\n          \n          if current_y < target_y:\n              actions.append(1)  # UP\n          elif current_y > target_y:\n              actions.append(0)  # DOWN\n\n  move_to_target(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T07:26:41.194194", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_target(target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      actions = []\n      \n      # Determine the direction to move in X-axis first\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      # Then determine the direction to move in Y-axis\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(move_to_target(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:28:43.735309", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    # Calculate relative position\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    # Determine the path to move towards the target\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n\n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1) and current_dir != 3:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (0, -1) and current_dir != 1:\n        return [(current_dir + 2) % 4]\n    elif target_dir == (1, 0) and current_dir != 2:\n        return [(current_dir + 1) % 4]\n    elif target_dir == (-1, 0) and current_dir != 0:\n        return [(current_dir + 3) % 4]\n\n    return []\n\n  def gather_primitives(env, primitives):\n      actions_to_take = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n              positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n              closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              \n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(tuple(closest_position)))\n              \n              # Align with the target position before collecting.\n              actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n              \n              # Collect the primitive using USE action\n              actions_to_take.append(4)\n      return actions_to_take\n\n  def move_and_align(target_pos):\n    actions_to_take = get_move_actions(target_pos)\n    actions_to_take.extend(align_with_workshop(target_pos))\n    return actions_to_take\n  \n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Move and align with the workshop\n        actions_to_take.extend(move_and_align(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-17T07:28:44.797359", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    target_x, target_y = workshop_pos[0], workshop_pos[1]\n    current_x, current_y = current_pos[0], current_pos[1]\n\n    if target_y > current_y:\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_y < current_y:\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_x > current_x:\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_x < current_x:\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def gather_primitives(env, primitives):\n      actions_to_take = []\n      for primitive in primitives:\n          primitive_index = env.world.cookbook.index[primitive]\n          while env._current_state.inventory.get(primitive_index, 0) == 0:  # Check if the primitive is in inventory\n              positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n              closest_position = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              \n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(tuple(closest_position)))\n              \n              # Align with the target position before collecting.\n              actions_to_take.extend(align_with_workshop(tuple(closest_position)))\n              \n              # Collect the primitive using USE action\n              actions_to_take.append(4)\n      return actions_to_take\n\n  def find_closest_workshop(workshops, current_pos):\n      return min(\n          workshops, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract primitives needed from the recipe\n    primitives_needed = {key: value for key, value in recipe.items() if key in cookbook.index}\n    \n    # Gather required primitives first.\n    actions_to_take = gather_primitives(env, primitives_needed.keys())\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = find_closest_workshop([tuple(pos) for pos in workshop_positions], current_pos)\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-09-17T07:30:28.262638", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n        return target_workshop_pos\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def craft_item(env, workshop_position):\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(workshop_position))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe.pop('_at')\n    \n    # Find the closest workshop position to craft at\n    target_workshop_pos = find_closest_workshop(env, workshop_name)\n\n    # Collect primitives required for crafting\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Craft the item at the specified workshop\n    craft_item(env, target_workshop_pos)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 6, "scores": {"3": 7.2}}
