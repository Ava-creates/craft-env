pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest primitive.\n          actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n          # Use the USE action to collect the primitive.\n          actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n          # Update inventory and missing items count.\n          inventory[primitive_index] += required_amount\n          missing_items.pop(primitive_name, None)\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      elif primitive_name in cookbook.recipes:  # If it's not a primitive, we need to craft it.\n        actions_to_take.extend(craft_v2(env, primitive_name))  # Recursively craft the required item.\n\n        # Update inventory and missing items count.\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n          raise ValueError(f\"Unknown primitive or item: {primitive_name}\")\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item.\n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Fetch the recipe details for the item.\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe.\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at.\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop.\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop.\n        actions_to_take.append(4)\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {}}
{"timestamp": "2025-09-17T07:02:04.574872", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, cookbook.index.get_key(primitive)))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def is_item_craftable(env, cookbook, item_index):\n      \"\"\"Check if the required items to craft the given item are available in inventory or on the grid.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      for ingredient_index in recipe.keys():\n          if ingredient_index != '_at':\n              if env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n                  # Check if this ingredient is available on the grid\n                  if not np.any(env._current_state.grid[:, :, ingredient_index]):\n                      return False\n      return True\n\n  def can_craft_item(env, cookbook, item_index):\n    \"\"\"Check if all required items are either in inventory or can be crafted.\"\"\"\n    recipe = cookbook.recipes[item_index]\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            if env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n                # If not enough in inventory, check if it's craftable\n                if ingredient_index not in cookbook.recipes:\n                    return False  # Primitive item not available on grid\n                if not can_craft_item(env, cookbook, ingredient_index):\n                    return False\n    return True\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n    \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n    if required_item_index not in cookbook.recipes:\n        # This is a primitive item and cannot be crafted\n        raise ValueError(f\"Cannot craft or collect the required primitive: {cookbook.index.get_key(required_item_index)}\")\n\n    recipe = cookbook.recipes[required_item_index]\n    workshop_name = recipe['_at']\n    \n    # Check if the required ingredients are available or can be crafted\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at' and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n            handle_missing_primitives(env, cookbook, ingredient_index)\n    \n    # Craft the item at the specified workshop\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n    target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n    actions_to_take.append(4)\n\n  def craft_item(env, item):\n      \"\"\"Craft the specified item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired item to be crafted\n      item_index = cookbook.index[item]\n      \n      if not can_craft_item(env, cookbook, item_index):\n          raise ValueError(f\"Cannot craft {item} due to missing or uncraftable prerequisites.\")\n\n      recipe = cookbook.recipes[item_index]\n\n      actions_to_take = gather_required_items(env, cookbook, recipe)\n\n      workshop_name = recipe['_at']\n      target_workshop_pos = find_nearest_workshop(env, workshop_name)\n      actions_to_take.extend(get_move_actions(target_workshop_pos))\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  try:\n    return craft_item(env, item)\n  except ValueError as e:\n    return []", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T07:02:05.703841", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at' and env._current_state.inventory[required_item_index] < recipe[required_item_index]:\n              # Determine the primitive(s) needed to make this item\n              primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n              for primitive in primitives_needed:\n                  actions.extend(collect(env, primitive))\n                  \n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n      world = env.world\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting.\")\n\n  def is_item_craftable(env, cookbook, item_index):\n      \"\"\"Check if the required items to craft the given item are available in inventory or on the grid.\"\"\"\n      recipe = cookbook.recipes[item_index]\n      for ingredient_index in recipe.keys():\n          if ingredient_index != '_at':\n              if env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n                  # Check if this ingredient is available on the grid\n                  if not np.any(env._current_state.grid[:, :, ingredient_index]):\n                      return False\n      return True\n\n  def handle_missing_primitives(env, cookbook, required_item_index):\n    \"\"\"Handle missing primitives by crafting them if possible.\"\"\"\n    actions_to_take = []\n\n    # Check if there is a recipe available for this item\n    if required_item_index in cookbook.recipes:\n        recipe = cookbook.recipes[required_item_index]\n        workshop_name = recipe['_at']\n\n        # Ensure all ingredients are available or can be crafted\n        for ingredient_index in recipe.keys():\n            if ingredient_index != '_at' and env._current_state.inventory[ingredient_index] < recipe[ingredient_index]:\n                actions_to_take.extend(handle_missing_primitives(env, cookbook, ingredient_index))\n\n        # Find the nearest workshop to craft this item\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n      recipe = cookbook.recipes[item_index]\n      \n      # Handle missing primitives by crafting them if possible\n      actions_to_take = handle_missing_primitives(env, cookbook, item_index)\n      \n      return actions_to_take\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:03:24.137550", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move(dx, dy):\n      \"\"\"Move the agent to a specific location.\"\"\"\n      actions = []\n      steps_right_or_left = abs(dx)\n      steps_up_or_down = abs(dy)\n\n      # Move horizontally first if it's farther\n      if dx > 0:\n          actions.extend([3] * steps_right_or_left)  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_right_or_left)  # LEFT\n      \n      # Then move vertically\n      if dy > 0:\n          actions.extend([1] * steps_up_or_down)  # UP\n      elif dy < 0:\n          actions.extend([0] * steps_up_or_down)  # DOWN\n\n      return actions\n\n  def get_next_move(current_x, current_y, target_x, target_y):\n      \"\"\"Calculate the next move direction.\"\"\"\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      elif dy < 0:\n          return 0  # DOWN\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  target_x, target_y = closest_workshop_pos\n  while current_x != target_x or current_y != target_y:\n      next_move = get_next_move(current_x, current_y, target_x, target_y)\n      actions.append(next_move)\n\n      # Update the current position based on the move\n      if next_move == 3:  # RIGHT\n          current_x += 1\n      elif next_move == 2:  # LEFT\n          current_x -= 1\n      elif next_move == 1:  # UP\n          current_y += 1\n      elif next_move == 0:  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T07:08:24.153174", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move(dx, dy):\n      \"\"\"Move the agent to a specific location.\"\"\"\n      steps_right_or_left = abs(dx)\n      steps_up_or_down = abs(dy)\n\n      if dx > 0:\n          actions.extend([3] * steps_right_or_left)  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_right_or_left)  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * steps_up_or_down)  # UP\n      elif dy < 0:\n          actions.extend([0] * steps_up_or_down)  # DOWN\n\n  def move_towards(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if abs(dx) > abs(dy):\n        # Move horizontally first if it's farther\n        if dx > 0:\n            actions.append(3)  # RIGHT\n        elif dx < 0:\n            actions.append(2)  # LEFT\n    else:\n        # Otherwise, move vertically first\n        if dy > 0:\n            actions.append(1)  # UP\n        elif dy < 0:\n            actions.append(0)  # DOWN\n\n    reward, done, observations = env.step(actions[-1])\n    return done\n\n  while True:\n      current_x, current_y = env._current_state.pos\n      dx = target_x - current_x\n      dy = target_y - current_y\n\n      if dx == 0 and dy == 0:\n          break\n      \n      move_towards(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
