he grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Determine the direction to move and convert it into actions\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    delta_x = next_pos[0] - best_path[i][0]\n    delta_y = next_pos[1] - best_path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 4.2}}
{"timestamp": "2025-09-17T00:40:30.292043", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # Calculate paths to all possible workshops and choose the shortest one\n  best_path = None\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star(current_pos, target_pos)\n      if path:\n          if not best_path or len(path) < len(best_path):\n              best_path = path\n\n  if not best_path:\n    raise ValueError(f\"No valid path to any workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  # Function to align direction to the target\n  def get_direction_to(target):\n    delta_x = target[0] - env._current_state.pos[0]\n    delta_y = target[1] - env._current_state.pos[1]\n\n    if delta_x < 0:\n        return action_map[\"LEFT\"]\n    elif delta_x > 0:\n        return action_map[\"RIGHT\"]\n    elif delta_y < 0:\n        return action_map[\"DOWN\"]\n    else:\n        return action_map[\"UP\"]\n\n  for i in range(len(best_path) - 1):\n    next_pos = best_path[i + 1]\n    current_dir_action = get_direction_to(next_pos)\n    while env._current_state.dir != current_dir_action:\n      # Turn to the correct direction\n      actions.append(current_dir_action)\n    actions.append(env.action_specs()[\"USE\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:42:12.431337", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def find_missing_items(item_index, cookbook):\n      missing_items = {}\n      if item_index in cookbook.recipes:\n          recipe = cookbook.recipes[item_index]\n          for ingredient, count in recipe.items():\n              if ingredient != '_at':\n                  # Convert ingredient name to index\n                  ingredient_index = cookbook.index[ingredient]\n                  # Check if we have enough of this ingredient in the inventory\n                  if env._current_state.inventory[ingredient_index] < count:\n                      missing_items[ingredient_index] = count - env._current_state.inventory[ingredient_index]\n      return missing_items\n\n  def collect_missing_primitives(env, primitives):\n    actions_to_take = []\n    for primitive_index, needed_count in primitives.items():\n        # Find positions of the primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n        if len(primitive_positions) > 0:\n            current_pos = env._current_state.pos\n\n            for _ in range(needed_count):\n                closest_primitive = min(\n                    primitive_positions, \n                    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                )\n                \n                target_primitive_pos = tuple(closest_primitive)\n\n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n\n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n\n                # Update current position after collection\n                current_pos = target_primitive_pos\n\n        else:\n            raise ValueError(f\"No primitives found for {primitive_index}.\")\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Find missing primitives and collect them first\n    missing_primitives = find_missing_items(item_index, cookbook)\n    \n    actions_to_take = []\n\n    # Collect missing items if any\n    if missing_primitives:\n        actions_to_take.extend(collect_missing_primitives(env, missing_primitives))\n    \n    # Once all required items are collected, proceed to craft the item\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:42:13.429814", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def collect_primitives(env, cookbook, primitives):\n      actions = []\n      for primitive in primitives:\n          primitive_index = cookbook.index[primitive]\n          while env._current_state.inventory[primitive_index] == 0:  # If the inventory does not have the primitive\n              # Find all positions of the specified primitive in the grid\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n              if len(primitive_positions) > 0:\n                  # Choose a random available position to collect the primitive from\n                  target_primitive_pos = tuple(primitive_positions[np.random.choice(len(primitive_positions))])\n\n                  # Calculate move actions to reach the target primitive\n                  move_actions = get_move_actions(target_primitive_pos)\n                  actions.extend(move_actions)\n\n                  # Use the USE action to collect the primitive\n                  actions.append(4)\n              else:\n                  raise ValueError(f\"No {primitive} found in the grid.\")\n      return actions\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Collect all required primitives before crafting\n    required_primitives = [primitive for primitive, amount in recipe.items() if primitive != '_at']\n    actions_to_take = collect_primitives(env, cookbook, required_primitives)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        move_actions = get_move_actions(target_workshop_pos)\n        actions_to_take.extend(move_actions)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-17T00:43:54.091107", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i not in env.world.cookbook.workshop_indices):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
