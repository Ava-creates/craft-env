tive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_index)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T15:44:23.082037", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move vertically first to avoid obstacles.\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n            \n    # Then move horizontally.\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory.copy()\n    \n    actions_to_take = []\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n\n      # Attempt to find positions of the specified primitive.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive.\n\n        inventory[primitive_index] += required_amount\n      else:\n        # If primitives are not directly available, attempt to craft them.\n        if primitive_index in cookbook.recipes:\n          sub_actions = craft_item(env, primitive_index)\n          actions_to_take.extend(sub_actions)\n          inventory.update({i: inv + (sub_actions.count(4) * recipe[i]) for i in recipe if i != '_at'})\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      \n      # Update missing items\n      missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Craft the item.\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory, potentially by crafting them.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 4.6}}
{"timestamp": "2025-09-17T15:44:24.145415", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move in and add the corresponding actions.\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n            \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory.copy()\n    \n    actions_to_take = []\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n\n      # Attempt to find positions of the specified primitive.\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Collect the primitive.\n\n        inventory[primitive_index] += required_amount\n      else:\n        # If primitives are not directly available, attempt to craft them.\n        if primitive_index in cookbook.recipes:\n          sub_actions = craft_item(env, primitive_index)\n          actions_to_take.extend(sub_actions)\n          inventory.update({i: inv + (sub_actions.count(4) * recipe[i]) for i in recipe if i != '_at'})\n        else:\n          raise ValueError(f\"No primitives found for {item}.\")\n      \n      # Update missing items\n      missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    return actions_to_take\n\n  def craft_item(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop.\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        actions_to_take = get_move_actions(target_workshop_pos)\n        actions_to_take.append(4)  # Craft the item.\n        return actions_to_take\n    else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted.\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    # Ensure all required items are in the inventory, potentially by crafting them.\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    # Craft the item at the appropriate workshop.\n    actions_to_take.extend(craft_item(env, item_index))\n  else:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 4.6}}
{"timestamp": "2025-09-17T15:47:03.773410", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Move horizontally first to reduce the area to search vertically\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # LEFT\n    \n    # Then move vertically\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # UP\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              # Check if on top of a primitive or at a workshop\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  def simulate_actions(env, actions):\n      \"\"\"Simulate a sequence of actions to predict the new state.\"\"\"\n      state = env._current_state\n      for action in actions:\n          if action == 0:  # UP\n              state.pos = (state.pos[0], max(0, state.pos[1] - 1))\n          elif action == 1:  # DOWN\n              state.pos = (state.pos[0], min(state.grid.shape[1] - 1, state.pos[1] + 1))\n          elif action == 2:  # LEFT\n              state.pos = (max(0, state.pos[0] - 1), state.pos[1])\n          elif action == 3:  # RIGHT\n              state.pos = (min(state.grid.shape[0] - 1, state.pos[0] + 1), state.pos[1])\n          elif action == 4:  # USE\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Simulate the gathered actions to update the inventory and position\n    simulate_actions(env, actions_to_take)\n    \n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 5.2}}
{"timestamp": "2025-09-17T15:47:04.912232", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def gather_required_items(env, cookbook, recipe):\n      actions = []\n      for required_item_index in recipe.keys():\n          if required_item_index != '_at':\n              required_amount = recipe[required_item_index]\n              current_amount = env._current_state.inventory[required_item_index]\n\n              while current_amount < required_amount:\n                  # Determine the primitive(s) needed to make this item\n                  primitives_needed = get_primitives_for_item(cookbook, required_item_index)\n                  for primitive in primitives_needed:\n                      actions.extend(collect(env, primitive))\n                  \n                  # Update the inventory after collecting\n                  env._current_state.inventory[required_item_index] += 1\n                  current_amount = env._current_state.inventory[required_item_index]\n\n      return actions\n\n  def get_primitives_for_item(cookbook, item_index):\n    \"\"\"Recursively determine all the primitives needed to craft an item.\"\"\"\n    if item_index not in cookbook.recipes:\n        # This is a primitive item\n        return [item_index]\n    \n    recipe = cookbook.recipes[item_index]\n    primitives = set()\n    for ingredient_index in recipe.keys():\n        if ingredient_index != '_at':\n            primitives.update(get_primitives_for_item(cookbook, ingredient_index))\n    return list(primitives)\n\n  def collect(env, primitive) -> list[int]:\n      \"\"\"Returns a list of actions to collect the specified primitive item.\"\"\"\n      cookbook = env.world.cookbook\n\n      # Get the index for the desired primitive to be collected\n      primitive_index = cookbook.index[primitive]\n      \n      # Find all positions of the specified primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n          # Choose the closest available position to collect the item at\n          current_pos = env._current_state.pos\n\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n\n          # Calculate move actions to reach the closest position\n          actions_to_take = get_move_actions(target_primitive_pos)\n\n          # Use the USE action to collect the item\n          actions_to_take.append(4)\n          \n          return actions_to_take\n\n      else:\n          raise ValueError(f\"No primitives found for collecting {primitive}.\")\n\n  def find_nearest_workshop(env, workshop_name):\n    cookbook = env.world.cookbook\n\n    # Get the index for the desired workshop\n    workshop_index = cookbook.index[workshop_name]\n    \n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {workshop_name}.\")\n\n  def update_inventory_after_actions(env, actions):\n      # Simulate the actions to update the inventory\n      state = env._current_state\n      for action in actions:\n          if action == 4:  # USE action\n              # Check if on top of a primitive or at a workshop\n              current_pos = state.pos\n              grid_slice = state.grid[current_pos[0], current_pos[1]]\n              for item_index, value in enumerate(grid_slice):\n                  if value == 1:\n                      # Collect the item and update inventory\n                      state.inventory[item_index] += 1\n                      break\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Gather required items before crafting\n    actions_to_take = gather_required_items(env, cookbook, recipe)\n\n    # Update inventory after gathering required items\n    update_inventory_after_actions(env, actions_to_take)\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n\n    try:\n        # Find nearest workshop to craft the item at\n        target_workshop_pos = find_nearest_workshop(env, workshop_name)\n    except ValueError as e:\n        return actions_to_take + [4]  # If no workshops found, just return collected items\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n    # Use the USE action to craft the item at the workshop\n    actions_to_take.append(4)\n    \n    return actions_to_take\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 2, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T15:47:59.295525", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  while (current_x != target_x) or (current_y != target_y):\n      if current_x < target_x:\n          actions.append(3)  # RIGHT\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(2)  # LEFT\n          current_x -= 1\n\n      if current_y < target_y:\n          actions.append(1)  # UP\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(0)  # DOWN\n          current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T15:48:00.354068", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_towards(x, y):\n      actions = []\n      current_x, current_y = env._current_state.pos\n      \n      while (current_x != x) or (current_y != y):\n          if current_x < x:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > x:\n              actions.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < y:\n              actions.append(1)  # UP\n              current_y += 1\n          elif current_y > y:\n              actions.append(0)  # DOWN\n              current_y -= 1\n          \n      return actions\n  \n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions.extend(move_towards(target_x, target_y))\n  \n  # Final USE to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T15:49:47.232701", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(current_x, current_y, target_x, target_y):\n      actions = []\n      path = collections.deque()\n\n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              path.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              path.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              path.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              path.append(0)  # DOWN\n              current_y -= 1\n\n      return actions, path\n\n  def is_item_in_inventory(item):\n    item_index = env.world.cookbook.index[item]\n    return env._current_state.inventory[item_index] > 0\n\n  def collect_primitives(env, primitives):\n    \"\"\"Helper function to collect all required primitives.\"\"\"\n    actions = []\n    for primitive in primitives:\n        while not is_item_in_inventory(primitive):\n            primitive_index = env.world.cookbook.index[primitive]\n            positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(positions) == 0:\n                raise ValueError(f\"{primitive} not found in the grid.\")\n            \n            closest_primitive_pos = min(\n              positions,\n              key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n            )\n\n            current_x, current_y = env._current_state.pos\n            target_x, target_y = closest_primitive_pos\n\n            actions_to_reach_primitive, path = calculate_path(current_x, current_y, target_x, target_y)\n            actions.extend(actions_to_reach_primitive)\n\n            while path:\n                action = path.popleft()\n                actions.append(action)\n                # Use USE action to pick up the primitive\n                actions.append(4)  # USE\n\n    return actions\n\n  def get_required_primitives(item):\n      goal_index = env.world.cookbook.index[item]\n      recipe = env.world.cookbook.recipes[goal_index]\n      primitives = [env.world.cookbook.index.inverse[index] for index in recipe if index != \"_at\"]\n      return primitives\n\n  actions = []\n  \n  # Check if the item is already in inventory\n  if is_item_in_inventory(item):\n      print(f\"{item} already in inventory.\")\n      return []\n\n  # Get required primitives for crafting the item\n  required_primitives = get_required_primitives(item)\n\n  # Collect all required primitives\n  actions.extend(collect_primitives(env, required_primitives))\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions_to_reach_workshop, path = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(actions_to_reach_workshop)\n\n  while path:\n      action = path.popleft()\n      actions.append(action)\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:49:48.199354", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def calculate_path(current_x, current_y, target_x, target_y):\n      actions = []\n      path = collections.deque()\n\n      while (current_x != target_x) or (current_y != target_y):\n          if current_x < target_x:\n              path.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_x:\n              path.append(2)  # LEFT\n              current_x -= 1\n\n          if current_y < target_y:\n              path.append(1)  # UP\n              current_y += 1\n          elif current_y > target_y:\n              path.append(0)  # DOWN\n              current_y -= 1\n\n      return actions, path\n\n  def is_item_in_inventory(item):\n    item_index = env.world.cookbook.index[item]\n    return env._current_state.inventory[item_index] > 0\n\n  def collect_primitives(env, primitives):\n    actions = []\n    for primitive in primitives:\n        while not is_item_in_inventory(primitive):\n            # Find the position of the primitive in the grid\n            primitive_index = env.world.cookbook.index[primitive]\n            positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n            if len(positions) == 0:\n                raise ValueError(f\"{primitive} not found in the grid.\")\n\n            current_x, current_y = env._current_state.pos\n\n            closest_primitive_pos = min(\n              positions,\n              key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n            )\n\n            # Calculate the relative position of the primitive from the agent's current position\n            target_x, target_y = closest_primitive_pos\n\n            actions_to_reach_primitive, path = calculate_path(current_x, current_y, target_x, target_y)\n\n            actions.extend(actions_to_reach_primitive)\n\n            while path:\n                action = path.popleft()\n                actions.append(action)\n                # Use USE action to collect the primitive\n                actions.append(4)  # USE\n\n    return actions\n\n  actions = []\n  \n  # Check if the item is already in inventory\n  if is_item_in_inventory(item):\n      print(f\"{item} already in inventory.\")\n      return []\n\n  goal_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  primitives = [key for key, value in recipe.items() if key != \"_at\" and value > 0]\n  \n  # Collect all required primitives\n  actions.extend(collect_primitives(env, primitives))\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  actions_to_reach_workshop, path = calculate_path(current_x, current_y, target_x, target_y)\n\n  actions.extend(actions_to_reach_workshop)\n\n  while path:\n      action = path.popleft()\n      actions.append(action)\n      # Use USE action every time we move to avoid getting stuck (this is a heuristic)\n      actions.append(4)  # USE\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-17T15:51:55.583493", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n        \n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def craft_item(env, workshop_index):\n      target_workshop_pos = get_closest_workshop(env, workshop_index)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 5.9999995}}
{"timestamp": "2025-09-17T15:51:56.673351", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def craft_item(env, workshop_index):\n      target_workshop_pos = get_closest_workshop(env, workshop_index)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  def ensure_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n\n    actions_to_take = []\n    while any(count > 0 for count in primitives_needed.values()):\n        for primitive_index, count in list(primitives_needed.items()):\n            # Check if the current inventory has enough of this item\n            if env._current_state.inventory[primitive_index] >= count:\n                del primitives_needed[primitive_index]\n                continue\n\n            # Calculate how many more are needed\n            additional_needed = count - env._current_state.inventory[primitive_index]\n\n            # Find positions of the required primitives in the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n            if len(primitive_positions) > 0:\n                # Choose the closest available position to collect from\n                current_pos = env._current_state.pos\n\n                closest_primitive = min(\n                    primitive_positions, \n                    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                )\n                \n                target_primitive_pos = tuple(closest_primitive)\n\n                # Calculate move actions to reach the closest primitive\n                actions_to_take.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive\n                actions_to_take.append(4)\n                \n                # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                env._current_state.inventory[primitive_index] += 1\n\n            else:\n                raise ValueError(f\"Not enough primitives available in the grid: {cookbook.index.inverse[primitive_index]}\")\n\n    return actions_to_take\n  \n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    try:\n        actions_to_take = ensure_inventory(env, recipe)\n        \n        # Now that we have ensured all required primitives are in inventory, proceed to craft the item\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 6.9999995}}
{"timestamp": "2025-09-17T15:53:59.565760", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def get_closest_resource(env, resource_index):\n    current_pos = env._current_state.pos\n    resource_positions = np.argwhere(env._current_state.grid[:, :, resource_index] == 1)\n\n    if len(resource_positions) > 0:\n        closest_resource = min(\n            resource_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_resource)\n    else:\n        raise ValueError(f\"No resources found for index {resource_index}.\")\n\n  def craft_item(env, workshop_index):\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_index)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    actions_to_take = []\n    \n    # Collect primitives required for crafting if not already in inventory\n    while any(k in env._current_state.inventory and env._current_state.inventory[k] < v for k, v in recipe.items()):\n        for primitive_index, count in recipe.items():\n            if primitive_index in env._current_state.inventory and env._current_state.inventory[primitive_index] >= count:\n                continue\n            \n            try:\n                target_resource_pos = get_closest_resource(env, primitive_index)\n                \n                # Calculate move actions to reach the closest resource\n                actions_to_take.extend(get_move_actions(target_resource_pos))\n                \n                # Use the USE action to collect the primitive/resource\n                actions_to_take.append(4)\n                \n                # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                env._current_state.inventory[primitive_index] += 1\n                \n            except ValueError as e:\n                print(e)  # Log or handle the error appropriately\n                raise\n\n    # Craft the item at the closest available workshop\n    actions_to_take.extend(craft_item(env, workshop_index))\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-17T15:54:00.652309", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def update_inventory(env, recipe):\n      cookbook = env.world.cookbook\n      for primitive_index in recipe.keys():\n          if primitive_index not in env._current_state.inventory:\n              env._current_state.inventory[primitive_index] = 0\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    # Ensure all primitives are in inventory with a count of 0 if not present\n    update_inventory(env, recipe)\n\n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take = collect_primitives(env, recipe)\n\n    try:\n        target_workshop_pos = get_closest_workshop(env, workshop_index)\n        \n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 0.79999995}}
{"timestamp": "2025-09-17T15:56:04.755602", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n            \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def ensure_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    if inventory[item_index] > 0:\n      return []\n    \n    recipe = cookbook.recipes[item_index]\n    missing_items = {i: amount - inventory[i] for i, amount in recipe.items() if i != '_at' and inventory[i] < amount}\n\n    actions_to_take = []\n\n    while missing_items:\n      primitive_name, required_amount = next(iter(missing_items.items()))\n      primitive_index = cookbook.index[primitive_name]\n      \n      # If the primitive is a component or another item that needs crafting\n      if primitive_index in cookbook.recipes:\n        # If it's a craftable item, recursively collect its components.\n        actions_to_take.extend(ensure_inventory(env, primitive_index))\n        \n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n      if len(primitive_positions) > 0:\n        current_pos = env._current_state.pos\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        actions_to_take.append(4)  # Assuming USE is used for collecting as well.\n\n        inventory[primitive_index] += required_amount\n        missing_items.pop(primitive_name, None)\n      else:\n        raise ValueError(f\"No primitives found for {item}.\")\n    \n    return actions_to_take\n\n  def move_towards_workshop(workshop_positions):\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    return get_move_actions(target_workshop_pos) + [4]\n\n  def update_inventory(env, item_index):\n    cookbook = env.world.cookbook\n    recipe = cookbook.recipes[item_index]\n    inventory = env._current_state.inventory\n\n    for ingredient, amount in recipe.items():\n      if ingredient != '_at':\n        inventory[ingredient] -= amount\n    inventory[item_index] += 1\n\n  def get_available_workshops(env):\n    cookbook = env.world.cookbook\n    available_workshops = {name: index for name, index in cookbook.index.items() if 'workshop' in name}\n    \n    return available_workshops\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    actions_to_take = ensure_inventory(env, item_index)\n    \n    recipe = cookbook.recipes[item_index]\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    available_workshops = get_available_workshops(env)\n    \n    if workshop_name not in available_workshops:\n        raise ValueError(f\"Workshop {workshop_name} is not available for crafting {item}.\")\n    \n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        actions_to_take.extend(move_towards_workshop(workshop_positions))\n\n        # Update inventory to reflect crafting\n        update_inventory(env, item_index)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
