{"timestamp": "2025-09-18T01:07:31.233912", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitive(env, primitive_index):\n    \"\"\"Collect a single primitive.\"\"\"\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n    \n    if len(primitive_positions) > 0:\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        actions_to_take = get_move_actions(tuple(closest_primitive))\n        actions_to_take.append(4)  # Use action to collect the primitive\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n        return actions_to_take\n    else:\n        raise ValueError(f\"No primitives found for index {primitive_index}.\")\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      for _ in range(count):\n        actions_to_take.extend(collect_primitive(env, primitive_index))\n        \n    return actions_to_take\n\n  def navigate_and_craft(env, item_index, workshop_positions):\n      current_pos = env._current_state.pos\n      closest_workshop = min(\n          workshop_positions, \n          key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n      )\n      \n      target_workshop_pos = tuple(closest_workshop)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n      \n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n      \n      return actions_to_take\n\n  def check_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index, count in recipe.items():\n      if (primitive_index not in env._current_state.inventory or \n          env._current_state.inventory[primitive_index] < count):\n        return False\n    return True\n\n  def get_recipe_dependencies(cookbook, item_index):\n    dependencies = set()\n    \n    # Use a queue to traverse the dependency tree\n    queue = [item_index]\n    while queue:\n      current_item = queue.pop(0)\n      if current_item in cookbook.recipes:\n        recipe = cookbook.recipes[current_item].copy()\n        del recipe['_at']\n        for primitive_index, count in recipe.items():\n          # If the item is not a primitive (i.e., it has its own recipe), add to dependencies\n          if primitive_index in cookbook.recipes and primitive_index != current_item:\n            queue.append(primitive_index)\n          else:\n            dependencies.add(primitive_index)\n    return dependencies\n\n  def collect_dependencies(env, dependencies):\n    actions_to_take = []\n    for dependency in dependencies:\n      # Check if the primitive is available in inventory\n      if (dependency not in env._current_state.inventory or \n          env._current_state.inventory[dependency] < 1):\n        actions_to_take.extend(collect_primitive(env, dependency))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Get all dependencies (primitives) required to craft the item\n    dependencies = get_recipe_dependencies(cookbook, item_index)\n    \n    # Collect all dependencies that are not in inventory\n    actions_to_take = collect_dependencies(env, dependencies)\n\n    # Check if all primitives are available in inventory\n    if check_inventory(env, recipe):\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n    else:\n        # Collect primitives required for crafting\n        actions_to_take.extend(collect_primitives(env, recipe))\n\n        # Extract the workshop from the original recipe\n        workshop_name = cookbook.recipes[item_index]['_at']\n        workshop_index = cookbook.index[workshop_name]\n\n        # Find all positions of the specified workshop in the grid\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n        if len(workshop_positions) > 0:\n            actions_to_take.extend(navigate_and_craft(env, item_index, workshop_positions))\n        else:\n            raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-18T01:09:47.245179", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_index):\n      \"\"\"Finds and returns the closest workshop position in the grid.\"\"\"\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          return min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n      else:\n          raise ValueError(\"No workshops found in the grid.\")\n\n  def collect_missing_primitives(env, recipe):\n    actions_to_take = []\n    for primitive_index, count_needed in recipe.items():\n        # Calculate how many more primitives are needed\n        count_in_inventory = env._current_state.inventory.get(primitive_index, 0)\n        if count_needed > count_in_inventory:\n            additional_needed = count_needed - count_in_inventory\n            \n            # Find positions of the required primitives in the grid\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            for _ in range(additional_needed):\n                if len(primitive_positions) > 0:\n                    current_pos = env._current_state.pos\n\n                    closest_primitive = min(\n                        primitive_positions, \n                        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                    )\n                    \n                    target_primitive_pos = tuple(closest_primitive)\n\n                    # Calculate move actions to reach the closest primitive\n                    actions_to_take.extend(get_move_actions(target_primitive_pos))\n                    \n                    # Use the USE action to collect the primitive\n                    actions_to_take.append(4)\n                    \n                    # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n                    env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n                    \n                else:\n                    raise ValueError(f\"Not enough primitives of type {primitive_index} in the grid.\")\n                    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    try:\n        # Collect missing primitives required for crafting\n        actions_to_take = collect_missing_primitives(env, recipe)\n\n        closest_workshop_pos = find_closest_workshop(env, workshop_index)\n        target_workshop_pos = tuple(closest_workshop_pos)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    except ValueError as e:\n        print(e)  # Print error message if no workshops are found or not enough primitives\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-18T01:09:48.255510", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, workshop_index):\n      \"\"\"Finds and returns the closest workshop position in the grid.\"\"\"\n      current_pos = env._current_state.pos\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if len(workshop_positions) > 0:\n          return min(\n              workshop_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n      else:\n          raise ValueError(\"No workshops found in the grid.\")\n\n  def handle_inventory(env, recipe):\n      \"\"\"Checks if all required primitives are available and collects them if not.\"\"\"\n      cookbook = env.world.cookbook\n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      \n      actions_to_take = []\n      for primitive_index, count in primitives_needed.items():\n          # Find positions of the required primitives in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n          \n          if len(primitive_positions) > 0:\n              # Choose the closest available position to collect from\n              current_pos = env._current_state.pos\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] += 1\n          else:\n              raise ValueError(f\"Not enough {cookbook.index.get(primitive_index, 'unknown primitive')} available in the grid.\")\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe and remove it\n    workshop_name = recipe.pop('_at')\n    workshop_index = cookbook.index[workshop_name]\n\n    # Ensure all required primitives are collected\n    actions_to_take = handle_inventory(env, recipe)\n\n    try:\n        closest_workshop_pos = find_closest_workshop(env, workshop_index)\n        target_workshop_pos = tuple(closest_workshop_pos)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n    except ValueError as e:\n        print(e)  # Print error message if no workshops are found\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-18T01:12:18.973442", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  def update_inventory(env, recipe):\n    \"\"\"Simulate updating the inventory based on the recipe.\"\"\"\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index in cookbook.recipes:\n            # Update inventory recursively for sub-recipes\n            sub_recipe = cookbook.recipes[primitive_index].copy()\n            del sub_recipe['_at']\n            update_inventory(env, sub_recipe)\n        \n        # Add the primitive to the inventory\n        env._current_state.inventory[primitive_index] += 1\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n\n        # Update inventory after crafting the item\n        update_inventory(env, recipe)\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": 11.199999}}
{"timestamp": "2025-09-18T01:12:20.043404", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def find_closest_workshop(env, item_index):\n    cookbook = env.world.cookbook\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        return tuple(closest_workshop)\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  def is_item_collected(item_index):\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes[item_index].copy()\n      del recipe['_at']\n      \n      # Check if all required primitives are in inventory with sufficient count\n      return all(k in env._current_state.inventory and env._current_state.inventory[k] >= v for k, v in recipe.items())\n\n  def craft_item(env, item_index):\n    actions_to_take = []\n    \n    workshop_pos = find_closest_workshop(env, item_index)\n    actions_to_take.extend(get_move_actions(workshop_pos))\n    actions_to_take.append(4)  # Craft the item\n    \n    return actions_to_take\n\n  def get_recipe_hierarchy(item_index, cookbook):\n      \"\"\"Get a hierarchy of recipes to craft an item.\"\"\"\n      recipe = cookbook.recipes[item_index].copy()\n      \n      if '_at' in recipe:\n          del recipe['_at']\n      \n      primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n      sub_recipes = {}\n\n      # Find recipes for each primitive needed\n      for primitive_index in list(primitives_needed.keys()):\n          if primitive_index in cookbook.recipes:\n              sub_recipes[primitive_index] = get_recipe_hierarchy(primitive_index, cookbook)\n      \n      return {\n          'item': item_index,\n          'prerequisites': primitives_needed,\n          'sub_recipes': sub_recipes\n      }\n\n  def flatten_recipe_hierarchy(hierarchy):\n      \"\"\"Flatten the recipe hierarchy into a list of items to be crafted in order.\"\"\"\n      flattened = []\n      \n      # Add all sub-recipes first\n      for sub_recipe in hierarchy['sub_recipes'].values():\n          flattened.extend(flatten_recipe_hierarchy(sub_recipe))\n      \n      # Then add the current item if it's not already collected\n      if not is_item_collected(hierarchy['item']):\n          flattened.append(hierarchy['item'])\n      \n      return flattened\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index in cookbook.recipes:\n    recipe_hierarchy = get_recipe_hierarchy(item_index, cookbook)\n    \n    items_to_craft = flatten_recipe_hierarchy(recipe_hierarchy)\n\n    actions_to_take = []\n    \n    # Collect all required primitives and craft the items in order\n    for item_to_craft in items_to_craft:\n        if is_item_collected(item_to_craft):\n            continue\n        \n        recipe = cookbook.recipes[item_to_craft].copy()\n        del recipe['_at']\n        \n        actions_to_take.extend(collect_primitives(env, recipe))\n        actions_to_take.extend(craft_item(env, item_to_craft))\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 8, "scores": {"3": 8.6}}
{"timestamp": "2025-09-18T01:14:23.413250", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    actions_to_take = []\n    \n    # Determine direction based on relative position and move accordingly\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n        \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    \n    return actions_to_take\n\n  def collect_primitives(env, recipe):\n    cookbook = env.world.cookbook\n    primitives_needed = {k: v for k, v in recipe.items() if k not in env._current_state.inventory or env._current_state.inventory[k] < v}\n    \n    actions_to_take = []\n    for primitive_index, count in primitives_needed.items():\n      # Find positions of the required primitives in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n      \n      if len(primitive_positions) > 0:\n        # Choose the closest available position to collect from\n        current_pos = env._current_state.pos\n\n        closest_primitive = min(\n            primitive_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_primitive_pos = tuple(closest_primitive)\n\n        # Calculate move actions to reach the closest primitive\n        actions_to_take.extend(get_move_actions(target_primitive_pos))\n        \n        # Use the USE action to collect the primitive\n        actions_to_take.append(4)\n        \n        # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n        env._current_state.inventory[primitive_index] += 1\n        \n    return actions_to_take\n\n  def get_closest_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        return tuple(closest_workshop)\n    else:\n        raise ValueError(\"No workshops found for crafting the item.\")\n\n  def craft_item(env, workshop_index):\n      target_workshop_pos = get_closest_workshop(env, workshop_index)\n\n      # Calculate move actions to reach the closest workshop\n      actions_to_take = get_move_actions(target_workshop_pos)\n\n      # Use the USE action to craft the item at the workshop\n      actions_to_take.append(4)\n\n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Extract the workshop from the original recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n\n    actions_to_take = []\n    \n    # Collect primitives required for crafting if not already in inventory\n    actions_to_take.extend(collect_primitives(env, recipe))\n    \n    try:\n        # Craft the item using the closest available workshop\n        actions_to_take.extend(craft_item(env, workshop_index))\n\n    except ValueError as e:\n        print(e)  # Log or handle the error appropriately\n        raise\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 4, "scores": {"3": 7.2}}
