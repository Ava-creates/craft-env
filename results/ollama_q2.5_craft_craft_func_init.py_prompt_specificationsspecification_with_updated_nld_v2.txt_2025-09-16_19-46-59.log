tive_index] += 1\n        \n    return actions_to_take\n\n  def craft_item_at_workshop(env, workshop_index):\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n    else:\n        raise ValueError(\"No workshops found for crafting.\")\n    \n    return actions_to_take\n\n  def ensure_correct_orientation(actions):\n    \"\"\"Ensure that the agent is facing the correct orientation before performing a USE action.\"\"\"\n    # Assuming the environment requires the agent to face the workshop or primitive\n    # Add necessary orientation changes here if needed (not implemented in this version)\n    return actions\n\n  def update_inventory(env, recipe):\n    cookbook = env.world.cookbook\n    for primitive_index in recipe:\n        if primitive_index not in env._current_state.inventory:\n            env._current_state.inventory[primitive_index] = 0\n        env._current_state.inventory[primitive_index] -= recipe[primitive_index]\n\n    # Simulate crafting the item (just updating inventory)\n    item_index = cookbook.index[item]\n    if item_index not in env._current_state.inventory:\n        env._current_state.inventory[item_index] = 0\n    env._current_state.inventory[item_index] += 1\n\n  def find_and_collect_primitives(env, recipe):\n      actions_to_take = []\n      \n      for primitive_index, count in recipe.items():\n          if primitive_index not in env.world.cookbook.primitives:\n              raise ValueError(f\"Unknown primitive: {primitive_index}\")\n          \n          # Check if the inventory already has enough of this primitive\n          if env._current_state.inventory.get(primitive_index, 0) >= count:\n              continue\n\n          needed_count = count - env._current_state.inventory.get(primitive_index, 0)\n\n          while needed_count > 0:\n              # Find positions of the required primitives in the grid\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n              \n              if len(primitive_positions) == 0:\n                  raise ValueError(f\"Not enough primitives available for crafting: {primitive_index}\")\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions_to_take.extend(get_move_actions(target_primitive_pos))\n              \n              # Use the USE action to collect the primitive\n              actions_to_take.append(4)\n              \n              # Update inventory (this step is just for simulation; actual collection will be handled by the environment)\n              env._current_state.inventory[primitive_index] = env._current_state.inventory.get(primitive_index, 0) + 1\n\n              needed_count -= 1\n      \n      return actions_to_take\n\n  cookbook = env.world.cookbook\n  \n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index].copy()\n\n    # Remove the '_at' key which indicates the workshop\n    del recipe['_at']\n    \n    # Collect primitives required for crafting\n    actions_to_take = find_and_collect_primitives(env, recipe)\n\n    # Extract the workshop from the original recipe\n    workshop_name = cookbook.recipes[item_index]['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Craft the item at the specified workshop\n    actions_to_take.extend(craft_item_at_workshop(env, workshop_index))\n\n    # Ensure correct orientation before performing USE action (if necessary)\n    actions_to_take = ensure_correct_orientation(actions_to_take)\n\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
