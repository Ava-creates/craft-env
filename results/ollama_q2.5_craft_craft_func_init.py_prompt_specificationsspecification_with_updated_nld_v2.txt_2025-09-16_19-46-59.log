he grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-16T23:10:34.053533", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the workshops in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using A*\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n  \n  def a_star(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return None\n  \n  path_to_workshop = a_star(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:10:35.050522", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n\n  if '_at' not in recipe:\n    raise ValueError(f\"No valid workshop found for item: {item}\")\n\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No valid workshop found for item: {item}\")\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using A* search\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return None\n  \n  path_to_workshop = a_star(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(f\"No valid path to workshop for item: {item}\")\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:12:07.277193", "function_name": "craft", "function_body": "  def heuristic(pos1, pos2):\n    # Manhattan distance heuristic\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def find_nearest_workshop(workshop_name):\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    start_pos = env._current_state.pos\n\n    # Perform A* search to find the nearest workshop\n    open_set = []\n    closed_set = set()\n    g_costs = {start_pos: 0}\n    f_costs = {start_pos: heuristic(start_pos, start_pos)}\n    came_from = {}\n\n    heapq.heappush(open_set, (f_costs[start_pos], start_pos))\n\n    while open_set:\n      _, current_pos = heapq.heappop(open_set)\n      if current_pos in closed_set:\n        continue\n\n      closed_set.add(current_pos)\n\n      # Check if the current position contains the workshop\n      if env._current_state.grid[current_pos] == workshop_idx:\n        path = []\n        while current_pos in came_from:\n          path.append(current_pos)\n          current_pos = came_from[current_pos]\n        path.reverse()\n        return path\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for action_name, action in env.action_specs().items():\n          new_pos = tuple(np.array(current_pos) + np.array(env._current_state.world.ACTION_VECTORS[action]))\n          if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n              tentative_g_cost = g_costs[current_pos] + 1\n              if new_pos not in g_costs or tentative_g_cost < g_costs[new_pos]:\n                  came_from[new_pos] = current_pos\n                  g_costs[new_pos] = tentative_g_cost\n                  f_costs[new_pos] = tentative_g_cost + heuristic(new_pos, start_pos)\n                  heapq.heappush(open_set, (f_costs[new_pos], new_pos))\n\n    # If no path is found, return an empty list or raise an error\n    return []\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n\n  actions = []\n  path_to_workshop = find_nearest_workshop(workshop_name)\n  if not path_to_workshop:\n    raise ValueError(f\"Workshop {workshop_name} not reachable from the current position.\")\n\n  # Convert path positions to actions\n  for i in range(len(path_to_workshop) - 1):\n      current_pos = path_to_workshop[i]\n      next_pos = path_to_workshop[i + 1]\n\n      if current_pos[0] < next_pos[0]:\n          actions.append(env.action_specs()[\"DOWN\"])\n      elif current_pos[0] > next_pos[0]:\n          actions.append(env.action_specs()[\"UP\"])\n      elif current_pos[1] < next_pos[1]:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif current_pos[1] > next_pos[1]:\n          actions.append(env.action_specs()[\"LEFT\"])\n\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:12:08.251248", "function_name": "craft", "function_body": "  def a_star_search(start_pos, goal_idx):\n    # A* pathfinding algorithm\n    open_set = set()\n    closed_set = set()\n    g_costs = {start_pos: 0}\n    f_costs = {start_pos: heuristic(start_pos, goal_idx)}\n    came_from = {}\n\n    start_node = (start_pos[0], start_pos[1])\n    open_set.add(start_node)\n\n    while open_set:\n      current = min(open_set, key=lambda x: f_costs[x])\n\n      if env.world.cookbook.index.get(env._current_state.grid[current].nonzero()[0]) == goal_idx:\n        return reconstruct_path(came_from, current)\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for neighbor in get_neighbors(current):\n        if neighbor in closed_set:\n          continue\n\n        tentative_g_cost = g_costs[current] + 1\n        if neighbor not in open_set or tentative_g_cost < g_costs[neighbor]:\n          came_from[neighbor] = current\n          g_costs[neighbor] = tentative_g_cost\n          f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, goal_idx)\n          open_set.add(neighbor)\n\n    return []\n\n  def heuristic(node, goal_idx):\n    # Simple Manhattan distance heuristic\n    goal_pos = get_workshop_position(goal_idx)\n    return abs(node[0] - goal_pos[0]) + abs(node[1] - goal_pos[1])\n\n  def get_neighbors(pos):\n    x, y = pos\n    neighbors = []\n    if x > 0:\n      neighbors.append((x - 1, y))\n    if x < env._current_state.grid.shape[0] - 1:\n      neighbors.append((x + 1, y))\n    if y > 0:\n      neighbors.append((x, y - 1))\n    if y < env._current_state.grid.shape[1] - 1:\n      neighbors.append((x, y + 1))\n    return neighbors\n\n  def reconstruct_path(came_from, current):\n    total_path = [current]\n    while current in came_from:\n        current = came_from[current]\n        total_path.insert(0, current)\n    actions = []\n    for i in range(len(total_path) - 1):\n      dx = total_path[i + 1][0] - total_path[i][0]\n      dy = total_path[i + 1][1] - total_path[i][1]\n      if dx == -1:\n        actions.append(env.action_specs()[\"UP\"])\n      elif dx == 1:\n        actions.append(env.action_specs()[\"DOWN\"])\n      elif dy == -1:\n        actions.append(env.action_specs()[\"LEFT\"])\n      elif dy == 1:\n        actions.append(env.action_specs()[\"RIGHT\"])\n    return actions\n\n  def get_workshop_position(workshop_idx):\n    # This function should find the position of the workshop in the grid\n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if env.world.cookbook.index.get(env._current_state.grid[x, y].nonzero()[0]) == workshop_idx:\n          return (x, y)\n    raise ValueError(\"Workshop not found in the grid\")\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  actions = []\n  path_to_workshop = a_star_search(env._current_state.pos, workshop_idx)\n  actions.extend(path_to_workshop)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:13:56.434176", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              \n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n\n      return actions\n\n  def rotate_direction(current_dir, desired_dir):\n      # Directions are mapped as follows: RIGHT=2, DOWN=0, LEFT=3, UP=1\n      if current_dir == desired_dir:\n          return []\n      elif (current_dir == 2 and desired_dir == 0) or \\\n           (current_dir == 0 and desired_dir == 3) or \\\n           (current_dir == 3 and desired_dir == 1) or \\\n           (current_dir == 1 and desired_dir == 2):\n          return [5]  # Assuming ROTATE_RIGHT action is represented by index 5\n      elif (current_dir == 2 and desired_dir == 1) or \\\n           (current_dir == 0 and desired_dir == 2) or \\\n           (current_dir == 3 and desired_dir == 0) or \\\n           (current_dir == 1 and desired_dir == 3):\n          return [6]  # Assuming ROTATE_LEFT action is represented by index 6\n      else:\n          raise ValueError(\"Invalid direction rotation\")\n\n  def face_towards(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      current_dir = env._current_state.dir  # Assuming the agent has a `dir` attribute for its current facing direction\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              desired_dir = dir_map[direction]\n              actions.extend(rotate_direction(current_dir, desired_dir))\n              current_dir = desired_dir\n              \n              actions.append(dir_map[direction])\n              \n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = face_towards(env, target_pos)\n\n  # Step 3: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:13:57.543569", "function_name": "craft", "function_body": "  def get_direction(current_pos, target_pos):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          return 'DOWN'\n      elif dx < 0:\n          return 'UP'\n      else:\n          if dy > 0:\n              return 'RIGHT'\n          elif dy < 0:\n              return 'LEFT'\n      return None\n\n  def move_to(env, target_pos):\n      actions = []\n      current_pos = env._current_state.pos\n      dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n      \n      while current_pos != target_pos:\n          direction = get_direction(current_pos, target_pos)\n          \n          if direction is not None:\n              actions.append(dir_map[direction])\n              # Simulate the move to update current_pos\n              if direction == 'DOWN':\n                  current_pos = (current_pos[0] + 1, current_pos[1])\n              elif direction == 'UP':\n                  current_pos = (current_pos[0] - 1, current_pos[1])\n              elif direction == 'RIGHT':\n                  current_pos = (current_pos[0], current_pos[1] + 1)\n              elif direction == 'LEFT':\n                  current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  recipe = cookbook.recipes[cookbook.index[item]]\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n  \n  # Find all positions of workshops in the grid that match the required workshop index\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n  \n  # Step 2: Move to one of the workshops (choosing the first available one here)\n  target_pos = tuple(workshop_positions[0])\n  actions = move_to(env, target_pos)\n  \n  # Step 3: Align direction towards the target position if not already aligned\n  current_direction = env._current_state.dir\n  final_direction = get_direction(env._current_state.pos, target_pos)\n  dir_map = {'UP': 1, 'DOWN': 0, 'LEFT': 3, 'RIGHT': 2}\n  \n  while current_direction != final_direction:\n      if current_direction == 'UP' and final_direction == 'LEFT':\n          actions.append(dir_map['LEFT'])\n      elif current_direction == 'UP' and final_direction == 'RIGHT':\n          actions.append(dir_map['RIGHT'])\n      elif current_direction == 'DOWN' and final_direction == 'LEFT':\n          actions.append(dir_map['LEFT'])\n      elif current_direction == 'DOWN' and final_direction == 'RIGHT':\n          actions.append(dir_map['RIGHT'])\n      elif current_direction == 'LEFT' and final_direction == 'UP':\n          actions.append(dir_map['UP'])\n      elif current_direction == 'LEFT' and final_direction == 'DOWN':\n          actions.append(dir_map['DOWN'])\n      elif current_direction == 'RIGHT' and final_direction == 'UP':\n          actions.append(dir_map['UP'])\n      elif current_direction == 'RIGHT' and final_direction == 'DOWN':\n          actions.append(dir_map['DOWN'])\n      \n      # Update the current direction\n      current_direction = final_direction\n  \n  # Step 4: Use the action to craft the item at the workshop\n  actions.append(4)  # Assuming USE action is represented by index 4\n  \n  return actions", "island_id": 0, "scores": {"3": 1.2}}
{"timestamp": "2025-09-16T23:15:09.271300", "function_name": "craft", "function_body": "  def astar(start, goal):\n    # A* algorithm to find the shortest path from start to goal\n    open_set = collections.PriorityQueue()\n    open_set.put((0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while not open_set.empty():\n      _, current = open_set.get()\n\n      if current == goal:\n        return reconstruct_path(came_from, current)\n\n      for neighbor in neighbors(current):\n        tentative_g_score = g_score[current] + dist_between(current, neighbor)\n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current\n          g_score[neighbor] = tentative_g_score\n          f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n          open_set.put((f_score[neighbor], neighbor))\n\n    return None\n\n  def heuristic(a, b):\n      # Manhattan distance heuristic\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def dist_between(a, b):\n      # Distance between two adjacent cells is 1\n      return 1\n\n  def neighbors(position):\n      # Possible neighboring positions (UP, DOWN, LEFT, RIGHT)\n      x, y = position\n      moves = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n      return [move for move in moves if valid_move(position, move)]\n\n  def valid_move(current_pos, next_pos):\n      # Check if the next position is within bounds and not blocked\n      x, y = next_pos\n      width, height = env.scenario.world.grid.shape[:2]\n      if 0 <= x < width and 0 <= y < height:\n          return np.sum(env._current_state.grid[x, y]) == 0\n      return False\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  def path_to_actions(path):\n      # Convert a list of positions to a list of actions\n      actions = []\n      for i in range(1, len(path)):\n          prev = path[i-1]\n          curr = path[i]\n          if curr[0] > prev[0]:\n              actions.append(env.action_specs()[\"DOWN\"])\n          elif curr[0] < prev[0]:\n              actions.append(env.action_specs()[\"UP\"])\n          elif curr[1] > prev[1]:\n              actions.append(env.action_specs()[\"RIGHT\"])\n          else:\n              actions.append(env.action_specs()[\"LEFT\"])\n      return actions\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop\n  def find_workshops():\n      positions = []\n      for x in range(env.scenario.world.grid.shape[0]):\n          for y in range(env.scenario.world.grid.shape[1]):\n              if np.sum(env._current_state.grid[x, y, workshop_idx]) > 0:\n                  positions.append((x, y))\n      return positions\n\n  workshops = find_workshops()\n  if not workshops:\n    raise ValueError(f\"No workshops found for item: {item}\")\n\n  start_pos = env._current_state.pos\n  goal_pos = min(workshops, key=lambda pos: heuristic(start_pos, pos))\n\n  path_to_workshop = astar(start_pos, goal_pos)\n  actions = path_to_actions(path_to_workshop)\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:15:10.392936", "function_name": "craft", "function_body": "  def find_path(start_pos, target_pos):\n      # Implement A* pathfinding algorithm here\n      # For now, let's assume it returns a hardcoded path (UP, RIGHT, RIGHT)\n      return [env.action_specs()[\"UP\"], env.action_specs()[\"RIGHT\"], env.action_specs()[\"RIGHT\"]]\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if not workshop_positions.any():\n    raise ValueError(f\"No workshops found for {workshop_name}\")\n\n  # Assume we choose the first one (in a real scenario, you'd want to find the nearest one)\n  target_pos = tuple(workshop_positions[0])\n\n  actions = []\n  path_to_workshop = find_path(env._current_state.pos, target_pos)\n  actions.extend(path_to_workshop)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T23:15:58.016560", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    for i in range(env._current_state.grid.shape[0]):\n        for j in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[i, j, workshop_index] == 1:\n                return (i, j)\n    return None\n\n  actions = []\n  \n  # Get the position of the workshop\n  workshop_pos = get_workshop_position(item)\n  if workshop_pos is None:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = workshop_pos\n  current_x, current_y = env._current_state.pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop\n  if dy > 0:\n      actions.extend([1] * abs(dy))  # UP\n  elif dy < 0:\n      actions.extend([0] * abs(dy))  # DOWN\n  \n  if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n  elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:15:59.111037", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the required workshop from the recipe for the item\n  goal_index = env.world.cookbook.index[item]\n  workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_index] == 1:\n              workshop_pos = (i, j)\n              break\n      if workshop_pos is not None:\n          break\n\n  if workshop_pos is None:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = workshop_pos\n  current_x, current_y = env._current_state.pos\n  \n  # Determine direction to move based on shortest path heuristic (Manhattan distance)\n  while current_x != target_x or current_y != target_y:\n      dx = target_x - current_x\n      dy = target_y - current_y\n      \n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          else:\n              actions.append(2)  # LEFT\n              current_x -= 1\n      else:\n          if dy > 0:\n              actions.append(1)  # UP\n              current_y += 1\n          else:\n              actions.append(0)  # DOWN\n              current_y -= 1\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:16:43.348899", "function_name": "craft", "function_body": "  actions = []\n\n  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  # Extract the workshop name from the recipe\n  workshop_name = recipe[\"_at\"]\n\n  # Get the index of the workshop\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop on the grid\n  current_state = env._current_state\n\n  # Find positions of all workshops in the grid\n  workshop_positions = np.argwhere(current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  # For simplicity, assume the first occurrence is the correct one.\n  workshop_pos = tuple(workshop_positions[0])\n\n  # Compute relative direction to face the workshop\n  agent_pos = current_state.pos\n  delta_x = workshop_pos[0] - agent_pos[0]\n  delta_y = workshop_pos[1] - agent_pos[1]\n\n  # Determine the actions needed to move towards the workshop\n  if delta_y < 0:\n    actions.append(UP)\n  elif delta_y > 0:\n    actions.append(DOWN)\n\n  if delta_x < 0:\n    actions.append(LEFT)\n  elif delta_x > 0:\n    actions.append(RIGHT)\n\n  # Add action to face the correct direction\n  # (This assumes that once in position, no further direction adjustment is needed)\n  \n  # Finally, add the USE action to craft the item at the workshop\n  actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:16:44.326384", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  i_item = env.world.cookbook.index[item]\n\n  # Find which workshop this item needs to be crafted at\n  recipe = env.world.cookbook.recipes[i_item]\n  required_workshop_name = recipe[\"_at\"]\n  required_workshop_index = env.world.cookbook.index[required_workshop_name]\n\n  # Locate the first available workshop of that type in the grid\n  for pos, cell_contents in np.ndenumerate(env._current_state.grid):\n    if cell_contents[required_workshop_index] == 1:\n      workshop_pos = pos\n      break\n\n  # Compute the direction vector from current position to workshop\n  agent_pos = env._current_state.pos\n  direction_vector = (workshop_pos[0] - agent_pos[0], workshop_pos[1] - agent_pos[1])\n\n  # Convert direction vector into a list of actions needed to reach the workshop\n  actions_to_workshop = []\n  if direction_vector[0] > 0:\n    actions_to_workshop.extend([craft.RIGHT] * abs(direction_vector[0]))\n  elif direction_vector[0] < 0:\n    actions_to_workshop.extend([craft.LEFT] * abs(direction_vector[0]))\n\n  if direction_vector[1] > 0:\n    actions_to_workshop.extend([craft.DOWN] * abs(direction_vector[1]))\n  elif direction_vector[1] < 0:\n    actions_to_workshop.extend([craft.UP] * abs(direction_vector[1]))\n\n  # Add the USE action to craft the item\n  actions_to_craft = actions_to_workshop + [craft.USE]\n\n  return actions_to_craft", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:18:13.920562", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  \n  # Calculate Manhattan distances to each workshop\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny, i_item] == 0:\n                      queue.append((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T23:18:15.051527", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      queue.append((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T23:19:23.780956", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the required workshop from the recipe for the item\n  goal_index = env.world.cookbook.index[item]\n  workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = []\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_index] == 1:\n              workshop_positions.append((i, j))\n\n  if not workshop_positions:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  # Choose the nearest workshop\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y))\n\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop\n  if dy > 0:\n      actions.extend([1] * abs(dy))  # UP\n  elif dy < 0:\n      actions.extend([0] * abs(dy))  # DOWN\n  \n  if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n  elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:19:24.767385", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the required workshop from the recipe for the item\n  goal_index = env.world.cookbook.index[item]\n  workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the workshop in the grid\n  workshop_pos = None\n  for i in range(env._current_state.grid.shape[0]):\n      for j in range(env._current_state.grid.shape[1]):\n          if env._current_state.grid[i, j, workshop_index] == 1:\n              workshop_pos = (i, j)\n              break\n      if workshop_pos is not None:\n          break\n\n  if workshop_pos is None:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = workshop_pos\n  current_x, current_y = env._current_state.pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Determine the shortest path to the workshop using a simple BFS algorithm\n  queue = collections.deque([(current_x, current_y)])\n  visited = set()\n  directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n  parent = {(current_x, current_y): None}\n\n  while queue:\n      x, y = queue.popleft()\n      if (x, y) == workshop_pos:\n          break\n      visited.add((x, y))\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n              if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum() == 0:  # Check if cell is empty\n                  queue.append((nx, ny))\n                  parent[(nx, ny)] = (x, y)\n\n  if workshop_pos not in parent:\n      raise ValueError(\"Path to the workshop not found.\")\n\n  # Reconstruct path from start to target\n  path = []\n  while workshop_pos != (current_x, current_y):\n      path.append(workshop_pos)\n      workshop_pos = parent[workshop_pos]\n\n  path.reverse()\n\n  # Convert path into actions\n  for (x1, y1), (x2, y2) in zip(path[:-1], path[1:]):\n      dx = x2 - x1\n      dy = y2 - y1\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:20:26.940348", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n\n  # Collect all required primitives for crafting from the environment\n  actions_to_collect = []\n  for primitive, count in recipe.items():\n      if primitive.startswith('_'):\n          continue  # Skip metadata fields like '_at'\n\n      i_primitive = env.world.cookbook.index[primitive]\n      \n      while np.sum(env._current_state.grid[:, :, i_primitive]) < count:\n          actions_to_collect.extend(collect_v2(env, primitive))\n  \n  # Craft the item using the improved `craft_v1` function\n  actions_to_craft = craft_v1(env, item)\n  \n  return actions_to_collect + actions_to_craft", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:20:27.910552", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n\n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  \n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n\n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  # Ensure the agent can move to this cell (no obstacles)\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny].sum(axis=2) == 0:\n                      queue.append((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n\n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n\n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n\n      current_pos = next_pos\n\n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:21:08.955762", "function_name": "craft", "function_body": "  # Retrieve the index for the desired item\n  i_goal = env.world.cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[i_goal]\n  \n  # Determine the workshop where the item must be crafted\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find all positions of the required workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No {workshop_name} found on the map.\")\n  \n  # For simplicity, we'll use the first available workshop position\n  workshop_pos = tuple(workshop_positions[0])\n  \n  # Calculate relative direction and distance to the workshop\n  pos_x, pos_y = env._current_state.pos\n  work_x, work_y = workshop_pos\n  \n  delta_x = work_x - pos_x\n  delta_y = work_y - pos_y\n  \n  actions = []\n  \n  # Move horizontally towards the workshop\n  if delta_x > 0:\n      actions.extend([craft.RIGHT] * delta_x)\n  elif delta_x < 0:\n      actions.extend([craft.LEFT] * abs(delta_x))\n  \n  # Move vertically towards the workshop\n  if delta_y > 0:\n      actions.extend([craft.DOWN] * delta_y)\n  elif delta_y < 0:\n      actions.extend([craft.UP] * abs(delta_y))\n  \n  # Craft the item at the workshop\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:21:09.916403", "function_name": "craft", "function_body": "  # Retrieve the goal index from the item name\n  goal_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the goal item\n  if goal_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  recipe = env.world.cookbook.recipes[goal_index]\n  \n  # Determine the workshop index from the recipe\n  workshop_name = recipe[\"_key\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  actions = []\n\n  # Move to the nearest workshop of the specified type (not implemented yet, assuming we already know the position)\n  # Assuming the agent knows the position of the workshop or can find it using a pathfinding algorithm.\n  # For now, let's assume we have a function `find_nearest_workshop` that returns the actions needed to move to the nearest workshop.\n\n  def find_nearest_workshop(env, workshop_index) -> list[int]:\n    \"\"\"Find the nearest workshop of the specified type and return the actions needed to move there.\"\"\"\n    # This is a placeholder for a pathfinding algorithm.\n    # For simplicity, let's assume we can directly move to the workshop without any obstacles.\n    return []\n\n  # Move to the workshop\n  actions.extend(find_nearest_workshop(env, workshop_index))\n\n  # Use the action to craft the item at the workshop\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:21:57.781542", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop\n  if dy > 0:\n      actions.extend([1] * abs(dy))  # UP\n  elif dy < 0:\n      actions.extend([0] * abs(dy))  # DOWN\n  \n  if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n  elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:21:58.913331", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    for i in range(env._current_state.grid.shape[0]):\n        for j in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[i, j, workshop_index] == 1:\n                return (i, j)\n    return None\n\n  def navigate_to_target(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      dy = target_y - current_y\n      dx = target_x - current_x\n      \n      # Move to the workshop\n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      return actions\n\n  actions = []\n  \n  # Get the position of the workshop\n  workshop_pos = get_workshop_position(item)\n  if workshop_pos is None:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  target_x, target_y = workshop_pos\n  current_x, current_y = env._current_state.pos\n\n  actions.extend(navigate_to_target(current_x, current_y, target_x, target_y))\n  \n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-16T23:23:31.786607", "function_name": "craft", "function_body": "  def a_star_search(start, goal, grid):\n      # Define possible moves (UP, DOWN, LEFT, RIGHT)\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      \n      # Priority queue to store the nodes to explore\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      \n      # Dictionary to store the path from start to each node\n      came_from = {}\n      \n      # Dictionary to store the cost of getting to each node\n      g_score = {start: 0}\n      \n      # Function to calculate heuristic (Manhattan distance)\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n          \n          for direction in directions:\n              neighbor = (current[0] + direction[0], current[1] + direction[1])\n              \n              # Check if the neighbor is within bounds and not blocked\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  if np.all(grid[neighbor] == 0):\n                      tentative_g_score = g_score[current] + 1\n                      \n                      if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                          came_from[neighbor] = current\n                          g_score[neighbor] = tentative_g_score\n                          f_score = tentative_g_score + heuristic(neighbor, goal)\n                          heapq.heappush(open_set, (f_score, neighbor))\n      \n      return None\n\n  def find_path(start_pos, target_pos):\n      # Find the path using A* search\n      grid = np.max(env._current_state.grid, axis=2) == 0  # Create a walkable grid based on free cells\n      path = a_star_search(start_pos, target_pos, grid)\n      if not path:\n          return []\n      \n      actions = []\n      directions = {(-1, 0): env.action_specs()[\"UP\"], (1, 0): env.action_specs()[\"DOWN\"],\n                      (0, -1): env.action_specs()[\"LEFT\"], (0, 1): env.action_specs()[\"RIGHT\"]}\n      \n      for i in range(1, len(path)):\n          move = (path[i][0] - path[i-1][0], path[i][1] - path[i-1][1])\n          actions.append(directions[move])\n      \n      return actions\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if not workshop_positions.any():\n    raise ValueError(f\"No workshops found for {workshop_name}\")\n\n  # Assume we choose the first one (in a real scenario, you'd want to find the nearest one)\n  target_pos = tuple(workshop_positions[0])\n\n  actions = []\n  path_to_workshop = find_path(env._current_state.pos, target_pos)\n  actions.extend(path_to_workshop)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:23:32.786192", "function_name": "craft", "function_body": "  def a_star(start, goal, grid):\n      # A* pathfinding implementation\n      open_set = collections.PriorityQueue()\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      open_set.put((f_score[start], start))\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if current == goal:\n              return reconstruct_path(came_from, current)\n\n          for neighbor in neighbors(grid, current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return []\n\n  def heuristic(a, b):\n      # Manhattan distance as heuristic function\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def neighbors(grid, pos):\n      x, y = pos\n      width, height = grid.shape[:2]\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height and grid[nx, ny].sum() == 0: # Assuming empty cells have sum 0\n              yield (nx, ny)\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if not workshop_positions.any():\n    raise ValueError(f\"No workshops found for {workshop_name}\")\n\n  # Assume we choose the first one (in a real scenario, you'd want to find the nearest one)\n  target_pos = tuple(workshop_positions[0])\n\n  actions = []\n  path_to_workshop = a_star(env._current_state.pos, target_pos, env._current_state.grid.sum(axis=2))\n  for pos in path_to_workshop:\n      dx, dy = pos[1] - env._current_state.pos[1], pos[0] - env._current_state.pos[0]\n      if dx == 1:\n          actions.append(env.action_specs()[\"RIGHT\"])\n      elif dx == -1:\n          actions.append(env.action_specs()[\"LEFT\"])\n      elif dy == 1:\n          actions.append(env.action_specs()[\"DOWN\"])\n      elif dy == -1:\n          actions.append(env.action_specs()[\"UP\"])\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:24:56.828265", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star_search(start_pos, target_pos):\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, target_pos)}\n\n      while open_set:\n          current = heapq.heappop(open_set)[1]\n\n          if current == target_pos:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return [env.action_specs()[direction] for direction in path_to_directions(path)]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, target_pos)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return []\n\n  def path_to_directions(path):\n      directions = []\n      for i in range(len(path) - 1):\n          dx = path[i+1][0] - path[i][0]\n          dy = path[i+1][1] - path[i][1]\n\n          if dx == -1:\n              directions.append(\"LEFT\")\n          elif dx == 1:\n              directions.append(\"RIGHT\")\n          elif dy == -1:\n              directions.append(\"UP\")\n          elif dy == 1:\n              directions.append(\"DOWN\")\n\n      return directions\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find all positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if not workshop_positions.any():\n    raise ValueError(f\"No workshops found for {workshop_name}\")\n\n  start_pos = env._current_state.pos\n\n  # Find the nearest workshop using A*\n  min_path = None\n  min_distance = float('inf')\n  for target_pos in map(tuple, workshop_positions):\n      path = a_star_search(start_pos, target_pos)\n      distance = len(path)\n      if distance < min_distance:\n          min_distance = distance\n          min_path = path\n\n  actions = []\n  if min_path:\n      actions.extend(min_path)\n\n  # Add the USE action to craft the item\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:24:57.800383", "function_name": "craft", "function_body": "  def find_nearest_workshop(workshop_name):\n      # Implement A* pathfinding algorithm here\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n      if not workshop_positions.any():\n          raise ValueError(f\"No workshops found for {workshop_name}\")\n\n      # Find the nearest workshop using A* pathfinding\n      start_pos = env._current_state.pos\n\n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n      open_set = []\n      heapq.heappush(open_set, (0, start_pos))\n      came_from = {}\n      g_score = {start_pos: 0}\n      f_score = {start_pos: heuristic(start_pos, tuple(workshop_positions[0]))}\n\n      while open_set:\n          current = heapq.heappop(open_set)[1]\n\n          if current in set(map(tuple, workshop_positions)):\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return [env.action_specs()[direction] for direction in directions_from_path(path)]\n\n          neighbors = get_neighbors(current)\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, tuple(workshop_positions[0]))\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      raise ValueError(\"No path to workshop found\")\n\n  def get_neighbors(position):\n      x, y = position\n      neighbors = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n      valid_neighbors = [n for n in neighbors if 0 <= n[0] < env._current_state.grid.shape[0] and 0 <= n[1] < env._current_state.grid.shape[1]]\n      return valid_neighbors\n\n  def directions_from_path(path):\n      directions = []\n      for i in range(len(path) - 1):\n          dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n          if dx == 1:\n              directions.append(\"RIGHT\")\n          elif dx == -1:\n              directions.append(\"LEFT\")\n          elif dy == 1:\n              directions.append(\"DOWN\")\n          elif dy == -1:\n              directions.append(\"UP\")\n      return directions\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  workshop_name = recipe.pop(\"_at\")\n\n  actions = []\n  path_to_workshop = find_nearest_workshop(workshop_name)\n  actions.extend(path_to_workshop)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:26:14.366056", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:26:15.330676", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    current_x, current_y = current_pos\n    target_x, target_y = target_pos\n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    # Move to the workshop\n    if dy > 0:\n        actions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        actions.extend([0] * abs(dy))  # DOWN\n    \n    if dx > 0:\n        actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        actions.extend([2] * abs(dx))  # LEFT\n\n    return actions\n\n  def find_path_astar(start, goal):\n      # Implement A* search algorithm to find the shortest path from start to goal\n      grid = env._current_state.grid[:, :, :]\n      width, height = grid.shape[0], grid.shape[1]\n      \n      def heuristic(a, b):\n          return abs(b[0] - a[0]) + abs(b[1] - a[1])\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heapq.heappop(open_set)\n          \n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < width and 0 <= neighbor[1] < height and grid[neighbor[0], neighbor[1], env.world.cookbook.index['BOUNDARY']] == 0:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n      return None\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_pos = env._current_state.pos\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n  )\n\n  # Find path to the closest workshop using A* search algorithm\n  path = find_path_astar(current_pos, closest_workshop_pos)\n  if not path:\n      raise ValueError(\"No valid path to the workshop.\")\n\n  for position in path:\n      actions.extend(move_to_position(current_pos, position))\n      current_pos = position\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:27:47.759717", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_item_positions(item_index):\n    return np.argwhere(env._current_state.grid[:, :, item_index] == 1)\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  if item_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe available for crafting {item}.\")\n\n  # Fetch all ingredients needed and their respective indices from the recipe\n  recipe = cookbook.recipes[item_index]\n  required_ingredients = {ingredient: cookbook.index[ingredient] for ingredient in recipe.keys() if ingredient != '_at'}\n\n  # Check if all required ingredients are present in inventory or on the grid\n  missing_ingredients = [ingredient for ingredient, index in required_ingredients.items() if env._current_state.inventory[index] < recipe[ingredient]]\n\n  actions_to_take = []\n\n  # Collect missing ingredients first if any\n  for ingredient in missing_ingredients:\n      ingredient_index = cookbook.index[ingredient]\n      \n      # Find all positions of the ingredient on the grid\n      item_positions = get_item_positions(ingredient_index)\n      \n      if len(item_positions) == 0:\n          raise ValueError(f\"No {ingredient} found on the grid to collect.\")\n\n      closest_item_pos = min(\n          item_positions, \n          key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      )\n      \n      # Calculate move actions to reach the ingredient\n      actions_to_take.extend(get_move_actions(tuple(closest_item_pos)))\n\n      # Use the COLLECT action (index 4 for USE in this context)\n      actions_to_take.append(4)\n\n      # Assume collection reduces the need by one unit\n      env._current_state.inventory[ingredient_index] += 1\n\n  # Now proceed to craft the item\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No workshops found for crafting {item}.\")\n\n  closest_workshop = min(\n      workshop_positions, \n      key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n  )\n  \n  target_workshop_pos = tuple(closest_workshop)\n\n  # Calculate move actions to reach the closest workshop\n  actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions_to_take.append(4)\n\n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:27:48.733197", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * abs(rel_x))\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n        \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * abs(rel_y))\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n\n    return actions_to_take\n\n  def get_primitive_actions(primitive):\n      primitive_index = env.world.cookbook.index[primitive]\n      \n      if not env._current_state.next_grid[primitive_index]:\n          # Find all positions of the specified primitive in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n\n          if len(primitive_positions) > 0:\n              # Choose the closest available primitive position to collect from\n              current_pos = env._current_state.pos\n\n              closest_primitive = min(\n                  primitive_positions, \n                  key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              )\n              \n              target_primitive_pos = tuple(closest_primitive)\n\n              # Calculate move actions to reach the closest primitive\n              actions_to_take = get_move_actions(target_primitive_pos)\n              actions_to_take.append(4)  # Collect action\n\n              return actions_to_take\n          else:\n              raise ValueError(f\"No {primitive} found in the environment.\")\n      else:\n          return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  if item_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe available for crafting {item}.\")\n    \n  actions_to_take = []\n  recipe = cookbook.recipes[item_index]\n  \n  # Collect all required primitives first\n  for key, value in recipe.items():\n      if key != '_at':\n          primitive_actions = get_primitive_actions(key)\n          actions_to_take.extend(primitive_actions)\n\n  # Craft the item after collecting all required primitives\n  workshop_name = recipe['_at']\n  workshop_index = cookbook.index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if len(workshop_positions) > 0:\n    current_pos = env._current_state.pos\n\n    closest_workshop = min(\n        workshop_positions, \n        key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n    )\n    \n    target_workshop_pos = tuple(closest_workshop)\n\n    # Calculate move actions to reach the closest workshop\n    actions_to_take.extend(get_move_actions(target_workshop_pos))\n    actions_to_take.append(4)  # Craft action\n\n    return actions_to_take\n  else:\n      raise ValueError(f\"No workshops found for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:28:52.531389", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos, current_pos, current_dir):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Adjust direction and move horizontally\n      if delta_x > 0:\n          if current_dir != RIGHT:\n              actions.append(RIGHT)\n          actions.extend([RIGHT]*abs(delta_x))  # move right\n      elif delta_x < 0:\n          if current_dir != LEFT:\n              actions.append(LEFT)\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      # Adjust direction and move vertically\n      if delta_y > 0:\n          if current_dir != DOWN:\n              actions.append(DOWN)\n          actions.extend([DOWN]*abs(delta_y))  # move down\n      elif delta_y < 0:\n          if current_dir != UP:\n              actions.append(UP)\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  if len(workshop_positions) == 0:\n      raise ValueError(\"No workshops found for specified item.\")\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(target_workshop_position, current_pos, current_dir))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T23:28:53.603579", "function_name": "craft", "function_body": "  def get_directions_to_target(target_pos, current_pos):\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      actions = []\n      \n      # Move horizontally first\n      if delta_x > 0:\n          actions.extend([RIGHT]*abs(delta_x))  # move right\n      else:\n          actions.extend([LEFT]*abs(delta_x))   # move left\n      \n      # Then move vertically\n      if delta_y > 0:\n          actions.extend([DOWN]*abs(delta_y))  # move down\n      else:\n          actions.extend([UP]*abs(delta_y))    # move up\n      \n      return actions\n  \n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = []\n  \n  # Calculate movement actions needed to reach the target workshop\n  actions.extend(get_directions_to_target(target_workshop_position, current_pos))\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.2}}
{"timestamp": "2025-09-16T23:30:34.352431", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-16T23:30:35.419183", "function_name": "craft", "function_body": "  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal, grid, workshop_index):\n    open_set = set()\n    closed_set = set()\n    g_values = {start: 0}\n    f_values = {start: heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(start)\n\n    while open_set:\n      current = min(open_set, key=f_values.get)\n\n      if current == goal:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1] + [goal]\n\n      open_set.remove(current)\n      closed_set.add(current)\n\n      for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          # Ensure the neighbor is a walkable cell\n          if all(grid[neighbor][i] == 0 for i in range(len(grid[neighbor])) if i != workshop_index):  # Assuming 0 indicates walkable\n            tentative_g_score = g_values[current] + heuristic(current, neighbor)\n            if neighbor not in g_values or tentative_g_score < g_values[neighbor]:\n              came_from[neighbor] = current\n              g_values[neighbor] = tentative_g_score\n              f_values[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n              if neighbor not in open_set:\n                open_set.add(neighbor)\n\n    return []\n\n  actions = []\n  \n  # Get the recipe for the target item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  output_index = index[item]\n\n  if output_index is None:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Retrieve the recipe details\n  recipe = cookbook.recipes[output_index]\n  \n  # Determine the required workshop\n  workshop_name = recipe[\"_at\"]\n  workshop_index = index[workshop_name]\n\n  # Find all positions of the specified workshop in the grid\n  grid = env._current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No available workshops for {item}\")\n\n  current_pos = env._current_state.pos\n\n  # For simplicity, we pick the first available workshop\n  target_pos = tuple(workshop_positions[0])\n\n  # Calculate the path to the target position using A* algorithm\n  path = a_star(current_pos, target_pos, grid, workshop_index)\n\n  if not path:\n    raise ValueError(f\"No valid path to workshop for {item}\")\n\n  # Convert the path into actions\n  action_map = {\n      \"UP\": env.action_specs()[\"UP\"],\n      \"DOWN\": env.action_specs()[\"DOWN\"],\n      \"LEFT\": env.action_specs()[\"LEFT\"],\n      \"RIGHT\": env.action_specs()[\"RIGHT\"]\n  }\n\n  current_dir = env._current_state.dir\n\n  for i in range(len(path) - 1):\n    next_pos = path[i + 1]\n    delta_x = next_pos[0] - path[i][0]\n    delta_y = next_pos[1] - path[i][1]\n\n    if delta_x < 0:\n        actions.append(action_map[\"LEFT\"])\n    elif delta_x > 0:\n        actions.append(action_map[\"RIGHT\"])\n    elif delta_y < 0:\n        actions.append(action_map[\"DOWN\"])\n    else:\n        actions.append(action_map[\"UP\"])\n\n  # Add action to use the workshop for crafting\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 8, "scores": {"3": 4.2}}
{"timestamp": "2025-09-16T23:32:05.456761", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    actions_to_take = []\n\n    # Calculate the direction to move in\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    if rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    elif rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n\n    if rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n    elif rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n\n    return actions_to_take\n\n  def collect_primitives(primitives):\n      actions_to_collect = []\n      \n      for primitive in primitives:\n          primitive_index = cookbook.index[primitive]\n          \n          if primitive_index not in env.world.cookbook.grabs:\n              raise ValueError(f\"Cannot collect {primitive} as it's not a grabbable item.\")\n              \n          # Find positions of the primitive in the grid\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"No {primitive} found to collect.\")\n          \n          # Choose the closest available primitive position to collect from\n          current_pos = env._current_state.pos\n          closest_primitive = min(\n              primitive_positions, \n              key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n          )\n          \n          target_primitive_pos = tuple(closest_primitive)\n          \n          # Calculate move actions to reach the closest primitive position\n          actions_to_collect.extend(get_move_actions(target_primitive_pos))\n          \n          # Use the USE action to collect the primitive\n          actions_to_collect.append(4)\n          \n      return actions_to_collect\n\n  def get_required_primitives(item_index):\n    if item_index not in cookbook.recipes:\n        raise ValueError(f\"No recipe available for crafting {item}.\")\n        \n    required_items = []\n    \n    # Recursively gather all primitives needed for the item\n    def gather_primitives(item_index):\n        if item_index not in cookbook.recipes:\n            # It's a primitive item, add to the list of primitives to collect\n            required_items.append(cookbook.index[item_index])\n        else:\n            recipe = cookbook.recipes[item_index]\n            del recipe['_at']  # Exclude '_at' from the items needed for crafting\n            for ingredient, count in recipe.items():\n                if ingredient != \"_at\":\n                    ingredient_index = cookbook.index[ingredient]\n                    gather_primitives(ingredient_index)\n\n    gather_primitives(item_index)\n    \n    return required_items\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n\n  # Get all primitives needed to craft the item\n  required_primitives = get_required_primitives(item_index)\n\n  actions_to_collect = collect_primitives([cookbook.index[primitive] for primitive in required_primitives if primitive not in env._current_state.inventory])\n\n  # After collecting all primitives, proceed to craft the item\n  actions_to_craft = craft_v0(env, item)\n\n  return actions_to_collect + actions_to_craft", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:32:06.526206", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n\n        # Turn to face the workshop if necessary. Here, we assume that the agent needs to be in front of the workshop to use it.\n        current_dir = env._current_state.dir\n        target_dir = (closest_workshop[0] - current_pos[0], closest_workshop[1] - current_pos[1])\n        \n        # Convert target direction into action\n        if target_dir == (0, 1):\n            if current_dir != 3:\n                actions_to_take.append((current_dir + 2) % 4)\n        elif target_dir == (0, -1):\n            if current_dir != 1:\n                actions_to_take.append((current_dir + 2) % 4)\n        elif target_dir == (1, 0):\n            if current_dir != 3:\n                actions_to_take.append((current_dir + 1) % 4)\n        elif target_dir == (-1, 0):\n            if current_dir != 1:\n                actions_to_take.append((current_dir + 3) % 4)\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:33:01.610351", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:33:02.691200", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move(dx, dy):\n    directions = []\n    if dx > 0:\n        directions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n        directions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n        directions.extend([1] * abs(dy))  # UP\n    elif dy < 0:\n        directions.extend([0] * abs(dy))  # DOWN\n\n    return directions\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move(dx, dy))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:34:38.434172", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    \n    return actions_to_take\n\n  def ensure_orientation(target_dir):\n      current_dir = env._current_state.dir\n      if target_dir == (0, 1) and current_dir != 3: \n          return [(current_dir + 2) % 4]\n      elif target_dir == (0, -1) and current_dir != 1:  \n          return [(current_dir + 2) % 4]\n      elif target_dir == (1, 0) and current_dir != 3:\n          return [(current_dir + 1) % 4]\n      elif target_dir == (-1, 0) and current_dir != 1:\n          return [(current_dir + 3) % 4]\n      return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Determine target direction based on relative position to the workshop\n        rel_x, rel_y = closest_workshop[0] - current_pos[0], closest_workshop[1] - current_pos[1]\n        if rel_x > 0:\n            target_dir = (1, 0)  # East\n        elif rel_x < 0:\n            target_dir = (-1, 0) # West\n        else:\n            target_dir = (0, 0)\n            \n        if rel_y > 0:\n            target_dir = (0, 1)  # South\n        elif rel_y < 0:\n            target_dir = (0, -1) # North\n        \n        if target_dir != (0, 0):\n            actions_to_take.extend(ensure_orientation(target_dir))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.7}}
{"timestamp": "2025-09-16T23:34:39.530809", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Determine the direction to move and append corresponding actions\n    if rel_x > 0:\n        actions_to_take.extend([3] * rel_x)  # Move RIGHT\n    elif rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    \n    if rel_y > 0:\n        actions_to_take.extend([1] * rel_y)  # Move DOWN\n    elif rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n\n    return actions_to_take\n\n  def align_with_target(target_pos):\n    current_pos = env._current_state.pos\n    target_dir = (target_pos[0] - current_pos[0], target_pos[1] - current_pos[1])\n    current_dir = env._current_state.dir\n    \n    # Determine the direction to turn and append corresponding actions\n    if target_dir == (0, 1) and current_dir != 3:\n        actions_to_take.append((current_dir + 2) % 4)\n    elif target_dir == (0, -1) and current_dir != 1:\n        actions_to_take.append((current_dir + 2) % 4)\n    elif target_dir == (1, 0) and current_dir != 3:\n        actions_to_take.append((current_dir + 1) % 4)\n    elif target_dir == (-1, 0) and current_dir != 1:\n        actions_to_take.append((current_dir + 3) % 4)\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Initialize the actions list\n        actions_to_take = []\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n\n        # Align with the target direction\n        align_with_target(target_workshop_pos)\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:36:05.900852", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using a simple BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n      \n      while queue:\n          current = queue.popleft()\n          if current == goal:\n              path = []\n              while current is not None:\n                  path.append(current)\n                  current = parent[current]\n              return path[::-1]  # Reverse the path to start from 'start'\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny, i_item] == 0:\n                      queue.append((nx, ny))\n                      parent[(nx, ny)] = current\n      \n      return None\n  \n  path_to_workshop = bfs(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {'UP': 0, 'DOWN': 1, 'LEFT': 2, 'RIGHT': 3}\n  current_pos = agent_pos\n  \n  for next_pos in path_to_workshop:\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n      \n      if dx == -1:\n          actions.append(dir_map['UP'])\n      elif dx == 1:\n          actions.append(dir_map['DOWN'])\n      elif dy == -1:\n          actions.append(dir_map['LEFT'])\n      elif dy == 1:\n          actions.append(dir_map['RIGHT'])\n      \n      current_pos = next_pos\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T23:36:07.116517", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[i_item]\n  \n  # Identify the workshop where the item must be crafted\n  workshop_name = recipe['_at']\n  i_workshop = env.world.cookbook.index[workshop_name]\n  \n  # Find the position of the nearest workshop in the grid\n  grid = env._current_state.grid\n  \n  # Filter out positions that contain the desired workshop type\n  workshop_positions = np.argwhere(grid[:, :, i_workshop] > 0)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(\"No valid workshop found for item: {}\".format(item))\n  \n  # Determine the nearest workshop to the agent's current position\n  agent_pos = env._current_state.pos\n  distances = np.sum(np.abs(workshop_positions - agent_pos), axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n  nearest_workshop_pos = tuple(workshop_positions[nearest_workshop_idx])\n  \n  # Calculate the path to the nearest workshop using A* algorithm for better efficiency\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          current, path = queue.popleft()\n          \n          if current == goal:\n              return path\n          \n          visited.add(current)\n          x, y = current\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited and env._current_state.grid[nx, ny, i_item] == 0:\n                      queue.append(((nx, ny), path + [(dx, dy)]))\n      \n      return None\n  \n  path_to_workshop = a_star(agent_pos, nearest_workshop_pos)\n  \n  if path_to_workshop is None:\n    raise ValueError(\"No valid path to workshop for item: {}\".format(item))\n  \n  # Translate the path into a sequence of actions (UP, DOWN, LEFT, RIGHT)\n  actions = []\n  dir_map = {(-1, 0): 0, (1, 0): 1, (0, -1): 2, (0, 1): 3}\n  \n  for dx, dy in path_to_workshop:\n      actions.append(dir_map[(dx, dy)])\n  \n  # Append the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by index 4\n  \n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-09-16T23:42:16.221715", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move(target_x, target_y):\n      actions = []\n      while (target_x != env._current_state.pos[0]) or (target_y != env._current_state.pos[1]):\n          dx = target_x - env._current_state.pos[0]\n          dy = target_y - env._current_state.pos[1]\n\n          if dx > 0:\n              actions.append(3)  # RIGHT\n          elif dx < 0:\n              actions.append(2)  # LEFT\n          \n          if dy > 0:\n              actions.append(1)  # UP\n          elif dy < 0:\n              actions.append(0)  # DOWN\n\n          # Execute the action and update the state\n          action = actions[-1]\n          reward, done, observations = env.step(action)\n      return actions\n\n  # Move to the workshop while considering direction changes\n  actions.extend(move(target_x, target_y))\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:42:17.345497", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n  current_dir = env._current_state.dir\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n\n  def move_to_target(target_x, target_y):\n    nonlocal actions, current_dir\n    directions = {\n        0: (2, 3),  # DOWN -> LEFT or RIGHT\n        1: (2, 3),  # UP   -> LEFT or RIGHT\n        2: (0, 1),  # LEFT -> DOWN or UP\n        3: (0, 1)   # RIGHT-> DOWN or UP\n    }\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n\n    if dx > 0:\n      # Move right\n      while current_dir != 3:\n        actions.append((current_dir + 1) % 4)\n        current_dir = (current_dir + 1) % 4\n      actions.extend([3] * abs(dx))\n    elif dx < 0:\n      # Move left\n      while current_dir != 2:\n        actions.append((current_dir - 1) % 4)\n        current_dir = (current_dir - 1) % 4\n      actions.extend([2] * abs(dx))\n\n    if dy > 0:\n      # Move up\n      while current_dir != 1:\n        actions.append((current_dir + 1) % 4)\n        current_dir = (current_dir + 1) % 4\n      actions.extend([1] * abs(dy))\n    elif dy < 0:\n      # Move down\n      while current_dir != 0:\n        actions.append((current_dir - 1) % 4)\n        current_dir = (current_dir - 1) % 4\n      actions.extend([0] * abs(dy))\n\n  move_to_target(target_x, target_y)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 3.7}}
{"timestamp": "2025-09-16T23:43:35.470952", "function_name": "craft", "function_body": "  def get_direction(x_target, y_target, x_current, y_current):\n    delta_x = x_target - x_current\n    delta_y = y_target - y_current\n\n    if delta_x > 0:\n      return RIGHT\n    elif delta_x < 0:\n      return LEFT\n    else:\n      return None\n\n    if delta_y > 0:\n      return DOWN\n    elif delta_y < 0:\n      return UP\n    else:\n      return None\n\n  def move_to_position(current_pos, target_pos):\n    actions = []\n    x_current, y_current = current_pos\n    x_target, y_target = target_pos\n\n    direction_x = get_direction(x_target, y_target, x_current, y_current)\n    if direction_x:\n      actions.extend([direction_x] * abs(x_target - x_current))\n\n    # Check and adjust direction after moving horizontally\n    if y_target > y_current:\n      actions.append(DOWN)\n    elif y_target < y_current:\n      actions.append(UP)\n\n    direction_y = get_direction(x_target, y_target, x_current, y_current)\n    if direction_y:\n      actions.extend([direction_y] * abs(y_target - y_current))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Create a list to store the actions\n  actions = move_to_position(current_pos, target_workshop_position)\n  \n  # Finally, use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-16T23:43:36.536555", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes[item_index]\n  \n  # Determine the workshop specified in the recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_index = env.world.cookbook.index[workshop_name]\n\n  # Find positions of all workshops on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  \n  # Assume there is at least one workshop of that type in the environment, take the first one.\n  target_workshop_position = tuple(workshop_positions[0])\n  \n  # Get current position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  # Define directions as constants for clarity\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 3, 2, 4\n  \n  # Calculate relative positions\n  delta_x = target_workshop_position[0] - current_pos[0]\n  delta_y = target_workshop_position[1] - current_pos[1]\n\n  # Calculate the shortest path to the workshop considering the direction changes\n  actions = []\n\n  # Function to turn in a specific direction based on current and desired directions\n  def change_direction(current_dir, target_dir):\n      if (current_dir == UP and target_dir == LEFT) or \\\n         (current_dir == DOWN and target_dir == RIGHT) or \\\n         (current_dir == LEFT and target_dir == DOWN) or \\\n         (current_dir == RIGHT and target_dir == UP):\n          return [LEFT]\n      elif (current_dir == UP and target_dir == RIGHT) or \\\n           (current_dir == DOWN and target_dir == LEFT) or \\\n           (current_dir == LEFT and target_dir == UP) or \\\n           (current_dir == RIGHT and target_dir == DOWN):\n          return [RIGHT]\n      else:\n          return []\n\n  # Determine the direction needed to move horizontally\n  if delta_x > 0:\n      target_horizontal_direction = RIGHT\n  elif delta_x < 0:\n      target_horizontal_direction = LEFT\n  else:\n      target_horizontal_direction = current_dir\n\n  # Turn to the horizontal direction and move\n  actions.extend(change_direction(current_dir, target_horizontal_direction))\n  actions.extend([target_horizontal_direction] * abs(delta_x))\n\n  # Determine the direction needed to move vertically\n  if delta_y > 0:\n      target_vertical_direction = DOWN\n  elif delta_y < 0:\n      target_vertical_direction = UP\n  else:\n      target_vertical_direction = current_dir\n\n  # Turn to the vertical direction and move\n  actions.extend(change_direction(target_horizontal_direction, target_vertical_direction))\n  actions.extend([target_vertical_direction] * abs(delta_y))\n\n  # Use the USE action at the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.4}}
{"timestamp": "2025-09-16T23:45:06.887058", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    if rel_x > 0:\n        # Move RIGHT\n        actions_to_take.extend([3] * rel_x)\n    elif rel_x < 0:\n        # Move LEFT\n        actions_to_take.extend([2] * abs(rel_x))\n            \n    if rel_y > 0:\n        # Move DOWN\n        actions_to_take.extend([1] * rel_y)\n    elif rel_y < 0:\n        # Move UP\n        actions_to_take.extend([0] * abs(rel_y))\n    return actions_to_take\n\n  def get_direction_actions(target_dir):\n    current_dir = env._current_state.dir\n    target_x, target_y = target_dir[0], target_dir[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to face based on the relative position of the target\n    if target_x > 0:\n        # Face RIGHT\n        target_direction = 3\n    elif target_x < 0:\n        # Face LEFT\n        target_direction = 2\n    elif target_y > 0:\n        # Face DOWN\n        target_direction = 1\n    elif target_y < 0:\n        # Face UP\n        target_direction = 0\n\n    if current_dir != target_direction:\n        actions_to_take.append((current_dir + (target_direction - current_dir) % 4) % 4)\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Calculate direction actions to face the workshop if necessary\n        rel_x, rel_y = closest_workshop[0] - current_pos[0], closest_workshop[1] - current_pos[1]\n        actions_to_take.extend(get_direction_actions((rel_x, rel_y)))\n\n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 0.7}}
{"timestamp": "2025-09-16T23:45:07.964465", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine the direction needed to face the workshop.\n    target_dir = (workshop_pos[0] - current_pos[0], workshop_pos[1] - current_pos[1])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take = get_move_actions(target_workshop_pos)\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": 4.8999996}}
{"timestamp": "2025-09-16T23:47:14.561238", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_dir = env._current_state.dir\n    target_dir = (workshop_pos[1] - env._current_state.pos[1], workshop_pos[0] - env._current_state.pos[0])\n\n    # Determine the direction needed to face the workshop.\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [2] if current_dir != 2 else []     # Face LEFT\n    elif target_dir == (-1, 0):\n        return [0] if current_dir != 0 else []     # Face UP\n    elif target_dir == (1, 0):\n        return [1] if current_dir != 1 else []     # Face DOWN\n\n    return []\n\n  def collect_primitives(env, recipe):\n    actions = []\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n    \n    for primitive_name in recipe:\n        if recipe[primitive_name] > 0 and cookbook.index[primitive_name] not in inventory:\n            # Find the position of the primitive resource in the grid\n            primitive_index = cookbook.index[primitive_name]\n            primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] == 1)\n            \n            if len(primitive_positions) > 0:\n                # Choose the closest available primitive position to collect it from.\n                current_pos = env._current_state.pos\n                closest_primitive = min(\n                    primitive_positions, \n                    key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n                )\n                \n                target_primitive_pos = tuple(closest_primitive)\n                \n                # Calculate move actions to reach the closest primitive\n                actions.extend(get_move_actions(target_primitive_pos))\n                \n                # Use the USE action to collect the primitive resource\n                actions.append(4)\n            else:\n                raise ValueError(f\"No {primitive_name} resources found in the environment.\")\n    return actions\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Remove the '_at' key as it's not a primitive requirement\n    del recipe['_at']\n\n    # Collect all required primitives for crafting the item if they are missing in inventory.\n    actions_to_take = collect_primitives(env, recipe)\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:47:15.523833", "function_name": "craft", "function_body": "  def get_move_actions(target_pos):\n    current_pos = env._current_state.pos\n    rel_x, rel_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n\n    actions_to_take = []\n    \n    # Calculate the direction to move based on relative position.\n    if rel_x < 0:\n        actions_to_take.extend([2] * abs(rel_x))  # Move LEFT\n    elif rel_x > 0:\n        actions_to_take.extend([3] * rel_x)       # Move RIGHT\n    \n    if rel_y < 0:\n        actions_to_take.extend([0] * abs(rel_y))  # Move UP\n    elif rel_y > 0:\n        actions_to_take.extend([1] * rel_y)       # Move DOWN\n    \n    return actions_to_take\n\n  def align_with_workshop(workshop_pos):\n    current_dir = env._current_state.dir\n    target_dir = (workshop_pos[1] - env._current_state.pos[1], workshop_pos[0] - env._current_state.pos[0])\n\n    if target_dir == (0, 1):\n        return [3] if current_dir != 3 else []     # Face RIGHT\n    elif target_dir == (0, -1):\n        return [1] if current_dir != 1 else []     # Face LEFT\n    elif target_dir == (-1, 0):\n        return [2] if current_dir != 2 else []     # Face UP\n    elif target_dir == (1, 0):\n        return [0] if current_dir != 0 else []     # Face DOWN\n\n    return []\n\n  def check_inventory(item_index, recipe):\n    cookbook = env.world.cookbook\n    inventory = env._current_state.grid[:, :, item_index]\n    \n    for ingredient in recipe:\n        if ingredient != '_at' and sum(inventory[:, :]) < recipe[ingredient]:\n            primitive_name = [k for k, v in cookbook.index.items() if v == ingredient][0]\n            return False, primitive_name\n    return True, None\n\n  def collect_primitive(env, primitive):\n    \"\"\"Collect the specified primitive resource from the environment.\"\"\"\n    actions_to_take = []\n    \n    # Define known positions of primitives (this should be dynamically determined in a real scenario)\n    known_positions = {\n        'WORKSHOP0': [(1, 1), (2, 2)],\n        'WORKSHOP1': [(3, 3), (4, 4)],\n        'WORKSHOP2': [(5, 5), (6, 6)],\n        # Add other primitives and their positions\n    }\n    \n    if primitive in known_positions:\n        closest_primitive = min(\n            known_positions[primitive], \n            key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n        )\n        \n        actions_to_take.extend(get_move_actions(closest_primitive))\n        actions_to_take.append(4)  # Collect the primitive\n    else:\n        raise ValueError(f\"No known positions for {primitive}.\")\n    \n    return actions_to_take\n\n  cookbook = env.world.cookbook\n\n  # Get the index for the desired item to be crafted\n  item_index = cookbook.index[item]\n  \n  # Check if there is a recipe available for this item\n  if item_index in cookbook.recipes:\n    # Fetch the recipe details for the item\n    recipe = cookbook.recipes[item_index]\n\n    # Extract the workshop from the recipe\n    workshop_name = recipe['_at']\n    workshop_index = cookbook.index[workshop_name]\n\n    # Check inventory to see if all ingredients are available.\n    has_all, missing_primitive = check_inventory(item_index, recipe)\n    \n    actions_to_take = []\n    \n    if not has_all:\n        # Collect the missing primitive resource\n        actions_to_take.extend(collect_primitive(env, missing_primitive))\n        # Recalculate item index and recipe after collecting the primitive\n        item_index = cookbook.index[item]\n        recipe = cookbook.recipes[item_index]\n\n    # Find all positions of the specified workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n\n    if len(workshop_positions) > 0:\n        # Choose the closest available workshop position to craft the item at\n        current_pos = env._current_state.pos\n\n        closest_workshop = min(\n            workshop_positions, \n            key=lambda pos: abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n        )\n        \n        target_workshop_pos = tuple(closest_workshop)\n\n        # Calculate move actions to reach the closest workshop\n        actions_to_take.extend(get_move_actions(target_workshop_pos))\n        \n        # Align with the workshop before using it.\n        actions_to_take.extend(align_with_workshop(target_workshop_pos))\n        \n        # Use the USE action to craft the item at the workshop\n        actions_to_take.append(4)\n\n        return actions_to_take\n\n    else:\n        raise ValueError(f\"No workshops found for crafting {item}.\")\n  else:\n      raise ValueError(f\"No recipe available for crafting {item}.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-16T23:48:22.575496", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n\n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  def move_to_target(dx, dy):\n    direction_mapping = {\n        (0, 1): 1, # UP\n        (1, 0): 3, # RIGHT\n        (0, -1): 0, # DOWN\n        (-1, 0): 2 # LEFT\n    }\n    \n    while dx != 0 or dy != 0:\n      if abs(dx) > abs(dy):\n          step_x = np.sign(dx)\n          step_y = 0\n      else:\n          step_x = 0\n          step_y = np.sign(dy)\n\n      direction = direction_mapping[(step_x, step_y)]\n      \n      # Turn towards the direction\n      current_dir = env._current_state.dir\n      target_direction = (direction - current_dir) % 4\n      if target_direction == 1 or target_direction == 3:\n          actions.append((target_direction + 1) % 4)  # Turn right\n      elif target_direction == 2:\n          actions.extend([(current_dir + 1) % 4, (current_dir + 2) % 4])  # Turn around\n      \n      # Move one step in the direction\n      actions.append(direction)\n      \n      dx -= step_x\n      dy -= step_y\n\n    return actions\n  \n  move_to_target(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 2.0}}
{"timestamp": "2025-09-16T23:48:23.634565", "function_name": "craft", "function_body": "  def get_workshop_position(item):\n    goal_index = env.world.cookbook.index[item]\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # Find the position of the workshop in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n    return positions\n\n  actions = []\n  \n  # Get the positions of the workshops\n  workshop_positions = get_workshop_position(item)\n  if len(workshop_positions) == 0:\n      raise ValueError(\"Workshop not found in the grid.\")\n\n  current_x, current_y = env._current_state.pos\n\n  closest_workshop_pos = min(\n    workshop_positions,\n    key=lambda pos: abs(pos[0] - current_x) + abs(pos[1] - current_y)\n  )\n\n  # Calculate the relative position of the workshop from the agent's current position\n  target_x, target_y = closest_workshop_pos\n  dx = target_x - current_x\n  dy = target_y - current_y\n\n  # Move to the workshop while considering direction changes\n  def move(dx, dy):\n      if abs(dy) > abs(dx):  # Prioritize vertical movement first\n          if dy > 0:\n              actions.extend([1] * abs(dy))  # UP\n          elif dy < 0:\n              actions.extend([0] * abs(dy))  # DOWN\n      \n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              actions.extend([2] * abs(dx))  # LEFT\n      else:  # Prioritize horizontal movement first\n          if dx > 0:\n              actions.extend([3] * abs(dx))  # RIGHT\n          elif dx < 0:\n              actions.extend([2] * abs(dx))  # LEFT\n      \n          if dy > 0:\n              actions.extend([1] * abs(dy))  # UP\n          elif dy < 0:\n              actions.extend([0] * abs(dy))  # DOWN\n\n  move(dx, dy)\n\n  # Craft the item (use the USE action)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
