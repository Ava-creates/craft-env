{"timestamp": "2025-06-25T10:34:15.913741", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # This can be further improved with a more accurate heuristic if needed.\n    return 0\n\n  def astar(start_state, goal):\n    \"\"\"A* Search algorithm to find the shortest path.\"\"\"\n    from queue import PriorityQueue\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        path = []\n        while tuple(current_state.features()) in came_from:\n          path.append(came_from[tuple(current_state.features())])\n          current_state, _ = next(s for s, a in zip(env._current_state.step(path[-1])[1], range(len(path))))\n        return path[::-1]\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[features_tuple] = action\n          g_score[features_tuple] = tentative_g_score\n          f_score[features_tuple] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[features_tuple], new_state))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:34:16.935068", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:35:50.187323", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def heuristic(state, goal):\n      # Heuristic based on Manhattan distance to a nearby required item\n      if state.next_to(goal):\n          return 0\n      else:\n          return 1\n\n  def astar(start_state, goal):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, actions = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, current_state, actions)\n          \n          for action in [USE] + list(range(env.world.n_actions)[:-1]):\n              reward, new_state = current_state.step(action)\n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (current_state, actions + [action])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = []\n      while tuple(current_state.features()) in came_from:\n          (current_state, actions) = came_from[tuple(current_state.features())]\n          total_path.append(actions[-1])\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:35:51.196035", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is valid and not visited\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Attempt to find a path using BFS\n  actions = bfs(start_state, item)\n  \n  if actions is not None:\n    return actions\n  \n  # If no path is found, attempt to find the closest ingredient and move towards it\n  def find_closest_ingredient(state, goal):\n      from collections import deque\n      \n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n      \n      while queue:\n          (x, y), actions = queue.popleft()\n          \n          # Check if the current position contains any of the required ingredients\n          for i_kind in env.world.cookbook.primitives_for(goal):\n              if state.grid[x, y, i_kind] > 0:\n                  return actions + [USE]\n          \n          # Explore neighboring positions\n          neighbors = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n          for nx, ny in neighbors:\n              if 0 <= nx < env.scenario.init_grid.shape[0] and 0 <= ny < env.scenario.init_grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), actions + [LEFT if nx < x else RIGHT if nx > x else UP if ny < y else DOWN]))\n      \n      return None  # No path to any ingredient found\n\n  # Find the closest ingredient and move towards it\n  ingredient_actions = find_closest_ingredient(start_state, item)\n  \n  if ingredient_actions is not None:\n      # Execute actions to get the ingredient\n      for action in ingredient_actions:\n          env.step(action)\n      \n      # Retry finding a path after getting the ingredient\n      new_start_state = env._current_state\n      actions = bfs(new_start_state, item)\n      \n      if actions is not None:\n          return actions\n  \n  raise ValueError(\"No path to craft the item found.\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:37:44.534890", "function_name": "craft", "function_body": "  def find_path_to_workshop(state):\n    \"\"\"Find a path to the nearest workshop.\"\"\"\n    from collections import deque\n    \n    queue = deque([(state.pos, [])])\n    visited = set([state.pos])\n    \n    while queue:\n      pos, actions = queue.popleft()\n      \n      if state.grid[pos] in env.world.workshop_indices:\n        return actions\n      \n      # Define possible moves\n      for move, direction in enumerate([(0, 1), (0, -1), (-1, 0), (1, 0)]):\n        new_pos = (pos[0] + direction[0], pos[1] + direction[1])\n        \n        if (0 <= new_pos[0] < state.grid.shape[0] and \n            0 <= new_pos[1] < state.grid.shape[1] and\n            tuple(new_pos) not in visited):\n          visited.add(tuple(new_pos))\n          \n          # Prioritize moving towards the workshop\n          queue.append((new_pos, actions + [move]))\n    \n    return None  # No path to workshop found\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # If the inventory changes, prioritize these states\n          if np.any(new_state.inventory != state.inventory):\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  \n  start_state = env._current_state\n  \n  # First, find a path to the nearest workshop if not already at one\n  if start_state.grid[start_state.pos] not in env.world.workshop_indices:\n    path_to_workshop = find_path_to_workshop(start_state)\n    if path_to_workshop is None:\n      raise ValueError(\"No path to any workshop found.\")\n    actions = path_to_workshop\n  else:\n    actions = []\n  \n  # Then, perform BFS to craft the item\n  crafting_actions = bfs(start_state, item)\n  \n  if crafting_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + crafting_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:37:45.546646", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Simple heuristic based on inventory differences\n    diff = np.abs(state.inventory - env.world.cookbook.primitives_for(goal))\n    return np.sum(diff)\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path with heuristics.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))  # (f_cost, state, actions)\n    came_from = {}\n    g_costs = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      f_cost, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        new_g_cost = g_costs[tuple(current_state.features())] + 1\n        if tuple(new_state.features()) not in g_costs or new_g_cost < g_costs[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions + [action])\n          g_costs[tuple(new_state.features())] = new_g_cost\n          \n          h_cost = heuristic(new_state, goal)\n          f_cost = new_g_cost + h_cost\n          \n          heappush(open_set, (f_cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    \"\"\"Reconstruct the path from start to goal.\"\"\"\n    total_actions = []\n    while tuple(current_state.features()) in came_from:\n      current_state, actions_to_here = came_from[tuple(current_state.features())]\n      total_actions = actions_to_here + total_actions\n    return total_actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:39:58.393385", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:39:59.491562", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_resource_positions(state, resource_indices):\n      \"\"\"Get all positions of the resources on the grid.\"\"\"\n      positions = {}\n      for idx in resource_indices:\n          grid = state.grid\n          pos_list = np.argwhere(grid[..., idx] == 1)\n          if len(pos_list) > 0:\n              positions[idx] = [tuple(pos) for pos in pos_list]\n      return positions\n\n  def move_to_position(state, target_pos):\n      \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n      pos = state.pos\n      dir_ = state.dir\n      \n      # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n      direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n      \n      actions = []\n      \n      # Calculate the relative position\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n      \n      # Adjust direction if necessary\n      if dx < 0 and dir_ != 2:\n          while dir_ != 2:\n              actions.append(LEFT)\n              dir_ += 3  # Rotate left (cyclically)\n              dir_ %= 4\n      elif dx > 0 and dir_ != 3:\n          while dir_ != 3:\n              actions.append(RIGHT)\n              dir_ += 1  # Rotate right (cyclically)\n              dir_ %= 4\n      elif dy < 0 and dir_ != 0:\n          while dir_ != 0:\n              actions.append(UP)\n              dir_ += 3  # Rotate left (cyclically)\n              dir_ %= 4\n      elif dy > 0 and dir_ != 1:\n          while dir_ != 1:\n              actions.append(DOWN)\n              dir_ += 1  # Rotate right (cyclically)\n              dir_ %= 4\n      \n      # Move in the x direction\n      for _ in range(abs(dx)):\n          if dx < 0:\n              actions.append(LEFT)\n          else:\n              actions.append(RIGHT)\n      \n      # Adjust direction if necessary\n      if dy < 0 and dir_ != 0:\n          while dir_ != 0:\n              actions.append(UP)\n              dir_ += 3  # Rotate left (cyclically)\n              dir_ %= 4\n      elif dy > 0 and dir_ != 1:\n          while dir_ != 1:\n              actions.append(DOWN)\n              dir_ += 1  # Rotate right (cyclically)\n              dir_ %= 4\n      \n      # Move in the y direction\n      for _ in range(abs(dy)):\n          if dy < 0:\n              actions.append(UP)\n          else:\n              actions.append(DOWN)\n      \n      return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  resource_positions = get_resource_positions(start_state, list(primitives_needed.keys()))\n  \n  for resource, count in primitives_needed.items():\n      if resource not in resource_positions or len(resource_positions[resource]) == 0:\n          raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n      \n      # Use all available positions of this resource\n      while count > 0 and resource_positions[resource]:\n          target_pos = resource_positions[resource].pop()\n          \n          # Move to the target position\n          actions.extend(move_to_position(start_state, target_pos))\n          start_state = env._current_state\n          \n          # Pick up the resource\n          actions.append(USE)\n          start_state = env._current_state\n          \n          count -= 1\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:41:01.059378", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:41:02.099507", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = hash(next_state)\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:42:09.224445", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Heuristic to prioritize states closer to the goal item\n    pos_x, pos_y = state.pos\n    goal_positions = np.argwhere(env._current_state.grid[:, :, item] == 1)\n    \n    if len(goal_positions) == 0:\n      return float('inf')\n    \n    distances = [abs(pos_x - gx) + abs(pos_y - gy) for gx, gy in goal_positions]\n    return min(distances)\n\n  def bfs(start_state, goal):\n    from collections import deque\n    from heapq import heappush, heappop\n    \n    queue = []\n    heappush(queue, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      _, state, actions = heappop(queue)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          heappush(queue, (0, new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            priority = heuristic(new_state)\n            heappush(queue, (priority, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:42:10.256811", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Heuristic: Prioritize USE action if next to required item\n      if state.next_to(goal):\n        reward, new_use_state = state.step(USE)\n        if new_use_state.inventory[goal] > 0:\n          return actions + [USE]\n        else:\n          queue.append((new_use_state, actions + [USE]))\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:43:10.753532", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is already a solution\n        if new_state.satisfies(\"\", goal):\n          return actions + [action]\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:43:11.717899", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance as a heuristic for now\n    pos_goal = (goal // env.world.cookbook.n_kinds, goal % env.world.cookbook.n_kinds)\n    pos_current = state.pos\n    return abs(pos_goal[0] - pos_current[0]) + abs(pos_goal[1] - pos_current[1])\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          \n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:44:29.322888", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic: Number of items needed in inventory to craft the goal\n    required_items = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    missing_count = sum(max(0, required - current) for kind, required in required_items.items())\n    return missing_count\n\n  def a_star(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or\\\n           tentative_g_score < g_score[tuple(new_state.features())]:\n            \n            came_from[new_state] = (current_state, action)\n            g_score[tuple(new_state.features())] = tentative_g_score\n            f_score = tentative_g_score + heuristic(new_state, goal)\n            heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      while current_state in came_from:\n          current_state, action = came_from[current_state]\n          actions.insert(0, action)\n      return actions\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:44:30.291251", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of zero entries in inventory that are not the goal\n    return sum(count == 0 for idx, count in enumerate(state.inventory) if idx != goal)\n\n  def a_star(start_state, goal):\n    from heapq import heappop, heappush\n\n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Avoid unnecessary movements by checking the direction\n          if (action == UP and state.dir == DOWN) or\\\n             (action == DOWN and state.dir == UP) or\\\n             (action == LEFT and state.dir == RIGHT) or\\\n             (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n\n          cost = len(actions) + heuristic(new_state, goal)\n          heappush(open_set, (cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:46:04.963764", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of non-zero entries in the inventory that match the goal\n    return int(state.inventory[goal] == 0)\n\n  def a_star(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while not open_set.empty():\n      _, current, actions = open_set.get()\n      \n      if current.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current.step(action)\n        \n        # Avoid unnecessary movements by checking the direction\n        if (action == UP and current.dir == DOWN) or\\\n           (action == DOWN and current.dir == UP) or\\\n           (action == LEFT and current.dir == RIGHT) or\\\n           (action == RIGHT and current.dir == LEFT):\n          continue  # Skip opposite movement\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        new_state_features_tuple = tuple(new_state.features())\n        \n        if new_state_features_tuple not in g_score or tentative_g_score < g_score[new_state_features_tuple]:\n          came_from[new_state_features_tuple] = (current, action)\n          g_score[new_state_features_tuple] = tentative_g_score\n          f_score[new_state_features_tuple] = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score[new_state_features_tuple], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_path = []\n    while tuple(current.features()) in came_from:\n      (current, action) = came_from[tuple(current.features())]\n      total_path.append(action)\n    total_path.reverse()\n    return total_path + actions\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:46:06.136722", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: Manhattan distance to the nearest required item if next to it\n    grid_features = state.features_dict()['features_ego']\n    goal_kind_index = np.where(grid_features[:, :, goal] == 1)[0]\n    \n    if len(goal_kind_index) > 0:\n      nearest_distance = min(abs(i - 4) for i in goal_kind_index)\n    else:\n      nearest_distance = float('inf')\n    \n    return nearest_distance\n\n  def bfs_with_heuristic(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [], 0)])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions, cost = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Heuristic: Prioritize USE action if next to required item\n      if state.next_to(goal):\n        reward, new_state = state.step(USE)\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [USE], cost + 1))\n      \n      # Generate all possible next states with heuristic\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid unnecessary movements by checking the direction\n        if (action == UP and state.dir == DOWN) or\\\n           (action == DOWN and state.dir == UP) or\\\n           (action == LEFT and state.dir == RIGHT) or\\\n           (action == RIGHT and state.dir == LEFT):\n          continue  # Skip opposite movement\n        \n        new_cost = cost + heuristic(new_state, goal)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action], new_cost))\n      \n      queue = deque(sorted(queue, key=lambda x: x[2]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:47:07.622137", "function_name": "craft", "function_body": "  def dfs(start_state, goal_name, goal_arg, max_depth=50):\n    \"\"\"Depth-first search with a limit on depth for a sequence of actions to achieve the goal.\"\"\"\n    stack = [(start_state, [])]\n    visited_states = set()\n\n    while stack:\n      current_state, actions_taken = stack.pop()\n\n      if len(actions_taken) > max_depth:\n        continue\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          stack.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = dfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:47:08.730464", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:48:13.366237", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance between the current position and the position of the item needed\n    # This is a placeholder and should be replaced with a more informed heuristic if possible\n    return 0\n  \n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:48:14.397919", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:49:00.221115", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if action == USE and state.next_to(goal) and tuple(new_state.features()) not in visited:\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:49:01.235288", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      use_actions = [action for action in range(env.world.n_actions) if action == USE and state.next_to(goal)]\n      other_actions = [action for action in range(env.world.n_actions) if action != USE or not state.next_to(goal)]\n      \n      for action in use_actions + other_actions:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:50:23.207920", "function_name": "craft", "function_body": "  def state_hash(state):\n    grid_tuple = tuple(map(tuple, map(tuple, state.grid)))\n    inventory_tuple = tuple(state.inventory)\n    return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search with priority queue to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    import heapq\n    from collections import defaultdict\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited_states = set()\n    \n    while open_set:\n        _, current_state, actions_taken = heapq.heappop(open_set)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        hash_val = state_hash(current_state)\n        \n        if hash_val in visited_states:\n            continue\n        \n        visited_states.add(hash_val)\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_next = state_hash(next_state)\n            \n            if hash_next not in visited_states:\n                heapq.heappush(open_set, (len(actions_taken) + 1, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:50:24.194307", "function_name": "craft", "function_body": "  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n  \n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search with improved efficiency and heuristic guidance\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n      import heapq\n      \n      # Priority queue to explore states by their estimated cost\n      priority_queue = []\n      heapq.heappush(priority_queue, (0, start_state, []))\n      visited_states = set()\n\n      while priority_queue:\n          _, current_state, actions_taken = heapq.heappop(priority_queue)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  heapq.heappush(priority_queue, (heuristic(next_state, goal_arg), next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  # Heuristic function to estimate the cost to reach the goal\n  def heuristic(state, goal_arg):\n      if state.inventory[goal_arg] > 0:\n          return 0\n      else:\n          return 1  # Simplistic heuristic: prioritize states where the goal item count increases\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:51:39.538350", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  # Reset the environment to a clean start\n  env.reset()\n  \n  start_state = env._current_state\n  \n  # Pre-collect resources if needed\n  primitives = env.world.cookbook.primitives_for(item)\n  for primitive, count in primitives.items():\n      while start_state.inventory[primitive] < count:\n          resource_actions = bfs(start_state, primitive)\n          if resource_actions is None:\n              raise ValueError(\"No path to collect the required resource found.\")\n          actions_to_collect_resource = []\n          current_state = start_state\n          for action in resource_actions:\n              reward, new_state = current_state.step(action)\n              actions_to_collect_resource.append(action)\n              current_state = new_state\n          \n          # Collect the primitive\n          _, final_state_after_collection = current_state.step(USE)\n          actions_to_collect_resource.append(USE)\n          start_state = final_state_after_collection\n  \n  # Now craft the item\n  actions_to_craft_item = bfs(start_state, item)\n  \n  if actions_to_craft_item is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions_to_collect_resource + actions_to_craft_item", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:51:40.552402", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  # Reset the environment to a clean start\n  env.reset()\n  \n  # Ensure the item is known and can be crafted\n  if item not in env.world.cookbook.index.reverse_contents:\n    raise ValueError(\"Unknown item index.\")\n  \n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:53:02.475841", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state, goal), start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    came_from = {}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n              came_from[tuple(new_state.features())] = (current_state, actions + [action])\n              g_score[tuple(new_state.features())] = tentative_g_score\n              f_score = tentative_g_score + heuristic(new_state, goal)\n              open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = actions[:]\n      while tuple(current_state.features()) in came_from:\n          (current_state, actions) = came_from[tuple(current_state.features())]\n          total_path = actions + total_path\n      return total_path\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    return -state.inventory[goal]  # More inventory of goal item is better\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:53:03.456756", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from collections import deque\n    \n    # Priority queue using a list of tuples (f_score, g_score, state, actions)\n    open_set = []\n    heapq.heappush(open_set, (0, 0, start_state, []))\n    \n    # Maps states to their g_scores\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      f_score, current_g, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          tentative_g_score = current_g + 1\n          \n          new_features = tuple(new_state.features())\n          if new_features not in g_score or tentative_g_score < g_score[new_features]:\n              g_score[new_features] = tentative_g_score\n              f_score = tentative_g_score + heuristic(new_state, goal)\n              heapq.heappush(open_set, (f_score, tentative_g_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    return -state.inventory[goal]  # More inventory of goal item is better\n\n  import heapq\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:54:16.117550", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the count of the goal item in the inventory\n    return -state.inventory[goal]\n\n  def a_star(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          new_cost = len(actions) + 1\n          heapq.heappush(open_set, (new_cost + heuristic(new_state, goal), new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:54:17.102748", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the count of the goal item in the inventory and proximity to workshops\n    inventory_count = state.inventory[goal]\n    \n    # Check proximity to workshop indices\n    min_workshop_distance = float('inf')\n    pos_x, pos_y = state.pos\n    \n    for wx, wy in env.world.workshop_indices:\n        distance = abs(pos_x - wx) + abs(pos_y - wy)\n        if distance < min_workshop_distance:\n            min_workshop_distance = distance\n    \n    # Combine heuristic values\n    return -(inventory_count + 1 / (min_workshop_distance + 1))\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Sort the actions based on heuristic\n      sorted_use_actions = sorted(use_actions, key=lambda x: heuristic(x[0], goal))\n      sorted_other_actions = sorted(other_actions, key=lambda x: heuristic(x[0], goal))\n      \n      # Extend queue with prioritized and sorted actions\n      queue.extend(sorted_use_actions)\n      queue.extend(sorted_other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:56:05.390893", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Calculate the distance to the nearest workshop if necessary\n    if state.inventory[env.world.stone_index] > 0 and env.world.workshop_indices:\n      workshop_distances = [np.linalg.norm(np.array(state.pos) - np.array((x // env.world.grid.shape[1], x % env.world.grid.shape[1])), ord=1)\n                            for x in env.world.workshop_indices]\n      return min(workshop_distances, default=float('inf'))\n    return 0\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE and heuristic(new_state, goal) < heuristic(state, goal):\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extendleft(use_actions)  # Prioritize USE actions by adding them first\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:56:06.381201", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Calculate the distance to the nearest workshop if necessary\n    if state.inventory[env.world.stone_index] > 0 and env.world.workshop_indices:\n      workshop_distances = [np.linalg.norm(np.array(state.pos) - np.array((x // env.world.grid.shape[1], x % env.world.grid.shape[1])), ord=1)\n                            for x in env.world.workshop_indices]\n      return min(workshop_distances, default=float('inf'))\n    return 0\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extendleft(use_actions)  # Prioritize USE actions by adding them first\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  def plan_to_workshop(state):\n    \"\"\"Plan a path to the nearest workshop using BFS.\"\"\"\n    from collections import deque\n    \n    if not env.world.workshop_indices:\n        return []\n    \n    target = min(env.world.workshop_indices, key=lambda x: np.linalg.norm(np.array(state.pos) - np.array((x // env.world.grid.shape[1], x % env.world.grid.shape[1])), ord=1))\n    \n    queue = deque([(state, [])])\n    visited = set([tuple(state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.pos == (target // env.world.grid.shape[1], target % env.world.grid.shape[1]):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return []  # No path to workshop found\n\n  start_state = env._current_state\n  initial_actions_to_workshop = plan_to_workshop(start_state)\n  \n  if not initial_actions_to_workshop:\n    raise ValueError(\"No path to a workshop found.\")\n  \n  # Execute actions to reach the nearest workshop\n  for action in initial_actions_to_workshop:\n      reward, start_state = start_state.step(action)\n\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return initial_actions_to_workshop + actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:58:42.584170", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Estimate the cost to reach the goal from the current state.\"\"\"\n    # Heuristic: Number of items still needed in inventory\n    required = env.world.cookbook.primitives_for(goal_arg)\n    in_inventory = {i_kind: count for i_kind, count in enumerate(current_state.inventory) if count > 0}\n    \n    missing_count = 0\n    for primitive, required_count in required.items():\n      missing_count += max(0, required_count - in_inventory.get(primitive, 0))\n    \n    return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    \n    visited_states = set()\n\n    while open_set:\n      current_cost, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          new_cost = len(actions_taken) + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (new_cost, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:58:43.632190", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    import numpy as np\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:00:46.961053", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:00:47.937341", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic to estimate the cost from current_state to the goal.\"\"\"\n    # Simple heuristic: distance between agent and any workshop\n    workshops = env.world.workshop_indices\n    min_distance = float('inf')\n    \n    for i in range(env.world.WIDTH):\n      for j in range(env.world.HEIGHT):\n        if current_state.grid[i, j, workshops[0]] > 0:\n          distance = abs(i - current_state.pos[0]) + abs(j - current_state.pos[1])\n          min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(heuristic(start_state, goal_arg), start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = open_set.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          h = heuristic(next_state, goal_arg)\n          g = len(actions_taken) + 1\n          f = g + h\n          \n          open_set.append((f, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:02:06.445434", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function based on distance to goal.\"\"\"\n    # Check if the item is in inventory or available nearby\n    if state.satisfies(\"\", goal) or env._current_state.next_to(goal):\n        return 0\n    return 1\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Heuristic based on distance to goal\n          h = heuristic(new_state, goal)\n          \n          queue.append((new_state, actions + [action], h))\n      \n      # Sort the queue based on priority (heuristic value)\n      queue = deque(sorted(queue, key=lambda x: x[2]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return [action for action, _ in actions]", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:02:07.446296", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function based on the difference in inventory counts.\"\"\"\n    return np.sum(np.abs(state.inventory - goal))\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      current_cost, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Calculate cost with heuristic\n          h_cost = heuristic(new_state, env.world.cookbook.primitives_for(goal))\n          f_cost = current_cost + 1 + h_cost  # Assuming step cost is 1 for simplicity\n          \n          heapq.heappush(open_set, (f_cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  goal_primitives = env.world.cookbook.primitives_for(item)\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:03:29.662951", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n    # Calculate the number of items needed for the goal\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory\n\n    # Count the total number of missing primitives\n    missing_count = sum(max(0, count - current_inventory[primitive]) for primitive, count in primitives.items())\n    return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    from heapq import heappop, heappush\n\n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal_arg), 0, start_state, []))\n    visited_states = set()\n    g_score = {start_state: 0}\n\n    while open_set:\n      _, current_cost, current_state, actions_taken = heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        tentative_g_score = current_cost + 1 - reward  # Adjust cost based on reward\n\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states or tentative_g_score < g_score.get(state_hash, float('inf')):\n          heappush(open_set, (tentative_g_score + heuristic(next_state, goal_arg), tentative_g_score, next_state, actions_taken + [action]))\n          g_score[state_hash] = tentative_g_score\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment to get a fresh scenario\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:03:30.708809", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment to get a fresh scenario\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:04:52.927173", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    max_queue_size = 0\n    start_time = time.time()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        end_time = time.time()\n        print(f\"Goal achieved in {len(actions_taken)} steps.\")\n        print(f\"Visited states: {len(visited_states)}, Max queue size: {max_queue_size}\")\n        print(f\"Time taken: {end_time - start_time:.2f} seconds\")\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n          max_queue_size = max(max_queue_size, len(queue))\n\n    return None\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:04:53.926024", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(map(tuple, state.grid.reshape(-1, state.world.n_kinds)))\n      inventory_tuple = tuple(state.inventory)\n      return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:06:09.139446", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Heuristic: Prioritize USE action if next to required item\n      if state.next_to(goal):\n        reward, new_use_state = state.step(USE)\n        if new_use_state.inventory[goal] > 0:\n          return actions + [USE]\n        else:\n          queue.append((new_use_state, actions + [USE]))\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Avoid unnecessary movements by checking the direction\n          if (action == UP and state.dir == DOWN) or\\\n             (action == DOWN and state.dir == UP) or\\\n             (action == LEFT and state.dir == RIGHT) or\\\n             (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n          \n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:06:10.297283", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Heuristic: Prioritize USE action if next to required item\n      for neighbor_idx in range(len(state.grid)):\n          for neighbor_jdx in range(len(state.grid[0])):\n              if state.next_to(goal) and (neighbor_idx, neighbor_jdx) == state.pos:\n                  reward, new_use_state = state.step(USE)\n                  if new_use_state.inventory[goal] > 0:\n                      return actions + [USE]\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Avoid unnecessary movements by checking the direction\n          if (action == UP and state.dir == DOWN) or\\\n             (action == DOWN and state.dir == UP) or\\\n             (action == LEFT and state.dir == RIGHT) or\\\n             (action == RIGHT and state.dir == LEFT):\n            continue  # Skip opposite movement\n        \n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:07:32.977278", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    grid_flat = tuple(state.grid.flatten())\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_flat, inventory_tuple, pos_tuple, dir_value)\n\n  # Initialize the environment and start scenario\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:07:33.973601", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # A* search to find the sequence of actions\n  def a_star(start_state, goal_name, goal_arg):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, start_state, []))\n      came_from = {}\n      g_score = {state_hash(start_state): 0}\n      \n      while not open_set.empty():\n          _, current_state, actions_taken = open_set.get()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return reconstruct_path(came_from, current_state, actions_taken)\n          \n          for action, next_state in get_possible_actions(current_state):\n              tentative_g_score = g_score[state_hash(current_state)] + 1\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in g_score or tentative_g_score < g_score[hash_val]:\n                  came_from[next_state] = (current_state, action)\n                  g_score[hash_val] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                  open_set.put((f_score, next_state, actions_taken + [action]))\n      \n      return None\n\n  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    return tuple(state.grid.flatten()) +\\\n           tuple(state.inventory) +\\\n           (state.pos,) +\\\n           (state.dir,)\n  \n  def heuristic(state, goal_arg):\n    # Simple heuristic: count number of items needed\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory[list(primitives.keys())]\n    return sum(max(0, primitives[key] - current_inventory[i]) for i, key in enumerate(primitives.keys()))\n  \n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = []\n      while current_state in came_from:\n          previous_state, action = came_from[current_state]\n          total_path.insert(0, action)\n          current_state = previous_state\n      return actions_taken + total_path\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:08:38.295421", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir,\n                  frozenset(next_state._cached_features_dict.items()) if next_state._cached_features_dict else None\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:08:39.307600", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Avoid revisiting the same state to prevent infinite loops\n        state_hash = hash((tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir))\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:09:38.065802", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states based on valid moves\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Skip invalid moves (e.g., walking into walls)\n        if not np.array_equal(next_state.grid, current_state.grid) or \\\n           not np.array_equal(next_state.pos, current_state.pos) or \\\n           not action == 4:  # Assuming action 4 is the USE action\n\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n            visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:09:39.130287", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Optionally, consider using the reward to prune or prioritize states\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Reset environment to a known starting state\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:11:10.186375", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search with heuristic: prioritize states that have more of the desired item\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                # Heuristic: Prioritize states that have more of the desired item and fewer steps taken\n                priority = -next_state.inventory[goal_arg] + len(actions_taken)\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:11:11.172296", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search with heuristic: prioritize states that have more of the desired item\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                # Heuristic: Prioritize states that have more of the desired item or are closer to a workshop\n                priority = -next_state.inventory[goal_arg] + distance_to_workshop(next_state.pos, env.world.workshop_indices)\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  def distance_to_workshop(pos, workshop_indices):\n      min_distance = float('inf')\n      for idx in workshop_indices:\n          workshop_pos = env.cookbook.index.get(idx)\n          distance = abs(workshop_pos[0] - pos[0]) + abs(workshop_pos[1] - pos[1])\n          min_distance = min(min_distance, distance)\n      return min_distance\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:12:25.489428", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_state, goal):\n      from collections import deque\n      \n      # Priority queue with initial state and empty action path\n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n\n      while queue:\n          current_state, actions = queue.popleft()\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n\n          # Prioritize USE action and then movement actions\n          for action in [USE] + [UP, DOWN, LEFT, RIGHT]:\n              reward, new_state = current_state.step(action)\n              \n              # Check if the state is already visited\n              state_tuple = tuple(new_state.features())\n              if state_tuple not in visited:\n                  visited.add(state_tuple)\n                  \n                  # Calculate priority based on action and inventory change\n                  priority = 0\n                  if action == USE:\n                      priority += 1\n                  if np.any(new_state.inventory != current_state.inventory):\n                      priority += 2\n\n                  # Append new state with updated actions to the queue\n                  queue.append((new_state, actions + [action]))\n                  \n                  # Sort the queue based on priority (higher first)\n                  queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n\n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:12:26.473846", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:13:27.628829", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:13:28.705618", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:15:32.499729", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n\n          # Prioritize picking up items that are ingredients for the goal\n          if new_state.grid[state.pos[0], state.pos[1]] in env.world.cookbook.primitives_for(goal):\n              priority += 3\n\n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:15:33.478144", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  def heuristic(state):\n      \"\"\"Heuristic function to prioritize states closer to having the goal item.\"\"\"\n      inventory = state.inventory\n      goal_index = env.world.cookbook.index.get(goal)\n      \n      if goal_index is not None and inventory[goal_index] > 0:\n          return -1  # Highest priority for states where the goal item is in the inventory\n      \n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      total_primitives_needed = sum(primitives_needed.values())\n      primitives_in_inventory = sum(inventory[i_kind] * count for i_kind, count in primitives_needed.items())\n      \n      return -primitives_in_inventory  # Prioritize states with more required primitives in inventory\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path using heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state)}\n    \n    while not open_set.empty():\n      _, state, actions = open_set.get()\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current=state)\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state)\n          open_set.put((f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n      \"\"\"Reconstruct the path from start to goal.\"\"\"\n      total_path = []\n      \n      while tuple(current.features()) in came_from:\n          (state, action) = came_from[tuple(current.features())]\n          total_path.append(action)\n          current = state\n      \n      return total_path[::-1]\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
