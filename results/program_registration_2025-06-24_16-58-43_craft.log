{"timestamp": "2025-06-25T12:23:39.980078", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:23:41.108491", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:25:11.012740", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    \"\"\"Estimate the cost to reach the goal using Manhattan distance.\"\"\"\n    return abs(item - state.world.cookbook.index.get('output', item))\n\n  def a_star(start_state, goal):\n      \"\"\"A* search to find the shortest path with heuristic guidance.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state)}\n      \n      while open_set:\n          _, current_state, actions = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              features_tuple = tuple(new_state.features())\n              if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n                  g_score[features_tuple] = tentative_g_score\n                  f_score[features_tuple] = tentative_g_score + heuristic(new_state)\n                  heapq.heappush(open_set, (f_score[features_tuple], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:25:12.034106", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:26:10.697455", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Use a simple heuristic based on the number of items in the inventory that are not yet part of the goal\n    return len([i for i in range(len(state.inventory)) if state.inventory[i] == 0])\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the optimal path.\"\"\"\n    from heapq import heappop, heappush\n    \n    open_set = [(heuristic(start_state, goal), 0, start_state, [])]\n    visited = set()\n    \n    while open_set:\n      _, cost_so_far, state, actions = heappop(open_set)\n      \n      if tuple(state.features()) in visited:\n        continue\n      \n      visited.add(tuple(state.features()))\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          heappush(open_set, (cost_so_far + 1 + heuristic(new_state, goal), cost_so_far + 1, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:26:11.704008", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:27:30.925311", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Simple heuristic: distance to the closest required item\n    target_indices = [i for i in range(env.world.cookbook.n_kinds) if env.world.cookbook.primitives_for(item).get(i, 0) > 0]\n    \n    min_distance = float('inf')\n    for idx in target_indices:\n      if state.next_to(idx):\n        return 0\n    \n    for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n        if any(state.grid[x, y, i] > 0 for i in target_indices):\n          distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n          min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def astar(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = [(heuristic(start_state), start_state, [])]\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:27:32.032089", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      use_first = []\n      others = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE and any(state.next_to(i) for i in env.world.cookbook.primitives_for(goal).keys()):\n            use_first.append((new_state, actions + [action]))\n          else:\n            others.append((new_state, actions + [action]))\n      \n      # Extend queue with USE first then others\n      queue.extend(use_first)\n      queue.extend(others)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:28:27.112814", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Ensure the agent doesn't get stuck in loops\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def prioritize_use_action(actions):\n      \"\"\"Prioritize USE action if next to required item.\"\"\"\n      new_actions = []\n      for i, action in enumerate(actions):\n          state = env._current_state\n          for a in actions[:i]:\n              _, state = state.step(a)\n          \n          if action == USE and any(state.next_to(i_kind) for i_kind in range(env.world.cookbook.n_kinds)):\n              new_actions.insert(0, action)  # Prioritize USE action\n          else:\n              new_actions.append(action)\n      return new_actions\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  actions = prioritize_use_action(actions)\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T12:28:28.170348", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:30:19.094680", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Simple heuristic: count the number of missing items in the inventory\n    required_items = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = dict(enumerate(current_state.inventory))\n    \n    return sum(required_items.get(i, 0) - current_inventory.get(i, 0) for i in required_items)\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm for finding the optimal sequence of actions.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n        tentative_g_score = g_score[current_state] + 1\n        \n        if next_state not in g_score or tentative_g_score < g_score[next_state]:\n          came_from[next_state] = (current_state, action)\n          g_score[next_state] = tentative_g_score\n          f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    \"\"\"Reconstructs the path from start to end using the came_from dict.\"\"\"\n    total_path = []\n    while current_state in came_from:\n      current_state, action = came_from[current_state]\n      total_path.append(action)\n    \n    return total_path[::-1]\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:30:20.153289", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  goal_item_index = item\n  \n  try:\n      start_scenario = env.scenario\n      start_state = start_scenario.init()\n\n      goal_name = 'default'  # Assuming a default goal name for now\n      goal_arg = goal_item_index\n      \n      action_sequence = bfs(start_state, goal_name, goal_arg)\n      \n      if action_sequence is not None:\n          return action_sequence\n      else:\n          raise ValueError(f\"No sequence of actions found to craft item {goal_item_index}\")\n  except Exception as e:\n      print(f\"An error occurred: {e}\")\n      return []", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:31:24.732877", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def hash_state(state):\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  # Reset the environment to get a fresh scenario\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:31:25.845692", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      # Check if the goal is satisfied\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment to get a fresh scenario\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:33:14.399328", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n      \"\"\"A* search to find the shortest path.\"\"\"\n      from heapq import heappush, heappop\n      \n      # Priority queue of (f_score, g_score, actions, state)\n      open_set = []\n      heappush(open_set, (0, 0, [], start_state))\n      \n      # Dictionary for visited states with their best g_scores\n      came_from = {}\n      g_scores = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, g_score, actions, current_state = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, current_state, actions)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Check if the action led to a meaningful state change\n              features_tuple = tuple(new_state.features())\n              tentative_g_score = g_score + 1  # Each action costs 1\n\n              if (features_tuple not in g_scores) or (tentative_g_score < g_scores[features_tuple]):\n                  came_from[new_state] = current_state\n                  g_scores[features_tuple] = tentative_g_score\n                  f_score_next = tentative_g_score + heuristic(new_state, goal)\n                  \n                  heappush(open_set, (f_score_next, tentative_g_score, actions + [action], new_state))\n      \n      return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n      return -state.inventory[goal] + np.sum(state.inventory) * 0.1  # Favor states with more of the goal item in inventory\n\n  def reconstruct_path(came_from, current_state, actions):\n      \"\"\"Reconstructs the path from start to the current state.\"\"\"\n      total_actions = []\n      \n      while current_state in came_from:\n          previous_state = came_from[current_state]\n          total_actions.insert(0, actions.pop())\n          current_state = previous_state\n      \n      return total_actions\n\n  # Initialize the environment and get the start state\n  env.reset()\n  start_state = env._current_state\n  \n  # Find actions to craft the item using A* search\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:33:15.384966", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Favor states with more of the goal item in inventory\n    return -state.inventory[goal] + np.sum(state.inventory) * 0.1  # Additional small reward for having any items\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path using a heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, 0, [], start_state))\n    \n    came_from = {}\n    g_scores = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, g_score, actions, current_state = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score + 1\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in g_scores or tentative_g_score < g_scores[features_tuple]:\n          came_from[new_state] = current_state\n          g_scores[features_tuple] = tentative_g_score\n          f_score_next = tentative_g_score + heuristic(new_state, goal)\n          \n          heappush(open_set, (f_score_next, tentative_g_score, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    \"\"\"Reconstructs the path from start to the current state.\"\"\"\n    total_actions = []\n    \n    while current_state in came_from:\n      previous_state = came_from[current_state]\n      total_actions.insert(0, actions.pop())\n      current_state = previous_state\n    \n    return total_actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:34:57.806562", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def astar(start_state, goal):\n      \"\"\"A* Search with heuristic prioritization.\"\"\"\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, start_state, [], 0))  # (f_score, state, actions, g_score)\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while not open_set.empty():\n          _, current_state, actions, current_cost = open_set.get()\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[new_state] = (current_state, actions + [action])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  open_set.put((f_score, new_state, actions + [action], tentative_g_score))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:34:58.920157", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"\n      Heuristic function that prioritizes states with:\n      - Changes in inventory.\n      - Closer to the goal based on inventory counts.\n      \"\"\"\n      priority = 0\n      \n      # Check if the current state has used any items or added them to the inventory\n      if np.any(state.inventory != env._current_state.inventory):\n          priority += 2\n      \n      # Additional heuristic based on how close we are to having enough of the goal item in inventory\n      goal_inventory = np.zeros_like(state.inventory)\n      goal_inventory[goal] = 1\n      inventory_distance = np.sum(np.abs(goal_inventory - state.inventory))\n      \n      return priority + (10 / (inventory_distance + 1))  # Avoid division by zero\n\n  def bfs(start_state, goal):\n      \"\"\"\n      Breadth-First Search with heuristic prioritization.\n      \"\"\"\n      from collections import deque\n      \n      queue = deque([(start_state, [], 0)])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions, current_cost = queue.popleft()\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action and states with changes in inventory\n          next_states = []\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = state.step(action)\n              \n              # Avoid revisiting the same state\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  # Calculate heuristic priority and cost\n                  priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                  new_cost = current_cost + 1\n                    \n                  next_states.append((new_state, actions + [action], priority, new_cost))\n          \n          # Sort states by priority and append to the front of the queue\n          next_states.sort(key=lambda x: (-x[2], x[3]))\n          for new_state, new_actions, _, _ in next_states:\n              queue.appendleft((new_state, new_actions, current_cost + 1))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:36:38.938939", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and early termination.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 5:\n        return False\n    last_five_actions = actions[-5:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return (last_five_actions == [UP, DOWN] * 2 + [UP]) or \\\n           (last_five_actions == [DOWN, UP] * 2 + [DOWN]) or \\\n           (last_five_actions == [LEFT, RIGHT] * 2 + [LEFT]) or \\\n           (last_five_actions == [RIGHT, LEFT] * 2 + [RIGHT])\n\n  def get_neighbors(state):\n      \"\"\"Get all reachable states from the current state.\"\"\"\n      neighbors = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          neighbors.append((new_state, action))\n      return neighbors\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:36:39.908076", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of primitives needed for the goal item\n    goal_primitives = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    missing_count = sum(max(0, count - current_inventory[i]) for i, count in goal_primitives.items())\n    return missing_count\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path with pruning and early termination using heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n      \"\"\"Reconstruct the path from start to current state.\"\"\"\n      total_path = []\n      while current in came_from:\n          prev_state, action = came_from[current]\n          total_path.append(action)\n          current = prev_state\n      return list(reversed(total_path))\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:37:52.798223", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            \n            # Avoid unnecessary movements by checking the direction\n            if (action == UP and state.dir == DOWN) or\\\n               (action == DOWN and state.dir == UP) or\\\n               (action == LEFT and state.dir == RIGHT) or\\\n               (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n            \n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:37:53.812366", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Heuristic: Prioritize USE action if next to required item\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Heuristic: Prioritize USE action if next to required item\n          if action == USE and any(i_kind == goal for i_kind in new_state.grid[state.pos[0] - 1:state.pos[0] + 2, state.pos[1] - 1:state.pos[1] + 2]):\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            # Avoid unnecessary movements by checking the direction\n            if (action == UP and state.dir == DOWN) or\\\n               (action == DOWN and state.dir == UP) or\\\n               (action == LEFT and state.dir == RIGHT) or\\\n               (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n            \n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:38:45.214790", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE and state.next_to(goal):\n            queue.appendleft((new_state, actions + [action]))\n          elif action == USE:\n            queue.append((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:38:46.283127", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:40:12.040093", "function_name": "craft", "function_body": "  def heuristic(state):\n    \"\"\"Heuristic function: Manhattan distance from the nearest primitive resource.\"\"\"\n    primitives = env.world.cookbook.primitives\n    pos = state.pos\n    min_distance = float('inf')\n    \n    for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n        if any(state.grid[x, y, p] > 0 for p in primitives):\n          distance = abs(x - pos[0]) + abs(y - pos[1])\n          min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n        continue\n      \n      visited_states.add(state_hash)\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash_next = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash_next not in visited_states:\n          heapq.heappush(open_set, (len(actions_taken) + 1 + heuristic(next_state), next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:40:13.105146", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      # Check if the state satisfies the goal before generating next states\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Avoid adding terminal states to the queue\n        if not env._is_done():\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n            visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:41:40.252880", "function_name": "craft", "function_body": "  def state_hash(state):\n      grid_flat = tuple(state.grid.flatten())\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_flat, inventory_tuple, pos_tuple, dir_value)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  # Breadth-first search with early termination and heuristic\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n      from queue import PriorityQueue\n      \n      pq = PriorityQueue()\n      pq.put((0, start_state, []))  # (priority, state, actions_taken)\n      visited_states = set()\n\n      while not pq.empty():\n          _, current_state, actions_taken = pq.get()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  # Heuristic: Prioritize states that have more of the desired item\n                  priority = -next_state.inventory[goal_arg]\n                  pq.put((priority, next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:41:41.251640", "function_name": "craft", "function_body": "  def state_hash(state):\n    # Use a more compact representation for hashing by converting arrays to tuples\n    grid_tuple = tuple(map(tuple, state.grid))\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    return (grid_tuple, inventory_tuple, pos_tuple, state.dir)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      if next_state is not None:\n        actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search with early termination and heuristic\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state in get_possible_actions(current_state):\n        hash_val = state_hash(next_state)\n        \n        if hash_val not in visited_states:\n          # Heuristic: Prioritize states that have more of the desired item\n          priority = -next_state.inventory[goal_arg]\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:42:50.326185", "function_name": "craft", "function_body": "  def state_hash(state):\n      # Combine grid, inventory, position, and direction into a tuple\n      return (tuple(map(tuple, state.grid)), tuple(state.inventory), state.pos, state.dir)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              yield action, next_state\n\n  # Breadth-first search with memoization to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:42:51.285903", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      if next_state is not None:\n        actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search with priority queue to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    import heapq\n\n    queue = [(0, start_state, [])]  # (cost, state, actions_taken)\n    visited_states = set()\n\n    while queue:\n      cost, current_state, actions_taken = heapq.heappop(queue)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state in get_possible_actions(current_state):\n        hash_val = state_hash(next_state)\n        \n        if hash_val not in visited_states:\n          heapq.heappush(queue, (cost + 1, next_state, actions_taken + [action]))\n          visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:44:04.107323", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_actions, other_actions = [], []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE:\n                  use_actions.append((new_state, actions + [action]))\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE actions first\n      queue.extendleft(reversed(use_actions))\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:44:05.261972", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristics.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Heuristic: Check if the current inventory has increased towards the goal\n              heuristic_score = new_state.inventory[goal] - state.inventory[goal]\n              if action == USE:\n                  use_action = (new_state, actions + [action], heuristic_score)\n              else:\n                  other_actions.append((new_state, actions + [action], heuristic_score))\n      \n      # Sort by heuristic score\n      if use_action is not None:\n          other_actions.append(use_action)\n      \n      # Prioritize states with higher heuristic scores\n      other_actions.sort(key=lambda x: x[2], reverse=True)\n      \n      for new_state, actions, _ in other_actions:\n          queue.appendleft((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:46:04.256888", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n      _, next_state = current_state.step(action)\n      if next_state is not None:\n        yield action, next_state\n\n  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state in get_possible_actions(current_state):\n        state_hash = tuple(next_state.grid.flatten()) +\\\n                     tuple(next_state.inventory) +\\\n                     (next_state.pos,) +\\\n                     (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:46:05.431549", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        if next_state is None:\n          continue\n        \n        state_hash = tuple(next_state.grid.flatten()) +\\\n                     tuple(next_state.inventory) +\\\n                     (next_state.pos,) +\\\n                     (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_goal_reachable(start_state, goal_name, goal_arg):\n    \"\"\"Check if the goal item can be reached.\"\"\"\n    from collections import deque\n\n    queue = deque([start_state])\n    visited_hashes = set()\n\n    while queue:\n      current_state = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return True\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        if next_state is None:\n          continue\n        \n        state_hash = tuple(next_state.grid.flatten()) +\\\n                     tuple(next_state.inventory) +\\\n                     (next_state.pos,) +\\\n                     (next_state.dir,)\n        \n        if state_hash not in visited_hashes:\n          queue.append(next_state)\n          visited_hashes.add(state_hash)\n\n    return False\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if not is_goal_reachable(start_state, goal_name, goal_arg):\n    raise ValueError(f\"Goal item {item} is not reachable in the current scenario.\")\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:47:54.470408", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # A* search to find the sequence of actions\n  def a_star(start_state, goal_name, goal_arg):\n    from queue import PriorityQueue\n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))  # (f_score, state, path)\n    \n    g_scores = {state_hash(start_state): 0}\n    came_from = {}\n\n    while not open_set.empty():\n        _, current_state, actions_taken = open_set.get()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            tentative_g_score = g_scores[state_hash(current_state)] + 1\n            \n            if hash_val not in g_scores or tentative_g_score < g_scores[hash_val]:\n                came_from[hash_val] = (state_hash(current_state), action)\n                g_scores[hash_val] = tentative_g_score\n                f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                open_set.put((f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  # Heuristic function (Manhattan distance to the nearest grabbable item that can be used to craft the goal)\n  def heuristic(state, goal_arg):\n      if state.inventory[goal_arg] > 0:\n          return 0\n      min_dist = float('inf')\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if any(state.grid[x, y, i] > 0 and i != env.world.water_index and i != env.world.stone_index for i in state.grabbable_indices):\n                  dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                  min_dist = min(min_dist, dist)\n      return min_dist\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:47:55.522617", "function_name": "craft", "function_body": "  def state_hash(state):\n    # Use a more compact representation for hashing\n    grid_flat = tuple(np.packbits(state.grid.reshape(-1)).tolist())\n    inventory_tuple = tuple(np.packbits(state.inventory).tolist())\n    return grid_flat + inventory_tuple + (state.pos,) + (state.dir,)\n\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Depth-first search with backtracking\n  def dfs(start_state, goal_name, goal_arg):\n      stack = [(start_state, [])]\n      visited_states = set()\n\n      while stack:\n          current_state, actions_taken = stack.pop()\n          if state_hash(current_state) in visited_states:\n              continue\n          \n          visited_states.add(state_hash(current_state))\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          for action, next_state in get_possible_actions(current_state)[::-1]:\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  stack.append((next_state, actions_taken + [action]))\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = dfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:49:12.438959", "function_name": "craft", "function_body": "  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n        reward, next_state = state.step(action)\n        if not np.array_equal(next_state.grid, state.grid) or not np.array_equal(next_state.inventory, state.inventory):\n            neighbors.append((next_state, action))\n    return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search with heuristic to prioritize states closer to the goal.\"\"\"\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          for next_state, action in get_neighbors(current_state):\n              state_hash = hash((tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir))\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:49:13.423853", "function_name": "craft", "function_body": "  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n        reward, next_state = state.step(action)\n        if reward != env._extra_pickup_penalty:  # Avoid redundant pickup actions\n            neighbors.append((next_state, action))\n    return neighbors\n\n  def heuristic(state, goal_arg):\n      \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n      return -state.inventory[goal_arg]  # Higher inventory means closer to goal\n\n  def a_star(start_state, goal_name, goal_arg):\n      import heapq\n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          for next_state, action in get_neighbors(current_state):\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  cost = len(actions_taken) + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (cost, next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:50:28.582720", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(UP, RIGHT+1)):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in the inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:50:29.552581", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of items needed in inventory to craft the goal\n    missing_items = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    return sum(max(0, missing_items[i] - current_inventory[i]) for i in missing_items)\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current_state, actions = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              new_state_features_tuple = tuple(new_state.features())\n              \n              if new_state_features_tuple not in g_score or tentative_g_score < g_score[new_state_features_tuple]:\n                  came_from[new_state_features_tuple] = (current_state, actions)\n                  g_score[new_state_features_tuple] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:51:51.907815", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of items in the inventory that match the recipe for the goal\n    if not state.world.cookbook.primitives_for(goal):\n      return 0\n    \n    recipe = state.world.cookbook.recipes.get(goal)\n    if not recipe:\n      return float('inf')\n    \n    needed_items = set(recipe.keys()) - {\"_key\"}\n    have_counts = {i: state.inventory[i] for i in needed_items}\n    need_counts = {i: recipe[i] for i in needed_items}\n\n    # Calculate the number of steps required to gather all items\n    steps = 0\n    for i, have in have_counts.items():\n      if have < need_counts[i]:\n        steps += (need_counts[i] - have) * 2  # Assuming each item requires 2 actions to gather\n\n    return steps\n\n  def a_star(start_state, goal):\n    \"\"\"A* search algorithm with heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = [(heuristic(start_state, goal), start_state, [])]\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          heappush(open_set, (heuristic(new_state, goal) + len(actions) + 1, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:51:52.926298", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n      # For simplicity, use a basic heuristic based on inventory counts\n      diff = np.sum(np.abs(state.inventory - env.world.cookbook.primitives_for(goal)))\n      return diff\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:53:24.506527", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: check if the item is in the inventory or nearby\n    if state.inventory[goal] > 0:\n      return 0\n    elif any(item == idx for idx in state.grid.flatten()):\n      return 1\n    else:\n      return 2\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          \n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    \"\"\"Reconstruct path from start to end.\"\"\"\n    total_actions = []\n    while current_state in came_from:\n      previous_state, actions_to_current = came_from[current_state]\n      total_actions = actions_to_current + total_actions\n      current_state = previous_state\n    return total_actions\n\n  start_state = env._current_state\n  \n  # Check for immediate availability of the item\n  if start_state.inventory[item] > 0:\n      return []\n  \n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:53:25.501770", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Priority based on inventory change\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n            \n            # If the new state is closer to the goal, prioritize it\n          if new_state.inventory[goal] > state.inventory[goal]:\n              priority += 3\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check for immediate availability of the item\n  if start_state.inventory[item] > 0:\n      return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:57:54.596611", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_resource_positions(state, resource_indices):\n      \"\"\"Get all positions of the resources on the grid.\"\"\"\n      positions = {}\n      for idx in resource_indices:\n          grid = state.grid\n          pos_list = np.argwhere(grid[..., idx] == 1)\n          if len(pos_list) > 0:\n              positions[idx] = [tuple(pos) for pos in pos_list]\n      return positions\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  def collect_resources(env, start_state, resource_positions, primitives_needed):\n    \"\"\"Collect all required resources.\"\"\"\n    actions = []\n    current_state = start_state\n    resource_indices = list(primitives_needed.keys())\n    \n    while resource_indices:\n      for resource in resource_indices.copy():\n        if resource not in resource_positions or len(resource_positions[resource]) == 0:\n          raise ValueError(f\"No {env.world.cookbook.index.get(resource)} found on the grid.\")\n        \n        # Use all available positions of this resource\n        while primitives_needed[resource] > 0 and resource_positions[resource]:\n            target_pos = resource_positions[resource].pop()\n            \n            # Move to the target position\n            actions.extend(move_to_position(current_state, target_pos))\n            current_state = env._current_state\n            \n            # Pick up the resource\n            actions.append(USE)\n            current_state = env._current_state\n            \n            primitives_needed[resource] -= 1\n        \n        if primitives_needed[resource] == 0:\n            resource_indices.remove(resource)\n    \n    return actions, current_state\n\n  def find_workshop_position(env):\n      \"\"\"Find a workshop position on the grid.\"\"\"\n      start_state = env._current_state\n      grid = start_state.grid\n      \n      # Assume workshop is indexed as a specific item in the cookbook\n      workshop_index = None  # Replace with actual workshop index if available\n      \n      if workshop_index is not None:\n          pos_list = np.argwhere(grid[..., workshop_index] == 1)\n          if len(pos_list) > 0:\n              return tuple(pos_list[0])\n      \n      raise ValueError(\"No workshop found on the grid.\")\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  resource_positions = get_resource_positions(start_state, list(primitives_needed.keys()))\n  \n  # Collect all required resources\n  actions, current_state = collect_resources(env, start_state, resource_positions, primitives_needed.copy())\n  \n  # Find a workshop position if needed (assuming crafting requires being at a workshop)\n  try:\n      workshop_position = find_workshop_position(env)\n      actions.extend(move_to_position(current_state, workshop_position))\n      current_state = env._current_state\n  except ValueError as e:\n      print(e)  # Log the error but do not raise it if workshops are not required\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(current_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:57:55.621977", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_resource_positions(state, resource_indices):\n    \"\"\"Get all positions of the resources on the grid.\"\"\"\n    positions = {}\n    for idx in resource_indices:\n        grid = state.grid\n        pos_list = np.argwhere(grid[..., idx] == 1)\n        if len(pos_list) > 0:\n            positions[idx] = [tuple(pos) for pos in pos_list]\n    return positions\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  def collect_resources(env, start_state, resource_positions, primitives_needed):\n    \"\"\"Collect all required resources.\"\"\"\n    actions = []\n    current_state = start_state\n    resource_indices = list(primitives_needed.keys())\n    \n    while resource_indices:\n      for resource in resource_indices.copy():\n        if resource not in resource_positions or len(resource_positions[resource]) == 0:\n          raise ValueError(f\"No {env.world.cookbook.index.get(resource)} found on the grid.\")\n        \n        # Use all available positions of this resource\n        while primitives_needed[resource] > 0 and resource_positions[resource]:\n            target_pos = resource_positions[resource].pop()\n            \n            # Move to the target position\n            actions.extend(move_to_position(current_state, target_pos))\n            current_state = env._current_state\n            \n            # Pick up the resource\n            actions.append(USE)\n            current_state = env._current_state\n            \n            primitives_needed[resource] -= 1\n        \n        if primitives_needed[resource] == 0:\n            resource_indices.remove(resource)\n    \n    return actions, current_state\n\n  def find_closest_resource(env, start_state, resource_positions):\n      \"\"\"Find the closest resource to the agent.\"\"\"\n      pos = start_state.pos\n      min_distance = float('inf')\n      closest_resource = None\n      \n      for resource_idx in resource_positions:\n          if len(resource_positions[resource_idx]) == 0:\n              continue\n          \n          distances = [abs(pos[0] - res_pos[0]) + abs(pos[1] - res_pos[1]) for res_pos in resource_positions[resource_idx]]\n          min_res_distance = min(distances)\n          \n          if min_res_distance < min_distance:\n              min_distance = min_res_distance\n              closest_resource = (resource_idx, distances.index(min_res_distance))\n      \n      return closest_resource\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  resource_positions = get_resource_positions(start_state, list(primitives_needed.keys()))\n  \n  actions = []\n  \n  while any(count > 0 for count in primitives_needed.values()):\n      closest_resource = find_closest_resource(env, start_state, resource_positions)\n      \n      if not closest_resource:\n          raise ValueError(\"No resources found on the grid.\")\n      \n      resource_idx, res_index = closest_resource\n      target_pos = resource_positions[resource_idx][res_index]\n      \n      # Move to the target position\n      actions.extend(move_to_position(start_state, target_pos))\n      start_state = env._current_state\n      \n      # Pick up the resource\n      actions.append(USE)\n      start_state = env._current_state\n      \n      primitives_needed[resource_idx] -= 1\n      \n      # Update resource positions\n      resource_positions[resource_idx].pop(res_index)\n      if not resource_positions[resource_idx]:\n          del resource_positions[resource_idx]\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:59:25.957315", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search algorithm with heuristic prioritization.\"\"\"\n      from collections import deque\n      \n      open_set = [(start_state, [], 0)]  # (state, actions, cost)\n      visited = set()\n      \n      while open_set:\n          current_state, actions, cost = min(open_set, key=lambda x: x[2])\n          open_set.remove((current_state, actions, cost))\n          \n          if tuple(current_state.features()) in visited:\n              continue\n          \n          visited.add(tuple(current_state.features()))\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = current_state.step(action)\n              \n              # Avoid revisiting the same state\n              if tuple(new_state.features()) not in visited:\n                  priority = cost + heuristic(new_state, goal) + (1 if action == USE else 0)\n                  open_set.append((new_state, actions + [action], priority))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:59:27.077169", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n      \n      # Check if the current state has used any items or added them to the inventory\n      inv_change = np.any(state.inventory != env._current_state.inventory)\n      \n      # If the goal item is in the inventory, give a high priority\n      goal_in_inventory = state.inventory[goal] > 0\n      \n      return int(goal_in_inventory) + int(inv_change)\n\n  def bfs(start_state, goal):\n      \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions = queue.popleft()\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action and states with changes in inventory\n          next_states = []\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = state.step(action)\n              \n              # Avoid revisiting the same state\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  # Calculate heuristic priority\n                  priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                      \n                  next_states.append((new_state, actions + [action], priority))\n          \n          # Sort states by priority and append to the front of the queue\n          next_states.sort(key=lambda x: -x[2])\n          for new_state, new_actions, _ in next_states:\n              queue.appendleft((new_state, new_actions))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:00:28.589853", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(UP, RIGHT+1)):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and invalid moves (e.g., moving into walls or out of bounds)\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:00:29.596961", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(UP, RIGHT+1)):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check for immediate availability of the item\n  if start_state.inventory[item] > 0:\n      return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:01:49.347704", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def astar(start_state, goal):\n      \"\"\"A* Search with heuristic prioritization.\"\"\"\n      from heapq import heappop, heappush\n      \n      open_set = [(0, start_state, [])]  # (f_score, state, actions)\n      visited = set()\n      \n      while open_set:\n          _, current_state, actions = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  # Calculate heuristic priority\n                  g_score = len(actions) + 1  # Cost from start to this state\n                  h_score = heuristic(new_state, goal) + (1 if action == USE else 0)\n                  f_score = g_score + h_score\n                  \n                  heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:01:50.426813", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and states with changes in inventory\n      next_states = []\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Calculate heuristic priority\n              priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                  \n              next_states.append((new_state, actions + [action], priority))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: -x[2])\n      for new_state, new_actions, _ in next_states:\n          queue.appendleft((new_state, new_actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:03:07.294648", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable representation of the state\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define the goal using the item index\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Perform BFS to find the action sequence\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:03:08.366569", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define the goal using the item index\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Perform BFS to find the action sequence\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:04:13.898565", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      use_actions = [action for action in range(env.world.n_actions) if action == USE and state.next_to(goal)]\n      other_actions = [action for action in range(env.world.n_actions) if action != USE or not state.next_to(goal)]\n      \n      # Filter out redundant movements\n      filtered_actions = []\n      last_action = actions[-1] if actions else None\n      opposite_moves = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}\n      \n      for action in use_actions + other_actions:\n        if last_action is not None and action == opposite_moves[last_action]:\n          continue  # Skip the opposite move immediately after it\n        filtered_actions.append(action)\n      \n      for action in filtered_actions:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:04:14.858762", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      use_actions = [action for action in range(env.world.n_actions) if action == USE and state.next_to(goal)]\n      other_actions = [action for action in range(env.world.n_actions) if action != USE or not state.next_to(goal)]\n\n      for action in use_actions + other_actions:\n        reward, new_state = state.step(action)\n        \n        # Skip if the inventory remains the same (useless step)\n        if np.array_equal(new_state.inventory, state.inventory):\n          continue\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:05:18.012914", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Simple heuristic to prioritize actions that lead closer to the goal.\"\"\"\n    # Placeholder heuristic; can be improved based on specific game dynamics\n    return 0 if state.satisfies(\"\", goal) else 1\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    \n    g_scores = {tuple(start_state.features()): 0}\n    visited = set()\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if tuple(state.features()) in visited:\n        continue\n      \n      visited.add(tuple(state.features()))\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_scores[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:05:19.022773", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:06:44.590669", "function_name": "craft", "function_body": "  def iddfs(current_state, goal_name, goal_arg, max_depth=50):\n      from collections import deque\n\n      for depth in range(max_depth + 1):\n          queue = deque([(current_state, [])])\n          visited_states = set()\n\n          while queue:\n              current_state, actions_taken = queue.popleft()\n\n              if len(actions_taken) > depth:\n                  continue\n\n              if current_state.satisfies(goal_name, goal_arg):\n                  return actions_taken\n\n              # Generate all possible next states\n              for action in range(env.world.n_actions):\n                  reward, next_state = current_state.step(action)\n                  \n                  # Create a hashable representation of the state\n                  state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n                  \n                  if state_hash not in visited_states:\n                      queue.append((next_state, actions_taken + [action]))\n                      visited_states.add(state_hash)\n\n      return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = iddfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:06:45.585615", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      # Simple heuristic: count the number of items needed in the inventory\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      missing_count = sum(primitives_needed.get(i, 0) - state.inventory[i] for i in primitives_needed)\n      return max(0, missing_count)\n\n  def astar(start_state, goal_index):\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_index), start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + start_state.pos + (start_state.dir,): 0}\n    f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + start_state.pos + (start_state.dir,): heuristic(start_state, goal_index)}\n    \n    while open_set:\n      current_f, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies('default', goal_index):\n        return actions_taken\n      \n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          \n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + next_state.pos + (next_state.dir,)\n          \n          tentative_g_score = g_score.get(current_state.state_hash(), float('inf')) + 1\n          \n          if tentative_g_score < g_score.get(state_hash, float('inf')):\n              came_from[state_hash] = (current_state, action)\n              g_score[state_hash] = tentative_g_score\n              f_score[state_hash] = tentative_g_score + heuristic(next_state, goal_index)\n              \n              heapq.heappush(open_set, (f_score[state_hash], next_state, actions_taken + [action]))\n    \n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n    raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = astar(start_state, goal_index)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:07:46.916638", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:07:47.999825", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:08:47.886417", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:08:48.971042", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:10:02.014938", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Calculate the distance to the nearest workshop if necessary\n    if state.inventory[env.world.stone_index] > 0 and env.world.workshop_indices:\n      workshop_distances = [np.linalg.norm(np.array(state.pos) - np.array((x // env.world.grid.shape[1], x % env.world.grid.shape[1])), ord=1)\n                            for x in env.world.workshop_indices]\n      return min(workshop_distances, default=float('inf'))\n    return 0\n\n  def astar(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          \n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:10:02.990897", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Calculate the distance to the nearest workshop if necessary\n    if state.inventory[env.world.stone_index] > 0 and env.world.workshop_indices:\n      workshop_distances = [np.linalg.norm(np.array(state.pos) - np.array((x // env.world.grid.shape[1], x % env.world.grid.shape[1])), ord=1)\n                            for x in env.world.workshop_indices]\n      return min(workshop_distances, default=float('inf'))\n    return 0\n\n  def a_star(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = [(heuristic(start_state, goal), start_state, [])]\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          priority = heuristic(new_state, goal) + len(actions) + 1\n          heappush(open_set, (priority, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:12:31.318081", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate neighbors based on valid moves\n      for action in range(env.world.n_actions - 1):  # Exclude USE to avoid crafting prematurely\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change and is not a dead end\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Avoid loops by checking if we're back at the start position with no inventory changes\n          if new_state.pos != start_state.pos or np.any(new_state.inventory != start_state.inventory):\n            queue.append((new_state, actions + [action]))\n      \n      # Attempt to use items only if inventory is not empty\n      if np.any(start_state.inventory > 0):\n        reward, new_state = state.step(USE)\n        \n        # Check if using an item led to a meaningful state change and is not a dead end\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Avoid loops by checking if we're back at the start position with no inventory changes\n          if new_state.pos != start_state.pos or np.any(new_state.inventory != start_state.inventory):\n            queue.append((new_state, actions + [USE]))\n    \n    return None  # No solution found\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions within the grid.\"\"\"\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      width, height = env.world.scenario.init_grid.shape[:2]\n      return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:12:32.309708", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_neighbors(pos):\n    \"\"\"Get valid neighboring positions within the grid.\"\"\"\n    x, y = pos\n    directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n    width, height = env.world.scenario.init_grid.shape[:2]\n    return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def is_walkable(pos):\n    \"\"\"Check if a position is walkable.\"\"\"\n    x, y = pos\n    grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n    return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  def find_path_to_workshop(start_pos, goal_kind):\n    \"\"\"Find a path to the nearest workshop or resource needed for the item.\"\"\"\n    from collections import deque\n    \n    queue = deque([start_pos])\n    visited = set([start_pos])\n    parent_map = {start_pos: None}\n    \n    while queue:\n      pos = queue.popleft()\n      \n      if env.world.scenario.init_grid[pos[0], pos[1], goal_kind] > 0:\n        path = []\n        while pos is not None:\n          path.append(pos)\n          pos = parent_map[pos]\n        return path[::-1]\n      \n      for neighbor in get_neighbors(pos):\n        if is_walkable(neighbor) and neighbor not in visited:\n          queue.append(neighbor)\n          visited.add(neighbor)\n          parent_map[neighbor] = pos\n    \n    return None  # No path found\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  goal_index = item\n\n  # Find the path to the nearest workshop or resource needed for the item\n  path_to_workshop = find_path_to_workshop(start_state.pos, goal_index)\n  \n  if not path_to_workshop:\n    raise ValueError(\"No path to a required resource found.\")\n  \n  actions = []\n\n  # Move to each position in the path\n  for pos in path_to_workshop[1:]:  # Skip the starting position\n    current_pos = start_state.pos\n    \n    delta_x = pos[0] - current_pos[0]\n    delta_y = pos[1] - current_pos[1]\n    \n    if delta_x < 0:\n      actions.extend([LEFT for _ in range(abs(delta_x))])\n    elif delta_x > 0:\n      actions.extend([RIGHT for _ in range(delta_x)])\n    \n    if delta_y < 0:\n      actions.extend([DOWN for _ in range(abs(delta_y))])\n    elif delta_y > 0:\n      actions.extend([UP for _ in range(delta_y)])\n    \n    # Use the resource at the position\n    actions.append(USE)\n  \n  # Perform BFS to craft the item from the current state\n  final_actions = bfs(start_state, goal_index)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:13:31.903231", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:13:32.869860", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = hash(next_state)  # Use a hash function to represent the state\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:14:49.160384", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              if action == USE:\n                  use_actions.append((new_state, actions + [action]))\n              else:\n                  # Check if the next state allows a USE action\n                  for next_action in range(env.world.n_actions):\n                      reward_next, _ = new_state.step(next_action)\n                      if reward_next != 0.0:  # Assuming USE yields non-zero reward\n                          priority_actions.append((new_state, actions + [action]))\n                          break\n                  else:\n                      other_actions.append((new_state, actions + [action]))\n\n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:14:50.222122", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n      # Simple heuristic based on the count of the goal item in the inventory\n      return state.inventory[goal] < 1\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n        state, actions = queue.popleft()\n        \n        if state.satisfies(\"\", goal):\n            return actions\n        \n        # Prioritize USE action and then prioritize movement actions that lead to USE\n        priority_actions = []\n        use_actions = []\n        other_actions = []\n\n        for action in range(env.world.n_actions):\n            reward, new_state = state.step(action)\n            \n            if tuple(new_state.features()) not in visited:\n                visited.add(tuple(new_state.features()))\n                \n                if action == USE:\n                    use_actions.append((new_state, actions + [action]))\n                else:\n                    # Check if the next state allows a USE action\n                    for next_action in range(env.world.n_actions):\n                        reward_next, _ = new_state.step(next_action)\n                        if reward_next != 0.0:  # Assuming USE yields non-zero reward\n                            priority_actions.append((new_state, actions + [action]))\n                            break\n                    else:\n                        other_actions.append((new_state, actions + [action]))\n\n        # Extend queue with prioritized actions based on heuristic\n        queue.extend(sorted(priority_actions, key=lambda x: heuristic(x[0], goal)))\n        queue.extend(use_actions)\n        queue.extend(other_actions)\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:15:48.177926", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:15:49.252648", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:16:44.401139", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies('default', goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action in range(env.world.n_actions):\n            _, next_state = current_state.step(action)\n            state_hash = hash_state(next_state)\n\n            if state_hash not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(state_hash)\n\n    return None\n\n  # Reset environment and initialize scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:16:45.384141", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = hash_state(next_state)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Reset environment to initial state\n  env.reset()\n  \n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:17:45.014335", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Try USE action first\n      used, new_state = state.step(USE)\n      if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          if new_state.satisfies(\"\", goal):\n              return actions + [USE]\n          queue.appendleft((new_state, actions + [USE]))\n      \n      # Explore other actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:17:46.006433", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          if action == USE and new_state.grid[state.pos] != 0:  # Ensure there's something to use\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:19:15.659681", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      # Simple heuristic: number of items needed to complete the recipe\n      return sum(\n          max(0, state.world.cookbook.recipes.get(goal_index, {}).get(i_kind, 0) - count)\n          for i_kind, count in enumerate(state.inventory)\n      )\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search to find the shortest sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        tentative_g_score = g_score[current_state] + 1\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if tentative_g_score < g_score.get(next_state, float('inf')):\n          came_from[next_state] = current_state\n          g_score[next_state] = tentative_g_score\n          f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:19:16.649068", "function_name": "craft", "function_body": "  def heuristic(state):\n      \"\"\"Estimate the distance from the state to the goal.\"\"\"\n      # Simple heuristic: number of items needed in inventory\n      return np.sum(np.maximum(0, env.world.cookbook.primitives_for(item).values() - state.inventory[env.world.cookbook.primitives]))\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state)}\n\n    while open_set:\n        current_f, current_state, actions_taken = heapq.heappop(open_set)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action in range(env.world.n_actions):\n            _, next_state = current_state.step(action)\n            tentative_g_score = g_score[current_state] + 1\n            state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n            \n            if tentative_g_score < g_score.get(next_state, float('inf')):\n                came_from[next_state] = current_state, actions_taken + [action]\n                g_score[next_state] = tentative_g_score\n                f_score[next_state] = tentative_g_score + heuristic(next_state)\n                heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:20:42.099568", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:20:43.102689", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic based on the number of required primitives not yet acquired.\"\"\"\n    required_primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = current_state.inventory\n    missing_count = sum(max(required_primitives.get(i, 0) - current_inventory[i], 0) for i in required_primitives)\n    return missing_count\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal with heuristic.\"\"\"\n    open_set = [(heuristic(start_state, goal_arg), start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = open_set.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          h = heuristic(next_state, goal_arg)\n          open_set.append((h + len(actions_taken) + 1, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n      # Sort the open set based on f-score\n      open_set.sort()\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:21:50.242139", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:21:51.232668", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n    \"\"\"Simple heuristic: count of the goal item in the inventory.\"\"\"\n    return -state.inventory[goal_arg]\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal with heuristics.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          priority = -heuristic(next_state, goal_arg)  # Use negative heuristic to turn it into a min-heap\n          heapq.heappush(open_set, (priority, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:24:21.426967", "function_name": "craft", "function_body": "  # Helper function for generating valid neighboring states with associated actions\n  def generate_next_states(current_state):\n    next_states = []\n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      if not env._is_done():\n        next_states.append((next_state, action))\n    return next_states\n\n  # Helper function for hashing states to avoid revisiting them\n  def hash_state(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + state.pos + (state.dir,)\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm with heuristic.\"\"\"\n    from heapq import heappush, heappop\n\n    # Priority queue for A*\n    open_set = []\n    heappush(open_set, (0, start_state, []))  # (f_score, state, actions_taken)\n    \n    g_scores = {hash_state(start_state): 0}\n    f_scores = {hash_state(start_state): heuristic(start_state)}\n\n    came_from = {}\n\n    while open_set:\n      current_f, current_state, actions_taken = heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state)\n\n      for next_state, action in generate_next_states(current_state):\n        tentative_g_score = g_scores[hash_state(current_state)] + 1\n        state_hash = hash_state(next_state)\n        \n        if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n          came_from[next_state] = (current_state, actions_taken + [action])\n          g_scores[state_hash] = tentative_g_score\n          f_scores[state_hash] = tentative_g_score + heuristic(next_state)\n          heappush(open_set, (f_scores[state_hash], next_state, actions_taken + [action]))\n\n    return None\n\n  def heuristic(state):\n    \"\"\"Heuristic function to estimate cost from state to goal.\"\"\"\n    # Simple heuristic: number of primitives needed minus those already in inventory\n    goal_primitives = env.world.cookbook.primitives_for(item)\n    current_inventory = {idx: count for idx, count in enumerate(state.inventory) if count > 0}\n    \n    # Calculate the sum of differences between required and available primitives\n    return sum(max(goal_count - current_inventory.get(idx, 0), 0) for idx, goal_count in goal_primitives.items())\n\n  def reconstruct_path(came_from, current_state):\n    \"\"\"Reconstruct path from start to current state.\"\"\"\n    total_path = []\n    while current_state in came_from:\n      (prev_state, actions_taken) = came_from[current_state]\n      total_path = [actions_taken[-1]] + total_path\n      current_state = prev_state\n    return total_path\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:24:22.428755", "function_name": "craft", "function_body": "  def a_star(start_state, goal_name, goal_arg):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))  # (f_score, state, actions_taken)\n      \n      # Set to track visited states and their costs\n      g_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n      f_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state)}\n      \n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n          \n          # Check if the goal is satisfied\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n          \n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              tentative_g_score = g_scores[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(next_state)\n                  heapq.heappush(open_set, (f_scores[state_hash], next_state, actions_taken + [action]))\n      \n      return None\n\n  def heuristic(state):\n      # Simple heuristic based on the number of required items not in inventory\n      goal_inventory = env.world.cookbook.primitives_for(env.world.cookbook.index.get(item))\n      current_inventory = {env.world.cookbook.index[i]: count for i, count in enumerate(state.inventory) if count > 0}\n      \n      missing_items = sum(goal_inventory.get(kind, 0) - current_inventory.get(kind, 0) for kind in goal_inventory)\n      \n      return max(missing_items, 1)\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:25:24.158154", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
