{"timestamp": "2025-06-25T01:32:34.239203", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None\n        if new_state is None:\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:33:52.353919", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:33:53.392375", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(state, goal_item):\n    \"\"\"Check if the state can be reached with the current resources to craft the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_item)\n    \n    # Check if all required primitives are available in the inventory or on the grid\n    for ingredient, count in primitives.items():\n      if state.inventory[ingredient] < count:\n        # Check if the ingredient is available on the grid\n        if not any(state.grid[:, :, ingredient].flatten()):\n          return False\n    \n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the goal item is reachable with current resources\n  if not is_reachable(start_state, item):\n      raise ValueError(f\"Goal item {item} cannot be crafted with available resources.\")\n      \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:34:58.181952", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_neighbors(state):\n    \"\"\"Get all neighboring states and corresponding actions.\"\"\"\n    neighbors = []\n    \n    for action in range(env.world.n_actions):\n      reward, new_state = state.step(action)\n      \n      if new_state != state:  # Avoid revisiting the same state\n        neighbors.append((new_state, action))\n    \n    return neighbors\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for neighbor, action in get_neighbors(state):\n        if tuple(neighbor.features()) not in visited:\n          visited.add(tuple(neighbor.features()))\n          queue.append((neighbor, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:34:59.229628", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Try using items nearby before moving\n      for action in [USE]:\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.append((new_state, actions + [action]))\n      \n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:36:31.756840", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize using items nearby\n      for action in [USE]:\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.appendleft((new_state, actions + [action]))  # Use appendleft to prioritize\n      \n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:36:32.739825", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to estimate distance from state to goal.\"\"\"\n    # Check if the item is in inventory\n    if state.inventory[goal] > 0:\n        return 0\n    \n    # Calculate the Manhattan distance to nearest resource needed\n    primitives = env.world.cookbook.primitives_for(goal)\n    \n    min_distance = float('inf')\n    for primitive, _ in primitives.items():\n        for dx in range(-1, 2):\n            for dy in range(-1, 2):\n                nx, ny = state.pos[0] + dx, state.pos[1] + dy\n                if (0 <= nx < env.world.WIDTH and \n                    0 <= ny < env.world.HEIGHT and \n                    state.grid[nx][ny][primitive]):\n                    min_distance = min(min_distance, abs(dx) + abs(dy))\n    \n    return min_distance\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n      from heapq import heappop, heappush\n      \n      open_set = [(heuristic(start_state, goal), start_state, [])]\n      visited = set([tuple(start_state.features())])\n      \n      while open_set:\n          _, state, actions = heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Try using items nearby before moving\n          for action in [USE]:\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  priority = heuristic(new_state, goal) + len(actions) + 1\n                  heappush(open_set, (priority, new_state, actions + [action]))\n          \n          # Explore movement actions\n          for action in [UP, DOWN, LEFT, RIGHT]:\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  priority = heuristic(new_state, goal) + len(actions) + 1\n                  heappush(open_set, (priority, new_state, actions + [action]))\n\n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:37:56.690557", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      # Simple heuristic based on inventory count for the goal item\n      return state.inventory[goal]\n\n  def astar_search(start_state, goal, max_depth=50):\n      \"\"\"A* search with heuristic prioritization and depth limit.\"\"\"\n      \n      from queue import PriorityQueue\n      \n      pq = PriorityQueue()\n      pq.put((0, start_state, []))\n      visited = set([tuple(start_state.features())])\n      \n      while not pq.empty():\n          _, state, actions = pq.get()\n          \n          if len(actions) >= max_depth:\n              continue  # Skip deeper paths to prevent infinite loops and excessive computation\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              g_cost = len(actions) + 1\n              h_cost = heuristic(new_state, goal)\n              f_cost = g_cost + h_cost  # A* cost function\n\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  pq.put((f_cost, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar_search(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:37:57.667170", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on inventory count for the goal item\n    return state.inventory[goal]\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search with heuristic prioritization.\"\"\"\n      \n      from collections import deque\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current_state, actions = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, current_state, actions)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              feature_tuple = tuple(new_state.features())\n              \n              if feature_tuple not in g_score or tentative_g_score < g_score[feature_tuple]:\n                  came_from[new_state] = (current_state, actions)\n                  g_score[feature_tuple] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_actions = []\n      while current_state in came_from:\n          (current_state, prev_actions) = came_from[current_state]\n          total_actions.extend(actions)\n      return prev_actions[::-1]\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:39:05.445211", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  \n  try:\n      start_scenario = env.scenario\n  except AttributeError:\n      raise ValueError(\"The environment does not have a scenario attribute. Make sure to initialize it properly.\")\n      \n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:39:06.553834", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:41:06.896400", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the distance to the nearest occurrence of the goal item and inventory.\n    grid = state.grid\n    pos = state.pos\n    \n    # Find all positions with the goal item in the grid\n    goal_positions = np.argwhere(grid[:, :, goal] > 0)\n    \n    if len(goal_positions) == 0:\n      return float('inf')  # No heuristic value if no goal items are found\n    \n    # Calculate Manhattan distances from the agent's position to each goal position\n    distances = [abs(pos[0] - gp[0]) + abs(pos[1] - gp[1]) for gp in goal_positions]\n    \n    min_distance = min(distances)\n    \n    # Penalize states with fewer goal items in inventory\n    inventory_penalty = 1 / (state.inventory[goal] + 1)\n    \n    return min_distance + inventory_penalty\n\n  def bfs_with_heuristic(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Sort possible actions based on heuristic\n      actions_sorted = sorted(range(env.world.n_actions), key=lambda a: (heuristic(state.step(a)[1], goal), -a))\n      \n      for action in actions_sorted:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:41:07.902641", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the distance to the nearest occurrence of the goal item.\n    grid = state.grid\n    pos = state.pos\n    \n    # Find all positions with the goal item in the grid\n    goal_positions = np.argwhere(grid[:, :, goal] > 0)\n    \n    if len(goal_positions) == 0:\n      return float('inf')  # No heuristic value if no goal items are found\n    \n    # Calculate Manhattan distances from the agent's position to each goal position\n    distances = [abs(pos[0] - gp[0]) + abs(pos[1] - gp[1]) for gp in goal_positions]\n    \n    return min(distances)\n\n  def astar(start_state, goal):\n    \"\"\"A* search with heuristic prioritization.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))  # (f_score, state, actions)\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_actions = []\n    while current_state in came_from:\n      _, action = came_from[current_state]\n      total_actions.append(action)\n      current_state = came_from[current_state][0]\n    \n    return list(reversed(total_actions))\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:42:32.098258", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n      # Simple heuristic: number of required items not in inventory\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory\n      return sum(max(0, count - current_inventory[idx]) for idx, count in primitives.items())\n\n  def astar(start_state, goal_name, goal_arg):\n      open_set = [(start_state, [], 0)]\n      visited_states = set()\n\n      while open_set:\n          current_state, actions_taken, g_cost = min(open_set, key=lambda x: x[2] + heuristic(x[0], goal_arg))\n          open_set.remove((current_state, actions_taken, g_cost))\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  open_set.append((next_state, actions_taken + [action], g_cost + 1))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Use A* to find the action sequence\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:42:33.194674", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Use BFS to find the action sequence\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:44:41.248327", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if new_state.pos == state.pos and action != USE:\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function using Manhattan distance to the nearest required item.\"\"\"\n    cookbook = state.world.cookbook\n    recipes = cookbook.recipes\n    \n    if goal not in recipes:\n      return 0  # If no recipe, no heuristic value\n    \n    recipe = recipes[goal]\n    \n    def find_nearest(kind):\n      \"\"\"Find the Manhattan distance to the nearest cell containing `kind`.\"\"\"\n      grid = state.grid\n      pos = state.pos\n      \n      min_distance = float('inf')\n      \n      for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n          if np.any(grid[y, x] == kind):\n            distance = abs(y - pos[0]) + abs(x - pos[1])\n            min_distance = min(min_distance, distance)\n            \n      return min_distance\n    \n    total_heuristic = 0\n    for ingredient, count in recipe.items():\n        # Assuming \"_key\" is a placeholder and should be ignored\n        if ingredient != \"_key\":\n            total_heuristic += find_nearest(ingredient) * count\n    \n    return total_heuristic\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path using heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    visited = set()\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if tuple(current_state.features()) in visited:\n        continue\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      visited.add(tuple(current_state.features()))\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)):\n        reward, new_state = current_state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if new_state.pos == current_state.pos and action != USE:\n          continue\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        features_tuple = tuple(new_state.features())\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          g_score[features_tuple] = tentative_g_score\n          f_score[features_tuple] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score[features_tuple], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
