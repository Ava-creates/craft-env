{"timestamp": "2025-06-25T03:57:01.898419", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None and not in a stuck position\n        if new_state is None or tuple(new_state.features()) == tuple(state.features()):\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state):\n    \"\"\"Simple heuristic: count the number of steps needed to pick up all required primitives.\"\"\"\n    primitives = env.world.cookbook.primitives_for(item)\n    current_inventory = state.inventory\n    distance_sum = 0\n    \n    for primitive, count in primitives.items():\n      if current_inventory[primitive] >= count:\n        continue\n      \n      # Find the closest instance of the primitive on the grid\n      distances = np.abs(state.grid[..., primitive].nonzero() - np.array(state.pos)).sum(axis=0)\n      if len(distances) == 0:\n          return float('inf')  # No instance found, consider this path costly\n      distance_sum += min(distances)\n    \n    return distance_sum\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = current_state.step(action)\n        \n        # Ensure the new state is not None and not in a stuck position\n        if new_state is None or tuple(new_state.features()) == tuple(current_state.features()):\n          continue\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        state_tuple = tuple(new_state.features())\n        \n        if state_tuple not in g_score or tentative_g_score < g_score[state_tuple]:\n          came_from[state_tuple] = (current_state, actions)\n          g_score[state_tuple] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = []\n    while tuple(current_state.features()) in came_from:\n      (current_state, actions) = came_from[tuple(current_state.features())]\n      total_path.append(actions)\n    total_path.reverse()\n    return [action for sublist in total_path for action in sublist]\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  # Check for simple pick-up scenario\n  if item in start_state.world.grabbable_indices:\n    for action in range(env.world.n_actions - 1):  # Exclude USE action\n      _, new_state = start_state.step(action)\n      if new_state and new_state.satisfies(\"\", item):\n        return [action]\n  \n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:57:03.014162", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None and not in a stuck position\n        if new_state is None or tuple(new_state.features()) == tuple(state.features()):\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  # Check for simple pick-up scenario\n  if item in start_state.world.grabbable_indices:\n    for action in range(env.world.n_actions - 1):  # Exclude USE action\n      _, new_state = start_state.step(action)\n      if new_state and new_state.satisfies(\"\", item):\n        return [action]\n  \n  # Check for nearby resources needed for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item)\n  actions_to_pickup_primitives = []\n  \n  for primitive, count in primitives_needed.items():\n    for _ in range(count):\n      # Find the nearest primitive\n      for action in range(env.world.n_actions - 1):  # Exclude USE action\n        _, new_state = start_state.step(action)\n        if new_state and new_state.next_to(primitive):\n          actions_to_pickup_primitives.append(action)\n          break\n  \n  # After collecting primitives, attempt crafting again\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions_to_pickup_primitives + final_actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:59:27.761831", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      # Heuristic function based on Manhattan distance to the nearest workshop\n      x1, y1 = state.pos\n      min_distance = float('inf')\n      \n      for workshop_pos in env.world.workshop_indices:\n          wx, wy = divmod(workshop_pos, env.scenario.init_grid.shape[1])\n          distance = abs(x1 - wx) + abs(y1 - wy)\n          if distance < min_distance:\n              min_distance = distance\n      \n      return min_distance\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path.\"\"\"\n      from collections import defaultdict\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state))\n      \n      came_from = {}\n      g_score = defaultdict(lambda: float('inf'))\n      g_score[tuple(start_state.features())] = 0\n      \n      while open_set:\n          _, current_state = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              path = []\n              while current_state in came_from:\n                  path.append(came_from[current_state])\n                  current_state = came_from[current_state]\n              return path[::-1]\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[new_state] = action\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (f_score, new_state))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:59:28.745252", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance as heuristic for the A* search\n    x1, y1 = state.pos\n    x2, y2 = env.scenario.init_pos  # Assuming initial position is a goal point\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = [(current_state, actions)]\n      \n      while current_state in came_from:\n          state_action_pair = came_from[current_state]\n          current_state, action = state_action_pair\n          actions = actions[:-1] if actions else []\n          total_path.append((state_action_pair[0], actions + [action]))\n      \n      return [action for _, actions in reversed(total_path)]\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:02:00.012254", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Only add to queue if the new state is valid and not visited\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    # Heuristic function: count of items needed to craft the goal minus current inventory\n    recipe = env.world.cookbook.primitives_for(goal)\n    if not recipe:\n      return float('inf')\n    return sum(recipe.get(i_kind, 0) - state.inventory[i_kind] for i_kind in recipe)\n\n  def astar(start_state, goal):\n    from heapq import heappush, heappop\n    import itertools\n\n    # Priority queue entry: (priority, count, task)\n    pq = []\n    heappush(pq, (heuristic(start_state, goal), itertools.count().next(), start_state, []))\n    \n    visited = set([tuple(start_state.features())])\n    \n    while pq:\n      _, __, state, actions = heappop(pq)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Only add to queue if the new state is valid and not visited\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          heappush(pq, (heuristic(new_state, goal) + len(actions), next(itertools.count()), new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:02:01.022652", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def a_star(start_state, goal):\n    import heapq\n    \n    # Priority queue with (f_score, state, actions)\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    # Simple heuristic: distance to the goal in terms of primitive counts\n    primitives = env.world.cookbook.primitives_for(goal)\n    inventory_counts = {env.world.cookbook.index.get(name): count for name, count in zip(env.world.cookbook.index.ordered_contents, state.inventory) if name in primitives}\n    return sum(primitives.get(kind, 0) - inventory_counts.get(kind, 0) for kind in primitives)\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = []\n    while current_state in came_from:\n      (current_state, action), actions = came_from[current_state], actions[:-1]\n      total_path.append(action)\n    \n    return list(reversed(actions))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:04:09.119909", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of items needed to craft the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    return sum(primitives_needed.get(idx, 0) - current_inventory[idx] for idx in primitives_needed)\n\n  def astar(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_actions = []\n    while current in came_from:\n      (prev, prev_actions) = came_from[current]\n      total_actions = prev_actions\n      current = prev\n    return total_actions + actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:04:10.112277", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: Manhattan distance to the nearest required item if needed\n    required_items = env.world.cookbook.primitives_for(goal)\n    min_distance = float('inf')\n    \n    for i_kind in required_items:\n      if not state.inventory[i_kind] > 0:\n        # Find the nearest required item\n        grid = state.grid[:, :, i_kind]\n        agent_pos = np.array(state.pos)\n        \n        indices = np.argwhere(grid > 0)\n        distances = [np.sum(np.abs(agent_pos - idx)) for idx in indices]\n        \n        if distances:\n          min_distance = min(min_distance, min(distances))\n    \n    return min_distance\n\n  def astar(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current, actions = heappop(open_set)\n      \n      if current.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current.step(action)\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_path = []\n    while current in came_from:\n      current, action_list = came_from[current]\n      total_path.extend(action_list)\n    return total_path[::-1]  # Reverse path since we start from goal\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:05:35.890629", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n    \n    # Priority queue to explore shorter paths first\n    priority_queue = []\n\n    while queue or priority_queue:\n      if not queue and priority_queue:\n        # Replenish queue from priority queue if needed\n        queue.extend(sorted(priority_queue, key=lambda x: len(x[1])))\n        priority_queue.clear()\n\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          new_actions = actions_taken + [action]\n          # Add to priority queue based on the length of actions taken\n          priority_queue.append((next_state, new_actions))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T04:05:37.000134", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              # Hash the state based on grid, inventory, position, and direction\n              state_hash = (tuple(next_state.grid.flatten()), \n                            tuple(next_state.inventory), \n                            next_state.pos, \n                            next_state.dir)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T04:07:58.821620", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T04:07:59.804606", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Heuristic function based on the number of items in inventory and proximity to required ingredients.\"\"\"\n      # Count how many required ingredients are already in the inventory\n      recipe = env.world.cookbook.recipes.get(goal_index, {})\n      required_counts = {ingredient: count for ingredient, count in recipe.items() if isinstance(ingredient, int)}\n      \n      # Check if any required item is zero distance away (i.e., in inventory)\n      proximity_scores = []\n      for ingredient, count in required_counts.items():\n          if state.inventory[ingredient] >= count:\n              proximity_scores.append(0)  # Already have enough in inventory\n          else:\n              # Calculate the Manhattan distance to the nearest cell containing the ingredient\n              ingredient_locations = np.argwhere(state.grid[:, :, ingredient])\n              if ingredient_locations.size > 0:\n                  agent_pos = np.array(state.pos)\n                  distances = [np.sum(np.abs(agent_pos - loc)) for loc in ingredient_locations]\n                  proximity_scores.append(min(distances))\n              else:\n                  # Ingredient not found on the grid, consider a large penalty\n                  proximity_scores.append(100)  # Large penalty\n      \n      return sum(proximity_scores)\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {hash((start_state.grid.tobytes(), tuple(start_state.inventory), start_state.pos, start_state.dir)): 0}\n    \n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        tentative_g_score = g_score.get(hash((current_state.grid.tobytes(), tuple(current_state.inventory), current_state.pos, current_state.dir)), float('inf')) + 1\n        \n        if tentative_g_score < g_score.get(state_hash, float('inf')):\n          came_from[state_hash] = (current_state, action)\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n    \n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    \"\"\"Reconstructs the path from start to goal.\"\"\"\n    total_path = []\n    while current_state in came_from:\n      current_state, action = came_from[current_state]\n      total_path.append(action)\n    total_path.reverse()\n    return total_path + actions_taken\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = astar(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:10:23.567900", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the number of items needed for the recipe minus those already in inventory\n    if goal not in env.world.cookbook.recipes:\n      return float('inf')  # No recipe available\n    \n    primitives_needed = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory.copy()\n    \n    cost = 0\n    for primitive, count in primitives_needed.items():\n      if current_inventory[primitive] < count:\n        cost += (count - current_inventory[primitive])\n    \n    return cost\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(range(4)):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (not any(new_state.grid[new_state.pos] == env.world.non_grabbable_indices) and\n            tuple(new_state.features()) not in came_from):\n          \n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n            came_from[tuple(new_state.features())] = (current_state, action)\n            g_score[tuple(new_state.features())] = tentative_g_score\n            f_score = tentative_g_score + heuristic(new_state, goal)\n            heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:10:24.578296", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with priority queue.\"\"\"\n    from collections import deque\n    \n    # Priority queue prioritizing states where inventory progress has been made\n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (not any(new_state.grid[state.pos] == env.world.non_grabbable_indices) and\n            tuple(new_state.features()) not in visited):\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states with increased inventory progress towards goal\n          if new_state.inventory[goal] > state.inventory[goal]:\n              queue.appendleft((new_state, actions + [action]))\n          else:\n              queue.append((new_state, actions + [action]))\n\n      # Ensure the agent can move to grab items nearby if needed\n      for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n          new_pos = (state.pos[0] + direction[0], state.pos[1] + direction[1])\n          \n          # Check bounds and non-grabbable indices\n          if (0 <= new_pos[0] < env.world.scenario.init_grid.shape[0] and\n              0 <= new_pos[1] < env.world.scenario.init_grid.shape[1] and\n              not any(env.world.scenario.init_grid[new_pos] == env.world.non_grabbable_indices)):\n              \n              # Simulate movement to the new position\n              _, moved_state = state.step(direction.index(new_pos))\n              \n              if tuple(moved_state.features()) not in visited:\n                  visited.add(tuple(moved_state.features()))\n                  queue.append((moved_state, actions + [direction.index(new_pos)]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T04:13:38.398223", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None and not in a stuck position\n        if new_state is None or tuple(new_state.features()) == tuple(state.features()):\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_nearest_resource(start_state, resource_index):\n      \"\"\"Find the nearest path to a resource.\"\"\"\n      from collections import deque\n      \n      directions = [(UP, (0, -1)), (DOWN, (0, 1)), (LEFT, (-1, 0)), (RIGHT, (1, 0))]\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions = queue.popleft()\n          \n          if state.next_to(resource_index):\n              return actions + [USE]\n          \n          for action, (dx, dy) in directions:\n              new_pos = (state.pos[0] + dx, state.pos[1] + dy)\n              \n              # Ensure the new position is within bounds\n              if not (0 <= new_pos[0] < env.world.scenario.init_grid.shape[0] and \n                      0 <= new_pos[1] < env.world.scenario.init_grid.shape[1]):\n                  continue\n              \n              _, new_state = state.step(action)\n              if new_state is None:\n                  continue\n              \n              state_tuple = tuple(new_state.features())\n              if state_tuple not in visited:\n                  visited.add(state_tuple)\n                  queue.append((new_state, actions + [action]))\n      \n      return None  # No path to resource found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  # Check for simple pick-up scenario\n  if item in start_state.world.grabbable_indices:\n    for action in range(env.world.n_actions - 1):  # Exclude USE action\n      _, new_state = start_state.step(action)\n      if new_state and new_state.satisfies(\"\", item):\n        return [action]\n  \n  # Check for nearby resources needed for crafting\n  primitives_needed = env.world.cookbook.primitives_for(item)\n  actions_to_pickup_primitives = []\n  \n  for primitive, count in primitives_needed.items():\n    for _ in range(count):\n      # Find the nearest primitive\n      path_to_primitive = find_nearest_resource(start_state, primitive)\n      if path_to_primitive:\n          actions_to_pickup_primitives.extend(path_to_primitive)\n          start_state = env._current_state\n          for action in actions_to_pickup_primitives:\n              _, start_state = start_state.step(action)\n  \n  # After collecting primitives, attempt crafting again\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions_to_pickup_primitives + final_actions", "island_id": 8, "scores": {"3": 1.5}}
