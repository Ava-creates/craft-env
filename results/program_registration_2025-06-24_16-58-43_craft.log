{"timestamp": "2025-06-25T15:14:31.399248", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Use a hashable representation of the state\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos[0], next_state.pos[1]) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:14:32.540295", "function_name": "craft", "function_body": "  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, next_state = state.step(action)\n          # Use a hashable representation of the state\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos[0], next_state.pos[1]) + (next_state.dir,)\n          neighbors.append((next_state, action, state_hash))\n      return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      neighbors = get_neighbors(current_state)\n      \n      for neighbor_state, action, state_hash in neighbors:\n          if state_hash not in visited_states:\n              queue.append((neighbor_state, actions_taken + [action]))\n              visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:15:43.819804", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n      reward, new_state = state.step(action)\n      neighbors.append((new_state, action))\n    return neighbors\n\n  def heuristic(state, goal):\n    # A simple heuristic based on the number of items needed\n    goal_inventory = np.zeros_like(state.inventory)\n    goal_inventory[goal] = 1\n    needed_items = env.world.cookbook.primitives_for(goal)\n    current_primitives = {env.world.cookbook.index.get(i): count for i, count in enumerate(state.inventory) if count > 0 and i in env.world.primitives}\n    \n    heuristic_value = 0\n    for primitive, required_count in needed_items.items():\n      if primitive not in current_primitives:\n        heuristic_value += required_count\n    \n    return heuristic_value\n\n  def a_star(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_scores = {tuple(start_state.features()): 0}\n    f_scores = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for new_state, action in get_neighbors(current_state):\n        tentative_g_score = g_scores[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, action)\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_scores[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_scores[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  came_from = {}\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:15:44.780381", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Heuristic based on Manhattan distance to nearest ingredient needed\n    needed_ingredients = env.world.cookbook.primitives_for(item)\n    min_distance = float('inf')\n    \n    for i_kind, count in needed_ingredients.items():\n        if state.inventory[i_kind] >= count:\n            continue\n        for x in range(env.world.grid_width):\n            for y in range(env.world.grid_height):\n                if state.grid[x, y, i_kind] > 0:\n                    distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                    min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    from collections import defaultdict\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.features())] = 0\n    f_score = defaultdict(lambda: float('inf'))\n    f_score[tuple(start_state.features())] = heuristic(start_state)\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state)\n          heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path_actions = []\n      while current_state in came_from:\n          prev_state, actions_to_current = came_from[current_state]\n          total_path_actions.extend(actions_to_current)\n          current_state = prev_state\n      return list(reversed(total_path_actions))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:17:01.560863", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n      # Calculate the Manhattan distance to the nearest required item in the inventory or on the grid\n      grid = state.grid.argmax(axis=2)\n      inventory = state.inventory\n      \n      if inventory[goal_item] > 0:\n          return 0\n\n      goal_indices = np.argwhere(grid == goal_item)\n\n      if goal_indices.size > 0:\n          agent_pos = np.array(state.pos)\n          distances = [np.sum(np.abs(agent_pos - idx)) for idx in goal_indices]\n          return min(distances) + 1\n      else:\n          # If no required items are found, return a high heuristic value\n          return float('inf')\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search algorithm to find the shortest sequence of actions.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n      f_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n      \n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n          \n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              tentative_g_score = g_scores[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_scores[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (f_scores[state_hash], next_state, actions_taken + [action]))\n      \n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:17:02.547018", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n      # Calculate the Manhattan distance to the nearest required items in the inventory\n      required_items = env.world.cookbook.primitives_for(goal_item)\n      \n      if not required_items:\n          return 0\n      \n      total_distance = 0\n      \n      for i_kind, count in required_items.items():\n          if state.inventory[i_kind] < count:\n              # Find the nearest item on the grid\n              grid = state.grid.argmax(axis=2)\n              goal_indices = np.argwhere(grid == i_kind)\n\n              if goal_indices.size > 0:\n                  agent_pos = np.array(state.pos)\n                  distances = [np.sum(np.abs(agent_pos - idx)) for idx in goal_indices]\n                  total_distance += min(distances) * (count - state.inventory[i_kind])\n              else:\n                  # If no required items are found, return a high heuristic value\n                  return float('inf')\n      \n      return total_distance\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search to find the shortest path to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited_states = set()\n\n    while open_set:\n      f_cost, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n        continue\n\n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_cost = len(actions_taken) + 1\n        h_cost = heuristic(next_state, goal_arg)\n        f_cost = next_cost + h_cost\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          heapq.heappush(open_set, (f_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  # Reset environment to a known starting state\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:17:50.884793", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:17:51.861979", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Validate the item index\n  cookbook = env.world.cookbook\n  if item < 0 or item >= cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = CraftScenario(\n    grid=np.zeros((WIDTH, HEIGHT, env.world.cookbook.n_kinds), dtype=int),\n    init_pos=(WIDTH // 2, HEIGHT // 2),\n    world=env.world\n  )\n  \n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:18:36.333973", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Use a more efficient hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:18:37.395423", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def initialize_scenario(env, item):\n      \"\"\"Initializes a scenario with the given goal item.\"\"\"\n      try:\n          env.scenario = env.world.sample_scenario_with_goal(item)\n          start_state = env.scenario.init()\n          return start_state\n      except ValueError as e:\n          print(e)\n          return None\n\n  # Initialize the environment scenario with the goal item\n  start_state = initialize_scenario(env, item)\n\n  if start_state is None:\n      raise ValueError(f\"No valid scenario found to craft item {item}\")\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:19:22.489486", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    return 0  # For now, we assume a uniform cost for simplicity. Can be improved.\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    visited = set()\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if tuple(state.features()) in visited:\n        continue\n      visited.add(tuple(state.features()))\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        new_features = tuple(new_state.features())\n        if new_features not in visited:\n          heapq.heappush(open_set, (len(actions) + 1 + heuristic(new_state, goal), new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:19:23.440290", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      reward, new_state_use = state.step(USE)\n      if tuple(new_state_use.features()) not in visited:\n          visited.add(tuple(new_state_use.features()))\n          if new_state_use.satisfies(\"\", goal):\n              return actions + [USE]\n          queue.appendleft((new_state_use, actions + [USE]))\n      \n      # Explore other actions\n      for action in range(env.world.n_actions):\n          if action == USE: continue  # Skip USE as it's already prioritized\n          reward, new_state = state.step(action)\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
