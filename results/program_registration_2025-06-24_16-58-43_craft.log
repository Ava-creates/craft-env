{"timestamp": "2025-06-25T07:40:47.959048", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  def optimize_actions(actions):\n    \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n    optimized_actions = []\n    last_action = None\n    for action in actions:\n      if action == USE and optimized_actions and optimized_actions[-1] != USE:\n        optimized_actions.append(USE)\n      elif action != last_action:\n        optimized_actions.append(action)\n      \n      last_action = action\n    \n    return optimized_actions\n\n  def collect_primitives(env, goal):\n    \"\"\"Collect primitives required to craft the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal)\n    \n    actions = []\n    for primitive, count in primitives.items():\n        # Find and pick up the primitive\n        if not env._current_state.next_to(primitive):\n            raise ValueError(\"Primitive not found in vicinity.\")\n        \n        # Simulate picking up the primitive\n        for _ in range(count):\n            _, new_state = env._current_state.step(USE)\n            actions.append(USE)\n    \n    return actions\n\n  start_state = env._current_state\n  primitives_actions = collect_primitives(env, item)\n\n  # After collecting primitives, attempt to craft the item\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  optimized_actions = optimize_actions(primitives_actions + actions)\n  return optimized_actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:40:48.948514", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  def optimize_actions(actions):\n    \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n    optimized_actions = []\n    for action in actions:\n      if optimized_actions and action == USE and optimized_actions[-1] != USE:\n        optimized_actions.append(USE)\n      else:\n        optimized_actions.append(action)\n    \n    return optimized_actions\n\n  def explore_goal_first(start_state, goal):\n    \"\"\"Explore states that are likely to lead to the goal first.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize states where USE is likely to be useful\n        priority = 0 if action == USE and new_state.next_to(goal) else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = explore_goal_first(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  optimized_actions = optimize_actions(actions)\n  return optimized_actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:41:50.036051", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:41:51.047302", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check for immediate availability of the item\n  if start_state.inventory[item] > 0:\n      return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:43:28.997114", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      from itertools import islice\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n          # Limit the size of the queue to prevent excessive memory usage\n          if len(queue) > 10000:\n              queue = deque(islice(queue, 10000))\n\n      return None\n\n  def dfs(start_state, goal_name, goal_arg, max_depth=20):\n      \"\"\"Depth-first search with depth limit for a sequence of actions to achieve the goal.\"\"\"\n      stack = [(start_state, [])]\n      visited_states = set()\n\n      while stack:\n          current_state, actions_taken = stack.pop()\n\n          if len(actions_taken) > max_depth:\n              continue\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  stack.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  # First try BFS, then DFS if necessary\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is None:\n      print(\"BFS failed. Switching to DFS.\")\n      action_sequence = dfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:43:30.046656", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      from itertools import islice\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n          # Limit the size of the queue to prevent excessive memory usage\n          if len(queue) > 10000:\n              queue = deque(islice(queue, 10000))\n\n      return None\n\n  def prune_actions(action_sequence):\n      \"\"\"Prune unnecessary actions from a sequence.\"\"\"\n      pruned_actions = []\n      prev_state = None\n\n      for action in action_sequence:\n          _, current_state = prev_state.step(action) if prev_state else start_state.step(action)\n          state_hash = (\n              tuple(current_state.grid.flatten()),\n              tuple(current_state.inventory),\n              current_state.pos,\n              current_state.dir\n          )\n          \n          # Only add the action if it results in a new state\n          if state_hash not in visited_states:\n              pruned_actions.append(action)\n              prev_state = current_state\n\n      return pruned_actions\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return prune_actions(action_sequence)\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:45:02.898938", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def is_reachable(start_state, goal_arg):\n      \"\"\"Check if the given state can lead to the goal item.\"\"\"\n      from collections import deque\n      \n      queue = deque([start_state])\n      visited_states = set()\n      \n      while queue:\n          current_state = queue.popleft()\n          \n          # Check if the current state satisfies the goal\n          if current_state.satisfies('default', goal_arg):\n              return True\n          \n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append(next_state)\n                  visited_states.add(state_hash)\n      \n      return False\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if is_reachable(start_state, goal_arg):\n      action_sequence = bfs(start_state, goal_name, goal_arg)\n      if action_sequence is not None:\n          return action_sequence\n      else:\n          raise ValueError(f\"No sequence of actions found to craft item {item}\")\n  else:\n      raise ValueError(f\"Goal item {item} is not reachable from the initial state.\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:45:04.051566", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n        continue\n      \n      visited_states.add(state_hash)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n\n    return None\n\n  def is_reachable(state, goal_arg):\n    \"\"\"Check if the state can be reached with the current resources.\"\"\"\n    # Implement a heuristic or constraint check here\n    # For now, assume all states are reachable if inventory and grid constraints are met\n    \n    # Example: Check if the required primitives are available in the initial state's neighborhood\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_arg)\n    \n    for kind, count in primitives_needed.items():\n      if not any(state.next_to(kind) for _ in range(count)):\n        return False\n    \n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if is_reachable(start_state, goal_arg):\n    action_sequence = bfs(start_state, goal_name, goal_arg)\n    if action_sequence is not None:\n      return action_sequence\n    else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")\n  else:\n    raise ValueError(f\"Goal item {item} is not reachable from the initial state.\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:46:07.324154", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(use_actions)\n      queue.extend(other_actions[:5])  # Limit non-USE actions to avoid explosion\n      \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:46:08.337461", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions and moving towards items needed for crafting\n      use_actions = []\n      move_towards_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          elif any(state.next_to(ingredient) for ingredient in env.world.cookbook.primitives_for(goal)):\n            move_towards_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(use_actions)\n      queue.extend(move_towards_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:46:54.392178", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(UP, RIGHT+1)):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and ensure no infinite loops\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:46:55.429414", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(UP, RIGHT+1)):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and ensure it's a valid move\n        if not np.array_equal(state.grid, new_state.grid) or tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:48:14.310879", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the item index is valid\n  if item not in env.world.cookbook.index.contents.values():\n    raise ValueError(f\"Invalid item index {item}\")\n\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:48:15.416713", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the item index is valid\n  if item not in env.world.cookbook.index.contents.values():\n    raise ValueError(f\"Invalid item index {item}\")\n\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:50:26.453336", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def find_shortest_sequence(start_state, goal_name, goal_arg):\n    \"\"\"Finds the shortest sequence of actions to achieve the goal using BFS.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_name, goal_arg):\n      \"\"\"Heuristic function to estimate the distance to the goal.\"\"\"\n      # Simple heuristic: number of items needed - items already in inventory\n      primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = current_state.inventory.copy()\n      \n      for item_idx, count in primitives_needed.items():\n          if current_inventory[item_idx] < count:\n              return count - current_inventory[item_idx]\n      return 0\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search to find the shortest sequence of actions to achieve the goal.\"\"\"\n    open_set = [(start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      # Sort by f-value (cost + heuristic)\n      open_set.sort(key=lambda x: len(x[1]) + heuristic(x[0], goal_name, goal_arg))\n      current_state, actions_taken = open_set.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          open_set.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:50:27.511211", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  \n  raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:51:47.151585", "function_name": "craft", "function_body": "  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  def get_possible_actions(current_state):\n    \"\"\"Generate all possible actions from the current state and their respective next states.\"\"\"\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search to find the sequence of actions.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.pop(0)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, _, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:51:48.230610", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:53:04.941187", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Prune invalid states (e.g., inventory overflow, grid constraints)\n        if is_valid_state(next_state):\n          state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n            visited_states.add(state_hash)\n\n    return None\n\n  def is_valid_state(state):\n    \"\"\"Check if the state is valid based on inventory and grid constraints.\"\"\"\n    # Ensure inventory does not exceed maximum possible values\n    max_inventory = 999  # Set a reasonable limit for item counts in the inventory\n    for i in range(len(state.inventory)):\n      if state.inventory[i] < 0 or state.inventory[i] > max_inventory:\n        return False\n    \n    # Ensure grid occupancy constraints are met (if applicable)\n    # Add more specific checks here if needed\n\n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:53:06.065637", "function_name": "craft", "function_body": "  from collections import deque\n\n  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      \n      queue = deque([(start_state, [])])\n      visited_states = set()\n      state_cache = {}  # Cache to store states based on hash for quick lookup\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n                  state_cache[state_hash] = next_state  # Store the state in cache\n\n      return None\n  \n  def is_valid_state(state):\n      \"\"\"Check if the state is valid based on inventory and grid constraints.\"\"\"\n      # Ensure inventory does not exceed maximum possible values\n      for i in range(len(state.inventory)):\n          if state.inventory[i] < 0:\n              return False\n      \n      # Ensure grid occupancy constraints are met (if applicable)\n      # Add more specific checks here if needed\n\n      return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:54:15.591154", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n    \"\"\"Heuristic function to estimate the distance to the goal.\"\"\"\n    # Count how many items we need in our inventory\n    needed_items = env.world.cookbook.primitives_for(goal_item)\n    current_inventory = state.inventory\n\n    total_distance = 0\n    for item_idx, count_needed in needed_items.items():\n        if item_idx not in current_inventory or current_inventory[item_idx] < count_needed:\n            total_distance += (count_needed - current_inventory.get(item_idx, 0))\n\n    # Penalize states with more steps taken\n    return total_distance\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n      came_from = {}\n      g_score = {start_state: 0}\n      f_score = {start_state: heuristic(start_state, goal_arg)}\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n\n              state_hash = (tuple(next_state.grid.flatten()), \n                            tuple(next_state.inventory), \n                            next_state.pos, \n                            next_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n\n              if next_state not in g_score or tentative_g_score < g_score[next_state]:\n                  came_from[next_state] = (current_state, action)\n                  g_score[next_state] = tentative_g_score\n                  f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:54:16.661519", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:55:09.809029", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the environment and get the start scenario and state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:55:10.886711", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment and get the start scenario and state\n  env.reset()\n  start_scenario = env.scenario\n  \n  try:\n      start_state = start_scenario.init()\n  except ValueError as e:\n      raise ValueError(f\"Error initializing scenario: {e}\")\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:57:00.064763", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n    start_time = time.time()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n      # Optional: Add a timeout to prevent infinite loops\n      if time.time() - start_time > 60:  # Timeout after 60 seconds\n        break\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function for A* search: Distance to nearest required item.\"\"\"\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    if not primitives:\n      return 0\n    \n    min_distance = float('inf')\n    for primitive_idx in primitives:\n      for i in range(env.scenario.init_grid.shape[0]):\n        for j in range(env.scenario.init_grid.shape[1]):\n          if env.scenario.init_grid[i, j, primitive_idx] > 0:\n            distance = abs(current_state.pos[0] - i) + abs(current_state.pos[1] - j)\n            min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def a_star(start_state, goal_name, goal_arg):\n    open_set = [(start_state, [])]\n    visited_states = set()\n    g_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    f_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n    \n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[2])\n      open_set.remove((_, current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          tentative_g_score = g_scores[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n          \n          if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n            g_scores[state_hash] = tentative_g_score\n            f_scores[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n            \n            open_set.append((f_scores[state_hash], next_state, actions_taken + [action]))\n            visited_states.add(state_hash)\n\n      # Optional: Add a timeout to prevent infinite loops\n      if time.time() - start_time > 60:  # Timeout after 60 seconds\n        break\n\n    return None\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:57:01.186706", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n    start_time = time.time()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n      # Optional: Add a timeout to prevent infinite loops\n      if time.time() - start_time > 120:  # Timeout after 120 seconds\n        break\n\n    return None\n  \n  def heuristic(current_state, goal_arg):\n    \"\"\"Simple heuristic based on distance from primitives.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = set(cookbook.primitives)\n    \n    # Count missing primitives in the inventory\n    required_primitives = cookbook.primitives_for(goal_arg)\n    missing_count = sum(required_primitives.get(i, 0) for i in primitives if current_state.inventory[i] < required_primitives.get(i, 0))\n    \n    return missing_count\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:00:20.092791", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize using items nearby\n      for action in [USE]:\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.appendleft((new_state, actions + [action]))  # Use appendleft to prioritize\n      \n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  def is_item_nearby(state, goal):\n    \"\"\"Check if the item is nearby in a 3x3 neighborhood.\"\"\"\n    x, y = state.pos\n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        nx, ny = x + dx, y + dy\n        if (0 <= nx < env.world.grid.shape[0] and\n            0 <= ny < env.world.grid.shape[1] and\n            state.grid[nx, ny].argmax() == goal):\n          return True\n    return False\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:00:21.084477", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize using items nearby\n      for action in [USE]:\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.appendleft((new_state, actions + [action]))  # Use appendleft to prioritize\n      \n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:01:38.372465", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n\n          # Heuristic: prioritize actions that lead to more items in inventory\n          heuristic = new_state.inventory.sum()\n          queue.append((new_state, actions + [action], heuristic))\n          \n          # Sort the queue based on heuristic and priority (higher values first)\n          queue = deque(sorted(queue, key=lambda x: (-x[2] - priority)))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:01:39.346254", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check for immediate availability of the item\n  if start_state.inventory[item] > 0:\n      return []\n\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:02:53.154142", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is known\n  if item not in range(env.world.cookbook.n_kinds):\n    raise ValueError(f\"Unknown item index {item}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:02:54.240960", "function_name": "craft", "function_body": "  class Node:\n    def __init__(self, state, actions_taken):\n      self.state = state\n      self.actions_taken = actions_taken\n\n    def hash(self):\n      return (tuple(self.state.grid.flatten()), tuple(self.state.inventory), self.state.pos, self.state.dir)\n\n  def bfs(start_state, goal_name, goal_arg) -> list[int]:\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([Node(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_node = queue.popleft()\n      current_state = current_node.state\n      actions_taken = current_node.actions_taken\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append(Node(next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:04:17.175195", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      \n      # Priority queue based on estimated cost\n      import heapq\n      \n      # Heuristic function: count of primitives needed for goal\n      cookbook = env.world.cookbook\n      primitive_counts = cookbook.primitives_for(goal_arg)\n      heuristic_cost = sum(primitive_counts.values())\n      \n      priority_queue = [(heuristic_cost, start_state, [])]\n      visited_states = set()\n\n      while priority_queue:\n          _, current_state, actions_taken = heapq.heappop(priority_queue)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  # Calculate heuristic cost for the next state\n                  next_heuristic_cost = sum(primitive_counts.values() - {i: min(count, next_state.inventory[i]) for i, count in primitive_counts.items()})\n                  \n                  heapq.heappush(priority_queue, (next_heuristic_cost + len(actions_taken) + 1, next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
