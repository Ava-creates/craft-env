{"timestamp": "2025-06-25T15:11:24.045840", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a unique hash for the state\n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the starting scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'\n  goal_arg = item\n\n  # Perform BFS to find a sequence of actions\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:11:25.114730", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        grid_hash = tuple(next_state.grid.flatten())\n        inventory_hash = tuple(next_state.inventory)\n        pos_hash = next_state.pos\n        dir_hash = next_state.dir\n        \n        state_hash = (grid_hash, inventory_hash, pos_hash, dir_hash)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T15:12:38.735907", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n    # Heuristic based on distance to nearest required item or workshop\n    inventory = np.array([state.inventory[i] for i in env.world.cookbook.primitives_for(goal_arg).keys()])\n    if np.all(inventory > 0):\n      return 0\n    \n    grid_flat = state.grid.flatten()\n    required_indices = list(env.world.cookbook.primitives_for(goal_arg).keys())\n    \n    min_distance = float('inf')\n    for idx in required_indices:\n      positions = np.argwhere(grid_flat == idx)\n      if len(positions) > 0:\n        agent_pos = np.array(state.pos)\n        distances = np.linalg.norm(agent_pos - positions, axis=1)\n        min_distance = min(min_distance, distances.min())\n    \n    return min_distance\n\n  def a_star(start_state, goal_name, goal_arg):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    came_from = {}\n    g_score = {start_state: 0}\n    \n    while open_set:\n      _, current_state, actions_taken = heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n      \n      state_hash = hash(tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,))\n      \n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        tentative_g_score = g_score[current_state] + 1\n        next_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if next_hash not in g_score or tentative_g_score < g_score[next_hash]:\n          came_from[next_state] = current_state\n          g_score[next_state] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heappush(open_set, (f_score, next_state, actions_taken + [action]))\n    \n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    total_path = []\n    while current_state in came_from:\n      total_path.append(actions_taken[-1])\n      current_state = came_from[current_state]\n      actions_taken.pop()\n    return list(reversed(total_path))\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T15:12:39.813005", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    goal_found = False\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken, True\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n      # Limit the search space to avoid infinite loops\n      if len(queue) > 10000:  # Arbitrary limit\n        return None, False\n\n    return None, goal_found\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence, goal_found = bfs(start_state, goal_name, goal_arg)\n  \n  if goal_found:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 7, "scores": {"3": 1.5}}
