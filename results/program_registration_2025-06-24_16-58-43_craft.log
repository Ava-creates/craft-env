[]\n    heappush(open_set, (0, start_state, []))\n    visited = set()\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Optimize by ignoring USE action if no item is nearby\n        if action == USE and not any(new_state.grid[new_state.pos[0]+dx][new_state.pos[1]+dy].any() \n                                     for dx in [-1, 0, 1] for dy in [-1, 0, 1]):\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          cost = len(actions) + heuristic(new_state, goal)\n          heappush(open_set, (cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:25:36.075481", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Heuristic based on weighted sum of Manhattan distances to the nearest required resources.\"\"\"\n      # Count missing items in inventory\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      \n      grid_size = state.grid.shape[0] * state.grid.shape[1]\n      total_distance = 0\n      \n      # Calculate weighted distance to nearest missing item\n      for idx in missing_items:\n          resource_positions = np.argwhere(state.grid[:, :, idx] == 1)\n          if len(resource_positions) > 0:\n              distances = [abs(rp[0] - state.pos[0]) + abs(rp[1] - state.pos[1]) for rp in resource_positions]\n              total_distance += min(distances)\n          else:\n              # If no resources are found, add a large distance\n              total_distance += grid_size\n      \n      return total_distance\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(0 + heuristic(start_state, goal_arg), start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[0])\n      open_set.remove((_, current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          open_set.append((estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:25:37.152741", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Heuristic based on the number of missing resources.\"\"\"\n      # Count missing items in inventory\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      \n      return len(missing_items)\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(0 + heuristic(start_state, goal_arg), start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[0])\n      open_set.remove((_, current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          open_set.append((estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:26:54.153691", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function using Manhattan distance.\"\"\"\n    goal_pos = np.array(env.scenario.world.index.get(goal))\n    agent_pos = np.array([state.pos[0], state.pos[1]])\n    return np.sum(np.abs(goal_pos - agent_pos))\n\n  def astar(start_state, goal):\n      \"\"\"A* Search to find the shortest path.\"\"\"\n      from heapq import heappush, heappop\n      import sys\n\n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      visited = set()\n      \n      while open_set:\n          _, state, actions = heappop(open_set)\n          \n          if tuple(state.features()) in visited:\n              continue\n          \n          visited.add(tuple(state.features()))\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  heappush(open_set, (len(actions) + heuristic(new_state, goal), new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:26:55.121118", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Simple heuristic: Manhattan distance between the agent's position and the nearest required item.\"\"\"\n    cookbook = env.world.cookbook\n    needed_indices = set(cookbook.primitives_for(goal).keys())\n    \n    if not needed_indices:\n      return 0\n    \n    min_distance = float('inf')\n    pos_x, pos_y = state.pos\n    \n    for x in range(env.scenario.init_grid.shape[0]):\n      for y in range(env.scenario.init_grid.shape[1]):\n        for kind_idx in range(env.world.n_kinds):\n          if state.grid[x, y, kind_idx] > 0 and kind_idx in needed_indices:\n            distance = abs(x - pos_x) + abs(y - pos_y)\n            min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:28:43.083921", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      from heapq import heappop, heappush\n\n      # Priority queue with (estimated_cost, actions_taken, current_state)\n      pq = [(0, [], start_state)]\n      visited_states = set()\n\n      while pq:\n          _, actions_taken, current_state = heappop(pq)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n\n              if state_hash not in visited_states:\n                  # Estimate cost as number of actions taken + heuristic (e.g., Manhattan distance to goal items)\n                  estimated_cost = len(actions_taken) + heuristic(current_state, goal_arg)\n                  heappush(pq, (estimated_cost, actions_taken + [action], next_state))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n      # A simple heuristic: sum of distances to all required ingredients\n      total_distance = 0\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      \n      for i_kind in primitives:\n          if current_state.inventory[i_kind] < primitives[i_kind]:\n              # Find the nearest instance of this ingredient on the grid\n              positions = np.argwhere(current_state.grid[:, :, i_kind])\n              if len(positions) > 0:\n                  nearest_position = min(\n                      positions,\n                      key=lambda pos: manhattan_distance(pos, current_state.pos)\n                  )\n                  total_distance += manhattan_distance(nearest_position, current_state.pos)\n\n      return total_distance\n\n  def manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:28:44.082787", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      from heapq import heappop, heappush\n      import numpy as np\n\n      # Priority queue with (estimated_cost, actions_taken, current_state)\n      pq = [(0, [], start_state)]\n      visited_states = set()\n\n      while pq:\n          _, actions_taken, current_state = heappop(pq)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n\n              if state_hash not in visited_states:\n                  # Estimate cost as number of actions taken + heuristic (e.g., Manhattan distance to goal items)\n                  estimated_cost = len(actions_taken) + heuristic(next_state, goal_arg)\n                  heappush(pq, (estimated_cost, actions_taken + [action], next_state))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n      # A simple heuristic: sum of distances to all required ingredients\n      total_distance = 0\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      \n      for i_kind in primitives:\n          if current_state.inventory[i_kind] < primitives[i_kind]:\n              # Find the nearest instance of this ingredient on the grid\n              positions = np.argwhere(current_state.grid[:, :, i_kind])\n              if len(positions) > 0:\n                  nearest_position = min(\n                      positions,\n                      key=lambda pos: manhattan_distance(pos, current_state.pos)\n                  )\n                  total_distance += manhattan_distance(nearest_position, current_state.pos)\n\n      return total_distance\n\n  def manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:30:01.536466", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on distance to nearest workshop and inventory status\n    dist_to_workshop = min(\n        np.abs(state.pos[0] - x) + np.abs(state.pos[1] - y)\n        for x, y in state.world.workshop_indices\n    )\n    \n    inv_status = sum(1 for idx in range(len(state.inventory)) if state.inventory[idx] > 0)\n    \n    return dist_to_workshop + (inv_status == 0) * 10  # Penalize empty inventory\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path with heuristics.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:30:02.551058", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:31:56.502684", "function_name": "craft", "function_body": "  def state_hash(state):\n    # Use a more efficient hash by converting the grid and inventory to bytes\n    return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  # A* search to find the sequence of actions with minimal cost (number of steps)\n  def a_star(start_state, goal_name, goal_arg):\n    from heapq import heappush, heappop\n    import numpy as np\n\n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    visited_states = set()\n\n    while open_set:\n        current_cost, current_state, actions_taken = heappop(open_set)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        hash_val = state_hash(current_state)\n        \n        if hash_val in visited_states:\n            continue\n        visited_states.add(hash_val)\n\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_next_val = state_hash(next_state)\n            \n            if hash_next_val not in visited_states:\n                # Calculate the cost to move to the next state (we assume a cost of 1 per step)\n                new_cost = current_cost + 1\n                heappush(open_set, (new_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:31:57.468469", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  # A* search to find the sequence of actions with minimum cost (penalty for extra pickups)\n  def a_star(start_state, goal_name, goal_arg):\n    import heapq\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))  # (cost, state, actions_taken)\n    came_from = {}\n    g_score = {state_hash(start_state): 0}\n    f_score = {state_hash(start_state): heuristic(start_state)}\n\n    while open_set:\n        _, current_state, actions_taken = heapq.heappop(open_set)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return reconstruct_path(came_from, current_state)\n\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_val_next = state_hash(next_state)\n            tentative_g_score = g_score[state_hash(current_state)] + 1 - reward\n\n            if hash_val_next not in g_score or tentative_g_score < g_score[hash_val_next]:\n                came_from[hash_val_next] = (current_state, action)\n                g_score[hash_val_next] = tentative_g_score\n                f_score[hash_val_next] = tentative_g_score + heuristic(next_state)\n                heapq.heappush(open_set, (f_score[hash_val_next], next_state, actions_taken + [action]))\n\n    return None\n\n  # Heuristic function to estimate cost from current state to goal\n  def heuristic(current_state):\n      # Simple heuristic: number of items needed minus inventory count for the goal item\n      if item in env.world.cookbook.primitives:\n          return max(1 - current_state.inventory[item], 0)\n      else:\n          primitives = env.world.cookbook.primitives_for(item)\n          total_primitives_needed = sum(primitives.values())\n          total_primitives_in_inventory = sum(current_state.inventory[k] for k in primitives.keys())\n          return max(total_primitives_needed - total_primitives_in_inventory, 0)\n\n  # Reconstruct path from start to goal\n  def reconstruct_path(came_from, current_state):\n      actions_taken = []\n      while state_hash(current_state) in came_from:\n          current_state, action = came_from[state_hash(current_state)]\n          actions_taken.append(action)\n      return actions_taken[::-1]\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:33:32.504029", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n      # Simple heuristic: number of steps needed to collect all primitives required\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      steps_needed = sum(max(primitives.get(p, 0) - current_inventory[p], 0) for p in primitives)\n      return steps_needed\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(start_state, [], heuristic(start_state, goal_arg))]\n    visited_states = set()\n    \n    while open_set:\n      # Sort and pop the state with the lowest cost\n      current_state, actions_taken, _ = min(open_set, key=lambda x: x[2])\n      open_set.remove((current_state, actions_taken, _))\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          new_actions = actions_taken + [action]\n          cost = len(new_actions) + heuristic(next_state, goal_arg)\n          open_set.append((next_state, new_actions, cost))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:33:33.552048", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n      # Simple heuristic: number of steps needed to collect all primitives required\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      steps_needed = sum(max(primitives.get(p, 0) - current_inventory[p], 0) for p in primitives)\n      return steps_needed\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(start_state, [], heuristic(start_state, goal_arg))]\n    visited_states = set()\n\n    while open_set:\n      # Sort and pop the state with the lowest cost\n      current_state, actions_taken, _ = min(open_set, key=lambda x: x[2])\n      open_set.remove((current_state, actions_taken, _))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          new_actions = actions_taken + [action]\n          cost = len(new_actions) + heuristic(next_state, goal_arg)\n          open_set.append((next_state, new_actions, cost))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:35:58.806201", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n          \n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Generate a hashable representation of the state\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def is_reachable(state, goal_arg):\n      \"\"\"Check if the current inventory allows crafting the goal item.\"\"\"\n      # Get the recipe for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_arg, {})\n      \n      # Check if all ingredients are available in the current inventory\n      for ingredient_index, count in recipe.items():\n          if state.inventory[ingredient_index] < count:\n              return False\n      \n      return True\n\n  def collect_ingredients(env, start_state, goal_arg):\n      \"\"\"Collect all necessary ingredients to craft the goal item.\"\"\"\n      required_ingredients = env.world.cookbook.recipes.get(goal_arg, {})\n      collected_ingredients = {ingredient: 0 for ingredient in required_ingredients}\n      \n      actions_sequence = []\n      current_state = start_state\n      \n      while not is_reachable(current_state, goal_arg):\n          # Identify missing ingredients\n          missing_ingredients = {\n              ingredient: required_ingredients[ingredient] - collected_ingredient\n              for ingredient, collected_ingredient in collected_ingredients.items()\n              if collected_ingredient < required_ingredients[ingredient]\n          }\n          \n          # Collect each missing ingredient\n          for ingredient in missing_ingredients:\n              ingredient_actions = collect_ingredient(env, current_state, ingredient)\n              actions_sequence.extend(ingredient_actions)\n              \n              _, current_state = current_state.step(actions_sequence[-1])\n              collected_ingredients[ingredient] += 1\n      \n      return actions_sequence\n\n  def collect_ingredient(env, state, ingredient):\n      \"\"\"Collect a specific ingredient.\"\"\"\n      from collections import deque\n      \n      queue = deque([(state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          # Check if the ingredient is next to the agent\n          if current_state.next_to(ingredient):\n              return actions_taken + [4]  # Action 4 corresponds to USE\n      \n          # Generate all possible next states\n          for action in range(env.world.n_actions - 1):  # Exclude USE action here\n              reward, next_state = current_state.step(action)\n              \n              # Generate a hashable representation of the state\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n      \n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  if not is_reachable(start_state, goal_arg):\n      ingredient_actions = collect_ingredients(env, start_state, goal_arg)\n      return ingredient_actions + craft_v1(env, item)\n  \n  action_sequence = craft_v1(env, item)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:35:59.878347", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n          \n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Generate a hashable representation of the state\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def is_reachable(state, goal_arg):\n      \"\"\"Check if the current inventory allows crafting the goal item.\"\"\"\n      # Get the recipe for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_arg, {})\n      \n      # Check if all ingredients are available in the current inventory\n      for ingredient_index, count in recipe.items():\n          if state.inventory[ingredient_index] < count:\n              return False\n      \n      return True\n\n  def get_primitives_for_goal(env, goal_arg):\n      \"\"\"Get primitives required to craft the goal item.\"\"\"\n      primitives = {}\n      \n      # Get the recipe for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_arg, {})\n      \n      for ingredient_index, count in recipe.items():\n          if ingredient_index in env.world.cookbook.primitives:\n              primitives[ingredient_index] = count\n          else:\n              # Recursively get primitives required for the ingredient\n              sub_primitives = get_primitives_for_goal(env, ingredient_index)\n              for sub_ingredient_index, sub_count in sub_primitives.items():\n                  if sub_ingredient_index in primitives:\n                      primitives[sub_ingredient_index] += sub_count * count\n                  else:\n                      primitives[sub_ingredient_index] = sub_count * count\n      \n      return primitives\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:37:18.779312", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return -state.inventory[goal]\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if action == USE and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n      \n      # Sort the queue based on heuristic\n      queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]))))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:37:19.780408", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n\n        # Check if the new state is already a goal state\n        if new_state.satisfies(\"\", goal):\n          return actions + [action]\n\n        if action == USE and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n      # Sort the queue based on heuristic\n      queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]))))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:40:27.516416", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(pos1, pos2):\n      \"\"\"Manhattan distance heuristic.\"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions within the grid.\"\"\"\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      width, height = env.world.scenario.init_grid.shape[:2]\n      return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state.pos, env.world.scenario.init_pos)}\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in g_score or g_score[tuple(state.features())] + 1 < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (state, actions + [action])\n          g_score[tuple(new_state.features())] = g_score[tuple(state.features())] + 1\n          f_score[tuple(new_state.features())] = g_score[tuple(new_state.features())] + heuristic(new_state.pos, env.world.scenario.init_pos)\n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    \"\"\"Reconstruct the path from start to goal.\"\"\"\n    total_path = []\n    while current in came_from:\n      current, actions = came_from[current]\n      total_path.append(actions[-1])\n    return total_path[::-1]\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:40:28.529607", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  def navigate_to_workshop(state):\n    \"\"\"Navigate to the nearest workshop.\"\"\"\n    from collections import deque\n    \n    start_pos = state.pos\n    queue = deque([start_pos])\n    visited = set([start_pos])\n    parent = {start_pos: None}\n    \n    while queue:\n      pos = queue.popleft()\n      \n      if env.world.index.get(env.world.grid[pos]) in env.world.workshop_indices:\n        path = []\n        while pos is not None:\n          path.append(pos)\n          pos = parent[pos]\n        return path[::-1]  # Reverse the path\n    \n      for neighbor in get_neighbors(pos):\n        if neighbor not in visited and is_walkable(neighbor):\n          queue.append(neighbor)\n          visited.add(neighbor)\n          parent[neighbor] = pos\n    \n    return None  # No workshop found\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions within the grid.\"\"\"\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      width, height = env.world.scenario.init_grid.shape[:2]\n      return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def move_to_pos(state, target_pos):\n    \"\"\"Generate actions to move from current position to target position.\"\"\"\n    start_pos = state.pos\n    path = navigate_to_workshop(state)\n    \n    if not path:\n      return None  # No valid path found\n    \n    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n    actions = []\n    current_pos = start_pos\n    \n    for pos in path[1:]:\n        dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n        \n        if (dx, dy) in directions:\n            action = directions.index((dx, dy))\n            actions.append(action)\n            current_pos = pos\n    \n    return actions\n\n  def gather_primitives(state):\n      \"\"\"Gather primitives required for the item.\"\"\"\n      primitives = env.world.cookbook.primitives_for(item)\n      actions = []\n      \n      for primitive_index, count in primitives.items():\n          while np.sum(state.inventory[primitive_index]) < count:\n              # Find nearest cell with the required primitive\n              pos = find_nearest_primitive(primitive_index, state.pos)\n              if not pos:\n                  return None  # Primitive not found\n      \n              actions.extend(move_to_pos(state, pos))\n              actions.append(USE)\n      \n      return actions\n\n  def find_nearest_primitive(primitive_index, start_pos):\n      \"\"\"Find the nearest cell with the required primitive.\"\"\"\n      from collections import deque\n      \n      queue = deque([start_pos])\n      visited = set([start_pos])\n      \n      while queue:\n          pos = queue.popleft()\n          \n          if env.world.index.get(env.world.grid[pos]) == primitive_index:\n              return pos\n          \n          for neighbor in get_neighbors(pos):\n              if neighbor not in visited and is_walkable(neighbor):\n                  queue.append(neighbor)\n                  visited.add(neighbor)\n      \n      return None  # No primitive found\n\n  start_state = env._current_state\n  actions = []\n\n  # Gather primitives required for the item\n  gather_actions = gather_primitives(start_state)\n  if not gather_actions:\n    raise ValueError(\"Could not gather all required primitives.\")\n  actions.extend(gather_actions)\n\n  # Navigate to workshop and craft the item\n  navigate_actions = move_to_pos(start_state, find_nearest_workshop())\n  if not navigate_actions:\n    raise ValueError(\"No path to workshop found.\")\n  actions.extend(navigate_actions)\n  \n  actions.append(USE)  # Craft the item\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:42:01.472087", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    return -state.inventory[goal]  # More inventory of goal item is better\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:42:02.454881", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of items needed in the inventory\n    return sum(max(0, count - state.inventory[i]) for i, count in env.world.cookbook.primitives_for(goal).items())\n\n  def astar(start_state, goal):\n      \"\"\"A* Search to find the shortest path.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current_state, actions = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (current_state, actions + [action])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:42:53.346887", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize USE action\n          if action == USE and (USE != actions or len(actions) == 0):\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:42:54.363137", "function_name": "craft", "function_body": "  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with improved efficiency.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == 4:  # USE action\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:44:07.271534", "function_name": "craft", "function_body": "  def state_hash(state):\n      \"\"\"Generate a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(map(tuple, state.grid))\n      inventory_tuple = tuple(state.inventory)\n      return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n  def get_possible_actions(current_state):\n      \"\"\"Generate all possible actions from the current state.\"\"\"\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  def bfs_with_heuristic(start_state, goal_arg):\n      \"\"\"Breadth-first search with heuristic.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              state_hash_val = state_hash(next_state)\n              \n              if state_hash_val not in visited_states:\n                  # Heuristic: Prioritize states that have more of the desired item\n                  priority = -next_state.inventory[goal_arg]\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:44:08.240399", "function_name": "craft", "function_body": "  def state_hash(state):\n      # Create a hashable representation of the state\n      grid_tuple = tuple(map(tuple, state.grid))\n      inventory_tuple = tuple(state.inventory)\n      return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        hash_val = state_hash(next_state)\n        \n        if hash_val not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:45:28.945918", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state has been visited or if it's invalid (no change)\n        if tuple(new_state.features()) not in visited and new_state != state:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states with changes in inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:45:29.965668", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state has been visited or if it's invalid (no change)\n        if tuple(new_state.features()) not in visited and new_state != state:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:46:45.050045", "function_name": "craft", "function_body": "  class Node:\n    def __init__(self, state, actions_taken):\n      self.state = state\n      self.actions_taken = actions_taken\n\n    def hash(self):\n      return (tuple(self.state.grid.flatten()), tuple(self.state.inventory), self.state.pos, self.state.dir)\n\n  def bfs(start_state, goal_name, goal_arg) -> list[int]:\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([Node(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_node = queue.popleft()\n      current_state = current_node.state\n      actions_taken = current_node.actions_taken\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Prioritize states where the inventory changes (item picked up or used)\n        state_hash = next_node.hash()\n        \n        if np.any(next_state.inventory != current_state.inventory) and state_hash not in visited_states:\n          queue.appendleft(Node(next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n        elif state_hash not in visited_states:\n          queue.append(Node(next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:46:46.162842", "function_name": "craft", "function_body": "  class Node:\n    def __init__(self, state, actions_taken):\n      self.state = state\n      self.actions_taken = actions_taken\n\n    def hash(self):\n      return (tuple(self.state.grid.flatten()), tuple(self.state.inventory), self.state.pos, self.state.dir)\n\n  def bfs(start_state, goal_name, goal_arg) -> list[int]:\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([Node(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_node = queue.popleft()\n      current_state = current_node.state\n      actions_taken = current_node.actions_taken\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append(Node(next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:47:53.879281", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.scenario = env.world.sample_scenario_with_goal(item)\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:47:54.928857", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Sample a scenario with the specified goal item\n  start_scenario = env.world.sample_scenario_with_goal(item)\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:48:55.549931", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n\n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Sample a scenario that makes the goal achievable\n  try:\n      env.scenario = env.world.sample_scenario_with_goal(item)\n  except ValueError as e:\n      raise ValueError(f\"Error sampling scenario: {e}\")\n\n  start_state = env.scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:48:56.614376", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:49:41.717702", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_state, goal):\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions = queue.popleft()\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action to facilitate crafting\n          for action in [USE] + list(range(4)):\n              reward, new_state = state.step(action)\n              \n              # Skip invalid moves into non-grabbable entities and visited states\n              if any(new_state.grid[new_state.pos] == env.world.non_grabbable_indices):\n                  continue\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.append((new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:49:42.742501", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving into non-grabbable entities)\n        if any(new_state.grid[new_state.pos] == env.world.non_grabbable_indices) and action != USE:\n          continue\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:50:55.344031", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def heuristic(state, goal):\n      # Heuristic based on distance from the nearest workshop if the goal is not in inventory\n      if state.inventory[goal] < 1:\n          min_distance = float('inf')\n          for x in range(env.world.WIDTH):\n              for y in range(env.world.HEIGHT):\n                  if state.grid[x, y, env.world.workshop_indices[0]] > 0:  # Assuming all workshops are of the same kind\n                      distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                      min_distance = min(min_distance, distance)\n          return min_distance\n      return 0\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n      # Sort the queue based on heuristic\n      queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]))))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:50:56.337816", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n      # Simple heuristic based on the count of the goal item in the inventory\n      return state.inventory[goal] < 1\n\n  def bfs(start_state, goal):\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n\n      while queue:\n          state, actions = queue.popleft()\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action\n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n\n              if action == USE and tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.appendleft((new_state, actions + [action]))\n              elif tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.append((new_state, actions + [action]))\n\n          # Sort the queue based on heuristic\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]))))\n\n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:52:32.017954", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n      # Simple heuristic: number of required items not in inventory\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory\n      return sum(max(0, count - current_inventory[idx]) for idx, count in primitives.items())\n\n  def astar(start_state, goal_name, goal_arg):\n      open_set = [(start_state, [], 0)]\n      visited_states = set()\n\n      while open_set:\n          # Pop the state with the lowest f_cost (g_cost + heuristic)\n          current_state, actions_taken, g_cost = min(open_set, key=lambda x: x[2] + heuristic(x[0], goal_arg))\n          open_set.remove((current_state, actions_taken, g_cost))\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (tuple(next_state.grid.flatten()), \n                            tuple(next_state.inventory), \n                            next_state.pos, \n                            next_state.dir)\n              \n              if state_hash not in visited_states:\n                  open_set.append((next_state, actions_taken + [action], g_cost + 1))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:52:33.109329", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n      # Simple heuristic: number of required items not in inventory\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory\n      return sum(max(0, count - current_inventory[idx]) for idx, count in primitives.items())\n\n  def astar(start_state, goal_name, goal_arg):\n      open_set = [(start_state, [], heuristic(start_state, goal_arg))]\n      visited_states = set()\n\n      while open_set:\n          current_state, actions_taken, f_cost = min(open_set, key=lambda x: x[2])\n          open_set.remove((current_state, actions_taken, f_cost))\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              # Hash the state based on grid, inventory, position, and direction\n              state_hash = (tuple(next_state.grid.flatten()), \n                            tuple(next_state.inventory), \n                            next_state.pos, \n                            next_state.dir)\n              \n              if state_hash not in visited_states:\n                  g_cost = len(actions_taken) + 1\n                  h_cost = heuristic(next_state, goal_arg)\n                  open_set.append((next_state, actions_taken + [action], g_cost + h_cost))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:53:44.671747", "function_name": "craft", "function_body": "  def get_available_actions(state):\n      available_actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = state.step(action)\n          if np.any(next_state.inventory != state.inventory):  # Check if any item was picked up or used\n              available_actions.append((action, next_state))\n      return available_actions\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      available_actions = get_available_actions(current_state)\n      for action, next_state in available_actions:\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          if state_hash not in visited_states:\n              queue.append((next_state, actions_taken + [action]))\n              visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:53:45.652390", "function_name": "craft", "function_body": "  def get_available_actions(state):\n      available_actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = state.step(action)\n          if np.any(next_state.inventory != state.inventory):  # Check if any item was picked up or used\n              available_actions.append((action, next_state))\n      return available_actions\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      available_actions = get_available_actions(current_state)\n      \n      for action, next_state in available_actions:\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          if state_hash not in visited_states:\n              queue.append((next_state, actions_taken + [action]))\n              visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:56:15.970793", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n\n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n\n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n\n    return None  # No solution found\n\n  def heuristics(state):\n    \"\"\"Simple heuristic to prioritize states that are closer to the goal.\"\"\"\n    if state.satisfies(\"\", item):\n        return 0\n    else:\n        # Example heuristic: number of steps taken so far (fewer is better)\n        return len(actions)\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:56:16.931887", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to estimate the cost from the current state to the goal.\"\"\"\n    # This is a simple heuristic that counts the number of steps needed to gather all primitives\n    cookbook = env.world.cookbook\n    primitive_counts = cookbook.primitives_for(goal)\n    \n    total_steps = 0\n    \n    for prim, count in primitive_counts.items():\n      if state.inventory[prim] < count:\n        # Assuming each primitive is at least one step away and we need to pick it up\n        total_steps += (count - state.inventory[prim])\n    \n    return total_steps\n\n  def astar(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current, actions = open_set.get()\n      \n      if current.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current.step(action)\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n      total_path = []\n      while current in came_from:\n          (current, action) = came_from[current]\n          total_path.insert(0, action)\n      \n      return total_path + actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:58:01.516072", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:58:02.483944", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      # Check if the goal is satisfied\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n    # Simple heuristic: count of items needed minus count of items in inventory\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    required_items = sum(primitives.values())\n    available_items = sum(current_state.inventory[i] for i in primitives.keys())\n    return required_items - available_items\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      \n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      # Check if the goal is satisfied\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        next_state_hash = (tuple(next_state.grid.flatten()), \n                           tuple(next_state.inventory), \n                           next_state.pos, \n                           next_state.dir)\n\n        tentative_g_score = g_score[state_hash] + 1\n\n        if next_state_hash not in g_score or tentative_g_score < g_score[next_state_hash]:\n          came_from[next_state_hash] = (current_state, actions_taken)\n          g_score[next_state_hash] = tentative_g_score\n          f_score[next_state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[next_state_hash], next_state, actions_taken + [action]))\n    \n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    total_actions = []\n    state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n    while state_hash in came_from:\n      _, previous_actions = came_from[state_hash]\n      total_actions = previous_actions\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n    return total_actions\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:59:20.513142", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n    \"\"\"Heuristic based on the difference in inventory counts.\"\"\"\n    return np.sum(np.abs(goal_item - state.inventory))\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited_states = set()\n    goal_item = np.zeros(env.world.n_kinds)\n    goal_item[goal_arg] = 1  # Desired inventory state with one of the goal item\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          # Calculate cost and heuristic\n          g_cost = len(actions_taken) + 1  # Cost from start to next state\n          h_cost = heuristic(next_state, goal_item)  # Heuristic estimate of cost from next state to goal\n          \n          heapq.heappush(open_set, (g_cost + h_cost, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:59:21.477628", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          # Prioritize actions that lead to a change in the inventory\n          if np.any(next_state.inventory != current_state.inventory):\n            queue.insert(0, (next_state, actions_taken + [action]))\n          else:\n            queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:00:39.049975", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  goal_index = item  # Ensure the item is an index in the cookbook\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = goal_index\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:00:40.160569", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      # Simple heuristic: number of items missing from inventory\n      required_items = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = dict(enumerate(current_state.inventory))\n      \n      missing_count = sum(\n          max(required_count - current_inventory.get(i_kind, 0), 0)\n          for i_kind, required_count in required_items.items()\n      )\n      \n      return missing_count\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:01:36.938882", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        grid_tuple = tuple(next_state.grid.flatten())\n        inventory_tuple = tuple(next_state.inventory)\n        pos_tuple = next_state.pos\n        dir_value = next_state.dir\n        state_hash = (grid_tuple, inventory_tuple, pos_tuple, dir_value)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment to get a fresh start\n  env.reset()\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:01:37.995400", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        grid_tuple = tuple(next_state.grid.flatten())\n        inventory_tuple = tuple(next_state.inventory)\n        pos_tuple = next_state.pos\n        dir_value = next_state.dir\n        state_hash = (grid_tuple, inventory_tuple, pos_tuple, dir_value)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment to get a fresh start\n  env.reset()\n  \n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:03:07.508820", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.pop(0)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:03:08.506711", "function_name": "craft", "function_body": "  # Helper function to create a hashable representation of the current state\n  def state_hash(state):\n    grid_tuple = tuple(map(tuple, state.grid))  # Convert grid to tuple of tuples for hashing\n    return (grid_tuple,) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.pop(0)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:05:30.026074", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with priority on crafting.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (new_state.pos != state.pos or action == USE) and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Simple heuristic based on Manhattan distance to the nearest resource needed.\"\"\"\n    import heapq\n    \n    # Find the positions of all resources in the grid\n    resource_positions = {kind: np.argwhere(state.grid[..., kind]).tolist() for kind in env.world.grabbable_indices}\n    \n    # Calculate the minimum distance to any required resource\n    distances = []\n    for ingredient in env.world.cookbook.primitives_for(goal):\n      if ingredient not in resource_positions or not resource_positions[ingredient]:\n        continue\n      min_distance = min(sum(abs(a - b) for a, b in zip(state.pos, pos)) for pos in resource_positions[ingredient])\n      distances.append(min_distance)\n    \n    return min(distances) if distances else 0\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state)\n      \n      for action in [USE] + list(range(4)):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (new_state.pos != current_state.pos or action == USE):\n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n            came_from[tuple(new_state.features())] = (current_state, actions + [action])\n            g_score[tuple(new_state.features())] = tentative_g_score\n            f_score = tentative_g_score + heuristic(new_state, goal)\n            heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n    \"\"\"Reconstruct the path from start to current.\"\"\"\n    total_path = []\n    while tuple(current.features()) in came_from:\n      _, step = came_from[tuple(current.features())]\n      total_path.append(step[-1])\n      current = came_from[tuple(current.features())][0]\n    \n    return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:05:31.045469", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic function based on the difference in inventory counts for the goal item\n    current_count = state.inventory[goal]\n    return abs(current_count - 1)  # Goal is to have exactly one of the goal item\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))  # (f_score, state, actions)\n      \n      g_scores = {tuple(start_state.features()): 0}\n      f_scores = {tuple(start_state.features()): heuristic(start_state, goal)}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, actions = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in [USE] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              # Check if the new state is a valid move and not already visited\n              if (new_state.pos != current_state.pos or action == USE):\n                  tentative_g_score = g_scores[tuple(current_state.features())] + 1\n                  \n                  if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n                      came_from[tuple(new_state.features())] = (current_state, actions)\n                      g_scores[tuple(new_state.features())] = tentative_g_score\n                      f_scores[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n                      heapq.heappush(open_set, (f_scores[tuple(new_state.features())], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:06:14.021701", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Ensure the agent doesn't get stuck in loops\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:06:15.025850", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:07:15.869839", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance as a heuristic\n    # This is just a placeholder; better heuristics can be designed based on the specific problem.\n    return 0\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = []\n    while current_state in came_from:\n      prev_state, prev_actions = came_from[current_state]\n      total_path = prev_actions + total_path\n      current_state = prev_state\n    return total_path\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
