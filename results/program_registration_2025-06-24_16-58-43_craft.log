{"timestamp": "2025-06-25T07:07:12.022845", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(state, goal_arg):\n      \"\"\"Heuristic to estimate the distance from the current state to the goal.\"\"\"\n      # A simple heuristic could be based on the number of items needed in inventory\n      primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = {env.world.cookbook.index.get(i_kind, -1): count for i_kind, count in enumerate(state.inventory) if count > 0}\n      \n      missing_items_count = sum(primitives_needed.get(kind, 0) - current_inventory.get(kind, 0) for kind in primitives_needed)\n      return missing_items_count\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search for an optimal sequence of actions to achieve the goal.\"\"\"\n      from queue import PriorityQueue\n      import heapq\n\n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(start_state, goal_arg), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n      f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n\n      while not open_set.empty():\n          _, current_state, actions_taken = open_set.get()\n          state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return reconstruct_path(came_from, current_state, actions_taken)\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              tentative_g_score = g_score[state_hash] + 1\n\n              if next_state_hash not in g_score or tentative_g_score < g_score[next_state_hash]:\n                  came_from[next_state_hash] = (state_hash, action)\n                  g_score[next_state_hash] = tentative_g_score\n                  f_score[next_state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n                  open_set.put((f_score[next_state_hash], next_state, actions_taken + [action]))\n\n      return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      \"\"\"Reconstruct the path from the start to the current state.\"\"\"\n      total_path = []\n      total_actions = []\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      while state_hash in came_from:\n          prev_state_hash, action = came_from[state_hash]\n          total_path.append(prev_state_hash)\n          total_actions.append(action)\n          state_hash = prev_state_hash\n\n      return total_actions[::-1]\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:07:13.037241", "function_name": "craft", "function_body": "  def heuristic(current_state, goal_arg):\n    # Simple heuristic: number of items needed minus items in inventory\n    required_items = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = current_state.inventory\n\n    missing_count = sum(required_items.get(kind, 0) - current_inventory[kind] for kind in required_items)\n    return max(missing_count, 0)\n\n  def astar(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      from heapq import heappush, heappop\n\n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  new_cost = len(actions_taken) + heuristic(next_state, goal_arg)\n                  heappush(open_set, (new_cost, next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:08:15.391850", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:08:16.507720", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:09:35.158562", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Priority based on inventory change and number of actions taken\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: (-x[0].inventory.sum() - priority, len(x[1]))))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:09:36.124432", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic based on the difference in inventory counts.\"\"\"\n    return np.sum(np.abs(goal - state.inventory))\n\n  def astar(start_state, goal):\n      \"\"\"A* Search with a heuristic.\"\"\"\n      from heapq import heappush, heappop\n      import sys\n      \n      # Priority queue for A*\n      open_set = []\n      heappush(open_set, (0, start_state, []))\n      \n      # Track costs and visited states\n      g_costs = {tuple(start_state.features()): 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, actions = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, current_state)\n          \n          # Get the current inventory for heuristic\n          current_inventory = np.copy(current_state.inventory)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Calculate tentative g cost\n              tentative_g_cost = g_costs[tuple(current_state.features())] + 1  # Assume each step costs 1\n      \n              if tuple(new_state.features()) not in g_costs or tentative_g_cost < g_costs[tuple(new_state.features())]:\n                  came_from[new_state] = (current_state, actions + [action])\n                  g_costs[tuple(new_state.features())] = tentative_g_cost\n                  f_cost = tentative_g_cost + heuristic(new_state, goal)\n                  heappush(open_set, (f_cost, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      while current_state in came_from:\n          _, action_list = came_from[current_state]\n          total_path = action_list + total_path\n          current_state = came_from[current_state][0]\n      return total_path\n\n  # Initialize goal inventory (assuming we want exactly one of the item)\n  goal_inventory = np.zeros_like(env._current_state.inventory)\n  goal_inventory[item] = 1\n\n  start_state = env._current_state\n  actions = astar(start_state, goal_inventory)\n\n  if actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:11:03.786518", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      # A simple heuristic: distance to the goal based on inventory items\n      return np.sum(np.abs(state.inventory - env.world.cookbook.primitives_for(goal)))\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n      from collections import defaultdict\n      \n      open_set = [(heuristic(start_state, goal), start_state, [])]\n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n      \n      while open_set:\n          _, current_state, actions = open_set.pop(0)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (current_state, actions + [action])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n                  open_set.append((f_score[tuple(new_state.features())], new_state, actions + [action]))\n                  \n          # Sort the open set based on f-score\n          open_set.sort(key=lambda x: x[0])\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  came_from = {}\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:11:04.756803", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Simple heuristic based on number of items needed in inventory\n    primitives = env.world.cookbook.primitives_for(goal)\n    current_inventory = dict(enumerate(state.inventory))\n    \n    total_cost = 0\n    for primitive_index, required_count in primitives.items():\n      if current_inventory.get(primitive_index, 0) < required_count:\n        total_cost += (required_count - current_inventory.get(primitive_index, 0))\n    \n    return total_cost\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    from collections import defaultdict\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.features())] = 0\n    f_score = defaultdict(lambda: float('inf'))\n    f_score[tuple(start_state.features())] = heuristic(start_state, goal)\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          # Avoid revisiting the same state or looping indefinitely\n          if tuple(new_state.features()) not in came_from or tentative_g_score < g_score[tuple(new_state.features())]:\n              came_from[tuple(new_state.features())] = (current_state, actions)\n              g_score[tuple(new_state.features())] = tentative_g_score\n              f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n              heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:12:24.282857", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of steps needed to collect all required items\n    primitives = env.world.cookbook.primitives_for(goal)\n    return sum(primitives.get(i_kind, 0) for i_kind in range(env.world.n_kinds))\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    \n    visited = set()\n    visited.add(tuple(start_state.features()))\n\n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action only if there's a nearby item\n      if any(state.grid[state.pos[0]+dx][state.pos[1]+dy].any() \n             for dx in [-1, 0, 1] for dy in [-1, 0, 1]):\n        reward, new_state = state.step(USE)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          heapq.heappush(open_set, (heuristic(new_state, goal), new_state, actions + [USE]))\n\n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          heapq.heappush(open_set, (heuristic(new_state, goal), new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:12:25.263712", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: prioritize states where inventory progress has been made\n    return -state.inventory[goal]\n\n  def astar(start_state, goal):\n      \"\"\"A* Search to find the shortest path with a priority queue.\"\"\"\n      from collections import deque\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      visited = set([tuple(start_state.features())])\n      \n      while open_set:\n          _, state, actions = heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Explore USE action only if there's a nearby item\n          if any(state.grid[state.pos[0]+dx][state.pos[1]+dy].any() \n                 for dx in [-1, 0, 1] for dy in [-1, 0, 1]):\n              reward, new_state = state.step(USE)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  cost = len(actions) + heuristic(new_state, goal)\n                  heappush(open_set, (cost, new_state, actions + [USE]))\n          \n          # Explore movement actions\n          for action in [UP, DOWN, LEFT, RIGHT]:\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  cost = len(actions) + heuristic(new_state, goal)\n                  heappush(open_set, (cost, new_state, actions + [action]))\n\n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:13:43.941241", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(range(env.world.n_actions)):\n          # Skip moving into non-grabbable entities\n          if action != USE and any(state.grid[state.pos] == env.world.non_grabbable_indices):\n              continue\n          \n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:13:44.931491", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(range(env.world.n_actions)):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to estimate distance to the goal.\"\"\"\n      if state.satisfies(\"\", goal):\n          return 0\n      else:\n          # Use the number of items in inventory as a simple heuristic\n          inventory_count = np.sum(state.inventory)\n          return max(1, goal - inventory_count)\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n          return actions\n      \n      for action in [USE] + list(range(env.world.n_actions)):\n          reward, new_state = current_state.step(action)\n          \n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n              came_from[tuple(new_state.features())] = (current_state, actions + [action])\n              g_score[tuple(new_state.features())] = tentative_g_score\n              f_score = tentative_g_score + heuristic(new_state, goal)\n              heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:16:51.063262", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions within the grid.\"\"\"\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      width, height = env.world.scenario.init_grid.shape[:2]\n      return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  def get_move_actions(start_pos, target_pos):\n      \"\"\"Get a sequence of move actions to reach the target position.\"\"\"\n      path = astar(start_pos, target_pos)\n      actions = []\n      \n      for i in range(len(path) - 1):\n          sx, sy = path[i]\n          tx, ty = path[i + 1]\n          \n          if tx == sx + 1:\n              actions.append(RIGHT)\n          elif tx == sx - 1:\n              actions.append(LEFT)\n          elif ty == sy + 1:\n              actions.append(DOWN)\n          elif ty == sy - 1:\n              actions.append(UP)\n      \n      return actions\n\n  def astar(start, goal):\n      \"\"\"A* Search for finding the shortest path.\"\"\"\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n      \n      while open_set:\n          _, current = heappop(open_set)\n          \n          if current == goal:\n              return reconstruct_path(came_from, current)\n          \n          for neighbor in get_neighbors(current):\n              tentative_g_score = g_score[current] + 1\n              \n              if tentative_g_score < g_score.get(neighbor, float('inf')):\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heappush(open_set, (f_score[neighbor], neighbor))\n      \n      return []  # No path found\n\n  def heuristic(a, b):\n      \"\"\"Manhattan distance heuristic.\"\"\"\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def reconstruct_path(came_from, current):\n      \"\"\"Reconstruct the path from start to goal.\"\"\"\n      total_path = [current]\n      \n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      \n      return total_path[::-1]\n\n  def find_item_positions(grid, item_index):\n      \"\"\"Find all positions of a specific item in the grid.\"\"\"\n      return np.argwhere(grid[:, :, item_index] == 1)\n\n  start_state = env._current_state\n  goal_index = item\n\n  # Find all positions of the goal item in the grid\n  goal_positions = find_item_positions(env.world.scenario.init_grid, goal_index)\n\n  if not len(goal_positions):\n    print(\"Goal item is not present in the initial grid. Attempting to craft it.\")\n    \n    actions = bfs(start_state, goal_index)\n    \n    if actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n    \n    return actions\n\n  # Find the nearest walkable position to the goal items\n  start_pos = start_state.pos\n  nearest_goal = min(goal_positions, key=lambda pos: heuristic(start_pos, tuple(pos)))\n\n  move_actions = get_move_actions(start_pos, tuple(nearest_goal))\n  \n  if not move_actions:\n    raise ValueError(\"No path found to reach the item.\")\n  \n  # Add USE action to pick up the item\n  move_actions.append(USE)\n  \n  return move_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:16:52.027633", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions within the grid.\"\"\"\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      width, height = env.world.scenario.init_grid.shape[:2]\n      return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  def heuristic(pos, goal_pos):\n    \"\"\"Heuristic function for A*.\"\"\"\n    return abs(pos[0] - goal_pos[0]) + abs(pos[1] - goal_pos[1])\n\n  def astar(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n      from heapq import heappush, heappop\n      \n      start_pos = start_state.pos\n      goal_pos = get_goal_position(goal)\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_pos, goal_pos), 0, start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current_g, state, actions = heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, state, actions)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              # Check if the action led to a meaningful state change\n              new_features = tuple(new_state.features())\n              tentative_g_score = current_g + 1\n              \n              if new_features not in g_score or tentative_g_score < g_score[new_features]:\n                  came_from[new_state] = (state, actions[-1])\n                  g_score[new_features] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state.pos, goal_pos)\n                  heappush(open_set, (f_score, tentative_g_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  def get_goal_position(goal):\n      \"\"\"Find the position of the required item in the grid.\"\"\"\n      goal_kind = env.world.cookbook.index.get(goal)\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, goal_kind] > 0)\n      \n      if len(positions) == 0:\n          return None\n      \n      # Choose the closest position to the current agent's position\n      agent_pos = env._current_state.pos\n      distances = [heuristic(agent_pos, pos) for pos in positions]\n      closest_pos = tuple(positions[np.argmin(distances)])\n      \n      return closest_pos\n\n  def reconstruct_path(came_from, current, actions):\n      \"\"\"Reconstruct the path from start to goal.\"\"\"\n      total_path = []\n      while current in came_from:\n          (prev_state, action) = came_from[current]\n          total_path.append(action)\n          current = prev_state\n      return list(reversed(total_path))\n\n  def get_walkable_neighbors(pos):\n      \"\"\"Get walkable neighboring positions within the grid.\"\"\"\n      neighbors = get_neighbors(pos)\n      return [n for n in neighbors if is_walkable(n)]\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:18:16.837208", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Heuristic based on the number of missing resources.\"\"\"\n      # Count missing items in inventory\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      return len(missing_items)\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:18:17.858243", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Heuristic based on the number of missing items in inventory.\"\"\"\n      # Count missing items in inventory\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      \n      return len(missing_items)\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:19:36.280244", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              if action == USE:\n                  use_actions.append((new_state, actions + [action]))\n              else:\n                  # Check if the next state allows a USE action\n                  for next_action in range(env.world.n_actions):\n                      reward_next, _ = new_state.step(next_action)\n                      if reward_next != 0.0:  # Assuming USE yields non-zero reward\n                          priority_actions.append((new_state, actions + [action]))\n                          break\n                  else:\n                      other_actions.append((new_state, actions + [action]))\n\n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:19:37.303884", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:22:37.656890", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(state, goal_arg):\n    \"\"\"Check if the given state can lead to the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n    \n    # Collect all required primitives and their counts\n    missing_primitives = {ingredient: count - state.inventory[ingredient] for ingredient, count in primitives.items() if count > state.inventory[ingredient]}\n    \n    # Check if the grid can provide the missing primitives\n    for ingredient, count in missing_primitives.copy().items():\n      available_on_grid = np.sum(state.grid[:, :, ingredient])\n      if available_on_grid >= count:\n        del missing_primitives[ingredient]\n      else:\n        missing_primitives[ingredient] -= available_on_grid\n    \n    # If there are still missing primitives, check if they can be crafted\n    for ingredient in list(missing_primitives.keys()):\n      sub_primitives = cookbook.primitives_for(ingredient)\n      if not sub_primitives:  # Primitive cannot be crafted\n        return False\n      \n      # Recursively check if the sub-primitives required to craft this ingredient are reachable\n      missing_sub_primitives = {sub_ingredient: count - state.inventory[sub_ingredient] for sub_ingredient, count in sub_primitives.items() if count > state.inventory[sub_ingredient]}\n      \n      # Check grid availability for sub-primitives\n      for sub_ingredient, count in missing_sub_primitives.copy().items():\n        available_on_grid = np.sum(state.grid[:, :, sub_ingredient])\n        if available_on_grid >= count:\n          del missing_sub_primitives[sub_ingredient]\n        else:\n          missing_sub_primitives[sub_ingredient] -= available_on_grid\n      \n      # If there are still missing sub-primitives, recurse\n      for sub_ingredient in list(missing_sub_primitives.keys()):\n        if not is_reachable(state, sub_ingredient):\n          return False\n    \n    return True\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for the shortest sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    from collections import defaultdict\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state)}\n\n    while open_set:\n      current_f, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          g_score[state_hash] = tentative_g_score\n          f_score[state_hash] = tentative_g_score + heuristic(next_state)\n          heapq.heappush(open_set, (f_score[state_hash], next_state, actions_taken + [action]))\n\n    return None\n\n  def heuristic(state):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(item)\n\n    # Collect all required primitives and their counts\n    missing_primitives = {ingredient: count - state.inventory[ingredient] for ingredient, count in primitives.items() if count > state.inventory[ingredient]}\n    \n    # Calculate the heuristic based on the number of missing primitives\n    return sum(missing_primitives.values())\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:22:38.749952", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(state, goal_arg):\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n    \n    # Collect all required primitives and their counts\n    missing_primitives = {ingredient: count - state.inventory[ingredient] for ingredient, count in primitives.items() if count > state.inventory[ingredient]}\n    \n    for ingredient, count in list(missing_primitives.items()):\n      available_on_grid = np.sum(state.grid[:, :, ingredient])\n      \n      # Check if the grid can provide enough of this primitive\n      if available_on_grid >= count:\n        del missing_primitives[ingredient]\n      else:\n          # Determine how many more are needed and check if they can be crafted\n          additional_needed = count - available_on_grid\n          sub_primitives = cookbook.primitives_for(ingredient)\n          \n          if not sub_primitives:  # Primitive cannot be crafted\n              return False\n          \n          # Check if the grid provides enough sub-primitives to craft this ingredient\n          sub_missing = {}\n          for sub_ingredient, sub_count in sub_primitives.items():\n              total_needed_sub = additional_needed * sub_count\n              available_on_grid_sub = np.sum(state.grid[:, :, sub_ingredient])\n              \n              if available_on_grid_sub >= total_needed_sub:\n                  continue  # Enough sub-primitive is available on the grid\n              else:\n                  sub_missing[sub_ingredient] = (total_needed_sub - available_on_grid_sub) // additional_needed\n          \n          for sub_ingredient, count in list(sub_missing.items()):\n              if not is_reachable(state, sub_ingredient):\n                  return False\n\n    return True\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Check if the goal is reachable from the initial state\n  if not is_reachable(start_state, goal_arg):\n      raise ValueError(f\"The goal item {item} cannot be crafted from the given initial state.\")\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
