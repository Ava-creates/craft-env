{"timestamp": "2025-06-25T00:04:29.221753", "function_name": "craft", "function_body": "  def bfs_shortest_path(graph, start, goal):\n    queue = [(start, [])]\n    visited = set()\n    \n    while queue:\n        current, path = queue.pop(0)\n        \n        if current == goal:\n            return path\n        \n        if current not in visited:\n            visited.add(current)\n            \n            for neighbor in graph.get(current, []):\n                if neighbor not in visited:\n                    new_path = path + [neighbor]\n                    queue.append((new_path[-1], new_path))\n                    \n    return None\n\n  def find_recipe(graph, goal_index):\n    paths = []\n    \n    for primitive in env.world.cookbook.primitives:\n        path = bfs_shortest_path(graph, primitive, goal_index)\n        if path:\n            paths.append(path)\n            \n    if not paths:\n        return None\n    \n    # Return the shortest path\n    return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path):\n    actions = []\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(output_index))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n    \"\"\"Collects an item by moving to it and using the action.\"\"\"\n    actions = []\n    \n    # Find positions of the item on the grid\n    item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    if len(item_positions) == 0:\n        raise ValueError(f\"No {item_index} found on the grid.\")\n    \n    for pos in item_positions:\n        x, y = pos\n        \n        # Calculate relative position from agent's current position\n        dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n        \n        # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n        if dx > 0:\n            actions.extend([env.ACTIONS['DOWN']] * abs(dx))\n        elif dx < 0:\n            actions.extend([env.ACTIONS['UP']] * abs(dx))\n        \n        if dy > 0:\n            actions.extend([env.ACTIONS['RIGHT']] * abs(dy))\n        elif dy < 0:\n            actions.extend([env.ACTIONS['LEFT']] * abs(dy))\n        \n        # Use the item\n        actions.append(env.ACTIONS['USE'])\n    \n    return actions\n\n  def craft_item(output_index):\n      \"\"\"Crafts an item at a workshop.\"\"\"\n      # Assuming that crafting is a single action (e.g., USE) when standing next to a workshop.\n      workshops = env.world.workshop_indices\n      \n      for workshop in workshops:\n          x, y = divmod(workshop, env._current_state.grid.shape[1])\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([env.ACTIONS['DOWN']] * abs(dx))\n          elif dx < 0:\n              actions.extend([env.ACTIONS['UP']] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([env.ACTIONS['RIGHT']] * abs(dy))\n          elif dy < 0:\n              actions.extend([env.ACTIONS['LEFT']] * abs(dy))\n          \n          # Use the workshop\n          actions.append(env.ACTIONS['USE'])\n      \n      return actions\n\n  graph = build_graph()\n  inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path)", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:05:19.889426", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  \n  # Ensure we have a valid goal item\n  if item not in env.world.cookbook.index.reverse_contents:\n    raise ValueError(f\"Unknown item index {item}\")\n  \n  start_scenario = CraftScenario(\n      grid=np.copy(env.scenario.init_grid),\n      init_pos=env.scenario.init_pos,\n      world=env.world\n  )\n  \n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:05:20.974421", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:06:45.168037", "function_name": "craft", "function_body": "  def find_closest_item(item_index):\n    min_distance = float('inf')\n    closest_pos = None\n\n    for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n        if env.current_state.grid[x, y, item_index] > 0:\n          distance = abs(x - env.current_state.pos[0]) + abs(y - env.current_state.pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_pos = (x, y)\n\n    return closest_pos\n\n  def move_to_position(target_x, target_y):\n    actions = []\n    current_x, current_y = env.current_state.pos\n\n    while current_x != target_x:\n      actions.append(env.RIGHT if current_x < target_x else env.LEFT)\n      current_x += 1 if current_x < target_x else -1\n\n    while current_y != target_y:\n      actions.append(env.DOWN if current_y < target_y else env.UP)\n      current_y += 1 if current_y < target_y else -1\n\n    return actions\n\n  def gather_item(item_index):\n    actions = []\n    item_pos = find_closest_item(item_index)\n\n    if not item_pos:\n      return actions\n\n    x, y = item_pos\n    actions.extend(move_to_position(x, y))\n    actions.append(env.USE)\n    \n    # Update the current state to reflect the new position and inventory after gathering\n    env.current_state.grid[x, y, item_index] -= 1\n    env.current_state.inventory[item_index] += 1\n\n    return actions\n\n  def craft_item(item_index):\n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    actions = []\n\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue  # Skip the key ingredient\n      \n      while env.current_state.inventory[ingredient] < count:\n        actions.extend(gather_item(ingredient))\n    \n    # Simulate crafting (this is a placeholder)\n    actions.append(env.USE)\n\n    return actions\n\n  actions = []\n\n  # Example logic based on item index\n  if item == 0:  # Assuming 0 is the index for 'stone'\n    actions.extend(gather_item(item))\n  \n  elif item == 1:  # Assuming 1 is the index for 'stick' which requires two stones\n    actions.extend(craft_item(item))\n\n  # Add more items and their crafting logic as needed\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:06:46.130852", "function_name": "craft", "function_body": "  def find_closest_item(item_index):\n    positions = []\n    for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n        if env.current_state.grid[x, y, item_index] > 0:\n          positions.append((x, y))\n    \n    # Find the closest position to the current agent's position\n    min_distance = float('inf')\n    closest_pos = None\n    current_x, current_y = env.current_state.pos\n\n    for x, y in positions:\n      distance = abs(x - current_x) + abs(y - current_y)\n      if distance < min_distance:\n        min_distance = distance\n        closest_pos = (x, y)\n\n    return closest_pos\n\n  def move_to_position(target_x, target_y):\n    actions = []\n    current_x, current_y = env.current_state.pos\n\n    while current_x != target_x:\n      actions.append(env.RIGHT if current_x < target_x else env.LEFT)\n      current_x += 1 if current_x < target_x else -1\n\n    while current_y != target_y:\n      actions.append(env.DOWN if current_y < target_y else env.UP)\n      current_y += 1 if current_y < target_y else -1\n\n    return actions\n\n  def gather_item(item_index):\n    item_pos = find_closest_item(item_index)\n    if not item_pos:\n      return []\n\n    x, y = item_pos\n    actions = move_to_position(x, y)\n    actions.append(env.USE)\n    return actions\n\n  def craft_item(item_index):\n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    actions = []\n\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue  # Skip the key ingredient\n      \n      while env.current_state.inventory[ingredient] < count:\n        actions.extend(gather_item(ingredient))\n    \n    # Simulate crafting (this is a placeholder)\n    actions.append(env.USE)\n\n    return actions\n\n  actions = []\n\n  if item in env.world.cookbook.primitives:\n    actions.extend(gather_item(item))\n  \n  elif item in env.world.cookbook.recipes:\n    actions.extend(craft_item(item))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:07:38.521774", "function_name": "craft", "function_body": "  target_index = item\n  cookbook = env.world.cookbook\n  primitives = cookbook.primitives\n  environment = cookbook.environment\n\n  # Mapping action names to their respective indices (placeholder, adjust as per actual implementation)\n  ACTION_MAP = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4,\n      \"PICKUP_PRIMITIVE\": 5,\n      \"GATHER_ENVIRONMENT\": 6\n      # Add more actions if needed\n  }\n\n  def bfs(start_index):\n    queue = deque([(start_index, [])])\n    visited = set()\n    \n    while queue:\n      current_index, path = queue.popleft()\n      \n      if current_index == target_index:\n        return path\n      \n      if current_index in visited:\n        continue\n      visited.add(current_index)\n      \n      for recipe_output, ingredients in cookbook.recipes.items():\n        if current_index in ingredients.values():\n          # Find the ingredient index and corresponding action to get that item\n          for ingredient_index, count in ingredients.items():\n            if ingredient_index == current_index:\n              actions = []\n              \n              # Check if the ingredient is a primitive or already crafted\n              if ingredient_index in primitives:\n                actions.append(ACTION_MAP[\"PICKUP_PRIMITIVE\"])  # Placeholder for actual pickup action logic\n                \n              elif ingredient_index in environment:\n                actions.append(ACTION_MAP[\"GATHER_ENVIRONMENT\"])  # Placeholder for actual gather action logic\n                \n              else:\n                sub_path = bfs(ingredient_index)\n                if sub_path is not None:\n                  actions.extend(sub_path)\n                \n              actions.append(ACTION_MAP[\"USE\"])  # Assume the last step involves using the crafted items\n              \n              queue.append((recipe_output, path + actions))\n    \n    return None\n  \n  crafting_actions = bfs(target_index)\n  \n  if crafting_actions is None:\n    raise ValueError(f\"Cannot craft item with index {target_index}\")\n  \n  return crafting_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:07:39.510603", "function_name": "craft", "function_body": "  target_index = item\n  cookbook = env.world.cookbook\n  primitives = cookbook.primitives\n  environment = cookbook.environment\n\n  def bfs(start_index):\n    queue = deque([(start_index, [])])\n    visited = set()\n    \n    while queue:\n      current_index, path = queue.popleft()\n      \n      if current_index == target_index:\n        return path\n      \n      if current_index in visited:\n        continue\n      visited.add(current_index)\n      \n      for recipe_output, ingredients in cookbook.recipes.items():\n          if recipe_output not in visited:  # Ensure we are not revisiting outputs\n              actions = []\n              \n              for ingredient_index, count in ingredients.items():\n                  sub_path = None\n                  \n                  if ingredient_index in primitives:\n                      actions.append(\"PICKUP_PRIMITIVE\")\n                      \n                  elif ingredient_index in environment:\n                      actions.append(\"GATHER_ENVIRONMENT\")\n                      \n                  else:\n                      # Only perform BFS if the ingredient is not already crafted or picked up\n                      if ingredient_index not in visited and ingredient_index != recipe_output:\n                          sub_path = bfs(ingredient_index)\n                          \n                  if sub_path is not None:\n                      actions.extend(sub_path)\n                  \n                  actions.append(\"USE\")  # Assume the last step involves using the crafted items\n                \n              queue.append((recipe_output, path + actions))\n    \n    return None\n  \n  crafting_actions = bfs(target_index)\n  \n  if crafting_actions is None:\n      raise ValueError(f\"Cannot craft item with index {target_index}\")\n  \n  return crafting_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:09:32.959679", "function_name": "craft", "function_body": "  # Example implementation\n  # This is just a placeholder and not an actual solution\n\n  def get_primitives_for_goal(goal_index):\n    cookbook = env.world.cookbook\n    primitives = {}\n    queue = [(goal_index, 1)]\n    \n    while queue:\n      current_index, count_needed = queue.pop(0)\n      \n      if current_index in cookbook.primitives:\n        # If the item is a primitive, add it to the primitives dictionary with required count\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count_needed\n      else:\n        # Otherwise, look up the recipe and add its ingredients to the queue\n        recipe = cookbook.recipes.get(current_index)\n        if recipe:\n          for ingredient_index, ingredient_count in recipe.items():\n            if ingredient_index != \"_key\":\n              queue.append((ingredient_index, ingredient_count * count_needed))\n    \n    return primitives\n  \n  def collect_primitives(primitives):\n    actions = []\n    for primitive_index, required_count in primitives.items():\n      while env._current_state.inventory[primitive_index] < required_count:\n        # This is a simplified action to \"collect\" a primitive\n        # In reality, you would need to move the agent to the location of the primitive and pick it up\n        actions.append(4)  # Assuming USE is represented by 4 for picking up items\n    return actions\n\n  def craft_from_primitives(goal_index):\n    cookbook = env.world.cookbook\n    \n    # Simple greedy approach: try to craft recipes with available ingredients\n    queue = [(goal_index, 1)]\n    crafted = set()\n    \n    while queue:\n      current_index, count_needed = queue.pop(0)\n      \n      if current_index in crafted or current_index in cookbook.primitives:\n        continue\n      \n      recipe = cookbook.recipes.get(current_index)\n      if recipe and all(env._current_state.inventory[ingredient] >= ingredient_count * count_needed for ingredient, ingredient_count in recipe.items() if ingredient != \"_key\"):\n        # Craft the item\n        actions.append(4)  # Assuming USE is represented by 4 for crafting items\n        \n        # Decrease inventory based on recipe requirements\n        for ingredient_index, ingredient_count in recipe.items():\n          if ingredient_index != \"_key\":\n            env._current_state.inventory[ingredient_index] -= ingredient_count * count_needed\n        \n        crafted.add(current_index)\n      else:\n        queue.append((current_index, count_needed))\n    \n    return actions\n  \n  # Main function logic\n  primitives = get_primitives_for_goal(item)\n  actions_to_collect = collect_primitives(primitives)\n  \n  # Simulate collecting primitives (this should be replaced with actual movement and pickup actions)\n  env._current_state.inventory.update(primitives)\n  \n  actions_to_craft = craft_from_primitives(item)\n  \n  return actions_to_collect + actions_to_craft", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:09:33.921594", "function_name": "craft", "function_body": "  # Define constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def move_to(x, y):\n    \"\"\"Generates a sequence of moves to get from the current position to (x, y).\"\"\"\n    path = []\n    dx = x - env._current_state.pos[0]\n    dy = y - env._current_state.pos[1]\n\n    # Move horizontally\n    if dx > 0:\n      path.extend([RIGHT] * dx)\n    elif dx < 0:\n      path.extend([LEFT] * abs(dx))\n\n    # Move vertically\n    if dy > 0:\n      path.extend([DOWN] * dy)\n    elif dy < 0:\n      path.extend([UP] * abs(dy))\n    \n    return path\n\n  def find_item(item_index):\n    \"\"\"Finds the nearest position of the item with index `item_index`.\"\"\"\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    if len(positions) == 0:\n      return None, None\n    distances = [abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]) for pos in positions]\n    nearest_pos = positions[np.argmin(distances)]\n    return nearest_pos[0], nearest_pos[1]\n\n  def pick_item(item_index):\n    \"\"\"Generates actions to pick up an item at the current position.\"\"\"\n    path = []\n    if env._current_state.grid[env._current_state.pos] == item_index:\n      path.append(USE)\n    return path\n\n  # Main logic to craft the item\n  action_sequence = []\n\n  # Get the recipe for the desired item\n  cookbook = env.world.cookbook.recipes\n  goal_index = item\n  if goal_index not in cookbook:\n    raise ValueError(f\"No recipe found for item index {goal_index}\")\n\n  # Check primitives needed for the goal\n  primitives_needed = cookbook[goal_index]\n\n  for ingredient, count in primitives_needed.items():\n    if ingredient == \"_key\":\n      continue  # Skip key ingredients for now\n\n    for _ in range(count):\n      # Find the nearest position of the ingredient\n      x, y = find_item(ingredient)\n      if x is None or y is None:\n        raise ValueError(f\"Ingredient index {ingredient} not found on the grid\")\n\n      # Move to the ingredient and pick it up\n      action_sequence.extend(move_to(x, y))\n      action_sequence.extend(pick_item(ingredient))\n\n  # Use the recipe to craft the item (assuming USE action at workshop)\n  if goal_index in env.world.workshop_indices:\n    action_sequence.extend(move_to(goal_index // env.world.WIDTH, goal_index % env.world.HEIGHT))  # Simplified movement\n    action_sequence.append(USE)\n\n  return action_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:11:20.290972", "function_name": "craft", "function_body": "  def get_primitives_for_goal(cookbook, goal):\n    primitives = {}\n    \n    # Recursively find primitives needed for the goal\n    def find_primitives(goal_index):\n      if goal_index in cookbook.primitives:\n        primitives[goal_index] = primitives.get(goal_index, 0) + 1\n        return\n      \n      if goal_index not in cookbook.recipes:\n        return  # No recipe for this item\n\n      for ingredient_index, count in cookbook.recipes[goal_index].items():\n        if ingredient_index == \"_key\":\n          continue\n        \n        if ingredient_index in cookbook.primitives:\n          primitives[ingredient_index] = primitives.get(ingredient_index, 0) + count\n        else:\n          find_primitives(ingredient_index)\n    \n    find_primitives(goal)\n    return primitives\n\n  def calculate_costs(primitives, inventory):\n    # Calculate the cost to gather all required primitives from the current inventory\n    total_cost = 0\n    for primitive_index, required_count in primitives.items():\n      if inventory[primitive_index] < required_count:\n        total_cost += (required_count - inventory[primitive_index])\n    return total_cost\n\n  def heuristic(item):\n    # Heuristic function: number of primitives needed minus available primitives\n    primitives = get_primitives_for_goal(cookbook, item)\n    current_primitives = {i: inventory[i] for i in primitives}\n    required_primitives = sum(count - current_primitives.get(i, 0) for i, count in primitives.items())\n    return required_primitives\n\n  cookbook = env.world.cookbook\n  inventory = env._current_state.inventory\n  \n  # Get the primitives needed to craft the goal item\n  primitives_needed = get_primitives_for_goal(cookbook, item)\n\n  # Initialize a priority queue for A* search and a dictionary to keep track of paths and costs\n  from heapq import heappush, heappop\n  pq = [(0 + heuristic(item), 0, item, [])]  # (total cost + heuristic, actual cost, target item index, path)\n  visited = set()\n  cost_so_far = {item: 0}\n\n  while pq:\n    _, current_cost, current_item, path = heappop(pq)\n\n    if current_item in inventory and inventory[current_item] > 0:\n      return path\n\n    if current_item in visited:\n      continue\n    visited.add(current_item)\n\n    # Find recipes that produce the current item\n    for ingredient_index, count in cookbook.recipes.get(current_item, {}).items():\n      if ingredient_index == \"_key\":\n        continue\n      \n      new_cost = current_cost + count  # Cost to produce this item\n      total_new_cost = new_cost + heuristic(ingredient_index)\n      \n      if ingredient_index not in cost_so_far or total_new_cost < cost_so_far[ingredient_index]:\n        cost_so_far[ingredient_index] = total_new_cost\n        new_path = path + [ingredient_index for _ in range(count)]\n        heappush(pq, (total_new_cost + heuristic(ingredient_index), new_cost, ingredient_index, new_path))\n\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:11:21.275053", "function_name": "craft", "function_body": "  def get_primitives_for_goal(cookbook, goal):\n    primitives = {}\n\n    # Recursively find primitives needed for the goal\n    def find_primitives(goal_index):\n      if goal_index in cookbook.primitives:\n        primitives[goal_index] = primitives.get(goal_index, 0) + 1\n        return\n\n      for output_index, recipe in cookbook.recipes.items():\n        if \"_key\" not in recipe or recipe[\"_key\"] != goal_index:\n          continue\n\n        ingredients = [(ingredient_index, count) for ingredient_index, count in recipe.items() if ingredient_index != \"_key\"]\n\n        for ingredient_index, count in ingredients:\n          if ingredient_index in cookbook.primitives:\n            primitives[ingredient_index] = primitives.get(ingredient_index, 0) + count\n          else:\n            find_primitives(ingredient_index)\n\n    find_primitives(goal)\n    return primitives\n\n  def calculate_costs(primitives, inventory):\n    # Calculate the cost to gather all required primitives from the current inventory\n    total_cost = 0\n    for primitive_index, required_count in primitives.items():\n      if inventory[primitive_index] < required_count:\n        total_cost += (required_count - inventory[primitive_index])\n    return total_cost\n\n  def get_neighbors(item, cookbook):\n    # Find all items that can be crafted using the current item as an ingredient\n    neighbors = []\n    for output_index, recipe in cookbook.recipes.items():\n      if \"_key\" not in recipe:\n        continue\n      if item in recipe and recipe[item] > 0:\n        neighbors.append(output_index)\n    return neighbors\n\n  def heuristic(current_item, goal, inventory, primitives_needed):\n    # Calculate a heuristic estimate for the cost to reach the goal from the current item\n    primitives = get_primitives_for_goal(cookbook, current_item)\n    total_cost = calculate_costs(primitives, inventory)\n\n    # If the current item is a primitive needed for the goal, prioritize it\n    if current_item in primitives_needed:\n      return 0\n    else:\n      return total_cost\n\n  cookbook = env.world.cookbook\n  inventory = env._current_state.inventory\n\n  # Get the primitives needed to craft the goal item\n  primitives_needed = get_primitives_for_goal(cookbook, item)\n\n  # Initialize a priority queue for A* search and a dictionary to keep track of paths and costs\n  from heapq import heappush, heappop\n  pq = [(0, item, [])]  # (f_score, target item index, path)\n  visited = set()\n  g_score = {item: 0}\n  f_score = {item: heuristic(item, item, inventory, primitives_needed)}\n\n  while pq:\n    _, current_item, path = heappop(pq)\n\n    if current_item in inventory and inventory[current_item] > 0:\n      return path\n\n    if current_item in visited:\n      continue\n    visited.add(current_item)\n\n    # Find recipes that produce the current item\n    for output_index, recipe in cookbook.recipes.items():\n      if \"_key\" not in recipe or recipe[\"_key\"] != current_item:\n        continue\n\n      ingredients = [(ingredient_index, count) for ingredient_index, count in recipe.items() if ingredient_index != \"_key\"]\n\n      # Calculate the cost to produce this item\n      production_cost = sum(count for _, count in ingredients)\n      tentative_g_score = g_score[current_item] + production_cost\n\n      if output_index not in g_score or tentative_g_score < g_score[output_index]:\n        came_from[output_index] = (current_item, path)\n        g_score[output_index] = tentative_g_score\n        f_score[output_index] = tentative_g_score + heuristic(output_index, item, inventory, primitives_needed)\n        heappush(pq, (f_score[output_index], output_index, path + [ingredient_index for ingredient_index, count in ingredients for _ in range(count)]))\n\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:12:23.996045", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on inventory count for the goal item\n    return state.inventory[goal]\n\n  def get_primitives(env, goal):\n    cookbook = env.world.cookbook\n    primitives = {}\n    \n    def dfs(current_goal):\n        if current_goal in primitives:\n            return primitives[current_goal]\n        \n        recipe = cookbook.recipes.get(current_goal)\n        if not recipe:\n            return {current_goal: 1}  # Primitive item\n        \n        current_primitives = {}\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            ingredient_primitives = dfs(ingredient)\n            for p, c in ingredient_primitives.items():\n                current_primitives[p] = current_primitives.get(p, 0) + c * count\n        \n        primitives[current_goal] = current_primitives\n        return current_primitives\n    \n    return dfs(goal)\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Sort possible actions based on heuristic\n      actions_sorted = sorted(range(env.world.n_actions), key=lambda a: heuristic(state.step(a)[1], goal))\n      \n      for action in actions_sorted:\n        reward, new_state = state.step(action)\n        \n        # Check if the USE action is likely to be productive\n        if action == USE and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  goal_primitives = get_primitives(env, item)\n  \n  for primitive, count in goal_primitives.items():\n      if primitive not in start_state.world.grabbable_indices:\n          raise ValueError(f\"Primitive {primitive} required to craft the item is not grabbable.\")\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:12:24.984384", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on inventory count for the goal item\n    return state.inventory[goal]\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Sort possible actions based on heuristic\n      actions_sorted = sorted(range(env.world.n_actions), key=lambda a: heuristic(state.step(a)[1], goal))\n      \n      for action in actions_sorted:\n        reward, new_state = state.step(action)\n        \n        # Check if the USE action is likely to be productive and prioritize it\n        if action == USE and new_state.inventory[goal] > state.inventory[goal]:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:13:57.080002", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of items needed to craft the goal\n    goal_name = env.world.cookbook.index.get(goal)\n    primitives = env.world.cookbook.primitives_for(goal)\n    \n    if not primitives:\n      return float('inf')  # No recipe for this item\n    \n    current_inventory = state.inventory.copy()\n    steps_needed = 0\n    \n    while any(current_inventory[primitive] < count for primitive, count in primitives.items()):\n      min_steps_to_goal = float('inf')\n      \n      for candidate_item, candidate_recipe in env.world.cookbook.recipes.items():\n        if candidate_item == goal:\n          continue\n        \n        candidate_primitives = {key: val for key, val in candidate_recipe.items() if key != \"_key\"}\n        \n        # Check if we can craft this candidate item\n        if all(current_inventory[primitive] >= count for primitive, count in candidate_primitives.items()):\n          steps_to_goal = sum(candidate_recipe[primitive] - current_inventory[primitive] for primitive, count in candidate_primitives.items())\n          \n          if steps_to_goal < min_steps_to_goal:\n            min_steps_to_goal = steps_to_goal\n            \n            # Craft the candidate item\n            craft_actions = bfs(state, candidate_item)\n            \n            if craft_actions is not None:\n              for action in craft_actions:\n                reward, state = state.step(action)\n                steps_needed += 1 + len(craft_actions)  # Add one for USE action\n                \n              current_inventory[candidate_item] += 1\n              \n    return steps_needed\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:14:27.099445", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the number of primitive items needed.\n    primitives = env.world.cookbook.primitives_for(goal)\n    \n    if not primitives:\n      return float('inf')  # No recipe for this item\n    \n    current_inventory = state.inventory.copy()\n    steps_needed = 0\n    \n    while any(current_inventory[primitive] < count for primitive, count in primitives.items()):\n      min_steps_to_goal = float('inf')\n      \n      for candidate_item, candidate_recipe in env.world.cookbook.recipes.items():\n        if candidate_item == goal:\n          continue\n        \n        candidate_primitives = {key: val for key, val in candidate_recipe.items() if key != \"_key\"}\n        \n        # Check if we can craft this candidate item\n        if all(current_inventory[primitive] >= count for primitive, count in candidate_primitives.items()):\n          steps_to_goal = sum(candidate_recipe[primitive] - current_inventory[primitive] for primitive, count in candidate_primitives.items())\n          \n          if steps_to_goal < min_steps_to_goal:\n            min_steps_to_goal = steps_to_goal\n            \n            # Craft the candidate item\n            craft_actions = bfs(state, candidate_item)\n            \n            if craft_actions is not None:\n              for action in craft_actions:\n                reward, state = state.step(action)\n                steps_needed += 1 + len(craft_actions)  # Add one for USE action\n                \n              current_inventory[candidate_item] += 1\n              \n    return steps_needed\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      current_cost, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          cost = current_cost + 1\n          heappush(open_set, (cost + heuristic(new_state, goal), new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  if not env.world.cookbook.primitives_for(item):\n    raise ValueError(f\"No recipe for item {item} found.\")\n  \n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:16:38.091651", "function_name": "craft", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n  \n  def bfs_shortest_path(graph, start, goal):\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          current, path = queue.pop(0)\n          \n          if current == goal:\n              return path\n          \n          if current not in visited:\n              visited.add(current)\n              \n              for neighbor in graph.get(current, []):\n                  if neighbor not in visited:\n                      new_path = path + [neighbor]\n                      queue.append((neighbor, new_path))\n                      \n      return None\n\n  def find_recipe(graph, goal_index):\n      paths = []\n      \n      for primitive in env.world.cookbook.primitives:\n          path = bfs_shortest_path(graph, primitive, goal_index)\n          if path:\n              paths.append(path)\n              \n      if not paths:\n          return None\n      \n      # Return the shortest path\n      return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path, item):\n    actions = []\n    \n    # Initialize inventory\n    inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(item))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n      \"\"\"Collects an item by moving to it and using the action.\"\"\"\n      actions = []\n      \n      # Find positions of the item on the grid\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      for pos in item_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n          \n          # Use the item\n          actions.append(USE)\n      \n      return actions\n\n  def craft_item(item_index):\n      \"\"\"Simulate crafting an item.\"\"\"\n      # Assuming that crafting is a single action (e.g., USE) when standing next to the appropriate ingredients.\n      return USE\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path, item)", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:16:39.040165", "function_name": "craft", "function_body": "    # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def bfs_shortest_path(graph, start, goal):\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          current, path = queue.pop(0)\n          \n          if current == goal:\n              return path\n          \n          if current not in visited:\n              visited.add(current)\n              \n              for neighbor in graph.get(current, []):\n                  if neighbor not in visited:\n                      new_path = path + [neighbor]\n                      queue.append((neighbor, new_path))\n                      \n      return None\n\n  def find_recipe(graph, goal_index):\n      paths = []\n      \n      for primitive in env.world.cookbook.primitives:\n          path = bfs_shortest_path(graph, primitive, goal_index)\n          if path:\n              paths.append(path)\n              \n      if not paths:\n          return None\n      \n      # Return the shortest path\n      return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path, goal):\n    actions = []\n    \n    # Initialize inventory\n    inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n    \n    for step in range(len(path) - 1):\n        current_item = path[step]\n        next_item = path[step + 1]\n        \n        recipe = env.world.cookbook.recipes[next_item]\n        required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n        \n        # Collect all required ingredients\n        for ingredient_index, count in required_ingredients.items():\n            while inventory[ingredient_index] < count:\n                actions.extend(collect_item(env, ingredient_index))\n            \n            # Update inventory after collecting\n            inventory[ingredient_index] += 1\n        \n        # Craft the next item by moving to a workshop and using the action\n        if env.world.cookbook.index.get(next_item) in env.world.workshop_indices:\n            actions.extend(move_to_workshop(env, current_item))\n        \n        # Simulate crafting (USE)\n        actions.append(USE)\n        \n        # Update inventory after crafting\n        inventory[next_item] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n      \"\"\"Collects an item by moving to it and using the action.\"\"\"\n      actions = []\n      \n      # Find positions of the item on the grid\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      if len(item_positions) == 0:\n          raise ValueError(f\"Item {item_index} not found on the grid.\")\n      \n      for pos in item_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n          \n          # Use the item\n          actions.append(USE)\n      \n      return actions\n\n  def move_to_workshop(env, current_item):\n      \"\"\"Moves to a workshop and returns the sequence of actions.\"\"\"\n      actions = []\n      \n      # Find positions of workshops on the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices] > 0)\n      \n      if len(workshop_positions) == 0:\n          raise ValueError(\"No workshop found on the grid.\")\n      \n      for pos in workshop_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n      \n      return actions\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path, item)", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:17:34.162190", "function_name": "craft", "function_body": "  target_index = item\n  cookbook = env.world.cookbook\n  primitives = cookbook.primitives\n  environment = cookbook.environment\n\n  # Maps an index to the actions needed to get that index\n  action_map = {}\n\n  def bfs(start_index):\n    queue = deque([(start_index, [])])\n    visited = set()\n    \n    while queue:\n      current_index, path = queue.popleft()\n      \n      if current_index == target_index:\n        return path\n      \n      if current_index in visited:\n        continue\n      visited.add(current_index)\n      \n      for recipe_output, ingredients in cookbook.recipes.items():\n        if current_index in ingredients.values():\n          # Find the ingredient index and corresponding action to get that item\n          for ingredient_index, count in ingredients.items():\n            if ingredient_index == current_index:\n              actions = []\n              \n              # Check if the ingredient is a primitive or already crafted\n              if ingredient_index in primitives:\n                actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action index\n                \n              elif ingredient_index in environment:\n                actions.append(env.world.N_ACTIONS - 2)  # Placeholder for GATHER_ENVIRONMENT, assuming it's second to last\n                \n              else:\n                sub_path = bfs(ingredient_index)\n                if sub_path is not None:\n                  actions.extend(sub_path)\n                \n              actions.append(env.world.N_ACTIONS - 1)  # Assume the last step involves using the crafted items\n              \n              queue.append((recipe_output, path + actions))\n    \n    return None\n  \n  crafting_actions = bfs(target_index)\n  \n  if crafting_actions is None:\n    raise ValueError(f\"Cannot craft item with index {target_index}\")\n  \n  return crafting_actions", "islan