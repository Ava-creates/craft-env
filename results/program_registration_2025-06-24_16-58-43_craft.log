{"timestamp": "2025-06-25T09:20:24.172758", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            \n            # Avoid unnecessary movements by checking the direction\n            if (action == UP and state.dir == DOWN) or \\\n               (action == DOWN and state.dir == UP) or \\\n               (action == LEFT and state.dir == RIGHT) or \\\n               (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n            \n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:20:25.182486", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:21:25.565177", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(new_state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or \\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:21:26.575640", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:22:56.457340", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extendleft(use_actions)  # Prioritize USE actions by adding them first\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:22:57.414655", "function_name": "craft", "function_body": "  # Constants for actions\n  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    inventory = state.inventory\n    if inventory[goal] > 0:\n        return -1  # Prioritize states where the goal item is already in the inventory\n    \n    return 0  # Default priority for other states\n\n  def a_star(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = []\n      while current_state in came_from:\n          current_state, actions = came_from[current_state]\n          total_path.extend(actions)\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:23:54.318219", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n          _, next_state = current_state.step(action)\n          state_hash = hash_state(next_state)\n\n          if state_hash not in visited_states:\n              queue.append((next_state, actions_taken + [action]))\n              visited_states.add(state_hash)\n\n    return None\n\n  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(map(tuple, map(tuple, state.grid)))\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_tuple, inventory_tuple, pos_tuple, dir_value)\n\n  # Initialize the scenario and start state\n  goal_arg = item\n  \n  action_sequence = bfs(env.scenario.init(), goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:23:55.295176", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      # Check if the goal is satisfied\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n      \n      for action in range(env.world.n_actions):\n          _, next_state = current_state.step(action)\n          state_hash = hash_state(next_state)\n\n          if state_hash not in visited_states:\n              queue.append((next_state, actions_taken + [action]))\n              visited_states.add(state_hash)\n              \n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  goal_arg = item\n  action_sequence = bfs(env.scenario.init(), goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:25:07.283414", "function_name": "craft", "function_body": "  def get_neighbors(pos):\n      x, y = pos\n      return [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with neighbor checks.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Check neighbors for more efficient pathing\n          if action != 4:  # Skip USE action for neighbor checks\n            new_pos = (state.pos[0] + (action == RIGHT) - (action == LEFT),\n                       state.pos[1] + (action == DOWN) - (action == UP))\n            if any(env.world.cookbook.index.get(i_kind, None) == goal for i_kind in env._current_state.grid[new_pos]):\n              queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:25:08.323944", "function_name": "craft", "function_body": "  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with additional optimizations.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the action led to a meaningful state change\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == 4:  # USE action\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:26:18.189902", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:26:19.189595", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Simple heuristic based on inventory count.\"\"\"\n      # Check if the goal is in the inventory\n      return 0 if state.inventory[goal_index] > 0 else 1\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    \n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n\n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = (actions_taken + [action], current_state)\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:27:37.326245", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:27:38.354208", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    from heapq import heappush, heappop\n    \n    # Priority queue of (f_score, g_score, actions, state)\n    open_set = []\n    heappush(open_set, (0, 0, [], start_state))\n    \n    # Set for visited states\n    visited = set()\n    \n    while open_set:\n      _, g_score, actions, current_state = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          \n          g_score_next = g_score + 1  # Each action costs 1\n          h_score_next = heuristic(new_state, goal)  # Estimate remaining cost\n          f_score_next = g_score_next + h_score_next\n          \n          heappush(open_set, (f_score_next, g_score_next, actions + [action], new_state))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    return -state.inventory[goal]  # More inventory of goal item is better\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:28:27.511804", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:28:28.516702", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:29:34.834214", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item not in env.world.cookbook.kinds:\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  # Initialize the scenario and start state\n  goal_arg = item\n  \n  action_sequence = bfs(env.scenario.init(), goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:29:35.966500", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Use a more efficient hash by combining key state elements\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item not in env.world.cookbook.kinds:\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  action_sequence = bfs(env.scenario.init(), item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:30:40.928388", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Check if the state is a valid (non-terminal) state\n              if not env._is_done():\n                  state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n                  \n                  if state_hash not in visited_states:\n                      queue.append((next_state, actions_taken + [action]))\n                      visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:30:41.970775", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:31:53.508484", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:31:54.519232", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: Manhattan distance to the nearest required item\n    pos_x, pos_y = state.pos\n    min_distance = float('inf')\n    \n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        x, y = pos_x + dx, pos_y + dy\n        if 0 <= x < env.world.scenario.init_grid.shape[0] and 0 <= y < env.world.scenario.init_grid.shape[1]:\n          if state.grid[x, y, goal] > 0:\n            min_distance = min(min_distance, abs(dx) + abs(dy))\n    \n    return min_distance\n\n  def a_star(start_state, goal):\n    from collections import deque\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))  # (f_score, state, actions)\n    g_scores = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_scores[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:33:08.845927", "function_name": "craft", "function_body": "  def bfs_with_heuristic(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritizing USE action.\"\"\"\n    from collections import deque\n    import heapq\n    \n    # Priority queue using a heap\n    priority_queue = []\n    heapq.heappush(priority_queue, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while priority_queue:\n      _, state, actions = heapq.heappop(priority_queue)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          heuristic_cost = 0 if action == USE else 1\n          heapq.heappush(priority_queue, (len(actions) + heuristic_cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  \n  start_state = env._current_state\n  actions = bfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:33:09.884523", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:34:39.528856", "function_name": "craft", "function_body": "  def state_hash(state):\n      return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  # Heuristic function: Prioritize states that have more of the desired item\n  def heuristic(state, goal_arg):\n      return -state.inventory[goal_arg]\n\n  # A* search with early termination and heuristic\n  def a_star(start_state, goal_name, goal_arg):\n      from heapq import heappop, heappush\n\n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal_arg), 0, start_state, []))\n      visited_states = set()\n\n      while open_set:\n          _, cost_so_far, current_state, actions_taken = heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  new_cost = cost_so_far + 1\n                  heappush(open_set, (new_cost + heuristic(next_state, goal_arg), new_cost, next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:34:40.567465", "function_name": "craft", "function_body": "  def state_hash(state):\n      return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n  \n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  # Heuristic: Prioritize states that have more of the desired item\n  def heuristic(state, goal_arg):\n      return -state.inventory[goal_arg]\n\n  # A* search with heuristic\n  def a_star(start_state, goal_name, goal_arg):\n      open_set = [(0, start_state, [])]\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = open_set.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          hash_val = state_hash(current_state)\n          if hash_val in visited_states:\n              continue\n          visited_states.add(hash_val)\n\n          for action, next_state in get_possible_actions(current_state):\n              hash_next = state_hash(next_state)\n              if hash_next not in visited_states:\n                  g_cost = len(actions_taken) + 1\n                  h_cost = heuristic(next_state, goal_arg)\n                  f_cost = g_cost + h_cost\n                  open_set.append((f_cost, next_state, actions_taken + [action]))\n                  # Sort the open set to ensure the lowest cost is always first\n                  open_set.sort(key=lambda x: x[0])\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:35:44.882754", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Hash the state for efficient lookup\n      state_hash = hash((current_state.grid.tobytes(), tuple(current_state.inventory), current_state.pos, current_state.dir))\n\n      if state_hash in visited_states:\n        continue\n\n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # If the action is invalid (reward < 0 or no change in state), skip it\n        if reward < 0 or state_hash == hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir)):\n          continue\n\n        # Create a hashable state representation for the next state\n        next_state_hash = hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir))\n\n        if next_state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:35:45.851867", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Hash the state for efficient lookup\n          state_hash = hash((current_state.grid.tobytes(), tuple(current_state.inventory), current_state.pos, current_state.dir))\n\n          if state_hash in visited_states:\n              continue\n\n          visited_states.add(state_hash)\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # If the action is invalid (reward < 0), skip it\n              if reward < 0:\n                  continue\n\n              # Check if the state has been visited before\n              next_state_hash = hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir))\n\n              if next_state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:37:30.309075", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:37:31.316107", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_closest_resource(state, resource_indices):\n    \"\"\"Find the closest resource to the current state.\"\"\"\n    from scipy.spatial import distance\n    \n    pos = np.array(state.pos)\n    min_dist = float('inf')\n    closest_pos = None\n    \n    for idx in resource_indices:\n      grid = state.grid\n      positions = np.argwhere(grid[..., idx] == 1)\n      \n      for res_pos in positions:\n        dist = distance.cityblock(pos, res_pos)\n        \n        if dist < min_dist:\n          min_dist = dist\n          closest_pos = tuple(res_pos)\n    \n    return closest_pos\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  \n  for resource, count in primitives_needed.items():\n    # Find the closest position of this resource\n    target_pos = find_closest_resource(start_state, [resource])\n    \n    if target_pos is None:\n      raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n    \n    # Move to the target position\n    actions.extend(move_to_position(start_state, target_pos))\n    start_state = env._current_state\n    \n    # Pick up the resource\n    actions.append(USE)\n    start_state = env._current_state\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:38:34.300417", "function_name": "craft", "function_body": "  # Ensure the item is valid\n  if item not in env.world.cookbook.kinds:\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  start_state = env.scenario.init()\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:38:35.408933", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item not in env.world.cookbook.kinds:\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:39:38.932769", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.pop(0)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define the goal using the item index\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Perform BFS to find the action sequence\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:39:40.019396", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:40:57.561052", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Heuristic: Prioritize USE action if next to required item\n      if state.next_to(goal):\n        reward, new_state = state.step(USE)\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [USE]))\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid unnecessary movements by checking the direction\n        if (action == UP and state.dir == DOWN) or\\\n           (action == DOWN and state.dir == UP) or\\\n           (action == LEFT and state.dir == RIGHT) or\\\n           (action == RIGHT and state.dir == LEFT):\n          continue  # Skip opposite movement\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:40:58.533513", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance heuristic based on position\n    pos = state.pos\n    target_pos = np.unravel_index(np.argmax(env._current_state.grid[:, :, goal]), env._current_state.grid.shape[:2])\n    return abs(pos[0] - target_pos[0]) + abs(pos[1] - target_pos[1])\n\n  def a_star(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, state, actions = open_set.get()\n      \n      if state.satisfies(\"\", goal):\n        path = []\n        current_state = state\n        while current_state in came_from:\n          path.append(actions[-1])\n          current_state, actions = came_from[current_state]\n        return path[::-1]\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or\\\n           tentative_g_score < g_score[tuple(new_state.features())]:\n            \n            came_from[new_state] = (state, actions)\n            g_score[tuple(new_state.features())] = tentative_g_score\n            f_score = tentative_g_score + heuristic(new_state, goal)\n            open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:42:07.173686", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the count of the goal item in the inventory\n    return -state.inventory[goal]\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Sort the actions based on heuristic\n      sorted_use_actions = sorted(use_actions, key=lambda x: heuristic(x[0], goal))\n      sorted_other_actions = sorted(other_actions, key=lambda x: heuristic(x[0], goal))\n      \n      # Extend queue with prioritized and sorted actions\n      queue.extendleft(sorted_use_actions)\n      queue.extend(sorted_other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:42:08.137546", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Calculate the distance to the nearest workshop if necessary\n    if state.inventory[env.world.stone_index] > 0 and env.world.workshop_indices:\n      workshop_distances = [np.linalg.norm(np.array(state.pos) - np.array((x // env.world.grid.shape[1], x % env.world.grid.shape[1])), ord=1)\n                            for x in env.world.workshop_indices]\n      return min(workshop_distances, default=float('inf'))\n    return 0\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extendleft(use_actions)  # Prioritize USE actions by adding them first\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:43:33.865368", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and heuristic guidance.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(new_state, actions) and\\\n           can_progress(new_state, goal):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  def can_progress(state, goal):\n    \"\"\"Check if the state is moving towards the goal.\"\"\"\n    # Simplistic heuristic: check if inventory of the goal item has increased\n    return state.inventory[goal] > env._current_state.inventory[goal]\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:43:34.891390", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(new_state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:45:10.594479", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate cost from state to goal.\"\"\"\n    # For simplicity, we can use a dummy heuristic like the Manhattan distance to the nearest resource.\n    if not state.next_to(goal):\n      return 10  # Arbitrary large number if not next to goal\n    else:\n      return 1  # Small number if next to goal\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:45:11.575186", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_primitives(env, item):\n    \"\"\"Get primitives required for the given item.\"\"\"\n    cookbook = env.world.cookbook\n    return cookbook.primitives_for(item)\n\n  start_state = env._current_state\n  primitives = get_primitives(env, item)\n  \n  if not primitives:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitives.items():\n    while state.inventory[primitive] < count:\n      # Find and collect the primitive\n      actions_to_primitive = bfs(start_state, primitive)\n      if actions_to_primitive is None:\n        raise ValueError(\"No path to collect the required primitive found.\")\n      \n      actions.extend(actions_to_primitive)\n      state = env._current_state\n      for action in actions_to_primitive:\n        _, state = state.step(action)\n\n  # Craft the item using collected primitives\n  actions_to_craft = bfs(start_state, item)\n  if actions_to_craft is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  actions.extend(actions_to_craft)\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:46:32.174001", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:46:33.143035", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n      \"\"\"Heuristic function: number of items missing to craft the goal.\"\"\"\n      primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory\n      missing_items = sum(max(0, count - current_inventory[prim]) for prim, count in primitives_needed.items())\n      return missing_items\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search with heuristic function.\"\"\"\n    import heapq\n    open_set = []\n    heapq.heappush(open_set, (heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          priority = heuristic(next_state, goal_arg) + len(actions_taken) + 1\n          heapq.heappush(open_set, (priority, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:47:40.482855", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Simple Manhattan distance to the goal in feature space\n    return np.sum(np.abs(state.features() - env.world.cookbook.primitives_for(item)))\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path with heuristics.\"\"\"\n    import heapq\n    \n    open_set = [(heuristic(start_state), start_state, [])]\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:47:41.515438", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Optimize by avoiding repeated USE actions that don't change the state\n        if action == USE and tuple(new_state.features()) == tuple(state.features()):\n          continue\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:48:32.959563", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:48:33.950155", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of items in the inventory compared to the goal requirements\n    cookbook = env.world.cookbook.recipes.get(goal, {})\n    required_items = set(cookbook.keys()) - {\"_key\"}\n    \n    missing_count = sum(1 for i_kind in required_items if state.inventory[i_kind] == 0)\n    return missing_count\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          cost = len(actions) + heuristic(new_state, goal)\n          heappush(open_set, (cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:49:54.350951", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            \n            # Avoid unnecessary movements by checking the direction\n            if (action == UP and state.dir == DOWN) or\\\n               (action == DOWN and state.dir == UP) or\\\n               (action == LEFT and state.dir == RIGHT) or\\\n               (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n            \n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:49:55.337403", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic function to prioritize states that are closer to the goal item\n    if state.next_to(goal):\n      return -1  # Prioritize USE action if next to the goal item\n    else:\n      return 0\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    \n    g_scores = {tuple(start_state.features()): 0}\n    visited = set()\n    \n    while open_set:\n      f_score, state, actions = heappop(open_set)\n      \n      if tuple(state.features()) in visited:\n        continue\n      \n      visited.add(tuple(state.features()))\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_scores[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or\\\n           tentative_g_score < g_scores[tuple(new_state.features())]:\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          \n          # Avoid unnecessary movements by checking the direction\n          if (action == UP and state.dir == DOWN) or\\\n             (action == DOWN and state.dir == UP) or\\\n             (action == LEFT and state.dir == RIGHT) or\\\n             (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n          \n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:50:48.164102", "function_name": "craft", "function_body": "  def get_state_hash(state):\n    # Use a more efficient hashing strategy by combining grid and inventory into bytes\n    grid_bytes = state.grid.tobytes()\n    inventory_bytes = state.inventory.tobytes()\n    return (grid_bytes, inventory_bytes) + tuple(state.pos) + (state.dir,)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = get_state_hash(next_state)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  goal_arg = item\n  \n  action_sequence = bfs(env.scenario.init(), goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:50:49.131389", "function_name": "craft", "function_body": "  def get_state_hash(state):\n    \"\"\"Generate a hashable state representation.\"\"\"\n    grid_tuple = tuple(map(tuple, state.grid))\n    inventory_tuple = tuple(state.inventory)\n    return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = get_state_hash(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  goal_arg = item\n  action_sequence = bfs(env.scenario.init(), goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:52:03.509865", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n      # Simple heuristic: number of steps required based on current inventory and grid state\n      needed = env.world.cookbook.primitives_for(goal)\n      current_inventory = state.inventory.copy()\n      steps = 0\n      \n      for primitive, count in needed.items():\n          if current_inventory[primitive] < count:\n              steps += (count - current_inventory[primitive])\n      \n      return steps\n\n  def astar(start_state, goal):\n    \"\"\"A* Search with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n              came_from[tuple(new_state.features())] = (current_state, actions + [action])\n              g_score[tuple(new_state.features())] = tentative_g_score\n              f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n              heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n      total_path = []\n      while tuple(current.features()) in came_from:\n          _, path_actions = came_from[tuple(current.features())]\n          total_path.extend(path_actions)\n          current = _\n      return total_path + actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:52:04.589542", "function_name": "craft", "function_body": "  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with additional optimizations.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the action led to a meaningful state change\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == 4:  # USE action\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:55:28.071046", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_closest_resource(state, resource_indices):\n    \"\"\"Find the closest resource to the current state.\"\"\"\n    from scipy.spatial import distance\n    \n    pos = np.array(state.pos)\n    min_dist = float('inf')\n    closest_pos = None\n    \n    for idx in resource_indices:\n      grid = state.grid\n      positions = np.argwhere(grid[..., idx] == 1)\n      \n      for res_pos in positions:\n        dist = distance.cityblock(pos, res_pos)\n        \n        if dist < min_dist:\n          min_dist = dist\n          closest_pos = tuple(res_pos)\n    \n    return closest_pos\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  \n  for resource, count in primitives_needed.items():\n    # Find the closest position of this resource\n    target_pos = find_closest_resource(start_state, [resource])\n    \n    if target_pos is None:\n      raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n    \n    # Move to the target position\n    actions.extend(move_to_position(start_state, target_pos))\n    start_state = env._current_state\n    \n    # Pick up the resource\n    for _ in range(count):\n        actions.append(USE)\n        start_state = env._current_state\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:55:29.100776", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_resource_positions(state, resource_indices):\n      \"\"\"Get all positions of the resources on the grid.\"\"\"\n      positions = {}\n      for idx in resource_indices:\n          grid = state.grid\n          pos_list = np.argwhere(grid[..., idx] == 1)\n          if len(pos_list) > 0:\n              positions[idx] = [tuple(pos) for pos in pos_list]\n      return positions\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  resource_positions = get_resource_positions(start_state, list(primitives_needed.keys()))\n  \n  for resource, count in primitives_needed.items():\n      if resource not in resource_positions or len(resource_positions[resource]) == 0:\n          raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n      \n      # Use all available positions of this resource\n      while count > 0 and resource_positions[resource]:\n          target_pos = resource_positions[resource].pop()\n          \n          # Move to the target position\n          actions.extend(move_to_position(start_state, target_pos))\n          start_state = env._current_state\n          \n          # Pick up the resource\n          actions.append(USE)\n          start_state = env._current_state\n          \n          count -= 1\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:56:48.651628", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search with early termination and heuristic pruning\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = tuple(next_state.grid.flatten()) +\\\n                         tuple(next_state.inventory) +\\\n                         (next_state.pos,) +\\\n                         (next_state.dir,)\n              \n              if hash_val not in visited_states:\n                  # Heuristic pruning: avoid states with no new items\n                  if any(i > 0 for i in next_state.inventory):\n                      queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:56:49.720060", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg, max_steps=1000):\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited_states = set()\n      steps_taken = 0\n      \n      while queue and steps_taken < max_steps:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = tuple(next_state.grid.flatten()) +\\\n                         tuple(next_state.inventory) +\\\n                         (next_state.pos,) +\\\n                         (next_state.dir,)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n          \n          steps_taken += 1\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:57:40.816883", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:57:41.888143", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:59:06.625218", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    from heapq import heappush, heappop\n    \n    # Priority queue of (f_score, g_score, actions, state)\n    open_set = []\n    heappush(open_set, (0, 0, [], start_state))\n    \n    # Dictionary for visited states and their g_scores\n    g_scores = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, g_score, actions, current_state = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        features_tuple = tuple(new_state.features())\n        g_score_next = g_score + 1  # Each action costs 1\n        \n        if features_tuple not in g_scores or g_score_next < g_scores[features_tuple]:\n          g_scores[features_tuple] = g_score_next\n          \n          h_score_next = heuristic(new_state, goal)  # Estimate remaining cost\n          f_score_next = g_score_next + h_score_next\n          \n          heappush(open_set, (f_score_next, g_score_next, actions + [action], new_state))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    # Use a combination of inventory and proximity to ingredients\n    inventory_value = state.inventory[goal]\n    ingredient_proximity = sum(\n        state.next_to(i) for i in env.world.cookbook.primitives_for(goal)\n    )\n    \n    return -inventory_value + ingredient_proximity\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:59:07.678104", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    from heapq import heappush, heappop\n    \n    # Priority queue of (f_score, g_score, actions, state)\n    open_set = []\n    heappush(open_set, (0, 0, [], start_state))\n    \n    # Dictionary to store the cost and actions leading to each state\n    g_scores = {tuple(start_state.features()): 0}\n    came_from = {}\n    \n    while open_set:\n      _, g_score, actions, current_state = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        features_tuple = tuple(new_state.features())\n        g_score_next = g_score + 1  # Each action costs 1\n        \n        if features_tuple not in g_scores or g_score_next < g_scores[features_tuple]:\n          g_scores[features_tuple] = g_score_next\n          f_score_next = g_score_next + heuristic(new_state, goal)\n          heappush(open_set, (f_score_next, g_score_next, actions + [action], new_state))\n          came_from[new_state] = current_state\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    return -state.inventory[goal]  # More inventory of goal item is better\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = []\n    while current_state in came_from:\n      total_path.append(actions)\n      current_state = came_from[current_state]\n      actions = came_from_actions[current_state]\n    return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T09:59:57.839859", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T09:59:58.896052", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:00:53.862571", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:00:54.844033", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = hash_state(next_state)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:02:15.566558", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the count of the goal item in inventory.\n    return -state.inventory[goal]\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with a heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:02:16.552576", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # This is a simple heuristic that assumes each USE action brings us closer\n    # to the goal. You can improve this based on domain knowledge.\n    return sum(state.inventory) - goal\n\n  def astar(start_state, goal):\n    \"\"\"A* search algorithm to find the shortest path with a heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))  # (f_score, state, actions)\n    g_scores = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n\n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_scores[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:03:39.715743", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Simple heuristic: count of inventory items needed for the goal recipe\n    cookbook = env.world.cookbook\n    if goal in cookbook.recipes:\n      recipe = cookbook.recipes[goal]\n      missing_count = 0\n      for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n          continue\n        missing_count += max(0, count - state.inventory[ingredient])\n      return missing_count\n    else:\n      return float('inf')  # No recipe found\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path using heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          \n          open_set.put((f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:03:40.707786", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of missing ingredients\n    cookbook = env.world.cookbook.recipes.get(goal)\n    if not cookbook:\n      return float('inf')  # No recipe available for the item\n    \n    current_inventory = state.inventory.copy()\n    missing_count = 0\n    \n    for ingredient, required in cookbook.items():\n        if ingredient == \"_key\":\n            continue\n        if current_inventory[ingredient] < required:\n            missing_count += required - current_inventory[ingredient]\n    \n    return missing_count\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:07:23.603079", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_closest_resource(state, resource_indices):\n    \"\"\"Find the closest resources to the current state.\"\"\"\n    from scipy.spatial import distance\n    \n    pos = np.array(state.pos)\n    closest_positions = []\n    \n    for idx in resource_indices:\n      grid = state.grid\n      positions = np.argwhere(grid[..., idx] == 1)\n      \n      if not positions.size:\n          continue\n      \n      min_dist = float('inf')\n      closest_pos = None\n      \n      for res_pos in positions:\n        dist = distance.cityblock(pos, res_pos)\n        \n        if dist < min_dist:\n          min_dist = dist\n          closest_pos = tuple(res_pos)\n      \n      closest_positions.append(closest_pos)\n    \n    return closest_positions\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  \n  for resource, count in primitives_needed.items():\n    target_positions = find_closest_resource(start_state, [resource])\n    \n    for _ in range(count):\n      closest_pos = min(target_positions, key=lambda pos: distance.cityblock(np.array(start_state.pos), np.array(pos)))\n      \n      if closest_pos is None:\n        raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n      \n      # Move to the target position\n      actions.extend(move_to_position(start_state, closest_pos))\n      start_state = env._current_state\n      \n      # Pick up the resource\n      actions.append(USE)\n      start_state = env._current_state\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:07:24.563650", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_closest_resource(state, resource_indices):\n    \"\"\"Find the closest resource to the current state.\"\"\"\n    from scipy.spatial import distance\n    \n    pos = np.array(state.pos)\n    min_dist = float('inf')\n    closest_pos = None\n    \n    for idx in resource_indices:\n      grid = state.grid\n      positions = np.argwhere(grid[..., idx] == 1)\n      \n      for res_pos in positions:\n        dist = distance.cityblock(pos, res_pos)\n        \n        if dist < min_dist:\n          min_dist = dist\n          closest_pos = tuple(res_pos)\n    \n    return closest_pos\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  collected_resources = set()\n  \n  while True:\n    # Check if we have all required resources\n    missing_resources = {resource: count for resource, count in primitives_needed.items() if state.inventory.get(resource, 0) < count}\n    \n    if not missing_resources:\n      break\n    \n    for resource, _ in missing_resources.items():\n      if resource in collected_resources:\n        continue\n      \n      # Find the closest position of this resource\n      target_pos = find_closest_resource(start_state, [resource])\n      \n      if target_pos is None:\n        raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n      \n      # Move to the target position\n      actions.extend(move_to_position(start_state, target_pos))\n      start_state = env._current_state\n      \n      # Pick up the resource\n      actions.append(USE)\n      start_state = env._current_state\n      \n      collected_resources.add(resource)\n\n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:09:07.971016", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n\n              # Create a hashable state representation\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n      # Simple heuristic: number of items needed in inventory\n      needed_items = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = current_state.inventory\n      missing_count = sum(max(needed - current for needed, current in zip(needed_items.values(), current_inventory[indices])) for indices in needed_items)\n      return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      import heapq\n\n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n\n              # Create a hashable state representation\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n\n              if state_hash not in visited_states:\n                  g_cost = len(actions_taken) + 1\n                  h_cost = heuristic(next_state, goal_arg)\n                  f_cost = g_cost + h_cost\n\n                  heapq.heappush(open_set, (f_cost, next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
