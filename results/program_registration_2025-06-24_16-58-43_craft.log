{"timestamp": "2025-06-25T14:39:27.185691", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:39:28.157175", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state to avoid revisiting\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  def heuristic(current_state, goal_arg):\n    # Simple heuristic: number of items needed to craft the goal\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = current_state.inventory\n    missing_items = sum(max(0, count - current_inventory[item]) for item, count in primitives.items())\n    return missing_items\n\n  def astar(start_state, goal_name, goal_arg):\n    from heapq import heappush, heappop\n\n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state to avoid revisiting\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          heappush(open_set, (heuristic(next_state, goal_arg) + len(actions_taken) + 1, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:40:21.359420", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n      # Simple heuristic: number of missing items needed to satisfy the goal\n      required_inventory = env.world.cookbook.primitives_for(goal)\n      current_inventory = state.inventory\n\n      missing_count = 0\n      for primitive_kind, count in required_inventory.items():\n          if primitive_kind not in current_inventory or current_inventory[primitive_kind] < count:\n              missing_count += count - (current_inventory.get(primitive_kind, 0))\n      \n      return missing_count\n\n  def astar(start_state, goal_name, goal_arg):\n    import heapq\n\n    # Priority queue for A* search\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))  # (f, state, path)\n    \n    visited_states = set()\n    g_costs = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_cost = g_costs[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n\n        if state_hash not in visited_states or tentative_g_cost < g_costs.get(state_hash, float('inf')):\n          visited_states.add(state_hash)\n          g_costs[state_hash] = tentative_g_cost\n          f_cost = tentative_g_cost + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:40:22.404214", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              # Create a hashable representation of the state\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:41:40.224706", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if it leads to a new state\n      use_actions, other_actions = [], []\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if new_state.inventory[goal] > 0:\n            return actions + [action]\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Add USE actions first if available\n      queue.extendleft(reversed(use_actions))\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:41:41.203992", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Check if the item is crafted directly\n              if new_state.inventory[goal] > 0:\n                  return actions + [action]\n              \n              if action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Attempt to optimize the initial state by moving towards the nearest resource\n  def move_towards_resource(state):\n      \"\"\"Moves the agent towards the nearest resource needed for the goal.\"\"\"\n      primitives = env.world.cookbook.primitives_for(item)\n      \n      def get_distance(pos1, pos2):\n          return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n      \n      grid = state.grid\n      agent_pos = state.pos\n      \n      nearest_resource_pos = None\n      min_distance = float('inf')\n      \n      for i_kind in primitives.keys():\n          if i_kind not in env.world.non_grabbable_indices:\n              positions = np.argwhere(grid[:, :, i_kind] > 0)\n              for pos in positions:\n                  distance = get_distance(agent_pos, (pos[1], pos[0]))\n                  if distance < min_distance:\n                      min_distance = distance\n                      nearest_resource_pos = (pos[1], pos[0])\n      \n      if nearest_resource_pos is not None:\n          path = a_star(state, nearest_resource_pos)\n          return path + [USE]\n      else:\n          return []\n  \n  def a_star(start_state, target_pos):\n      from heapq import heappush, heappop\n      \n      UP = 0\n      DOWN = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n      \n      def get_neighbors(pos, dir):\n          neighbors = []\n          if pos[0] > 0:\n              neighbors.append((pos[0] - 1, pos[1], LEFT))\n          if pos[0] < env.world.grid.shape[0] - 1:\n              neighbors.append((pos[0] + 1, pos[1], RIGHT))\n          if pos[1] > 0:\n              neighbors.append((pos[0], pos[1] - 1, UP))\n          if pos[1] < env.world.grid.shape[1] - 1:\n              neighbors.append((pos[0], pos[1] + 1, DOWN))\n          return neighbors\n      \n      def heuristic(pos):\n          return abs(pos[0] - target_pos[0]) + abs(pos[1] - target_pos[1])\n      \n      open_set = []\n      heappush(open_set, (0, start_state.pos, start_state.dir, []))\n      came_from = {}\n      g_score = {start_state.pos: 0}\n      \n      while open_set:\n          _, current_pos, current_dir, actions = heappop(open_set)\n          \n          if current_pos == target_pos:\n              return actions\n          \n          for new_pos, action in get_neighbors(current_pos, current_dir):\n              tentative_g_score = g_score[current_pos] + 1\n              \n              if new_pos not in g_score or tentative_g_score < g_score[new_pos]:\n                  came_from[(new_pos, action)] = (current_pos, actions)\n                  g_score[new_pos] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_pos)\n                  heappush(open_set, (f_score, new_pos, action, actions + [action]))\n      \n      return []  # No path found\n  \n  optimized_actions = move_towards_resource(start_state)\n  \n  if optimized_actions:\n      start_state = start_state\n      for action in optimized_actions[:-1]:\n          _, start_state = start_state.step(action)\n      use_action = optimized_actions[-1]\n      actions = [use_action] + bfs(start_state, item)\n  else:\n      actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:42:09.661699", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:42:10.751630", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:42:56.641448", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Collect actions with prioritization\n      use_actions, other_actions = [], []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Directly return if goal is crafted using USE\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]\n              elif action == USE:\n                  use_actions.append((new_state, actions + [action]))\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add all USE actions first\n      queue.extendleft(reversed(use_actions))\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:42:57.607431", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    \"\"\"Simple heuristic based on distance to goal in inventory.\"\"\"\n    return 1 / (state.inventory[item] + 1)\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Collect actions with prioritization\n      use_actions, other_actions = [], []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              priority = heuristic(new_state) + len(actions)  # f(n) = g(n) + h(n)\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_actions.append((priority, new_state, actions + [action]))\n              else:\n                  other_actions.append((priority, new_state, actions + [action]))\n      \n      # Add all USE actions first with priority\n      for _, new_state, actions in sorted(use_actions):\n          heapq.heappush(open_set, (heuristic(new_state) + len(actions), new_state, actions))\n      for _, new_state, actions in other_actions:\n          heapq.heappush(open_set, (heuristic(new_state) + len(actions), new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:44:00.038269", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Use a more efficient hash by combining key state elements\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  index = env.world.cookbook.index.get(item)\n  if index is None or index not in env.world.cookbook.kinds:\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  action_sequence = bfs(env.scenario.init(), index)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:44:01.010152", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Use a more efficient hash by combining key state elements\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def a_star(start_state, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      import heapq\n      \n      # Priority queue (f_score, state, actions_taken)\n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_score = {start_state: 0}\n      f_score = {start_state: heuristic(start_state, goal_arg)}\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Use a more efficient hash by combining key state elements\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n              tentative_g_score = g_score[current_state] + 1\n\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (f_score[state_hash], next_state, actions_taken + [action]))\n      \n      return None\n\n  def heuristic(state, goal_arg):\n      \"\"\"Heuristic function to estimate cost from state to goal.\"\"\"\n      # Here we use a simple heuristic based on the number of items needed in inventory\n      required_items = primitives_for(env.world.cookbook, goal_arg)\n      current_inventory = dict(enumerate(state.inventory))\n      \n      missing_count = sum(required.get(i, 0) - current_inventory.get(i, 0) for i, count in required.items())\n      \n      return missing_count\n\n  def primitives_for(cookbook, goal):\n      \"\"\"Returns a dictionary mapping primitive-kind indices to counts required to craft one goal.\"\"\"\n      from collections import defaultdict\n      \n      if goal not in cookbook.recipes:\n          return {}\n      \n      queue = [goal]\n      primitives = defaultdict(int)\n      \n      while queue:\n          current = queue.pop()\n          \n          if current in cookbook.primitives:\n              primitives[current] += 1\n          elif current in cookbook.recipes:\n              for ingredient, count in cookbook.recipes[current].items():\n                  if ingredient == \"_key\":\n                      continue\n                  for _ in range(count):\n                      queue.append(ingredient)\n      \n      return dict(primitives)\n\n  # Ensure the item is valid\n  if item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  action_sequence = a_star(env.scenario.init(), item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:44:32.057888", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:44:33.116469", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:45:34.898942", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n    # Example heuristic: number of missing items in the inventory needed to satisfy the goal\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory.copy()\n    \n    total_missing = 0\n    \n    for prim_kind, count_needed in primitives.items():\n      if prim_kind in current_inventory:\n        total_missing += max(0, count_needed - current_inventory[prim_kind])\n      else:\n        total_missing += count_needed\n\n    return total_missing\n\n  def a_star(start_state, goal_name, goal_arg):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state, goal_arg)}\n    \n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state)\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n\n        tentative_g_score = g_score[current_state] + 1\n        \n        if next_state not in g_score or tentative_g_score < g_score[next_state]:\n          came_from[next_state] = (current_state, action)\n          g_score[next_state] = tentative_g_score\n          f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n    \n    return None\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      \n      while current in came_from:\n        prev, action = came_from[current]\n        total_path.append(action)\n        current = prev\n      \n      return list(reversed(total_path))\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n    raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:45:35.896730", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      # Simple heuristic based on the number of primitives needed\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_index)\n      \n      # Count how many primitives are already in inventory\n      current_primitives = state.inventory[list(primitives_needed.keys())]\n      missing_primitives = np.array(list(primitives_needed.values())) - current_primitives\n      \n      return int(np.sum(missing_primitives[missing_primitives > 0]))\n\n  def a_star(start_state, goal_name, goal_arg):\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))  # (f_score, state, actions_taken)\n    visited_states = set()\n    \n    while open_set:\n      current_f, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          g_score = len(actions_taken) + 1\n          h_score = heuristic(next_state, goal_arg)\n          f_score = g_score + h_score\n          \n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:46:28.179400", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n    # Simple heuristic: count of items needed minus count of items in inventory\n    primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = current_state.inventory\n\n    total_cost = 0\n    for primitive, required_count in primitives_needed.items():\n      current_count = current_inventory[primitive]\n      if current_count < required_count:\n        total_cost += (required_count - current_count)\n\n    return total_cost\n\n  def a_star(start_state, goal_arg):\n    \"\"\"A* search algorithm to find the optimal sequence of actions.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))  # (f_score, state, actions_taken)\n    came_from = {}\n    g_score = {hash_state(start_state): 0}\n    \n    while open_set:\n      current_f_score, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies('default', goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n      \n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        tentative_g_score = g_score[hash_state(current_state)] + 1\n\n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = (current_state, actions_taken)\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    \"\"\"Reconstructs the path from start to goal.\"\"\"\n    total_actions = []\n    while hash_state(current_state) in came_from:\n      current_state, prev_actions = came_from[hash_state(current_state)]\n      total_actions = prev_actions + total_actions\n    return total_actions + actions_taken\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = a_star(start_state, item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:46:29.157181", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:48:18.401277", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action in range(env.world.n_actions):\n            reward, next_state = current_state.step(action)\n            \n            state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n            \n            if state_hash not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Example heuristic: number of steps needed to gather all required primitives\n    required_primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory\n    missing_count = sum(max(0, count - current_inventory[primitive]) for primitive, count in required_primitives.items())\n    return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search with heuristic guidance.\"\"\"\n    from heapq import heappush, heappop\n    open_set = []\n    heappush(open_set, (0, start_state, []))  # (f_score, state, actions_taken)\n    g_scores = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    came_from = {}\n\n    while open_set:\n        _, current_state, actions_taken = heappop(open_set)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return reconstruct_path(came_from, current_state, actions_taken)\n\n        for action in range(env.world.n_actions):\n            reward, next_state = current_state.step(action)\n            \n            state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n            \n            tentative_g_score = g_scores[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n\n            if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                came_from[state_hash] = current_state\n                g_scores[state_hash] = tentative_g_score\n                f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    \"\"\"Reconstruct the path from start to goal.\"\"\"\n    total_path = []\n    while current_state:\n        total_path.append(actions_taken[-1])\n        state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n        if state_hash in came_from:\n            actions_taken = came_from[state_hash]\n            current_state = came_from[state_hash]\n        else:\n            break\n    return total_path[::-1]\n\n  # Reset environment to a known starting state\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:48:19.379906", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import defaultdict\n    import heapq\n\n    # Priority queue with (f_cost, state_hash, actions_taken)\n    open_set = []\n    heapq.heappush(open_set, (0, tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + start_state.pos + (start_state.dir,), []))\n    \n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    f_score = defaultdict(lambda: float('inf'))\n\n    state_hash = tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + start_state.pos + (start_state.dir,)\n    g_score[state_hash] = 0\n    f_score[state_hash] = heuristic(start_state, goal_arg)\n\n    while open_set:\n        _, current_state_hash, actions_taken = heapq.heappop(open_set)\n        \n        # Reconstruct the state from the hash\n        grid_flat, inventory, pos_x, pos_y, dir_ = current_state_hash[:-3], current_state_hash[-4:-1], current_state_hash[-3], current_state_hash[-2], current_state_hash[-1]\n        grid = np.array(grid_flat).reshape(env.world.cookbook.n_kinds, env.scenario.init_grid.shape[0], env.scenario.init_grid.shape[1]).transpose(1, 2, 0)\n        inventory = np.array(inventory)\n\n        current_state = CraftState(\n            scenario=env.scenario,\n            grid=grid,\n            pos=(pos_x, pos_y),\n            dir=dir_,\n            inventory=inventory\n        )\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return reconstruct_path(came_from, current_state_hash)\n\n        for action in range(env.world.n_actions):\n            _, next_state = current_state.step(action)\n            \n            state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n            tentative_g_score = g_score[current_state_hash] + 1\n\n            if tentative_g_score < g_score[state_hash]:\n                came_from[state_hash] = current_state_hash\n                g_score[state_hash] = tentative_g_score\n                f_score[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n                heapq.heappush(open_set, (f_score[state_hash], state_hash, actions_taken + [action]))\n\n    return None\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Example heuristic: number of steps needed to gather all required primitives\n    required_primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory\n    missing_count = sum(max(0, count - current_inventory[primitive]) for primitive, count in required_primitives.items())\n    return missing_count\n\n  def reconstruct_path(came_from, current_state_hash):\n      total_path = []\n      \n      while current_state_hash in came_from:\n          total_path.append(current_state_hash)\n          current_state_hash = came_from[current_state_hash]\n      \n      total_path.reverse()\n      # Extract actions from the path\n      action_sequence = []\n      for i in range(1, len(total_path)):\n          prev_hash, curr_hash = total_path[i-1], total_path[i]\n          grid_flat_prev, inventory_prev, pos_x_prev, pos_y_prev, dir_prev = prev_hash[:-3], prev_hash[-4:-1], prev_hash[-3], prev_hash[-2], prev_hash[-1]\n          grid_flat_curr, inventory_curr, pos_x_curr, pos_y_curr, dir_curr = curr_hash[:-3], curr_hash[-4:-1], curr_hash[-3], curr_hash[-2], curr_hash[-1]\n\n          grid_prev = np.array(grid_flat_prev).reshape(env.world.cookbook.n_kinds, env.scenario.init_grid.shape[0], env.scenario.init_grid.shape[1]).transpose(1, 2, 0)\n          inventory_prev = np.array(inventory_prev)\n\n          state_prev = CraftState(\n              scenario=env.scenario,\n              grid=grid_prev,\n              pos=(pos_x_prev, pos_y_prev),\n              dir=dir_prev,\n              inventory=inventory_prev\n          )\n\n          for action in range(env.world.n_actions):\n              _, next_state = state_prev.step(action)\n              \n              if (tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)) == curr_hash:\n                  action_sequence.append(action)\n                  break\n\n      return action_sequence\n\n\n  # Reset environment to a known starting state\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:48:52.264505", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extendleft(reversed(use_actions))  # Prioritize USE actions by extending from the left\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
