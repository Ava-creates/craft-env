{"timestamp": "2025-06-25T05:44:53.000379", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:47:27.547576", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (not any(new_state.grid[state.pos] == env.world.non_grabbable_indices) and\n            tuple(new_state.features()) not in visited):\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states with progress towards crafting\n          if action == USE and new_state.inventory[goal] > state.inventory[goal]:\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_initial_resources(env):\n      \"\"\"Gather initial resources available on the grid.\"\"\"\n      grid = env._current_state.grid\n      resources = {}\n      \n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              kind_index = np.argmax(grid[i, j])\n              if kind_index in env.world.grabbable_indices:\n                  if kind_index not in resources:\n                      resources[kind_index] = 0\n                  resources[kind_index] += 1\n      \n      return resources\n\n  def gather_initial_resources(env):\n    \"\"\"Gather initial resources available on the grid.\"\"\"\n    grid = env._current_state.grid\n    resources = {}\n    \n    for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n            kind_index = np.argmax(grid[i, j])\n            if kind_index in env.world.grabbable_indices:\n                if kind_index not in resources:\n                    resources[kind_index] = 0\n                resources[kind_index] += 1\n    \n    return resources\n\n  def gather_resources(actions):\n      \"\"\"Simulate gathering resources based on the actions taken.\"\"\"\n      current_state = env._current_state\n      gathered_resources = {}\n      \n      for action in actions:\n          reward, new_state = current_state.step(action)\n          \n          # Check if any resource was picked up\n          for kind_index in env.world.grabbable_indices:\n              if new_state.inventory[kind_index] > current_state.inventory[kind_index]:\n                  if kind_index not in gathered_resources:\n                      gathered_resources[kind_index] = 0\n                  gathered_resources[kind_index] += (new_state.inventory[kind_index] - current_state.inventory[kind_index])\n          \n          current_state = new_state\n      \n      return gathered_resources\n\n  def is_possible_to_craft(primitives, primitives_required):\n    \"\"\"Check if the available primitives are sufficient to craft the goal item.\"\"\"\n    for primitive, count in primitives_required.items():\n        if primitives.get(primitive, 0) < count:\n            return False\n    return True\n\n  start_state = env._current_state\n  initial_resources = gather_initial_resources(env)\n  \n  # Get primitives required for the goal item\n  cookbook = env.world.cookbook\n  primitives_required = cookbook.primitives_for(item)\n\n  if not is_possible_to_craft(initial_resources, primitives_required):\n    raise ValueError(\"Initial resources are insufficient to craft the item.\")\n\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:47:28.528117", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (not any(new_state.grid[state.pos] == env.world.non_grabbable_indices) and\n            tuple(new_state.features()) not in visited):\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states with progress towards crafting\n          if action == USE and new_state.inventory[goal] > state.inventory[goal]:\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:49:43.016460", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Simple heuristic: count the number of items needed in inventory\n    needed_items = set()\n    def find_needed_items(output_index):\n      if output_index not in env.world.cookbook.recipes:\n        return\n      for ingredient, count in env.world.cookbook.recipes[output_index].items():\n        if ingredient != \"_key\":\n          needed_items.add((ingredient, count))\n          find_needed_items(ingredient)\n\n    find_needed_items(goal_arg)\n    \n    current_inventory = state.inventory.copy()\n    missing_count = 0\n    for item, count in needed_items:\n      if current_inventory[item] < count:\n        missing_count += (count - current_inventory[item])\n    \n    return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[state_hash] + 1\n        \n        if next_state_hash not in g_score or tentative_g_score < g_score[next_state_hash]:\n          came_from[next_state_hash] = (state_hash, action)\n          g_score[next_state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T05:49:44.061281", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Only add valid moves to the queue\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:51:45.644140", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Simple heuristic based on Manhattan distance to the nearest required resource.\"\"\"\n      # Count missing items in inventory\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      \n      min_distance = float('inf')\n      grid_size = state.grid.shape[0] * state.grid.shape[1]\n      \n      # Calculate distance to nearest missing item\n      for idx in missing_items:\n          resource_positions = np.argwhere(state.grid[:, :, idx] == 1)\n          if len(resource_positions) > 0:\n              distances = [abs(rp[0] - state.pos[0]) + abs(rp[1] - state.pos[1]) for rp in resource_positions]\n              min_distance = min(min_distance, min(distances))\n      \n      # If no resources are found, return a large distance\n      if min_distance == float('inf'):\n          min_distance = grid_size\n      \n      return min_distance\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(0 + heuristic(start_state, goal_arg), start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[0])\n      open_set.remove((_, current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          open_set.append((estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:51:46.794563", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              # Create a hashable representation of the state\n              state_hash = (tuple(next_state.grid.flatten()), \n                            tuple(next_state.inventory), \n                            next_state.pos, \n                            next_state.dir)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:56:02.745409", "function_name": "craft", "function_body": "  from collections import deque\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if is_reachable(current_state) and current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Prune unreachable actions\n      for action in prune_unreachable_actions(current_state):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def prune_unreachable_actions(current_state):\n    \"\"\"Prune actions that lead to unreachable states.\"\"\"\n    reachable_actions = []\n    \n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      \n      if is_reachable(next_state) and not has_exceeded_inventory_limits(next_state):\n        reachable_actions.append(action)\n    \n    return reachable_actions\n\n  def is_reachable(state):\n    \"\"\"Check if the state can be reached with the current resources.\"\"\"\n    # Check inventory constraints\n    for kind in env.world.non_grabbable_indices:\n      if state.inventory[kind] > 0:\n        return False\n    \n    # Check grid constraints (e.g., not stepping into walls)\n    x, y = state.pos\n    dir_ = state.dir\n    next_x, next_y = x + DIRECTIONS[dir_][0], y + DIRECTIONS[dir_][1]\n    \n    if 0 <= next_x < env.world.grid.shape[0] and 0 <= next_y < env.world.grid.shape[1]:\n      for kind in env.world.non_grabbable_indices:\n        if state.grid[next_x, next_y, kind] > 0:\n          return False\n    \n    return True\n\n  def has_exceeded_inventory_limits(state):\n    \"\"\"Check if the inventory exceeds any limits.\"\"\"\n    # Example: limit each item to a certain count\n    MAX_INVENTORY = 10\n    \n    for count in state.inventory:\n      if count > MAX_INVENTORY:\n        return True\n    \n    return False\n  \n  # Define direction changes for each action\n  DIRECTIONS = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T05:56:03.746791", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def prune_unreachable_actions(current_state):\n      \"\"\"Prune actions that lead to unreachable states.\"\"\"\n      reachable_actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          \n          if is_reachable(next_state):\n              reachable_actions.append(action)\n      \n      return reachable_actions\n\n  def is_reachable(state):\n      \"\"\"Check if the state can be reached with the current resources.\"\"\"\n      # Check inventory constraints\n      for kind in env.world.non_grabbable_indices:\n          if state.inventory[kind] > 0:\n              return False\n      \n      # Check grid constraints (e.g., not stepping into walls)\n      x, y = state.pos\n      dir_ = state.dir\n      next_x, next_y = x + DIRECTIONS[dir_][0], y + DIRECTIONS[dir_][1]\n      \n      if 0 <= next_x < env.world.grid.shape[0] and 0 <= next_y < env.world.grid.shape[1]:\n          for kind in env.world.non_grabbable_indices:\n              if state.grid[next_x, next_y, kind] > 0:\n                  return False\n      \n      return True\n\n  def heuristic(state, goal_arg):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n      # Simple heuristic: number of required items not yet in inventory\n      required_items = env.world.cookbook.primitives_for(goal_arg)\n      missing_items_count = sum(required_items[kind] - state.inventory[kind] for kind in required_items)\n      return missing_items_count\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search for the shortest sequence of actions to achieve the goal.\"\"\"\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, start_state, []))  # (f_score, state, actions_taken)\n      came_from = {}\n      g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n      \n      while open_set:\n          _, current_state, actions_taken = heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return reconstruct_path(came_from, current_state, actions_taken)\n          \n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[next_state] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                  heappush(open_set, (f_score, next_state, actions_taken + [action]))\n      \n      return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      \"\"\"Reconstruct the path from the start state to the goal state.\"\"\"\n      total_actions = []\n      while current_state in came_from:\n          previous_state = came_from[current_state]\n          for action in range(env.world.n_actions):\n              _, next_state = previous_state.step(action)\n              if np.array_equal(next_state.grid, current_state.grid) and \\\n                 np.array_equal(next_state.inventory, current_state.inventory) and \\\n                 next_state.pos == current_state.pos and \\\n                 next_state.dir == current_state.dir:\n                  total_actions.append(action)\n                  break\n          current_state = previous_state\n      \n      return list(reversed(total_actions))\n\n  # Define direction changes for each action\n  DIRECTIONS = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T05:57:36.070889", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T05:57:37.191203", "function_name": "craft", "function_body": "  # Helper function to create a state hash for BFS\n  def state_hash(state):\n      return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          _, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:00:00.190035", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_name, goal_arg):\n    \"\"\"Heuristic function to estimate the cost to reach the goal.\"\"\"\n    # For now, a simple heuristic: count of items needed but not in inventory\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_arg)\n    \n    missing_items_count = 0\n    for i_kind, count in primitives_needed.items():\n      if state.inventory[i_kind] < count:\n        missing_items_count += count - state.inventory[i_kind]\n    \n    return missing_items_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm.\"\"\"\n    open_set = [(0 + heuristic(start_state, goal_name, goal_arg), start_state, [])]\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    \n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[0])\n      open_set.remove((_, current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = current_state\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_name, goal_arg)\n          open_set.append((f_score, next_state, actions_taken + [action]))\n    \n    return None\n\n  def reconstruct_path(came_from, current):\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n    return total_path[-1].actions_taken if total_path else []\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T06:00:01.281074", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:02:17.138521", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def astar(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), 0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_cost, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (tuple(state.features()), actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, tentative_g_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n      total_path = []\n      while tuple(current.features()) in came_from:\n          (current, action) = came_from[tuple(current.features())]\n          total_path.append(action[-1])\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:02:18.127667", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def a_star(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    came_from = {}\n    \n    while open_set:\n      _, current, actions = heappop(open_set)\n      \n      if current.satisfies(\"\", goal):\n        path = []\n        while current in came_from:\n          path.append(actions[-1])\n          current, actions = came_from[current]\n        return path[::-1]  # Reverse the path to get it from start to end\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current.step(action)\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:03:48.923952", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:03:49.978353", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # If the inventory changes, prioritize these states\n          if np.any(new_state.inventory != state.inventory):\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:04:54.884240", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:04:56.057370", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(range(env.world.n_actions)):\n        if action == USE and not state.next_to(goal): \n            continue  # Skip USE if the goal item is not next to the agent\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:08:08.103801", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a unique hash of the state to check if it has been visited\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n    # Simple heuristic: count of required items minus available items\n    primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n    inventory_count = {idx: count for idx, count in enumerate(current_state.inventory) if idx in primitives_needed}\n    \n    missing_items = sum(primitives_needed.get(idx, 0) - inventory_count.get(idx, 0) for idx in primitives_needed)\n    return max(1, missing_items)\n\n  def astar(start_state, goal_arg):\n    \"\"\"A* search algorithm to find the optimal sequence of actions.\"\"\"\n    open_set = [(start_state, [], heuristic(start_state, goal_arg))]\n    visited_states = set()\n\n    while open_set:\n      current_state, actions_taken, _ = min(open_set, key=lambda x: x[2])\n      open_set.remove((current_state, actions_taken, _))\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      state_hash = (tuple(current_state.grid.flatten()), \n                    tuple(current_state.inventory), \n                    current_state.pos, \n                    current_state.dir)\n      \n      if state_hash in visited_states:\n        continue\n      \n      visited_states.add(state_hash)\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a unique hash of the state to check if it has been visited\n        next_state_hash = (tuple(next_state.grid.flatten()), \n                           tuple(next_state.inventory), \n                           next_state.pos, \n                           next_state.dir)\n        \n        if next_state_hash not in visited_states:\n          actions_sequence = actions_taken + [action]\n          g_score = len(actions_sequence)  # Cost from start to current state\n          h_score = heuristic(next_state, goal_arg)  # Estimated cost from current state to goal\n          f_score = g_score + h_score  # Total estimated cost\n          \n          open_set.append((next_state, actions_sequence, f_score))\n\n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the item index is valid\n  if item not in env.world.cookbook.index.contents.values():\n    raise ValueError(f\"Invalid item index {item}\")\n\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:08:09.170518", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the item index is valid\n  if item not in env.world.cookbook.index.contents.values():\n    raise ValueError(f\"Invalid item index {item}\")\n\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:09:55.919102", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Prune states where inventory or grid constraints are violated\n        if is_valid_state(next_state):\n          state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n            visited_states.add(state_hash)\n\n    return None\n\n  def is_valid_state(state):\n    \"\"\"Check if the state is valid based on inventory and grid constraints.\"\"\"\n    # Ensure inventory does not exceed maximum possible values\n    for i in range(len(state.inventory)):\n      if state.inventory[i] < 0:\n        return False\n    \n    # Ensure grid occupancy constraints are met (if applicable)\n    # Add more specific checks here if needed\n\n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:09:56.936106", "function_name": "craft", "function_body": "  def heuristic(state, goal_name, goal_arg):\n      \"\"\"Heuristic function for A* search.\"\"\"\n      # Simple heuristic: number of items missing from the inventory\n      required = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory\n      return sum(required.get(primitive, 0) - current_inventory[primitive] for primitive in required)\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_name, goal_arg), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + start_state.pos + (start_state.dir,): 0}\n    \n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n          return actions_taken\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + next_state.pos + (next_state.dir,)\n        \n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,)] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = (tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,), action)\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_name, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n    \n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:10:52.100318", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:10:53.121439", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid infinite loops by checking if the inventory has changed meaningfully\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:13:05.268138", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n    # Heuristic function based on Manhattan distance from ingredients in the inventory\n    # and a simple penalty for carrying unnecessary items.\n    cookbook = env.world.cookbook\n    required_primitives = cookbook.primitives_for(goal_index)\n    \n    current_inventory = state.inventory\n    heuristic_value = 0\n    \n    for kind, count in required_primitives.items():\n      if current_inventory[kind] < count:\n        heuristic_value += (count - current_inventory[kind]) * 1.5  # Penalty for missing items\n      else:\n        heuristic_value -= (current_inventory[kind] - count) * 0.5  # Discount for extra items\n    \n    return heuristic_value\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm with heuristics to find the shortest path.\"\"\"\n    from heapq import heappop, heappush\n\n    open_set = [(heuristic(start_state, goal_arg), start_state, [])]\n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state, goal_arg)}\n\n    while open_set:\n      current_fscore, current_state, actions_taken = heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        tentative_g_score = g_score[current_state] + 1\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if tentative_g_score < g_score.get(next_state, float('inf')):\n          came_from[next_state] = (current_state, actions_taken + [action])\n          g_score[next_state] = tentative_g_score\n          f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n          heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current, path):\n    \"\"\"Reconstruct the path from start to goal.\"\"\"\n    while current in came_from:\n      prev_state, action_sequence = came_from[current]\n      path = action_sequence + path\n      current = prev_state\n    return path\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:13:06.232537", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Simple heuristic: count the number of missing ingredients in the inventory.\"\"\"\n      if state.satisfies('default', goal_index):\n          return 0\n      \n      # Get primitives required for the goal\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_index)\n      \n      # Calculate the difference between required and current inventory\n      missing_count = sum(primitives_needed.get(i, 0) - state.inventory[i] for i in primitives_needed.keys())\n      \n      return max(missing_count, 1)\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          heapq.heappush(open_set, (len(actions_taken) + heuristic(next_state, goal_arg), next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:14:18.782867", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:14:19.755822", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:15:39.314294", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:15:40.281746", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Check if the inventory has changed (indicates an item was picked up or used)\n        if np.any(next_state.inventory != current_state.inventory):\n          # Prioritize these actions by adding them to the front of the queue\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          if state_hash not in visited_states:\n            queue.insert(0, (next_state, actions_taken + [action]))\n        else:\n          # Otherwise, add them to the end of the queue\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n\n        visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:16:56.135225", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:16:57.272507", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:20:18.470881", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of items needed to craft the goal\n    goal_name = env.world.cookbook.index.get(goal)\n    primitives = env.world.cookbook.primitives_for(goal)\n    \n    if not primitives:\n      return float('inf')  # No recipe for this item\n    \n    current_inventory = state.inventory.copy()\n    steps_needed = 0\n    \n    while any(current_inventory[primitive] < count for primitive, count in primitives.items()):\n      min_steps_to_goal = float('inf')\n      \n      for candidate_item, candidate_recipe in env.world.cookbook.recipes.items():\n        if candidate_item == goal:\n          continue\n        \n        candidate_primitives = {key: val for key, val in candidate_recipe.items() if key != \"_key\"}\n        \n        # Check if we can craft this candidate item\n        if all(current_inventory[primitive] >= count for primitive, count in candidate_primitives.items()):\n          steps_to_goal = sum(candidate_recipe[primitive] - current_inventory[primitive] for primitive, count in candidate_primitives.items())\n          \n          if steps_to_goal < min_steps_to_goal:\n            min_steps_to_goal = steps_to_goal\n            \n            # Craft the candidate item\n            craft_actions = bfs(state, candidate_item)\n            \n            if craft_actions is not None:\n              for action in craft_actions:\n                reward, state = state.step(action)\n                steps_needed += 1 + len(craft_actions)  # Add one for USE action\n                \n              current_inventory[candidate_item] += 1\n              \n    return steps_needed\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state):\n    total_path = []\n    \n    while current_state in came_from:\n      previous_state, action = came_from[current_state]\n      total_path.append(action)\n      current_state = previous_state\n    \n    return total_path[::-1]\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:20:48.511525", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of items needed to craft the goal\n    goal_name = env.world.cookbook.index.get(goal)\n    primitives = env.world.cookbook.primitives_for(goal)\n\n    if not primitives:\n      return float('inf')  # No recipe for this item\n\n    current_inventory = state.inventory.copy()\n    steps_needed = 0\n\n    while any(current_inventory[primitive] < count for primitive, count in primitives.items()):\n      min_steps_to_goal = float('inf')\n      best_candidate_actions = None\n      best_new_state = None\n      \n      for candidate_item, candidate_recipe in env.world.cookbook.recipes.items():\n        if candidate_item == goal:\n          continue\n        \n        candidate_primitives = {key: val for key, val in candidate_recipe.items() if key != \"_key\"}\n        \n        # Check if we can craft this candidate item\n        if all(current_inventory[primitive] >= count for primitive, count in candidate_primitives.items()):\n          steps_to_goal = sum(candidate_recipe[primitive] - current_inventory[primitive] for primitive, count in candidate_primitives.items())\n          \n          if steps_to_goal < min_steps_to_goal:\n            min_steps_to_goal = steps_to_goal\n            \n            # Craft the candidate item\n            craft_actions = bfs(state, candidate_item)\n            \n            if craft_actions is not None:\n              new_state = state.copy()\n              for action in craft_actions:\n                reward, new_state = new_state.step(action)\n              \n              best_candidate_actions = craft_actions\n              best_new_state = new_state\n    \n      if best_candidate_actions and best_new_state:\n        steps_needed += 1 + len(best_candidate_actions)  # Add one for USE action\n        actions.extend(best_candidate_actions)\n        state = best_new_state\n        current_inventory[best_new_state.inventory.argmax()] += 1\n\n    return steps_needed\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = []\n  \n  while not start_state.satisfies(\"\", item):\n    crafting_actions = heuristic(start_state, item)\n    if crafting_actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n    actions.extend(crafting_actions)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:22:44.417021", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              if state_hash not in visited_states:\n                  # Prioritize actions that lead to a change in the inventory\n                  if np.any(next_state.inventory != current_state.inventory):\n                      queue.insert(0, (next_state, actions_taken + [action]))\n                  else:\n                      queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:22:45.407528", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Simple heuristic: count the number of missing items needed to craft the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n    inventory_counts = {i_kind: state.inventory[i_kind] for i_kind in primitives_needed}\n    \n    missing_count = 0\n    for prim, needed_count in primitives_needed.items():\n      if inventory_counts[prim] < needed_count:\n        missing_count += (needed_count - inventory_counts[prim])\n    \n    return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for the shortest sequence of actions to achieve the goal.\"\"\"\n    open_set = [(0, start_state, [])]\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[0])\n      open_set.remove((f_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)], current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = (current_state, actions_taken)\n          g_score[state_hash] = tentative_g_score\n          f_score[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n          \n          open_set.append((f_score[state_hash], next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:24:10.408149", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state has been visited or if it's invalid (no change)\n        if tuple(new_state.features()) not in visited and new_state != state:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:24:11.371798", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    \"\"\"Heuristic function based on the number of primitives needed to craft the item.\"\"\"\n    goal_count = env.world.cookbook.primitives_for(item)\n    inventory_count = {i_kind: state.inventory[i_kind] for i_kind in goal_count}\n    \n    # Calculate the number of additional steps needed\n    steps_needed = 0\n    for i_kind, count in goal_count.items():\n      steps_needed += max(0, count - inventory_count.get(i_kind, 0))\n    \n    return steps_needed\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:25:16.041722", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:25:17.025414", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = hash_state(next_state)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:27:05.090870", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:27:06.078624", "function_name": "craft", "function_body": "  def heuristic(state, goal_item):\n    \"\"\"A simple heuristic based on the number of missing items in the inventory.\"\"\"\n    missing_items = env.world.cookbook.primitives_for(goal_item)\n    current_inventory = state.inventory\n\n    # Count how many primitives are still needed\n    missing_count = sum(missing_items.get(i_kind, 0) - current_inventory[i_kind] for i_kind in missing_items)\n    return max(0, missing_count)\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state)\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n\n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = current_state\n          g_score[state_hash] = tentative_g_score\n          f_score[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[state_hash], next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current):\n    \"\"\"Reconstruct the path from start to current.\"\"\"\n    total_path = []\n    \n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n      \n    total_path.reverse()\n    actions = []\n    for i in range(1, len(total_path)):\n      for action in range(env.world.n_actions):\n        _, next_state = total_path[i - 1].step(action)\n        if np.array_equal(next_state.grid, total_path[i].grid) and \\\n           np.array_equal(next_state.inventory, total_path[i].inventory) and \\\n           next_state.pos == total_path[i].pos and \\\n           next_state.dir == total_path[i].dir:\n          actions.append(action)\n          break\n    return actions\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:28:32.366657", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to estimate cost from state to goal.\"\"\"\n      current_inventory = state.inventory\n      goal_item_count = current_inventory[goal]\n      \n      # Penalize states where the goal item count is less than in the start state\n      penalty = 0 if goal_item_count >= 1 else -1\n      \n      return penalty\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n    total_path = []\n    while current in came_from:\n      (prev, action) = came_from[current]\n      total_path.append(action)\n      current = prev\n    return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:28:33.412959", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate possible next states\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          # Use heuristic to prioritize actions that move towards the goal\n          if env._get_reward() > 0:\n            queue.appendleft((new_state, actions + [action]))  # Prioritize better states\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:30:10.393399", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n      import heapq\n\n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_scores = {start_state: 0}\n      came_from = {}\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              path = []\n              while current_state in came_from:\n                  path.append(actions_taken[-1])\n                  current_state, actions_taken = came_from[current_state]\n              return path[::-1]\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              tentative_g_score = g_scores[current_state] + 1\n\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n              if next_state not in g_scores or tentative_g_score < g_scores[next_state]:\n                  came_from[next_state] = (current_state, actions_taken)\n                  g_scores[next_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      # Simple heuristic: number of steps already taken\n      # You can implement a more sophisticated heuristic here\n      return len(current_state.inventory) - current_state.inventory[goal_arg]\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:30:11.391847", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n      from queue import PriorityQueue\n\n      open_set = PriorityQueue()\n      open_set.put((0, start_state, []))\n      \n      g_score = {start_state: 0}\n      came_from = {}\n\n      while not open_set.empty():\n          _, current_state, actions_taken = open_set.get()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return reconstruct_path(came_from, current_state, actions_taken)\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n\n              if next_state not in g_score or tentative_g_score < g_score[next_state]:\n                  came_from[state_hash] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                  open_set.put((f_score, next_state, actions_taken + [action]))\n\n      return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = [current_state]\n      total_actions = [actions_taken]\n\n      while (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir) in came_from:\n          current_state = came_from[(tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)]\n          actions_taken = actions_taken[:-1]\n          total_path.append(current_state)\n          total_actions.append(actions_taken)\n\n      return list(reversed(total_actions[-1]))\n\n  def heuristic(state, goal_arg):\n      # Heuristic: number of items needed to craft the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory\n      missing_items_count = sum(max(0, primitives_needed.get(i_kind, 0) - current_inventory[i_kind]) for i_kind in primitives_needed)\n      return missing_items_count\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:31:19.261053", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if action == USE and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n      \n      # Sort the queue based on heuristic\n      queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]))))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:31:20.244668", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = []\n      while current_state in came_from:\n          current_state, actions = came_from[current_state]\n          total_path.append(actions[-1])\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:33:11.621047", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Hash the current state for visited states set.\"\"\"\n    grid_hash = tuple(state.grid.flatten())\n    inventory_hash = tuple(state.inventory)\n    pos_dir_hash = (state.pos[0], state.pos[1], state.dir)\n    return hash(grid_hash + inventory_hash + pos_dir_hash)\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = hash_state(next_state)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:33:12.607920", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state):\n      # Heuristic function to estimate the cost from the current state to the goal\n      # Here we use a simple heuristic: number of items needed minus those already in inventory\n      required_items = env.world.cookbook.primitives_for(item)\n      current_inventory = state.inventory\n      missing_items = sum(required_items[i] - current_inventory[i] for i in required_items if current_inventory[i] < required_items[i])\n      return missing_items\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        tentative_g_score = g_score[current_state] + 1\n        \n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        next_state_key = (state_hash, next_state)\n\n        if next_state_key not in g_score or tentative_g_score < g_score[next_state_key]:\n          came_from[next_state_key] = (current_state, actions_taken)\n          g_score[next_state_key] = tentative_g_score\n          f_score[next_state_key] = tentative_g_score + heuristic(next_state)\n          heapq.heappush(open_set, (f_score[next_state_key], next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = []\n      state_hash = hash(tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,))\n      current_key = (state_hash, current_state)\n      \n      while current_key in came_from:\n          previous_state, previous_actions = came_from[current_key]\n          total_path = [previous_actions[-1]] + total_path\n          state_hash = hash(tuple(previous_state.grid.flatten()) + tuple(previous_state.inventory) + (previous_state.pos,) + (previous_state.dir,))\n          current_key = (state_hash, previous_state)\n      \n      return actions_taken + total_path\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:34:29.666843", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: Manhattan distance between current inventory and goal item\n    return np.sum(np.abs(state.inventory - (np.zeros_like(state.inventory) + int(state.world.cookbook.index.get(item, -1)))))\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n      from heapq import heappush, heappop\n\n      open_set = []\n      heappush(open_set, (0, start_state, []))\n      visited = set([tuple(start_state.features())])\n      \n      while open_set:\n          _, state, actions = heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = state.step(action)\n              \n              # Avoid revisiting the same state and prioritize states with changes in inventory\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  g_score = len(actions) + 1  # Cost from start to current node\n                  h_score = heuristic(new_state, goal)  # Heuristic cost estimate\n                  f_score = g_score + h_score\n                  \n                  heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:34:30.646998", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the difference in inventory counts for the goal item\n    return abs(goal - np.sum(state.inventory))\n\n  def astar(start_state, goal):\n      \"\"\"A* Search to find the shortest path with a heuristic.\"\"\"\n      from heapq import heappush, heappop\n\n      open_set = []\n      heappush(open_set, (0, start_state, []))\n      visited = set([tuple(start_state.features())])\n\n      while open_set:\n          _, state, actions = heappop(open_set)\n\n          if state.satisfies(\"\", goal):\n              return actions\n\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = state.step(action)\n\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  cost = len(actions) + heuristic(new_state, goal)\n                  heappush(open_set, (cost, new_state, actions + [action]))\n\n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:35:45.244095", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.pop(0)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:35:46.341814", "function_name": "craft", "function_body": "  def state_hash(state):\n      return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:36:48.412054", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n      action_priority = {4: -1}  # Prioritize USE action\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  # Assign priority to the USE action\n                  priority = action_priority.get(action, 0)\n                  queue.append((next_state, actions_taken + [action]))\n                  queue.sort(key=lambda x: (len(x[1]) + priority), reverse=True)\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:36:49.395671", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          # Prioritize actions that lead to a change in the inventory\n          if np.any(next_state.inventory != current_state.inventory):\n            queue.insert(0, (next_state, actions_taken + [action]))\n          else:\n            queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:39:51.688035", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(state, goal_arg):\n    \"\"\"Check if the given state can lead to the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n    \n    # Collect all required primitives and their counts\n    missing_primitives = {ingredient: count - state.inventory[ingredient] for ingredient, count in primitives.items() if count > state.inventory[ingredient]}\n    \n    # Check if the grid can provide the missing primitives\n    for ingredient, count in missing_primitives.copy().items():\n      available_on_grid = np.sum(state.grid[:, :, ingredient])\n      if available_on_grid >= count:\n        del missing_primitives[ingredient]\n      else:\n        missing_primitives[ingredient] -= available_on_grid\n    \n    # If there are still missing primitives, check if they can be crafted\n    for ingredient in list(missing_primitives.keys()):\n      sub_primitives = cookbook.primitives_for(ingredient)\n      if not sub_primitives:  # Primitive cannot be crafted\n        return False\n      \n      # Recursively check if the sub-primitives required to craft this ingredient are reachable\n      missing_sub_primitives = {sub_ingredient: count - state.inventory[sub_ingredient] for sub_ingredient, count in sub_primitives.items() if count > state.inventory[sub_ingredient]}\n      \n      # Check grid availability for sub-primitives\n      for sub_ingredient, count in missing_sub_primitives.copy().items():\n        available_on_grid = np.sum(state.grid[:, :, sub_ingredient])\n        if available_on_grid >= count:\n          del missing_sub_primitives[sub_ingredient]\n        else:\n          missing_sub_primitives[sub_ingredient] -= available_on_grid\n      \n      # If there are still missing sub-primitives, recurse\n      for sub_ingredient in list(missing_sub_primitives.keys()):\n        if not is_reachable(state, sub_ingredient):\n          return False\n    \n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:40:21.732621", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(start_state, goal_arg):\n    \"\"\"Check if the given state can lead to the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n\n    # Check if all required primitives are available in the inventory or on the grid\n    for ingredient, count in primitives.items():\n      if start_state.inventory[ingredient] < count:\n        # Check if the ingredient is available on the grid\n        if not any(start_state.grid[:, :, ingredient].flatten()):\n          return False\n\n    return True\n\n  def can_craft(state, goal_arg):\n    \"\"\"Check if all required ingredients for the goal item are available.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n\n    for ingredient, count in primitives.items():\n      if state.inventory[ingredient] < count:\n        return False\n\n    return True\n\n  def collect_primitives(state, goal_arg):\n    \"\"\"Generate actions to collect all required primitives for the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n    actions = []\n\n    for ingredient, count in primitives.items():\n      while state.inventory[ingredient] < count:\n        # Find a cell containing the ingredient\n        x, y = np.argwhere(state.grid[:, :, ingredient]).tolist()[0]\n        \n        # Move to the cell with the ingredient\n        actions.extend(move_to_cell(state, (x, y)))\n        \n        # Pick up the ingredient\n        actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n        reward, state = state.step(actions[-1])\n\n    return actions\n\n  def move_to_cell(state, target_pos):\n    \"\"\"Generate actions to move from current position to target position.\"\"\"\n    start_x, start_y = state.pos\n    target_x, target_y = target_pos\n    actions = []\n\n    # Move horizontally\n    if start_x < target_x:\n      actions.extend([0] * (target_x - start_x))  # DOWN\n    elif start_x > target_x:\n      actions.extend([1] * (start_x - target_x))  # UP\n\n    # Move vertically\n    if start_y < target_y:\n      actions.extend([2] * (target_y - start_y))  # LEFT\n    elif start_y > target_y:\n      actions.extend([3] * (start_y - target_y))  # RIGHT\n\n    return actions\n\n  def craft_item(state, goal_arg):\n    \"\"\"Generate actions to craft the item once all primitives are collected.\"\"\"\n    actions = [env.world.n_actions - 1]  # Assuming USE is the last action\n    reward, state = state.step(actions[-1])\n    return actions\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if not is_reachable(start_state, goal_arg):\n    raise ValueError(f\"Goal item {item} is not reachable from the initial state.\")\n\n  actions = []\n  while not can_craft(start_state, goal_arg):\n    actions.extend(collect_primitives(start_state, goal_arg))\n    start_state = env._current_state\n\n  # Craft the final item\n  actions.extend(craft_item(start_state, goal_arg))\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:41:46.306512", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:41:47.325190", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      \"\"\"Heuristic function to estimate the cost from current_state to the goal.\"\"\"\n      # Simple heuristic: count how many of the required items are still missing\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      total_missing = sum(primitives.get(i_kind, 0) for i_kind in primitives if current_state.inventory[i_kind] < primitives[i_kind])\n      return total_missing\n\n  def astar(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      open_set = [(heuristic(start_state, goal_arg), start_state, [])]\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  heapq.heappush(open_set, (heuristic(next_state, goal_arg) + len(actions_taken), next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:42:50.796182", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          if action == USE:\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:42:51.849607", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:43:47.705327", "function_name": "craft", "function_body": "  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, next_state = state.step(action)\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          neighbors.append((action, next_state, state_hash))\n      return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state, state_hash in get_neighbors(current_state):\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:43:48.833100", "function_name": "craft", "function_body": "  # Helper function to get the name of an item from its index\n  def index_to_name(index):\n      for key, val in env.world.cookbook.index.contents.items():\n          if val == index:\n              return key\n      raise ValueError(f\"No item found with index {index}\")\n\n  def bfs(start_state, goal_index):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.inventory[goal_index] > 0:\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = bfs(start_state, goal_index)\n  \n  if action_sequence is not None:\n      print(f\"Actions to craft {index_to_name(goal_index)}: {action_sequence}\")\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:45:02.467401", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Hash the current state for visited states set.\"\"\"\n      grid_hash = tuple(state.grid.flatten())\n      inventory_hash = tuple(state.inventory)\n      pos_dir_hash = (state.pos[0], state.pos[1], state.dir)\n      return hash(grid_hash + inventory_hash + pos_dir_hash)\n\n  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              state_hash = hash_state(next_state)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:45:03.479280", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Hash the current state for visited states set.\"\"\"\n    grid_hash = tuple(state.grid.flatten())\n    inventory_hash = tuple(state.inventory)\n    pos_dir_hash = (state.pos[0], state.pos[1], state.dir)\n    return hash(grid_hash + inventory_hash + pos_dir_hash)\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = hash_state(next_state)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:46:40.714397", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Try to find the shortest path to collect primitives first\n  primitives = env.world.cookbook.primitives_for(item)\n  \n  actions_to_collect_primitives = []\n  for primitive_index in primitives:\n      if state.inventory[primitive_index] < primitives[primitive_index]:\n          sub_actions = bfs(start_state, primitive_index)\n          if sub_actions is None:\n              raise ValueError(f\"No path to collect the primitive index {primitive_index} found.\")\n          actions_to_collect_primitives.extend(sub_actions)\n          # Update start_state after collecting each primitive\n          for action in sub_actions:\n              reward, start_state = start_state.step(action)\n\n  # Now find the shortest path to craft the item\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions_to_collect_primitives + final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:46:41.682195", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function for A*.\"\"\"\n    # Here we use a simple heuristic based on inventory differences.\n    current_inventory = state.inventory\n    goal_inventory = np.zeros_like(current_inventory)\n    goal_inventory[goal] = 1\n    \n    # Calculate the Manhattan distance between current and goal inventories.\n    return np.sum(np.abs(current_inventory - goal_inventory))\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state, goal), start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:48:07.872303", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  def prioritize_movement(action_sequence):\n    \"\"\"Prioritize movement actions to reach nearby items.\"\"\"\n    prioritized_actions = []\n    for action in action_sequence:\n        if action != USE:\n            prioritized_actions.append(action)\n    for action in action_sequence:\n        if action == USE:\n            prioritized_actions.append(action)\n    return prioritized_actions\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  # Prioritize movement actions in the sequence\n  return prioritize_movement(actions)", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-06-25T06:48:08.837065", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states where an item was used or added to inventory\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:49:27.044778", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and prioritize states with changes in inventory\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Priority based on inventory change\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:49:28.126419", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and states with changes in inventory\n      next_states = []\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Prioritize states where an item was used or added to inventory\n              priority = 0\n              if action == USE:\n                  priority += 1\n              if np.any(new_state.inventory != state.inventory):\n                  priority += 2\n                  \n              next_states.append((new_state, actions + [action], priority))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: -x[2])\n      for new_state, new_actions, _ in next_states:\n          queue.appendleft((new_state, new_actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:51:27.323901", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in prune_unreachable_actions(current_state):\n        reward, next_state = current_state.step(action)\n        state_hash = hash(next_state)  # Use a hash function to represent the state\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def prune_unreachable_actions(current_state):\n    \"\"\"Prune actions that lead to unreachable states.\"\"\"\n    reachable_actions = []\n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      \n      if is_reachable(next_state):\n        reachable_actions.append(action)\n    \n    return reachable_actions\n\n  def is_reachable(state):\n    \"\"\"Check if the state can be reached with the current resources.\"\"\"\n    # Implement a heuristic or constraint check here\n    # For now, assume all states are reachable if inventory and grid constraints are met\n    return True\n\n  def hash(state):\n    \"\"\"Hash function to represent the state uniquely.\"\"\"\n    return (tuple(state.grid.flatten()), tuple(state.inventory), state.pos, state.dir)\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:51:28.395238", "function_name": "craft", "function_body": "  # Define constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in prune_unreachable_actions(current_state):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def prune_unreachable_actions(current_state):\n    \"\"\"Prune actions that lead to unreachable states.\"\"\"\n    reachable_actions = []\n    \n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      \n      if is_reachable(next_state) and not is_stuck(next_state, action):\n        reachable_actions.append(action)\n    \n    return reachable_actions\n\n  def is_reachable(state):\n    \"\"\"Check if the state can be reached with the current resources.\"\"\"\n    # Ensure inventory does not exceed maximum possible values\n    for i in range(len(state.inventory)):\n      if state.inventory[i] < 0:\n        return False\n    \n    # Ensure grid occupancy constraints are met (if applicable)\n    # Add more specific checks here if needed\n\n    return True\n\n  def is_stuck(state, action):\n    \"\"\"Check if the action leads to a stuck state.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n\n    # If moving in a direction that doesn't change position, it's not stuck\n    if action != DOWN and action != UP and action != LEFT and action != RIGHT:\n      return False\n    \n    # Check if the next move is blocked by an obstacle or non-grabbable entity\n    new_pos = list(pos)\n    if dir_ == 0:  # Facing down\n      new_pos[1] += 1\n    elif dir_ == 1:  # Facing up\n      new_pos[1] -= 1\n    elif dir_ == 2:  # Facing left\n      new_pos[0] -= 1\n    elif dir_ == 3:  # Facing right\n      new_pos[0] += 1\n    \n    if (not is_within_bounds(new_pos, state.grid.shape)) or (state.grid[new_pos[0], new_pos[1]].argmax() in env.world.non_grabbable_indices):\n      return True\n\n    return False\n\n  def is_within_bounds(pos, grid_shape):\n    \"\"\"Check if the position is within the grid bounds.\"\"\"\n    width, height = grid_shape[:2]\n    x, y = pos\n    return 0 <= x < width and 0 <= y < height\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:52:40.013783", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Priority based on inventory change\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:52:40.999080", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Priority based on inventory change\n          priority = 0\n          if action == USE:\n              priority += 1\n          if np.any(new_state.inventory != state.inventory):\n              priority += 2\n              \n          queue.append((new_state, actions + [action]))\n          # Move the new state to the front of the queue based on priority\n          queue = deque(sorted(queue, key=lambda x: -x[0].inventory.sum() - priority))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:54:34.793306", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Simple heuristic based on Manhattan distance to the nearest required resource.\"\"\"\n      # Count missing items in inventory\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      \n      min_distance = float('inf')\n      grid_size = state.grid.shape[0] * state.grid.shape[1]\n      \n      # Calculate distance to nearest missing item\n      for idx in missing_items:\n          resource_positions = np.argwhere(state.grid[:, :, idx] == 1)\n          if len(resource_positions) > 0:\n              distances = [abs(rp[0] - state.pos[0]) + abs(rp[1] - state.pos[1]) for rp in resource_positions]\n              min_distance = min(min_distance, min(distances))\n      \n      # If no resources are found, return a large distance\n      if min_distance == float('inf'):\n          min_distance = grid_size\n      \n      return min_distance\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:54:36.978539", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      \"\"\"Heuristic based on Manhattan distance and required resources.\"\"\"\n      missing_items = [idx for idx, count in enumerate(state.inventory) if state.world.cookbook.primitives_for(goal_index).get(idx, 0) > count]\n      \n      min_distance = float('inf')\n      grid_size = state.grid.shape[0] * state.grid.shape[1]\n      \n      # Calculate distance to nearest missing item\n      for idx in missing_items:\n          resource_positions = np.argwhere(state.grid[:, :, idx] == 1)\n          if len(resource_positions) > 0:\n              distances = [abs(rp[0] - state.pos[0]) + abs(rp[1] - state.pos[1]) for rp in resource_positions]\n              min_distance = min(min_distance, min(distances))\n      \n      # If no resources are found, return a large distance\n      if min_distance == float('inf'):\n          min_distance = grid_size\n      \n      return len(missing_items) * grid_size + min_distance\n\n  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    open_set = [(0 + heuristic(start_state, goal_arg), start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = min(open_set, key=lambda x: x[0])\n      open_set.remove((_, current_state, actions_taken))\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          cost = len(actions_taken) + 1\n          estimated_cost = cost + heuristic(next_state, goal_arg)\n          open_set.append((estimated_cost, next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:55:52.815650", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment and scenario\n  env.reset()\n  \n  try:\n      start_scenario = env.scenario\n  except AttributeError:\n      raise ValueError(\"The environment does not have a scenario attribute. Make sure to initialize it properly.\")\n      \n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T06:55:53.794628", "function_name": "craft", "function_body": "  def bfs_with_pruning(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search with pruning for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    import heapq\n\n    # Priority queue with depth as priority (lower is better)\n    queue = [(0, start_state, [])]\n    visited_states = set()\n\n    while queue:\n      depth, current_state, actions_taken = heapq.heappop(queue)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          heapq.heappush(queue, (depth + 1, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  \n  try:\n      start_scenario = env.scenario\n  except AttributeError:\n      raise ValueError(\"The environment does not have a scenario attribute. Make sure to initialize it properly.\")\n      \n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs_with_pruning(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:58:11.709862", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:58:12.708510", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (not any(new_state.grid[state.pos[0]+dx][state.pos[1]+dy].any() \n                     for dx in [-1, 0, 1] for dy in [-1, 0, 1]) and\n            tuple(new_state.features()) not in visited):\n          visited.add(tuple(new_state.features()))\n          \n          # Prioritize states with progress towards crafting\n          if action == USE and new_state.inventory[goal] > state.inventory[goal]:\n            queue.appendleft((new_state, actions + [action]))\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_initial_resources(env):\n      \"\"\"Gather initial resources available on the grid.\"\"\"\n      grid = env._current_state.grid\n      resources = {}\n      \n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              kind_index = np.argmax(grid[i, j])\n              if kind_index in env.world.grabbable_indices:\n                  if kind_index not in resources:\n                      resources[kind_index] = 0\n                  resources[kind_index] += 1\n      \n      return resources\n\n  def gather_initial_resources(env):\n    \"\"\"Gather initial resources available on the grid.\"\"\"\n    grid = env._current_state.grid\n    resources = {}\n    \n    for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n            kind_index = np.argmax(grid[i, j])\n            if kind_index in env.world.grabbable_indices:\n                if kind_index not in resources:\n                    resources[kind_index] = 0\n                resources[kind_index] += 1\n    \n    return resources\n\n  def gather_resources(actions):\n      \"\"\"Simulate gathering resources based on the actions taken.\"\"\"\n      current_state = env._current_state\n      gathered_resources = {}\n      \n      for action in actions:\n          reward, new_state = current_state.step(action)\n          \n          # Check if any resource was picked up\n          for kind_index in env.world.grabbable_indices:\n              if new_state.inventory[kind_index] > current_state.inventory[kind_index]:\n                  if kind_index not in gathered_resources:\n                      gathered_resources[kind_index] = 0\n                  gathered_resources[kind_index] += (new_state.inventory[kind_index] - current_state.inventory[kind_index])\n          \n          current_state = new_state\n      \n      return gathered_resources\n\n  def is_possible_to_craft(primitives, primitives_required):\n    \"\"\"Check if the available primitives are sufficient to craft the goal item.\"\"\"\n    for primitive, count in primitives_required.items():\n        if primitives.get(primitive, 0) < count:\n            return False\n    return True\n\n  start_state = env._current_state\n  initial_resources = gather_initial_resources(env)\n  \n  # Get primitives required for the goal item\n  cookbook = env.world.cookbook\n  primitives_required = cookbook.primitives_for(item)\n\n  if not is_possible_to_craft(initial_resources, primitives_required):\n    raise ValueError(\"Initial resources are insufficient to craft the item.\")\n\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:59:23.578460", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of items needed\n    return len(env.world.cookbook.primitives_for(goal)) - sum(state.inventory)\n\n  def a_star(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = []\n      while tuple(current_state.features()) in came_from:\n          current_state, actions = came_from[tuple(current_state.features())]\n          total_path.append(actions[-1])\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T06:59:24.601593", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:00:38.085613", "function_name": "craft", "function_body": "  def state_hash(state):\n      return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, next_state))\n      return actions\n\n  # Breadth-first search with early termination and heuristic\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  # Heuristic: Prioritize states that have more of the desired item\n                  priority = -next_state.inventory[goal_arg]\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:00:39.147242", "function_name": "craft", "function_body": "  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              yield action, next_state\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = tuple(next_state.grid.flatten()) + \\\n                         tuple(next_state.inventory) + \\\n                         (next_state.pos,) + \\\n                         (next_state.dir,)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:02:51.244782", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:02:52.220432", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from state to reach the goal.\"\"\"\n    # Simple heuristic: distance between agent's position and nearest required ingredient\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n    \n    if not primitives:\n      return 0\n    \n    min_distance = float('inf')\n    for i_kind, count in primitives.items():\n      if state.inventory[i_kind] >= count:\n        continue\n      \n      required_count = count - state.inventory[i_kind]\n      # Find nearest cell with the required item\n      positions = np.argwhere(state.grid[:, :, i_kind])\n      if len(positions) == 0:\n        return min_distance  # No such item on grid, assume high cost\n      \n      for pos in positions:\n        distance = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n    \n    return min_distance\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal with a heuristic.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[state_hash] + 1\n        \n        if next_hash not in g_score or tentative_g_score < g_score[next_hash]:\n          came_from[next_hash] = current_state, action\n          g_score[next_hash] = tentative_g_score\n          f_score[next_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[next_hash], next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    \"\"\"Reconstructs the path from start to current state.\"\"\"\n    total_actions = []\n    while (parent_state, action) in came_from:\n      total_actions.insert(0, action)\n      current_state, _ = came_from[(tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,))]\n    \n    return total_actions + actions_taken\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:03:53.160683", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:03:54.258289", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_neighbors(pos):\n      \"\"\"Get valid neighboring positions within the grid.\"\"\"\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      width, height = env.world.scenario.init_grid.shape[:2]\n      return [(nx, ny) for nx, ny in directions if 0 <= nx < width and 0 <= ny < height]\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:05:04.516132", "function_name": "craft", "function_body": "  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n      reward, next_state = state.step(action)\n      state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n      neighbors.append((action, next_state, state_hash))\n    return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state, state_hash in get_neighbors(current_state):\n        if state_hash not in visited_states:\n          # Prioritize actions that lead to a change in the inventory\n          if np.any(next_state.inventory != current_state.inventory):\n            queue.appendleft((next_state, actions_taken + [action]))\n          else:\n            queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
