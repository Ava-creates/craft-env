found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:42:11.373554", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def prune_unreachable_actions(current_state):\n      \"\"\"Prune actions that lead to unreachable states.\"\"\"\n      reachable_actions = []\n      for action in range(env.world.n_actions):\n          _, next_state = current_state.step(action)\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          # Check if the next state is reachable based on the current inventory\n          if is_reachable(next_state):\n              reachable_actions.append(action)\n      return reachable_actions\n\n  def is_reachable(state, goal_arg):\n      \"\"\"Check if the state can be reached with the current resources.\"\"\"\n      # Implement a heuristic or constraint check here\n      # For now, assume all states are reachable if inventory contains necessary items\n      required_items = env.world.cookbook.primitives_for(goal_arg)\n      \n      for i_kind, count in required_items.items():\n          if state.inventory[i_kind] < count:\n              return False\n      \n      return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:43:06.389705", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def prune_unreachable_actions(current_state):\n    \"\"\"Prune actions that lead to unreachable states.\"\"\"\n    reachable_actions = []\n    for action in range(env.world.n_actions):\n      _, next_state = current_state.step(action)\n      \n      # Check if the next state is reachable based on the current inventory\n      if is_reachable(next_state, goal_arg):\n        reachable_actions.append(action)\n    return reachable_actions\n\n  def is_reachable(state, goal_arg):\n    \"\"\"Check if the state can be reached with the current resources.\"\"\"\n    # Implement a heuristic or constraint check here\n    # For now, assume all states are reachable\n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:43:07.449211", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Prune unreachable actions\n      reachable_actions = prune_unreachable_actions(current_state)\n\n      for action in reachable_actions:\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def prune_unreachable_actions(current_state):\n    \"\"\"Prune actions that lead to unreachable states.\"\"\"\n    reachable_actions = []\n    for action in range(env.world.n_actions):\n      _, next_state = current_state.step(action)\n      \n      # Check if the next state is reachable based on the current inventory\n      if is_reachable(next_state, goal_arg):\n        reachable_actions.append(action)\n    return reachable_actions\n\n  def is_reachable(state, goal_arg):\n    \"\"\"Check if the state can be reached with the current resources.\"\"\"\n    # Implement a heuristic or constraint check here\n    # For now, assume all states are reachable\n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:46:45.908973", "function_name": "craft", "function_body": "  # Define constants for actions\n  ACTIONS = {\n      'UP': 0,\n      'DOWN': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  def bfs_shortest_path(graph, start, goal):\n    queue = [(start, [])]\n    visited = set()\n    \n    while queue:\n        current, path = queue.pop(0)\n        \n        if current == goal:\n            return path\n        \n        if current not in visited:\n            visited.add(current)\n            \n            for neighbor in graph.get(current, []):\n                if neighbor not in visited:\n                    new_path = path + [neighbor]\n                    queue.append((new_path[-1], new_path))\n                    \n    return None\n\n  def find_recipe(graph, goal_index):\n    paths = []\n    \n    for primitive in env.world.cookbook.primitives:\n        path = bfs_shortest_path(graph, primitive, goal_index)\n        if path:\n            paths.append(path)\n            \n    if not paths:\n        return None\n    \n    # Return the shortest path\n    return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path):\n    actions = []\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(output_index))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(item_index):\n      \"\"\"Collects an item by moving to it and using the action.\"\"\"\n      actions = []\n      \n      # Find positions of the item on the grid\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      if len(item_positions) == 0:\n          raise ValueError(f\"No {item_index} found on the grid.\")\n      \n      for pos in item_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([ACTIONS['DOWN']] * abs(dx))\n          elif dx < 0:\n              actions.extend([ACTIONS['UP']] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([ACTIONS['RIGHT']] * abs(dy))\n          elif dy < 0:\n              actions.extend([ACTIONS['LEFT']] * abs(dy))\n          \n          # Use the item\n          actions.append(ACTIONS['USE'])\n      \n      return actions\n\n  def craft_item(output_index):\n      \"\"\"Crafts an item at a workshop.\"\"\"\n      # Assuming that crafting is a single action (e.g., USE) when standing next to a workshop.\n      workshops = env.world.workshop_indices\n      \n      for workshop in workshops:\n          x, y = divmod(workshop, env._current_state.grid.shape[1])\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([ACTIONS['DOWN']] * abs(dx))\n          elif dx < 0:\n              actions.extend([ACTIONS['UP']] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([ACTIONS['RIGHT']] * abs(dy))\n          elif dy < 0:\n              actions.extend([ACTIONS['LEFT']] * abs(dy))\n          \n          # Use the workshop\n          actions.append(ACTIONS['USE'])\n      \n      return ACTIONS['USE']\n\n  def heuristic(state, goal_index):\n    \"\"\"Returns a heuristic estimate of the cost to reach the goal from the current state.\"\"\"\n    # Heuristic: Manhattan distance to the nearest occurrence of the goal on the grid\n    min_distance = float('inf')\n    for x in range(env._current_state.grid.shape[0]):\n        for y in range(env._current_state.grid.shape[1]):\n            if np.any(env._current_state.grid[x, y] == goal_index):\n                distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n                min_distance = min(min_distance, distance)\n    return min_distance\n\n  def a_star_search(start_state, goal_index):\n    \"\"\"Finds the shortest path to craft the item using A* search algorithm.\"\"\"\n    open_set = [(heuristic(start_state, goal_index), start_state, [])]\n    came_from = {}\n    g_score = {start_state: 0}\n    \n    while open_set:\n        _, current_state, actions = open_set.pop(0)\n        \n        # Check if the goal is satisfied\n        if current_state.satisfies(\"\", goal_index):\n            return actions\n        \n        # Generate neighboring states and corresponding actions\n        for ingredient_index, count in env.world.cookbook.primitives_for(goal_index).items():\n            # If the ingredient is a primitive resource, generate actions to pick it up\n            if ingredient_index in env.world.grabbable_indices:\n                pickup_actions = collect_item(ingredient_index)\n                new_state = current_state\n                for action in pickup_actions:\n                    _, new_state = new_state.step(action)\n                \n                tentative_g_score = g_score[current_state] + len(pickup_actions)\n                if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                    came_from[new_state] = (current_state, actions + pickup_actions)\n                    g_score[new_state] = tentative_g_score\n                    open_set.append((tentative_g_score + heuristic(new_state, goal_index), new_state, actions + pickup_actions))\n            \n            # If the ingredient is a crafted item, generate actions to craft it\n            else:\n                recipe = env.world.cookbook.recipes[ingredient_index]\n                craft_actions = get_crafting_path(recipe)\n                if craft_actions:\n                    new_state = current_state\n                    for action in craft_actions:\n                        _, new_state = new_state.step(action)\n                    \n                    tentative_g_score = g_score[current_state] + len(craft_actions)\n                    if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                        came_from[new_state] = (current_state, actions + craft_actions)\n                        g_score[new_state] = tentative_g_score\n                        open_set.append((tentative_g_score + heuristic(new_state, goal_index), new_state, actions + craft_actions))\n        \n        # Sort the open set by estimated total cost\n        open_set.sort()\n    \n    return []  # No path found\n\n  def get_crafting_path(recipe):\n      \"\"\"Finds a sequence of actions to craft an item from its recipe.\"\"\"\n      actions = []\n      \n      # Collect required items\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          \n          while inventory[ingredient] < count:\n              actions.extend(collect_item(ingredient))\n          \n          # Update inventory\n          inventory[ingredient] -= count\n      \n      # Craft the item\n      actions.append(ACTIONS['USE'])\n      \n      return actions\n\n  graph = build_graph()\n  inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path)", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:46:46.868669", "function_name": "craft", "function_body": "  def get_item_positions(state, item_index):\n    return np.argwhere(state.grid[:, :, item_index] > 0)\n\n  def move_to_position(state, target_pos):\n    x, y = state.pos\n    tx, ty = target_pos\n\n    actions = []\n    if tx < x:\n        actions.extend([env.ACTIONS['UP']] * (x - tx))\n    elif tx > x:\n        actions.extend([env.ACTIONS['DOWN']] * (tx - x))\n\n    if ty < y:\n        actions.extend([env.ACTIONS['LEFT']] * (y - ty))\n    elif ty > y:\n        actions.extend([env.ACTIONS['RIGHT']] * (ty - y))\n\n    return actions\n\n  def collect_item(state, item_index):\n    positions = get_item_positions(state, item_index)\n    if len(positions) == 0:\n        raise ValueError(f\"No {item_index} found on the grid.\")\n    \n    actions = []\n    for pos in positions:\n        move_actions = move_to_position(state, tuple(pos))\n        actions.extend(move_actions)\n        state = env._current_state\n        for _ in range(len(move_actions)):\n            _, state = state.step(actions[-1])\n        \n        actions.append(env.ACTIONS['USE'])\n        state = env._current_state\n        \n    return actions\n\n  def craft_item_at_workshop(state, output_index):\n    workshops = env.world.workshop_indices\n    if not workshops:\n        raise ValueError(\"No workshop found on the grid.\")\n    \n    # Find the nearest workshop to the current position\n    x, y = state.pos\n    distances = [(abs(x - wx), abs(y - wy)) for wx, wy in divmod(workshops, state.grid.shape[1])]\n    nearest_workshop_index = distances.index(min(distances))\n    workshop_pos = divmod(workshops[nearest_workshop_index], state.grid.shape[1])\n    \n    actions = move_to_position(state, workshop_pos)\n    actions.append(env.ACTIONS['USE'])\n    \n    return actions\n\n  def bfs_shortest_path(graph, start, goal):\n    queue = [(start, [])]\n    visited = set()\n    \n    while queue:\n        current, path = queue.pop(0)\n        \n        if current == goal:\n            return path\n        \n        if current not in visited:\n            visited.add(current)\n            \n            for neighbor in graph.get(current, []):\n                if neighbor not in visited:\n                    new_path = path + [neighbor]\n                    queue.append((new_path[-1], new_path))\n                    \n    return None\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def find_recipe(graph, goal_index):\n    paths = []\n    \n    for primitive in env.world.cookbook.primitives:\n        path = bfs_shortest_path(graph, primitive, goal_index)\n        if path:\n            paths.append(path)\n            \n    if not paths:\n        return None\n    \n    # Return the shortest path\n    return min(paths, key=len)\n\n  def translate_path_to_actions(path):\n    actions = []\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while env._current_state.inventory[ingredient] < count:\n                collect_actions = collect_item(env._current_state, ingredient)\n                actions.extend(collect_actions)\n            \n            # Update inventory (simulated)\n            env._current_state.inventory[ingredient] -= count\n        \n        # Craft the item\n        craft_actions = craft_item_at_workshop(env._current_state, output_index)\n        actions.extend(craft_actions)\n        \n        # Update inventory (simulated)\n        env._current_state.inventory[output_index] += 1\n    \n    return actions\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path)", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:47:35.725202", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if not new_state.pos == state.pos:\n          features_tuple = tuple(new_state.features())\n          if features_tuple not in visited:\n            visited.add(features_tuple)\n            queue.append((new_state, actions + [action]))\n      \n      # Check USE action separately\n      _, use_state = state.step(USE)\n      if use_state.inventory[goal] > 0 and not np.array_equal(use_state.grid, state.grid):\n        return actions + [USE]\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:47:36.731559", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if reward < 0:\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_valid_moves(state):\n    \"\"\"Get a list of valid moves from the current state.\"\"\"\n    valid_moves = []\n    for action in range(env.world.n_actions):\n      reward, new_state = state.step(action)\n      if reward >= 0:  # Only consider valid moves\n        valid_moves.append((action, new_state))\n    return valid_moves\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:48:40.588472", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n    from queue import PriorityQueue\n\n    # Heuristic: Number of primitives needed to craft the goal\n    def heuristic(state, goal_arg):\n      # Count primitives in inventory towards goal\n      primitive_counts = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory[primitive_counts.keys()]\n      return sum(primitive_counts.values()) - np.minimum(current_inventory, list(primitive_counts.values())).sum()\n\n    queue = PriorityQueue()\n    start_hash = hash((start_state.grid.tobytes(), tuple(start_state.inventory), start_state.pos, start_state.dir))\n    queue.put((0 + heuristic(start_state, goal_arg), 0, [start_hash], []))  # (f_cost, g_cost, path_hashes, actions_taken)\n    visited_states = {start_hash}\n\n    while not queue.empty():\n      f_cost, g_cost, path_hashes, actions_taken = queue.get()\n      current_state = start_state\n\n      for action in actions_taken:\n        _, current_state = current_state.step(action)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir))\n\n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          new_g_cost = g_cost + 1\n          f_cost = new_g_cost + heuristic(next_state, goal_arg)\n          queue.put((f_cost, new_g_cost, path_hashes + [state_hash], actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:48:42.067404", "function_name": "craft", "function_body": "  # Define the maximum depth for search\n  MAX_DEPTH = 50\n\n  def dfs_with_pruning(start_state, goal_name, goal_arg, max_depth=MAX_DEPTH):\n    \"\"\"Depth-first search with pruning and early termination.\"\"\"\n    \n    def is_primitive(i_kind):\n      return i_kind in env.world.cookbook.primitives\n    \n    def can_craft(state, item_index):\n      primitives_needed = env.world.cookbook.primitives_for(item_index)\n      for primitive, count in primitives_needed.items():\n        if state.inventory[primitive] < count:\n          return False\n      return True\n    \n    def helper(state, actions_taken, depth):\n      # Check goal satisfaction\n      if state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Prune if maximum depth is reached\n      if depth > max_depth:\n        return None\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = state.step(action)\n        state_hash = hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir))\n        \n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          \n          # Check if the action leads to crafting a needed primitive\n          if is_primitive(goal_arg) and can_craft(next_state, goal_arg):\n            return actions_taken + [action]\n          \n          result = helper(next_state, actions_taken + [action], depth + 1)\n          if result is not None:\n            return result\n          visited_states.remove(state_hash)  # Prune the search space\n      \n      return None\n\n    visited_states = set()\n    return helper(start_state, [], 0)\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = dfs_with_pruning(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:51:39.617495", "function_name": "craft", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n  \n  def bfs_shortest_path(graph, start, goal):\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          current, path = queue.pop(0)\n          \n          if current == goal:\n              return path\n          \n          if current not in visited:\n              visited.add(current)\n              \n              for neighbor in graph.get(current, []):\n                  if neighbor not in visited:\n                      new_path = path + [neighbor]\n                      queue.append((neighbor, new_path))\n                      \n      return None\n\n  def find_recipe(graph, goal_index):\n      paths = []\n      \n      # Collect all paths from each primitive to the goal\n      for primitive in env.world.cookbook.primitives:\n          path = bfs_shortest_path(graph, primitive, goal_index)\n          if path:\n              paths.append(path)\n              \n      if not paths:\n          return None\n      \n      # Return the shortest path\n      return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def get_actions_to_pickup_item(env, item_index):\n    \"\"\"Generate actions to move to and pick up an item.\"\"\"\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    # Find all positions of the item on the grid\n    item_positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if len(item_positions) == 0:\n        return []  # No items found\n    \n    # Calculate distances to each item position\n    distances = [(np.abs(pos[0] - x) + np.abs(pos[1] - y), (x, y)) for x, y in item_positions]\n    \n    # Sort by distance and take the closest one\n    closest_pos = min(distances)[1]\n    \n    # Calculate relative position from agent's current position\n    dx, dy = closest_pos[0] - pos[0], closest_pos[1] - pos[1]\n    \n    actions = []\n    \n    if dx > 0:\n        actions.extend([DOWN] * abs(dx))\n    elif dx < 0:\n        actions.extend([UP] * abs(dx))\n    \n    if dy > 0:\n        actions.extend([RIGHT] * abs(dy))\n    elif dy < 0:\n        actions.extend([LEFT] * abs(dy))\n    \n    # Use the item\n    actions.append(USE)\n    \n    return actions\n\n  def craft_item_at_workshop(env):\n    \"\"\"Generate actions to move to and use a workshop.\"\"\"\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    \n    # Find all workshop positions on the grid\n    workshops = [(x, y) for x in range(grid.shape[0]) for y in range(grid.shape[1]) if grid[x, y].any() == 1]\n    \n    if len(workshops) == 0:\n        return []  # No workshops found\n    \n    # Calculate distances to each workshop\n    distances = [(np.abs(pos[0] - x) + np.abs(pos[1] - y), (x, y)) for x, y in workshops]\n    \n    # Sort by distance and take the closest one\n    closest_pos = min(distances)[1]\n    \n    # Calculate relative position from agent's current position\n    dx, dy = closest_pos[0] - pos[0], closest_pos[1] - pos[1]\n    \n    actions = []\n    \n    if dx > 0:\n        actions.extend([DOWN] * abs(dx))\n    elif dx < 0:\n        actions.extend([UP] * abs(dx))\n    \n    if dy > 0:\n        actions.extend([RIGHT] * abs(dy))\n    elif dy < 0:\n        actions.extend([LEFT] * abs(dy))\n    \n    # Use the workshop\n    actions.append(USE)\n    \n    return actions\n\n  def get_crafting_actions(env, item_index):\n    \"\"\"Generate a sequence of actions to craft an item.\"\"\"\n    recipe = env.world.cookbook.recipes[item_index]\n    inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n    actions = []\n    \n    # Collect required items\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        \n        while inventory[ingredient] < count:\n            pickup_actions = get_actions_to_pickup_item(env, ingredient)\n            if not pickup_actions:\n                return []  # Cannot find the ingredient\n            \n            actions.extend(pickup_actions)\n            \n            # Simulate picking up the item\n            for action in pickup_actions:\n                _, env._current_state = env._current_state.step(action)\n            \n            inventory[ingredient] += 1\n    \n    # Craft the item at a workshop\n    craft_actions = craft_item_at_workshop(env)\n    if not craft_actions:\n        return []  # Cannot find a workshop\n    \n    actions.extend(craft_actions)\n    \n    return actions\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  actions = []\n  inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n  \n  for i in range(len(path) - 1):\n      input_index = path[i]\n      output_index = path[i + 1]\n      \n      # Collect required items\n      recipe = env.world.cookbook.recipes[output_index]\n      crafting_actions = get_crafting_actions(env, output_index)\n      \n      if not crafting_actions:\n          raise ValueError(f\"Cannot craft item {output_index}.\")\n      \n      actions.extend(crafting_actions)\n      \n      # Simulate crafting the item\n      for action in crafting_actions:\n          _, env._current_state = env._current_state.step(action)\n      \n      inventory[output_index] += 1\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:51:40.572572", "function_name": "craft", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n  \n  def bfs_shortest_path(graph, start, goal):\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          current, path = queue.pop(0)\n          \n          if current == goal:\n              return path\n          \n          if current not in visited:\n              visited.add(current)\n              \n              for neighbor in graph.get(current, []):\n                  if neighbor not in visited:\n                      new_path = path + [neighbor]\n                      queue.append((neighbor, new_path))\n                      \n      return None\n\n  def find_recipe(graph, goal_index):\n      paths = []\n      \n      for primitive in env.world.cookbook.primitives:\n          path = bfs_shortest_path(graph, primitive, goal_index)\n          if path:\n              paths.append(path)\n              \n      if not paths:\n          return None\n      \n      # Return the shortest path\n      return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path, item):\n    actions = []\n    \n    # Initialize inventory\n    inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(output_index))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n      \"\"\"Collects an item by moving to it and using the action.\"\"\"\n      actions = []\n      \n      # Find positions of the item on the grid\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      for pos in item_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n          \n          # Use the item\n          actions.append(USE)\n      \n      return actions\n\n  def craft_item(output_index):\n      \"\"\"Simulate crafting an item at a workshop.\"\"\"\n      actions = []\n      \n      # Find the nearest workshop\n      workshops = env.world.workshop_indices\n      \n      for workshop in workshops:\n          x, y = divmod(workshop, env._current_state.grid.shape[1])\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n          \n          # Use the workshop to craft the item\n          actions.append(USE)\n      \n      return actions\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path, item)", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:52:41.943068", "function_name": "craft", "function_body": "  def heuristic(state, goal_item_index):\n    # Heuristic: count the number of missing items required for the goal in the inventory\n    primitives = env.world.cookbook.primitives_for(goal_item_index)\n    total_missing = sum(primitives.get(i_kind, 0) - state.inventory[i_kind] for i_kind in primitives)\n    return max(total_missing, 0)\n\n  def astar(start_state, goal_name, goal_arg):\n    import heapq\n\n    # Priority queue with (f_score, g_score, state, actions_taken)\n    open_set = []\n    heapq.heappush(open_set, (heuristic(start_state, goal_arg), 0, start_state, []))\n    \n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state, goal_arg)}\n\n    while open_set:\n      _, current_g_score, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = current_g_score + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[next_state] = current_state\n          g_score[next_state] = tentative_g_score\n          f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score[next_state], tentative_g_score, next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current, actions):\n      total_path = []\n      while current in came_from:\n          total_path.append(actions[-1])\n          current = came_from[current]\n          if len(actions) > 0:\n              actions.pop()\n      return list(reversed(total_path))\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:52:43.033102", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:53:39.608079", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the distance to the nearest occurrence of the goal item.\n    grid = state.grid\n    pos = state.pos\n    \n    # Find all positions with the goal item in the grid\n    goal_positions = np.argwhere(grid[:, :, goal] > 0)\n    \n    if len(goal_positions) == 0:\n      return float('inf')  # No heuristic value if no goal items are found\n    \n    # Calculate Manhattan distances from the agent's position to each goal position\n    distances = [abs(pos[0] - gp[0]) + abs(pos[1] - gp[1]) for gp in goal_positions]\n    \n    return min(distances)\n\n  def bfs_with_heuristic(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Sort possible actions based on heuristic\n      actions_sorted = sorted(range(env.world.n_actions), key=lambda a: (heuristic(state.step(a)[1], goal), -a))\n      \n      for action in actions_sorted:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:53:41.070854", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on inventory count for the goal item\n    return state.inventory[goal]\n\n  def dfs_with_heuristic(start_state, goal, max_depth=50):\n      \"\"\"Depth-First Search with heuristic prioritization and depth limit.\"\"\"\n      \n      from collections import deque\n      \n      stack = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while stack:\n          state, actions = stack.pop()\n          \n          if len(actions) >= max_depth:\n              continue  # Skip deeper paths to prevent infinite loops and excessive computation\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Sort possible actions based on heuristic\n          actions_sorted = sorted(range(env.world.n_actions), key=lambda a: heuristic(state.step(a)[1], goal))\n          \n          for action in actions_sorted:\n              reward, new_state = state.step(action)\n              \n              # Check if the USE action is likely to be productive and prioritize it\n              if action == USE and new_state.inventory[goal] > state.inventory[goal]:\n                  visited.add(tuple(new_state.features()))\n                  stack.appendleft((new_state, actions + [action]))\n              elif tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  stack.append((new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = dfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:54:34.806714", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of items in inventory\n    return len([i for i in range(len(state.inventory)) if state.inventory[i] > 0 and i != goal])\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = [(heuristic(start_state, goal), start_state, [])]\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          heappush(open_set, (len(actions) + heuristic(new_state, goal), new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:54:35.771647", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Heuristic based on the number of items in the inventory towards the goal\n    required_items = env.world.cookbook.primitives_for(item)\n    count = sum(required_items.get(i, 0) for i in range(len(state.inventory)) if state.inventory[i] > 0)\n    return len(required_items) - count\n\n  def astar(start_state, goal):\n      \"\"\"A* search to find the shortest path with heuristics.\"\"\"\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(start_state), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while not open_set.empty():\n          _, current_state, actions = open_set.get()\n\n          if current_state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, current_state, actions)\n\n          for action in [USE] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n\n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (current_state, action)\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  open_set.put((f_score, new_state, actions + [action]))\n\n      return None  # No solution found\n\n  def reconstruct_path(came_from, current, path):\n      if tuple(current.features()) in came_from:\n          (p, action) = came_from[tuple(current.features())]\n          path = reconstruct_path(came_from, p, path) + [action]\n      return path\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:56:21.302369", "function_name": "craft", "function_body": "  def bfs(start_pos, target_indices):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [(start_pos, [])]\n    visited = set()\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n        \n        if current_pos in visited:\n            continue\n        visited.add(current_pos)\n        \n        # Check all neighboring cells for target indices\n        for dx, dy in directions:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            \n            if (new_x < 0 or new_x >= env._current_state.grid.shape[0] or \n                new_y < 0 or new_y >= env._current_state.grid.shape[1]):\n                continue\n                \n            # Check if any of the target_indices are present in the cell\n            for index in target_indices:\n                if env._current_state.grid[new_x, new_y, index] > 0:\n                    return path + [(new_x, new_y)]\n                    \n            queue.append(((new_x, new_y), path + [(new_x, new_y)]))\n            \n    return None\n\n  def get_action_to_move(current_pos, target_pos):\n    directions = [(0, 1, 2), (1, 0, 3), (0, -1, 4), (-1, 0, 5)]\n    \n    for dx, dy, action in directions:\n        if current_pos[0] + dx == target_pos[0] and current_pos[1] + dy == target_pos[1]:\n            return action\n    \n    return None\n\n  def find_nearest_workshop(start_pos):\n      path_to_workshop = bfs(start_pos, env.world.workshop_indices)\n      return path_to_workshop\n\n  def craft_item(env):\n      # Assume the agent is at a workshop\n      recipe = env.world.cookbook.primitives_for(item)\n      required_items = list(recipe.keys())\n      \n      for req_item in required_items:\n          if env._current_state.inventory[req_item] < recipe[req_item]:\n              return False\n      \n      # Craft the item by using the required items\n      for _ in range(sum(recipe.values())):\n          actions.append(4)  # Assuming 4 corresponds to the USE action\n      \n      return True\n\n  actions = []\n  start_pos = env._current_state.pos\n  \n  # Find and pick up all required items\n  recipe = env.world.cookbook.primitives_for(item)\n  required_items = list(recipe.keys())\n  \n  for req_item in required_items:\n      path_to_item = bfs(start_pos, [req_item])\n      \n      if not path_to_item:\n          return actions\n      \n      for next_pos in path_to_item:\n          action = get_action_to_move(start_pos, next_pos)\n          if action is not None:\n              actions.append(action)\n              start_pos = next_pos\n      \n      # Use action to pick up the item\n      actions.append(4)  # Assuming 4 corresponds to the USE action\n  \n  # Move to a workshop to craft the item\n  path_to_workshop = find_nearest_workshop(start_pos)\n  \n  if not path_to_workshop:\n      return actions\n  \n  for next_pos in path_to_workshop:\n      action = get_action_to_move(start_pos, next_pos)\n      if action is not None:\n          actions.append(action)\n          start_pos = next_pos\n  \n  # Craft the item\n  if not craft_item(env):\n      return actions\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:56:22.256285", "function_name": "craft", "function_body": "  def bfs(start_pos, target_indices):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [(start_pos, [])]\n    visited = set()\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n        \n        if current_pos in visited:\n            continue\n        visited.add(current_pos)\n        \n        # Check all neighboring cells for target indices\n        for dx, dy in directions:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            \n            if (new_x < 0 or new_x >= env._current_state.grid.shape[0] or \n                new_y < 0 or new_y >= env._current_state.grid.shape[1]):\n                continue\n                \n            # Check if any of the target_indices are present in the cell\n            for index in target_indices:\n                if env._current_state.grid[new_x, new_y, index] > 0:\n                    return path + [(new_x, new_y)]\n                    \n            queue.append(((new_x, new_y), path + [(new_x, new_y)]))\n            \n    return None\n\n  def get_action_to_move(current_pos, target_pos):\n    directions = [(0, 1, 3), (1, 0, 2), (0, -1, 4), (-1, 0, 5)]\n    \n    for dx, dy, action in directions:\n        if current_pos[0] + dx == target_pos[0] and current_pos[1] + dy == target_pos[1]:\n            return action\n    \n    return None\n\n  def find_nearest_workshop(start_pos):\n      path_to_workshop = bfs(start_pos, env.world.workshop_indices)\n      return path_to_workshop\n\n  def craft_item(env):\n      # Assume the agent is at a workshop\n      recipe = env.world.cookbook.primitives_for(item)\n      required_items = list(recipe.keys())\n      \n      for req_item in required_items:\n          if env._current_state.inventory[req_item] < recipe[req_item]:\n              return False\n      \n      # Craft the item by using the required items\n      for _ in range(sum(recipe.values())):\n          actions.append(4)  # Assuming 4 corresponds to the USE action\n      \n      return True\n\n  actions = []\n  start_pos = env._current_state.pos\n  \n  # Find and pick up all required items\n  recipe = env.world.cookbook.primitives_for(item)\n  required_items = list(recipe.keys())\n  \n  for req_item in required_items:\n      path_to_item = bfs(start_pos, [req_item])\n      \n      if not path_to_item:\n          return actions\n      \n      for next_pos in path_to_item:\n          action = get_action_to_move(start_pos, next_pos)\n          actions.append(action)\n          start_pos = next_pos\n      \n      # Use action to pick up the item\n      actions.append(4)  # Assuming 4 corresponds to the USE action\n  \n  # Move to a workshop to craft the item\n  path_to_workshop = find_nearest_workshop(start_pos)\n  \n  if not path_to_workshop:\n      return actions\n  \n  for next_pos in path_to_workshop:\n      action = get_action_to_move(start_pos, next_pos)\n      actions.append(action)\n      start_pos = next_pos\n  \n  # Craft the item\n  if not craft_item(env):\n      return actions\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:57:38.148798", "function_name": "craft", "function_body": "  def find_closest_items(item_index):\n      positions = []\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if env.current_state.grid[x, y, item_index] > 0:\n                  positions.append((x, y))\n      return sorted(positions, key=lambda pos: abs(pos[0] - env.current_state.pos[0]) + abs(pos[1] - env.current_state.pos[1]))\n\n  def move_to_position(target_x, target_y):\n      actions = []\n      current_x, current_y = env.current_state.pos\n\n      while current_x != target_x:\n          actions.append(env.RIGHT if current_x < target_x else env.LEFT)\n          current_x += 1 if current_x < target_x else -1\n\n      while current_y != target_y:\n          actions.append(env.DOWN if current_y < target_y else env.UP)\n          current_y += 1 if current_y < target_y else -1\n\n      return actions\n\n  def gather_item(item_index):\n      actions = []\n      positions = find_closest_items(item_index)\n\n      for pos in positions:\n          x, y = pos\n          actions.extend(move_to_position(x, y))\n          actions.append(env.USE)\n          \n          # Update the current state to reflect the new position and inventory after gathering\n          env.current_state.grid[x, y, item_index] -= 1\n          env.current_state.inventory[item_index] += 1\n\n      return actions\n\n  def craft_item(item_index):\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      actions = []\n\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue  # Skip the key ingredient\n      \n          while env.current_state.inventory[ingredient] < count:\n              actions.extend(gather_item(ingredient))\n      \n      # Simulate crafting (this is a placeholder)\n      actions.append(env.USE)\n\n      return actions\n\n  actions = []\n\n  # Example logic based on item index\n  if item == 0:  # Assuming 0 is the index for 'stone'\n    actions.extend(gather_item(item))\n\n  elif item == 1:  # Assuming 1 is the index for 'stick' which requires two stones\n    actions.extend(craft_item(item))\n\n  # Add more items and their crafting logic as needed\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:57:39.153132", "function_name": "craft", "function_body": "  def find_closest_items(item_index):\n    positions = []\n    min_distance = float('inf')\n\n    for x in range(env.world.WIDTH):\n      for y in range(env.world.HEIGHT):\n        if env.current_state.grid[x, y, item_index] > 0:\n          distance = abs(x - env.current_state.pos[0]) + abs(y - env.current_state.pos[1])\n          positions.append((x, y, distance))\n          if distance < min_distance:\n            min_distance = distance\n\n    # Filter only the closest items\n    return [pos for pos in positions if pos[2] == min_distance]\n\n  def move_to_position(target_x, target_y):\n    actions = []\n    current_x, current_y = env.current_state.pos\n\n    while current_x != target_x:\n      actions.append(env.RIGHT if current_x < target_x else env.LEFT)\n      current_x += 1 if current_x < target_x else -1\n\n    while current_y != target_y:\n      actions.append(env.DOWN if current_y < target_y else env.UP)\n      current_y += 1 if current_y < target_y else -1\n\n    return actions\n\n  def gather_item(item_index):\n    actions = []\n    closest_positions = find_closest_items(item_index)\n\n    for x, y, _ in closest_positions:\n      while env.current_state.grid[x, y, item_index] > 0 and env.current_state.inventory[item_index] == 0:\n        actions.extend(move_to_position(x, y))\n        actions.append(env.USE)\n        \n        # Update the current state to reflect the new position and inventory after gathering\n        env._current_state.grid[x, y, item_index] -= 1\n        env._current_state.inventory[item_index] += 1\n\n    return actions\n\n  def craft_item(item_index):\n    recipe = env.world.cookbook.recipes.get(item_index, {})\n    actions = []\n\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue  # Skip the key ingredient\n      \n      while env._current_state.inventory[ingredient] < count:\n        actions.extend(gather_item(ingredient))\n    \n    # Simulate crafting (this is a placeholder)\n    actions.append(env.USE)\n\n    return actions\n\n  actions = []\n\n  # Example logic based on item index\n  if item == 0:  # Assuming 0 is the index for 'stone'\n    actions.extend(gather_item(item))\n  \n  elif item == 1:  # Assuming 1 is the index for 'stick' which requires two stones\n    actions.extend(craft_item(item))\n\n  # Add more items and their crafting logic as needed\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:58:22.436864", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  # Check if the item is already in the inventory\n  initial_state = env._current_state\n  if initial_state.satisfies(goal_name, goal_arg):\n    return []\n\n  action_sequence = bfs(initial_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:58:23.470214", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n\n              # Create a hashable state representation\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n      \n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:59:51.899083", "function_name": "craft", "function_body": "  def find_closest_items(item_index):\n      positions = []\n      min_distance = float('inf')\n\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if env.current_state.grid[x, y, item_index] > 0:\n                  distance = abs(x - env.current_state.pos[0]) + abs(y - env.current_state.pos[1])\n                  positions.append((x, y, distance))\n                  if distance < min_distance:\n                      min_distance = distance\n\n      # Filter only the closest items\n      return [pos for pos in positions if pos[2] == min_distance]\n\n  def move_to_position(target_x, target_y):\n      actions = []\n      current_x, current_y = env.current_state.pos\n\n      while current_x != target_x:\n          actions.append(env.RIGHT if current_x < target_x else env.LEFT)\n          current_x += 1 if current_x < target_x else -1\n\n      while current_y != target_y:\n          actions.append(env.DOWN if current_y < target_y else env.UP)\n          current_y += 1 if current_y < target_y else -1\n\n      return actions\n\n  def gather_item(item_index):\n      actions = []\n      closest_positions = find_closest_items(item_index)\n\n      for x, y, _ in closest_positions:\n          while env.current_state.grid[x, y, item_index] > 0 and env._current_state.inventory[item_index] == 0:\n              actions.extend(move_to_position(x, y))\n              actions.append(env.USE)\n              \n              # Update the current state to reflect the new position and inventory after gathering\n              env._current_state.grid[x, y, item_index] -= 1\n              env._current_state.inventory[item_index] += 1\n\n      return actions\n\n  def craft_item(item_index):\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      actions = []\n\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue  # Skip the key ingredient\n          \n          while env._current_state.inventory[ingredient] < count:\n              actions.extend(gather_item(ingredient))\n      \n      # Simulate crafting (this is a placeholder)\n      actions.append(env.USE)\n\n      return actions\n\n  def craft_goal(item_index):\n      if item_index in env.world.cookbook.primitives:\n          return gather_item(item_index)\n      else:\n          return craft_item(item_index)\n\n  actions = []\n\n  # Example logic based on item index\n  if item == 0:  # Assuming 0 is the index for 'stone'\n      actions.extend(gather_item(item))\n  \n  elif item == 1:  # Assuming 1 is the index for 'stick' which requires two stones\n      actions.extend(craft_goal(item))\n\n  # Add more items and their crafting logic as needed\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:59:52.865914", "function_name": "craft", "function_body": "  def find_closest_items(item_index):\n      positions = []\n      min_distance = float('inf')\n\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if env.current_state.grid[x, y, item_index] > 0:\n                  distance = abs(x - env.current_state.pos[0]) + abs(y - env.current_state.pos[1])\n                  positions.append((x, y, distance))\n                  if distance < min_distance:\n                      min_distance = distance\n\n      # Filter only the closest items\n      return [pos for pos in positions if pos[2] == min_distance]\n\n  def move_to_position(target_x, target_y):\n      actions = []\n      current_x, current_y = env.current_state.pos\n\n      while current_x != target_x:\n          actions.append(env.RIGHT if current_x < target_x else env.LEFT)\n          current_x += 1 if current_x < target_x else -1\n\n      while current_y != target_y:\n          actions.append(env.DOWN if current_y < target_y else env.UP)\n          current_y += 1 if current_y < target_y else -1\n\n      return actions\n\n  def gather_item(item_index):\n      actions = []\n      closest_positions = find_closest_items(item_index)\n\n      for x, y, _ in closest_positions:\n          while env.current_state.grid[x, y, item_index] > 0 and env._current_state.inventory[item_index] == 0:\n              actions.extend(move_to_position(x, y))\n              actions.append(env.USE)\n              \n              # Update the current state to reflect the new position and inventory after gathering\n              env._current_state.grid[x, y, item_index] -= 1\n              env._current_state.inventory[item_index] += 1\n\n      return actions\n\n  def craft_item(item_index):\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      actions = []\n\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue  # Skip the key ingredient\n          \n          while env._current_state.inventory[ingredient] < count:\n              actions.extend(gather_item(ingredient))\n      \n      # Simulate crafting (this is a placeholder)\n      actions.append(env.USE)\n\n      return actions\n\n  def resolve_dependencies(item_index):\n      \"\"\"Recursively resolve dependencies for crafting an item.\"\"\"\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      if not recipe:\n          return []  # No recipe means no dependencies\n      \n      actions = []\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue  # Skip the key ingredient\n          \n          while env._current_state.inventory[ingredient] < count:\n              # Check if the ingredient is a primitive or needs to be crafted\n              if ingredient not in env.world.cookbook.recipes:\n                  actions.extend(gather_item(ingredient))\n              else:\n                  actions.extend(resolve_dependencies(ingredient))\n      \n      # Simulate crafting (this is a placeholder)\n      actions.append(env.USE)\n\n      return actions\n\n  actions = resolve_dependencies(item)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:00:39.480333", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n      # Simple heuristic: Manhattan distance between current inventory and goal\n      current_inventory = state.inventory\n      goal_inventory = np.zeros_like(current_inventory)\n      goal_inventory[goal] = 1\n      return np.sum(np.abs(current_inventory - goal_inventory))\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path.\"\"\"\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), 0, start_state, []))\n      \n      g_costs = {tuple(start_state.features()): 0}\n      visited = set()\n      \n      while open_set:\n          _, current_cost, state, actions = heappop(open_set)\n          \n          if tuple(state.features()) in visited:\n              continue\n          visited.add(tuple(state.features()))\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              # Check if the new state is a valid move and not already visited\n              if (not any(new_state.grid[new_state.pos] == env.world.non_grabbable_indices) and\n                  tuple(new_state.features()) not in g_costs or\n                  current_cost + 1 < g_costs[tuple(new_state.features())]):\n                  g_costs[tuple(new_state.features())] = current_cost + 1\n                  heappush(open_set, (g_costs[tuple(new_state.features())] + heuristic(new_state, goal),\n                                      g_costs[tuple(new_state.features())], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:00:40.513335", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (not any(new_state.grid[state.pos] == env.world.non_grabbable_indices) and\n            tuple(new_state.features()) not in visited):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:01:22.670900", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n          tuple(next_state.grid.flatten()), \n          tuple(next_state.inventory), \n          next_state.pos, \n          next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:01:23.661062", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              # Use a more efficient hashable state representation\n              state_hash = (\n                  hash(next_state.grid.tobytes()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:02:27.483883", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states and is_reachable(current_state, goal_item=item):\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  def is_reachable(state, goal_item):\n    \"\"\"Check if the state can be reached with the current resources to craft the goal item.\"\"\"\n    # Check if the ingredients required for the goal item are available in inventory or on the grid\n    primitives = env.world.cookbook.primitives_for(goal_item)\n    \n    for ingredient, count in primitives.items():\n      if state.inventory[ingredient] < count:\n        if not next_to(state, ingredient):\n          return False\n    \n    return True\n\n  def next_to(state, i_kind) -> bool:\n    \"\"\"Check if any cell in the 3\u00d73 neighborhood around pos contains that kind.\"\"\"\n    x, y = state.pos\n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        nx, ny = x + dx, y + dy\n        if (0 <= nx < env.world.grid_width and \n            0 <= ny < env.world.grid_height and \n            state.grid[nx, ny, i_kind] > 0):\n          return True\n    return False\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:02:28.604451", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(state, goal_item):\n    \"\"\"Check if the state can be reached with the current resources to craft the goal item.\"\"\"\n    # Check if the ingredients required for the goal item are available in inventory or on the grid\n    primitives = env.world.cookbook.primitives_for(goal_item)\n    \n    for ingredient, count in primitives.items():\n      if state.inventory[ingredient] < count:\n        # Check if the ingredient is available on the grid\n        if not any(state.grid[:, :, ingredient].flatten()):\n          return False\n    \n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:03:22.790349", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Heuristic based on Manhattan distance to nearest required resource or workshop\n    required_resources = env.world.cookbook.primitives_for(item).keys()\n    closest_distance = float('inf')\n    \n    for resource in required_resources:\n      if not state.inventory[resource]:\n        for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n            if state.grid[x, y, resource] > 0:\n              distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n              closest_distance = min(closest_distance, distance)\n    \n    return closest_distance\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)):\n        reward, new_state = current_state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if new_state.pos == current_state.pos and action != USE:\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[features_tuple] = (tuple(current_state.features()), action)\n          g_score[features_tuple] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T01:03:23.825635", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if new_state.pos == state.pos and action != USE:\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T01:04:38.499110", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def manhattan_distance(pos1, pos2):\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def get_closest_workshop(state):\n    min_dist = float('inf')\n    closest_workshop = None\n    for workshop_pos in state.world.workshop_indices:\n      dist = manhattan_distance(state.pos, (workshop_pos % env.scenario.init_grid.shape[0], workshop_pos // env.scenario.init_grid.shape[1]))\n      if dist < min_dist:\n        min_dist = dist\n        closest_workshop = workshop_pos\n    return closest_workshop\n\n  def bfs_with_heuristic(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Calculate heuristic cost\n          heu_cost = heuristic(new_state, goal)\n          \n          queue.append((new_state, actions + [action]))\n      \n      # Sort queue based on heuristic cost (lower cost first)\n      queue = deque(sorted(queue, key=lambda x: heuristic(x[0], goal)))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n      closest_workshop = get_closest_workshop(state)\n      if closest_workshop is None:\n          return manhattan_distance(state.pos, (0, 0))  # Arbitrary position if no workshop is available\n      return manhattan_distance(state.pos, (closest_workshop % env.scenario.init_grid.shape[0], closest_workshop // env.scenario.init_grid.shape[1])) + state.inventory[goal]\n\n  start_state = env._current_state\n  actions = bfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
