{"timestamp": "2025-06-25T00:19:49.577707", "function_name": "craft", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n  width, height = env.world.scenario.init_grid.shape[:2]\n\n  def bfs_shortest_path(graph, start, goal):\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          current, path = queue.pop(0)\n          \n          if current == goal:\n              return path\n          \n          if current not in visited:\n              visited.add(current)\n              \n              for neighbor in graph.get(current, []):\n                  if neighbor not in visited:\n                      new_path = path + [neighbor]\n                      queue.append((neighbor, new_path))\n                      \n      return None\n\n  def find_recipe(graph, goal_index):\n      paths = []\n      \n      for primitive in env.world.cookbook.primitives:\n          path = bfs_shortest_path(graph, primitive, goal_index)\n          if path:\n              paths.append(path)\n              \n      if not paths:\n          return None\n      \n      # Return the shortest path\n      return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path, goal):\n    actions = []\n    \n    # Initialize inventory\n    inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(output_index))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n      \"\"\"Collects an item by moving to it and using the action.\"\"\"\n      actions = []\n      \n      # Find positions of the item on the grid\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      for pos in item_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n          \n          # Use the item\n          actions.append(USE)\n      \n      return actions\n\n  def craft_item(item_index):\n      \"\"\"Simulate crafting an item.\"\"\"\n      # Assuming that crafting is a single action (e.g., USE) when standing next to the appropriate ingredients.\n      return USE\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path, item)", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:19:50.544541", "function_name": "craft", "function_body": "  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def bfs_shortest_path(graph, start, goal):\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          current, path = queue.pop(0)\n          \n          if current == goal:\n              return path\n          \n          if current not in visited:\n              visited.add(current)\n              \n              for neighbor in graph.get(current, []):\n                  if neighbor not in visited:\n                      new_path = path + [neighbor]\n                      queue.append((neighbor, new_path))\n                      \n      return None\n\n  def find_recipe(graph, goal_index):\n      paths = []\n      \n      for primitive in env.world.cookbook.primitives:\n          path = bfs_shortest_path(graph, primitive, goal_index)\n          if path:\n              paths.append(path)\n              \n      if not paths:\n          return None\n      \n      # Return the shortest path\n      return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path, item):\n    actions = []\n    \n    # Initialize inventory\n    inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(output_index))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n      \"\"\"Collects an item by moving to it and using the action.\"\"\"\n      actions = []\n      \n      # Find positions of the item on the grid\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      for pos in item_positions:\n          x, y = pos\n          \n          # Calculate relative position from agent's current position\n          dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n          \n          # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n          if dx > 0:\n              actions.extend([DOWN] * abs(dx))\n          elif dx < 0:\n              actions.extend([UP] * abs(dx))\n          \n          if dy > 0:\n              actions.extend([RIGHT] * abs(dy))\n          elif dy < 0:\n              actions.extend([LEFT] * abs(dy))\n          \n          # Use the item\n          actions.append(USE)\n      \n      return actions\n\n  def craft_item(item_index):\n      \"\"\"Simulate crafting an item.\"\"\"\n      # Assuming that crafting is a single action (e.g., USE) when standing next to the appropriate ingredients.\n      return USE\n\n  def adjust_inventory(env, recipe, inventory):\n      actions = []\n      \n      for ingredient_index, count in recipe.items():\n          if ingredient_index == \"_key\":\n              continue\n          \n          while inventory[ingredient_index] < count:\n              # Collect items until we have enough\n              collect_actions = collect_item(env, ingredient_index)\n              actions.extend(collect_actions)\n              \n              # Simulate the collection effect on the grid and inventory\n              new_inventory = inventory.copy()\n              for action in collect_actions:\n                  if action == USE:\n                      # Update inventory count for the collected item\n                      new_inventory[ingredient_index] += 1\n      \n          # Decrease inventory by used amount\n          inventory[ingredient_index] -= count\n      \n      return actions\n\n  def craft(env, output_index):\n      \"\"\"Crafts an item given its index.\"\"\"\n      recipe = env.world.cookbook.recipes[output_index]\n      \n      # Adjust inventory to have enough items for the recipe\n      adjust_actions = adjust_inventory(env, recipe, env._current_state.inventory)\n      \n      # Craft the item (assumes standing next to ingredients and USE action is sufficient)\n      craft_action = [USE]\n      \n      return adjust_actions + craft_action\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  actions = []\n  \n  # Follow the path to craft the item\n  for i in range(len(path) - 1):\n      input_index = path[i]\n      output_index = path[i + 1]\n      \n      # Collect and craft each intermediate step\n      actions.extend(craft(env, output_index))\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:21:58.562643", "function_name": "craft", "function_body": "  # Helper function to find all recipes that can be crafted\n  def find_craftable_recipes(inventory):\n    craftable = set()\n    for output_index, recipe in env.world.cookbook.recipes.items():\n        if all(ingredient in inventory and inventory[ingredient] >= count for ingredient, count in recipe.items() if ingredient != \"_key\"):\n            craftable.add(output_index)\n    return craftable\n\n  # Helper function to update the inventory based on a crafted item\n  def update_inventory(inventory, output_index):\n    recipe = env.world.cookbook.recipes[output_index]\n    for ingredient, count in recipe.items():\n        if ingredient != \"_key\":\n            inventory[ingredient] -= count\n    inventory[output_index] += 1\n\n  # Helper function to determine the next action based on current state and goal\n  def plan_next_action(inventory, goal):\n    craftable = find_craftable_recipes(inventory)\n    \n    if goal in craftable:\n        return \"craft_{}\".format(goal), inventory\n    \n    for recipe_output, recipe in env.world.cookbook.recipes.items():\n        if all(ingredient in inventory and inventory[ingredient] >= count for ingredient, count in recipe.items() if ingredient != \"_key\"):\n            new_inventory = inventory.copy()\n            update_inventory(new_inventory, recipe_output)\n            action, _ = plan_next_action(new_inventory, goal)\n            return \"craft_{}\".format(recipe_output), new_inventory\n    \n    # If we can't craft the goal or any intermediate steps, collect required items\n    for ingredient in env.world.cookbook.recipes[goal]:\n        if ingredient != \"_key\" and inventory.get(ingredient, 0) < env.world.cookbook.recipes[goal][ingredient]:\n            return \"collect_{}\".format(ingredient), inventory\n    \n    raise ValueError(\"No way to craft the item with current inventory.\")\n\n  # Initialize inventory\n  inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n  \n  actions = []\n  while item not in inventory or inventory[item] == 0:\n      action, new_inventory = plan_next_action(inventory, item)\n      actions.append(action)\n      inventory.update(new_inventory)\n      \n  return [action.split(\"_\")[1] for action in actions]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:21:59.530012", "function_name": "craft", "function_body": "  def bfs_shortest_path(graph, start, goal):\n    queue = [(start, [])]\n    visited = set()\n    \n    while queue:\n        current, path = queue.pop(0)\n        \n        if current == goal:\n            return path\n        \n        if current not in visited:\n            visited.add(current)\n            \n            for neighbor in graph.get(current, []):\n                if neighbor not in visited:\n                    new_path = path + [neighbor]\n                    queue.append((neighbor, new_path))\n                    \n    return None\n\n  def find_recipe(graph, goal_index):\n    paths = []\n    \n    for primitive in env.world.cookbook.primitives:\n        path = bfs_shortest_path(graph, primitive, goal_index)\n        if path:\n            paths.append(path)\n            \n    if not paths:\n        return None\n    \n    # Return the shortest path\n    return min(paths, key=len)\n\n  def build_graph(cookbook):\n      graph = {}\n      \n      for output_index, recipe in cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path, cookbook):\n    actions = []\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(env, output_index))\n        \n        # Update inventory\n        inventory[output_index] += 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n    \"\"\"Simulate collecting an item.\"\"\"\n    actions = []\n    \n    # Find positions of the item in the grid\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    for pos in positions:\n        x, y = pos\n        \n        # Calculate direction and move to the position\n        dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n        \n        if dx < 0:\n            actions.extend([env_world.LEFT] * abs(dx))\n        elif dx > 0:\n            actions.extend([env_world.RIGHT] * abs(dx))\n        \n        if dy < 0:\n            actions.extend([env_world.DOWN] * abs(dy))\n        elif dy > 0:\n            actions.extend([env_world.UP] * abs(dy))\n        \n        # Use the item (pick it up)\n        actions.append(env_world.USE)\n    \n    return actions\n\n  def craft_item(env, item_index):\n    \"\"\"Simulate crafting an item.\"\"\"\n    # Find workshop positions\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)\n    \n    for pos in workshop_positions:\n        x, y = pos\n        \n        # Calculate direction and move to the workshop\n        dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n        \n        if dx < 0:\n            actions.extend([env_world.LEFT] * abs(dx))\n        elif dx > 0:\n            actions.extend([env_world.RIGHT] * abs(dx))\n        \n        if dy < 0:\n            actions.extend([env_world.DOWN] * abs(dy))\n        elif dy > 0:\n            actions.extend([env_world.UP] * abs(dy))\n        \n        # Use the workshop to craft the item\n        actions.append(env_world.USE)\n    \n    return actions\n\n  env_world = env_world_class()\n  inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n  \n  graph = build_graph(env.world.cookbook)\n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path, env.world.cookbook)", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:22:48.509429", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    state_cache = {}  # Cache to store previously seen states and their action sequences\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n          \n      visited_states.add(state_hash)\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states and next_state_hash not in state_cache:\n          queue.append((next_state, actions_taken + [action]))\n          state_cache[next_state_hash] = actions_taken + [action]\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:22:49.615798", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n        continue\n\n      visited_states.add(state_hash)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:25:33.199494", "function_name": "craft", "function_body": "  def bfs_shortest_path(graph, start, goal):\n    queue = [(start, [])]\n    visited = set()\n    \n    while queue:\n        current, path = queue.pop(0)\n        \n        if current == goal:\n            return path\n        \n        if current not in visited:\n            visited.add(current)\n            \n            for neighbor in graph.get(current, []):\n                if neighbor not in visited:\n                    new_path = path + [neighbor]\n                    queue.append((neighbor, new_path))\n                    \n    return None\n\n  def find_recipe(graph, goal_index):\n    paths = []\n    \n    # Start BFS from all primitive resources\n    for primitive in env.world.cookbook.primitives:\n        path = bfs_shortest_path(graph, primitive, goal_index)\n        if path:\n            paths.append(path)\n            \n    if not paths:\n        return None\n    \n    # Return the shortest path\n    return min(paths, key=len)\n\n  def build_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = []\n              graph[ingredient_index].append(output_index)\n              \n      return graph\n\n  def translate_path_to_actions(path):\n    actions = []\n    \n    # Initialize inventory with current state's inventory\n    inventory = {i: env._current_state.inventory.get(i, 0) for i in env.world.cookbook.index.contents.values()}\n    \n    for i in range(len(path) - 1):\n        input_index = path[i]\n        output_index = path[i + 1]\n        \n        # Find the recipe for the current step\n        recipe = env.world.cookbook.recipes[output_index]\n        \n        # Collect required items\n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            while inventory[ingredient] < count:\n                actions.extend(collect_item(env, ingredient))\n            \n            # Update inventory\n            inventory[ingredient] -= count\n        \n        # Craft the item\n        actions.append(craft_item(output_index, env._current_state.workshop_indices))\n        \n        # Update inventory\n        if output_index in inventory:\n            inventory[output_index] += 1\n        else:\n            inventory[output_index] = 1\n    \n    return actions\n\n  def collect_item(env, item_index):\n    \"\"\"Collects an item by moving to it and using the action.\"\"\"\n    actions = []\n    \n    # Find positions of the item on the grid\n    item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    for pos in item_positions:\n        x, y = pos\n        \n        # Calculate relative position from agent's current position\n        dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n        \n        # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n        if dx > 0:\n            actions.extend([env.ACTIONS['DOWN']] * abs(dx))\n        elif dx < 0:\n            actions.extend([env.ACTIONS['UP']] * abs(dx))\n        \n        if dy > 0:\n            actions.extend([env.ACTIONS['RIGHT']] * abs(dy))\n        elif dy < 0:\n            actions.extend([env.ACTIONS['LEFT']] * abs(dy))\n        \n        # Use the item\n        actions.append(env.ACTIONS['USE'])\n    \n    return actions\n\n  def craft_item(item_index, workshop_indices):\n      \"\"\"Crafts an item at a workshop.\"\"\"\n      actions = []\n      \n      # Find positions of workshops on the grid\n      workshops = [(x, y) for x in range(env._current_state.grid.shape[0]) \n                   for y in range(env._current_state.grid.shape[1]) \n                   if env._current_state.grid[x, y].tolist() == [workshop_indices]]\n      \n      # Assuming there's at least one workshop\n      x, y = workshops[0]\n      \n      # Calculate relative position from agent's current position\n      dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n      \n      # Convert relative position to actions (UP, DOWN, LEFT, RIGHT)\n      if dx > 0:\n          actions.extend([env.ACTIONS['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([env.ACTIONS['UP']] * abs(dx))\n      \n      if dy > 0:\n          actions.extend([env.ACTIONS['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([env.ACTIONS['LEFT']] * abs(dy))\n      \n      # Use the workshop\n      actions.append(env.ACTIONS['USE'])\n      \n      return actions\n\n  graph = build_graph()\n  \n  path = find_recipe(graph, item)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  return translate_path_to_actions(path)", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:25:34.156393", "function_name": "craft", "function_body": "  def get_actions_to_move_to_position(current_x, current_y, target_x, target_y):\n      actions = []\n      \n      # Move vertically\n      if target_y > current_y:\n          actions.extend([env.ACTIONS['UP']] * (target_y - current_y))\n      elif target_y < current_y:\n          actions.extend([env.ACTIONS['DOWN']] * (current_y - target_y))\n      \n      # Move horizontally\n      if target_x > current_x:\n          actions.extend([env.ACTIONS['RIGHT']] * (target_x - current_x))\n      elif target_x < current_x:\n          actions.extend([env.ACTIONS['LEFT']] * (current_x - target_x))\n      \n      return actions\n\n  def get_actions_to_pick_up_item(item_index):\n      item_positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n      \n      if not item_positions.size:\n          raise ValueError(f\"Item {item_index} not found on the grid.\")\n      \n      current_x, current_y = env._current_state.pos\n      actions = []\n      \n      for x, y in item_positions:\n          actions.extend(get_actions_to_move_to_position(current_x, current_y, x, y))\n          actions.append(env.ACTIONS['USE'])\n          \n          # Update current position after picking up the item\n          current_x, current_y = x, y\n      \n      return actions\n\n  def get_actions_to_craft_item(output_index):\n      workshops = env.world.workshop_indices\n      workshop_positions = [(i // env._current_state.grid.shape[1], i % env._current_state.grid.shape[1]) for i in workshops]\n      \n      if not workshop_positions:\n          raise ValueError(\"No workshop found on the grid.\")\n      \n      current_x, current_y = env._current_state.pos\n      actions = []\n      \n      for x, y in workshop_positions:\n          actions.extend(get_actions_to_move_to_position(current_x, current_y, x, y))\n          actions.append(env.ACTIONS['USE'])\n          \n          # Update current position after crafting the item\n          current_x, current_y = x, y\n      \n      return actions\n\n  def build_dependency_graph():\n      graph = {}\n      \n      for output_index, recipe in env.world.cookbook.recipes.items():\n          ingredients = [ingredient_index for ingredient_index in recipe.keys() if ingredient_index != \"_key\"]\n          \n          for ingredient_index in ingredients:\n              if ingredient_index not in graph:\n                  graph[ingredient_index] = set()\n              graph[ingredient_index].add(output_index)\n              \n      return graph\n\n  def find_shortest_path(graph, start_nodes, goal_node):\n      from collections import deque\n      \n      queue = deque([(node, []) for node in start_nodes])\n      visited = set(start_nodes)\n      \n      while queue:\n          current, path = queue.popleft()\n          \n          if current == goal_node:\n              return path\n          \n          for neighbor in graph.get(current, []):\n              if neighbor not in visited:\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [current]))\n                  \n      return None\n\n  def translate_path_to_actions(path):\n      actions = []\n      inventory = {i: 0 for i in env.world.cookbook.index.contents.values()}\n      \n      for i in range(len(path) - 1):\n          input_index = path[i]\n          output_index = path[i + 1]\n          \n          # Find the recipe for the current step\n          recipe = env.world.cookbook.recipes[output_index]\n          \n          # Collect required items\n          for ingredient, count in recipe.items():\n              if ingredient == \"_key\":\n                  continue\n              \n              while inventory[ingredient] < count:\n                  actions.extend(get_actions_to_pick_up_item(ingredient))\n                  \n                  # Update grid to reflect that the item has been picked up\n                  item_positions = np.argwhere(env._current_state.grid[:, :, ingredient] > 0)\n                  if item_positions.size:\n                      x, y = item_positions[0]\n                      env._current_state.grid[x, y, ingredient] -= 1\n                  \n                  # Update inventory\n                  inventory[ingredient] += 1\n              \n              # Deduct used items from inventory\n              inventory[ingredient] -= count\n          \n          # Craft the item\n          actions.extend(get_actions_to_craft_item(output_index))\n          \n          # Update grid to reflect that the item has been crafted\n          workshop_positions = [(i // env._current_state.grid.shape[1], i % env._current_state.grid.shape[1]) for i in env.world.workshop_indices]\n          if workshop_positions:\n              x, y = workshop_positions[0]\n              env._current_state.grid[x, y, output_index] += 1\n          \n          # Update inventory\n          inventory[output_index] += 1\n      \n      return actions\n\n  graph = build_dependency_graph()\n  start_nodes = env.world.cookbook.primitives\n  goal_node = item\n  \n  path = find_shortest_path(graph, start_nodes, goal_node)\n  if not path:\n      raise ValueError(f\"No recipe found for item {item}.\")\n  \n  # Prepend the initial state to the path\n  path.insert(0, None)\n  \n  return translate_path_to_actions(path)", "island_id": 2, "scores": {"3": -1}}
