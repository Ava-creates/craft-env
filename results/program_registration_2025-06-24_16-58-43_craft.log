{"timestamp": "2025-06-25T11:17:35.877884", "function_name": "craft", "function_body": "  def bfs(start_state, goal_index):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_index):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = bfs(start_state, goal_index)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:17:36.952741", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state to avoid revisiting\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:18:56.352499", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    from collections import defaultdict\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.features())] = 0\n    f_score = defaultdict(lambda: float('inf'))\n    f_score[tuple(start_state.features())] = heuristic(start_state, goal)\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of steps taken so far\n    # Can be improved with domain knowledge if needed\n    return len(actions)\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = [actions]\n    while current_state in came_from:\n      current_state, actions = came_from[current_state]\n      total_path.append(actions)\n    return [action for action_list in reversed(total_path) for action in action_list]\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:19:26.833033", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action_taken = False\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if action == USE and not use_action_taken:\n              use_action_taken = True\n              queue.appendleft((new_state, actions + [action]))\n          else:\n              queue.append((new_state, actions + [action]))\n              \n          visited.add(tuple(new_state.features()))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:23:43.382661", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_resource_positions(state, resource_indices):\n      \"\"\"Get all positions of the resources on the grid.\"\"\"\n      positions = {}\n      for idx in resource_indices:\n          grid = state.grid\n          pos_list = np.argwhere(grid[..., idx] == 1)\n          if len(pos_list) > 0:\n              positions[idx] = [tuple(pos) for pos in pos_list]\n      return positions\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  def collect_resources(env, start_state, resource_positions, primitives_needed):\n    \"\"\"Collect all required resources.\"\"\"\n    actions = []\n    current_state = start_state\n    resource_indices = list(primitives_needed.keys())\n    \n    while resource_indices:\n      for resource in resource_indices.copy():\n        if resource not in resource_positions or len(resource_positions[resource]) == 0:\n          raise ValueError(f\"No {env.world.cookbook.index.get(resource)} found on the grid.\")\n        \n        # Use all available positions of this resource\n        while primitives_needed[resource] > 0 and resource_positions[resource]:\n            target_pos = resource_positions[resource].pop()\n            \n            # Move to the target position\n            actions.extend(move_to_position(current_state, target_pos))\n            current_state = env._current_state\n            \n            # Pick up the resource\n            actions.append(USE)\n            current_state = env._current_state\n            \n            primitives_needed[resource] -= 1\n        \n        if primitives_needed[resource] == 0:\n            resource_indices.remove(resource)\n    \n    return actions, current_state\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  resource_positions = get_resource_positions(start_state, list(primitives_needed.keys()))\n  \n  # Collect all required resources\n  actions, current_state = collect_resources(env, start_state, resource_positions, primitives_needed.copy())\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(current_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:23:44.364962", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def get_resource_positions(state, resource_indices):\n    \"\"\"Get all positions of the resources on the grid.\"\"\"\n    positions = {}\n    for idx in resource_indices:\n      grid = state.grid\n      pos_list = np.argwhere(grid[..., idx] == 1)\n      if len(pos_list) > 0:\n          positions[idx] = [tuple(pos) for pos in pos_list]\n    return positions\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  def move_to_workshop(state):\n    \"\"\"Generate actions to move the agent to a workshop.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Find the closest workshop\n    workshops = env.world.cookbook.index.get(env.world.cookbook.index.inverse[workshop_index])\n    resource_positions = get_resource_positions(state, [workshop_index])\n    \n    if not resource_positions or len(resource_positions[workshop_index]) == 0:\n        raise ValueError(\"No workshop found on the grid.\")\n    \n    target_pos = resource_positions[workshop_index][0]\n    \n    # Move to the target position\n    actions = move_to_position(state, target_pos)\n    \n    return actions\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n  \n  actions = []\n  resource_positions = get_resource_positions(start_state, list(primitives_needed.keys()))\n  \n  for resource, count in primitives_needed.items():\n      if resource not in resource_positions or len(resource_positions[resource]) == 0:\n          raise ValueError(f\"No {cookbook.index.get(resource)} found on the grid.\")\n      \n      # Use all available positions of this resource\n      while count > 0 and resource_positions[resource]:\n          target_pos = resource_positions[resource].pop()\n          \n          # Move to the target position\n          actions.extend(move_to_position(start_state, target_pos))\n          start_state = env._current_state\n          \n          # Pick up the resource\n          actions.append(USE)\n          start_state = env._current_state\n          \n          count -= 1\n  \n  # Find a nearby workshop\n  workshop_index = next((idx for idx in cookbook.index if \"workshop\" in cookbook.index.get(idx)), None)\n  \n  if not workshop_index:\n    raise ValueError(\"No workshop found in the cookbook.\")\n  \n  # Move to the workshop\n  actions.extend(move_to_workshop(start_state))\n  start_state = env._current_state\n  \n  # Use BFS to find a path to craft the item from the collected resources\n  final_actions = bfs(start_state, item)\n  \n  if final_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:24:43.818037", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        new_features = tuple(new_state.features())\n        if new_features not in visited:\n          visited.add(new_features)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the goal item is already in inventory\n  if start_state.inventory[item] > 0:\n      return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
