d\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path using heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), 0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      f_score, g_score, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting states that have the same feature representation\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          g_score_new = g_score + 1\n          f_score_new = g_score_new + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score_new, g_score_new, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:38:16.054567", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    import heapq\n    \n    # Priority queue for A*\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    # Cost map and came_from map\n    g_cost_map = {tuple(start_state.features()): 0}\n    came_from = {}\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Calculate tentative g_cost\n        tentative_g_cost = g_cost_map[tuple(state.features())] + 1\n        \n        # If this path to neighbor is better, record it\n        if tuple(new_state.features()) not in g_cost_map or tentative_g_cost < g_cost_map[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, actions)\n          g_cost_map[tuple(new_state.features())] = tentative_g_cost\n          \n          # f_cost is the sum of g_cost and h_cost (heuristic)\n          # Here, we use a simple heuristic: if the new state has more of the goal item, it's better\n          h_cost = -new_state.inventory[goal]\n          f_cost = tentative_g_cost + h_cost\n          \n          heapq.heappush(open_set, (f_cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:39:51.405928", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None\n        if new_state is None:\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  # Attempt to collect primitives needed for crafting\n  primitive_actions = []\n  cookbook = env.world.cookbook\n  primitives_needed = cookbook.primitives_for(item)\n  \n  for primitive, count in primitives_needed.items():\n    while start_state.inventory[primitive] < count:\n      # Find and pick up the primitive\n      found_primitive = False\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if new_state is None:\n          continue\n        \n        if new_state.next_to(primitive):\n          reward, new_state = new_state.step(USE)  # Pick up the primitive\n          \n          if new_state.inventory[primitive] > start_state.inventory[primitive]:\n            found_primitive = True\n            break\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n        \n        state = new_state\n      \n      if not found_primitive:\n        raise ValueError(\"Could not find the required primitive.\")\n      \n      primitive_actions.append(USE)  # Add pick-up action to the list\n      start_state = new_state\n  \n  # Now attempt to craft the item\n  crafting_actions = bfs(start_state, item)\n  \n  if crafting_actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return primitive_actions + crafting_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:39:52.532452", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None\n        if new_state is None:\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  # Check for simple pick-up scenario\n  if item in start_state.world.grabbable_indices:\n    for action in range(env.world.n_actions - 1):  # Exclude USE action\n      _, new_state = start_state.step(action)\n      if new_state and new_state.satisfies(\"\", item):\n        return [action]\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:41:07.045552", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:41:08.176089", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:43:23.807302", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on Manhattan distance to the nearest required item\n    cookbook = state.world.cookbook\n    required_items = set(cookbook.recipes.get(goal, {}).keys()) - {USE}\n    \n    min_distance = float('inf')\n    for x in range(state.grid.shape[0]):\n      for y in range(state.grid.shape[1]):\n        if any(np.any(state.grid[x, y] == item) for item in required_items):\n          distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n          min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def a_star(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in [USE] + list(range(env.world.n_actions)):\n        reward, new_state = current_state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if new_state.pos == current_state.pos and action != USE:\n          continue\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        features_tuple = tuple(new_state.features())\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[features_tuple] = tentative_g_score\n          f_score[features_tuple] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[features_tuple], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_path_actions = []\n    while current in came_from:\n      _, action_list = came_from[current]\n      actions.extend(action_list)\n      current = came_from[current][0]\n    return list(reversed(actions))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:43:24.828222", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance heuristic\n    return sum(abs(a - b) for a, b in zip(state.pos, env.world.cookbook.index.get(goal)))\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = [(0, start_state, [])]\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in [USE] + list(range(env.world.n_actions)):\n        reward, new_state = current_state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if new_state.pos == current_state.pos and action != USE:\n          continue\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        features_tuple = tuple(new_state.features())\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[new_state] = (current_state, actions)\n          g_score[features_tuple] = tentative_g_score\n          f_score[features_tuple] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score[features_tuple], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = actions\n    while current_state in came_from:\n      prev_state, prev_actions = came_from[current_state]\n      total_path = prev_actions[:-1] + total_path\n      current_state = prev_state\n    return total_path\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:45:17.270905", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def is_reachable(start_state, goal_arg):\n      \"\"\"Check if the given state can lead to the goal item.\"\"\"\n      from collections import deque\n      \n      queue = deque([start_state])\n      visited_states = set()\n      \n      while queue:\n          current_state = queue.popleft()\n          \n          # Check if the current state satisfies the goal\n          if current_state.satisfies('default', goal_arg):\n              return True\n          \n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              if state_hash not in visited_states:\n                  queue.append(next_state)\n                  visited_states.add(state_hash)\n      \n      return False\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if is_reachable(start_state, goal_arg):\n      action_sequence = bfs(start_state, goal_name, goal_arg)\n      if action_sequence is not None:\n          return action_sequence\n      else:\n          raise ValueError(f\"No sequence of actions found to craft item {item}\")\n  else:\n      raise ValueError(f\"Goal item {item} is not reachable from the initial state.\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:45:18.357392", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(state, goal_arg):\n    \"\"\"Check if the given state can lead to the goal item.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(goal_arg)\n\n    # Check if all required primitives are available in the inventory or on the grid\n    for ingredient, count in primitives.items():\n      if state.inventory[ingredient] < count:\n        # Check if the ingredient is available on the grid\n        if not any(state.grid[:, :, ingredient].flatten()):\n          return False\n\n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:47:52.176824", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      # Heuristic based on the distance to the nearest occurrence of the goal item and inventory.\n      grid = state.grid\n      pos = state.pos\n      \n      # Find all positions with the goal item in the grid\n      goal_positions = np.argwhere(grid[:, :, goal] > 0)\n      \n      if len(goal_positions) == 0:\n          return float('inf')  # No heuristic value if no goal items are found\n      \n      # Calculate Manhattan distances from the agent's position to each goal position\n      distances = [abs(pos[0] - gp[0]) + abs(pos[1] - gp[1]) for gp in goal_positions]\n      \n      min_distance = min(distances)\n      \n      # Penalize states with fewer goal items in inventory\n      inventory_penalty = 1 / (state.inventory[goal] + 1)\n      \n      return min_distance + inventory_penalty\n\n  def bfs_with_heuristic(start_state, goal):\n      \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions = queue.popleft()\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Sort possible actions based on heuristic\n          actions_sorted = sorted(range(env.world.n_actions), key=lambda a: (heuristic(state.step(a)[1], goal), -a))\n          \n          for action in actions_sorted:\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.append((new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  def find_resources(env, start_state, primitives):\n      \"\"\"Find a path to gather all required primitive resources.\"\"\"\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions = queue.popleft()\n          \n          # Check if all primitives are collected\n          inventory = state.inventory\n          if all(inventory[p] > 0 for p in primitives):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.append((new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  \n  # Get required primitives for the goal item\n  primitives_dict = cookbook.primitives_for(item)\n  required_primitives = list(primitives_dict.keys())\n  \n  # Find a path to gather all required resources\n  resource_actions = find_resources(env, start_state, required_primitives)\n  \n  if resource_actions is None:\n      raise ValueError(\"No path to gather required resources found.\")\n  \n  # Execute resource gathering actions\n  current_state = start_state\n  for action in resource_actions:\n      _, current_state = current_state.step(action)\n  \n  # Find a path to craft the item with gathered resources\n  crafting_actions = bfs_with_heuristic(current_state, item)\n  \n  if crafting_actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n  \n  return resource_actions + crafting_actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:47:53.233092", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on the distance to the nearest occurrence of the goal item and inventory.\n    grid = state.grid\n    pos = state.pos\n    \n    # Find all positions with the goal item in the grid\n    goal_positions = np.argwhere(grid[:, :, goal] > 0)\n    \n    if len(goal_positions) == 0:\n      return float('inf')  # No heuristic value if no goal items are found\n    \n    # Calculate Manhattan distances from the agent's position to each goal position\n    distances = [abs(pos[0] - gp[0]) + abs(pos[1] - gp[1]) for gp in goal_positions]\n    \n    min_distance = min(distances)\n    \n    # Penalize states with fewer goal items in inventory\n    inventory_penalty = 1 / (state.inventory[goal] + 1)\n    \n    return min_distance + inventory_penalty\n\n  def bfs_with_heuristic(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Sort possible actions based on heuristic\n      actions_sorted = sorted(range(env.world.n_actions), key=lambda a: (heuristic(state.step(a)[1], goal), -a))\n      \n      for action in actions_sorted:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs_with_heuristic(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:49:06.564751", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:49:07.544737", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with priority queue.\"\"\"\n    from queue import PriorityQueue\n    \n    pq = PriorityQueue()\n    pq.put((0, start_state, []))  # (priority, state, actions)\n    visited = set([tuple(start_state.features())])\n    \n    while not pq.empty():\n      _, state, actions = pq.get()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          # Use the length of actions as priority to favor shorter paths\n          pq.put((len(actions) + 1, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:50:37.170141", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None\n        if new_state is None:\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:50:38.157544", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Ensure the new state is not None\n        if new_state is None:\n          continue\n        \n        state_tuple = tuple(new_state.features())\n        if state_tuple not in visited:\n          visited.add(state_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  \n  # Check if the item is already in inventory\n  if start_state.satisfies(\"\", item):\n    return []\n  \n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:53:33.818821", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting states that have the same feature representation\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path with heuristics.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function for A* search.\"\"\"\n    x1, y1 = state.pos\n    x2, y2 = env.scenario.init_pos  # Assuming initial position is a reference point\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  start_state = env._current_state\n  \n  # Try A* search first\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found using A*.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:53:34.794033", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance as heuristic for the A* search\n    x1, y1 = state.pos\n    x2, y2 = env.scenario.init_pos  # Assuming initial position is a goal point\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path.\"\"\"\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while not open_set.empty():\n          f_score, state, actions = open_set.get()\n          \n          if state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, state, actions)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              tentative_g_score = g_score[tuple(start_state.features())] + 1  # Cost of each step is 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[new_state] = (state, action)\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  open_set.put((f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n      total_actions = []\n      while current in came_from:\n          (prev_state, action) = came_from[current]\n          total_actions.append(action)\n          current = prev_state\n      return list(reversed(actions))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:55:08.451761", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T02:55:09.421738", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        grid_hash = tuple(map(tuple, next_state.grid))\n        inventory_hash = tuple(next_state.inventory)\n        pos_hash = next_state.pos\n        dir_hash = next_state.dir\n        state_hash = (grid_hash, inventory_hash, pos_hash, dir_hash)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:57:19.356086", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance as heuristic for the BFS search\n    x1, y1 = state.pos\n    x2, y2 = env.scenario.init_pos  # Assuming initial position is a goal point\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path using a heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))  # (f_score, state, actions)\n    \n    g_scores = {tuple(start_state.features()): 0}\n    f_scores = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_scores[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_scores[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_scores[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:57:20.322180", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple Manhattan distance as heuristic for the BFS search\n    x1, y1 = state.pos\n    x2, y2 = env.scenario.init_pos  # Assuming initial position is a goal point\n    return abs(x1 - x2) + abs(y1 - y2)\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path using heuristic.\"\"\"\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = []\n    while current_state in came_from:\n      prev_state, actions_to_here = came_from[current_state]\n      total_path.extend(actions_to_here)\n      current_state = prev_state\n    return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:59:07.190808", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic function: Manhattan distance to the nearest resource needed for the goal.\n    resources_needed = env.world.cookbook.primitives_for(goal)\n    \n    if not resources_needed:\n      return 0\n    \n    min_distance = float('inf')\n    grid = state.grid\n    pos = state.pos\n    width, height = grid.shape[0], grid.shape[1]\n    \n    for i_kind in resources_needed.keys():\n      for y in range(height):\n        for x in range(width):\n          if grid[x, y, i_kind] > 0:\n            distance = abs(x - pos[0]) + abs(y - pos[1])", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T02:59:08.236444", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with early exit on reaching goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action leads to a new, unvisited state\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:00:35.934513", "function_name": "craft", "function_body": "  def hash_state(state):\n      \"\"\"Creates a hashable representation of the state.\"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = hash_state(next_state)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:00:36.949239", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:02:25.033973", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n      \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n\n      while queue:\n          state, actions = queue.popleft()\n\n          if state.satisfies(\"\", goal):\n              return actions\n\n          # Check nearby cells for items to use\n          has_nearby_item = False\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  x, y = state.pos[0] + dx, state.pos[1] + dy\n                  if 0 <= x < env.world.WIDTH and 0 <= y < env.world.HEIGHT:\n                      if any(state.grid[x][y]):\n                          has_nearby_item = True\n                          break\n              if has_nearby_item:\n                  break\n\n          # Try USE action only if there's a nearby item\n          if has_nearby_item:\n              reward, new_state = state.step(USE)\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.append((new_state, actions + [USE]))\n\n          # Explore movement actions\n          for action in [UP, DOWN, LEFT, RIGHT]:\n              reward, new_state = state.step(action)\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  queue.append((new_state, actions + [action]))\n\n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:02:26.001530", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action only if there's a nearby item\n      if any(state.grid[state.pos[0]+dx][state.pos[1]+dy].any() \n             for dx in [-1, 0, 1] for dy in [-1, 0, 1]):\n        reward, new_state = state.step(USE)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [USE]))  # Prioritize USE action\n\n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:04:10.890028", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function: Manhattan distance to the nearest workbench.\"\"\"\n    workshop_indices = env.world.workshop_indices\n    pos_x, pos_y = state.pos\n    \n    min_distance = float('inf')\n    for workshop_index in workshop_indices:\n      workshop_pos = np.argwhere(state.grid[:, :, workshop_index])  # Get positions of the workbench\n      if workshop_pos.size > 0:  # If workbench exists in the grid\n        workshop_x, workshop_y = workshop_pos[0]  # Take the first one\n        distance = abs(workshop_x - pos_x) + abs(workshop_y - pos_y)\n        min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    g_costs = {tuple(start_state.features()): 0}\n    visited = set()\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if tuple(state.features()) in visited:\n        continue\n      \n      visited.add(tuple(state.features()))\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Calculate g_cost and f_cost\n        new_g_cost = g_costs[tuple(state.features())] + 1\n        if tuple(new_state.features()) not in g_costs or new_g_cost < g_costs[tuple(new_state.features())]:\n          g_costs[tuple(new_state.features())] = new_g_cost\n          f_cost = new_g_cost + heuristic(new_state, goal)\n          heappush(open_set, (f_cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:04:11.944374", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Only add to queue if the new state is valid and not visited\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:05:24.839103", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              \n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), \n                            next_state.pos, next_state.dir)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:05:25.808459", "function_name": "craft", "function_body": "  def heuristic(current_state, goal_arg):\n      # Simple heuristic: count the difference in inventory counts for the goal item\n      return abs(goal_arg - current_state.inventory[goal_arg])\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      open_set = [(heuristic(start_state, goal_arg), start_state, [])]\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = open_set.pop(0)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  priority = heuristic(next_state, goal_arg) + len(actions_taken) + 1\n                  open_set.append((priority, next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n          # Sort the open set by priority (heuristic value)\n          open_set.sort()\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:08:09.684315", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if tuple(new_state.features()) == tuple(state.features()):\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:08:10.670898", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if not new_state.satisfies(\"\", goal) and tuple(new_state.features()) == tuple(state.features()):\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n      if state.satisfies(\"\", goal):\n          return 0\n      else:\n          return 1  # Simple heuristic that returns 1 for all non-goal states\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path with a heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = current_state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if not new_state.satisfies(\"\", goal) and tuple(new_state.features()) == tuple(current_state.features()):\n          continue\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        features_tuple = tuple(new_state.features())\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n            came_from[new_state] = current_state\n            g_score[features_tuple] = tentative_g_score\n            f_score = tentative_g_score + heuristic(new_state, goal)\n            heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n      \"\"\"Reconstructs the path from start to goal.\"\"\"\n      total_actions = []\n      \n      while current in came_from:\n          previous = came_from[current]\n          total_actions.insert(0, actions[len(total_actions)])\n          current = previous\n      \n      return total_actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:09:23.160734", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:09:24.205566", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:10:54.857733", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action when near the goal\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE and state.next_to(goal):\n            queue.appendleft((new_state, actions + [action]))  # Prioritize immediate useful USE actions\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:10:55.962291", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action when near the goal\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE and state.next_to(goal):\n            queue.appendleft((new_state, actions + [action]))  # Prioritize immediate useful USE actions\n          elif action == USE:\n            queue.append((new_state, actions + [action]))  # Next prioritize other USE actions\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:12:34.627648", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment scenario and start state\n  try:\n    start_scenario = env.scenario\n    start_state = start_scenario.init()\n    \n    goal_name = 'default'  # Assuming a default goal name for now\n    goal_arg = item\n    \n    # Use BFS to find the action sequence\n    action_sequence = bfs(start_state, goal_name, goal_arg)\n    \n    if action_sequence is not None:\n      return action_sequence\n    else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")\n      \n  except Exception as e:\n    print(f\"An error occurred: {e}\")\n    return []", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T03:12:35.618967", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = hash(next_state)  # Using a custom hash function for CraftState\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def hash(state):\n    \"\"\"Custom hash function for CraftState.\"\"\"\n    grid_flat = tuple(state.grid.flatten())\n    inventory_tuple = tuple(state.inventory)\n    position_tuple = state.pos\n    direction = state.dir\n    return hash((grid_flat, inventory_tuple, position_tuple, direction))\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Use BFS to find the action sequence\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T03:14:43.333774", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Prune unreachable actions based on the current state's inventory\n      reachable_actions = prune_unreachable_actions(current_state)\n\n      for action in reachable_actions:\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def prune_unreachable_actions(current_state):\n    \"\"\"Prune actions that lead to unreachable states.\"\"\"\n    reachable_actions = []\n    for action in range(env.world.n_actions):\n      _, next_state = current_state.step(action)\n      \n      # Check if the next state is reachable based on the current inventory\n      if can_reach_goal(next_state, goal_arg):\n        reachable_actions.append(action)\n    \n    return reachable_actions\n\n  def can_reach_goal(state, goal_arg):\n    \"\"\"Check if the state can be reached with the current resources to achieve the goal.\"\"\"\n    # This function should check if all required ingredients are available or can be crafted\n    # For now, assume a simple heuristic based on inventory counts\n\n    if state.inventory[goal_arg] > 0:\n      return True\n    \n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    \n    for prim_index, count in primitives.items():\n      if state.inventory[prim_index] < count:\n        return False\n    \n    return True\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
