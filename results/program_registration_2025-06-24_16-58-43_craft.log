{"timestamp": "2025-06-25T14:51:49.141179", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:51:50.182478", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = hash(tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:52:18.300618", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  \n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:52:19.405985", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  \n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:53:13.455768", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the count of the goal item in the inventory and proximity to required ingredients\n    inventory_count = state.inventory[goal]\n    if inventory_count > 0:\n      return 0\n    \n    required_ingredients = env.world.cookbook.primitives_for(goal)\n    \n    # Calculate the minimum Manhattan distance to any required ingredient\n    min_distance = float('inf')\n    for i_kind in required_ingredients.keys():\n      if state.next_to(i_kind):\n        return 1  # Immediate proximity to a required ingredient\n    \n    for x in range(env.world.grid_size[0]):\n      for y in range(env.world.grid_size[1]):\n        if np.any(state.grid[x, y] == list(required_ingredients.keys())):\n          distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n          min_distance = min(min_distance, distance)\n    \n    return 1 + min_distance\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions based on heuristic\n      queue.extend(sorted(use_actions, key=lambda x: heuristic(x[0], goal)))\n      queue.extend(sorted(priority_actions, key=lambda x: heuristic(x[0], goal)))\n      queue.extend(sorted(other_actions, key=lambda x: heuristic(x[0], goal)))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:53:14.423049", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      # Simple heuristic based on the count of the goal item in the inventory\n      return -state.inventory[goal] + sum(state.inventory[i] for i in state.world.cookbook.primitives_for(goal) if state.next_to(i))\n\n  def astar(start_state, goal):\n      from collections import deque\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      \n      visited = set([tuple(start_state.features())])\n      \n      while open_set:\n          _, state, actions = heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  cost = len(actions) + 1\n                  heappush(open_set, (cost + heuristic(new_state, goal), new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:54:01.380111", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:54:02.373273", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n      # A simple heuristic based on the number of items needed in the inventory\n      goal_recipe = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = state.inventory.copy()\n      \n      missing_items_count = sum(max(0, count - current_inventory[i]) for i, count in goal_recipe.items())\n      return missing_items_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm to find the optimal sequence of actions.\"\"\"\n    import heapq\n    from collections import defaultdict\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,)] = 0\n    f_score = defaultdict(lambda: float('inf'))\n    f_score[tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,)] = heuristic(start_state, goal_arg)\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n          _, next_state = current_state.step(action)\n          next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          tentative_g_score = g_score[state_hash] + 1\n          \n          if tentative_g_score < g_score[next_state_hash]:\n              came_from[next_state_hash] = (state_hash, action)\n              g_score[next_state_hash] = tentative_g_score\n              f_score[next_state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n              heapq.heappush(open_set, (f_score[next_state_hash], next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:54:45.782995", "function_name": "craft", "function_body": "  def satisfies(state, goal_arg):\n      return state.inventory[goal_arg] > 0\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      # Create a hashable representation of the state\n      state_hash = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)\n\n      if satisfies(current_state, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        next_state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if next_state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(next_state_hash)\n\n    return None\n\n  # Initialize the environment\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:54:46.737876", "function_name": "craft", "function_body": "  def satisfies(state, goal_arg):\n      return state.inventory[goal_arg] > 0\n\n  def heuristic(state, goal_arg):\n    # Simple heuristic: count the number of items needed to make the goal\n    cookbook = env.world.cookbook\n    if goal_arg not in cookbook.recipes:\n        return float('inf')  # If no recipe for the item, it's unreachable\n    recipe = cookbook.recipes[goal_arg]\n    \n    # Calculate the total number of ingredients needed\n    ingredient_count = sum(recipe.values())\n    return ingredient_count\n\n  def a_star(start_state, goal_arg):\n      \"\"\"A* search algorithm to find the optimal sequence of actions.\"\"\"\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))  # (f_score, state, path)\n      g_scores = {start_state: 0}\n      \n      while open_set:\n          _, current_state, actions_taken = heappop(open_set)\n          \n          if satisfies(current_state, goal_arg):\n              return actions_taken\n          \n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              tentative_g_score = g_scores[current_state] + 1  # Assuming each step has a cost of 1\n\n              if next_state not in g_scores or tentative_g_score < g_scores[next_state]:\n                  g_scores[next_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                  heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:55:23.652485", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n    \"\"\"Simple heuristic: number of items missing from inventory to reach the goal.\"\"\"\n    required_items = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory\n    return sum(required_items.get(i, 0) - current_inventory[i] for i in required_items)\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:55:24.697320", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Skip invalid moves (e.g., moving into walls or out of bounds)\n        if reward < 0:\n          continue\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
