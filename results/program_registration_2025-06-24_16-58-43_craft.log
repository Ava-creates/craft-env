{"timestamp": "2025-06-25T10:10:23.107508", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, reward, next_state))\n      return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, reward, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:10:24.155111", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:11:59.727713", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(new_state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic to prioritize states that are closer to having the ingredients.\"\"\"\n      # Placeholder heuristic: count of items needed in inventory\n      recipe = env.world.cookbook.primitives_for(goal)\n      current_inventory = state.inventory\n      missing_count = sum(max(0, count - current_inventory[idx]) for idx, count in recipe.items())\n      return missing_count\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:12:00.784117", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(new_state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  def heuristic(state, goal):\n      \"\"\"Simple heuristic: number of items needed to craft the goal.\"\"\"\n      primitives = env.world.cookbook.primitives_for(goal)\n      inventory_items = state.inventory.nonzero()[0]\n      \n      # Calculate the minimum number of steps required based on available resources\n      steps_required = sum(primitives.get(i, 0) for i in primitives if i not in inventory_items)\n      \n      return steps_required\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:13:32.505806", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions based on heuristic\n      queue.extend(sorted(priority_actions, key=lambda x: heuristic(x[0], goal)))\n      queue.extend(sorted(use_actions, key=lambda x: heuristic(x[0], goal)))\n      queue.extend(sorted(other_actions, key=lambda x: heuristic(x[0], goal)))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:13:33.552366", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic function to prioritize states closer to the goal.\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions based on heuristic\n      queue.extend(sorted(priority_actions, key=lambda x: (heuristic(x[0], goal), len(x[1]))))\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:14:49.479782", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  # Breadth-first search with heuristic: prioritize states that have more of the desired item\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                # Heuristic: Prioritize states that have more of the desired item\n                priority = -next_state.inventory[goal_arg]\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:14:50.468946", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  # Breadth-first search with priority queue and heuristic\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n      import heapq\n      \n      queue = []\n      heapq.heappush(queue, (0, start_state, []))  # Priority, state, actions_taken\n      visited_states = set()\n\n      while queue:\n          _, current_state, actions_taken = heapq.heappop(queue)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          hash_val = state_hash(current_state)\n          \n          if hash_val not in visited_states:\n              # Generate all possible next states\n              for action, reward, next_state in get_possible_actions(current_state):\n                  priority = -next_state.inventory[goal_arg]  # Heuristic: prioritize more of the desired item\n                  heapq.heappush(queue, (priority, next_state, actions_taken + [action]))\n              visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:16:15.343814", "function_name": "craft", "function_body": "  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  def get_possible_actions(current_state):\n    \"\"\"Generate all possible actions from the current state and their respective next states.\"\"\"\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, next_state))\n    return actions\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to prioritize states that have more of the desired item.\"\"\"\n    return -state.inventory[goal_arg]\n\n  def bfs_with_heuristic(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search with a heuristic to find the sequence of actions.\"\"\"\n    queue = [(start_state, [], 0)]\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken, accumulated_reward = queue.pop(0)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                priority = heuristic(next_state, goal_arg) + accumulated_reward\n                queue.append((next_state, actions_taken + [action], priority))\n                visited_states.add(hash_val)\n\n        # Sort the queue based on priority (heuristic value)\n        queue.sort(key=lambda x: x[2])\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs_with_heuristic(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:16:16.336413", "function_name": "craft", "function_body": "  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  def get_possible_actions(current_state):\n    \"\"\"Generate all possible actions from the current state and their respective next states.\"\"\"\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Higher inventory of the desired item means closer to the goal\n    return -state.inventory[goal_arg]\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search to find the sequence of actions with optimal cost using heuristic.\"\"\"\n    open_set = [(0, start_state, [])]  # Priority queue (cost, state, actions_taken)\n    visited_states = set()\n\n    while open_set:\n        current_cost, current_state, actions_taken = open_set.pop(0)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                new_cost = current_cost - reward + heuristic(next_state, goal_arg)  # Updated cost calculation\n                open_set.append((new_cost, next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n        # Sort the open set by cost to simulate a priority queue\n        open_set.sort(key=lambda x: x[0])\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:16:59.031135", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        # Avoid infinite loops by checking if the inventory has changed meaningfully\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:17:00.077533", "function_name": "craft", "function_body": "  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid infinite loops by checking if the inventory has changed meaningfully\n        new_features = tuple(new_state.features())\n        if new_features not in visited:\n          visited.add(new_features)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:18:17.308842", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    return tuple(state.grid.flatten()) +\\\n           tuple(state.inventory) +\\\n           (state.pos,) +\\\n           (state.dir,)\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:18:18.533080", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      if next_state is not None:\n        yield action, next_state\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state in get_possible_actions(current_state):\n        hash_val = tuple(next_state.grid.flatten()) +\\\n                   tuple(next_state.inventory) +\\\n                   (next_state.pos,) +\\\n                   (next_state.dir,)\n        \n        if hash_val not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(hash_val)\n\n    return None\n\n  def is_goal_reachable(start_state, goal_name, goal_arg):\n    # Use a simplified BFS to check reachability without storing full state history\n    from collections import deque\n\n    queue = deque([start_state])\n    visited_hashes = set()\n    \n    while queue:\n      current_state = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return True\n\n      # Generate all possible next states\n      for _, next_state in get_possible_actions(current_state):\n        hash_val = tuple(next_state.grid.flatten()) +\\\n                   tuple(next_state.inventory) +\\\n                   (next_state.pos,) +\\\n                   (next_state.dir,)\n        \n        if hash_val not in visited_hashes:\n          queue.append(next_state)\n          visited_hashes.add(hash_val)\n\n    return False\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if not is_goal_reachable(start_state, goal_name, goal_arg):\n    raise ValueError(f\"Goal item {item} is not reachable in the current scenario.\")\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:19:35.739206", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          state, actions = queue.popleft()\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action and then prioritize movement actions that lead to USE\n          priority_actions = []\n          use_actions = []\n          other_actions = []\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  if action == USE:\n                      use_actions.append((new_state, actions + [action]))\n                  else:\n                      # Check if the next state allows a USE action\n                      for next_action in range(env.world.n_actions):\n                          _, _ = new_state.step(next_action)\n                          if next_action == USE and tuple(new_state.features()) not in visited:\n                              priority_actions.append((new_state, actions + [action]))\n                              break\n                      else:\n                          other_actions.append((new_state, actions + [action]))\n          \n          # Extend queue with prioritized actions based on heuristic\n          queue.extend(sorted(priority_actions, key=lambda x: heuristic(x[0], goal)))\n          queue.extend(sorted(use_actions, key=lambda x: heuristic(x[0], goal)))\n          queue.extend(sorted(other_actions, key=lambda x: heuristic(x[0], goal)))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:19:36.722429", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n      # Simple heuristic based on the count of the goal item in the inventory\n      return state.inventory[goal] < 1\n  \n  def a_star(start_state, goal):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate neighbors and prioritize USE action\n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Calculate the priority (f(n) = g(n) + h(n))\n          g_n = len(actions) + 1\n          h_n = heuristic(new_state, goal)\n          f_n = g_n + h_n\n          \n          if action == USE:\n            heapq.heappush(open_set, (f_n - 1, new_state, actions + [action]))  # Prioritize USE\n          else:\n            heapq.heappush(open_set, (f_n, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:20:29.686915", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the distance to the goal.\"\"\"\n    # For simplicity, we use a Manhattan distance between positions\n    current_pos = state.pos\n    goal_pos = np.argwhere(env.scenario.init_grid[:, :, goal])[0]\n    return abs(current_pos[0] - goal_pos[0]) + abs(current_pos[1] - goal_pos[1])\n\n  start_state = env._current_state\n  actions = astar(start_state, goal)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:20:30.744681", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:22:47.557701", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_nearest_resource(env, resource_index):\n      \"\"\"Finds the nearest position of a given resource index on the grid.\"\"\"\n      current_pos = env._current_state.pos\n      width, height = env.world.grid.shape[:2]\n      \n      for distance in range(1, max(width, height) + 1):\n          for dx in range(-distance, distance + 1):\n              for dy in range(-distance, distance + 1):\n                  if abs(dx) + abs(dy) == distance:\n                      x = current_pos[0] + dx\n                      y = current_pos[1] + dy\n                      \n                      if 0 <= x < width and 0 <= y < height and env._current_state.grid[x, y, resource_index] > 0:\n                          return (x, y)\n      \n      return None\n\n  def move_to_position(env, target_pos):\n      \"\"\"Generates actions to move the agent from its current position to a target position.\"\"\"\n      UP = 0\n      DOWN = 1\n      LEFT = 2\n      RIGHT = 3\n      \n      current_pos = env._current_state.pos\n      actions = []\n      \n      while current_pos != target_pos:\n          dx = target_pos[0] - current_pos[0]\n          dy = target_pos[1] - current_pos[1]\n          \n          if dx > 0:\n              actions.append(DOWN)\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif dx < 0:\n              actions.append(UP)\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          \n          if dy > 0:\n              actions.append(RIGHT)\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif dy < 0:\n              actions.append(LEFT)\n              current_pos = (current_pos[0], current_pos[1] - 1)\n      \n      return actions\n\n  def gather_resources(env, goal):\n      \"\"\"Gathers all required resources for crafting the item.\"\"\"\n      cookbook = env.world.cookbook\n      start_state = env._current_state\n      \n      if goal not in cookbook.recipes:\n          raise ValueError(f\"No recipe found for item index {goal}.\")\n      \n      recipe = cookbook.recipes[goal]\n      actions = []\n      \n      for resource_index, count in recipe.items():\n          if resource_index == \"_key\":\n              continue  # Skip the \"_key\" entry\n          \n          while start_state.inventory[resource_index] < count:\n              nearest_pos = find_nearest_resource(env, resource_index)\n              \n              if not nearest_pos:\n                  raise ValueError(f\"No resource found with index {resource_index}.\")\n              \n              actions.extend(move_to_position(env, nearest_pos))\n              actions.append(USE)  # Pick up the resource\n              env._current_state, _ = env._current_state.step(USE)\n      \n      return actions\n\n  start_state = env._current_state\n  \n  if item not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe found for item index {item}.\")\n  \n  gather_actions = gather_resources(env, item)\n  craft_actions = bfs(start_state, item)\n  \n  if not craft_actions:\n      raise ValueError(\"No path to craft the item found.\")\n  \n  return gather_actions + craft_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:22:48.533817", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of items in inventory that are not the goal\n    return np.sum(state.inventory) - state.inventory[goal]\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          \n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:24:25.879809", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function using Manhattan distance.\"\"\"\n    # Placeholder for a better heuristic if needed\n    return 0\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:24:26.896906", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function for A* search.\"\"\"\n    # Simple Manhattan distance between positions (assuming grid layout)\n    return abs(state.pos[0] - goal.pos[0]) + abs(state.pos[1] - goal.pos[1])\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_scores = {tuple(start_state.features()): 0}\n    f_scores = {tuple(start_state.features()): heuristic(start_state, goal)}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", item):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_scores[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_scores[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_scores[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  # Create a dummy goal state that satisfies the item to guide the search\n  goal_state = CraftState(scenario=start_state.scenario,\n                           grid=np.copy(start_state.grid),\n                           pos=start_state.pos,\n                           dir=start_state.dir,\n                           inventory=np.zeros(env.world.n_kinds))\n  \n  goal_state.inventory[item] = 1  # This is just a dummy to guide the search\n\n  actions = a_star(start_state, goal_state)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:25:31.212673", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      # Check if the goal is satisfied\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  # Initialize the scenario and start state with a specific goal item\n  env.reset()\n  start_scenario = CraftScenario(\n      grid=env.world.random.choice(range(env.world.n_kinds), size=(10, 10, env.world.n_kinds), replace=True),\n      init_pos=(5, 5),\n      world=env.world\n  )\n  \n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:25:32.313217", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n    \n    return None\n\n  # Reset the environment to get a new scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:26:32.927420", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Use a more efficient hash by combining key state elements\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_valid_goal(item):\n    \"\"\"Check if the item is a valid crafting goal.\"\"\"\n    return item in env.world.cookbook.kinds\n\n  # Ensure the item is valid\n  if not is_valid_goal(item):\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  action_sequence = bfs(env.scenario.init(), item)\n  \n  if action_sequence:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:26:34.173237", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Use a more efficient hash by combining key state elements\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the item is valid\n  if item not in env.world.cookbook.kinds:\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  action_sequence = bfs(env.scenario.init(), item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:27:50.455127", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: Manhattan distance from the current position to a hypothetical target position.\n    # Since we don't have a specific target position, we can use the goal item's index as a proxy.\n    # This is a placeholder and should be replaced with a more meaningful heuristic if possible.\n\n    # For now, return 0 for simplicity\n    return 0\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[new_state] = current_state\n          g_score[features_tuple] = tentative_g_score\n          f_score[features_tuple] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[features_tuple], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_actions = []\n    while current_state in came_from:\n      total_actions.append(actions[-1])\n      current_state = came_from[current_state]\n      actions = actions[:-1]\n    return total_actions[::-1]\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:27:51.544323", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:29:10.555204", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of items needed for the goal that are not in inventory\n    required_items = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    missing_count = sum(required_items.get(i, 0) - current_inventory[i] for i in required_items)\n    return missing_count\n\n  def a_star(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, state, actions = open_set.get()\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n      total_path = []\n      while tuple(current.features()) in came_from:\n          (current, actions) = came_from[tuple(current.features())]\n          total_path.append(actions[-1])\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:29:11.737029", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          # Avoid unnecessary movements by checking the direction\n          if (action == UP and state.dir == DOWN) or\\\n             (action == DOWN and state.dir == UP) or\\\n             (action == LEFT and state.dir == RIGHT) or\\\n             (action == RIGHT and state.dir == LEFT):\n              continue  # Skip opposite movement\n\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:30:12.835668", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: distance from the current inventory to the goal inventory\n    if state.inventory[goal] > 0:\n      return 0\n    else:\n      return 1\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        features_tuple = tuple(new_state.features())\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[actions + [action]] = actions\n          g_score[features_tuple] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n    total_path = []\n    while current in came_from:\n      total_path.append(current[-1])\n      current = came_from[current]\n    return total_path[::-1]\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:30:13.877250", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Check if the move leads to a valid and unvisited state\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:31:40.608563", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T10:31:41.607774", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n\n  def a_star(start_state, goal):\n    from collections import deque\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    visited = set()\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if tuple(current_state.features()) in visited:\n          continue\n      \n      visited.add(tuple(current_state.features()))\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T10:33:02.970029", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Simple heuristic: prioritize states with more items in inventory towards the goal.\n    return -state.inventory[item]\n\n  def a_star(start_state, goal):\n      \"\"\"A* search to find the shortest path.\"\"\"\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state), start_state, []))\n      \n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state)}\n      \n      while open_set:\n          _, current_state, actions = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (current_state, actions + [action])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state)\n                  heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
