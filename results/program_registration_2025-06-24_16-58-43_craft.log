{"timestamp": "2025-06-25T13:33:27.601788", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  \n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:34:50.297039", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def heuristic(state, goal):\n      # Simple heuristic: Count number of primitives needed for the goal\n      recipe = env.world.cookbook.recipes.get(goal)\n      if not recipe:\n          return float('inf')\n      \n      required_primitives = {}\n      queue = [goal]\n      \n      while queue:\n          current_goal = queue.pop()\n          current_recipe = env.world.cookbook.recipes.get(current_goal)\n          \n          if current_recipe is None:  # Primitive or no recipe\n              kind_name = env.world.cookbook.index.get(goal, \"\")\n              if kind_name in env.world.cookbook.primitives:\n                  required_primitives[current_goal] = required_primitives.get(current_goal, 0) + 1\n              continue\n      \n          for ingredient, count in current_recipe.items():\n              if ingredient == \"_key\":\n                  continue\n              queue.append(ingredient)\n      \n      # Calculate the heuristic as the sum of counts of primitives needed\n      total_primitives = sum(state.inventory[prim] >= req_count for prim, req_count in required_primitives.items())\n      return len(required_primitives) - total_primitives\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search with heuristic.\"\"\"\n    from collections import deque\n    \n    open_set = [(0 + heuristic(start_state, goal), start_state, [])]\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      f_score, state, actions = open_set.pop(0)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              f = len(actions) + 1 + heuristic(new_state, goal)\n              open_set.append((f, new_state, actions + [action]))\n              open_set.sort(key=lambda x: x[0])\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:34:51.398873", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Check if the current state already satisfies the goal\n    if state.satisfies(\"\", goal):\n      return 0\n    \n    # Calculate a simple heuristic: number of steps taken so far (penalize inventory size)\n    inventory_size = np.sum(state.inventory)\n    return inventory_size\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization and early stopping.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [], 0)])  # state, actions, cost\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions, cost = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Calculate new cost with heuristic\n        new_cost = cost + 1 + heuristic(new_state, goal)\n\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action], new_cost))\n          queue = deque(sorted(queue, key=lambda x: x[2]))  # Sort by new cost\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:36:05.486711", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Check if the item is crafted directly\n              if new_state.inventory[goal] > 0:\n                  return actions + [action]\n              \n              if action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:36:06.489878", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Collect actions with prioritization\n      use_actions, other_actions = [], []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_actions.append((new_state, actions + [action]))\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add all USE actions first\n      queue.extendleft(reversed(use_actions))\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:37:09.832932", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      move_towards_primitives_actions = []\n      other_actions = []\n\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          elif any(new_state.next_to(primitive) for primitive in env.world.cookbook.primitives_for(goal)):\n            move_towards_primitives_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(use_actions)\n      queue.extend(move_towards_primitives_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:37:10.855409", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      move_towards_primitives_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          elif any(new_state.next_to(primitive) for primitive in env.world.cookbook.primitives_for(goal)):\n            move_towards_primitives_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(use_actions)\n      queue.extend(move_towards_primitives_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:39:24.996399", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Add a penalty to avoid picking up the same item multiple times unnecessarily\n        if action == USE_ACTION and env._extra_pickup_penalty > 0:\n          reward -= env._extra_pickup_penalty\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic to estimate the cost from current_state to the goal.\"\"\"\n    # Simple heuristic: count of items needed\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = current_state.inventory\n    \n    missing_items_count = sum(max(0, count - current_inventory[prim]) for prim, count in primitives.items())\n    return missing_items_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for the shortest path to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      current_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state)\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Add a penalty to avoid picking up the same item multiple times unnecessarily\n        if action == USE_ACTION and env._extra_pickup_penalty > 0:\n          reward -= env._extra_pickup_penalty\n        \n        next_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[current_hash] + 1  # Assuming each action has a cost of 1\n\n        if next_hash not in g_score or tentative_g_score < g_score[next_hash]:\n          came_from[next_hash] = current_state\n          g_score[next_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current):\n    \"\"\"Reconstruct the path from start to current.\"\"\"\n    total_path = []\n    while current in came_from:\n      total_path.append(current)\n      current = came_from[current]\n    total_path.reverse()\n    # Extract actions taken\n    actions_taken = []\n    for i in range(1, len(total_path)):\n      prev_state, current_state = total_path[i-1], total_path[i]\n      for action in range(env.world.n_actions):\n        _, next_state = prev_state.step(action)\n        if np.array_equal(next_state.grid, current_state.grid) and np.array_equal(next_state.inventory, current_state.inventory) \\\n           and next_state.pos == current_state.pos and next_state.dir == current_state.dir:\n          actions_taken.append(action)\n    return actions_taken\n\n  # Define the USE action index\n  global USE_ACTION\n  USE_ACTION = 4  # Assuming USE is the last action (index 4)\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T13:39:26.098474", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Add a penalty to avoid picking up the same item multiple times unnecessarily\n              if action == USE_ACTION and env._extra_pickup_penalty > 0:\n                  reward -= env._extra_pickup_penalty\n              \n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir,\n                  frozenset(next_state._cached_features_dict.items()) if next_state._cached_features_dict else None\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Define the USE action index\n  global USE_ACTION\n  USE_ACTION = 4  # Assuming USE is the last action (index 4)\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T13:41:15.804435", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n      # Simple heuristic: count the number of items needed to craft the goal\n      required_items = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = current_state.inventory\n      \n      total_missing_count = sum(\n          max(0, required_count - current_inventory[item_index])\n          for item_index, required_count in required_items.items()\n      )\n      \n      return total_missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n    visited_states = set()\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable representation of the state\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          heapq.heappush(\n              open_set,\n              (len(actions_taken) + 1 + heuristic(next_state, goal_arg),\n               next_state,\n               actions_taken + [action])\n          )\n          visited_states.add(state_hash)\n\n    return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define the goal using the item index\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Perform A* search to find the action sequence\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
