{"timestamp": "2025-06-25T14:34:14.692177", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  try:\n      start_scenario = env.scenario\n  except AttributeError:\n      raise ValueError(\"The environment does not have a valid scenario set up.\")\n  \n  try:\n      start_state = start_scenario.init()\n  except Exception as e:\n      raise ValueError(f\"Failed to initialize the scenario: {e}\")\n\n  # Define goal parameters\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  if goal_arg not in env.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"The item index {item} is not valid or does not have a recipe.\")\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {goal_arg}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:34:15.751652", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def dfs(start_state, goal_name, goal_arg, max_depth=10):\n    \"\"\"Depth-first search for a sequence of actions to achieve the goal with depth limit.\"\"\"\n    stack = [(start_state, [])]\n    visited_states = set()\n\n    while stack:\n      current_state, actions_taken = stack.pop()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      if len(actions_taken) >= max_depth:\n        continue\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          stack.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is None:\n      action_sequence = dfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:35:29.805508", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else (1 if new_state.next_to(goal) else 2)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  def optimize_actions(actions):\n    \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n    optimized_actions = []\n    for action in actions:\n      if not (optimized_actions and action == optimized_actions[-1]):\n        optimized_actions.append(action)\n    \n    return optimized_actions\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  optimized_actions = optimize_actions(actions)\n  return optimized_actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:35:30.782963", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  def optimize_actions(actions):\n    \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n    optimized_actions = []\n    for action in actions:\n      if optimized_actions and action == USE and optimized_actions[-1] != USE:\n        optimized_actions.append(USE)\n      elif not (optimized_actions and action == optimized_actions[-1]):\n        optimized_actions.append(action)\n    \n    return optimized_actions\n\n  def find_item_positions(grid, item):\n    \"\"\"Finds all positions of a specific item in the grid.\"\"\"\n    positions = []\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if np.any(grid[y, x] == item):\n                positions.append((y, x))\n    return positions\n\n  def move_to_position(state, target_pos):\n      \"\"\"Generates actions to move the agent to the target position.\"\"\"\n      current_y, current_x = state.pos\n      target_y, target_x = target_pos\n      \n      actions = []\n      \n      # Move in Y direction\n      while current_y < target_y:\n          actions.append(DOWN)\n          current_y += 1\n      while current_y > target_y:\n          actions.append(UP)\n          current_y -= 1\n      \n      # Move in X direction\n      while current_x < target_x:\n          actions.append(RIGHT)\n          current_x += 1\n      while current_x > target_x:\n          actions.append(LEFT)\n          current_x -= 1\n      \n      return actions\n\n  start_state = env._current_state\n  item_positions = find_item_positions(start_state.grid, item)\n\n  if not item_positions:\n    raise ValueError(\"Item positions not found in the grid.\")\n\n  all_actions = []\n  for pos in item_positions:\n      move_actions = move_to_position(start_state, pos)\n      all_actions.extend(move_actions)\n      all_actions.append(USE)  # Attempt to use the item\n\n      # Check if goal is satisfied after each use\n      new_state = start_state\n      for action in all_actions:\n          _, new_state = new_state.step(action)\n      \n      if new_state.satisfies(\"\", item):\n          break\n\n  optimized_actions = optimize_actions(all_actions)\n\n  return optimized_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:36:04.536497", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Only consider valid moves (reward >= 0 indicates a valid move)\n        if reward >= 0:\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          \n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n            visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:36:05.581756", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  \n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:37:21.184899", "function_name": "craft", "function_body": "  def heuristic(state, goal_index):\n      # Simple heuristic: number of items needed minus what we have\n      needed_items = env.world.cookbook.primitives_for(goal_index)\n      current_inventory = state.inventory\n\n      missing_count = sum(\n          max(0, needed - current_inventory[idx])\n          for idx, needed in needed_items.items()\n      )\n      \n      return missing_count\n\n  def astar(start_state, goal_index):\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {start_state: 0}\n    f_score = {start_state: heuristic(start_state, goal_index)}\n\n    while open_set:\n      _, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies('default', goal_index):\n        return reconstruct_path(came_from, current_state, actions_taken)\n\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          tentative_g_score = g_score[current_state] + 1  # Assume step cost is 1\n\n          state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n          if next_state not in g_score or tentative_g_score < g_score[next_state]:\n              came_from[next_state] = (current_state, actions_taken + [action])\n              g_score[next_state] = tentative_g_score\n              f_score[next_state] = tentative_g_score + heuristic(next_state, goal_index)\n              heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = []\n      while current_state in came_from:\n          prev_state, action_list = came_from[current_state]\n          total_path = action_list[-1:] + total_path\n          current_state = prev_state\n      return total_path\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = astar(start_state, goal_index)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:37:22.164270", "function_name": "craft", "function_body": "  def a_star_search(start_state, goal_index):\n    from heapq import heappop, heappush\n    from collections import defaultdict\n\n    # Priority queue for A* search\n    open_set = []\n    heappush(open_set, (0, start_state, []))\n\n    # Sets to track visited states and g-scores (cost from start to current state)\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[(tuple(start_state.grid.flatten()), tuple(start_state.inventory), start_state.pos, start_state.dir)] = 0\n\n    while open_set:\n      _, current_state, actions_taken = heappop(open_set)\n\n      # Check if the goal is reached\n      if current_state.satisfies('default', goal_index):\n        return reconstruct_path(came_from, current_state, actions_taken)\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        tentative_g_score = g_score[(tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)] + 1\n        \n        if tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = (current_state, actions_taken + [action])\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_index)\n          heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n    return None\n\n  def heuristic(state, goal_index):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # Simple heuristic: number of items needed minus what's already in inventory\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    current_inventory = {i: count for i, count in enumerate(state.inventory) if count > 0}\n    \n    missing_items_count = sum(primitives_needed.get(i, 0) - current_inventory.get(i, 0) for i in primitives_needed.keys())\n    return max(1, missing_items_count)\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n    total_path = []\n    state_hash = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)\n    \n    while state_hash in came_from:\n      current_state, actions_taken = came_from[state_hash]\n      total_path.append(actions_taken[-1])\n      state_hash = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)\n    \n    return list(reversed(total_path))\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = a_star_search(start_state, goal_index)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:38:02.051206", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash((tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:38:03.043165", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n    # Simple heuristic: number of items needed minus current count\n    primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n    current_inventory = state.inventory\n    \n    return sum(max(count - current_inventory[primitive], 0) for primitive, count in primitives_needed.items())\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    from heapq import heappush, heappop\n\n    # Priority queue: (f_score, g_score, state, actions_taken)\n    open_set = [(heuristic(start_state, goal_arg), 0, start_state, [])]\n    visited_states = set()\n\n    while open_set:\n      f_score, g_score, current_state, actions_taken = heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          tentative_g_score = g_score + 1\n          h_score = heuristic(next_state, goal_arg)", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:38:31.681034", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
