{"timestamp": "2025-06-25T08:06:09.228583", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    queue = [(start_state, [])]\n    visited_states = set()\n    \n    while queue:\n      current_state, actions_taken = queue.pop(0)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:07:20.413763", "function_name": "craft", "function_body": "  # Define constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Check if the inventory has changed (indicates an item was picked up or used)\n        if np.any(next_state.inventory != current_state.inventory) and action == USE:\n          # Prioritize these actions by adding them to the front of the queue\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          if state_hash not in visited_states:\n            queue.insert(0, (next_state, actions_taken + [action]))\n        else:\n          # Otherwise, add them to the end of the queue\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          if state_hash not in visited_states:\n            queue.append((next_state, actions_taken + [action]))\n\n        visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:07:21.400181", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          # Prioritize actions that lead to inventory changes\n          if np.any(next_state.inventory != current_state.inventory):\n            queue.insert(0, (next_state, actions_taken + [action]))\n          else:\n            queue.append((next_state, actions_taken + [action]))\n\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:09:10.784176", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on Manhattan distance to the nearest item\n    x, y = state.pos\n    min_dist = float('inf')\n    \n    for dx in range(-1, 2):\n      for dy in range(-1, 2):\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n          dist = np.abs(nx - goal).sum()\n          min_dist = min(min_dist, dist)\n    \n    return min_dist\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n      from collections import deque\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n      \n      while open_set:\n          _, state, actions = heapq.heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action only if there's a nearby item\n          if any(state.grid[state.pos[0]+dx][state.pos[1]+dy].any() \n                 for dx in [-1, 0, 1] for dy in [-1, 0, 1]):\n              reward, new_state = state.step(USE)\n              \n              tentative_g_score = g_score[tuple(state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (state, actions + [USE])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [USE]))\n          \n          # Explore movement actions\n          for action in [UP, DOWN, LEFT, RIGHT]:\n              reward, new_state = state.step(action)\n              \n              tentative_g_score = g_score[tuple(state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (state, actions + [action])\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:09:11.785125", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n\n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action only if there's a nearby item\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              if (0 <= state.pos[0] + dx < env.scenario.init_grid.shape[0] and\n                  0 <= state.pos[1] + dy < env.scenario.init_grid.shape[1]):\n                  if any(state.grid[state.pos[0]+dx][state.pos[1]+dy]):\n                      reward, new_state = state.step(USE)\n                      \n                      if tuple(new_state.features()) not in visited:\n                          visited.add(tuple(new_state.features()))\n                          queue.appendleft((new_state, actions + [USE]))  # Prioritize USE action\n\n      # Explore movement actions\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:10:31.362465", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [], 0)])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions, current_cost = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and states with changes in inventory\n      next_states = []\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Calculate heuristic priority and cost\n              priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n              new_cost = current_cost + 1\n                  \n              next_states.append((new_state, actions + [action], priority, new_cost))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: (-x[2], x[3]))\n      for new_state, new_actions, _, _ in next_states:\n          queue.appendleft((new_state, new_actions, current_cost + 1))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:10:32.351337", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n      # Calculate Manhattan distance between current inventory and goal item\n      current_inventory = state.inventory.copy()\n      current_inventory[goal] -= 1  # Account for the goal item being crafted\n      \n      return -np.sum(current_inventory > 0)  # Minimize remaining items\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      next_states = []\n      for action in [USE] + list(range(UP, RIGHT+1)):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Calculate heuristic priority\n              priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                  \n              next_states.append((new_state, actions + [action], priority))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: -x[2])\n      for new_state, new_actions, _ in next_states:\n          queue.appendleft((new_state, new_actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:11:45.172111", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n          \n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the item index is valid\n  if item not in env.world.cookbook.index.contents.values():\n    raise ValueError(f\"Invalid item index {item}\")\n\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:11:46.275492", "function_name": "craft", "function_body": "  def get_goal_item_name(item_index):\n    \"\"\"Retrieve the name of the goal item from the cookbook index.\"\"\"\n    for name, idx in env.world.cookbook.index.contents.items():\n      if idx == item_index:\n        return name\n    raise ValueError(f\"Item index {item_index} not found in cookbook index.\")\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):  # Assuming 'default' as placeholder for now\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Hash the state based on grid, inventory, position, and direction\n        state_hash = (tuple(next_state.grid.flatten()), \n                      tuple(next_state.inventory), \n                      next_state.pos, \n                      next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Ensure the item index is valid\n  if item not in env.world.cookbook.index.contents.values():\n    raise ValueError(f\"Invalid item index {item}\")\n\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:12:46.886620", "function_name": "craft", "function_body": "  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, next_state = state.step(action)\n          state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n          neighbors.append((action, next_state, state_hash))\n      return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state, state_hash in get_neighbors(current_state):\n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          queue.append((next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:12:47.872886", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          # Prioritize actions that lead to a change in the inventory\n          if np.any(next_state.inventory != current_state.inventory):\n            queue.appendleft((next_state, actions_taken + [action]))\n          else:\n            queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:14:21.546635", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    from heapq import heappop, heappush\n\n    # Priority queue with (estimated_cost, actions_taken, current_state)\n    pq = [(0, [], start_state)]\n    visited_states = set()\n\n    while pq:\n      _, actions_taken, current_state = heappop(pq)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          # Estimate cost as number of actions taken + heuristic (e.g., Manhattan distance to goal items)\n          estimated_cost = len(actions_taken) + heuristic(next_state, goal_arg)\n          heappush(pq, (estimated_cost, actions_taken + [action], next_state))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # A simple heuristic: sum of distances to all required ingredients\n    total_distance = 0\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    \n    for i_kind in primitives:\n      if current_state.inventory[i_kind] < primitives[i_kind]:\n        # Find the nearest instance of this ingredient on the grid\n        positions = np.argwhere(current_state.grid[:, :, i_kind])\n        if len(positions) > 0:\n          nearest_position = min(\n              positions,\n              key=lambda pos: manhattan_distance(pos, current_state.pos)\n          )\n          total_distance += manhattan_distance(nearest_position, current_state.pos)\n\n    return total_distance\n\n  def manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Initialize the environment and get the start scenario and state\n  env.reset()\n  \n  try:\n      start_scenario = env.scenario\n      start_state = start_scenario.init()\n  except ValueError as e:\n      raise ValueError(f\"Error initializing scenario: {e}\")\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:14:22.588685", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Reset the environment and get the start scenario and state\n  env.reset()\n\n  try:\n      start_scenario = env.scenario\n      start_state = start_scenario.init()\n  except ValueError as e:\n      raise ValueError(f\"Error initializing scenario: {e}\")\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:16:05.721687", "function_name": "craft", "function_body": "  def heuristic(current_state, goal_arg):\n      \"\"\"Heuristic based on distance from primitives.\"\"\"\n      cookbook = env.world.cookbook\n      primitives = set(cookbook.primitives)\n      \n      # Count missing primitives in the inventory\n      required_primitives = cookbook.primitives_for(goal_arg)\n      missing_count = sum(required_primitives.get(i, 0) for i in primitives if current_state.inventory[i] < required_primitives.get(i, 0))\n      \n      return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n      import heapq\n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n      visited_states = set()\n      start_time = time.time()\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  heapq.heappush(open_set, (\n                      len(actions_taken) + 1 + heuristic(next_state, goal_arg), \n                      next_state, \n                      actions_taken + [action]\n                  ))\n                  visited_states.add(state_hash)\n\n          # Optional: Add a timeout to prevent infinite loops\n          if time.time() - start_time > 120:  # Timeout after 120 seconds\n              break\n\n      return None\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:16:06.736196", "function_name": "craft", "function_body": "  def heuristic(current_state, goal_arg):\n    \"\"\"Simple heuristic based on distance from primitives.\"\"\"\n    cookbook = env.world.cookbook\n    primitives = set(cookbook.primitives)\n    \n    # Count missing primitives in the inventory\n    required_primitives = cookbook.primitives_for(goal_arg)\n    missing_count = sum(required_primitives.get(i, 0) - current_state.inventory[i] for i in primitives if required_primitives.get(i, 0) > current_state.inventory[i])\n    \n    return missing_count\n\n  def a_star(start_state, goal_name, goal_arg):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited_states = set()\n    came_from = {}\n    g_score = {start_state: 0}\n    \n    while open_set:\n      current_f, current_state, actions_taken = heapq.heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return reconstruct_path(came_from, current_state, actions_taken)\n      \n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      visited_states.add(state_hash)\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        tentative_g_score = g_score[current_state] + 1\n\n        next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if next_state_hash not in g_score or tentative_g_score < g_score[next_state_hash]:\n          came_from[next_state] = current_state\n          g_score[next_state] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n    \n    return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = []\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          actions_taken.pop()  # Remove the last action added\n          total_path.append(actions_taken[-1])  # Add the correct action leading to this state\n      return list(reversed(total_path))\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:17:36.080179", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n      # Simple heuristic based on the count of the goal item in the inventory\n      return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:17:37.132531", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n      # Simple heuristic based on the count of the goal item in the inventory\n      return state.inventory[goal] < 1\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:19:17.665706", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T08:19:18.629585", "function_name": "craft", "function_body": "  # Define the constants for movement and use actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def get_neighbors(pos):\n      \"\"\"Get the valid neighboring positions.\"\"\"\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < env.world.WIDTH and 0 <= ny < env.world.HEIGHT:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def is_next_to(pos, target_index):\n      \"\"\"Check if the target index is in any of the neighboring cells.\"\"\"\n      for neighbor in get_neighbors(pos):\n          if current_state.grid[neighbor[1], neighbor[0]].nonzero()[0] == target_index:\n              return True\n      return False\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  # Define goal name and argument\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = []\n  current_state = start_state\n\n  while not current_state.satisfies(goal_name, goal_arg):\n      if is_next_to(current_state.pos, goal_arg):\n          action_sequence.append(USE)\n          reward, current_state = current_state.step(USE)\n      else:\n          # Find the nearest instance of the required item\n          target_pos = None\n          for x in range(env.world.WIDTH):\n              for y in range(env.world.HEIGHT):\n                  if current_state.grid[y, x].nonzero()[0] == goal_arg:\n                      target_pos = (x, y)\n                      break\n              if target_pos is not None:\n                  break\n\n          if target_pos is not None:\n              # Move towards the target position\n              dx = target_pos[0] - current_state.pos[0]\n              dy = target_pos[1] - current_state.pos[1]\n\n              if dx < 0:\n                  action_sequence.append(LEFT)\n                  reward, current_state = current_state.step(LEFT)\n              elif dx > 0:\n                  action_sequence.append(RIGHT)\n                  reward, current_state = current_state.step(RIGHT)\n              elif dy < 0:\n                  action_sequence.append(DOWN)\n                  reward, current_state = current_state.step(DOWN)\n              elif dy > 0:\n                  action_sequence.append(UP)\n                  reward, current_state = current_state.step(UP)\n\n  return action_sequence", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T08:22:12.285822", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: number of items needed to craft the goal\n    goal_name = env.world.cookbook.index.get(goal)\n    primitives = env.world.cookbook.primitives_for(goal)\n    \n    if not primitives:\n      return float('inf')  # No recipe for this item\n    \n    current_inventory = state.inventory.copy()\n    steps_needed = 0\n    \n    while any(current_inventory[primitive] < count for primitive, count in primitives.items()):\n      min_steps_to_goal = float('inf')\n      \n      for candidate_item, candidate_recipe in env.world.cookbook.recipes.items():\n        if candidate_item == goal:\n          continue\n        \n        candidate_primitives = {key: val for key, val in candidate_recipe.items() if key != \"_key\"}\n        \n        # Check if we can craft this candidate item\n        if all(current_inventory[primitive] >= count for primitive, count in candidate_primitives.items()):\n          steps_to_goal = sum(candidate_recipe[primitive] - current_inventory[primitive] \n                              for primitive, count in candidate_primitives.items())\n          \n          if steps_to_goal < min_steps_to_goal:\n            min_steps_to_goal = steps_to_goal\n            \n            # Craft the candidate item\n            craft_actions = a_star(state, candidate_item)\n            \n            if craft_actions is not None:\n              for action in craft_actions:\n                reward, state = state.step(action)\n                steps_needed += 1 + len(craft_actions)  # Add one for USE action\n                \n              current_inventory[candidate_item] += 1\n              \n    return steps_needed\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    \n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        # Optimize by ignoring USE action if no item is nearby\n        if action == USE and not any(new_state.grid[new_state.pos[0]+dx][new_state.pos[1]+dy].any() \n                                     for dx in [-1, 0, 1] for dy in [-1, 0, 1]):\n          continue\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (current_state, actions)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
