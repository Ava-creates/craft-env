{"timestamp": "2025-06-25T07:24:41.973783", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  \n  # Sample a scenario with the goal item\n  try:\n      start_scenario = env.sample_scenario_with_goal(item)\n  except ValueError as e:\n      raise ValueError(f\"Failed to sample scenario with goal {item}: {e}\")\n\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:26:11.953008", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Avoid infinite loops by checking if the inventory has changed meaningfully\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Manhattan distance heuristic.\"\"\"\n    goal_pos = np.unravel_index(goal, env.world.scenario.init_grid.shape[:2])\n    current_pos = state.pos\n    return abs(goal_pos[0] - current_pos[0]) + abs(goal_pos[1] - current_pos[1])\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path with heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, state, actions = open_set.get()\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    \"\"\"Reconstruct path from start to goal.\"\"\"\n    total_path = []\n    while tuple(current.features()) in came_from:\n      current, actions = came_from[tuple(current.features())]\n      total_path.extend(actions)\n    return total_path[::-1]  # Reverse the path\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:26:12.935021", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the inventory has changed meaningfully\n        if tuple(new_state.features()) not in visited and np.any(new_state.inventory != start_state.inventory):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_walkable(pos):\n      \"\"\"Check if a position is walkable.\"\"\"\n      x, y = pos\n      grid_slice = env.world.scenario.init_grid[x-1:x+2, y-1:y+2, :]\n      return np.sum(grid_slice[:, :, env.world.stone_index]) == 0 and np.sum(grid_slice[:, :, env.world.water_index]) == 0\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:27:13.660604", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        # Check if the new state is a valid move and not already visited\n        if (new_state.pos != state.pos or action == USE) and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:27:14.641331", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Use a simple heuristic based on whether the item is in inventory or not\n    return 0 if state.inventory[goal] > 0 else 1\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = [(heuristic(start_state, goal), start_state, [])]\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to facilitate crafting\n      for action in [USE] + list(range(4)):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if (tuple(new_state.features()) not in g_score or \n            tentative_g_score < g_score[tuple(new_state.features())]):\n          came_from[new_state] = current_state\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:28:29.732875", "function_name": "craft", "function_body": "  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n      reward, next_state = state.step(action)\n      state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n      neighbors.append((action, next_state, state_hash))\n    return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state, state_hash in get_neighbors(current_state):\n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          # Prioritize actions that lead to a change in the inventory\n          if np.any(next_state.inventory != current_state.inventory):\n            queue.appendleft((next_state, actions_taken + [action]))\n          else:\n            queue.append((next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:28:30.796647", "function_name": "craft", "function_body": "  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n      reward, next_state = state.step(action)\n      state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n      if np.any(next_state.inventory != state.inventory):  # Prioritize inventory changes\n        neighbors.insert(0, (action, next_state, state_hash))\n      else:\n        neighbors.append((action, next_state, state_hash))\n    return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action, next_state, state_hash in get_neighbors(current_state):\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:30:16.314258", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: count the number of items needed in inventory to craft the goal\n    required_items = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    return sum(max(0, required - current) for kind, required in required_items.items() if kind in current_inventory)\n\n  def astar(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    g_score = {tuple(start_state.features()): 0}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = actions[:]\n    while current_state in came_from:\n      current_state, prev_actions = came_from[current_state]\n      total_path[:0] = prev_actions\n    return total_path\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:30:17.316918", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # A simple heuristic: distance to nearest ingredient or workshop\n    # For simplicity, let's assume the goal is always a crafted item and not a primitive.\n    # The heuristic will be based on the Manhattan distance to the nearest required ingredient.\n    required_ingredients = env.world.cookbook.recipes.get(item, {})\n    grid = state.grid\n    pos = np.array(state.pos)\n    min_dist = float('inf')\n    \n    for ingredient in required_ingredients:\n      if ingredient == \"_key\":\n        continue  # Skip the key which is used for counts\n\n      for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n          if grid[y, x, ingredient] > 0:\n            dist = abs(y - pos[0]) + abs(x - pos[1])\n            min_dist = min(min_dist, dist)\n    \n    return min_dist\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    from collections import defaultdict\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.features())] = 0\n    f_score = defaultdict(lambda: float('inf'))\n    f_score[tuple(start_state.features())] = heuristic(start_state)\n    \n    while open_set:\n      _, current, actions = heappop(open_set)\n      \n      if current.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current.step(action)\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        \n        if tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state)\n          heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_path = []\n    while current in came_from:\n      (current, actions) = came_from[current]\n      total_path = actions[-1:] + total_path\n    return total_path\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:31:31.999712", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  \n  # Ensure the goal item is valid\n  if item not in range(env.world.cookbook.n_kinds):\n      raise ValueError(f\"Invalid item index: {item}\")\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:31:33.120183", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n      # Prune the queue to maintain a manageable size\n      if len(queue) > 10000:\n        queue = deque(sorted(queue, key=lambda x: -len(x[1]))[:5000])  # Keep the shortest paths\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:32:41.837186", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and avoid revisiting the same position\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Avoid unnecessary moves that don't change the grid or inventory\n              if action != USE and tuple(state.grid.flatten()) == tuple(new_state.grid.flatten()) and np.array_equal(state.inventory, new_state.inventory):\n                  continue\n\n              if action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:32:42.837892", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:33:54.328014", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def bfs(start_state, goal):\n      from collections import deque\n      from heapq import heappush, heappop\n      \n      # Priority queue for A* search\n      priority_queue = []\n      heappush(priority_queue, (0, start_state, []))\n      \n      visited = set([tuple(start_state.features())])\n      \n      while priority_queue:\n          _, state, actions = heappop(priority_queue)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Generate all possible next states and actions\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  # Calculate cost (heuristic: distance from inventory to goal inventory)\n                  cost = len(actions) + 1\n                  heuristic = np.sum(np.abs(new_state.inventory - goal_inventory))\n                  total_cost = cost + heuristic\n                  \n                  heappush(priority_queue, (total_cost, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  goal_index = item\n  \n  # Determine the target inventory for the goal item\n  def get_target_inventory(goal_index):\n      inventory = np.zeros(env.world.n_kinds)\n      primitives = env.world.cookbook.primitives_for(goal_index)\n      for kind, count in primitives.items():\n          inventory[kind] += count\n      return inventory\n  \n  goal_inventory = get_target_inventory(goal_index)\n\n  actions = bfs(start_state, goal_index)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:33:55.307681", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    return int(not state.satisfies(\"\", goal))  # Returns 1 if goal not satisfied, else 0\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n      from collections import deque\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, start_state, []))  # (f_score, state, actions)\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current_state, actions = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:35:44.183714", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic function using Manhattan distance.\"\"\"\n      inv = state.inventory.copy()\n      inv[goal] -= 1\n      primitives_needed = env.world.cookbook.primitives_for(goal)\n      \n      # Estimate cost to gather all needed primitives\n      cost = 0\n      for i_kind, count in primitives_needed.items():\n          if inv[i_kind] < count:\n              cost += count - inv[i_kind]\n      \n      return cost\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n          prev, action = came_from[current]\n          total_path.append(action)\n          current = prev\n      return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:35:45.164891", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: Euclidean distance to the nearest known item location\n    grid = state.grid\n    pos = state.pos\n    \n    item_positions = np.argwhere(grid[:, :, goal])\n    \n    if len(item_positions) == 0:\n      return float('inf')\n    \n    distances = [np.linalg.norm(np.array(pos) - np.array(p)) for p in item_positions]\n    return min(distances)\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    g_scores = {tuple(start_state.features()): 0}\n    f_scores = {tuple(start_state.features()): heuristic(start_state, goal)}\n    came_from = {}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        path_actions = []\n        while current_state in came_from:\n          path_actions.append(actions[-1])\n          current_state, actions = came_from[current_state]\n        return list(reversed(path_actions))\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_scores[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions)\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_scores[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_scores[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:37:04.048619", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and states with changes in inventory\n      next_states = []\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Prioritize states where an item was used or added to inventory\n              priority = 0\n              if action == USE:\n                  priority += 1\n              if np.any(new_state.inventory != state.inventory):\n                  priority += 2\n                  \n              next_states.append((new_state, actions + [action], priority))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: -x[2])\n      for new_state, new_actions, _ in next_states:\n          queue.appendleft((new_state, new_actions))\n    \n    return None  # No solution found\n\n  start_time = time.time()\n  max_duration = 10.0  # Maximum duration in seconds\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found within the given time.\")\n  \n  print(f\"Crafting completed in {time.time() - start_time:.2f} seconds with {len(actions)} actions.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:37:05.127039", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and states with changes in inventory\n      next_states = []\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Calculate heuristic priority\n              priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                  \n              next_states.append((new_state, actions + [action], priority))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: -x[2])\n      for new_state, new_actions, _ in next_states:\n          queue.appendleft((new_state, new_actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T07:38:30.144381", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def astar(start_state, goal):\n      \"\"\"A* Search with heuristic prioritization.\"\"\"\n      from collections import deque\n      \n      queue = [(0, start_state, [])]\n      visited = set([tuple(start_state.features())])\n      \n      while queue:\n          _, state, actions = queue.pop(0)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action and states with changes in inventory\n          next_states = []\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = state.step(action)\n              \n              # Avoid revisiting the same state\n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  # Calculate heuristic priority\n                  priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                      \n                  next_states.append((new_state, actions + [action], priority))\n          \n          # Sort states by priority and append to the front of the queue\n          next_states.sort(key=lambda x: -x[2])\n          for new_state, new_actions, _ in next_states:\n              cost = len(new_actions)  # Cost is the number of steps taken so far\n              queue.append((cost + heuristic(new_state, goal), new_state, new_actions))\n              # Move the new state to the front of the queue based on priority\n              queue.sort(key=lambda x: (x[0], -x[2]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T07:38:31.216222", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and states with changes in inventory\n      next_states = []\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n          reward, new_state = state.step(action)\n          \n          # Avoid revisiting the same state\n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              \n              # Calculate heuristic priority\n              priority = heuristic(new_state, goal) + (1 if action == USE else 0)\n                  \n              next_states.append((new_state, actions + [action], priority))\n      \n      # Sort states by priority and append to the front of the queue\n      next_states.sort(key=lambda x: -x[2])\n      for new_state, new_actions, _ in next_states:\n          queue.appendleft((new_state, new_actions))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1