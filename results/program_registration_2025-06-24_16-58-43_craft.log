{"timestamp": "2025-06-25T11:27:01.361562", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:27:02.423197", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable representation of the state\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:28:35.872010", "function_name": "craft", "function_body": "  def heuristic(state: CraftState, goal_arg: int) -> int:\n    \"\"\"Heuristic function for A* search.\"\"\"\n    # Simple heuristic: distance between any resource needed and the agent's position\n    # This is a placeholder heuristic; it can be improved further.\n    cookbook = env.world.cookbook\n    required_resources = cookbook.primitives_for(goal_arg)\n    \n    total_distance = 0\n    \n    for primitive, count in required_resources.items():\n      if state.inventory[primitive] >= count:\n        continue\n      \n      # Find the nearest occurrence of each required resource\n      min_dist = float('inf')\n      for y in range(state.grid.shape[0]):\n          for x in range(state.grid.shape[1]):\n              if state.grid[y, x, primitive] > 0:\n                  dist = abs(y - state.pos[0]) + abs(x - state.pos[1])\n                  min_dist = min(min_dist, dist)\n      \n      total_distance += min_dist\n    \n    return total_distance\n\n  def a_star(start_state: CraftState, goal_name: str, goal_arg: int):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    from heapq import heappush, heappop\n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n    \n    while open_set:\n      _, current_state, actions_taken = heappop(open_set)\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n        \n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[state_hash] = (actions_taken, action)\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(next_state, goal_arg)\n          heappush(open_set, (f_score, next_state, actions_taken + [action]))\n    \n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:28:36.998161", "function_name": "craft", "function_body": "  def get_neighbors(state):\n    neighbors = []\n    for action in range(env.world.n_actions):\n        _, next_state = state.step(action)\n        neighbors.append((next_state, action))\n    return neighbors\n\n  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search with heuristic to prioritize states closer to the goal.\"\"\"\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          for next_state, action in get_neighbors(current_state):\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:30:03.672855", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate all possible next states\n      next_states = [(state.step(action)[1], action) for action in range(env.world.n_actions)]\n      \n      # Prioritize USE action to speed up crafting and apply heuristic\n      next_states.sort(key=lambda x: (x[0].inventory[goal] == 0, is_stuck(x[0], actions)))\n      \n      for new_state, action in next_states:\n        if tuple(new_state.features()) not in visited and not is_stuck(new_state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:30:04.686219", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and early termination.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  def get_neighbors(state):\n      \"\"\"Get all reachable states from the current state.\"\"\"\n      neighbors = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          neighbors.append((new_state, action))\n      return neighbors\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:31:34.158520", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Simple heuristic based on inventory items close to the goal.\"\"\"\n    # Calculate the sum of inventory that matches the goal\n    return np.sum(state.inventory[goal])\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search algorithm to find the shortest path with heuristic.\"\"\"\n      from collections import deque\n      \n      open_set = [(start_state, [], 0)]  # (state, actions, cost)\n      visited = set([tuple(start_state.features())])\n      \n      while open_set:\n          state, actions, cost = open_set.pop(0)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action first\n          for action in [USE] + list(range(UP, RIGHT+1)):\n              reward, new_state = state.step(action)\n              \n              if tuple(new_state.features()) not in visited:\n                  visited.add(tuple(new_state.features()))\n                  \n                  new_cost = cost + 1  # Uniform cost\n                  priority = new_cost + heuristic(new_state, goal)  # f(n) = g(n) + h(n)\n                  \n                  open_set.append((new_state, actions + [action], new_cost))\n                  # Sort the open set based on priority (f(n))\n                  open_set.sort(key=lambda x: x[2] + heuristic(x[0], goal))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:31:35.182923", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of items in the inventory that are not the goal\n    return np.sum(state.inventory) - state.inventory[goal]\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with a heuristic.\"\"\"\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current, actions = heappop(open_set)\n          \n          if current.satisfies(\"\", goal):\n              return actions\n          \n          for action in [USE] + list(range(UP, RIGHT+1)):\n              reward, new_state = current.step(action)\n              tentative_g_score = g_score[tuple(current.features())] + 1\n\n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  came_from[tuple(new_state.features())] = (current, action)\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:32:42.582287", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on Manhattan distance to an estimated location of the item\n    # This is a placeholder and should be replaced with a more accurate heuristic\n    return np.sum(np.abs(state.pos - (env.world.grid.shape[0] // 2, env.world.grid.shape[1] // 2)))\n\n  def astar(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      f_score, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        path = []\n        current = state\n        while current in came_from:\n          path.append(came_from[current])\n          current = came_from[current]\n        return path[::-1] + actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:32:43.610455", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action if next to required item\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if action == USE and state.next_to(goal) and tuple(new_state.features()) not in visited:\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            queue.append((new_state, actions + [action]))\n\n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:34:14.349474", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment to get a fresh scenario\n  env.reset()\n  \n  # Ensure we have a valid goal item\n  if item not in env.world.cookbook.index.ordered_contents:\n    raise ValueError(f\"Item {item} is not known to the cookbook.\")\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:34:15.338097", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(current_state, goal_arg):\n      \"\"\"Heuristic based on the number of items needed to craft the goal.\"\"\"\n      # Placeholder heuristic: count difference between current inventory and required items\n      primitives = env.world.cookbook.primitives_for(goal_arg)\n      current_inventory = current_state.inventory\n      return sum(primitives.get(kind, 0) - current_inventory[kind] for kind in primitives)\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n      import heapq\n\n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n      came_from = {}\n      g_score = {start_state: 0}\n      f_score = {start_state: heuristic(start_state, goal_arg)}\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Cost of one action\n\n              if next_state not in g_score or tentative_g_score < g_score[next_state]:\n                  came_from[next_state] = (current_state, actions_taken + [action])\n                  g_score[next_state] = tentative_g_score\n                  f_score[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (f_score[next_state], next_state, actions_taken + [action]))\n\n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:36:00.035727", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and early termination.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  def get_neighbors(state):\n      \"\"\"Get all reachable states from the current state.\"\"\"\n      neighbors = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          neighbors.append((new_state, action))\n      return neighbors\n\n  # Helper function to perform Dijkstra's algorithm\n  def dijkstra(start_state, goal):\n    \"\"\"Dijkstra's Algorithm to find the shortest path.\"\"\"\n    from queue import PriorityQueue\n    \n    pq = PriorityQueue()\n    pq.put((0, start_state, []))  # (cost, state, actions)\n    visited = set()\n    \n    while not pq.empty():\n      cost, state, actions = pq.get()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      if tuple(state.features()) in visited:\n          continue\n      visited.add(tuple(state.features()))\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if tuple(new_state.features()) not in visited and not is_stuck(state, actions):\n              pq.put((cost + 1, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = dijkstra(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:36:01.058473", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning and early termination.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        # Prune states that are already visited or where the agent is stuck\n        if tuple(new_state.features()) not in visited and not is_stuck(state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  def get_neighbors(state):\n      \"\"\"Get all reachable states from the current state.\"\"\"\n      neighbors = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          neighbors.append((new_state, action))\n      return neighbors\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n\n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:37:05.841210", "function_name": "craft", "function_body": "  def dfs(current_state, actions_taken, goal_index, max_depth=25):\n    if current_state.satisfies('default', goal_index):\n      return actions_taken\n    \n    if len(actions_taken) >= max_depth:\n      return None\n\n    # Generate all possible next states\n    for action in range(env.world.n_actions):\n      reward, next_state = current_state.step(action)\n      \n      result = dfs(next_state, actions_taken + [action], goal_index, max_depth)\n      if result is not None:\n        return result\n    \n    return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n    raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = dfs(start_state, [], goal_index)\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n\n  return action_sequence", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:37:06.864472", "function_name": "craft", "function_body": "  def dfs(current_state, goal_index, path):\n      # Check if the current state satisfies the goal\n      if current_state.satisfies('default', goal_index):\n          return path\n      \n      # Explore all possible actions\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          new_path = path + [action]\n          \n          # Recursive call to explore deeper\n          result = dfs(next_state, goal_index, new_path)\n          if result:\n              return result\n      \n      return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = dfs(start_state, goal_index, [])\n  \n  if action_sequence is None:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")\n    \n  return action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:39:02.341449", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # For simplicity, we can use a heuristic based on whether the inventory has the required item\n    if state.inventory[goal] > 0:\n        return 0\n    else:\n        return 1\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with a heuristic.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          tentative_g_score = g_score[tuple(current_state.features())] + 1\n          \n          if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n              came_from[tuple(new_state.features())] = (current_state, actions + [action])\n              g_score[tuple(new_state.features())] = tentative_g_score\n              f_score = tentative_g_score + heuristic(new_state, goal)\n              heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n      total_path = actions\n      while tuple(current_state.features()) in came_from:\n          current_state, actions = came_from[tuple(current_state.features())]\n          total_path = actions\n      return total_path\n  \n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:39:03.319988", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      use_action, other_actions = None, []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          if tuple(new_state.features()) not in visited:\n              visited.add(tuple(new_state.features()))\n              if action == USE and new_state.inventory[goal] > 0:\n                  return actions + [action]  # Directly return if goal is crafted\n              elif action == USE:\n                  use_action = (new_state, actions + [action])\n              else:\n                  other_actions.append((new_state, actions + [action]))\n      \n      # Add USE action first if available\n      if use_action is not None:\n          queue.appendleft(use_action)\n      for new_state, actions in other_actions:\n          queue.append((new_state, actions))\n    \n    return None  # No solution found\n\n  start_time = time.time()\n  \n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  end_time = time.time()\n  print(f\"Time taken: {end_time - start_time} seconds\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:40:16.404984", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # A simple heuristic: distance to the nearest required item or workshop\n    required_indices = set(env.world.cookbook.primitives_for(goal).keys())\n    distances = []\n    \n    for i in range(env.world.WIDTH):\n      for j in range(env.world.HEIGHT):\n        if state.grid[i, j] in required_indices:\n          dist = abs(i - state.pos[0]) + abs(j - state.pos[1])\n          distances.append(dist)\n        elif state.grid[i, j] == env.world.workshop_indices[0]:\n          dist = abs(i - state.pos[0]) + abs(j - state.pos[1])\n          distances.append(dist)\n    \n    return min(distances) if distances else float('inf')\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0 + heuristic(start_state, goal), 0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, current_cost, state, actions = open_set.get()\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, state)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, tentative_g_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current):\n    total_path = []\n    while current in came_from:\n      current, action = came_from[current]\n      total_path.append(action)\n    return list(reversed(total_path))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:40:17.440380", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and try to avoid unnecessary moves\n      for action in [USE] + list(range(UP, RIGHT+1)):\n        reward, new_state = state.step(action)\n        \n        # Avoid revisiting the same state and ensure it's a valid move\n        if not np.array_equal(state.grid, new_state.grid) or tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:41:42.741845", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic based on Manhattan distance.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    \n    g_costs = {tuple(start_state.features()): 0}\n    visited = set()\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if tuple(state.features()) in visited:\n        continue\n      visited.add(tuple(state.features()))\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        new_g_cost = g_costs[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_costs or new_g_cost < g_costs[tuple(new_state.features())]:\n          g_costs[tuple(new_state.features())] = new_g_cost\n          f_cost = new_g_cost + heuristic(new_state, goal)\n          heappush(open_set, (f_cost, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function based on Manhattan distance to the closest ingredient.\"\"\"\n    if env.world.cookbook.primitives_for(goal):\n      return 0  # Directly craftable items have no heuristic cost\n    \n    min_distance = float('inf')\n    for i_kind in env.world.cookbook.primitives_for(goal).keys():\n      if state.next_to(i_kind):\n        return 1  # If next to an ingredient, cost is minimal\n      for y in range(env.scenario.init_grid.shape[0]):\n        for x in range(env.scenario.init_grid.shape[1]):\n          if env.scenario.init_grid[y, x, i_kind] > 0:\n            distance = abs(state.pos[0] - x) + abs(state.pos[1] - y)\n            min_distance = min(min_distance, distance)\n    \n    return min_distance\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:41:43.740132", "function_name": "craft", "function_body": "  def a_star(start_state, goal):\n    \"\"\"A* Search with heuristics.\"\"\"\n    import heapq\n    \n    def heuristic(state, goal):\n      # Simple heuristic: count the number of items needed in the inventory\n      recipe = env.world.cookbook.primitives_for(goal)\n      current_inventory = state.inventory\n      missing_items = sum(max(0, recipe.get(i_kind, 0) - current_inventory[i_kind]) for i_kind in recipe)\n      return missing_items\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:42:37.310317", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n      \n      queue = deque([(start_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n\n              # Create a hashable state representation\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n      \n      return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
