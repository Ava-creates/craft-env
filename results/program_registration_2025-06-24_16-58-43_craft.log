{"timestamp": "2025-06-25T11:45:45.319108", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Add a penalty to avoid picking up the same item multiple times unnecessarily\n        if action == USE_ACTION and env._extra_pickup_penalty > 0:\n          reward -= env._extra_pickup_penalty\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Define the USE action index\n  global USE_ACTION\n  USE_ACTION = 4  # Assuming USE is the last action (index 4)\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:45:46.509471", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Normalize the state to avoid redundant visits due to rotations or other symmetries\n        normalized_grid = normalize_grid(next_state.grid)\n        state_hash = (tuple(normalized_grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def normalize_grid(grid):\n    # Implement grid normalization logic here\n    # For example, rotating the grid to a canonical orientation\n    from scipy.ndimage import rotate\n    \n    # Convert one-hot encoding to labels\n    labels = np.argmax(grid, axis=-1)\n    \n    # Rotate to find the minimum lexicographical rotation\n    min_rotation = None\n    for angle in [0, 90, 180, 270]:\n      rotated_labels = rotate(labels, angle, reshape=False).astype(int)\n      if min_rotation is None or np.array_equal(rotated_labels, min_rotation):\n        min_rotation = rotated_labels\n    \n    # Convert back to one-hot encoding\n    normalized_grid = np.eye(grid.shape[-1])[min_rotation]\n    \n    return normalized_grid\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:46:47.924094", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Skip USE actions that don't change the state\n        if (action == USE and tuple(new_state.features()) == tuple(state.features())) or \\\n           tuple(new_state.features()) in visited:\n          continue\n        \n        visited.add(tuple(new_state.features()))\n        queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:46:48.898501", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to estimate the cost from state to goal.\"\"\"\n    # Simple heuristic: number of items needed in inventory minus current count\n    goal_counts = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    \n    missing_items = sum(max(0, goal_counts.get(i, 0) - current_inventory[i]) for i in goal_counts)\n    \n    return missing_items\n\n  def a_star(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    \n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    while open_set:\n      _, state, actions = heapq.heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          \n          heapq.heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  came_from = {}\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:48:43.507036", "function_name": "craft", "function_body": "  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # Calculate the number of missing ingredients needed for the goal\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    inventory = current_state.inventory\n    \n    total_missing_ingredients = 0\n    \n    for i_kind, required_count in primitives.items():\n      if inventory[i_kind] < required_count:\n        total_missing_ingredients += (required_count - inventory[i_kind])\n    \n    return total_missing_ingredients\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search algorithm to find the optimal sequence of actions.\"\"\"\n    from heapq import heappop, heappush\n    from collections import defaultdict\n\n    # Priority queue with (estimated_cost, actions_taken, current_state)\n    pq = [(0, [], start_state)]\n    visited_states = set()\n    cost_so_far = defaultdict(lambda: float('inf'))\n\n    while pq:\n      _, actions_taken, current_state = heappop(pq)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          new_cost = len(actions_taken)\n          if new_cost < cost_so_far[state_hash]:\n            cost_so_far[state_hash] = new_cost\n            priority = new_cost + heuristic(next_state, goal_arg)\n            heappush(pq, (priority, actions_taken + [action], next_state))\n            visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:48:44.496312", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n    from heapq import heappop, heappush\n\n    # Priority queue with (estimated_cost, actions_taken, current_state)\n    pq = [(0, [], start_state)]\n    visited_states = set()\n\n    while pq:\n      _, actions_taken, current_state = heappop(pq)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          # Estimate cost as number of actions taken + heuristic (e.g., Manhattan distance to goal items)\n          estimated_cost = len(actions_taken) + heuristic(current_state, goal_arg)\n          heappush(pq, (estimated_cost, actions_taken + [action], next_state))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # A simple heuristic: sum of distances to all required ingredients\n    total_distance = 0\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    \n    for i_kind in primitives:\n      if current_state.inventory[i_kind] < primitives[i_kind]:\n        # Find the nearest instance of this ingredient on the grid\n        positions = np.argwhere(current_state.grid[:, :, i_kind])\n        if len(positions) > 0:\n          nearest_position = min(\n              positions,\n              key=lambda pos: manhattan_distance(pos, current_state.pos)\n          )\n          total_distance += manhattan_distance(nearest_position, current_state.pos)\n\n    return total_distance\n\n  def manhattan_distance(p1, p2):\n      \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n      return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Initialize the environment and get the start scenario and state\n  env.reset()\n  \n  try:\n      start_scenario = env.scenario\n      start_state = start_scenario.init()\n  except ValueError as e:\n      raise ValueError(f\"Error initializing scenario: {e}\")\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:50:00.149011", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n\n              # Check the new state against the visited set before adding to the queue\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n                  queue.append((next_state, actions_taken + [action]))\n\n      return None\n\n  # Define the USE action index\n  global USE_ACTION\n  USE_ACTION = 4  # Assuming USE is the last action (index 4)\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:50:01.202346", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Add a penalty to avoid picking up the same item multiple times unnecessarily\n        if action == USE_ACTION and env._extra_pickup_penalty > 0:\n          reward -= env._extra_pickup_penalty\n        \n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Define the USE action index\n  global USE_ACTION\n  USE_ACTION = 4  # Assuming USE is the last action (index 4)\n\n  # Ensure the environment is set up correctly\n  env.reset()\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:51:50.553786", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n      from itertools import islice\n      \n      queue = deque([(start_state, [])])\n      visited_states = set()\n      depth_limit = 50  # Limit the maximum number of steps\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          if len(actions_taken) < depth_limit:  # Check against depth limit\n              for action in range(env.world.n_actions):\n                  reward, next_state = current_state.step(action)\n                  state_hash = (\n                      tuple(next_state.grid.flatten()),\n                      tuple(next_state.inventory),\n                      next_state.pos,\n                      next_state.dir\n                  )\n                  \n                  if state_hash not in visited_states:\n                      queue.append((next_state, actions_taken + [action]))\n                      visited_states.add(state_hash)\n\n              # Limit the size of the queue to prevent excessive memory usage\n              if len(queue) > 10000:\n                  queue = deque(islice(queue, 10000))\n\n      return None\n\n  def heuristic(state, goal_index):\n      \"\"\"Heuristic function to estimate distance from current state to goal.\"\"\"\n      # Simple heuristic: count the number of items needed in inventory\n      recipe = env.world.cookbook.primitives_for(goal_index)\n      if not recipe:\n          return float('inf')\n      \n      missing_items = 0\n      for item, count in recipe.items():\n          if state.inventory[item] < count:\n              missing_items += count - state.inventory[item]\n      return missing_items\n\n  def a_star(start_state, goal_name, goal_arg):\n      \"\"\"A* search with heuristic to find the shortest path.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_scores = {start_state: 0}\n      f_scores = {start_state: heuristic(start_state, goal_arg)}\n      came_from = {}\n\n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              tentative_g_score = g_scores[current_state] + 1\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n              \n              if tentative_g_score < g_scores.get(next_state, float('inf')):\n                  came_from[next_state] = (current_state, action)\n                  g_scores[next_state] = tentative_g_score\n                  f_scores[next_state] = tentative_g_score + heuristic(next_state, goal_arg)\n                  heapq.heappush(open_set, (f_scores[next_state], next_state, actions_taken + [action]))\n\n      return None\n\n  def reconstruct_path(came_from, current):\n      \"\"\"Reconstructs the path from start to current.\"\"\"\n      total_path = []\n      while current in came_from:\n          prev, action = came_from[current]\n          total_path.append(action)\n          current = prev\n      return total_path[::-1]\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:51:51.637138", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              _, next_state = current_state.step(action)\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Reset the environment to get a fresh scenario\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:53:13.526545", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n    priority = 0\n    \n    # Check if the current state has used any items or added them to the inventory\n    if np.any(state.inventory != env._current_state.inventory):\n        priority += 2\n    \n    return priority\n\n  def astar(start_state, goal):\n      \"\"\"A* search with heuristic prioritization.\"\"\"\n      from collections import deque\n      \n      # Priority queue using a heap\n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      \n      g_score = {tuple(start_state.features()): 0}\n      visited = set()\n      \n      while open_set:\n          _, current_state, actions = heapq.heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              state_features = tuple(new_state.features())\n              \n              if state_features not in visited or tentative_g_score < g_score.get(state_features, float('inf')):\n                  visited.add(state_features)\n                  g_score[state_features] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  \n                  heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:53:14.515827", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic to prioritize states with changes in inventory and closer to the goal.\"\"\"\n      \n      # Check if the current state has used any items or added them to the inventory\n      inventory_change = np.sum(np.abs(state.inventory - env._current_state.inventory))\n      \n      return inventory_change\n\n  def a_star(start_state, goal):\n      \"\"\"A* search with heuristic prioritization.\"\"\"\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, [], 0))\n      \n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n      \n      while open_set:\n          _, current_state, actions, current_cost = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          # Prioritize USE action\n          for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n              reward, new_state = current_state.step(action)\n              \n              new_cost = g_score[tuple(current_state.features())] + 1\n              tentative_g_score = new_cost\n              feature_tuple = tuple(new_state.features())\n              \n              if feature_tuple not in g_score or tentative_g_score < g_score[feature_tuple]:\n                  came_from[feature_tuple] = (tuple(current_state.features()), actions)\n                  g_score[feature_tuple] = tentative_g_score\n                  f_score[feature_tuple] = tentative_g_score + heuristic(new_state, goal)\n                  heappush(open_set, (f_score[feature_tuple], new_state, actions + [action], new_cost))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:54:12.871911", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    # Priority queue for A* search\n    queue = deque([(0, start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_cost, current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          # Calculate cost (here we use a simple heuristic: distance from goal)\n          new_cost = current_cost - reward + 1  # Assuming reward is negative or zero for actions\n          queue.append((new_cost, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Reset the environment and initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:54:13.952879", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n\n        # Create a hashable state representation\n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Ensure the environment is reset and scenario initialized\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:55:53.583697", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n      \"\"\"Heuristic function based on Manhattan distance and inventory difference.\"\"\"\n      pos = np.array(state.pos)\n      dir_vec = {\n          0: np.array([0, -1]),  # DOWN\n          1: np.array([0, 1]),   # UP\n          2: np.array([-1, 0]),  # LEFT\n          3: np.array([1, 0])    # RIGHT\n      }\n      \n      # Calculate Manhattan distance to the nearest resource needed\n      resources_needed = set(env.world.cookbook.primitives_for(goal).keys())\n      min_distance = float('inf')\n      for res in resources_needed:\n          if state.inventory[res] > 0:\n              continue\n          pos_res = np.argwhere(state.grid[:, :, res] > 0)\n          if pos_res.size == 0:\n              continue\n          distances = np.linalg.norm(pos_res - pos, ord=1, axis=1)\n          min_distance = min(min_distance, distances.min())\n      \n      # Calculate inventory difference penalty\n      inv_penalty = sum(abs(state.inventory[res] - env.world.cookbook.primitives_for(goal).get(res, 0))\n                        for res in resources_needed if state.inventory[res] < env.world.cookbook.primitives_for(goal).get(res, 0))\n      \n      return min_distance + inv_penalty\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search algorithm to find the shortest path.\"\"\"\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, start_state, []))\n      visited = set([tuple(start_state.features())])\n      \n      while open_set:\n          _, state, actions = heapq.heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              # Avoid infinite loops by checking if the inventory has changed meaningfully\n              new_features = tuple(new_state.features())\n              if new_features not in visited:\n                  visited.add(new_features)\n                  cost = len(actions) + heuristic(new_state, goal)\n                  heapq.heappush(open_set, (cost, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:55:54.545801", "function_name": "craft", "function_body": "  def heuristic(state, goal):\n      # Heuristic based on distance from having the required primitives\n      cookbook = env.world.cookbook\n      required_primitives = cookbook.primitives_for(goal)\n      current_inventory = state.inventory\n\n      missing_count = 0\n      for primitive, count in required_primitives.items():\n          missing_count += max(0, count - current_inventory[primitive])\n      \n      return missing_count\n  \n  def astar(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, start_state, []))  # (f_score, state, actions)\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n      \n      while not open_set.empty():\n          _, current_state, actions = open_set.get()\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Check if the action led to a meaningful state change\n              new_features = tuple(new_state.features())\n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if new_features not in g_score or tentative_g_score < g_score[new_features]:\n                  came_from[new_features] = (current_state, actions)\n                  g_score[new_features] = tentative_g_score\n                  f_score[new_features] = tentative_g_score + heuristic(new_state, goal)\n                  open_set.put((f_score[new_features], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:57:26.128154", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable representation of the state\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T11:57:27.097451", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        # Check if the current state satisfies the goal\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action in range(env.world.n_actions):\n            reward, next_state = current_state.step(action)\n            \n            # Create a hashable representation of the state\n            state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n            \n            if state_hash not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(state_hash)\n\n    return None\n\n  def is_reachable(goal_index):\n      \"\"\"Check if the goal item can be crafted from available primitives.\"\"\"\n      # Retrieve primitives required for the goal\n      primitives = env.world.cookbook.primitives_for(goal_index)\n      \n      # Check if all required primitives are in the initial inventory or environment\n      for primitive, count in primitives.items():\n          if (current_state.inventory[primitive] < count and\n              primitive not in env.world.grabbable_indices):\n              return False\n      \n      return True\n\n  # Validate the item index\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  # Check if the goal item can be reached\n  if not is_reachable(item):\n      raise ValueError(f\"The item with index {item} cannot be crafted from available resources.\")\n\n  # Initialize scenario and state\n  start_scenario = env.scenario\n  current_state = start_scenario.init()\n  \n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(current_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:59:01.851885", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Use Manhattan distance as a simple heuristic\n    pos = state.pos\n    goal_pos = None\n    \n    # Find the position of the goal item on the grid\n    for x in range(env.world.cookbook.n_kinds):\n        for y in range(len(state.grid)):\n            if np.argmax(state.grid[y, :, x]) == 1:\n                goal_pos = (x, y)\n                break\n        if goal_pos is not None:\n            break\n    \n    if goal_pos is None:\n        return float('inf')  # Goal item not found on the grid\n    \n    return abs(pos[0] - goal_pos[0]) + abs(pos[1] - goal_pos[1])\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, start_state, []))\n      \n      g_score = {tuple(start_state.features()): 0}\n      f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n      \n      while open_set:\n          _, state, actions = heappop(open_set)\n          \n          if state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = state.step(action)\n              \n              tentative_g_score = g_score[tuple(state.features())] + 1\n              \n              if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n                  g_score[tuple(new_state.features())] = tentative_g_score\n                  f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n                  heappush(open_set, (f_score[tuple(new_state.features())], new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T11:59:02.855665", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic function: prioritize states where the agent is closer to the required item.\n    return state.next_to(goal)\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))  # (f_score, state, actions)\n    \n    g_scores = {tuple(start_state.features()): 0}\n    came_from = {}\n    \n    while not open_set.empty():\n      _, current_state, actions = open_set.get()\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_scores[tuple(current_state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_scores or tentative_g_score < g_scores[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_scores[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    total_path = []\n    while current_state in came_from:\n      (current_state, action_list) = came_from[current_state]\n      total_path.extend(action_list)\n    return total_path[::-1]\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:00:34.912212", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with pruning.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, new_state = state.step(action)\n        \n        # Prune stuck states and redundant states\n        if tuple(new_state.features()) not in visited and not is_stuck(state, actions):\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  # Reset the environment to a clean start\n  env.reset()\n  \n  # Ensure the item is known and can be crafted\n  if item not in env.world.cookbook.index.reverse_contents:\n    raise ValueError(\"Unknown item index.\")\n  \n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:00:35.926001", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate all possible next states\n      next_states = [(state.step(action)[1], action) for action in range(env.world.n_actions)]\n      \n      # Prioritize USE action to speed up crafting and apply heuristic\n      next_states.sort(key=lambda x: (x[0].inventory[goal] == 0, is_stuck(x[0], actions)))\n      \n      for new_state, action in next_states:\n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def is_stuck(state, actions):\n    \"\"\"Check if the agent is stuck.\"\"\"\n    if len(actions) < 3:\n        return False\n    last_three_actions = actions[-3:]\n    # Check for repetitive patterns indicating being stuck (e.g., going in a small loop)\n    return last_three_actions == [UP, DOWN, UP] or last_three_actions == [DOWN, UP, DOWN] or\\\n           last_three_actions == [LEFT, RIGHT, LEFT] or last_three_actions == [RIGHT, LEFT, RIGHT]\n\n  # Reset the environment to a clean start\n  env.reset()\n  \n  # Ensure the item is known and can be crafted\n  if item not in env.world.cookbook.index.reverse_contents:\n    raise ValueError(\"Unknown item index.\")\n  \n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:01:53.905414", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n    start_time = time.time()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n      # Optional: Check time limit to avoid infinite loops\n      elapsed_time = time.time() - start_time\n      if elapsed_time > 60:  # Time limit set to 60 seconds\n        raise TimeoutError(\"BFS took too long to find a solution.\")\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  action_sequence = bfs(start_state, item)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:01:54.894857", "function_name": "craft", "function_body": "  def hash_state(state):\n    \"\"\"Creates a hashable representation of the state.\"\"\"\n    grid_bytes = state.grid.tobytes()\n    inventory_tuple = tuple(state.inventory)\n    pos_tuple = state.pos\n    dir_value = state.dir\n    return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def get_random_position(grid_size):\n    \"\"\"Generate a random position within the grid.\"\"\"\n    width, height = grid_size\n    return (np.random.randint(width), np.random.randint(height))\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  \n  # Generate a new initial position for the agent\n  new_init_pos = get_random_position(start_scenario.init_grid.shape[:2])\n  start_state = CraftState(\n    scenario=start_scenario,\n    grid=np.copy(start_scenario.init_grid),\n    pos=new_init_pos,\n    dir=0,  # Default direction\n    inventory=np.zeros(env.world.n_kinds, dtype=int)\n  )\n\n  action_sequence = bfs(start_state, item)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:03:33.034402", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n    \"\"\"A* search to find the shortest path.\"\"\"\n    from heapq import heappush, heappop\n    \n    # Priority queue of (f_score, g_score, actions, state)\n    open_set = []\n    heappush(open_set, (0, 0, [], start_state))\n    \n    # Set for visited states\n    visited = set()\n    \n    while open_set:\n      _, g_score, actions, current_state = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        # Check if the action led to a meaningful state change\n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          \n          g_score_next = g_score + 1  # Each action costs 1\n          h_score_next = heuristic(new_state, goal)  # Estimate remaining cost\n          f_score_next = g_score_next + h_score_next\n          \n          heappush(open_set, (f_score_next, g_score_next, actions + [action], new_state))\n    \n    return None  # No solution found\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n    # More inventory of goal item is better\n    inventory_heuristic = -state.inventory[goal]\n    \n    # Encourage moving towards workshops if not at one and needed ingredients are nearby\n    workshop_bonus = 0\n    if state.world.cookbook.primitives_for(goal):\n      nearest_workshop_distance = min(\n          abs(state.pos[0] - x) + abs(state.pos[1] - y)\n          for x, y in env.world.workshop_indices\n      )\n      workshop_bonus = -nearest_workshop_distance\n    \n    return inventory_heuristic + workshop_bonus\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:03:34.084488", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def astar(start_state, goal):\n      \"\"\"A* search to find the shortest path.\"\"\"\n      from heapq import heappush, heappop\n      \n      # Priority queue of (f_score, g_score, actions, state)\n      open_set = []\n      heappush(open_set, (0, 0, [], start_state))\n      \n      # Dictionary for visited states with their best g_scores\n      came_from = {}\n      g_scores = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, g_score, actions, current_state = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return reconstruct_path(came_from, current_state, actions)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Check if the action led to a meaningful state change\n              features_tuple = tuple(new_state.features())\n              tentative_g_score = g_score + 1  # Each action costs 1\n\n              if (features_tuple not in g_scores) or (tentative_g_score < g_scores[features_tuple]):\n                  came_from[new_state] = current_state\n                  g_scores[features_tuple] = tentative_g_score\n                  f_score_next = tentative_g_score + heuristic(new_state, goal)\n                  \n                  heappush(open_set, (f_score_next, tentative_g_score, actions + [action], new_state))\n      \n      return None  # No solution found\n\n  def heuristic(state, goal):\n      \"\"\"Heuristic to prioritize states closer to the goal.\"\"\"\n      # Favor states with more of the goal item in inventory\n      return -state.inventory[goal] + np.sum(state.inventory) * 0.1  # Additional small reward for having any items\n\n  def reconstruct_path(came_from, current_state, actions):\n      \"\"\"Reconstructs the path from start to the current state.\"\"\"\n      total_actions = []\n      \n      while current_state in came_from:\n          previous_state = came_from[current_state]\n          total_actions.insert(0, actions.pop())\n          current_state = previous_state\n      \n      return total_actions\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:04:19.864440", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE action if next to required item\n        if action == USE and state.next_to(goal):\n          queue.appendleft((new_state, actions + [action]))\n        else:\n          if tuple(new_state.features()) not in visited:\n            visited.add(tuple(new_state.features()))\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:04:20.849474", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: prioritize states where the agent is next to the required item\n    return int(not state.next_to(goal))\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize states with lower heuristic value\n        h_val = heuristic(new_state, goal)\n        queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:06:01.957166", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  def optimize_actions(actions):\n    \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n    optimized_actions = []\n    for action in actions:\n      if optimized_actions and action == USE and optimized_actions[-1] != USE:\n        optimized_actions.append(USE)\n      elif not (optimized_actions and action == optimized_actions[-1]):\n        optimized_actions.append(action)\n    \n    return optimized_actions\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  optimized_actions = optimize_actions(actions)\n  return optimized_actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:06:02.943999", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return state.inventory[goal] < 1\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize USE actions\n        priority = 0 if action == USE else 1\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n          queue = deque(sorted(queue, key=lambda x: (heuristic(x[0], goal), len(x[1]), priority)))\n    \n    return None  # No solution found\n\n  def optimize_actions(actions):\n    \"\"\"Optimize the sequence of actions to remove redundant movements.\"\"\"\n    optimized_actions = []\n    for action in actions:\n      if optimized_actions and action == USE and optimized_actions[-1] != USE:\n        optimized_actions.append(USE)\n      else:\n        optimized_actions.append(action)\n    \n    return optimized_actions\n\n  def find_workshop(state):\n    \"\"\"Find the nearest workshop to move towards.\"\"\"\n    directions = [(UP, (0, -1)), (DOWN, (0, 1)), (LEFT, (-1, 0)), (RIGHT, (1, 0))]\n    for direction, delta in directions:\n      new_pos = tuple(map(sum, zip(state.pos, delta)))\n      if state.grid[new_pos] in env.world.workshop_indices:\n        return direction\n    return None\n\n  start_state = env._current_state\n  \n  # First, move to the nearest workshop\n  workshop_action = find_workshop(start_state)\n  actions = [workshop_action] if workshop_action is not None else []\n  \n  # Then, perform BFS to craft the item\n  actions += bfs(start_state, item) or []\n\n  if not actions:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  optimized_actions = optimize_actions(actions)\n  return optimized_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:07:26.073851", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function for A* search.\"\"\"\n    # Simple Manhattan distance based on inventory difference\n    current_inventory = state.inventory\n    goal_inventory = np.zeros_like(current_inventory)\n    goal_inventory[goal] = 1\n    \n    return np.sum(np.abs(goal_inventory - current_inventory))\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        features_tuple = tuple(new_state.features())\n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[features_tuple] = (tuple(state.features()), action)\n          g_score[features_tuple] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:07:27.065447", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    \"\"\"\n    Heuristic function to estimate the cost from current state to goal.\n    This is a simple heuristic that counts the number of items needed to craft the goal.\n    \"\"\"\n    cookbook = env.world.cookbook\n    primitives = cookbook.primitives_for(item)\n    \n    # Count the missing primitive items in the inventory\n    count = 0\n    for i_kind, required_count in primitives.items():\n        if state.inventory[i_kind] < required_count:\n            count += (required_count - state.inventory[i_kind])\n    return count\n\n  def a_star(start_state, goal):\n      \"\"\"A* Search to find the shortest path using heuristic.\"\"\"\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(start_state), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while not open_set.empty():\n          _, current_state, actions = open_set.get()\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              features_tuple = tuple(new_state.features())\n              \n              if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n                  came_from[features_tuple] = (current_state, actions)\n                  g_score[features_tuple] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  open_set.put((f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:08:40.246000", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Priority actions: USE, then move towards primitives\n      priority_actions = []\n      use_actions = []\n      move_towards_primitives_actions = []\n      other_actions = []\n\n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          elif any(new_state.next_to(primitive) for primitive in env.world.cookbook.primitives_for(goal)):\n            move_towards_primitives_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            found_use = False\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                found_use = True\n                break\n            if not found_use:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(move_towards_primitives_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:08:41.268165", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and then prioritize movement actions that lead to USE\n      priority_actions = []\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            # Check if the next state allows a USE action\n            for next_action in range(env.world.n_actions):\n              _, _ = new_state.step(next_action)\n              if next_action == USE and tuple(new_state.features()) not in visited:\n                priority_actions.append((new_state, actions + [action]))\n                break\n            else:\n              other_actions.append((new_state, actions + [action]))\n      \n      # Extend queue with prioritized actions\n      queue.extend(priority_actions)\n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:09:46.135070", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (\n          tuple(next_state.grid.flatten()), \n          tuple(next_state.inventory), \n          next_state.pos, \n          next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:09:47.231604", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable state representation\n              state_hash = (\n                  tuple(next_state.grid.flatten()), \n                  tuple(next_state.inventory), \n                  next_state.pos, \n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def is_valid_goal(item):\n      \"\"\"Check if the item is a valid crafting goal.\"\"\"\n      return item in env.world.cookbook.kinds\n\n  # Ensure the item is valid\n  if not is_valid_goal(item):\n      raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:11:20.699601", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Simple heuristic based on the number of items needed.\"\"\"\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal)\n    inventory = state.inventory\n    \n    count = 0\n    for primitive_index, required_count in primitives_needed.items():\n        if inventory[primitive_index] < required_count:\n            count += (required_count - inventory[primitive_index])\n    \n    return count\n\n  def a_star(start_state, goal):\n      \"\"\"A* search to find the shortest path with heuristics.\"\"\"\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.features()): 0}\n      \n      while open_set:\n          _, current_state, actions = heappop(open_set)\n          \n          if current_state.satisfies(\"\", goal):\n              return actions\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Check if the move leads to a valid and unvisited state\n              features_tuple = tuple(new_state.features())\n              tentative_g_score = g_score[tuple(current_state.features())] + 1\n              \n              if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n                  came_from[features_tuple] = (current_state, actions)\n                  g_score[features_tuple] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal)\n                  heappush(open_set, (f_score, new_state, actions + [action]))\n      \n      return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:11:21.708478", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Simple Manhattan distance between positions (assuming grid-based movement)\n    return abs(state.pos[0] - goal[0]) + abs(state.pos[1] - goal[1])\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic.\"\"\"\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current_state, actions = heapq.heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current_state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        features_tuple = tuple(new_state.features())\n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if features_tuple not in g_score or tentative_g_score < g_score[features_tuple]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[features_tuple] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heapq.heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current_state, actions):\n    \"\"\"Reconstructs the path from start to goal.\"\"\"\n    total_actions = []\n    while current_state in came_from:\n      prev_state, act = came_from[current_state]\n      total_actions.extend(act)\n      current_state = prev_state\n    return total_actions\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:13:52.499574", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic for A* search (Manhattan distance to the nearest resource).\"\"\"\n    from scipy.spatial import distance\n    \n    pos = np.array(state.pos)\n    min_dist = float('inf')\n    \n    for idx in env.world.cookbook.primitives_for(goal).keys():\n      grid = state.grid\n      positions = np.argwhere(grid[..., idx] == 1)\n      \n      for res_pos in positions:\n        dist = distance.cityblock(pos, res_pos)\n        \n        if dist < min_dist:\n          min_dist = dist\n    \n    return min_dist\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path.\"\"\"\n    from heapq import heappop, heappush\n    from collections import defaultdict\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(start_state, goal), start_state, []))\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.features())] = 0\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  # Reset the environment to a clean start\n  env.reset()\n  \n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:13:53.514278", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action to speed up crafting\n      for action in [USE] + list(set(range(env.world.n_actions)) - {USE}):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def find_closest_resource(state, resource_indices):\n    \"\"\"Find the closest resource to the current state.\"\"\"\n    from scipy.spatial import distance\n    \n    pos = np.array(state.pos)\n    min_dist = float('inf')\n    closest_pos = None\n    \n    for idx in resource_indices:\n      grid = state.grid\n      positions = np.argwhere(grid[..., idx] == 1)\n      \n      for res_pos in positions:\n        dist = distance.cityblock(pos, res_pos)\n        \n        if dist < min_dist:\n          min_dist = dist\n          closest_pos = tuple(res_pos)\n    \n    return closest_pos\n\n  def move_to_position(state, target_pos):\n    \"\"\"Generate actions to move the agent to a specific position.\"\"\"\n    pos = state.pos\n    dir_ = state.dir\n    \n    # Directions: UP=0, DOWN=1, LEFT=2, RIGHT=3\n    direction_map = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n    \n    actions = []\n    \n    # Calculate the relative position\n    dx = target_pos[0] - pos[0]\n    dy = target_pos[1] - pos[1]\n    \n    # Adjust direction if necessary\n    if dx < 0 and dir_ != 2:\n      actions.append(LEFT)\n      dir_ = 2\n    elif dx > 0 and dir_ != 3:\n      actions.append(RIGHT)\n      dir_ = 3\n    elif dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the x direction\n    for _ in range(abs(dx)):\n      if dx < 0:\n        actions.append(LEFT)\n      else:\n        actions.append(RIGHT)\n    \n    # Adjust direction if necessary\n    if dy < 0 and dir_ != 0:\n      actions.append(UP)\n      dir_ = 0\n    elif dy > 0 and dir_ != 1:\n      actions.append(DOWN)\n      dir_ = 1\n    \n    # Move in the y direction\n    for _ in range(abs(dy)):\n      if dy < 0:\n        actions.append(UP)\n      else:\n        actions.append(DOWN)\n    \n    return actions\n\n  def craft_item_from_resources(state, item):\n    \"\"\"Craft an item using available resources.\"\"\"\n    primitives_needed = env.world.cookbook.primitives_for(item)\n    \n    for resource, count in primitives_needed.items():\n      if state.grid[..., resource].sum() < count:\n        raise ValueError(f\"Not enough {env.world.cookbook.index.get(resource)} found on the grid.\")\n    \n    # Use BFS to find a path to craft the item from the collected resources\n    final_actions = bfs(state, item)\n    \n    if final_actions is None:\n      raise ValueError(\"No path to craft the item found.\")\n    \n    return final_actions\n\n  start_state = env._current_state\n  \n  # Get all primitive resources needed to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item)\n  \n  if not primitives_needed:\n    raise ValueError(\"No recipe found for the item.\")\n\n  actions = []\n  \n  for resource, count in primitives_needed.items():\n    for _ in range(count):\n      # Find the closest position of this resource\n      target_pos = find_closest_resource(start_state, [resource])\n      \n      if target_pos is None:\n        raise ValueError(f\"No {env.world.cookbook.index.get(resource)} found on the grid.\")\n      \n      # Move to the target position\n      actions.extend(move_to_position(start_state, target_pos))\n      start_state = env._current_state\n      \n      # Pick up the resource\n      actions.append(USE)\n      start_state = env._current_state\n\n  final_actions = craft_item_from_resources(start_state, item)\n  \n  return actions + final_actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:15:26.324747", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)\n      \n      if state_hash in visited_states:\n          continue\n      \n      visited_states.add(state_hash)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash_next = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash_next not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:15:27.294303", "function_name": "craft", "function_body": "  def heuristic(current_state, goal_index):\n      # Simple heuristic: count the number of missing items needed for the recipe\n      inventory = current_state.inventory\n      recipe = env.world.cookbook.recipes.get(goal_index, {})\n\n      if \"_key\" in recipe:\n          recipe_key = recipe[\"_key\"]\n          del recipe[\"_key\"]\n          recipe_count = sum(recipe.values())\n          return (recipe_count - np.sum(inventory[list(recipe.keys())])) + 1\n      else:\n          recipe_count = sum(recipe.values())\n          return recipe_count - np.sum(inventory[list(recipe.keys())])\n\n  def astar(start_state, goal_index):\n      from queue import PriorityQueue\n\n      open_set = PriorityQueue()\n      open_set.put((0, start_state, []))\n      came_from = {}\n      g_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n      f_score = {tuple(start_state.grid.flatten()) + tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_index)}\n\n      while not open_set.empty():\n          current_f, current_state, actions_taken = open_set.get()\n          state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (start_state.dir,)\n\n          if current_state.satisfies('default', goal_index):\n              return reconstruct_path(came_from, current_state, actions_taken)\n          \n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              next_state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              tentative_g_score = g_score[state_hash] + 1\n\n              if next_state_hash not in g_score or tentative_g_score < g_score[next_state_hash]:\n                  came_from[next_state_hash] = current_state\n                  g_score[next_state_hash] = tentative_g_score\n                  f_score[next_state_hash] = tentative_g_score + heuristic(next_state, goal_index)\n                  open_set.put((f_score[next_state_hash], next_state, actions_taken + [action]))\n      \n      return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = [current_state]\n      total_actions = []\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          total_path.append(current_state)\n          total_actions.insert(0, actions_taken.pop())\n      return total_actions\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_index = item\n\n  action_sequence = astar(start_state, goal_index)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:16:35.602674", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return -state.inventory[goal]\n  \n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Sort and extend queue with prioritized actions\n      use_actions.sort(key=lambda x: heuristic(x[0], goal))\n      other_actions.sort(key=lambda x: heuristic(x[0], goal))[:5]\n      \n      queue.extend(use_actions)\n      queue.extend(other_actions)\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:16:36.615013", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states closer to the goal.\"\"\"\n    # Simple heuristic based on the count of the goal item in the inventory\n    return -state.inventory[goal]\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE actions\n      use_actions = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE:\n            use_actions.append((new_state, actions + [action]))\n          else:\n            other_actions.append((new_state, actions + [action]))\n      \n      # Sort actions based on heuristic and prioritize USE actions\n      queue.extend(sorted(use_actions, key=lambda x: heuristic(x[0], goal)))\n      queue.extend(sorted(other_actions[:5], key=lambda x: heuristic(x[0], goal)))  # Limit non-USE actions to avoid explosion\n      \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:17:53.837188", "function_name": "craft", "function_body": "  def state_hash(state):\n    # Hash the grid, inventory, position, and direction into a tuple for BFS\n    return (tuple(state.grid.flatten()), tuple(state.inventory), state.pos, state.dir)\n\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            # Include the reward and next state as a tuple\n            actions.append((action, reward, next_state))\n    return actions\n\n  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        # Check if the current state satisfies the goal condition\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                queue.append((next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:17:54.835421", "function_name": "craft", "function_body": "  # Convert the item name to its corresponding index using the cookbook\n  try:\n    item_index = env.world.cookbook.index[item]\n  except KeyError:\n    raise ValueError(f\"Item '{item}' not found in the cookbook.\")\n\n  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n    actions = []\n    for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        if next_state is not None:\n            actions.append((action, reward, next_state))\n    return actions\n\n  # A* search algorithm to find the shortest sequence of actions\n  def a_star(start_state, goal_name, goal_arg):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))  # Priority queue with (cost, state, action_sequence)\n    visited_states = set()\n\n    while open_set:\n        current_cost, current_state, actions_taken = heapq.heappop(open_set)\n\n        if current_state.satisfies(goal_name, goal_arg):\n            return actions_taken\n\n        # Generate all possible next states\n        for action, reward, next_state in get_possible_actions(current_state):\n            hash_val = state_hash(next_state)\n            \n            if hash_val not in visited_states:\n                cost_to_next = current_cost + 1  # Each action has a uniform cost of 1\n                heapq.heappush(open_set, (cost_to_next, next_state, actions_taken + [action]))\n                visited_states.add(hash_val)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item_index\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:19:13.749461", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic: prioritize states where the agent is next to the required item\n    return int(not state.next_to(goal))\n\n  def a_star(start_state, goal):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while open_set:\n      _, state, actions = heappop(open_set)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Heuristic: Prioritize states with lower heuristic value\n        h_val = heuristic(new_state, goal)\n        f_val = len(actions) + h_val  # f(n) = g(n) + h(n)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          heappush(open_set, (f_val, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:19:14.734780", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Heuristic based on Manhattan distance to the required item\n    if not state.next_to(goal):\n      grid_indices = np.argwhere(state.grid[..., goal] == 1)\n      if len(grid_indices) > 0:\n        pos = np.array(state.pos)\n        nearest_item_pos = min(grid_indices, key=lambda x: np.sum(np.abs(x - pos)))\n        return np.sum(np.abs(nearest_item_pos - pos))\n      else:\n        return float('inf')  # No item found in grid\n    else:\n      return 0\n\n  def a_star(start_state, goal):\n    from queue import PriorityQueue\n    \n    open_set = PriorityQueue()\n    open_set.put((0, start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while not open_set.empty():\n      _, state, actions = open_set.get()\n      \n      if state.satisfies(\"\", goal):\n        return reconstruct_path(came_from, state, actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        tentative_g_score = g_score[tuple(state.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[tuple(new_state.features())] = (state, actions + [action])\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          open_set.put((f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_path = actions\n    while tuple(current.features()) in came_from:\n      _, action = came_from[tuple(current.features())]\n      total_path = action + total_path\n      current, _ = came_from[tuple(current.features())]\n    return total_path\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:20:04.962050", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      \n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:20:05.953780", "function_name": "craft", "function_body": "  def hash_state(state):\n      grid_bytes = state.grid.tobytes()\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_value = state.dir\n      return (grid_bytes, inventory_tuple, pos_tuple, dir_value)\n\n  def bfs(start_state, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = hash_state(next_state)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:21:32.006982", "function_name": "craft", "function_body": "  def state_hash(state):\n    return tuple(state.grid.flatten()) + tuple(state.inventory) + (state.pos,) + (state.dir,)\n\n  # Heuristic function for A* search\n  def heuristic(current_state, goal_arg):\n      # Simple heuristic: Manhattan distance to the nearest workshop if needed, otherwise 0\n      if not current_state.world.workshop_indices:\n          return 0\n      \n      pos_x, pos_y = current_state.pos\n      min_distance = float('inf')\n      \n      for wx, wy in [(x // env.world.grid.shape[0], y // env.world.grid.shape[1]) for x, y in current_state.world.workshop_indices]:\n          distance = abs(pos_x - wx) + abs(pos_y - wy)\n          if distance < min_distance:\n              min_distance = distance\n      \n      return min_distance\n\n  # A* search to find the sequence of actions\n  def a_star(start_state, goal_name, goal_arg):\n      import heapq\n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(start_state, goal_arg), start_state, []))\n      came_from = {}\n      g_score = {state_hash(start_state): 0}\n      \n      while open_set:\n          _, current_state, actions_taken = heapq.heappop(open_set)\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              if next_state is not None:\n                  tentative_g_score = g_score[state_hash(current_state)] + 1\n                  hash_val = state_hash(next_state)\n                  \n                  if hash_val not in g_score or tentative_g_score < g_score[hash_val]:\n                      came_from[hash_val] = (current_state, action)\n                      g_score[hash_val] = tentative_g_score\n                      f_score = tentative_g_score + heuristic(next_state, goal_arg)\n                      heapq.heappush(open_set, (f_score, next_state, actions_taken + [action]))\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-25T12:21:33.010534", "function_name": "craft", "function_body": "  def state_hash(state):\n    # Use a more efficient hash representation if the grid and inventory sizes are large.\n    return (state.pos, state.dir, tuple(np.where(state.grid == 1)[0]), tuple(np.where(state.grid == 1)[1]),\n            tuple(np.where(state.grid == 1)[2]), tuple(state.inventory))\n\n  # Helper function to generate all possible actions from the current state\n  def get_possible_actions(current_state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, next_state = current_state.step(action)\n          if next_state is not None:\n              actions.append((action, reward, next_state))\n      return actions\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, reward, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T12:22:38.251040", "function_name": "craft", "function_body": "  def get_possible_actions(current_state):\n    for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        if next_state is not None:\n            yield action, next_state\n\n  # Breadth-first search to find the sequence of actions\n  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action, next_state in get_possible_actions(current_state):\n              hash_val = state_hash(next_state)\n              \n              if hash_val not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(hash_val)\n\n      return None\n\n  def state_hash(state):\n    \"\"\"Create a hashable representation of the current state.\"\"\"\n    grid_tuple = tuple(map(tuple, state.grid))\n    return (grid_tuple,) +\\\n           tuple(state.inventory) +\\\n           (state.pos,) +\\\n           (state.dir,)\n  \n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 6, "scores": {"3": -1}}
