{"timestamp": "2025-06-25T14:27:56.060175", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Create a hashable representation of the state\n              state_hash = (\n                  tuple(next_state.grid.flatten()),\n                  tuple(next_state.inventory),\n                  next_state.pos,\n                  next_state.dir\n              )\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:27:57.151924", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n          \n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n          \n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  # Ensure the item is valid\n  if item < 0 or item >= env.world.cookbook.n_kinds:\n      raise ValueError(f\"Item index {item} is out of bounds. Valid indices are from 0 to {env.world.cookbook.n_kinds - 1}\")\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:29:03.798270", "function_name": "craft", "function_body": "  def heuristic(state, goal_arg):\n    # Simple heuristic based on the distance between items in the inventory and the goal\n    inventory_counts = state.inventory.copy()\n    primitives_needed = env.world.cookbook.primitives_for(goal_arg)\n    \n    # Calculate the difference in counts needed for each primitive\n    missing_counts = np.array([max(primitives_needed.get(p, 0) - inventory_counts[p], 0) for p in primitives_needed])\n    return int(np.sum(missing_counts))\n\n  def a_star(start_state, goal_name, goal_arg):\n      from queue import PriorityQueue\n\n      open_set = PriorityQueue()\n      open_set.put((0, start_state, []))  # (f_score, state, actions_taken)\n      came_from = {}\n      g_score = {tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): 0}\n      f_score = {tuple(start_state.inventory) + (start_state.pos,) + (start_state.dir,): heuristic(start_state, goal_arg)}\n\n      while not open_set.empty():\n          _, current_state, actions_taken = open_set.get()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return reconstruct_path(came_from, current_state, actions_taken)\n\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              \n              # Use a hash that ignores the grid and focuses on inventory, position, and direction\n              state_hash = tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              tentative_g_score = g_score[tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[next_state] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(next_state, goal_arg)\n                  open_set.put((f_score[state_hash], next_state, actions_taken + [action]))\n\n      return None\n\n  def reconstruct_path(came_from, current_state, actions_taken):\n      total_path = []\n      while current_state in came_from:\n          total_path.append(actions_taken[-1])\n          actions_taken = actions_taken[:-1]\n          current_state = came_from[current_state]\n      return list(reversed(total_path))\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:29:04.780790", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n      from collections import deque\n\n      queue = deque([(start_state, [])])\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.popleft()\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n\n              # Use a hash that ignores the grid and focuses on inventory, position, and direction for faster convergence\n              state_hash = tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n\n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  def heuristic(state, goal_arg):\n      \"\"\"Heuristic function based on the difference between current inventory and goal item count.\"\"\"\n      return max(0, 1 - state.inventory[goal_arg])\n\n  def astar(start_state, goal_name, goal_arg):\n      from heapq import heappop, heappush\n\n      open_set = []\n      heappush(open_set, (0, start_state, []))\n      visited_states = set()\n\n      while open_set:\n          _, current_state, actions_taken = heappop(open_set)\n\n          if current_state.satisfies(goal_name, goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n\n              # Use a hash that ignores the grid and focuses on inventory, position, and direction for faster convergence\n              state_hash = tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n\n              if state_hash not in visited_states:\n                  g_score = len(actions_taken) + 1\n                  h_score = heuristic(next_state, goal_arg)\n                  f_score = g_score + h_score\n\n                  heappush(open_set, (f_score, next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:29:40.390385", "function_name": "craft", "function_body": "  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:           # LEFT\n          neighbors.append((x - 1, y))\n      if x < env.world.WIDTH - 1:  # RIGHT\n          neighbors.append((x + 1, y))\n      if y > 0:           # DOWN\n          neighbors.append((x, y - 1))\n      if y < env.world.HEIGHT - 1: # UP\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      for workshop in env.world.workshop_indices:\n          if np.any(env.current_state.grid[:, :, workshop] > 0) and pos == np.argwhere(env.current_state.grid[:, :, workshop] > 0)[0]:\n              return True\n      return False\n\n  def bfs(start_state, goal_arg):\n      \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n      queue = [(start_state, [])]\n      visited_states = set()\n\n      while queue:\n          current_state, actions_taken = queue.pop(0)\n\n          if current_state.satisfies('default', goal_arg):\n              return actions_taken\n\n          # Generate all possible next states\n          for action in range(env.world.n_actions):\n              reward, next_state = current_state.step(action)\n              state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n              \n              if state_hash not in visited_states:\n                  queue.append((next_state, actions_taken + [action]))\n                  visited_states.add(state_hash)\n\n      return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  \n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:29:41.461555", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:30:09.978264", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:30:11.081685", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:30:43.331731", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action and avoid revisiting the same position\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:30:44.295206", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state):\n    # Simple heuristic: count the number of non-zero items in inventory that are not the goal\n    return np.sum((state.inventory > 0) & (np.arange(len(state.inventory)) != item))\n\n  def a_star(start_state, goal):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (heuristic(start_state), start_state, []))\n    came_from = {}\n    g_score = {tuple(start_state.features()): 0}\n    \n    while open_set:\n      _, current, actions = heappop(open_set)\n      \n      if current.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(env.world.n_actions)[:-1]):\n        reward, new_state = current.step(action)\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-25T14:31:45.393136", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n    from heapq import heappop, heappush\n    import numpy as np\n\n    # Priority queue with (estimated_cost, actions_taken, current_state)\n    pq = [(0, [], start_state)]\n    visited_states = set()\n\n    while pq:\n      _, actions_taken, current_state = heappop(pq)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          # Estimate cost as number of actions taken + heuristic (e.g., Manhattan distance to goal items)\n          estimated_cost = len(actions_taken) + heuristic(next_state, goal_arg)\n          heappush(pq, (estimated_cost, actions_taken + [action], next_state))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # A simple heuristic: sum of distances to all required ingredients\n    total_distance = 0\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    \n    for i_kind in primitives:\n      if current_state.inventory[i_kind] < primitives[i_kind]:\n        # Find the nearest instance of this ingredient on the grid\n        positions = np.argwhere(current_state.grid[:, :, i_kind])\n        if len(positions) > 0:\n          nearest_position = min(\n              positions,\n              key=lambda pos: manhattan_distance(pos, current_state.pos)\n          )\n          total_distance += manhattan_distance(nearest_position, current_state.pos)\n\n    return total_distance\n\n  def manhattan_distance(p1, p2):\n    \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:31:46.400270", "function_name": "craft", "function_body": "  def astar(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    from heapq import heappop, heappush\n    import numpy as np\n\n    # Priority queue with (estimated_cost, actions_taken, current_state)\n    pq = [(0, [], start_state)]\n    visited_states = set()\n\n    while pq:\n      _, actions_taken, current_state = heappop(pq)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()),\n            tuple(next_state.inventory),\n            next_state.pos,\n            next_state.dir\n        )\n\n        if state_hash not in visited_states:\n          # Estimate cost as number of actions taken + heuristic (e.g., Manhattan distance to goal items)\n          estimated_cost = len(actions_taken) - reward + heuristic(next_state, goal_arg)\n          heappush(pq, (estimated_cost, actions_taken + [action], next_state))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(current_state, goal_arg):\n    \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n    # A simple heuristic: sum of distances to all required ingredients\n    total_distance = 0\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    \n    for i_kind in primitives:\n      if current_state.inventory[i_kind] < primitives[i_kind]:\n        # Find the nearest instance of this ingredient on the grid\n        positions = np.argwhere(current_state.grid[:, :, i_kind])\n        if len(positions) > 0:\n          nearest_position = min(\n              positions,\n              key=lambda pos: manhattan_distance(pos, current_state.pos)\n          )\n          total_distance += manhattan_distance(nearest_position, current_state.pos)\n\n    return total_distance\n\n  def manhattan_distance(p1, p2):\n    \"\"\"Calculate the Manhattan distance between two points.\"\"\"\n    return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n\n  # Reset environment and get the initial state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = astar(start_state, goal_name, goal_arg)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:32:16.731280", "function_name": "craft", "function_body": "  def satisfies(state, goal_arg):\n    return state.inventory[goal_arg] > 0\n\n  def bfs(start_state, goal_arg):\n    from collections import deque\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      current_hash = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)\n\n      if satisfies(current_state, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the environment\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:32:17.842073", "function_name": "craft", "function_body": "  def satisfies(state, goal_arg):\n    return state.inventory[goal_arg] > 0\n\n  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n      state_hash = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)\n\n      if satisfies(current_state, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        next_state_hash = (tuple(next_state.grid.flatten()), tuple(next_state.inventory), next_state.pos, next_state.dir)\n\n        if next_state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(next_state_hash)\n\n    return None\n\n  # Initialize the environment\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_arg)\n  if action_sequence is not None:\n      return action_sequence\n  else:\n      raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T14:32:57.528598", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        state_hash = (\n            tuple(next_state.grid.flatten()), \n            tuple(next_state.inventory), \n            next_state.pos, \n            next_state.dir\n        )\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def is_valid_goal(item):\n    \"\"\"Check if the item is a valid crafting goal.\"\"\"\n    return item in env.world.cookbook.kinds\n\n  # Ensure the environment and scenario are properly initialized\n  try:\n      env.reset()\n      start_scenario = env.scenario\n  except AttributeError as e:\n      raise ValueError(\"The environment does not have a scenario attribute. Make sure to initialize it properly.\") from e\n  \n  if not hasattr(start_scenario, 'init'):\n      raise ValueError(\"The scenario does not have an init method. Make sure the scenario is initialized correctly.\")\n  \n  start_state = start_scenario.init()\n\n  # Validate the item\n  if not is_valid_goal(item):\n    raise ValueError(f\"Item {item} is not a valid crafting goal.\")\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n\n  if action_sequence:\n      return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
