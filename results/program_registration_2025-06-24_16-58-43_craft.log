{"timestamp": "2025-06-24T19:14:46.911323", "function_name": "craft", "function_body": "  def find_path_to_item(item_index):\n    # Placeholder function to find a path to an item on the grid\n    # This should be replaced with actual pathfinding logic\n    return [0] * 10  # Example: return a sequence of actions\n\n  def use_workshop_if_needed():\n    # Placeholder function to determine if and how to use a workshop\n    # This should be replaced with actual logic for using workshops\n    return []\n\n  def update_inventory():\n    # Update inventory based on the current state and grid\n    pass\n\n  action_sequence = []\n  \n  while not env._current_state.satisfies(None, item):\n      path_to_item = find_path_to_item(item)\n      action_sequence.extend(path_to_item)\n\n      use_workshop_actions = use_workshop_if_needed()\n      action_sequence.extend(use_workshop_actions)\n\n      # Use the item or perform necessary actions to craft it\n      if env._current_state.next_to(item):\n          action_sequence.append(4)  # Assuming action index 4 is the USE action\n\n      update_inventory()\n\n  return action_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-24T19:14:47.899781", "function_name": "craft", "function_body": "  # Check if the item is a primitive or in the environment\n  if item in env.world.primitives or item in env.world.non_grabbable_indices:\n    raise ValueError(f\"Item {item} is not craftable as it's either a primitive or part of the non-grabbable environment.\")\n\n  def find_path_to_item(item, current_inventory):\n    # Placeholder function to determine the sequence of actions needed to gather an item.\n    return []\n\n  def craft_item(recipe, current_inventory):\n    actions = []\n    for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n        continue\n      while current_inventory[ingredient] < count:\n        actions.extend(find_path_to_item(ingredient, current_inventory))\n        current_inventory[ingredient] += 1\n\n    # Assuming the crafting action is always the last action needed and can be triggered by using an item.\n    actions.append(env.world.cookbook.index[\"USE\"])\n    return actions\n\n  # Get the recipe for the desired item\n  if item not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item {item}.\")\n\n  recipe = env.world.cookbook.recipes[item]\n  current_inventory = np.zeros(env.world.n_kinds)\n\n  # Craft the item using the recipe\n  actions = craft_item(recipe, current_inventory)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-24T19:17:43.385228", "function_name": "craft", "function_body": "  # Initialize an empty action sequence\n  actions = []\n\n  def find_item_in_inventory(item_index):\n      return env._current_state.inventory[item_index] > 0\n\n  def pick_up_item(item_index):\n    for i in range(env.world.n_kinds):\n      if env._current_state.next_to(i) and i == item_index:\n        actions.append(4)  # Action to USE the item\n        return True\n    return False\n\n  def move_towards_item(target_position):\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_position\n    \n    if current_x < target_x:\n      actions.append(3)  # RIGHT\n    elif current_x > target_x:\n      actions.append(2)  # LEFT\n    elif current_y < target_y:\n      actions.append(0)  # DOWN\n    elif current_y > target_y:\n      actions.append(1)  # UP\n\n  def find_item_position(item_index):\n    for x in range(env.world.grid.shape[0]):\n        for y in range(env.world.grid.shape[1]):\n            if env._current_state.grid[x, y, item_index] > 0:\n                return (x, y)\n    return None\n\n  # Get the primitives required to craft the desired item\n  primitives = env.world.cookbook.primitives_for(item)\n\n  while not find_item_in_inventory(item):\n      for primitive, count in primitives.items():\n          if env._current_state.inventory[primitive] < count:\n              target_position = find_item_position(primitive)\n              if target_position is not None:\n                  move_towards_item(target_position)\n                  pick_up_item(primitive)\n              \n  actions.append(4)  # Action to USE the item (assuming crafting happens here)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-24T19:17:44.346084", "function_name": "craft", "function_body": "  action_list = []\n\n  # Check if the goal is a primitive or already in inventory\n  if env.world.cookbook.primitives_for(item):\n    print(\"Goal is a primitive or already in inventory.\")\n    return []\n\n  # Start with an empty inventory and initial position\n  current_state = env._current_state\n\n  def find_recipe(output_index):\n      \"\"\"Finds the recipe for the given output index.\"\"\"\n      for recipe_output, ingredients in env.world.cookbook.recipes.items():\n          if recipe_output == output_index:\n              return ingredients\n      return None\n\n  def gather_primitives(recipe):\n      \"\"\"Gathers all primitives required by the recipe and adds corresponding actions to action_list.\"\"\"\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          if env.world.cookbook.index.get(ingredient) is not None:\n              item_index = env.world.cookbook.index.get(ingredient)\n              while current_state.inventory[item_index] < count:\n                  # Find the position of the required primitive on the grid\n                  pos = find_item_on_grid(current_state.grid, item_index)\n                  if pos:\n                      move_to_position(current_state.pos, pos)\n                      action_list.append(env.ACTIONS[\"USE\"])\n                      current_state = env.step(env.ACTIONS[\"USE\"])[1]\n                  else:\n                      print(f\"Primitive {ingredient} not found on the grid.\")\n              return True\n      return False\n\n  def find_item_on_grid(grid, item_index):\n      \"\"\"Finds the position of the required primitive on the grid.\"\"\"\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if len(positions) > 0:\n          return tuple(positions[0])\n      return None\n\n  def move_to_position(current_pos, target_pos):\n      \"\"\"Moves the agent to the target position and adds corresponding actions to action_list.\"\"\"\n      dx = target_pos[1] - current_pos[1]\n      dy = target_pos[0] - current_pos[0]\n\n      # Adjust direction\n      if dx > 0:\n          turn_to_direction(current_state.dir, env.DIRECTIONS[\"RIGHT\"])\n      elif dx < 0:\n          turn_to_direction(current_state.dir, env.DIRECTIONS[\"LEFT\"])\n\n      # Move horizontally\n      for _ in range(abs(dx)):\n          action_list.append(env.ACTIONS[\"RIGHT\"] if dx > 0 else env.ACTIONS[\"LEFT\"])\n          current_state = env.step(action_list[-1])[1]\n\n      # Adjust direction\n      if dy > 0:\n          turn_to_direction(current_state.dir, env.DIRECTIONS[\"DOWN\"])\n      elif dy < 0:\n          turn_to_direction(current_state.dir, env.DIRECTIONS[\"UP\"])\n\n      # Move vertically\n      for _ in range(abs(dy)):\n          action_list.append(env.ACTIONS[\"DOWN\"] if dy > 0 else env.ACTIONS[\"UP\"])\n          current_state = env.step(action_list[-1])[1]\n\n  def turn_to_direction(current_dir, target_dir):\n      \"\"\"Turns the agent to the target direction and adds corresponding actions to action_list.\"\"\"\n      # Calculate the difference between current and target directions\n      diff = (target_dir - current_dir) % 4\n\n      if diff == 1:\n          action_list.append(env.ACTIONS[\"TURN_RIGHT\"])\n      elif diff == 2:\n          action_list.append(env.ACTIONS[\"TURN_AROUND\"])\n      elif diff == 3:\n          action_list.append(env.ACTIONS[\"TURN_LEFT\"])\n\n      # Update the current direction\n      current_state.dir = target_dir\n\n  # Find the recipe for the desired item\n  recipe = find_recipe(item)\n  if not recipe:\n      print(f\"No recipe found for item {item}.\")\n      return []\n\n  # Gather all primitives required by the recipe\n  if gather_primitives(recipe):\n      print(\"Primitives gathered successfully.\")\n  else:\n      print(\"Failed to gather all primitives.\")\n\n  # Craft the desired item (placeholder logic)\n  action_list.append(env.ACTIONS[\"USE\"])\n\n  return action_list", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-24T19:22:52.311251", "function_name": "craft", "function_body": "  def parse_fexp(fexp: str) -> tuple[str, str]:\n    import re\n    match = re.match(r\"(\\w+)\\[(\\w+)]\", fexp)\n    if match:\n        return match.groups()\n    else:\n        raise ValueError(\"Invalid functional expression format.\")\n\n  def flatten(lol):\n      \"\"\"Flattens a list of lists (possibly nested).\"\"\"\n      flat_list = []\n      for item in lol:\n          if isinstance(item, (list, tuple)):\n              flat_list.extend(flatten(item))\n          else:\n              flat_list.append(item)\n      return flat_list\n\n  def postorder(tree):\n      \"\"\"Yields nodes in post-order traversal.\"\"\"\n      if isinstance(tree, tuple):\n          for node in tree:\n              yield from postorder(node)\n          yield tree\n      else:\n          yield tree\n\n  def tree_map(function, tree):\n      \"\"\"Applies a function to each node of the tree and returns a new tree with the results.\"\"\"\n      if isinstance(tree, tuple):\n          return tuple(tree_map(function, node) for node in tree)\n      else:\n          return function(tree)\n\n  def tree_zip(*trees):\n      \"\"\"Zips elements at each position in multiple trees with identical structure.\"\"\"\n      if all(isinstance(t, tuple) for t in trees):\n          return tuple(tree_zip(*nodes) for nodes in zip(*trees))\n      elif all(not isinstance(t, tuple) for t in trees):\n          return tuple(trees)\n      else:\n          raise ValueError(\"Trees have different structures.\")\n\n  def get_recipe_output_index(item_index, cookbook):\n    \"\"\"Returns the output index of the recipe that produces the item.\"\"\"\n    for output_index, recipe in cookbook.recipes.items():\n        if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n            return output_index\n    raise ValueError(f\"No recipe found for item index {item_index}.\")\n\n  def collect_primitives(primitive_indices, cookbook):\n      \"\"\"Collects primitives from the environment.\"\"\"\n      actions = []\n      for primitive_index in primitive_indices:\n          while env._current_state.inventory[primitive_index] < 1:  # Assuming we need at least one of each\n              positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n              \n              if len(positions) == 0:\n                  raise ValueError(f\"Not enough {cookbook.index.get(primitive_index, 'unknown item')} to craft the required primitives.\")\n              \n              closest_pos = min(positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n              actions.extend(move_actions)\n              \n              # Pick up the primitive\n              actions.append(4)  # Assuming USE action is represented by 4\n              \n              _, env._current_state = env.step(actions[-1])\n      return actions\n\n  def move_to(pos1, pos2):\n      \"\"\"Moves from one position to another.\"\"\"\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n      \n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def craft_recipe(output_index, cookbook):\n      \"\"\"Crafts a recipe given its output index.\"\"\"\n      actions = []\n      recipe = cookbook.recipes[output_index]\n      \n      # Collect all required ingredients\n      ingredient_actions = collect_primitives(recipe.keys(), cookbook)\n      actions.extend(ingredient_actions)\n      \n      # Find a workshop location to craft the item\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)  # Assuming one type of workshop for simplicity\n      \n      if len(workshop_positions) == 0:\n          raise ValueError(f\"No workshop available to craft {cookbook.index.get(output_index, 'unknown item')}.\")\n      \n      closest_workshop = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n      move_actions = move_to(env._current_state.pos, tuple(closest_workshop))\n      actions.extend(move_actions)\n      \n      # Craft the item (USE action at workshop)\n      actions.append(4)  # Assuming USE action is represented by 4\n      \n      _, env._current_state = env.step(actions[-1])\n      \n      return actions\n\n  def craft_item(item_index, cookbook):\n      \"\"\"Crafts an item recursively if it requires other items.\"\"\"\n      actions = []\n      \n      while not env._current_state.satisfies(\"\", item_index):\n          # Find the recipe that produces the item\n          output_index = get_recipe_output_index(item_index, cookbook)\n          \n          # Collect all required ingredients\n          ingredient_actions = collect_primitives(cookbook.recipes[output_index].keys(), cookbook)\n          actions.extend(ingredient_actions)\n          \n          # Craft the item\n          craft_actions = craft_recipe(output_index, cookbook)\n          actions.extend(craft_actions)\n      \n      return actions\n\n  if isinstance(item, str):\n    item_index = env.world.cookbook.index[item]\n  else:\n    item_index = item\n  \n  # Check if the item is a primitive or environment entity\n  if item_index in env.world.non_grabbable_indices or item_index in env.world.grabbable_indices:\n    return []\n\n  # Craft the item using the recursive crafting function\n  actions = craft_item(item_index, env.world.cookbook)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-24T19:22:53.292563", "function_name": "craft", "function_body": "  def flatten(lst):\n      for elem in lst:\n          if isinstance(elem, list):\n              yield from flatten(elem)\n          else:\n              yield elem\n\n  if isinstance(item, str):\n    item_index = env.world.cookbook.index[item]\n  else:\n    item_index = item\n\n  # Check if the item is a primitive or environment entity\n  if item_index in env.world.non_grabbable_indices or item_index in env.world.grabbable_indices:\n    return []\n\n  def move_to(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n      \n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      return actions\n\n  def collect_primitive(primitive_index, count):\n      while env._current_state.inventory[primitive_index] < count:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive_index, 'unknown item')} to craft {item}.\")\n          \n          # Move towards the closest primitive\n          closest_pos = min(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n          actions.extend(move_actions)\n          \n          # Pick up the primitive (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after picking up\n          _, env._current_state = env.step(actions[-1])\n      \n      if env._current_state.inventory[primitive_index] >= count:\n          return\n\n  def craft_item(item_index):\n      while not env._current_state.satisfies(\"\", item_index):\n          # Find a workshop location to craft the item\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)  # Assuming one type of workshop for simplicity\n          \n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop available to craft {item}.\")\n          \n          # Move towards the closest workshop\n          closest_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n          actions.extend(move_actions)\n          \n          # Craft the item (USE action at workshop)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after crafting\n          _, env._current_state = env.step(actions[-1])\n      \n      if env._current_state.satisfies(\"\", item_index):\n          return\n\n  def resolve_primitives(item_index, parent_actions=[]):\n      if item_index in required_primitives:\n          collect_primitive(item_index, required_primitives[item_index])\n          return\n      \n      # Get recipe for the current item\n      recipe = env.world.cookbook.recipes.get(item_index, {})\n      \n      if \"_key\" not in recipe:\n          raise ValueError(f\"No recipe available to craft {env.world.cookbook.index.get(item_index, 'unknown item')}.\")\n      \n      # Collect all required primitives for this recipe\n      child_actions_list = []\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          \n          ingredient_index = int(ingredient)\n          if ingredient_index not in env.world.cookbook.primitives:\n              child_actions_list.append(resolve_primitives(ingredient_index))\n          \n          collect_primitive(ingredient_index, count)\n      \n      # Craft the item using a basic rule (assuming recipes are simple and direct)\n      craft_item(item_index)\n      \n      return parent_actions + list(flatten(child_actions_list))\n\n  # Get primitives required for the goal\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Initialize action list\n  actions = []\n\n  # Resolve all dependencies and collect required primitives\n  resolve_primitives(item_index, actions)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-24T19:28:04.978666", "function_name": "craft", "function_body": "  if isinstance(item, str):\n    item_index = env.world.cookbook.index[item]\n  else:\n    item_index = item\n\n  # Check if the item is a primitive or environment entity\n  if item_index in env.world.non_grabbable_indices or item_index in env.world.grabbable_indices:\n    return []\n\n  # Get primitives required for the goal\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Initialize action list\n  actions = []\n  \n  def move_to(pos1, pos2):\n      \"\"\"Move from pos1 to pos2.\"\"\"\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n      \n      actions = []\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      return actions\n\n  def collect_primitive(primitive_index, count):\n      \"\"\"Collect the required amount of a primitive.\"\"\"\n      while env._current_state.inventory[primitive_index] < count:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive_index, 'unknown item')} to craft {item}.\")\n          \n          # Move towards the closest primitive\n          closest_pos = min(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n          actions.extend(move_actions)\n          \n          # Pick up the primitive (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after picking up\n          _, env._current_state = env.step(actions[-1])\n      \n      if env._current_state.inventory[primitive_index] >= count:\n          return\n\n  def craft_item(item_index):\n      \"\"\"Craft the item using available resources.\"\"\"\n      while not env._current_state.satisfies(\"\", item_index):\n          # Move to a workshop location (assuming there is at least one)\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)\n          \n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop found to craft {item}.\")\n          \n          # Move towards the closest workshop\n          closest_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n          actions.extend(move_actions)\n          \n          # Craft the item (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after crafting\n          _, env._current_state = env.step(actions[-1])\n\n  def prioritize_primitives(required_primitives):\n      \"\"\"Prioritize primitives based on availability and distance to minimize movement.\"\"\"\n      prioritized_primitives = []\n      \n      for primitive, count in required_primitives.items():\n          available_count = env._current_state.inventory[primitive]\n          needed_count = count - available_count\n          \n          if needed_count > 0:\n              # Find positions of the primitive on the grid\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n              \n              # Sort primitives by proximity to the current position\n              sorted_primitives = sorted(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              \n              for _ in range(needed_count):\n                  if len(sorted_primitives) == 0:\n                      raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive, 'unknown item')} to craft {item}.\")\n                  \n                  closest_pos = sorted_primitives.pop(0)\n                  prioritized_primitives.append((primitive, tuple(closest_pos)))\n      \n      return prioritized_primitives\n\n  # Prioritize primitives based on availability and distance\n  prioritized_primitives = prioritize_primitives(required_primitives)\n\n  # Collect all required primitives in prioritized order\n  for primitive_index, pos in prioritized_primitives:\n      move_actions = move_to(env._current_state.pos, pos)\n      actions.extend(move_actions)\n      \n      # Pick up the primitive (USE action)\n      actions.append(4)  # Assuming USE action is represented by 4\n      \n      # Update state after picking up\n      _, env._current_state = env.step(actions[-1])\n\n  # Craft the item using a basic rule (assuming recipes are simple and direct)\n  craft_item(item_index)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-24T19:28:05.934563", "function_name": "craft", "function_body": "  if isinstance(item, str):\n    item_index = env.world.cookbook.index[item]\n  else:\n    item_index = item\n\n  # Check if the item is a primitive or environment entity\n  if item_index in env.world.non_grabbable_indices or item_index in env.world.grabbable_indices:\n    return []\n\n  # Get primitives required for the goal\n  required_primitives = env.world.cookbook.primitives_for(item_index)\n\n  # Initialize action list\n  actions = []\n  \n  def move_to(pos1, pos2):\n      dx = pos2[0] - pos1[0]\n      dy = pos2[1] - pos1[1]\n      \n      actions = []\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # DOWN\n      \n      if dx > 0:\n          actions.extend([3] * abs(dx))  # RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # LEFT\n      \n      return actions\n\n  def collect_primitive(primitive_index, count):\n      while env._current_state.inventory[primitive_index] < count:\n          primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n          \n          if len(primitive_positions) == 0:\n              raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive_index, 'unknown item')} to craft {item}.\")\n          \n          # Move towards the closest primitive\n          closest_pos = min(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n          actions.extend(move_actions)\n          \n          # Pick up the primitive (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after picking up\n          _, env._current_state = env.step(actions[-1])\n      \n      if env._current_state.inventory[primitive_index] >= count:\n          return\n\n  def craft_item(item_index):\n      while not env._current_state.satisfies(\"\", item_index):\n          # Move to a workshop location (assuming there is at least one)\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[0]] > 0)\n          \n          if len(workshop_positions) == 0:\n              raise ValueError(f\"No workshop found to craft {item}.\")\n          \n          # Move towards the closest workshop\n          closest_pos = min(workshop_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n          move_actions = move_to(env._current_state.pos, tuple(closest_pos))\n          actions.extend(move_actions)\n          \n          # Craft the item (USE action)\n          actions.append(4)  # Assuming USE action is represented by 4\n          \n          # Update state after crafting\n          _, env._current_state = env.step(actions[-1])\n\n  def prioritize_primitives(required_primitives):\n      \"\"\"Prioritize primitives based on availability and distance to minimize movement.\"\"\"\n      prioritized_primitives = []\n      \n      for primitive, count in required_primitives.items():\n          available_count = env._current_state.inventory[primitive]\n          needed_count = count - available_count\n          \n          if needed_count > 0:\n              # Find positions of the primitive on the grid\n              primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n              \n              # Sort primitives by proximity to the current position\n              sorted_primitives = sorted(primitive_positions, key=lambda pos: abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1]))\n              \n              for _ in range(needed_count):\n                  if len(sorted_primitives) == 0:\n                      raise ValueError(f\"Not enough {env.world.cookbook.index.get(primitive, 'unknown item')} to craft {item}.\")\n                  \n                  closest_pos = sorted_primitives.pop(0)\n                  prioritized_primitives.append((primitive, tuple(closest_pos)))\n      \n      return prioritized_primitives\n\n  # Prioritize primitives based on availability and distance\n  prioritized_primitives = prioritize_primitives(required_primitives)\n\n  # Collect all required primitives in prioritized order\n  for primitive_index, pos in prioritized_primitives:\n      move_actions = move_to(env._current_state.pos, pos)\n      actions.extend(move_actions)\n      \n      # Pick up the primitive (USE action)\n      actions.append(4)  # Assuming USE action is represented by 4\n      \n      # Update state after picking up\n      _, env._current_state = env.step(actions[-1])\n\n  # Craft the item using a basic rule (assuming recipes are simple and direct)\n  craft_item(item_index)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-06-24T19:30:53.476450", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    # Simple heuristic based on the number of required items in inventory\n    goal_primitives = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    missing_count = sum(max(0, count - current_inventory[primitive]) for primitive, count in goal_primitives.items())\n    return missing_count\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the USE action is likely to be productive\n        if action == USE and state.next_to(goal) and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  def a_star(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristic guidance.\"\"\"\n    from heapq import heappush, heappop\n    import itertools\n    \n    open_set = []\n    g_score = {tuple(start_state.features()): 0}\n    f_score = {tuple(start_state.features()): heuristic(start_state, goal)}\n    \n    counter = itertools.count()  # To ensure stability with tie-breaking\n    push_count = [0]\n    \n    def push(item):\n        count = next(counter)\n        heappush(open_set, (f_score[tuple(item.features())], -count, item, actions))\n        push_count[0] += 1\n    \n    push(start_state)\n    came_from = {}\n    \n    while open_set:\n      _, _, current, current_actions = heappop(open_set)\n      \n      if current.satisfies(\"\", goal):\n        return reconstruct_path(came_from, current, current_actions)\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = current.step(action)\n        \n        tentative_g_score = g_score[tuple(current.features())] + 1\n        \n        if tuple(new_state.features()) not in g_score or tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score[tuple(new_state.features())] = tentative_g_score + heuristic(new_state, goal)\n          \n          if tuple(new_state.features()) not in [item[2] for item in open_set]:\n            push(new_state)\n    \n    return None  # No solution found\n\n  def reconstruct_path(came_from, current, actions):\n    total_path = [(current, actions)]\n    while current in came_from:\n        current, action = came_from[current]\n        actions.append(action)\n        total_path.append((current, actions))\n    return list(reversed(actions))\n\n  start_state = env._current_state\n  actions = a_star(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-24T19:30:54.513873", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path with heuristic prioritization and early termination.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action when the agent is next to a workshop or an item needed for crafting\n      use_actions_first = []\n      other_actions = []\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        if action == USE and state.next_to(goal) and tuple(new_state.features()) not in visited:\n          use_actions_first.append((new_state, actions + [action]))\n        elif tuple(new_state.features()) not in visited:\n          other_actions.append((new_state, actions + [action]))\n      \n      # Process USE actions first to prioritize making progress\n      for new_state, actions in use_actions_first:\n        queue.appendleft((new_state, actions))\n        visited.add(tuple(new_state.features()))\n      \n      # Process other actions second\n      for new_state, actions in other_actions:\n        queue.append((new_state, actions))\n        visited.add(tuple(new_state.features()))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-24T19:34:32.308870", "function_name": "craft", "function_body": "  def bfs(start_pos, target_indices):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [(start_pos, [])]\n    visited = set()\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n        \n        if current_pos in visited:\n            continue\n        visited.add(current_pos)\n        \n        # Check all neighboring cells\n        for dx, dy in directions:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            \n            if (new_x < 0 or new_x >= env._current_state.grid.shape[0] or \n                new_y < 0 or new_y >= env._current_state.grid.shape[1]):\n                continue\n                \n            # Check if any of the target_indices are present in the cell\n            for index in target_indices:\n                if env._current_state.grid[new_x, new_y, index] > 0:\n                    return path + [(new_x, new_y)]\n                    \n            queue.append(((new_x, new_y), path + [(new_x, new_y)]))\n            \n    return None\n\n  def get_action_to_move(current_pos, target_pos):\n    directions = [(0, 1, 2), (1, 0, 3), (0, -1, 4), (-1, 0, 5)]\n    \n    for dx, dy, action in directions:\n        if current_pos[0] + dx == target_pos[0] and current_pos[1] + dy == target_pos[1]:\n            return action\n    \n    return None\n\n  actions = []\n  start_pos = env._current_state.pos\n  \n  # Find the nearest required items using BFS\n  recipe = env.world.cookbook.primitives_for(item)\n  required_items = list(recipe.keys())\n  \n  for req_item in required_items:\n      path_to_item = bfs(start_pos, [req_item])\n      \n      if path_to_item:\n          for next_pos in path_to_item:\n              action = get_action_to_move(start_pos, next_pos)\n              actions.append(action)\n              start_pos = next_pos\n          \n          # Use action to pick up the item\n          actions.append(4)  # Assuming 4 corresponds to the USE action\n  \n  # Craft the item using items in inventory\n  while not env._current_state.satisfies(None, item):\n      for _ in range(recipe[req_item]):\n          actions.append(4)  # Assuming 4 corresponds to the USE action\n      \n      # Try to craft the item\n      actions.append(4)\n      \n      if not env._current_state.satisfies(None, item):\n          # If crafting failed, reset inventory and try again\n          for _ in range(recipe[req_item]):\n              actions.append(env.world.n_actions - 1)  # Assuming n_actions-1 corresponds to DROP action\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
