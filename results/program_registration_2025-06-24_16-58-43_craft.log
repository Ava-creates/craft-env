{"timestamp": "2025-06-25T00:35:09.340111", "function_name": "craft", "function_body": "  def find_path_a_star(target_item, inventory, cookbook):\n    import heapq\n    \n    # Priority queue with (estimated_cost, cost_so_far, path, current_item)\n    priority_queue = [(0, 0, [], target_item)]\n    \n    visited = set()\n    \n    while priority_queue:\n        estimated_cost, cost_so_far, path, current_item = heapq.heappop(priority_queue)\n\n        if current_item in inventory and inventory[current_item] > 0:\n            return path\n        \n        if current_item in visited:\n            continue\n        visited.add(current_item)\n\n        for output_index, recipe in cookbook.recipes.items():\n            if \"_key\" not in recipe or recipe[\"_key\"] != current_item:\n                continue\n            \n            ingredients = [(ingredient_index, count) for ingredient_index, count in recipe.items() if ingredient_index != \"_key\"]\n            \n            # Check if we can craft the item from available inventory\n            required_counts = np.zeros_like(inventory)\n            for ingredient_index, count in ingredients:\n                if inventory[ingredient_index] < count:\n                    required_counts[ingredient_index] += count - inventory[ingredient_index]\n            \n            # If we have all the ingredients, add them to the path and continue crafting\n            if np.all(required_counts == 0):\n                new_path = path + [ingredient_index for ingredient_index, count in ingredients for _ in range(count)]\n                return new_path\n            \n            # Otherwise, try to get the missing ingredients first\n            for ingredient_index, count in enumerate(required_counts):\n                if count > 0:\n                    # Heuristic: number of steps required to gather all missing ingredients\n                    heuristic = np.sum(required_counts)\n                    new_cost_so_far = cost_so_far + count\n                    new_estimated_cost = new_cost_so_far + heuristic\n                    heapq.heappush(priority_queue, (new_estimated_cost, new_cost_so_far, path + [ingredient_index], ingredient_index))\n    \n    return []\n\n  cookbook = env.world.cookbook\n  inventory = env._current_state.inventory\n\n  return find_path_a_star(item, inventory, cookbook)", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:35:10.320097", "function_name": "craft", "function_body": "  def find_path_a_star(target_item, inventory, cookbook):\n    import heapq\n    \n    # Priority queue with (estimated_cost, cost, path, current_item)\n    priority_queue = [(0, 0, [], target_item)]\n    \n    visited = set()\n    \n    while priority_queue:\n        estimated_cost, cost, path, current_item = heapq.heappop(priority_queue)\n\n        if current_item in inventory and inventory[current_item] > 0:\n            return path\n        \n        if current_item in visited:\n            continue\n        visited.add(current_item)\n\n        for output_index, recipe in cookbook.recipes.items():\n            if \"_key\" not in recipe or recipe[\"_key\"] != current_item:\n                continue\n            \n            ingredients = [(ingredient_index, count) for ingredient_index, count in recipe.items() if ingredient_index != \"_key\"]\n            \n            # Calculate the required counts of missing ingredients\n            required_counts = np.zeros_like(inventory)\n            for ingredient_index, count in ingredients:\n                if inventory[ingredient_index] < count:\n                    required_counts[ingredient_index] += count - inventory[ingredient_index]\n            \n            # If we have all the ingredients, add them to the path and continue crafting\n            if np.all(required_counts == 0):\n                new_path = path + [ingredient_index for ingredient_index, count in ingredients for _ in range(count)]\n                return new_path\n            \n            # Otherwise, try to get the missing ingredients first\n            for ingredient_index, count in enumerate(required_counts):\n                if count > 0:\n                    new_cost = cost + count\n                    # Heuristic: estimate remaining cost as sum of required counts\n                    estimated_remaining_cost = np.sum(required_counts)\n                    heapq.heappush(priority_queue, (new_cost + estimated_remaining_cost, new_cost, path + [ingredient_index], ingredient_index))\n    \n    return []\n\n  cookbook = env.world.cookbook\n  inventory = env._current_state.inventory\n\n  return find_path_a_star(item, inventory, cookbook)", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:36:15.632977", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  def heuristic(state, goal_arg):\n    \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n    # Simple heuristic: count the number of items needed in the inventory\n    primitives = env.world.cookbook.primitives_for(goal_arg)\n    total_needed = sum(primitives.values())\n    current_inventory = state.inventory[list(primitives.keys())]\n    total_held = np.sum(current_inventory)\n\n    return max(0, total_needed - total_held)\n\n  def a_star(start_state, goal_name, goal_arg):\n    \"\"\"A* search for a sequence of actions to achieve the goal.\"\"\"\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (0, start_state, []))\n    visited_states = set()\n\n    while open_set:\n      current_cost, current_state, actions_taken = heapq.heappop(open_set)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          g_cost = len(actions_taken) + 1\n          h_cost = heuristic(next_state, goal_arg)\n          f_cost = g_cost + h_cost\n\n          heapq.heappush(open_set, (f_cost, next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = a_star(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:36:16.763971", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        reward, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n  \n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:36:53.214102", "function_name": "craft", "function_body": "  def bfs(start_state, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies('default', goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  goal_arg = item\n  \n  action_sequence = bfs(env.scenario.init(), goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:36:54.355322", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    from collections import deque\n\n    queue = deque([(start_state, [])])\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.popleft()\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        \n        # Create a hashable state representation\n        state_hash = tuple(next_state.grid.flatten()) + tuple(next_state.inventory) + (next_state.pos,) + (next_state.dir,)\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  env.reset()\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:37:45.520865", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to estimate the cost from state to goal.\"\"\"\n    # Simple heuristic: count of missing ingredients\n    required_primitives = env.world.cookbook.primitives_for(goal)\n    current_inventory = state.inventory\n    \n    missing_count = 0\n    for prim_kind, count in required_primitives.items():\n      missing_count += max(0, count - current_inventory[prim_kind])\n    \n    return missing_count\n\n  def astar(start_state, goal):\n    \"\"\"A* Search to find the shortest path with heuristics.\"\"\"\n    from heapq import heappush, heappop\n    from collections import defaultdict\n    \n    open_set = [(heuristic(start_state, goal), start_state, [])]\n    came_from = {}\n    g_score = defaultdict(lambda: float('inf'))\n    g_score[tuple(start_state.features())] = 0\n    \n    while open_set:\n      _, current_state, actions = heappop(open_set)\n      \n      if current_state.satisfies(\"\", goal):\n        return actions\n      \n      for action in [USE] + list(range(4)):\n        reward, new_state = current_state.step(action)\n        \n        tentative_g_score = g_score[tuple(current_state.features())] + 1\n        \n        if tentative_g_score < g_score[tuple(new_state.features())]:\n          came_from[new_state] = (current_state, action)\n          g_score[tuple(new_state.features())] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal)\n          heappush(open_set, (f_score, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = astar(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:37:46.487496", "function_name": "craft", "function_body": "  UP, DOWN, LEFT, RIGHT, USE = range(5)\n\n  def heuristic(state, goal):\n    \"\"\"Simple heuristic based on inventory and distance to goal.\"\"\"\n    inventory_diff = abs(goal - np.argmax(state.inventory))\n    return inventory_diff\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with simple heuristic for better exploration.\"\"\"\n    from collections import deque\n    from heapq import heappush, heappop\n    \n    queue = []\n    heappush(queue, (0, start_state, []))\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      _, state, actions = heappop(queue)\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          h_value = heuristic(new_state, goal)  # Calculate heuristic value\n          heappush(queue, (h_value, new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:38:30.883308", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      # Prioritize USE action when near the goal\n      for action in [USE] + list(range(4)):\n        reward, new_state = state.step(action)\n        \n        if tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          \n          if action == USE and state.next_to(goal):\n            queue.appendleft((new_state, actions + [action]))  # Prioritize immediate useful USE actions\n          else:\n            queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:38:31.859279", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def heuristic(state, goal):\n    \"\"\"Heuristic function to prioritize states that are closer to the goal.\"\"\"\n    # Check if the item is next to the agent and can be used\n    return int(state.next_to(goal)) == 0\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search with heuristic prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Check if the USE action is likely to be productive\n        if action == USE and heuristic(state, goal) and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.appendleft((new_state, actions + [action]))  # Prioritize immediate useful USE actions\n        elif action == USE and tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))  # Prioritize other USE actions\n        elif tuple(new_state.features()) not in visited:\n          visited.add(tuple(new_state.features()))\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n  \n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:39:41.393436", "function_name": "craft", "function_body": "  from collections import deque\n\n  target_index = item\n  cookbook = env.world.cookbook\n  primitives = cookbook.primitives\n  environment = cookbook.environment\n  reverse_contents = cookbook.index.reverse_contents\n  \n  # Mapping action names to their respective indices (placeholder, adjust as per actual implementation)\n  ACTION_MAP = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n      # Add more actions if needed\n  }\n\n  def bfs(start_index):\n    queue = deque([(start_index, [])])\n    visited = set()\n    \n    while queue:\n      current_index, path = queue.popleft()\n      \n      if current_index == target_index:\n        return path\n      \n      if current_index in visited:\n        continue\n      visited.add(current_index)\n      \n      # Check if the current item is a primitive or environment item\n      if current_index in primitives or current_index in environment:\n          actions.append(ACTION_MAP[\"USE\"])  # Placeholder for actual pickup/gather action logic\n          return path\n      \n      # Find recipes that require the current item as an ingredient\n      for recipe_output, ingredients in cookbook.recipes.items():\n        if current_index in ingredients.values():\n            sub_path = bfs(recipe_output)\n            if sub_path is not None:\n                actions = []\n                \n                # Find the ingredient index and corresponding action to get that item\n                for ingredient_index, count in ingredients.items():\n                    if ingredient_index == current_index:\n                        sub_actions = bfs(ingredient_index)\n                        if sub_actions is not None:\n                            actions.extend(sub_actions)\n                    \n                actions.append(ACTION_MAP[\"USE\"])  # Assume the last step involves using the crafted items\n                \n                return path + actions\n    \n    return None\n  \n  crafting_actions = bfs(target_index)\n  \n  if crafting_actions is None:\n      raise ValueError(f\"Cannot craft item with index {target_index}\")\n  \n  return crafting_actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T00:39:42.370790", "function_name": "craft", "function_body": "  # Placeholder action mapping\n  ACTION_MAP = {\n      \"DOWN\": 0,\n      \"UP\": 1,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n      # Add more actions if needed\n  }\n\n  def find_recipe(item_index):\n    \"\"\"Find the recipe for a given item index.\"\"\"\n    for output_index, ingredients in env.world.cookbook.recipes.items():\n        if output_index == item_index:\n            return ingredients\n    return None\n\n  def gather_primitive(primitive_index):\n      \"\"\"Generate actions to gather a primitive resource.\"\"\"\n      # Placeholder logic: Assume gathering primitives is straightforward and requires a single action.\n      return [ACTION_MAP[\"USE\"]]\n\n  def find_path_to_ingredient(ingredient_index, current_state):\n      \"\"\"Find a path to the ingredient on the grid.\"\"\"\n      # Placeholder logic: This function should implement pathfinding to reach an item on the grid.\n      # For simplicity, assume the agent is already next to the item.\n      return []\n\n  def use_crafting_station(current_state):\n      \"\"\"Generate actions to use a crafting station if needed.\"\"\"\n      # Placeholder logic: Assume the agent is already at a crafting station and can craft directly.\n      return [ACTION_MAP[\"USE\"]]\n\n  def bfs(start_index, target_index):\n    \"\"\"Breadth-first search to find a sequence of actions to craft the target item.\"\"\"\n    from collections import deque\n    queue = deque([(start_index, [])])\n    visited = set()\n    \n    while queue:\n        current_index, path = queue.popleft()\n        \n        if current_index == target_index:\n            return path\n        \n        if current_index in visited:\n            continue\n        visited.add(current_index)\n        \n        recipe = find_recipe(target_index)\n        if not recipe:\n            continue\n        \n        for ingredient_index, count in recipe.items():\n            # Placeholder logic: Assume we need only one of each ingredient.\n            actions_to_ingredient = []\n            \n            if ingredient_index in env.world.cookbook.primitives:\n                actions_to_ingredient.extend(gather_primitive(ingredient_index))\n            else:\n                actions_to_ingredient.extend(find_path_to_ingredient(ingredient_index, current_state))\n                sub_path = bfs(ingredient_index, ingredient_index)\n                if sub_path is not None:\n                    actions_to_ingredient.extend(sub_path)\n            \n            actions_to_use_station = use_crafting_station(current_state)\n            queue.append((target_index, path + actions_to_ingredient + actions_to_use_station))\n    \n    return None\n\n  crafting_actions = bfs(0, item)  # Start from a default state (index 0)\n\n  if crafting_actions is None:\n      raise ValueError(f\"Cannot craft item with index {item}\")\n  \n  return crafting_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-25T00:40:22.691714", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if reward < 0:\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:40:23.854116", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def is_valid_move(new_state):\n    # Check if the new state is valid by ensuring the agent's position has changed or an item was used\n    return new_state.pos != env._current_state.pos or (env._current_state.inventory != new_state.inventory).any()\n\n  def bfs(start_state, goal):\n    \"\"\"Breadth-First Search to find the shortest path.\"\"\"\n    from collections import deque\n    \n    queue = deque([(start_state, [])])\n    visited = set([tuple(start_state.features())])\n    \n    while queue:\n      state, actions = queue.popleft()\n      \n      if state.satisfies(\"\", goal):\n        return actions\n      \n      for action in range(env.world.n_actions):\n        reward, new_state = state.step(action)\n        \n        # Skip invalid moves (e.g., moving out of bounds or into obstacles)\n        if not is_valid_move(new_state) and action != USE:\n          continue\n        \n        features_tuple = tuple(new_state.features())\n        if features_tuple not in visited:\n          visited.add(features_tuple)\n          queue.append((new_state, actions + [action]))\n    \n    return None  # No solution found\n\n  start_state = env._current_state\n  actions = bfs(start_state, item)\n\n  if actions is None:\n    raise ValueError(\"No path to craft the item found.\")\n  \n  return actions", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:41:05.539611", "function_name": "craft", "function_body": "  def bfs(start_state, goal_name, goal_arg):\n    \"\"\"Breadth-first search for a sequence of actions to achieve the goal.\"\"\"\n    queue = [(start_state, [])]\n    visited_states = set()\n\n    while queue:\n      current_state, actions_taken = queue.pop(0)\n\n      if current_state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = current_state.step(action)\n        state_hash = hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir))\n        \n        if state_hash not in visited_states:\n          queue.append((next_state, actions_taken + [action]))\n          visited_states.add(state_hash)\n\n    return None\n\n  # Initialize the scenario and start state\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  # Perform BFS to find the action sequence\n  action_sequence = bfs(start_state, goal_name, goal_arg)\n  \n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-25T00:41:07.109137", "function_name": "craft", "function_body": "  def dfs_with_pruning(start_state, goal_name, goal_arg, max_depth=50):\n    \"\"\"Depth-first search with pruning for a sequence of actions to achieve the goal.\"\"\"\n    def helper(state, actions_taken, depth):\n      if state.satisfies(goal_name, goal_arg):\n        return actions_taken\n\n      if depth > max_depth:\n        return None\n\n      # Generate all possible next states\n      for action in range(env.world.n_actions):\n        _, next_state = state.step(action)\n        state_hash = hash((next_state.grid.tobytes(), tuple(next_state.inventory), next_state.pos, next_state.dir))\n        \n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          result = helper(next_state, actions_taken + [action], depth + 1)\n          if result is not None:\n            return result\n          visited_states.remove(state_hash)  # Prune the search space\n\n      return None\n\n    visited_states = set()\n    return helper(start_state, [], 0)\n\n  start_scenario = env.scenario\n  start_state = start_scenario.init()\n  goal_name = 'default'  # Assuming a default goal name for now\n  goal_arg = item\n\n  action_sequence = dfs_with_pruning(start_state, goal_name, goal_arg)\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    raise ValueError(f\"No sequence of actions found to craft item {item}\")", "island_id": 4, "scores": {"3": 1.5}}
