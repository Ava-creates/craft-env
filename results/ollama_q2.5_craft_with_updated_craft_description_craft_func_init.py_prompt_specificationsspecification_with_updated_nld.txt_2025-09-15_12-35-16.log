{"timestamp": "2025-09-15T13:06:14.945240", "function_name": "craft", "function_body": "  # Check if the item is a primitive, in which case we don't need to craft it.\n  if item in env.world.cookbook.primitives:\n      return []\n\n  # Get the index of the item from the environment's cookbook index.\n  item_index = env.world.cookbook.index[item]\n  # Check if the item is craftable.\n  if item_index not in env.world.cookbook.recipes:\n      return []\n\n  # Get the recipe for the item from the cookbook.\n  recipe = env.world.cookbook.recipes[item_index]\n  # Check if we have enough of each ingredient.\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":  # This is a special key for workshop index\n          workshop_index = count\n          continue\n      # Check if we have the ingredient in the inventory.\n      if env._current_state.inventory[ingredient] < count:\n          return []  # Not enough ingredients, return empty list.\n\n  # If we have all the ingredients, we can craft the item.\n  # Find the workshop where the item can be crafted.\n  workshop_index = recipe[\"_key\"]\n  # Get the workshop name from the index.\n  workshop_name = env.world.cookbook.index.get(workshop_index)\n  # Get the position of the workshop.\n  workshop_pos = None\n  for i in range(env.world.cookbook.index.len()):\n      if env.world.cookbook.index.get(i) == workshop_name:\n          workshop_pos = np.where(env._current_state.grid[:, :, i] == 1)\n          if workshop_pos[0].size > 0:\n              workshop_pos = (workshop_pos[0][0], workshop_pos[1][0])\n              break\n  if workshop_pos is None:\n      return []  # Workshop not found.\n\n  # Move to the workshop.\n  actions = []\n  # Calculate the direction to move towards the workshop.\n  dx = workshop_pos[0] - env._current_state.pos[0]\n  dy = workshop_pos[1] - env._current_state.pos[1]\n  if dx > 0:\n      actions.append(1)  # DOWN\n  elif dx < 0:\n      actions.append(0)  # UP\n  if dy > 0:\n      actions.append(3)  # RIGHT\n  elif dy < 0:\n      actions.append(2)  # LEFT\n  # Add the USE action to craft the item.\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
