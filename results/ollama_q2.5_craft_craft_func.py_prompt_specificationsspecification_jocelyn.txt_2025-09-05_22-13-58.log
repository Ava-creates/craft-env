s = heapq.heappop(open_list)\n          if current_pos == tuple(goal):\n              path = []\n              while current_pos in came_from:\n                  path.append(current_pos)\n                  current_pos = came_from[current_pos]\n              path.reverse()\n              return path\n\n          closed_set.add(current_pos)\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor = (current_pos[0] + dx, current_pos[1] + dy)\n              tentative_g_score = g_scores[tuple(current_pos)] + heuristic(neighbor, current_pos)\n\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or \\\n                 not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              if tuple(neighbor) in closed_set:\n                  continue\n\n              if tuple(neighbor) not in g_scores or tentative_g_score < g_scores[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current_pos\n                  g_scores[tuple(neighbor)] = tentative_g_score\n                  f_scores[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_list, (f_scores[tuple(neighbor)], tuple(neighbor)))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos))\n\n  if not path:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  for target in path:\n      dx, dy = np.array(target) - pos\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If dx == dy, choose a random direction\n          direction = np.random.choice([2, 3]) if dx >= 0 else np.random.choice([0, 1])\n          actions.append(direction)\n          if direction in [2, 3]:\n              pos[0] += 1 if direction == 3 else -1\n          else:\n              pos[1] += 1 if direction == 1 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": -1}}
