se the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:54:58.071587", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in target_positions])]\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:54:59.205691", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def find_closest_workshop(current_pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) == 0:  # No workshops found, skip to the next type\n              continue\n\n          # Calculate mean position for each workshop type and find the closest one\n          workshop_pos_mean = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(current_pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:56:37.579413", "function_name": "craft", "function_body": "  def find_closest_workshop(env):\n      pos = np.array(env._current_state.pos)\n      \n      # Calculate distances to all workshops\n      workshop_distances = []\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards for each workshop type\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n          \n          workshop_distances.append((workshop_idx, nearest_target_pos, distance))\n      \n      if not workshop_distances:\n          return None, None\n      \n      # Find the closest workshop among all types\n      closest_workshop_idx, nearest_target_pos, _ = min(workshop_distances, key=lambda x: x[2])\n      return closest_workshop_idx, nearest_target_pos\n\n  def move_towards(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine which workshops can craft the desired item\n  candidate_workshops = []\n  for recipe in cookbook.recipes.values():\n      if goal_index == recipe.get(\"_key\"):\n          candidate_workshops.extend(recipe.keys() - set([\"_key\"]))\n\n  candidate_workshop_indices = [workshop_idx for workshop_idx in env.world.workshop_indices if workshop_idx in candidate_workshops]\n\n  actions = []\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(env)\n  \n  if closest_workshop_idx is not None:\n      # Move towards the closest workshop\n      actions.extend(move_towards(env, nearest_target_pos))\n      \n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:56:38.695739", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None, None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions, nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find which workshop can craft the desired item\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe:\n          ingredient_indices = [i for i in recipe.keys() if isinstance(i, int)]\n          break\n  else:\n      return []\n\n  # Find the closest suitable workshop\n  actions, nearest_workshop_pos = None, None\n\n  for workshop_idx in env.world.workshop_indices:\n      actions_cand, workshop_pos = move_towards_workshop(workshop_idx)\n      if actions_cand is not None and (nearest_workshop_pos is None or np.linalg.norm(pos - workshop_pos) < np.linalg.norm(pos - nearest_workshop_pos)):\n          actions, nearest_workshop_pos = actions_cand, workshop_pos\n\n  if actions is not None:\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n  else:\n      raise ValueError(\"No suitable workshop found\")\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:58:00.507597", "function_name": "craft", "function_body": "  def find_closest_workshop_and_position(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      distances_to_workshops = {}\n\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n              distances_to_workshops[workshop_idx] = (np.linalg.norm(pos - nearest_target_pos), nearest_target_pos)\n\n      if not distances_to_workshops:\n          raise ValueError(\"No available workshop found\")\n\n      # Get the closest workshop based on their distances\n      _, nearest_target_pos = min(distances_to_workshops.values(), key=lambda x: x[0])\n\n      return nearest_target_pos\n\n  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):\n              # Move in the x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):\n              # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:\n              # If both directions are equal, choose one arbitrarily (e.g., x-direction)\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop position that can craft the desired item\n  nearest_target_pos = find_closest_workshop_and_position(env, goal_index)\n\n  # Move to the closest workshop position\n  actions = move_towards(np.array(env._current_state.pos), nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:58:01.582464", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):\n        # Move in the x-direction first\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n      else:\n        # Move in the y-direction\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n      nearest_target_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n      distances_to_workshops[workshop_idx] = (np.linalg.norm(pos - nearest_target_pos), nearest_target_pos)\n\n  if not distances_to_workshops:\n    raise ValueError(\"No available workshop found\")\n\n  # Get the closest workshop based on their distances\n  _, nearest_target_pos = min(distances_to_workshops.values(), key=lambda x: x[0])\n\n  # Move to the closest workshop position\n  actions = move_towards(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:59:44.350241", "function_name": "craft", "function_body": "  def move_to(target_pos: np.ndarray, current_pos: np.ndarray) -> list[int]:\n      \"\"\"Moves the agent to the target position from the current position.\"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def get_closest_workshop_index(pos: np.ndarray) -> int:\n      \"\"\"Finds the closest workshop index based on the agent's position.\"\"\"\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      min_distance = float('inf')\n      closest_workshop_idx = None\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) == 0: continue\n          \n          # Calculate the mean position of all workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      \n      return closest_workshop_idx\n\n  def get_nearest_target_position(workshop_idx: int, pos: np.ndarray) -> np.ndarray:\n      \"\"\"Finds the nearest target position to move towards.\"\"\"\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      min_distance = flo