{"timestamp": "2025-09-06T15:48:44.340238", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Get all available workshops and their positions\n  all_workshops = {}\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          all_workshops[workshop_idx] = workshop_pos_list\n\n  pos = np.array(env._current_state.pos)\n\n  # Calculate distances from current position to each workshop position and sort them\n  distance_to_workshops = []\n  for workshop_idx, workshop_positions in all_workshops.items():\n      for target_pos in workshop_positions:\n          distance = np.linalg.norm(pos - target_pos)\n          distance_to_workshops.append((distance, workshop_idx, target_pos))\n\n  # Sort by distances to find the closest workshops\n  sorted_distances = sorted(distance_to_workshops, key=lambda x: x[0])\n\n  # Try moving to and using each closest workshop\n  for _, workshop_idx, nearest_target_pos in sorted_distances:\n      actions.extend(move_towards(pos, nearest_target_pos))\n      actions.append(4)  # USE\n\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
