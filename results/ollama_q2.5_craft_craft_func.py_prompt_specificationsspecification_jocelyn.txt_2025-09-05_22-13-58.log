{"timestamp": "2025-09-06T08:53:45.454468", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Determine the closest workshop for the goal index\n  closest_workshop_idx, min_distance = None, float('inf')\n  recipe_workshops = set()\n\n  # Find which workshops can craft the desired item based on its recipe ingredients.\n  for recipe_output, ingredients in cookbook.recipes.items():\n      if goal_index == recipe_output:\n          # Collect all possible workshop indices that could craft any ingredient of the goal\n          for ingredient in ingredients.keys():\n              workshop_idx = next(\n                  (w for w in workshop_indices if cookbook.primitives_for(ingredient) or ingredient not in env.world.non_grabbable_indices),\n                  None)\n              if workshop_idx:\n                  recipe_workshops.add(workshop_idx)\n\n  # Determine which of the identified workshops is closest to the agent's current position.\n  for workshop_idx in recipe_workshops:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there are any locations for the workshop\n          workshop_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n 