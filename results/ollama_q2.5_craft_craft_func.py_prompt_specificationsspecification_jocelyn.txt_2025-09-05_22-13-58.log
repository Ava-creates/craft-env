{"timestamp": "2025-09-06T16:21:23.378219", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  current_state = env._current_state\n  grid = current_state.grid\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index)\n\n  if not recipe:\n      return []  # No need to craft as there's no recipe\n\n  actions = []\n\n  # Collect all required ingredients that are not already in inventory\n  for ingredient_idx, count in recipe.items():\n      if ingredient_idx == \"_key\":  # Skip the _key entry which might contain metadata\n          continue\n\n      if current_state.inventory[ingredient_idx] < count:\n          # Calculate how many more of this item we need\n          needed_count = count - current_state.inventory[ingredient_idx]\n          actions.extend(collect_v2(env, ingredient_idx, needed_count))\n\n  # Find and move towards the closest workshop that can craft the desired item\n  for workshop_idx in env.world.workshop_indices:\n      if move_towards_workshop(workshop_idx) is not None:\n          break\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:22:27.042170", "function_name": "craft", "function_body": "  def find_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Iterate through all workshop indices to find the closest one that can craft the goal\n      min_distance = float('inf')\n      closest_workshop_pos = None\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n          \n          # Check if the workshop can craft the goal item\n          for workshop_pos in workshop_pos_list:\n              if env.world.cookbook.recipes[goal_index].get('_key') == workshop_idx or \\\n                 goal_index in env.world.cookbook.recipes[goal_index]:\n                  distance = np.linalg.norm(workshop_pos - pos)\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_workshop_pos = workshop_pos\n\n      return closest_workshop_pos\n\n  def move_towards_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_pos = find_closest_workshop(env, goal_index)\n  \n  if closest_workshop_pos is None:\n      raise ValueError(f\"No workshop found that can craft {item}\")\n\n  actions = move_towards_target(env, closest_workshop_pos)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:22:28.174010", "function_name": "craft", "function_body": "  def get_closest_workshop(env):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx = None\n      min_distance = float('inf')\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n\n      return closest_workshop_idx\n\n  def move_towards_workshop(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return actions\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  closest_workshop_idx = get_closest_workshop(env)\n  \n  if closest_workshop_idx is None:\n      raise ValueError(\"No suitable workshop found to craft the item.\")\n\n  actions = move_towards_workshop(env, closest_workshop_idx)\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:23:25.438207", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all workshop positions and calculate distances\n      workshop_positions = []\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n          workshop_positions.extend([(workshop_idx, tuple(pos)) for pos in workshop_pos_list])\n\n      if not workshop_positions:\n          return actions\n\n      # Calculate the closest position to move towards\n      nearest_workshop_idx, nearest_target_pos = min(workshop_positions,\n                                                   key=lambda x: np.linalg.norm(np.array(x[1]) - pos))\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-09-06T16:23:26.420128", "function_name": "craft", "function_body": "  def find_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Check if the item can be crafted in any workshop\n      for workshop_idx in env.world.workshop_indices:\n          recipe = env.world.cookbook.recipes.get(goal_index, {})\n          \n          # If \"_key\" is present and matches the workshop index, it means this workshop can craft the item\n          if recipe.get(\"_key\") == workshop_idx:\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) > 0:  # Ensure workshops exist\n                  nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n                  return nearest_target_pos\n      \n      raise ValueError(\"No suitable workshop found for item\")\n\n  def move_towards(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest suitable workshop to craft the desired item\n  target_pos = find_closest_workshop(env, goal_index)\n\n  # Move towards and use the workshop\n  actions = move_towards(env, target_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:24:50.838425", "function_name": "craft", "function_body": "  def move_towards(current_pos, target_pos):\n      actions = []\n      dx, dy = target_pos - current_pos\n\n      while not np.array_equal(current_pos, target_pos):\n          # Choose the direction with the larger absolute difference to prioritize\n          if abs(dx) > abs(dy):\n              # Move in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n              dx -= 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):\n              # Move in y-direction next\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n              dy -= 1 if dy > 0 else -1\n          else:\n              # If both directions are equal, choose one arbitrarily (e.g., x-direction)\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n              dx -= 1 if dx > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there are any workshops of this type\n          # Calculate distances to all workshops of this type\n          distances = np.linalg.norm(current_pos - workshop_pos_list, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions = move_towards(current_pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:24:51.937924", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Filter workshops that can craft the desired item\n  available_workshops = []\n  for workshop_idx in workshop_indices:\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          available_workshops.extend(workshop_pos_list)\n\n  if not available_workshops:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the closest workshop from the current position\n  pos = np.array(env._current_state.pos)\n  distances = np.linalg.norm(pos - available_workshops, axis=1)\n  nearest_workshop_idx = np.argmin(distances)\n\n  # Move to the nearest workshop position\n  actions = move_towards(pos, available_workshops[nearest_workshop_idx])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:26:38.296955", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # Check for obstacles and adjust path if necessary\n      if env._current_state.next_to(env.world.stone_index) or env._current_state.next_to(env.world.water_index):\n          # Replan the path to avoid obstacles\n          target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n          nearest_target_pos = None\n          min_nearest_distance = float('inf')\n          for target_pos in target_positions:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_target_pos = target_pos\n                  min_nearest_distance = distance\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:31:38.434939", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      dx, dy = target_pos - pos\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              action = 1 if dy > 0 else 0\n              pos[1] += 1 if dy > 0 else -1\n          actions.append(action)\n          \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T16:32:52.715423", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  # Calculate distances to all workshops and choose the closest one\n  min_distance = float('inf')\n  closest_workshop_idx, nearest_target_pos = None, None\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # No workshops of this type available\n          continue\n      \n      for target_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = tuple(target_pos)\n              min_distance = distance\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos[0] - pos[0], nearest_target_pos[1] - pos[1]\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:32:53.830756", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  target_positions = []\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:34:24.426969", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = np.argmax([abs(dx), abs(dy)])\n      if direction == 1:  # y-direction\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n      elif direction == 0:  # x-direction\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) > 0:  # Check if there are any positions\n          distances = np.linalg.norm(pos - target_positions, axis=1)\n          nearest_target_pos = target_positions[np.argmin(distances)]\n          distance = np.min(distances)\n          distances_to_workshops[workshop_idx] = (distance, nearest_target_pos)\n\n  # Get the closest workshops based on their distances\n  if not distances_to_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  closest_workshop_distance, nearest_target_pos = min(distances_to_workshops.values(), key=lambda x: x[0])\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T16:34:25.498174", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = np.argmax([abs(dx), abs(dy)])\n      if direction == 1:  # y-direction\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n      elif direction == 0:  # x-direction\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n    target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(target_positions) > 0:  # Check if there are any positions\n      nearest_target_pos = min(\n        target_positions,\n        key=lambda x: np.linalg.norm(pos - x, ord=2)\n      )\n      distances_to_workshops[workshop_idx] = (np.linalg.norm(pos - nearest_target_pos, ord=2), nearest_target_pos)\n\n  # Sort workshops by distance\n  closest_workshop_indices = sorted(distances_to_workshops.keys(), key=lambda k: distances_to_workshops[k][0])\n\n  actions = []\n\n  for workshop_idx in closest_workshop_indices:\n    _, nearest_target_pos = distances_to_workshops[workshop_idx]\n    actions.extend(move_towards(pos, nearest_target_pos))\n    pos = np.array(nearest_target_pos)\n    actions.append(4)  # USE\n\n    return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
