{"timestamp": "2025-09-06T17:56:53.581502", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      # Identify the workshop required for crafting the item\n      recipe = env.world.cookbook.recipes[goal_index]\n      workshop_required = None\n\n      if \"_key\" in recipe:\n          key = recipe[\"_key\"]\n          if \"workshop\" in key:  # Assuming keys like 'workshop0'\n              workshop_required = int(key.split(\"workshop\")[1])\n\n      if workshop_required is not None and workshop_required < len(env.world.workshop_indices):\n          workshop_idx = env.world.workshop_indices[workshop_required]\n          # Find all positions of the required type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              raise ValueError(f\"No workshop of type {workshop_required} found\")\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T17:56:54.632872", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      workshops = env.world.workshop_indices\n      current_grid = env._current_state.grid\n\n      for workshop_idx in workshops:\n          workshop_positions = np.argwhere(current_grid[:, :, workshop_idx])\n          if len(workshop_positions) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Check if the workshop can craft the desired item\n          recipe = env.world.cookbook.recipes.get(goal_index, {})\n          if \"_key\" in recipe and recipe[\"_key\"] == workshop_idx:\n              nearest_workshop_pos = workshop_positions[np.argmin(np.linalg.norm(workshop_positions - np.array(env._current_state.pos), axis=1))]\n              return nearest_workshop_pos\n\n      return None  # No suitable workshop found\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_pos = find_closest_workshop(env, goal_index)\n  if closest_workshop_pos is None:\n      raise ValueError(f\"No suitable workshop found to craft {item}\")\n\n  # Move towards the closest suitable workshop\n  actions_to_workshop = move_to_target(env, closest_workshop_pos)\n\n  # Use the workshop to craft the item\n  actions_to_workshop.append(4)  # USE\n\n  return actions_to_workshop", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:58:17.548820", "function_name": "craft", "function_body": "  def find_closest_workshop(env):\n    pos = np.array(env._current_state.pos)\n    closest_workshop_pos = None\n    min_distance = float('inf')\n\n    for workshop_idx in env.world.workshop_indices:\n        # Find all positions of this type of workshop\n        workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n        \n        if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n            continue\n\n        # Calculate the closest position to move towards\n        distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n        nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n        \n        distance = np.min(distances)\n        if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = nearest_target_pos\n\n    return closest_workshop_pos\n\n  def move_to_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_pos = find_closest_workshop(env)\n\n  if closest_workshop_pos is not None:\n    actions = move_to_position(np.array(env._current_state.pos), closest_workshop_pos)\n    actions.append(4)  # USE to craft the item at the workshop\n  else:\n    raise ValueError(\"No workshop found to craft the desired item\")\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:58:18.619521", "function_name": "craft", "function_body": "  def find_closest_workshop_pos(env):\n      pos = np.array(env._current_state.pos)\n      \n      closest_workshop_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = nearest_target_pos\n\n      return closest_workshop_pos\n\n\n  def move_towards_position(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n\n  def determine_workshop_from_recipe(env, goal_index):\n      cookbook = env.world.cookbook\n      for recipe_output_idx, ingredients in cookbook.recipes.items():\n          if recipe_output_idx == goal_index:\n              # Check which workshop can be used to craft the item based on ingredient types\n              for ingredient_idx in ingredients.keys():\n                  if ingredient_idx != \"_key\":\n                      for workshop_idx in env.world.workshop_indices:\n                          if env._current_state.grid[:, :, workshop_idx].sum() > 0:  # Workshop exists\n                              return workshop_idx\n      raise ValueError(\"No suitable workshop found for the recipe\")\n\n      \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_index = determine_workshop_from_recipe(env, goal_index)\n  closest_workshop_pos = find_closest_workshop_pos(env)\n\n  actions_to_workshop = move_towards_position(env, closest_workshop_pos) + [4]  # Move to the closest workshop and use it\n\n  return actions_to_workshop", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:00:48.087824", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Prioritize moving in y-direction first\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n          else:  # If dx == dy, decide based on the direction with a small random perturbation\n              random_direction = np.random.choice([0, 2])  # Randomly choose to move in x or y direction\n              actions.append(3 if random_direction == 0 and dx > 0 else (2 if random_direction == 0 else (1 if dy > 0 else 0)))\n              current_pos[0] += 1 if random_direction == 0 and dx > 0 else (-1 if random_direction == 0 else 0)\n              current_pos[1] += 1 if random_direction == 2 and dy > 0 else (-1 if random_direction == 2 else 0)\n      return actions\n\n  def find_closest_workshop(current_pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) == 0:  # No workshops found, skip to the next type\n              continue\n\n          # Calculate distances to each position and find nearest one\n          distances = [np.linalg.norm(current_pos - target, ord=2) for target in workshop_positions]\n          nearest_target_pos = workshop_positions[np.argmin(distances)]\n          distance = np.min(distances)\n          \n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_idx = workshop_idx\n              final_target_pos = nearest_target_pos\n      \n      return closest_workshop_idx, final_target_pos\n\n  def find_nearest_target(current_pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item and the nearest target position\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the nearest target position of the closest workshop\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:00:49.087727", "function_name": "craft", "function_body": "  def move_to_target(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Prioritize moving in y-direction first\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n          else:  # If dx == dy, decide based on the direction with a small random perturbation\n              random_direction = np.random.choice([0, 2])  # Randomly choose to move in x or y direction\n              actions.append(3 if random_direction == 0 and dx > 0 else (2 if random_direction == 0 else (1 if dy > 0 else 0)))\n              current_pos[0] += 1 if random_direction == 0 and dx > 0 else (-1 if random_direction == 0 else 0)\n              current_pos[1] += 1 if random_direction == 2 and dy > 0 else (-1 if random_direction == 2 else 0)\n      return actions\n\n  def find_closest_workshop(current_pos, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) == 0:  # No workshops found, skip to the next type\n              continue\n\n          # Calculate mean position for each workshop type and find the closest one that can craft the goal item\n          for recipe in cookbook.recipes:\n              if recipe.output == goal_index:\n                  input_indices = [input_item.index for input_item in recipe.inputs]\n                  if workshop_idx in input_indices:  # Check if this workshop is part of the crafting process for the goal item\n                      workshop_pos_mean = workshop_positions.mean(axis=0)\n                      distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n                      \n                      if distance < min_distance:\n                          min_distance = distance\n                          closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(current_pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(current_pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:02:27.883778", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if all required primitives are in the inventory\n  primitives_needed = cookbook.primitives_for(goal_index)\n  for primitive_idx, count in primitives_needed.items():\n      if env._current_state.inventory[primitive_idx] < count:\n          raise ValueError(f\"Insufficient {cookbook.index.reverse[primitive_idx]} in inventory\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:02:28.860385", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  def get_required_primitives(env, goal_index):\n    cookbook = env.world.cookbook\n    required_primitives = cookbook.primitives_for(goal_index)\n    return required_primitives\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the required primitives for crafting\n  required_primitives = get_required_primitives(env, goal_index)\n\n  # Collect all required primitives before crafting\n  actions = []\n  for primitive_idx in required_primitives:\n    actions.extend(collect_v2(env, env.world.cookbook.index.get_key(primitive_idx)))\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions.extend(move_towards_workshop(env, goal_index))\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:04:01.253445", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n      \"\"\"\n      Find the closest workshop to the current position.\n      \n      Args:\n          grid (np.ndarray): The current grid state.\n          pos (tuple): Current agent's position (x, y).\n          \n      Returns:\n          tuple: The position of the closest workshop or None if no workshops are found.\n      \"\"\"\n      # Collect all workshop positions\n      workshop_positions = []\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          workshop_positions.extend(workshop_pos_list)\n      \n      if not workshop_positions:\n          return None\n      \n      # Find the nearest workshop position\n      nearest_target_pos = min(workshop_positions, key=lambda wp: np.linalg.norm(np.array(wp) - np.array(pos)))\n      return tuple(nearest_target_pos)\n\n  def move_to_position(env, target_pos):\n      \"\"\"\n      Generate actions to move the agent towards a specific target position.\n      \n      Args:\n          env (CraftLab): The current environment state.\n          target_pos (tuple): The position to move towards (x, y).\n          \n      Returns:\n          list[int]: List of action indices to move towards the target position.\n      \"\"\"\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop to move towards\n  target_workshop_pos = find_closest_workshop(env._current_state.grid, env._current_state.pos)\n  \n  if target_workshop_pos is not None:\n      actions_to_move = move_to_position(env, target_workshop_pos)\n      actions_to_move.append(4)  # Use the workshop to craft the item\n      return actions_to_move\n  \n  raise ValueError(\"No workshops found in the environment.\")", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:04:02.421915", "function_name": "craft", "function_body": "  def move_to_position(pos_target: np.array, current_pos: np.array) -> list[int]:\n      actions = []\n      while not np.array_equal(current_pos, pos_target):\n          dx, dy = pos_target - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      # Find all possible workshops\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          actions.extend(move_to_position(nearest_target_pos, pos))\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 3, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T18:05:15.582568", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # If both directions are equal, choose one arbitrarily (e.g., x-direction)\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n\n          # Verify that this workshop can actually craft the desired item\n          recipe = cookbook.recipes.get(goal_index, [])\n          if any(workshop_idx in r for r in recipe):\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  nearest_target_pos_final = nearest_target_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos_final))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:05:16.723760", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # If both directions are equal, choose one arbitrarily (e.g., x-direction)\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n\n      return actions\n\n  def get_workshop_positions(workshop_idx):\n      \"\"\"Get all positions of a specific workshop type in the current grid.\"\"\"\n      return np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n  def find_closest_workshop(pos, workshop_indices):\n      \"\"\"Find the closest available workshop among the given indices.\"\"\"\n      min_distance = float('inf')\n      nearest_target_pos = None\n      closest_workshop_idx = None\n\n      for workshop_idx in workshop_indices:\n          workshop_positions = get_workshop_positions(workshop_idx)\n          if len(workshop_positions) == 0:\n              continue\n\n          distances = np.linalg.norm(pos - workshop_positions, axis=1)\n          min_dist_to_this_workshop = np.min(distances)\n          nearest_pos_to_this_workshop = workshop_positions[np.argmin(distances)]\n\n          if min_dist_to_this_workshop < min_distance:\n              min_distance = min_dist_to_this_workshop\n              nearest_target_pos = nearest_pos_to_this_workshop\n              closest_workshop_idx = workshop_idx\n\n      return closest_workshop_idx, nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  pos = np.array(env._current_state.pos)\n\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(pos, workshop_indices)\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions = move_towards(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:06:27.046978", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest workshop position to the agent's current position\n          nearest_workshop_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(pos - p))\n          distance = np.linalg.norm(pos - nearest_workshop_pos)\n\n          # Check if this is the closest workshop to the agent\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = np.array(nearest_workshop_pos)\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Calculate the direction with the smallest difference in coordinates\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If dx and dy are equal, choose a direction randomly\n          random_direction = np.random.choice([2, 3, 0, 1])\n          actions.append(random_direction)\n          if random_direction in [2, 3]:  # Move left or right\n              pos[0] += -1 if random_direction == 2 else 1\n          else:  # Move up or down\n              pos[1] += -1 if random_direction == 0 else 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:06:28.029938", "function_name": "craft", "function_body": "  def move_towards(current_pos, target_pos):\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  current_pos = np.array(env._current_state.pos)\n\n  min_distance, closest_workshop_idx = float('inf'), None\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest workshop position to the agent's current position\n          nearest_workshop_pos = min(workshop_pos_list, key=lambda p: np.linalg.norm(current_pos - p))\n          distance = np.linalg.norm(current_pos - nearest_workshop_pos)\n\n          # Check if this is the closest workshop to the agent\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Get the nearest target position from the list of workshops\n  nearest_target_pos = np.array(min(workshop_pos_list, key=lambda p: np.linalg.norm(current_pos - p)))\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:07:36.756521", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      elif abs(dy) >= abs(dx):  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def get_next_step(pos, target):\n      direction = get_direction(target[0] - pos[0], target[1] - pos[1])\n      new_pos = np.array(pos) + (direction == 3) - (direction == 2), (direction == 1) - (direction == 0)\n      return direction, tuple(new_pos)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      direction, pos = get_next_step(pos, nearest_target_pos)\n      actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:07:37.812313", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos += (direction == 3) - (direction == 2), (direction == 1) - (direction == 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:08:45.765887", "function_name": "craft", "function_body": "  def move_to_position(pos_target: np.array, current_pos: np.array) -> list[int]:\n      actions = []\n      while not np.array_equal(current_pos, pos_target):\n          dx, dy = pos_target - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def get_workshop_positions_for_item(env, item_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      goal_recipes = {key: value for key, value in cookbook.recipes.items() if item_index in value}\n\n      # Find all workshops that can craft the desired item\n      valid_workshops = set()\n      for recipe in goal_recipes.values():\n          for ingredient, count in recipe.items():\n              if ingredient != \"_key\" and ingredient in workshop_indices:\n                  valid_workshops.add(ingredient)\n\n      return [np.argwhere(env._current_state.grid[:, :, idx]) for idx in valid_workshops]\n\n  def move_towards_closest_valid_workshop(env, item_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      # Get all positions of valid workshops that can craft the desired item\n      workshop_positions_lists = get_workshop_positions_for_item(env, item_index)\n\n      # Flatten the list and find the closest position to move towards\n      all_workshop_positions = [pos for sublist in workshop_positions_lists for pos in sublist]\n      if len(all_workshop_positions) == 0:\n          raise ValueError(\"No valid workshops found that can craft the desired item.\")\n\n      nearest_target_pos = all_workshop_positions[np.argmin(np.linalg.norm(all_workshop_positions - pos, axis=1))]\n      \n      actions.extend(move_to_position(nearest_target_pos, pos))\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest valid workshop that can craft the desired item\n  actions = move_towards_closest_valid_workshop(env, goal_index)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:08:46.740116", "function_name": "craft", "function_body": "  def move_to_position(pos_target: np.array, current_pos: np.array) -> list[int]:\n      actions = []\n      while not np.array_equal(current_pos, pos_target):\n          dx, dy = pos_target - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      # Find all possible workshops that can craft the desired item\n      for recipe in env.world.cookbook.recipes.values():\n          if goal_index in recipe:\n              workshop_idx = list(set(recipe.keys()) & set(env.world.workshop_indices))[0]\n              \n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n                  continue\n\n              # Calculate the closest position to move towards\n              nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n              actions.extend(move_to_position(nearest_target_pos, pos))\n\n              # Use the workshop to craft the item\n              actions.append(4)  # USE\n\n              break  # Only need one workshop to craft the item\n      \n      return actions if len(actions) > 0 else []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:10:10.787567", "function_name": "craft", "function_body": "  def move_to_target(target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = direction_mapping[(np.sign(dx), np.sign(dy))]\n          actions.append(direction)\n          pos += np.array([dx > 0, dy > 0]) * 2 - np.array([dx < 0, dy < 0])\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(np.array(env._current_state.pos) - x, ord=2))\n\n  # Move to the closest workshop position\n  actions = move_to_target(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:10:11.873845", "function_name": "craft", "function_body": "  def move_to_target(target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}  # UP, DOWN, LEFT, RIGHT\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              next_direction = 3 if dx > 0 else 2\n          else:  # Then move in y-direction\n              next_direction = 1 if dy > 0 else 0\n\n          # Add the action for this direction\n          actions.append(next_direction)\n          pos += np.array(direction_mapping[next_direction])\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions = move_to_target(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
