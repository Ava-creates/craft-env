{"timestamp": "2025-09-06T01:21:26.219149", "function_name": "craft", "function_body": "  def calculate_distance(p1, p2):\n      return np.linalg.norm(np.array(p1) - np.array(p2), ord=2)\n\n  def get_direction(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = calculate_distance(pos, workshop_pos_mean)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = calculate_distance(pos, target_pos)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the direction to move towards the closest workshop position\n  dx, dy = nearest_target_pos - pos\n\n  while not np.array_equal(pos, nearest_target_pos):\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      if direction == 2 or direction == 3:  # LEFT or RIGHT\n          pos[0] += 1 if direction == 3 else -1\n      elif direction == 0 or direction == 1:  # DOWN or UP\n          pos[1] += 1 if direction == 1 else -1\n\n      dx, dy = nearest_target_pos - pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T01:21:27.411324", "function_name": "craft", "function_body": "  def calculate_distance(p1, p2):\n      return np.linalg.norm(np.array(p1) - np.array(p2), ord=2)\n\n  def find_closest_workshop(pos, workshop_indices, grid):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = calculate_distance(pos, workshop_pos_mean)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def move_to_target(env, pos, target_pos):\n      actions = []\n      dx, dy = target_pos - pos\n      while not np.array_equal(pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n              dx -= 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n              dy -= 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop(pos, workshop_indices, env._current_state.grid)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: calculate_distance(pos, x))\n\n  # Move towards the closest workshop position\n  actions.extend(move_to_target(env, pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T01:23:45.885041", "function_name": "craft", "function_body": "  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      direction_mapping = {\n          (0, -1): 0,  # UP\n          (0, 1): 1,   # DOWN\n          (-1, 0): 2,  # LEFT\n          (1, 0): 3    # RIGHT\n      }\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = (1, 0) if dx > 0 else (-1, 0)\n          else:  # Then move in y-direction\n              direction = (0, 1) if dy > 0 else (0, -1)\n\n          actions.append(direction_mapping[direction])\n          pos += np.array(direction)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(env, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T01:23:47.023834", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      pos = np.array(env._current_state.pos)\n\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, closest_workshop_idx):\n      pos = np.array(env._current_state.pos)\n\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_idx = find_closest_workshop(env, goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, closest_workshop_idx)\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  actions = move_to_target(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T01:26:30.930628", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding algorithm\n  start = tuple(pos)\n  end = tuple(nearest_target_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star_search(start, end):\n      open_set = set()\n      closed_set = set()\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, end)}\n      came_from = {}\n\n      open_set.add(start)\n\n      while open_set:\n          current = min(open_set, key=lambda k: f_score[k])\n\n          if current == end:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1]\n\n          open_set.remove(current)\n          closed_set.add(current)\n\n          for neighbor in [(current[0] + 1, current[1]), (current[0] - 1, current[1]), (current[0], current[1] + 1), (current[0], current[1] - 1)]:\n              tentative_g_score = g_score[current] + 1\n\n              if 0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                  if neighbor in closed_set:\n                      continue\n\n                  if neighbor not in open_set or tentative_g_score < g_score.get(neighbor, float('inf')):\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, end)\n                      open_set.add(neighbor)\n\n      return None\n\n  path = a_star_search(start, end)\n\n  if path is None:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  # Convert path to actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n\n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 2.7}}
{"timestamp": "2025-09-06T01:26:31.996548", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe:\n          for workshop_idx in workshop_indices:\n              # Calculate the mean position of all workshops of this type\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                  distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
