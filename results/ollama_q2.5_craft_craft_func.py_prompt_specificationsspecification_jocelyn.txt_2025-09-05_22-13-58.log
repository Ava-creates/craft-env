  # Recalculate the remaining distance to the target after each step\n      dx, dy = nearest_target_pos - pos\n  \n  actions.extend(path)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-05T22:34:37.475545", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the workshop index from recipes that can produce this item.\n  workshop_idx = None\n  for recipe_output, recipe in cookbook.recipes.items():\n      if recipe_output == goal_index:\n          workshop_idx = int(recipe[\"_key\"])\n          break\n\n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found for crafting the item\")\n\n  actions = []\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Check if we are already at the nearest target position\n  if not np.array_equal(pos, nearest_target_pos):\n      # Move to the closest workshop position\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-05T22:36:37.652586", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the workshops required for crafting the item\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No recipe available for {item}\")\n\n  required_workshops = set()\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient in workshop_indices:\n          required_workshops.add(ingredient)\n\n  # If no specific workshops are mentioned in the recipe,\n  # default to using any of the available workshops\n  if not required_workshops:\n      required_workshops.update(workshop_indices)\n\n  pos = np.array(env._current_state.pos)\n  current_world = env.world\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in required_workshops:\n      workshop_pos_list = np.argwhere(current_world.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_world.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      \n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-05T22:36:38.642966", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the sequence of actions to move to the closest workshop position using A* pathfinding algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  open_set = collections.deque([(pos.tolist(), [])])\n  closed_set = set()\n\n  while open_set:\n      current_pos, current_path = open_set.popleft()\n\n      if tuple(current_pos) in closed_set:\n          continue\n\n      closed_set.add(tuple(current_pos))\n\n      if np.array_equal(np.array(current_pos), nearest_target_pos):\n          actions.extend([2, 3, 0, 1][np.argmax(np.abs(np.array(nearest_target_pos) - np.array(current_pos)))] + [4])\n          break\n\n      neighbors = [(current_pos[0] - 1, current_pos[1]), (current_pos[0] + 1, current_pos[1]),\n                   (current_pos[0], current_pos[1] - 1), (current_pos[0], current_pos[1] + 1)]\n\n      for neighbor in neighbors:\n          if not env._current_state.next_to(env.world.cookbook.index.get(\"BOUNDARY\", -1)) and \\\n             0 <= neighbor[0] < env.world.scenario.init_grid.shape[0] and \\\n             0 <= neighbor[1] < env.world.scenario.init_grid.shape[1]:\n              tentative_path = current_path + [2, 3, 0, 1][neighbors.index(neighbor)]\n              new_cost = len(tentative_path) + heuristic(neighbor, nearest_target_pos)\n\n              if tuple(neighbor) not in closed_set or new_cost < len(closed_set[tuple(neighbor)]):\n                  open_set.append((list(neighbor), tentative_path))\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
