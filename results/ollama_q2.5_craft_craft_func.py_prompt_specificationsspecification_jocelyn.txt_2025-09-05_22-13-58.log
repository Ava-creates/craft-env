  pos[1] += 1 if dy > 0 else -1\n\n      # Ensure the agent is facing the correct direction before moving\n      current_direction = env._current_state.direction\n      if direction_to_move == 3 and current_direction != 3:\n          actions.append(3)  # Turn to face right\n      elif direction_to_move == 2 and current_direction != 2:\n          actions.append(2)  # Turn to face left\n      elif direction_to_move == 1 and current_direction != 1:\n          actions.append(1)  # Turn to face up\n      elif direction_to_move == 0 and current_direction != 0:\n          actions.append(0)  # Turn to face down\n\n      actions.append(direction_to_move)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:45:16.852023", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index)\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine which workshop to use based on the recipe ingredients\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Check if this workshop can craft the desired item (based on its recipe)\n      if any(i_kind in recipe for i_kind in env.world.grabbable_indices):\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:46:50.721639", "function_name": "craft", "function_body": "  def move_towards_position(pos_target):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, pos_target):\n          dx, dy = pos_target - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index)\n  if not recipe:\n      raise ValueError(f\"No known recipe for {item}\")\n\n  actions = []\n\n  # Check if any ingredient in the recipe requires crafting (recursive step)\n  for ingredient, count in recipe.items():\n      if isinstance(ingredient, int) and ingredient != goal_index:\n          # Assume that the ingredient is also an item that can be crafted\n          ingredient_name = cookbook.index.get(ingredient)\n          if ingredient_name:\n              actions.extend(craft_v2(env, ingredient_name))  # Recursive call to craft the ingredient\n\n      elif isinstance(ingredient, str) and ingredient == \"_key\":\n          continue  # Ignore the \"_key\" field as it's not an actual item\n      else:\n          raise ValueError(f\"Unexpected ingredient type in recipe for {item}\")\n\n  # Now that all ingredients are either in inventory or being crafted, move to a workshop\n  # Find the closest workshop that can be used to craft the desired item\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in env.world.workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      # Calculate the closest position to move towards among all workshops\n      for workshop_pos in workshop_pos_list:\n          distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos)\n          if distance < min_distance:\n              nearest_workshop_pos = workshop_pos\n              min_distance = distance\n\n  if nearest_workshop_pos is not None:\n      actions.extend(move_towards_position(nearest_workshop_pos))\n      actions.append(4)  # USE to craft the item at the workshop\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:46:51.701833", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions + [4]  # Use the workshop to craft the item\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine which workshop can craft the desired item\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe.values():\n          workshop_idx = next((idx for idx, value in env.world.cookbook.recipes.items() if goal_index in value.values()), None)\n          if workshop_idx is not None:\n              actions = move_towards_workshop(workshop_idx)\n              if actions is not None:\n                  return actions\n\n  raise ValueError(\"No suitable workshop found to craft the item\")", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:48:23.148957", "function_name": "craft", "function_body": "  def move_to_position(pos_target):\n      pos_current = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos_current, pos_target):\n          dx, dy = pos_target - pos_current\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos_current[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos_current[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the workshop indices that are needed for this recipe\n  required_workshop_indices = set()\n  ingredient_indices = []\n  \n  for output_idx, ingredients in env.world.cookbook.recipes.items():\n      if output_idx == goal_index:\n          ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n          break\n\n  for ingredient in ingredient_indices:\n      primitives_needed = cookbook.primitives_for(ingredient)\n      required_workshop_indices.update(primitives_needed.keys())\n\n  # Find the closest workshop from the list of workshops that can craft the desired item\n  nearest_target_pos = None\n  min_distance = float('inf')\n  \n  for workshop_idx in env.world.workshop_indices:\n      if workshop_idx not in required_workshop_indices:\n          continue\n      \n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      pos = np.array(env._current_state.pos)\n      nearest_workshop_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n      distance = np.linalg.norm(nearest_workshop_pos - pos)\n\n      if distance < min_distance:\n          min_distance = distance\n          nearest_target_pos = nearest_workshop_pos\n\n  # If we found a target position, move there and use the workshop to craft the item\n  actions = []\n  \n  if nearest_target_pos is not None:\n      actions.extend(move_to_position(nearest_target_pos))\n      actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T17:48:24.144300", "function_name": "craft", "function_body": "  def move_to_position(pos_target):\n      pos_current = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos_current, pos_target):\n          dx, dy = pos_target - pos_current\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos_current[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos_current[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe_ingredients = cookbook.recipes.get(goal_index, {})\n  \n  if not recipe_ingredients: \n      raise ValueError(f\"No recipe found for {item}\")\n\n  required_workshop_indices = set()\n  for ingredient in recipe_ingredients:\n      if isinstance(ingredient, int):\n          primitives_needed = cookbook.primitives_for(ingredient)\n          required_workshop_indices.update(primitives_needed.keys())\n\n  # Filter workshops that can be used to craft the desired item\n  usable_workshops = [ws_idx for ws_idx in env.world.workshop_indices if ws_idx in required_workshop_indices]\n\n  if not usable_workshops:\n      raise ValueError(\"No suitable workshop found\")\n\n  # Move to each workshop and use it\n  actions = []\n  for workshop_idx in usable_workshops:\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - env._current_state.pos, axis=1))]\n\n      actions.extend(move_to_position(nearest_target_pos))\n      actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T17:50:44.269856", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # If both are equal, choose one direction randomly\n              random_direction = np.random.choice([2, 3]) if dx != 0 else np.random.choice([0, 1])\n              actions.append(random_direction)\n              pos[0] += 1 if random_direction == 3 else (-1 if random_direction == 2 else 0)\n              pos[1] += 1 if random_direction == 1 else (-1 if random_direction == 0 else 0)\n      return actions\n\n  def find_closest_workshop(pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              # Calculate mean position\n              workshop_pos_mean = workshop_positions.mean(axis=0)\n              \n              # Calculate distance to this workshop type's mean position\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              # Update closest workshop if necessary\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T17:50:45.337334", "function_name": "craft", "function_body": "  def move_to_target(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # If equal distance, decide randomly between x and y\n              random_direction = np.random.choice([0, 2])  # Randomly choose to move in x or y direction\n              actions.append(3 if random_direction == 0 and dx > 0 else (2 if random_direction == 0 else (1 if dy > 0 else 0)))\n              pos[random_direction] += 1 if (random_direction == 0 and dx > 0) or (random_direction == 1 and dy > 0) else -1\n      return actions\n\n  def find_closest_workshop(pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for idx in workshop_indices:\n          # Find positions of all workshops of this type\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              # Calculate mean position\n              workshop_pos_mean = workshop_positions.mean(axis=0)\n              \n              # Calculate distance to this workshop type's mean position\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              # Update closest workshop if necessary\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_target(pos, workshop_idx):\n      # Find positions of all workshops of the type closest_workshop_idx\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(target_positions) == 0:\n          raise ValueError(\"No positions found for this workshop type\")\n      \n      # Calculate distances to each position and find nearest one\n      nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in target_positions])]\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target(np.array(env._current_state.pos), closest_workshop_idx)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
