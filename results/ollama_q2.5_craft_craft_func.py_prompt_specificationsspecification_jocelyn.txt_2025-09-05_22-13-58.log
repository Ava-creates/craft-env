{"timestamp": "2025-09-06T14:39:45.757995", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = np.argmax(np.abs([dx, dy]))\n\n      if direction == 0:  # y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # x-direction\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:41:52.306871", "function_name": "craft", "function_body": "  def get_closest_pos(target_positions, current_position):\n      \"\"\"Helper function to find the closest position from a list of positions.\"\"\"\n      return target_positions[np.argmin(np.linalg.norm(target_positions - current_position, axis=1))]\n\n  def move_towards(env, target_position) -> list[int]:\n      \"\"\"Move towards a given target position using UP, DOWN, LEFT, RIGHT actions.\"\"\"\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_position):\n          dx, dy = target_position - pos\n          \n          # Determine direction to move in prioritizing x-direction first if equal distance\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dx) < abs(dy):\n              action = 1 if dy > 0 else 0\n              pos[1] += 1 if dy > 0 else -1\n          else:\n              # If equal distance in both directions, choose one direction arbitrarily (here x-direction)\n              action = 3 if dx > 0 else 2\n              pos[0] += 1 if dx > 0 else -1\n\n          actions.append(action)\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Retrieve all recipe ingredients and their respective counts\n  recipe = cookbook.recipes.get(goal_index)\n  \n  if recipe is None:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n\n  # Identify which workshop type can craft the desired item\n  workshop_type_indices = [k for k, v in env.world.cookbook.recipes.items() if '_key' in v and goal_index in v['_key']]\n  \n  if not workshop_type_indices:\n      raise ValueError(f\"No suitable workshop found for crafting {item}\")\n\n  # Choose the closest workshop of the identified type\n  target_workshop_idx = workshop_type_indices[0]\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, target_workshop_idx])\n\n  if len(workshop_pos_list) == 0:\n      raise ValueError(\"No workshops found in the environment\")\n\n  nearest_workshop_pos = get_closest_pos(workshop_pos_list, env._current_state.pos)\n\n  # Move towards the closest workshop\n  actions.extend(move_towards(env, nearest_workshop_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:41:53.307607", "function_name": "craft", "function_body": "  def move_to_target(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  workshop_indices = cookbook.recipes[goal_index].get(\"_key\", [])\n  if not workshop_indices:\n      raise ValueError(\"No suitable workshop found for crafting the item.\")\n\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n\n  # Find all workshops and choose the closest one\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n      \n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n      if nearest_workshop_pos is None or np.linalg.norm(nearest_target_pos - pos) < np.linalg.norm(nearest_workshop_pos - pos):\n          nearest_workshop_pos = nearest_target_pos\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No workshops available to craft the item.\")\n\n  actions = move_to_target(nearest_workshop_pos)\n  actions.append(4)  # USE action to craft the item at the workshop\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:43:53.620785", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n      min_distance = float('inf')\n      closest_workshop_pos = None\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(workshop_pos - pos)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = workshop_pos\n\n      return closest_workshop_pos\n\n  def move_towards_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  current_pos = np.array(env._current_state.pos)\n  grid = env._current_state.grid\n\n  closest_workshop_pos = find_closest_workshop(grid, current_pos)\n\n  if closest_workshop_pos is None:\n      raise ValueError(\"No available workshops\")\n\n  actions = move_towards_position(current_pos, closest_workshop_pos)\n  actions.append(4)  # USE to craft the item\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:43:54.761488", "function_name": "craft", "function_body": "  def move_towards_position(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_workshop_for_item(goal_index):\n      \"\"\"Find the workshop index that can craft the item.\"\"\"\n      cookbook = env.world.cookbook\n      for recipe_output, recipe in cookbook.recipes.items():\n          if recipe_output == goal_index:\n              # Check each ingredient in the recipe to see if it has a \"_key\" pointing to a workshop\n              for key, value in recipe.items():\n                  if isinstance(key, str) and key.startswith(\"_\"):\n                      return int(value)\n      raise ValueError(\"No workshop found for the given item.\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the appropriate workshop index for crafting the desired item\n  try:\n      workshop_idx = find_workshop_for_item(goal_index)\n  except ValueError as e:\n      print(e)\n      return []\n\n  # Find all positions of this type of workshop\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n  if len(workshop_pos_list) == 0:  # No workshops of this type exist\n      return []\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - env._current_state.pos, axis=1))]\n\n  # Move towards the nearest workshop and use it to craft the item\n  actions = move_towards_position(nearest_target_pos)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:46:15.865675", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def find_closest_workshop():\n      cookbook = env.world.cookbook\n      goal_index = cookbook.index[item]\n\n      if goal_index is None:\n          raise ValueError(\"Unknown item\")\n\n      workshop_indices = env.world.workshop_indices\n      pos = np.array(env._current_state.pos)\n\n      # Find the closest workshop that can craft the desired item\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n\n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      return closest_workshop_idx, nearest_target_pos\n\n  # Get the closest workshop and target position\n  _, nearest_target_pos = find_closest_workshop()\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n\n      actions.append(direction)\n      \n      # Update agent's current position based on direction moved\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
