lse -1\n\n  # Ensure we are facing the workshop before using it\n  current_direction = np.array(env._current_state.pos) - nearest_target_pos\n  desired_direction = nearest_target_pos - np.array(env._current_state.pos)\n\n  if not np.array_equal(current_direction, desired_direction):\n      actions.append(4)  # Turn around to face the workshop\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:25:29.242806", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      dx, dy = target_pos - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n      return actions, current_pos\n\n  def find_closest_workshop(env, workshop_indices):\n      pos = np.array(env._current_state.pos)\n      nearest_workshop = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n\n          if distance < min_distance:\n              min_distance = distance\n              nearest_workshop = nearest_target_pos\n\n      return nearest_workshop\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Identify the type of workshop needed for crafting the item\n  workshops_needed = set()\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe:\n          workshops_needed.update([k for k, v in cookbook.workshop_indices.items() if any(w in v for w in recipe.get(\"_key\", []))])\n\n  # Find and move towards the closest workshop that can craft the desired item\n  nearest_workshop = find_closest_workshop(env, workshops_needed)\n\n  if nearest_workshop is None:\n      raise ValueError(\"No suitable workshop found to craft the item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Move towards the closest workshop\n  while not np.array_equal(pos, nearest_workshop):\n      action_additions, pos = move_to_position(pos, nearest_workshop)\n      actions.extend(action_additions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:25:30.245002", "function_name": "craft", "function_body": "  def move_to_target_position(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_closest_workshop(goal_index, cookbook, env):\n      recipes = cookbook.recipes\n      workshop_indices = env.world.workshop_indices\n\n      for recipe_output, recipe_ingredients in recipes.items():\n          if recipe_output == goal_index:\n              # Assuming workshops are listed as \"_key\" in the recipe\n              workshop_name = recipe_ingredients[\"_key\"]\n              return cookbook.index[workshop_name]\n\n      return None  # No matching workshop found\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_idx = find_closest_workshop(goal_index, cookbook, env)\n  \n  if closest_workshop_idx is None:\n      raise ValueError(f\"No workshop found for crafting {item}\")\n\n  # Find all positions of the closest workshop\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n      raise ValueError(f\"No position found for {item} workshop\")\n\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n  actions = move_to_target_position(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:27:52.174038", "function_name": "craft", "function_body": "  def find_closest_workshop(current_pos: np.array, workshops: dict[int, np.ndarray]) -> np.array:\n      distances = {ws_idx: np.min(np.linalg.norm(ws_positions - current_pos, axis=1)) for ws_idx, ws_positions in workshops.items()}\n      closest_ws_idx = min(distances, key=distances.get)\n      return workshops[closest_ws_idx][np.argmin(distances[closest_ws_idx])]\n\n  def move_to_position(pos_target: np.array, current_pos: np.array) -> list[int]:\n      actions = []\n      while not np.array_equal(current_pos, pos_target):\n          dx, dy = pos_target - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Collect all workshop positions\n      workshops = {ws_idx: np.argwhere(env._current_state.grid[:, :, ws_idx]) for ws_idx in env.world.workshop_indices}\n\n      # Filter out empty workshop types\n      workshops = {k: v for k, v in workshops.items() if len(v) > 0}\n\n      if not workshops:\n          raise ValueError(\"No available workshops\")\n\n      closest_workshop_pos = find_closest_workshop(pos, workshops)\n\n      actions.extend(move_to_position(closest_workshop_pos, pos))\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 3, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:27:53.146291", "function_name": "craft", "function_body": "  def move_to_position(pos_target: np.array, current_pos: np.array, direction: int) -> tuple[list[int], int]:\n      actions = []\n      \n      while not np.array_equal(current_pos, pos_target):\n          dx, dy = pos_target - current_pos\n\n          # Determine the new direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              target_direction = 3 if dx > 0 else 2\n          else:  # Then move in y-direction\n              target_direction = 1 if dy > 0 else 0\n\n          # Turn to the target direction if not already facing it\n          if direction != target_direction:\n              turns = (target_direction - direction) % 4\n              if turns == 1 or turns == -3:  # Turn right\n                  actions.append(5)\n                  direction = target_direction\n              elif turns == 2 or turns == -2:  # Turn around\n                  actions.extend([5, 5])\n                  direction = target_direction\n              elif turns == 3 or turns == -1:  # Turn left\n                  actions.append(6)\n                  direction = target_direction\n\n          # Move forward in the correct direction\n          actions.append(4)\n          current_pos[0] += 1 if dx > 0 else (-1 if dx < 0 else 0)\n          current_pos[1] += 1 if dy > 0 else (-1 if dy < 0 else 0)\n\n      return actions, direction\n\n  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      direction = env._current_state.dir\n      actions = []\n      \n      # Find all possible workshops\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          actions.extend(move_to_position(nearest_target_pos, pos, direction))\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:29:43.143505", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      actions = []\n      dx, dy = target_pos - current_pos\n      while not np.array_equal(current_pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def get_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          return nearest_target_pos, workshop_idx\n      \n      raise ValueError(\"No valid workshop found for item\")\n\n  def find_workshop_with_recipe(env, goal_index):\n      cookbook = env.world.cookbook\n\n      # Check if there's a recipe for the desired item\n      if goal_index not in cookbook.recipes:\n          raise ValueError(\"No recipe found for item\")\n\n      # Check which workshops can craft this item (based on recipe)\n      valid_workshops = []\n      for workshop_idx in env.world.workshop_indices:\n          if workshop_idx in cookbook.recipes[goal_index]:\n              valid_workshops.append(workshop_idx)\n\n      if not valid_workshops:\n          raise ValueError(\"No workshop found that can craft the desired item\")\n\n      return valid_workshops\n\n  def move_towards_closest_valid_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find workshops that can craft the desired item\n      valid_workshops = find_workshop_with_recipe(env, goal_index)\n\n      # Calculate distances to all valid workshops and choose the closest one\n      closest_workshop_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in valid_workshops:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(workshop_pos - pos)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = workshop_pos\n\n      if closest_workshop_pos is None:\n          raise ValueError(\"No valid workshop found within the grid\")\n\n      # Move towards the closest valid workshop\n      actions.extend(move_to_position(pos, closest_workshop_pos))\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest valid workshop that can craft the desired item\n  actions = move_towards_closest_valid_workshop(env, goal_index)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:29:44.205471", "function_name": "craft", "function_body": "  def find_closest_workshop(pos, grid):\n      distances = []\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n          \n          distances.append((distance, workshop_idx, nearest_target_pos))\n      \n      if not distances:\n          return None, None  # No workshops found\n\n      return min(distances)\n\n  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      grid = env._current_state.grid\n      actions = []\n\n      distance, workshop_idx, nearest_target_pos = find_closest_workshop(pos, grid)\n\n      if distance is None:\n          raise ValueError(\"No workshops found\")\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
