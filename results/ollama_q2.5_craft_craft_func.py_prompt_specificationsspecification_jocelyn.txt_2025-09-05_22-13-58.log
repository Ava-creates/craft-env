ientation, current_direction, atol=np.pi/4):\n      # Calculate the direction to rotate\n      delta_orientation = target_orientation - current_direction\n      if delta_orientation < 0:\n          delta_orientation += 2 * np.pi\n      optimal_rotation = min(delta_orientation, 2*np.pi-delta_orientation)\n      \n      if optimal_rotation <= np.pi/2:\n          actions.append(3)  # Turn right (RIGHT)\n      else:\n          actions.append(2)  # Turn left (LEFT)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:26:25.864694", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Determine the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0: continue\n\n      # Calculate the distance to each workshop position\n      distances = [np.linalg.norm(pos - wp, ord=2) for wp in workshop_positions]\n      nearest_wp = workshop_positions[np.argmin(distances)]\n      distance_to_nearest_wp = min(distances)\n\n      if distance_to_nearest_wp < min_distance:\n          nearest_workshop_pos, min_distance = nearest_wp, distance_to_nearest_wp\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n\n      # Determine direction to move in\n      # Prioritize moving in x-direction if there's a larger difference\n      if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if needed\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T13:26:26.941572", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  current_pos = np.array(env._current_state.pos)\n  nearest_workshop_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Find the closest position among all workshops of this type\n      distances = [np.linalg.norm(current_pos - wp, ord=2) for wp in workshop_positions]\n      nearest_workshop = workshop_positions[np.argmin(distances)]\n      distance_to_nearest_workshop = min(distances)\n\n      if distance_to_nearest_workshop < min_distance:\n          nearest_workshop_pos = nearest_workshop\n          min_distance = distance_to_nearest_workshop\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  target_pos = np.array(nearest_workshop_pos)\n  \n  while not np.array_equal(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      \n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if needed\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T13:29:09.922502", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n        dx, dy = target_pos - pos\n        directions = [(dx > 0, 'RIGHT', 3), (dx < 0, 'LEFT', 2),\n                      (dy > 0, 'DOWN', 1), (dy < 0, 'UP', 0)]\n        \n        # Prioritize moving in the direction that reduces distance\n        directions = sorted(directions, key=lambda x: abs(x[0]) * -1)\n        for condition, _, action in directions:\n            if condition:\n                actions.append(action)\n                pos += (dx if action % 2 == 0 else 0, dy if action % 2 != 0 else 0)\n                break\n\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) > 0:  # Check if there are any positions\n          mean_pos = target_positions.mean(axis=0)\n          distance = np.linalg.norm(pos - mean_pos, ord=2)\n          distances_to_workshops[workshop_idx] = (distance, mean_pos)\n\n  sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  actions = []\n\n  for workshop_idx, (_, nearest_target_pos) in sorted_workshops:\n      # Move to the closest workshop position\n      actions.extend(move_towards(pos, nearest_target_pos))\n      pos = nearest_target_pos\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T13:29:11.030224", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n        dx, dy = target_pos - pos\n        direction = np.argmax([abs(dx), abs(dy)])\n        \n        if direction == 0:  # x-direction\n            actions.append(3 if dx > 0 else 2)\n            pos[0] += 1 if dx > 0 else -1\n        elif direction == 1:  # y-direction\n            actions.append(1 if dy > 0 else 0)\n            pos[1] += 1 if dy > 0 else -1\n\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the item can be crafted (i.e., it has a recipe)\n  if goal_index not in cookbook.recipes:\n      raise ValueError(f\"No recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find all workshops that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) > 0:  # Check if there are any positions\n          mean_pos = target_positions.mean(axis=0)\n          distance = np.linalg.norm(pos - mean_pos, ord=2)\n          distances_to_workshops[workshop_idx] = (distance, mean_pos)\n\n  sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  for workshop_idx, (_, nearest_target_pos) in sorted_workshops:\n      # Move to the closest workshop position\n      actions.extend(move_towards(pos, nearest_target_pos))\n      pos = nearest_target_pos\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
