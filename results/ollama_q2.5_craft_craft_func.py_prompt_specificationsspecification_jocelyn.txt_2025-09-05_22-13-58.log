{"timestamp": "2025-09-06T15:21:28.251673", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          elif direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          distances_to_workshops[workshop_idx] = (distance, workshop_pos_mean)\n\n  # Get the closest workshops based on their distances\n  sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  actions = []\n\n  for workshop_idx, (_, mean_target_pos) in sorted_workshops:\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n\n      # Calculate the nearest position from all workshop positions\n      for target_pos in np.argwhere(env._current_state.grid[:, :, workshop_idx]):\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      # Move to the closest workshop position\n      actions.extend(move_towards(pos, nearest_target_pos))\n      \n      # Update current position after moving towards the nearest workshop\n      pos = nearest_target_pos\n      \n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:21:29.220098", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = (np.argmax([abs(dx), abs(dy)]))\n          if direction == 0:  # x-direction\n              action = 3 if dx > 0 else 2\n              pos[0] += 1 if dx > 0 else -1\n          elif direction == 1:  # y-direction\n              action = 1 if dy > 0 else 0\n              pos[1] += 1 if dy > 0 else -1\n          actions.append(action)\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  recipe = cookbook.recipes.get(goal_index, {})\n  workshop_idx = recipe.get(\"_key\", None)\n\n  if workshop_idx is None or workshop_idx not in env.world.workshop_indices:\n      raise ValueError(\"No valid workshop found for the item.\")\n\n  target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  if len(target_positions) == 0:\n      raise ValueError(\"Workshop positions not found in the environment grid.\")\n\n  # Calculate the mean position of all workshops of this type\n  workshop_pos_mean = target_positions.mean(axis=0)\n\n  pos = np.array(env._current_state.pos)\n  distance_to_workshop = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n  if distance_to_workshop > env.world.scenario.grid_size:\n      raise ValueError(\"Workshop is too far away from the current position.\")\n\n  # Move to the closest workshop\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n  actions = move_towards(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:24:38.183818", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* search algorithm for better pathfinding\n  start_pos = tuple(pos)\n  end_pos = tuple(nearest_target_pos)\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star_search(start, goal):\n      frontier = collections.PriorityQueue()\n      frontier.put((0, start))\n      came_from = {}\n      cost_so_far = {}\n      came_from[start] = None\n      cost_so_far[start] = 0\n\n      while not frontier.empty():\n          current = frontier.get()[1]\n\n          if current == goal:\n              break\n\n          neighbors = [(current[0]+1, current[1]), (current[0]-1, current[1]), \n                       (current[0], current[1]+1), (current[0], current[1]-1)]\n\n          for next_pos in neighbors:\n              new_cost = cost_so_far[current] + 1\n              if next_pos not in cost_so_far or new_cost < cost_so_far[next_pos]:\n                  cost_so_far[next_pos] = new_cost\n                  priority = new_cost + heuristic(goal, next_pos)\n                  frontier.put((priority, next_pos))\n                  came_from[next_pos] = current\n\n      path = []\n      while goal in came_from:\n          path.append(goal)\n          goal = came_from[goal]\n      path.reverse()\n      return path\n\n  # Get the path to the target position\n  path = a_star_search(start_pos, end_pos)\n\n  for next_pos in path[1:]:  # Skip the first element as it's the current position\n      dx, dy = next_pos[0] - pos[0], next_pos[1] - pos[1]\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"3": -1}}
