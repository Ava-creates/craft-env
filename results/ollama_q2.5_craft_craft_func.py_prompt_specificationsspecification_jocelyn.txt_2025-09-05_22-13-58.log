{"timestamp": "2025-09-06T08:21:51.753738", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      actions = []\n      \n      while not np.array_equal(current_pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              action = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              action = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n          \n          actions.append(action)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:29:12.247015", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshops = []\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of the workshops\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n\n          if distance < min_distance:\n              nearest_workshops = [(workshop_idx, nearest_target_pos)]\n              min_distance = distance\n          elif distance == min_distance:\n              nearest_workshops.append((workshop_idx, nearest_target_pos))\n\n  if not nearest_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Randomly choose one of the nearest workshops\n  closest_workshop_idx, nearest_target_pos = nearest_workshops[np.random.choice(len(nearest_workshops))]\n\n  # Move to the chosen workshop position\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n      # If we are at the same x or y, decide which direction to go first randomly.\n      elif abs(dy) == abs(dx):\n          direction = np.random.choice([0, 2])  # Randomly choose between LEFT and DOWN\n          actions.append(direction)\n          if direction == 2:\n              pos[0] -= 1\n          else:\n              pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:29:13.316689", "function_name": "craft", "function_body": "  def move_to_target(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshops = []\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of the workshops\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_target_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n\n          if distance < min_distance:\n              nearest_workshops = [(workshop_idx, nearest_target_pos)]\n              min_distance = distance\n          elif distance == min_distance:\n              nearest_workshops.append((workshop_idx, nearest_target_pos))\n\n  if not nearest_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Randomly choose one of the nearest workshops\n  closest_workshop_idx, nearest_target_pos = nearest_workshops[np.random.choice(len(nearest_workshops))]\n\n  # Move to the chosen workshop position\n  actions = move_to_target(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T08:32:40.068532", "function_name": "craft", "function_body": "  def get_action(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # DOWN\n      else:  # dy < 0\n          return 0  # UP\n\n  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          action = get_action(dx, dy)\n          actions.append(action)\n\n          if dx > 0:\n              pos[0] += 1\n          elif dx < 0:\n              pos[0] -= 1\n          elif dy > 0:\n              pos[1] += 1\n          else:  # dy < 0\n              pos[1] -= 1\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  def has_required_primitives(env, goal_index):\n      cookbook = env.world.cookbook\n      inventory = env._current_state.features_dict['inventory']\n      \n      # Check if all required primitives are in the inventory\n      required_items = cookbook.recipes[goal_index].get('requires', [])\n      for item in required_items:\n          if inventory.get(item, 0) == 0:\n              return False\n      \n      return True\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  if not has_required_primitives(env, goal_index):\n      raise ValueError(\"Required primitives are missing from the inventory\")\n\n  workshop_idx = find_closest_workshop(env, goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, workshop_idx)\n\n  # Move to the closest workshop position\n  actions = move_to_target(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:32:41.196656", "function_name": "craft", "function_body": "  def get_action(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # DOWN\n      else:  # dy < 0\n          return 0  # UP\n\n  def move_to_target(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          action = get_action(dx, dy)\n          actions.append(action)\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              if dx > 0:\n                  pos[0] += 1\n              elif dx < 0:\n                  pos[0] -= 1\n          else:  # Then move in y-direction\n              if dy > 0:\n                  pos[1] += 1\n              else:  # dy < 0\n                  pos[1] -= 1\n\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n      \n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx = find_closest_workshop(env, goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target_position(env, workshop_idx)\n\n  # Move to the closest workshop position\n  actions = move_to_target(env, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 0.7}}
{"timestamp": "2025-09-06T08:35:14.086756", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if 'closest_workshop_idx' not in locals():\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Align the agent's direction to the workshop before using it\n  dx, dy = nearest_target_pos - pos\n  if abs(dx) > abs(dy):\n      actions.append(3 if dx > 0 else 2)\n  elif dy != 0:\n      actions.append(1 if dy > 0 else 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T08:35:15.056542", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if 'closest_workshop_idx' not in locals():\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check if the agent is already facing the workshop\n  current_direction = env._current_state.direction\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n\n  if abs(current_direction - target_direction) > np.pi / 4:\n      actions.append(5 if current_direction < target_direction else 6)  # Turn towards the workshop\n      env._current_state.direction = target_direction\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T08:37:46.631346", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  def find_closest_workshop():\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position to the closest workshop\n  def find_nearest_position(workshop_idx):\n      workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n      distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_positions]\n      nearest_target_pos = workshop_positions[np.argmin(distances)]\n      return nearest_target_pos\n\n  target_pos = find_nearest_position(closest_workshop_idx)\n\n  # Calculate actions to move to the nearest position\n  def calculate_move_actions(target):\n      actions = []\n      current_pos = np.array(current_state.pos)\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n      \n      return actions\n\n  move_actions = calculate_move_actions(target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T08:37:47.712756", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  def find_closest_workshop(pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  def find_nearest_position(workshop_idx):\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_positions]\n      nearest_target_pos = workshop_positions[np.argmin(distances)]\n      return nearest_target_pos\n\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop(pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  target_pos = find_nearest_position(closest_workshop_idx)\n\n  # Calculate actions to move to the nearest position\n  def calculate_move_actions(start, target):\n      actions = []\n      current_pos = start\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n      \n      return actions\n\n  move_actions = calculate_move_actions(pos, target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T08:39:42.498474", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Find the nearest single workshop position directly to move towards\n          nearest_target_pos = None\n          min_nearest_distance = float('inf')\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_nearest_distance:\n                  nearest_target_pos = target_pos\n                  min_nearest_distance = distance\n\n          # Update closest workshop and position if this is the nearest one overall\n          if min_nearest_distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = min_nearest_distance\n              target_position = nearest_target_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, target_position):\n      dx, dy = target_position - pos\n\n      # Determine direction to move in based on the shortest path\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first if equal or larger distance\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
