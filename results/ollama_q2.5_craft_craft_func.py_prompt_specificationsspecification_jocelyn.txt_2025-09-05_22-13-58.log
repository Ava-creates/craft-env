se the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:13:44.392695", "function_name": "craft", "function_body": "  def move_towards_workshop(env, workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index, {})\n  \n  # Determine which workshop(s) can craft this item\n  possible_workshops = [k for k in env.world.workshop_indices if \"_key\" in recipe and recipe[\"_key\"] == env.world.cookbook.index.get(env.world.cookbook.index.get(k))]\n\n  if not possible_workshops:\n      raise ValueError(\"No suitable workshop found\")\n\n  # Move towards the closest suitable workshop\n  actions = None\n  for workshop_idx in possible_workshops:\n      actions = move_towards_workshop(env, workshop_idx)\n      if actions is not None:\n          break\n\n  if actions is None:\n      raise ValueError(\"No workshops found to craft item\")\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:13:45.360189", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Check which workshops can craft the desired item\n      workshop_indices_with_recipe = []\n      for recipe in env.world.cookbook.recipes.values():\n          if \"_key\" in recipe and recipe[\"_key\"] == goal_index:\n              workshop_indices_with_recipe.append(recipe[\"workshop\"])\n\n      # If no suitable workshop exists, raise an error\n      if not workshop_indices_with_recipe:\n          raise ValueError(\"No workshop can craft the desired item\")\n\n      # Find all positions of these workshops\n      workshop_pos_list = []\n      for workshop_idx in workshop_indices_with_recipe:\n          workshop_pos_list.extend(np.argwhere(env._current_state.grid[:, :, workshop_idx]))\n\n      # If no workshops exist, raise an error\n      if not workshop_pos_list:\n          raise ValueError(\"No workshops found on the grid\")\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:16:15.750436", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find the appropriate workshop from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              workshop_idx = None\n              if \"_key\" in ingredients:\n                  workshop_idx = ingredients[\"_key\"]\n              else:\n                  raise ValueError(\"No workshop specified for this item\")\n\n              # Find all positions of this type of workshop\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n              \n              if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n                  continue\n\n              # Calculate the closest position to move towards\n              nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n              while not np.array_equal(pos, nearest_target_pos):\n                  dx, dy = nearest_target_pos - pos\n\n                  # Determine direction to move in\n                  if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                      actions.append(3 if dx > 0 else 2)\n                      pos[0] += 1 if dx > 0 else -1\n                  else:  # Then move in y-direction\n                      actions.append(1 if dy > 0 else 0)\n                      pos[1] += 1 if dy > 0 else -1\n\n              # Use the workshop to craft the item\n              actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:16:16.765024", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      shortest_path = None\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          path = a_star(env._current_state.grid, tuple(pos), tuple(nearest_target_pos))\n          \n          if shortest_path is None or len(path) < len(shortest_path):\n              shortest_path = path\n\n      # Follow the shortest path to the nearest workshop\n      for step in shortest_path[:-1]:  # Exclude the last position since we'll be using the workshop there\n          actions.append(direction_to_action(step, pos))\n          pos[:] = step  # Update the current position\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  def a_star(grid, start, goal):\n      width, height, _ = grid.shape\n      neighbors = [(0, -1), (1, 0), (0, 1), (-1, 0)]\n      came_from = {}\n      cost_so_far = {start: 0}\n      frontier = collections.PriorityQueue()\n      frontier.put((0, start))\n\n      while not frontier.empty():\n          current = frontier.get()[1]\n          \n          if current == goal:\n              break\n          \n          for dx, dy in neighbors:\n              neighbor = (current[0] + dx, current[1] + dy)\n              new_cost = cost_so_far[current] + 1  # Assuming all steps have the same cost\n\n              if 0 <= neighbor[0] < width and 0 <= neighbor[1] < height and grid[neighbor].sum() == 0:\n                  if neighbor not in cost_so_far or new_cost < cost_so_far[neighbor]:\n                      cost_so_far[neighbor] = new_cost\n                      priority = new_cost + heuristic(goal, neighbor)\n                      frontier.put((priority, neighbor))\n                      came_from[neighbor] = current\n\n      path = []\n      while goal in came_from:\n          path.append(goal)\n          goal = came_from[goal]\n      path.reverse()\n      \n      return path if path else []\n\n  def heuristic(a, b):\n      # Manhattan distance\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def direction_to_action(target_pos, current_pos):\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      \n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      elif dy < 0:\n          return 0  # DOWN\n      \n      raise ValueError(\"Invalid target position\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
