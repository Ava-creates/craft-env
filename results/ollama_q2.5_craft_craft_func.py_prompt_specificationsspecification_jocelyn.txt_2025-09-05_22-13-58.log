{"timestamp": "2025-09-06T05:19:56.789532", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  def find_closest_workshop():\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_positions) > 0:\n              mean_pos = workshop_positions.mean(axis=0)\n              distance = np.linalg.norm(pos - mean_pos, ord=2)\n\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_idx\n      \n      return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position to the closest workshop\n  def find_nearest_position(workshop_idx):\n      workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n      distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_positions]\n      nearest_target_pos = workshop_positions[np.argmin(distances)]\n      return nearest_target_pos\n\n  target_pos = find_nearest_position(closest_workshop_idx)\n\n  # Calculate actions to move to the nearest position\n  def calculate_move_actions(target):\n      actions = []\n      current_pos = np.array(current_state.pos)\n      \n      while not np.array_equal(current_pos, target):\n          dx, dy = target - current_pos\n\n          if abs(dx) > abs(dy):\n              direction = 3 if dx > 0 else 2\n              current_pos[0] += 1 if dx > 0 else -1\n          else:\n              direction = 1 if dy > 0 else 0\n              current_pos[1] += 1 if dy > 0 else -1\n\n          actions.append(direction)\n      \n      return actions\n\n  move_actions = calculate_move_actions(target_pos)\n  actions.extend(move_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T05:19:57.927332", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest position among all workshops that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = [np.linalg.norm(pos - tp, ord=2) for tp in workshop_pos_list]\n          nearest_tp = workshop_pos_list[np.argmin(distances)]\n          distance_to_nearest_tp = min(distances)\n          if distance_to_nearest_tp < min_distance:\n              nearest_target_pos, min_distance = nearest_tp, distance_to_nearest_tp\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T05:22:17.352293", "function_name": "craft", "function_body": "  def get_workshop_positions(workshop_idx):\n    return np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n  def find_closest_workshop(pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Get all positions of this type of workshop\n          workshop_positions = get_workshop_positions(workshop_idx)\n\n          if len(workshop_positions) == 0:  # No workshops of this type available\n              continue\n\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_mean = workshop_positions.mean(axis=0)\n          distance_to_mean = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance_to_mean < min_distance:\n              min_distance = distance_to_mean\n              closest_workshop_idx = workshop_idx\n\n      # Find the nearest specific position among all workshops of the closest type\n      if closest_workshop_idx is not None:\n          target_positions = get_workshop_positions(closest_workshop_idx)\n          nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n      return closest_workshop_idx, nearest_target_pos\n\n  def move_towards(start_pos, target_pos):\n      actions = []\n      \n      while not np.array_equal(start_pos, target_pos):\n          dx, dy = target_pos - start_pos\n          \n          # Determine direction to move in (prioritizing the longer distance)\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              start_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              start_pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop and its position\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(current_pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions = move_towards(current_pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
