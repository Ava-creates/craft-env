{"timestamp": "2025-09-05T22:49:06.986116", "function_name": "craft", "function_body": "  def get_direction_to_move(dx: int, dy: int) -> int:\n      if abs(dx) > abs(dy):\n          return 3 if dx > 0 else 2\n      elif dy != 0:\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      actions.append(get_direction_to_move(dx, dy))\n      pos += np.array([1 if dx > 0 else -1, 1 if dy > 0 else -1]) * (abs(dx) > abs(dy))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-05T22:51:00.493955", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe.values() or goal_index == int(list(recipe.keys())[0]):\n          # Check if any workshop can be used to craft this item\n          for workshop_idx in workshop_indices:\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                  distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n\n          if closest_workshop_idx is not None:\n              break\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found to craft the item\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-05T22:56:00.631213", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      else:  # Then move in y-direction\n          direction = (1 if dy > 0 else 0)\n\n      actions.append(direction)\n      pos += np.array((1 if direction == 3 else -1) if direction in [2, 3] else (1 if direction == 1 else -1), dtype=np.int32)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-05T22:58:35.141841", "function_name": "craft", "function_body": "  def move_towards(pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:  # Then move in y-direction if needed\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - p, ord=2) for p in target_positions])]\n\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-05T22:58:36.147089", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding algorithm\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {tuple(pos): float('inf') for pos in np.argwhere(env._current_state.grid)}\n      g_score[tuple(start)] = 0\n      f_score = {tuple(pos): float('inf') for pos in np.argwhere(env._current_state.grid)}\n      f_score[tuple(start)] = heuristic(start, goal)\n\n      while open_set:\n          current = heapq.heappop(open_set)[1]\n          if tuple(current) == tuple(goal):\n              path = []\n              while current in came_from:\n                  path.append(tuple(current))\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              neighbor = tuple(np.array(current) + np.array((dx, dy)))\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              if tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos))\n  if path is None:\n      raise ValueError(\"No path found to the workshop\")\n\n  # Convert path to actions\n  for i in range(len(path) - 1):\n      dx, dy = np.array(path[i + 1]) - np.array(path[i])\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      elif dy < 0:\n          actions.append(0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
