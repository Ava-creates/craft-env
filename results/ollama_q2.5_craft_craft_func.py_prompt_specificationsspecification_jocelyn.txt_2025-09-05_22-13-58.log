{"timestamp": "2025-09-06T06:00:52.080818", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Fetch the recipe for the goal item to check which workshop can craft it\n  primitives_needed = cookbook.primitives_needed(goal_index)\n  required_workshop_idx = cookbook.workshop_for_item(goal_index)\n\n  if required_workshop_idx is None or required_workshop_idx not in env.world.workshop_indices:\n      raise ValueError(\"No available workshop found for the item\")\n\n  actions = []\n\n  # Find the closest position of the required workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, required_workshop_idx])\n  if len(target_positions) == 0:\n      raise ValueError(f\"No positions found for the required workshop {required_workshop_idx}\")\n\n  nearest_target_pos = None\n  min_distance = float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance < min_distance:\n          nearest_target_pos = target_pos\n          min_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T06:00:53.156849", "function_name": "craft", "function_body": "  def get_workshop_positions(workshop_idx):\n    return np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n  def find_closest_workshop(pos):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      nearest_target_pos = None\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Get all positions of this type of workshop\n          workshop_positions = get_workshop_positions(workshop_idx)\n\n          if len(workshop_positions) == 0:  # No workshops of this type available\n              continue\n\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_mean = workshop_positions.mean(axis=0)\n          distance_to_mean = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance_to_mean < min_distance:\n              min_distance = distance_to_mean\n              closest_workshop_idx = workshop_idx\n\n      # Find the nearest specific position among all workshops of the closest type\n      if closest_workshop_idx is not None:\n          target_positions = get_workshop_positions(closest_workshop_idx)\n          nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n      return closest_workshop_idx, nearest_target_pos\n\n  def move_towards(start_pos, target_pos):\n      actions = []\n      \n      while not np.array_equal(start_pos, target_pos):\n          dx, dy = target_pos - start_pos\n          \n          # Determine direction to move in (prioritizing the longer distance)\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              start_pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              start_pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop and its position\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(current_pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions = move_towards(current_pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T06:03:30.501682", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(np.array(env._current_state.pos) - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n  pos = np.array(env._current_state.pos)\n\n  # Move to the closest workshop position using a heuristic approach (Manhattan distance)\n  while not np.array_equal(pos, nearest_pos):\n      dx, dy = nearest_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T06:03:31.667642", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          mean_pos = workshop_positions.mean(axis=0)\n          current_distance = np.linalg.norm(np.array(env._current_state.pos) - mean_pos, ord=2)\n\n          if current_distance < min_distance:\n              target_workshop_idx = workshop_idx\n              min_distance = current_distance\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the closest position to move towards among all positions of the target workshop\n  nearest_pos = np.argwhere(env._current_state.grid[:, :, target_workshop_idx]).min(axis=0)\n  pos = np.array(env._current_state.pos)\n\n  def get_direction(dx, dy):\n      \"\"\"Helper function to determine direction based on dx and dy.\"\"\"\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  path = []\n  target_pos = tuple(nearest_pos)\n  open_set = collections.deque([(pos[0], pos[1])])\n  came_from = {}\n  g_score = {tuple(pos): 0}\n  f_score = {tuple(pos): np.linalg.norm(np.array(pos) - nearest_pos, ord=2)}\n\n  while open_set:\n      current = open_set.popleft()\n\n      if current == target_pos:\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # UP, DOWN, LEFT, RIGHT\n          neighbor = (current[0] + dx, current[1] + dy)\n\n          if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              continue\n\n          tentative_g_score = g_score[current] + 1\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + np.linalg.norm(np.array(neighbor) - nearest_pos, ord=2)\n              open_set.append(neighbor)\n\n  if path:\n      for step in path:\n          dx, dy = step[0] - pos[0], step[1] - pos[1]\n          actions.append(get_direction(dx, dy))\n          pos[0], pos[1] = step\n  else:\n      raise ValueError(\"No valid path found\")\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
