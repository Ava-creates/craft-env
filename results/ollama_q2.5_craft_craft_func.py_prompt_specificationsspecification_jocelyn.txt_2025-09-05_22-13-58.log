{"timestamp": "2025-09-06T19:13:16.198007", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Identify which workshops can craft the desired item\n  valid_workshops = [workshop_idx for workshop_idx in env.world.workshop_indices \n                     if goal_index in cookbook.recipes and \"_key\" in cookbook.recipes[goal_index] and cookbook.recipes[goal_index][\"_key\"] == f\"workshop{workshop_idx-3}\"]\n\n  actions = None\n  for workshop_idx in valid_workshops:\n      actions = move_towards_workshop(workshop_idx)\n      if actions is not None:  # If we found a valid path, use it\n          break\n\n  if actions is None:\n      raise ValueError(\"No suitable workshop to craft the item\")\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T19:13:17.266190", "function_name": "craft", "function_body": "  def get_closest_workshop_position(env):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_pos = None\n      min_distance = float('inf')\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(workshop_pos - pos)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = workshop_pos\n\n      return closest_workshop_pos\n\n  def move_towards_position(pos, target_pos):\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_pos = get_closest_workshop_position(env)\n  if closest_workshop_pos is None:\n      raise ValueError(\"No workshop found\")\n\n  actions = move_towards_position(np.array(env._current_state.pos), closest_workshop_pos)\n  actions.append(4)  # USE the workshop\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:14:05.805380", "function_name": "craft", "function_body": "  def get_workshop_for_item(cookbook, goal_index):\n      # Find a workshop index that has a recipe for the goal_index\n      for workshop_idx in env.world.workshop_indices:\n          if any(workshop_idx in recipe.values() or \"_key\" in recipe and workshop_idx == int(recipe[\"_key\"]) for recipe in cookbook.recipes.values()):\n              return workshop_idx\n      raise ValueError(\"No workshop can craft the item\")\n\n  def move_towards_workshop(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def use_workshop(env):\n      return [4]  # USE action to craft the item at the workshop\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_idx = get_workshop_for_item(cookbook, goal_index)\n  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n  if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n      raise ValueError(\"No workshop found\")\n\n  nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - np.array(env._current_state.pos), axis=1))]\n\n  actions = move_towards_workshop(env, nearest_target_pos) + use_workshop(env)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T19:14:06.777868", "function_name": "craft", "function_body": "  def move_towards_workshop(env, target_workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of the target workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, target_workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Determine which workshop can craft the desired item\n  target_workshop_idx = None\n  for recipe in cookbook.recipes.values():\n      if goal_index in recipe.values() and \"_key\" not in recipe:  # Check if the recipe can produce the goal item directly\n          target_workshop_idx = next(iter(recipe.keys()))  # Assume the first key is the workshop index\n          break\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No suitable workshop found to craft the item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, target_workshop_idx)\n\n  if actions is None:\n      raise ValueError(\"No workshops of the required type exist in the environment\")\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
