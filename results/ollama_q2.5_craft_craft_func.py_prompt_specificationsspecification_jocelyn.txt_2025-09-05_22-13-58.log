{"timestamp": "2025-09-06T18:50:40.902536", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 0, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T18:50:42.026048", "function_name": "craft", "function_body": "  def find_closest_workshop_position(env):\n      pos = np.array(env._current_state.pos)\n      \n      # Find all positions of all workshops\n      workshop_positions = []\n      for workshop_idx in env.world.workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          workshop_positions.extend(workshop_pos_list)\n\n      if not workshop_positions:  # Skip if no workshops exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(x - pos))\n      \n      return nearest_target_pos\n\n  def move_towards_position(env, target_pos):\n      actions = []\n      current_pos = np.array(env._current_state.pos)\n\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def craft_item(env):\n      actions = []\n      actions.extend(move_towards_position(env, find_closest_workshop_position(env)))\n      actions.append(4)  # USE\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = craft_item(env)\n\n  return actions", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:51:32.170028", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      # Find the nearest workshop that can craft the desired item\n      for workshop_idx in env.world.workshop_indices:\n          # Get all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if the required ingredients are available in the inventory\n  required_primitives = cookbook.primitives_for(goal_index)\n  \n  for primitive, count in required_primitives.items():\n      if env._current_state.inventory[primitive] < count:\n          raise ValueError(f\"Not enough {cookbook.index.get(primitive)} in inventory\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:51:33.228323", "function_name": "craft", "function_body": "  def find_closest_workshop_pos(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Identify which workshops can be used for crafting the desired item\n      possible_workshops = []\n      for workshop_idx in env.world.workshop_indices:\n          recipe_key = f\"{workshop_idx}_key\"\n          if (goal_index in env.world.cookbook.recipes and \n              recipe_key in env.world.cookbook.recipes[goal_index]):\n              possible_workshops.append(workshop_idx)\n\n      # Find all positions of these workshops\n      workshop_pos_list = np.concatenate([np.argwhere(env._current_state.grid[:, :, workshop_idx])\n                                        for workshop_idx in possible_workshops])\n\n      if len(workshop_pos_list) == 0:  # No suitable workshop found\n          raise ValueError(\"No suitable workshop available\")\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n      \n      return nearest_target_pos\n\n  def move_towards_workshop(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  try:\n      target_pos = find_closest_workshop_pos(env, goal_index)\n      actions = move_towards_workshop(env, target_pos)\n  except ValueError as e:\n      print(e)\n      return []\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:52:18.528268", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 6, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T18:52:19.496329", "function_name": "craft", "function_body": "  def move_to(target_pos, current_pos):\n      actions = []\n      dx, dy = target_pos - current_pos\n\n      # Determine direction to move in\n      while not np.array_equal(current_pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n              dx = target_pos[0] - current_pos[0]\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n              dy = target_pos[1] - current_pos[1]\n\n      return actions\n\n  def find_closest_workshop(env, item):\n      cookbook = env.world.cookbook\n      goal_index = cookbook.index[item]\n\n      if goal_index is None:\n          raise ValueError(\"Unknown item\")\n\n      for recipe_output, ingredients in cookbook.recipes.items():\n          if recipe_output == goal_index:\n              # Check the workshop type required for this recipe\n              for ingredient, count in ingredients.items():\n                  if \"_key\" not in ingredient:  # Skip if it's a key and not an actual ingredient\n                      continue\n\n                  workshop_type = int(ingredient.split(\"_\")[1])  # Extract the workshop index from \"_workshopX\"\n\n                  # Find all positions of this type of workshop\n                  workshop_pos_list = np.argwhere(env._current_state.grid[:, :, env.world.workshop_indices[workshop_type]])\n\n                  if len(workshop_pos_list) > 0:\n                      return workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - np.array(env._current_state.pos), axis=1))]\n      return None\n\n  # Find the closest workshop that can craft the desired item\n  target_workshop_pos = find_closest_workshop(env, item)\n\n  if target_workshop_pos is None:\n      raise ValueError(\"No suitable workshop found\")\n\n  # Move towards the closest workshop\n  actions = move_to(target_workshop_pos, np.array(env._current_state.pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:53:18.580357", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_required_workshop(goal_index):\n      for workshop_idx in env.world.workshop_indices:\n          for output_idx, ingredients in env.world.cookbook.recipes.items():\n              if output_idx == goal_index and workshop_idx in ingredients.values():\n                  return workshop_idx\n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if we have all required ingredients in inventory\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Cannot craft as we lack some ingredient\n\n  # Find the workshop that can craft the desired item\n  workshop_idx = find_required_workshop(goal_index)\n  \n  if workshop_idx is None:\n      raise ValueError(\"No suitable workshop found for crafting this item\")\n\n  actions = move_towards_workshop(workshop_idx)\n\n  if actions:\n      actions.append(4)  # USE to craft\n\n  return actions if actions else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T18:53:19.714050", "function_name": "craft", "function_body": "  def move_towards_workshop(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Check if we have all required ingredients in inventory\n  primitives_required = cookbook.primitives_for(goal_index)\n\n  for primitive, count in primitives_required.items():\n      if env._current_state.inventory[primitive] < count:\n          return []  # Cannot craft as we lack some ingredient\n\n  # Find the correct workshop that can craft the desired item\n  actions = None\n  for output_idx, ingredients in cookbook.recipes.items():\n      if output_idx == goal_index:\n          required_workshop_indices = [i for i in env.world.workshop_indices if i in ingredients]\n          break\n\n  for workshop_idx in required_workshop_indices:\n      actions = move_towards_workshop(workshop_idx)\n      if actions is not None:  # If valid actions found, break out of loop\n          actions.append(4)  # USE to craft\n          break\n\n  return actions if actions else []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-06T18:54:40.374704", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check if the agent is already at the workshop and facing it\n  if not np.array_equal(pos, nearest_target_pos):\n      # Move to the closest workshop position\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T18:59:40.467452", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the direction to move based on relative position\n  dx, dy = nearest_target_pos - pos\n  direction_order = []\n  \n  if abs(dx) > abs(dy):\n      direction_order.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n      direction_order.append(1 if dy > 0 else 0)  # UP or DOWN\n  else:\n      direction_order.append(1 if dy > 0 else 0)  # UP or DOWN\n      direction_order.append(3 if dx > 0 else 2)  # RIGHT or LEFT\n\n  for direction in direction_order:\n      while abs(dx) + abs(dy) > 0:\n          if direction == 3 and dx > 0:  # RIGHT\n              actions.append(direction)\n              pos[0] += 1\n              dx -= 1\n          elif direction == 2 and dx < 0:  # LEFT\n              actions.append(direction)\n              pos[0] -= 1\n              dx += 1\n          elif direction == 1 and dy > 0:  # UP\n              actions.append(direction)\n              pos[1] += 1\n              dy -= 1\n          elif direction == 0 and dy < 0:  # DOWN\n              actions.append(direction)\n              pos[1] -= 1\n              dy += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-06T19:00:43.695987", "function_name": "craft", "function_body": "  def get_closest_workshop_pos(workshop_indices, grid):\n      pos = np.array(env._current_state.pos)\n      closest_distance = float('inf')\n      best_workshop_pos = None\n      best_workshop_idx = None\n\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos)\n              if distance < closest_distance:\n                  closest_distance = distance\n                  best_workshop_pos = workshop_pos\n                  best_workshop_idx = workshop_idx\n\n      return best_workshop_pos, best_workshop_idx\n\n  def move_towards(workshop_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, workshop_pos):\n          dx, dy = workshop_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  closest_workshop_pos, best_workshop_idx = get_closest_workshop_pos(env.world.workshop_indices, env._current_state.grid)\n\n  if closest_workshop_pos is not None and best_workshop_idx is not None:\n      actions = move_towards(closest_workshop_pos)\n  else:\n      raise ValueError(\"No workshop found that can craft the desired item\")\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:00:44.760822", "function_name": "craft", "function_body": "  def get_recipe_action_sequence(cookbook, goal_index):\n      if goal_index in cookbook.primitives:\n          raise ValueError(\"Goal is a primitive and cannot be crafted.\")\n      \n      recipe = cookbook.recipes.get(goal_index)\n      if not recipe:\n          raise ValueError(f\"No recipe found for item index {goal_index}.\")\n\n      actions = []\n      # Assuming we need to find the right workshop based on the recipe ingredients\n      for ingredient_idx, count in recipe.items():\n          if ingredient_idx == \"_key\":\n              continue  # Skip metadata\n\n          # For simplicity, assume there's only one type of workshop that can craft this item\n          workshop_idx = env.world.workshop_indices[0]\n          \n          actions.extend(move_to_workshop(env, pos=np.array(env._current_state.pos), workshop_idx=workshop_idx))\n          \n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  def move_to_workshop(env, pos, workshop_idx):\n      actions = []\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return actions\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Generate sequence of actions to craft the desired item\n  try:\n      actions = get_recipe_action_sequence(cookbook, goal_index)\n  except ValueError as e:\n      print(f\"Error: {e}\")\n      return []\n\n  return actions", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-09-06T19:02:11.594308", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          min_workshop_distance = float('inf')\n          nearest_workshop_pos = None\n\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_workshop_distance:\n                  nearest_workshop_pos = workshop_pos\n                  min_workshop_distance = distance\n\n          if min_workshop_distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, min_workshop_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding algorithm\n  open_set = collections.deque([tuple(pos)])\n  came_from = {}\n  g_score = {tuple(pos): 0}\n  f_score = {tuple(pos): np.linalg.norm(nearest_target_pos - pos, ord=2)}\n\n  while open_set:\n      current = min(open_set, key=lambda x: f_score[x])\n      if np.array_equal(current, nearest_target_pos):\n          path = []\n          while current in came_from:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          break\n\n      open_set.remove(current)\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor = (current[0] + dx, current[1] + dy)\n          tentative_g_score = g_score[current] + 1\n\n          if env._current_state.grid[neighbor[0], neighbor[1], 0] != 0:  # Check for boundary or non-walkable tiles\n              continue\n\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n              came_from[neighbor] = current\n              g_score[neighbor] = tentative_g_score\n              f_score[neighbor] = tentative_g_score + np.linalg.norm(nearest_target_pos - np.array(neighbor), ord=2)\n              if neighbor not in open_set:\n                  open_set.append(neighbor)\n\n  if path is None or len(path) == 0:\n      raise ValueError(\"No valid path to the nearest workshop found\")\n\n  # Translate path into actions\n  for i in range(len(path) - 1):\n      dx = path[i + 1][0] - path[i][0]\n      dy = path[i + 1][1] - path[i][1]\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 2.7}}
{"timestamp": "2025-09-06T19:02:12.686394", "function_name": "craft", "function_body": "  def find_closest_workshop(pos: np.ndarray, workshop_indices: list[int]) -> tuple[int, np.ndarray]:\n      closest_workshop_idx = None\n      min_distance = float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate positions of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              min_workshop_distance = float('inf')\n              nearest_workshop_pos = None\n\n              for workshop_pos in workshop_pos_list:\n                  distance = np.linalg.norm(pos - workshop_pos, ord=2)\n                  if distance < min_workshop_distance:\n                      nearest_workshop_pos = workshop_pos\n                      min_workshop_distance = distance\n\n              if min_workshop_distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, min_workshop_distance\n\n      return closest_workshop_idx, np.array(nearest_workshop_pos) if closest_workshop_idx is not None else None\n\n  def move_to_position(start_pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      actions = []\n      pos = start_pos.copy()\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_closest_workshop(np.array(env._current_state.pos), workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(np.array(env._current_state.pos), nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:03:17.611258", "function_name": "craft", "function_body": "  def get_workshops_for_item(env, goal_index):\n      # Find all workshops that can be used to craft the desired item\n      cookbook = env.world.cookbook\n      recipes = cookbook.recipes\n\n      for output_idx, recipe in recipes.items():\n          if output_idx == goal_index:\n              return [key.split('_')[0] for key in recipe.keys() if 'workshop' in key]\n\n      return []\n\n  def move_towards_workshop(env, workshop_name):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      # Find all positions of the specified type of workshop\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          return []\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can be used to craft the desired item\n  workshop_names = get_workshops_for_item(env, goal_index)\n\n  if not workshop_names:\n      raise ValueError(\"No suitable workshop found for crafting the item.\")\n\n  actions = []\n\n  # Move towards and use each of the required workshops in sequence\n  for workshop_name in workshop_names:\n      actions.extend(move_towards_workshop(env, workshop_name))\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-06T19:03:18.706474", "function_name": "craft", "function_body": "  def move_towards_workshop(env):\n    pos = np.array(env._current_state.pos)\n    actions = []\n\n    # Check if there are any workshops in the environment\n    if not env.world.workshop_indices:\n      raise ValueError(\"No workshops available\")\n\n    # Initialize variables to track the closest workshop and its distance\n    nearest_target_pos = None\n    min_distance = float('inf')\n\n    # Iterate over all types of workshops\n    for workshop_idx in env.world.workshop_indices:\n        # Find all positions of this type of workshop\n        workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n        \n        if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n            continue\n\n        # Calculate the closest position to move towards for each workshop\n        for workshop_pos in workshop_pos_list:\n            distance = np.linalg.norm(workshop_pos - pos)\n            \n            # Update nearest_target_pos if a closer workshop is found\n            if distance < min_distance:\n                min_distance = distance\n                nearest_target_pos = workshop_pos\n\n    # If no workshops were found, raise an error\n    if nearest_target_pos is None:\n        raise ValueError(\"No reachable workshops\")\n\n    # Determine the path to the closest workshop\n    while not np.array_equal(pos, nearest_target_pos):\n        dx, dy = nearest_target_pos - pos\n\n        # Determine direction to move in\n        if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n            actions.append(3 if dx > 0 else 2)\n            pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            actions.append(1 if dy > 0 else 0)\n            pos[1] += 1 if dy > 0 else -1\n\n    # Use the workshop to craft the item\n    actions.append(4)  # USE\n\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env)\n\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T19:04:18.335171", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
