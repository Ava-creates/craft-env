 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T14:59:58.677208", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          # If this workshop is closer than the previously found ones, update closest_workshop_idx and min_distance\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n      else:  # Handle the case when both x and y directions are equal\n          actions.append(3 if dx >= 0 else 2)  # Move right or left first\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T14:59:59.743447", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          elif direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) > 0:  # Check if there are any positions\n          distances = np.linalg.norm(pos - target_positions, axis=1)\n          nearest_target_pos = target_positions[np.argmin(distances)]\n          distance_to_nearest = distances.min()\n          distances_to_workshops[workshop_idx] = (distance_to_nearest, nearest_target_pos)\n\n  # Get the closest workshops based on their distances\n  sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  actions = []\n\n  for workshop_idx, (_, nearest_target_pos) in sorted_workshops:\n      # Move to the closest workshop position\n      actions.extend(move_towards(pos, nearest_target_pos))\n      pos = nearest_target_pos\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:02:03.693018", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using BFS\n  actions.extend(bfs_move_to(env._current_state.grid, pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:02:09.106202", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n      else:  # If equal distance, move in one direction first (arbitrary choice)\n          actions.append(3 if dx > 0 else 2)  # Arbitrary choice to prioritize x-direction\n          pos[0] += 1 if dx > 0 else -1\n\n      # Check and update the current position based on the action taken\n      if not np.array_equal(pos, nearest_target_pos):\n          time.sleep(0.1)  # Add a small delay to simulate the action taking time\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:03:21.005528", "function_name": "craft", "function_body": "  def move_to(pos: np.ndarray, target_pos: np.ndarray) -> list[int]:\n      actions = []\n      dx, dy = target_pos - pos\n\n      while not np.array_equal(pos, target_pos):\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n              dx = target_pos[0] - pos[0]\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n              dy = target_pos[1] - pos[1]\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the recipe for the desired item\n  recipe = cookbook.recipes.get(goal_index)\n  \n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Check if we are near a workshop that can craft the desired item\n  for workshop_idx in env.world.workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n          continue\n\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n      actions.extend(move_to(pos, nearest_target_pos))\n      actions.append(4)  # USE to craft the item at the workshop\n\n      return actions\n  \n  raise ValueError(\"No suitable workshop found for crafting\")", "island_id": 0, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:03:22.021261", "function_name": "craft", "function_body": "  def move_towards_position(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def find_nearest_workshop(env, item_index):\n      cookbook = env.world.cookbook\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          for workshop_pos in workshop_pos_list:\n              # Check if the workshop can craft the desired item\n              if any(item_index in recipe.values() for recipe in cookbook.recipes.values()):\n                  return workshop_pos\n      \n      return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  nearest_workshop_pos = find_nearest_workshop(env, goal_index)\n  if nearest_workshop_pos is not None:\n      actions = move_towards_position(env, nearest_workshop_pos) + [4]  # USE action to craft\n      return actions\n\n  raise ValueError(\"No suitable workshop found for crafting the item\")", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:05:44.406340", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          # Update agent's current position based on direction moved\n          if direction == 3:\n              pos[0] += 1\n          elif direction == 2:\n              pos[0] -= 1\n          elif direction == 1:\n              pos[1] += 1\n          else:  # direction == 0\n              pos[1] -= 1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:05:45.371994", "function_name": "craft", "function_body": "  def get_direction(dx: int, dy: int):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  def get_path(start, target):\n      # Simple BFS for finding the shortest path\n      queue = collections.deque([(start, [])])\n      visited = set()\n      \n      while queue:\n          (current_pos, path) = queue.popleft()\n          visited.add(tuple(current_pos))\n          \n          if np.array_equal(current_pos, target):\n              return path + [get_direction(target[0] - current_pos[0], target[1] - current_pos[1])]\n          \n          # Explore neighbors\n          for d in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor = np.array(current_pos) + np.array(d)\n              \n              if tuple(neighbor) not in visited and is_valid_move(env._current_state.grid, neighbor):\n                  queue.append((neighbor, path + [get_direction(d[0], d[1])]))\n      return []\n\n  def is_valid_move(grid, pos):\n      # Check if the position is within grid bounds\n      width, height = grid.shape[:2]\n      if not (0 <= pos[0] < width and 0 <= pos[1] < height):\n          return False\n      \n      # Check for obstacles in the way (you can customize this based on your environment)\n      obstacle_indices = [env.world.cookbook.index[p] for p in [\"BOUNDARY\", \"WORKSHOP0\", \"WORKSHOP1\", \"WORKSHOP2\"]]\n      \n      for idx in obstacle_indices:\n          if grid[pos[0], pos[1], idx]:\n              return False\n      \n      return True\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Get the path to the closest workshop position\n  path_actions = get_path(pos, nearest_target_pos)\n\n  actions.extend(path_actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:07:37.152445", "function_name": "craft", "function_body": "  def find_closest_workshop(grid, pos):\n      # Iterate over each type of workshop and find the closest one\n      closest_workshop_pos = None\n      min_distance = float('inf')\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          for w_pos in workshop_pos_list:\n              distance = np.linalg.norm(w_pos - pos)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = w_pos\n\n      return closest_workshop_pos\n\n  def move_towards(env, target_pos):\n      actions = []\n      pos = np.array(env._current_state.pos)\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  grid = env._current_state.grid\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop in the environment\n  closest_workshop_pos = find_closest_workshop(grid, pos)\n  \n  if closest_workshop_pos is None:\n      raise ValueError(\"No workshop found to craft the item\")\n\n  actions = move_towards(env, closest_workshop_pos)\n  \n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:07:38.279206", "function_name": "craft", "function_body": "  def get_closest_workshop_position(env):\n      pos = np.array(env._current_state.pos)\n      \n      closest_workshop_pos = None\n      min_distance = float('inf')\n      \n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(workshop_pos - pos)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = workshop_pos\n      \n      return closest_workshop_pos\n\n  def get_direction_to_move(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          direction = 1 if dy > 0 else 0\n      return direction\n\n  def move_towards_workshop(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          direction = get_direction_to_move(pos, target_pos)\n          actions.append(direction)\n          if direction == 0:\n              pos[1] -= 1\n          elif direction == 1:\n              pos[1] += 1\n          elif direction == 2:\n              pos[0] -= 1\n          else:  # direction == 3\n              pos[0] += 1\n\n      actions.append(4)  # USE\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  closest_workshop_pos = get_closest_workshop_position(env)\n  if closest_workshop_pos is not None:\n      actions = move_towards_workshop(env, closest_workshop_pos)\n  else:\n      raise ValueError(\"No available workshops to craft the desired item\")\n\n  return actions", "island_id": 2, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T15:09:47.274553", "function_name": "craft", "function_body": "  def move_towards_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      # Determine the required workshop type from the recipe\n      for output_idx, ingredients in env.world.cookbook.recipes.items():\n          if output_idx == goal_index:\n              ingredient_indices = [i for i in ingredients if isinstance(i, int)]\n              break\n\n      # Find all workshops that can craft this item (assuming any workshop can)\n      for workshop_idx in env.world.workshop_indices:\n          # Find all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) == 0:  # Skip if no workshops of this type exist\n              continue\n\n          # Calculate the closest position to move towards\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n\n          while not np.array_equal(pos, nearest_target_pos):\n              dx, dy = nearest_target_pos - pos\n\n              # Determine direction to move in\n              if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n                  actions.append(3 if dx > 0 else 2)\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  actions.append(1 if dy > 0 else 0)\n                  pos[1] += 1 if dy > 0 else -1\n\n          # Use the workshop to craft the item\n          actions.append(4)  # USE\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find and move towards the closest workshop that can craft the desired item\n  actions = move_towards_workshop(env, goal_index)\n\n  return actions", "island_id": 0, "scores": {"3": 5.1}}
{"timestamp": "2025-09-06T15:09:48.319343", "function_name": "craft", "function_body": "  def find_closest_workshop(env, goal_index):\n      pos = np.array(env._current_state.pos)\n      \n      # Get the recipe for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_index)\n      if not recipe:\n          return None\n      \n      # Identify workshops involved in crafting this item\n      workshop_indices = [key for key, value in recipe.items() if \"_workshop\" in key]\n      \n      # Find all positions of these workshops\n      workshop_pos_list = []\n      for workshop_idx in workshop_indices:\n          workshop_pos_list.extend(np.argwhere(env._current_state.grid[:, :, int(workshop_idx)]))\n          \n      if not workshop_pos_list:  # Skip if no relevant workshops exist\n          return None\n\n      # Calculate the closest position to move towards\n      nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(workshop_pos_list - pos, axis=1))]\n      \n      return nearest_target_pos\n\n  def move_towards_workshop(env, target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  target_pos = find_closest_workshop(env, goal_index)\n  if target_pos is None:\n      raise ValueError(\"No relevant workshop found for the desired item\")\n      \n  # Find and move towards the closest relevant workshop\n  actions = move_towards_workshop(env, target_pos)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-06T15:12:03.262148", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Face the correct direction to use the workshop\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_direction = env._current_state.dir * (np.pi / 2)  # Convert agent's direction index to radians\n\n  angle_diff = (target_direction - current_direction + np.pi) % (2 * np.pi) - np.pi\n\n  if angle_diff > 0:\n      actions.append(1)  # Turn UP\n  elif angle_diff < 0:\n      actions.append(0)  # Turn DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  # print(actions)\n  return actions", "island_id": 4, "scores": {"3": 1.9000001}}
