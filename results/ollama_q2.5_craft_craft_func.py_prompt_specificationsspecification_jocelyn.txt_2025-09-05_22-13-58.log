rection to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-06T09:13:40.055425", "function_name": "craft", "function_body": "  def get_direction(pos1, pos2):\n      dx, dy = pos2 - pos1\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  target_positions = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of workshops of this type\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(positions) > 0:  # Check if there is any location for the workshop\n          distance = np.linalg.norm(pos - positions.mean(axis=0), ord=2)\n          if distance < min_distance:\n              target_positions = positions\n              min_distance = distance\n\n  if target_positions is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position among all closest workshops\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      direction = get_direction(pos, nearest_target_pos)\n      actions.append(direction)\n\n      # Update agent's position based on the action taken\n      if direction == 3:\n          pos[0] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      else:  # direction == 0\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 