se the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T11:08:33.610016", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Plan a path to the closest workshop position using Breadth-First Search (BFS)\n  queue = collections.deque([(pos.tolist(), [])])\n  visited = set()\n  found = False\n\n  while queue and not found:\n      current_pos, current_actions = queue.popleft()\n      if tuple(current_pos) in visited:\n          continue\n      visited.add(tuple(current_pos))\n\n      # Check if we've reached the target position\n      if np.array_equal(np.array(current_pos), nearest_target_pos):\n          actions.extend(current_actions)\n          found = True\n          break\n\n      # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n          if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n              queue.append(([new_x, new_y], current_actions + [4 if dx == 0 and dy == 0 else (2 if dx < 0 else 3) if dx != 0 else (0 if dy > 0 else 1)]))\n\n  # Use the workshop to craft the item\n  actions.append(4)\n  return actions", "island_id": 8, "scores": {"3": 0.2}}
{"timestamp": "2025-09-06T11:15:16.942681", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      # Prioritize movement in the direction with larger distance to reach the target position faster\n      if abs(dx) > abs(dy):  # x-direction\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # y-direction\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n    target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(target_positions) > 0:  # Check if there are any positions\n      workshop_pos_mean = target_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      distances_to_workshops[workshop_idx] = (distance, target_positions)\n\n  # Get the closest workshops based on their distances\n  closest_workshops_indices = sorted(distances_to_workshops.keys(), key=lambda k: distances_to_workshops[k][0])\n\n  for workshop_idx in closest_workshops_indices:\n    _, target_positions = distances_to_workshops[workshop_idx]\n    nearest_target_pos = None\n    min_nearest_distance = float('inf')\n\n    for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n        nearest_target_pos = target_pos\n        min_nearest_distance = distance\n\n    # Move to the closest workshop position\n    actions.extend(move_towards(pos, nearest_target_pos))\n\n    # Use the workshop to craft the item\n    actions.append(4)  # USE\n\n    return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:15:18.080053", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = np.argmax([abs(dx), abs(dy)])\n          if direction == 1:  # y-direction\n              actions.append(1 if dy > 0 else 0)\n              pos[1] += 1 if dy > 0 else -1\n          elif direction == 0:  # x-direction\n              actions.append(3 if dx > 0 else 2)\n              pos[0] += 1 if dx > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(target_positions) > 0:  # Check if there are any positions\n          distances = np.linalg.norm(pos - target_positions, axis=1)\n          nearest_target_pos = target_positions[np.argmin(distances)]\n          distance_to_nearest = distances.min()\n          distances_to_workshops[workshop_idx] = (distance_to_nearest, nearest_target_pos)\n\n  # Get the closest workshops based on their distances\n  sorted_workshops = sorted(distances_to_workshops.items(), key=lambda x: x[1][0])\n\n  actions = []\n\n  for workshop_idx, (_, nearest_target_pos) in sorted_workshops:\n      # Move to the closest workshop position\n      actions.extend(move_towards(pos, nearest_target_pos))\n      pos = nearest_target_pos\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T11:17:45.579491", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = (abs(dy) > abs(dx)) * 2 + (dx < 0) + (dy < 0) * 2\n      if direction == UP:\n        actions.append(UP)\n      elif direction == DOWN:\n        actions.append(DOWN)\n      elif direction == LEFT:\n        actions.append(LEFT)\n      elif direction == RIGHT:\n        actions.append(RIGHT)\n      pos[1] += dy > 0 - (dy < 0)\n      pos[0] += dx > 0 - (dx < 0)\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  inventory = env._current_state.inventory\n  recipe = cookbook.recipes[goal_index]\n\n  # Check if the required primitives are available in the inventory\n  for ingredient, quantity in recipe.items():\n    if inventory.get(ingredient, 0) < quantity:\n        raise ValueError(f\"Missing required {ingredient} to craft {item}\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  distances_to_workshops = {}\n\n  for workshop_idx in workshop_indices:\n    target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(target_positions) > 0:  # Check if there are any positions\n      workshop_pos_mean = target_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      distances_to_workshops[workshop_idx] = (distance, target_positions)\n\n  # Get the closest workshops based on their distances\n  closest_workshops_indices = sorted(distances_to_workshops.keys(), key=lambda k: distances_to_workshops[k][0])\n\n  for workshop_idx in closest_workshops_indices:\n    _, target_positions = distances_to_workshops[workshop_idx]\n    nearest_target_pos = None\n    min_nearest_distance = float('inf')\n\n    for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n        nearest_target_pos = target_pos\n        min_nearest_distance = distance\n\n    # Move to the closest workshop position\n    actions.extend(move_towards(pos, nearest_target_pos))\n\n    # Use the workshop to craft the item\n    actions.append(4)  # USE\n\n    return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:22:45.625022", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = (np.argmax([abs(dx), abs(dy)]), dx, dy)\n      if direction == (1, 0, 1):  # Move UP\n        actions.append(1)\n        pos[1] += 1\n      elif direction == (1, 0, -1):  # Move DOWN\n        actions.append(0)\n        pos[1] -= 1\n      elif direction == (0, 1, 0):  # Move RIGHT\n        actions.append(3)\n        pos[0] += 1\n      elif direction == (0, -1, 0):  # Move LEFT\n        actions.append(2)\n        pos[0] -= 1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  distances_to_workshops = {}\n  for workshop_idx in workshop_indices:\n    target_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n    if len(target_positions) > 0:  # Check if there are any positions\n      workshop_pos_mean = target_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      distances_to_workshops[workshop_idx] = (distance, target_positions)\n\n  # Get the closest workshops based on their distances\n  closest_workshops_indices = sorted(distances_to_workshops.keys(), key=lambda k: distances_to_workshops[k][0])\n\n  for workshop_idx in closest_workshops_indices:\n    _, target_positions = distances_to_workshops[workshop_idx]\n    nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n    # Move to the closest workshop position\n    actions.extend(move_towards(pos, nearest_target_pos))\n\n    # Use the workshop to craft the item\n    actions.append(4)  # USE\n\n    return actions\n\n  raise ValueError(\"No available workshop found\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-06T11:25:15.681955", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T11:25:16.753633", "function_name": "craft", "function_body": "  def move_to(target_pos: np.ndarray, current_pos: np.ndarray) -> list[int]:\n      \"\"\"Moves the agent to the target position from the current position.\"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n\n          # Determine direction to move in\n          if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n              actions.append(3 if dx > 0 else 2)\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              actions.append(1 if dy > 0 else 0)\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to(nearest_target_pos, pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 4.7}}
{"timestamp": "2025-09-06T11:27:34.057524", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          # Check if this workshop can craft the desired item\n          can_craft = False\n          for recipe_output_idx in cookbook.recipes:\n              if goal_index == recipe_output_idx and workshop_idx in cookbook.recipes[recipe_output_idx]:\n                  can_craft = True\n                  break\n\n          if can_craft and distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
